@{
    ViewData["Title"] = "Cari Bakiye Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*
    CARİ BAKİYE RAPORU — yeni tasarım. Müşteri ve tedarikçi carilerinin bakiye, vadesi geçmiş / gelecek, içerideki çek-senet, toplam risk, kredi limiti ve risk durumu;
    Müşteri / Tedarikçi Cari Kartları ile aynı süzgeçler (ara, tip, bölge, ülke, sınıf, ilişki, rol, durum, faaliyet ana grubu / grubu, temsilci, şirket, limit, risk).
    Veri: /CariKart/Veri (CARİ_MASTER + kredi limiti + cari risk; Data/CariKartOrnek.cs, Data/MutabakatOrnek.cs). Betik: wwwroot/js/cari-bakiye.js
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<link rel="stylesheet" href="/css/cari-kart.css?v=13" />
<link rel="stylesheet" href="/css/cari-bakiye.css?v=4" />
}
<div class="container-fluid py-3 na ck sik cb" id="cb" data-sayfa="bakiye">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-scale-balanced"></i></span>Cari Bakiye Raporu</h4>
        <span style="font-size:.68rem;font-weight:700;color:#475569;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:999px;padding:3px 10px"><i class="fas fa-database me-1"></i>CARİ_MASTER + Cari Mutabakat + Kredi Limiti</span>
        <span class="sub w-100">Müşteri ve tedarikçi carilerinin <b>bakiye</b> (para birimi kırılımı ve TL karşılığı), <b>vadesi geçmiş / gelecek</b> açık faturaları, içerideki <b>çek / senet</b>, <b>toplam cari risk</b>, <b>kredi limiti</b> ve otomatik <b>risk durumu</b>. Süzgeçler Müşteri / Tedarikçi Cari Kartları ile aynıdır; satırdan karta ve cari ekstreye geçilir.</span>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>
    <div class="cb-kpi" id="cbKpi"></div>
    <div class="na-kart">
        <div class="na-kart-b"><span><i class="fas fa-filter me-1"></i>Filtreler</span><span class="d-flex gap-1"><button type="button" class="btn btn-light btn-sm py-0" id="ckTemizle" style="font-size:.66rem">Temizle</button><button type="button" class="btn btn-light btn-sm py-0" id="cbExcel" style="font-size:.66rem"><i class="fas fa-file-excel me-1"></i>Excel</button></span></div>
        <div class="na-kart-g">
            <div class="ck-filtre">
                <div><label>Ara</label><input class="form-control" id="ckAra" placeholder="Kod, ünvan, VKN, yetkili, e-posta…"></div>
                <div><label>Cari Kart Tipi</label><select class="form-select" id="ckFTip"></select></div>
                <div><label>Cari Bölge</label><select class="form-select" id="ckFBolge"><option value="">Tümü</option></select></div>
                <div><label>Ülke</label><select class="form-select" id="ckFUlke"><option value="">Tümü</option></select></div>
                <div><label>Cari Sınıfı</label><select class="form-select" id="ckFSinif"><option value="">Tümü</option></select></div>
                <div><label>İlişki Durumu</label><select class="form-select" id="ckFIliski"><option value="">Tümü</option></select></div>
                <div><label>Cari Rolü</label><select class="form-select" id="ckFRol"><option value="">Tümü</option></select></div>
                <div><label>Durum</label><select class="form-select" id="ckFDurum"><option value="">Tümü</option><option>Aktif</option><option>Pasif</option></select></div>
                <div><label>Faaliyet Ana Grubu</label><select class="form-select" id="ckFAna"><option value="">Tümü</option></select></div>
                <div><label>Faaliyet Grubu</label><select class="form-select" id="ckFGrup"><option value="">Tümü</option></select></div>
                <div><label>Temsilci</label><select class="form-select" id="ckFTemsilci"><option value="">Tümü</option></select></div>
                <div><label>Şirket (ERP)</label><select class="form-select" id="ckFSirket"><option value="">Tümü</option></select></div>
                <div><label>Limit Durumu</label><select class="form-select" id="ckFLimit"><option value="">Tümü</option><option>Limit İçinde</option><option>Limite Yakın</option><option>Limit Aşıldı</option><option>Limit Yok</option></select></div>
                <div><label>Risk Durumu</label><select class="form-select" id="ckFRisk" title="Otomatik: 30 günden fazla vadesi geçmiş ödeme → Riskli; 1–30 gün gecikme → İzlemede"><option value="">Tümü</option><option>Riskli</option><option>İzlemede</option><option>Risksiz</option></select></div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap"><div class="na-mini" id="ckSayi"></div><div class="na-mini ms-auto cb-sirala">Sırala: <select class="form-select form-select-sm d-inline-block w-auto" id="cbSirala"><option value="risk">Toplam Risk (Büyükten)</option><option value="bakiye">Bakiye (Büyükten)</option><option value="gecmis">Vadesi Geçmiş (Büyükten)</option><option value="gecikme">Gecikme Günü (Büyükten)</option><option value="kullanim">Limit Kullanımı (Büyükten)</option><option value="kod">Cari Kodu</option><option value="ad">Kısa Ad</option></select></div></div>
            <div class="table-responsive"><table class="na-tablo ck-liste" id="cbTablo" data-dinamik="kapali"><thead><tr><th class="k-kod">Cari Kodu</th><th>Kısa Ad / Resmi Ünvan</th><th>Tip</th><th>Cari Sınıfı</th><th class="k-vade">Vade</th><th>Bakiye (PB)</th><th class="e">Toplam Bakiye (TL)</th><th class="e">Vadesi Geçmiş</th><th class="e">Vadesi Gelecek</th><th class="e">Çek / Senet</th><th class="e">Toplam Risk</th><th class="e">Kredi Limiti</th><th class="k-kul">Kullanım</th><th>Risk</th><th>Durum</th><th></th></tr></thead><tbody></tbody><tfoot></tfoot></table></div>
        </div>
    </div>
</div>
@section Scripts {
<script src="/js/cari-bakiye.js?v=3"></script>
}
