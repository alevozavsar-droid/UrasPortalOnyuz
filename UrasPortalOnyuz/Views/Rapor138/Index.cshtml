@model List<WebApplication3.Controllers.UretimRaporViewModel>
@{
    ViewData["Title"] = "Üretim Miktarları Raporu (UR / YM)";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var urunler = Model?.Where(x => x.ItemType == "ÜRÜN").ToList() ?? new List<WebApplication3.Controllers.UretimRaporViewModel>();
    var yariMamuller = Model?.Where(x => x.ItemType == "YARI MAMUL").ToList() ?? new List<WebApplication3.Controllers.UretimRaporViewModel>();

    int totalItems = Model?.Count ?? 0;
    decimal totalURQuantity = urunler.Sum(x => x.TotalQuantity);
    int totalURTypes = urunler.Count;

    decimal totalYMQuantity = yariMamuller.Sum(x => x.TotalQuantity);
    int totalYMTypes = yariMamuller.Count;
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7fc; font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #2b3445; }
        
        .dashboard-card { background: #ffffff; border-radius: 12px; border: 1px solid #eef2f7; box-shadow: 0 2px 6px rgba(0,0,0,0.03); padding: 20px; height: 100%; transition: all 0.3s ease; position: relative; overflow: hidden; cursor: pointer; }
        
        .kpi-title { font-size: 12px; color: #64748b; font-weight: 700; text-transform: uppercase; margin-bottom: 8px; z-index: 2; position: relative; }
        .kpi-value { font-size: 24px; font-weight: 900; color: #0f172a; margin-bottom: 2px; z-index: 2; position: relative; }
        .kpi-desc { font-size: 11px; color: #94a3b8; z-index: 2; position: relative; }
        .kpi-icon-bg { position: absolute; right: -10px; bottom: -10px; font-size: 5rem; color: #e2e8f0; opacity: 0.4; z-index: 1; transform: rotate(-10deg); }
        
        .border-top-primary { border-top: 4px solid #3b82f6 !important; }
        .border-top-success { border-top: 4px solid #10b981 !important; }
        .border-top-warning { border-top: 4px solid #f59e0b !important; }

        .table > thead { background-color: #f8fafc; font-size: 12px; color: #475569; font-weight: 700; border-bottom: 2px solid #e2e8f0; }
        .table > thead > tr > th { text-transform: uppercase; letter-spacing: 0.5px; padding: 12px; border-bottom: none; }
        .table > tbody > tr > td { font-size: 13px; color: #334155; vertical-align: middle; padding: 12px; border-bottom: 1px solid #f1f5f9; }
        .table-hover tbody tr:hover { background-color: #f8fafc; transform: scale(1.001); transition: all 0.2s; box-shadow: inset 2px 0 0 #3b82f6; }
        
        .filter-section { background: white; border-radius: 12px; padding: 20px; margin-bottom: 24px; box-shadow: 0 2px 6px rgba(0,0,0,0.03); }
        
        .nav-tabs .nav-link { color: #64748b; font-weight: 600; padding: 12px 20px; border: none; border-bottom: 3px solid transparent; }
        .nav-tabs .nav-link:hover { color: #3b82f6; border-color: transparent; }
        .nav-tabs .nav-link.active { color: #3b82f6; border: none; border-bottom: 3px solid #3b82f6; background: transparent; }
    </style>
}

<div class="container-fluid py-4">
    
    <div class="filter-section">
        <div class="row align-items-center">
            <div class="col-md-5">
                <h4 class="fw-bold mb-1 text-dark" style="letter-spacing: -0.5px;">Aylık Üretim Raporu</h4>
                <span class="text-muted" style="font-size: 13px;">Belirtilen tarih aralığındaki Ürün ve Yarı Mamul girişleri</span>
            </div>
            <div class="col-md-7">
                <form method="get" action="/Rapor138/Index" id="filterForm" class="row g-2 justify-content-end align-items-end">
                    <div class="col-auto">
                        <label class="form-label text-muted" style="font-size: 12px; font-weight:600;">Başlangıç</label>
                        <input type="date" name="startDate" id="startDate" class="form-control form-control-sm" value="@ViewBag.StartDate">
                    </div>
                    <div class="col-auto">
                        <label class="form-label text-muted" style="font-size: 12px; font-weight:600;">Bitiş</label>
                        <input type="date" name="endDate" id="endDate" class="form-control form-control-sm" value="@ViewBag.EndDate">
                    </div>
                    <div class="col-auto d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm rounded shadow fw-bold px-3">
                            <i class="fas fa-search me-1"></i> Raporla
                        </button>
                        <button type="button" class="btn btn-success btn-sm rounded shadow fw-bold px-3" onclick="downloadExcel()">
                            <i class="fas fa-file-excel me-1"></i> Excel İndir
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger shadow-sm border-0 mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.ErrorMessage
        </div>
    }

    <!-- KPI Kartları -->
    <div class="row mb-4 g-3">
        <div class="col-md-4">
            <div class="dashboard-card p-3 border-0 border-top-primary">
                <i class="fas fa-boxes kpi-icon-bg"></i>
                <div class="kpi-title">Toplam Üretilen Kalem Çeşidi</div>
                <div class="kpi-value text-primary">@totalItems</div>
                <div class="kpi-desc">Tüm Ürün (UR) ve Yarı Mamul (YM) çeşitleri</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-card p-3 border-0 border-top-success">
                <i class="fas fa-box-open kpi-icon-bg"></i>
                <div class="kpi-title">Toplam Ürün (UR) Üretimi</div>
                <div class="kpi-value text-success">@totalURQuantity.ToString("N2")</div>
                <div class="kpi-desc">@totalURTypes farklı ürün kaleminde gerçekleşti</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-card p-3 border-0 border-top-warning">
                <i class="fas fa-flask kpi-icon-bg"></i>
                <div class="kpi-title">Toplam Yarı Mamul (YM) Üretimi</div>
                <div class="kpi-value text-warning">@totalYMQuantity.ToString("N2")</div>
                <div class="kpi-desc">@totalYMTypes farklı yarı mamul kaleminde gerçekleşti</div>
            </div>
        </div>
    </div>

    <!-- Sekmeler -->
    <div class="dashboard-card border-0 p-0 overflow-hidden">
        <ul class="nav nav-tabs px-3 pt-2 bg-light border-bottom" id="reportTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="urun-tab" data-bs-toggle="tab" data-bs-target="#urun-pane" type="button" role="tab" aria-controls="urun-pane" aria-selected="true">
                    <i class="fas fa-box text-success me-1"></i> Ürünler (UR) <span class="badge bg-secondary ms-1">@totalURTypes</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="yarimamul-tab" data-bs-toggle="tab" data-bs-target="#yarimamul-pane" type="button" role="tab" aria-controls="yarimamul-pane" aria-selected="false">
                    <i class="fas fa-flask text-warning me-1"></i> Yarı Mamuller (YM) <span class="badge bg-secondary ms-1">@totalYMTypes</span>
                </button>
            </li>
        </ul>

        <div class="tab-content" id="reportTabsContent">
            
            <!-- 1. Sekme: ÜRÜNLER -->
            <div class="tab-pane fade show active" id="urun-pane" role="tabpanel" tabindex="0">
                <div class="table-responsive" style="max-height: 60vh; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="sticky-top shadow-sm">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Kalem Kodu</th>
                                <th>Kalem Adı</th>
                                <th class="text-end">Üretim Miktarı</th>
                                <th class="text-center">Ana Birim</th>
                                <th class="text-end">2. Birim Çarpanı</th>
                                <th class="text-end">Toplam 2. Birim</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (urunler.Any())
                            {
                                int i = 1;
                                foreach (var item in urunler)
                                {
                                    <tr>
                                        <td class="text-muted fw-bold">@i</td>
                                        <td class="fw-bold text-dark">@item.ItemCode</td>
                                        <td class="text-secondary fw-semibold">@item.ItemName</td>
                                        <td class="text-end fw-bold text-dark fs-6">@item.TotalQuantity.ToString("N2")</td>
                                        <td class="text-center"><span class="badge bg-light text-dark border">@item.Unit</span></td>
                                        <td class="text-end text-muted">@item.SecondUnitMultiplier.ToString("N2")</td>
                                        <td class="text-end fw-bold text-primary fs-6">
                                            @item.TotalSecondQuantity.ToString("N2") 
                                            <span style="font-size: 11px;" class="text-muted">@item.SecondUnitName</span>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="text-muted mb-2"><i class="fas fa-search-minus fa-3x opacity-25 text-success"></i></div>
                                        <h6 class="fw-bold text-secondary">Kayıt bulunamadı.</h6>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. Sekme: YARI MAMULLER -->
            <div class="tab-pane fade" id="yarimamul-pane" role="tabpanel" tabindex="0">
                <div class="table-responsive" style="max-height: 60vh; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="sticky-top shadow-sm">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Kalem Kodu</th>
                                <th>Kalem Adı</th>
                                <th class="text-end">Üretim Miktarı</th>
                                <th class="text-center">Ana Birim</th>
                                <th class="text-end">2. Birim Çarpanı</th>
                                <th class="text-end">Toplam 2. Birim</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (yariMamuller.Any())
                            {
                                int i = 1;
                                foreach (var item in yariMamuller)
                                {
                                    <tr>
                                        <td class="text-muted fw-bold">@i</td>
                                        <td class="fw-bold text-dark">@item.ItemCode</td>
                                        <td class="text-secondary fw-semibold">@item.ItemName</td>
                                        <td class="text-end fw-bold text-dark fs-6">@item.TotalQuantity.ToString("N2")</td>
                                        <td class="text-center"><span class="badge bg-light text-dark border">@item.Unit</span></td>
                                        <td class="text-end text-muted">@item.SecondUnitMultiplier.ToString("N2")</td>
                                        <td class="text-end fw-bold text-primary fs-6">
                                            @item.TotalSecondQuantity.ToString("N2") 
                                            <span style="font-size: 11px;" class="text-muted">@item.SecondUnitName</span>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="text-muted mb-2"><i class="fas fa-search-minus fa-3x opacity-25 text-warning"></i></div>
                                        <h6 class="fw-bold text-secondary">Kayıt bulunamadı.</h6>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function downloadExcel() {
            var startDate = document.getElementById('startDate').value;
            var endDate = document.getElementById('endDate').value;
            
            // Veritabanı seçimi kaldırıldığı için URL sadece tarihleri gönderiyor.
            var url = '/Rapor138/ExportExcel?startDate=' + encodeURIComponent(startDate) + '&endDate=' + encodeURIComponent(endDate);
            window.location.href = url;
        }
    </script>
}