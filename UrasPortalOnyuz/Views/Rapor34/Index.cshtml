@model List<WebApplication3.Models.CustomerRiskReportViewModel>
@using System.Globalization
@using Newtonsoft.Json
@using System.Linq
@using System.Text.RegularExpressions 

@{
    ViewData["Title"] = "Müşteri Risk Raporu (Rapor 34)";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 1. KURAL: URL'den veya Cookie'den aktif şirketi okuyan değişken
    var currentDb = Context.Request.Query["db"].FirstOrDefault() ?? Context.Request.Cookies["AktifSirket"] ?? "";
    var currentSelectedDbDisplay = (string)ViewBag.CurrentDbDisplay ?? "Bilinmiyor";

    var reportDataJson = Model != null ? JsonConvert.SerializeObject(Model) : "[]";
    var monthFilter = ViewBag.MonthFilter ?? 3;

    // Temizlik fonksiyonunu tanımlıyoruz. Sadece harf ve rakamları tutar.
    string NormalizeString(string s)
    {
        if (string.IsNullOrEmpty(s)) return string.Empty;
        // Tüm boşlukları, noktalama işaretlerini, özel karakterleri temizler ve küçük harfe çevirir.
        // \p{L}: Herhangi bir harf, \p{N}: Herhangi bir rakam.
        string normalized = Regex.Replace(s, @"[^\p{L}\p{N}_]+", "").ToLowerInvariant();
        return normalized;
    }

    var distinctValues = new Dictionary<string, List<string>>();
    if (Model != null && Model.Any())
    {
        distinctValues["MusteriKodu"] = Model.Where(m => !string.IsNullOrEmpty(m.MusteriKodu)).Select(m => m.MusteriKodu).Distinct().OrderBy(s => s).ToList();

        // Müşteri adlarını normalize ederek tekilleştirme.
        distinctValues["MusteriFirmaAdi"] = Model
            .Where(m => !string.IsNullOrEmpty(m.MusteriFirmaAdi))
            .GroupBy(m => NormalizeString(m.MusteriFirmaAdi)) // Güçlü normalize edilmiş string'i gruplama anahtarı yap
            .Select(g => g.First().MusteriFirmaAdi) // Her gruptan sadece orijinal adı (ilkini) al
            .OrderBy(s => s)
            .ToList();

        distinctValues["SatisSorumlusu"] = Model.Where(m => !string.IsNullOrEmpty(m.SatisSorumlusu)).Select(m => m.SatisSorumlusu).Distinct().OrderBy(s => s).ToList();
        distinctValues["MusteriGrubu"] = Model.Where(m => !string.IsNullOrEmpty(m.MusteriGrubu)).Select(m => m.MusteriGrubu).Distinct().OrderBy(s => s).ToList();
    }
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/css/bootstrap-select.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <style>
        /* Ana Stil Ayarları */
        :root {
            --primary-color: #007bff;
            --secondary-color: #6c757d;
            --danger-color: #dc3545;
            --light-bg: #f8f9fa;
            --white-bg: #ffffff;
            --border-color: #d1d9e6;
            --text-color: #333;
            --header-bg: #495057;
            --header-text: #ffffff;
            --shadow-medium: 0 4px 12px rgba(0, 0, 0, 0.1);
            --box-shadow-medium: 0 2px 4px rgba(0, 0, 0, 0.08);
        }

        body {
            background-color: var(--light-bg);
            font-family: 'Poppins', sans-serif;
            color: var(--text-color);
            line-height: 1.2;
            font-size: 0.85rem;
        }

        .container-fluid.py-4 {
            padding: 0 10px;
            margin-top: 10px;
        }

        /* Yeni Filtre Kutusu Modernleştirildi */
        .filter-controls {
            background-color: var(--white-bg);
            padding: 15px;
            border-radius: 8px;
            box-shadow: var(--box-shadow-medium);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

            .filter-controls label {
                font-weight: 500;
                color: var(--text-color);
                margin-bottom: 0;
                white-space: nowrap;
            }

            .filter-controls .form-select-sm {
                height: 35px;
                padding: 0.25rem 0.5rem;
                font-size: 0.85rem;
                border-radius: 5px;
            }

            .filter-controls .btn {
                height: 35px;
                line-height: 1.2;
                display: flex;
                align-items: center;
            }

        /* Sticky Toolbar */
        .sticky-toolbar {
            position: sticky;
            top: 0;
            background-color: var(--white-bg);
            z-index: 1000;
            padding: 10px 15px;
            border-radius: 8px;
            margin-bottom: 10px;
            box-shadow: var(--box-shadow-medium);
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 20px;
        }

        .total-amount-display {
            font-size: 1em;
            font-weight: 600;
            color: var(--danger-color);
            white-space: nowrap;
        }

        .btn {
            padding: 0.4rem 0.8rem;
            font-size: 0.8rem;
            border-radius: 5px;
        }

        /* Tablo Konteyneri ve Stilleri */
        .table-container {
            overflow-x: auto;
            max-height: calc(100vh - 240px); /* Alt taraftaki ortak buton için alan optimize edildi */
            overflow-y: auto;
            position: relative;
            border-radius: 8px;
            box-shadow: var(--shadow-medium);
            background-color: var(--white-bg);
            border: 1px solid var(--border-color);
        }

        .rapor-tablo {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            table-layout: fixed;
            min-width: 1400px;
        }

            .rapor-tablo thead {
                position: sticky;
                top: 0;
                z-index: 101;
                background-color: var(--white-bg);
            }

                .rapor-tablo thead .main-header-row th {
                    background-color: var(--header-bg);
                    color: var(--header-text);
                    padding: 6px 4px;
                    text-align: center;
                    white-space: nowrap;
                    font-weight: 600;
                    border-bottom: 2px solid var(--border-color);
                    border-right: 1px solid rgba(255, 255, 255, 0.1);
                    line-height: 1.2;
                    font-size: 0.8rem;
                }

                    .rapor-tablo thead .main-header-row th:last-child {
                        border-right: none;
                    }

                .rapor-tablo thead .filter-row th {
                    padding: 3px 4px;
                    height: 35px;
                    vertical-align: top;
                    background-color: #f1f4f8;
                    border-bottom: 1px solid var(--border-color);
                }

            .rapor-tablo th, .rapor-tablo td {
                vertical-align: middle;
                border-right: 1px solid var(--border-color);
            }

            .rapor-tablo td {
                padding: 4px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                height: 30px;
                line-height: 1.2;
                border-bottom: 1px solid #e9ecef;
            }

            .rapor-tablo tbody tr:nth-child(even) {
                background-color: #fafafa;
            }

        .table-hover tbody tr:hover {
            background-color: #e9eff7;
            cursor: pointer;
        }

        /* Sayısal alanları sağa hizala */
        .rapor-tablo td:nth-child(3), /* R Bakiye */
        .rapor-tablo td:nth-child(4), /* X Bakiye */
        .rapor-tablo td:nth-child(5), /* 420 Hesap Bakiyesi */
        .rapor-tablo td:nth-child(6), /* Genel Bakiye Farkı */
        .rapor-tablo td:nth-child(7), /* R Gecikme Gün */
        .rapor-tablo td:nth-child(8), /* R Yaşlanan Bakiye */
        .rapor-tablo td:nth-child(9), /* X Gecikme Gün */
        .rapor-tablo td:nth-child(10), /* X Yaşlanan Bakiye */
        .rapor-tablo td:nth-child(13) { /* Fatura Limiti */
            text-align: right;
        }

        /* Input/Select stillerini daha küçük yap */
        .filter-row th .form-control,
        .filter-row th .bootstrap-select .btn {
            height: 25px !important;
            padding: 2px 5px !important;
            font-size: 0.8rem !important;
        }

        .rapor-tablo tbody tr.selected-row {
            background-color: #cce5ff !important;
            border: 1px solid #007bff;
        }
        
        .footer-info-bar {
            background-color: #f1f3f5;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 6px 12px;
        }
    </style>
}

<div class="container-fluid py-4">
    @Html.AntiForgeryToken()

    <div class="row g-0">
        <div class="col-md-12">
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger" role="alert">
                    @ViewBag.ErrorMessage
                </div>
            }

            <div id="alertContainer" class="mt-3"></div>

            @if (Model != null && Model.Any())
            {
                <div class="filter-controls">
                    <label for="monthFilter">Fatura Limit Ayı:</label>
                    <select id="monthFilter" class="form-select form-select-sm" style="width: 120px;">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <!option value="@i" @(i == monthFilter ? "selected" : "")>Son @i Ay Toplamı</!option>
                        }
                    </select>
                    <button class="btn btn-primary btn-sm" id="applyFilterBtn" title="Filtreyi Uygula"><i class="fas fa-filter"></i> Uygula</button>

                    <div class="ms-auto d-flex align-items-center">
                        <span class="me-2 total-amount-display">Toplam Seçili Risk:</span>
                        <strong id="totalSelectedTlAmount" class="text-danger">0,00 TL</strong>
                    </div>
                </div>

                <div class="table-container">
                    <table class="table table-bordered table-striped table-hover rapor-tablo" id="rapor34Table">
                        <thead>
                            <tr class="main-header-row">
                                <th class="sortable-column" data-column="MusteriKodu" title="Müşteri Kodu" data-sort-type="text">Müşteri Kodu <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="MusteriFirmaAdi" title="Müşteri Firma Adı" data-sort-type="text">Müşteri Firma Adı <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="RBakiye" title="R Bakiye (Cari Ekstre Toplamı)" data-sort-type="number">R Bakiye <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="XBakiye" title="X Bakiye (Cari Ekstre Toplamı)" data-sort-type="number">X Bakiye <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="Hesap420Bakiyesi" title="420 Hesap Bakiyesi" data-sort-type="number">420 Hesap Bakiyesi <i class="fas fa-sort float-end"></i></th> 
                                <th class="sortable-column" data-column="GenelBakiyeFarki" title="R Bakiye + 420 Hesap Bakiyesi Toplamı" data-sort-type="number">Genel Bakiye Farkı <i class="fas fa-sort float-end"></i></th> 
                                <th class="sortable-column" data-column="RYaslananBakiyeGecikmeGunSayisi" title="R Yaşlanan Bakiye Gecikme Gün Sayısı (Tüm Açık İşlemler)" data-sort-type="number">R Yaşlanan Bakiye Gecikme Gün <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="RYaslananBakiye" title="R Yaşlanan Bakiye (Tüm Açık İşlemler)" data-sort-type="number">R Yaşlanan Bakiye <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="XYaslananBakiyeGecikmeGunSayisi" title="X Yaşlanan Bakiye Gecikme Gün Sayısı (Tüm Açık İşlemler)" data-sort-type="number">X Yaşlanan Bakiye Gecikme Gün <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="XYaslananBakiye" title="X Yaşlanan Bakiye (Tüm Açık İşlemler)" data-sort-type="number">X Yaşlanan Bakiye <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="SatisSorumlusu" title="Satış Sorumlusu" data-sort-type="text">Satış Sorumlusu <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="MusteriGrubu" title="Müşteri Grubu" data-sort-type="text">Müşteri Grubu <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="SonAyFaturaLimiti" title="Son @monthFilter Ay Toplam Fatura Limiti" data-sort-type="number">Son @monthFilter Ay Toplam Fatura Limiti <i class="fas fa-sort float-end"></i></th>
                            </tr>
                            <tr class="filter-row">
                                <th data-column="MusteriKodu"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                                <th data-column="MusteriFirmaAdi">
