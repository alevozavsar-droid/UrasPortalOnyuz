@model List<WebApplication3.Models.Rapor77ViewModel>
@{
    ViewData["Title"] = "Dinamik Ambalaj Matrisi (USD)";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // 1. KURAL: URL'den veya Cookie'den aktif şirketi okuyan değişken
    var currentDb = Context.Request.Query["db"].FirstOrDefault() ?? Context.Request.Cookies["AktifSirket"] ?? "";
    
    var dynamicColumns = ViewBag.DynamicColumns as List<int> ?? new List<int>();
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <style>
        body { 
            font-family: 'Inter', sans-serif; 
            background-color: #f8fafc; 
            color: #334155;
        }
        
        .modern-card {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            background: #ffffff;
            overflow: hidden;
        }
        
        .modern-card-header {
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 1.25rem 1.5rem;
        }

        .search-container {
            position: relative;
            max-width: 350px;
        }
        .search-container i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.9rem;
        }
        .search-input {
            padding-left: 38px;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            background-color: #f1f5f9;
            font-size: 0.95rem;
            transition: all 0.2s;
        }
        .search-input:focus {
            background-color: #ffffff;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
        }

        .table-container {
            max-height: calc(100vh - 250px); /* Alt kısma buton eklendiği için yükseklik optimize edildi */
            overflow-y: auto;
            overflow-x: auto;
        }

        .table-matrix { 
            margin-bottom: 0; 
            border-collapse: separate; 
            border-spacing: 0; 
        }
        
        .table-matrix thead th {
            background-color: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(8px);
            color: #475569;
            font-weight: 600;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 1rem 1.25rem;
            border-bottom: 2px solid #e2e8f0;
            text-align: right;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .table-matrix thead th:first-child,
        .table-matrix tbody td:first-child {
            position: sticky;
            left: 0;
            text-align: left;
            background-color: #ffffff;
            box-shadow: inset -1px 0 0 #e2e8f0;
            z-index: 11;
        }

        .table-matrix thead th:first-child {
            z-index: 12; 
            background-color: rgba(255, 255, 255, 0.95);
        }

        .best-option-th {
            background-color: #f0fdf4 !important;
            color: #166534 !important;
            border-bottom: 2px solid #bbf7d0 !important;
            text-align: center !important;
        }

        .pure-cost-th {
            background-color: #eff6ff !important;
            color: #1d4ed8 !important;
            border-bottom: 2px solid #bfdbfe !important;
        }

        .table-matrix tbody td {
            font-size: 0.95rem;
            vertical-align: middle;
            padding: 0.85rem 1.25rem;
            border-bottom: 1px solid #f1f5f9;
            color: #334155;
            text-align: right;
            font-weight: 500;
            white-space: nowrap;
            transition: background-color 0.2s;
        }

        .table-matrix tbody td:first-child { 
            font-weight: 600; 
            color: #0f172a; 
            min-width: 280px;
        }

        .best-option-td {
            text-align: center !important;
            font-weight: 700 !important;
            color: #15803d !important;
            background-color: #f8fafc;
        }

        .pure-cost-td {
            color: #2563eb !important;
            background-color: #f8fafc;
            font-weight: 600 !important;
        }

        .table-matrix tbody tr:hover td { 
            background-color: #f8fafc; 
        }

        .empty-cell { 
            color: #cbd5e1 !important; 
            font-weight: 400 !important; 
        }

        .price-tag {
            color: #16a34a; 
        }
        
        .badge-db {
            background-color: #e2e8f0;
            color: #475569;
            font-weight: 500;
            border: 1px solid #cbd5e1;
        }
        
        .badge-usd {
            background-color: #dcfce7;
            color: #166534;
            font-weight: 600;
            border: 1px solid #bbf7d0;
        }

        /* Sıfır Maliyet (Hata) Olan Hücre Tasarımı */
        .error-cell {
            background-color: #fff1f2 !important;
            color: #e11d48 !important;
            font-weight: 700 !important;
            cursor: help;
        }
    </style>
}

@* 2. KURAL: Güvenlik (CSRF) - Yetkisiz veri işlemlerini engellemek amacıyla eklendi *@
@Html.AntiForgeryToken()

<div class="container-fluid mt-4 mb-5">
    <div class="modern-card">
        <div class="modern-card-header d-flex justify-content-between align-items-center flex-wrap gap-3">
            <h5 class="mb-0 fw-bold" style="color: #1e293b;">
                <i class="fas fa-layer-group text-primary me-2"></i> Ambalaj Matrisi <span class="text-muted" style="font-size:0.85em;">(Birim Maliyetler USD)</span>
            </h5>
            
            @if (string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="search-container flex-grow-1 mx-lg-4">
                    <i class="fas fa-search"></i>
                    <input type="text" id="tableSearch" class="form-control search-input" placeholder="Ürün adı ile hızlıca filtrele...">
                </div>
            }

            <div class="d-flex gap-2">
                @if (ViewBag.UsdRate != null)
                {
                    <span class="badge badge-usd px-3 py-2 rounded-pill shadow-sm">
                        <i class="fas fa-dollar-sign me-1"></i> Kur: @ViewBag.UsdRate
                    </span>
                }
                <span class="badge badge-db px-3 py-2 rounded-pill">
                    <i class="fas fa-database me-1 text-primary"></i> @ViewBag.CurrentDbDisplay
                </span>
            </div>
        </div>
        
        <div class="card-body p-0">
            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="p-5 text-center">
                    <div class="mb-3">
                        <i class="fas fa-lock fa-3x" style="color: #ef4444;"></i>
                    </div>
                    <h5 class="fw-bold" style="color: #b91c1c;">Erişim Kısıtlaması</h5>
                    <p style="color: #64748b; font-size: 1.05rem;">@ViewBag.ErrorMessage</p>
                </div>
            }
            else if (Model != null && Model.Any())
            {
                <div class="table-container">
                    <table class="table table-matrix w-100" id="matrixTable">
                        <thead>
                            <tr>
                                <th>Ürün Adı</th>
                                
                                <th class="pure-cost-th" title="HAJ (Ambalaj) kalemleri çıkarılarak hesaplanmış saf reçete kilosu.">
                                    <i class="fas fa-vial me-1"></i> Ambalajsız (1 KG)
                                </th>

                                <th class="best-option-th"><i class="fas fa-star me-1 text-warning"></i> En Uygun Ambalaj</th>
                                
                                @foreach (var col in dynamicColumns)
                                {
                                    <th>@col kg</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                <tr>
                                    <td>@row.AnaUrunAdi</td>
                                    
                                    @if(row.Ambalajsiz1Kg.HasValue)
                                    {
                                        if (row.AmbalajsizSifirMaliyetliKalemVarMi)
                                        {
                                            <td class="error-cell" title="Dikkat! Ürün ağacındaki hammaddelerden en az birinin maliyeti 0 (Sıfır).">
                                                $ @row.Ambalajsiz1Kg.Value.ToString("N4") <i class="fas fa-exclamation-triangle ms-1"></i>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="pure-cost-tdpx-3">$ @row.Ambalajsiz1Kg.Value.ToString("N4")</td>
                                        }
                                    }
                                    else
                                    {
                                        <td class="pure-cost-td empty-cell">-</td>
                                    }

                                    <td class="best-option-td">
                                        @if(row.EnUygunAmbalaj == "Hesaplanamadı")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill px-3 py-1" title="Tüm paketlerde maliyet hatası var!">
                                                Hatalı BOM
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3 py-1">
                                                @row.EnUygunAmbalaj
                                            </span>
                                        }
                                    </td>
                                    
                                    @foreach (var col in dynamicColumns)
                                    {
                                        if (row.AmbalajMaliyetleri.ContainsKey(col))
                                        {
                                            var ambalajVerisi = row.AmbalajMaliyetleri[col];
                                            
                                            if(ambalajVerisi.SifirMaliyetliKalemVarMi)
                                            {
                                                <td class="error-cell" title="Dikkat! Bu ambalajın ürün ağacındaki bileşenlerden en az birinin maliyeti 0 (Sıfır).">
                                                    $ @ambalajVerisi.Maliyet.ToString("N4") <i class="fas fa-exclamation-triangle ms-1"></i>
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="price-tag">$ @ambalajVerisi.Maliyet.ToString("N4")</td>
                                            }
                                        }
                                        else
                                        {
                                            <td class="empty-cell">-</td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center">
                    <div class="mb-3">
                        <i class="fas fa-folder-open fa-3x" style="color: #cbd5e1;"></i>
                    </div>
                    <h5 class="fw-bold" style="color: #475569;">Kayıt Bulunamadı</h5>
                    <p style="color: #64748b;">Sistemde 'U' ile başlayan ve 1'den büyük tam sayı ambalaj bilgisi girilmiş geçerli bir ürün bulunamadı.</p>
                </div>
            }
        </div>
    </div>

    @* 4. KURAL: UI/UX Standartlarına uygun şık, db parametreli Ana Sayfa Dönüş butonu *@
    <div class="mt-4 text-center">
        <a asp-controller="Home" asp-action="Index" asp-route-db="@currentDb" class="btn btn-outline-secondary fw-bold shadow-sm">
            <i class="fas fa-home me-2"></i> Ana Sayfaya Dön
        </a>
    </div>
</div>

@section Scripts {
    
    <script>
        $(document).ready(function() {
            $("#tableSearch").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("#matrixTable tbody tr").filter(function() {
                    var rowText = $(this).find('td:first').text().toLowerCase();
                    $(this).toggle(rowText.indexOf(value) > -1);
                });
            });
        });
    </script>
}