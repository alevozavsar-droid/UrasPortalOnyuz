@model WebApplication3.Models.AdatHesaplamaModel
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Rendering
@using Newtonsoft.Json
@using System.Linq

@{
    ViewData["Title"] = "Adat Hesaplama Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Aktif Veritabanını URL veya Cookie'den alıyoruz
    var currentDb = Context.Request.Query["db"].ToString();
    if (string.IsNullOrEmpty(currentDb))
    {
        currentDb = Context.Request.Cookies["SelectedDatabase"];
    }

    var currentSelectedDbDisplay = (string)ViewBag.CurrentDbDisplay ?? "URASKIMYA";
    var approvers = ViewBag.Approvers as List<WebApplication3.Models.ApproverViewModel>;
    
    int bpExtraDays = ViewBag.BpExtraDays ?? 0;
    int bpExtraMonth = ViewBag.BpExtraMonth ?? 0;

    // Başlık yanına konan "nasıl hesaplanıyor" bilgilendirme ikonu. TIKLAYINCA açılır popover gösterir.
    // aciklama içinde ÇİFT TIRNAK kullanma; <b>/<br> serbest.
    Func<string, Microsoft.AspNetCore.Html.IHtmlContent> Bilgi = (aciklama) =>
        Html.Raw($"<i class='fas fa-info-circle adat-info ms-1' role='button' tabindex='0' aria-label='Nasıl hesaplanır' data-bilgi=\"{aciklama}\"></i>");
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <style>
        :root {
            --adat-primary: var(--metro-primary, #4f46e5);
            --adat-radius: 16px;
            --adat-radius-sm: 10px;
            --adat-shadow: 0 1px 2px rgba(16,24,40,.04), 0 8px 24px rgba(16,24,40,.06);
            --adat-shadow-hover: 0 8px 30px rgba(16,24,40,.12);
            --adat-card: var(--bg-card, #ffffff);
            --adat-border: var(--border-color, #e9edf5);
            --adat-muted: var(--text-muted, #667085);
            --adat-danger: #ef4444;
            --adat-success: #10b981;
            --adat-warn: #f59e0b;
        }
        body { font-family: 'Segoe UI', 'Inter', Tahoma, sans-serif; background-color: var(--bg-main, #f5f6fa); overflow-x: hidden; }
        .container, .container-fluid { max-width: 100% !important; width: 100%; padding: 0 22px; }
        * { box-sizing: border-box; }

        /* HERO */
        .header { position: relative; overflow: hidden; background: linear-gradient(120deg, var(--adat-primary) 0%, #7c3aed 100%); color: #fff; border: none; padding: 26px 30px; border-radius: var(--adat-radius); margin-bottom: 18px; box-shadow: var(--adat-shadow); }
        .header::after { content: ""; position: absolute; right: -40px; top: -40px; width: 190px; height: 190px; background: rgba(255,255,255,.10); border-radius: 50%; }
        .header h2 { font-weight: 800; letter-spacing: .3px; margin: 0; font-size: 1.6rem; }
        .header p { opacity: .9; margin-top: 4px; }
        .header .hero-icon { font-size: 1.5rem; opacity: .95; }

        .database-info { background: var(--adat-card); border: 1px solid var(--adat-border); border-left: 4px solid var(--adat-primary); padding: 9px 15px; border-radius: var(--adat-radius-sm); margin-bottom: 18px; font-size: .9rem; color: var(--adat-muted); }
        .database-info strong { color: var(--bs-body-color, #101828); }

        .card { border: 1px solid var(--adat-border); border-radius: var(--adat-radius); box-shadow: var(--adat-shadow); }
        .card-header { border-top-left-radius: var(--adat-radius) !important; border-top-right-radius: var(--adat-radius) !important; }
        .table-container { overflow-x: auto; margin-top: 1rem; background-color: var(--adat-card); border: 1px solid var(--adat-border); border-radius: var(--adat-radius); box-shadow: var(--adat-shadow); padding: 16px; }
        table { width: 100%; border-collapse: collapse; }

        /* CARI BAŞLIK + AKSİYONLAR */
        .cari-bilgi { background: var(--adat-card); padding: 16px 20px; border-radius: var(--adat-radius); margin-bottom: 18px; border: 1px solid var(--adat-border); border-left: 5px solid var(--adat-primary); box-shadow: var(--adat-shadow); display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; }
        .cari-bilgi h4 { font-weight: 700; font-size: 1.15rem; }
        .cari-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
        .cari-actions .btn { border-radius: 10px; font-weight: 600; }
        .cari-actions .btn-group .btn { border-radius: 0; }
        .cari-actions .btn-group .btn:first-child { border-top-left-radius: 10px; border-bottom-left-radius: 10px; }
        .cari-actions .btn-group .btn:last-child { border-top-right-radius: 10px; border-bottom-right-radius: 10px; }

        /* FAİZ ORANI ÇUBUĞU (sticky) */
        .rate-bar { position: sticky; top: 8px; z-index: 30; background: var(--adat-card); border: 1px solid var(--adat-border); border-radius: var(--adat-radius); box-shadow: var(--adat-shadow); }
        .rate-bar .form-label { color: var(--bs-body-color, #101828); }
        #interestRate { border-radius: 8px 0 0 8px; }

        /* KPI KARTLARI */
        .kpi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 18px; }
        .kpi-card { background: var(--adat-card); border: 1px solid var(--adat-border); border-radius: var(--adat-radius); padding: 18px 20px; box-shadow: var(--adat-shadow); position: relative; overflow: hidden; transition: transform .15s ease, box-shadow .15s ease; }
        .kpi-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 5px; background: var(--kc, var(--adat-primary)); }
        .kpi-card:hover { transform: translateY(-3px); box-shadow: var(--adat-shadow-hover); }
        .kpi-card.is-danger { --kc: var(--adat-danger); }
        .kpi-card.is-success { --kc: var(--adat-success); }
        .kpi-card.is-primary { --kc: var(--adat-primary); }
        .kpi-head { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
        .kpi-icon { width: 40px; height: 40px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.05rem; color: var(--kc); background: color-mix(in srgb, var(--kc) 14%, transparent); flex: none; }
        .kpi-head h5 { margin: 0; font-weight: 700; font-size: 1rem; color: var(--bs-body-color, #101828); }
        .adat-metric-row, .kpi-metric { display: flex; justify-content: space-between; align-items: baseline; padding: 9px 0; border-bottom: 1px dashed var(--adat-border); }
        .kpi-metric:last-of-type { border-bottom: none; }
        .adat-metric-label, .kpi-label { font-weight: 500; color: var(--adat-muted); font-size: .88rem; }
        .adat-metric-value, .kpi-value { font-weight: 800; font-size: 1.18rem; text-align: right; color: var(--bs-body-color, #101828); }
        .kpi-value small { font-weight: 600; color: var(--adat-muted); }
        .text-risk { color: var(--adat-danger) !important; }
        .text-safe { color: var(--adat-success) !important; }

        /* SPLIT: FATURALAR / ÇEKLER */
        .table-split-container { display: flex; gap: 18px; align-items: flex-start; }
        .invoices-wrapper, .checks-wrapper { flex: 1; min-width: 0; background: var(--adat-card); border: 1px solid var(--adat-border); border-radius: var(--adat-radius); box-shadow: var(--adat-shadow); padding: 16px; }
        .invoices-wrapper .table-container, .checks-wrapper .table-container { border: none; box-shadow: none; padding: 0; margin-top: .5rem; }
        .section-title { font-weight: 700; font-size: 1.02rem; display: flex; align-items: center; gap: 8px; }

        /* TABLOLAR */
        .table thead th { border-color: var(--adat-border); }
        .table > :not(caption) > * > * { padding: .55rem .6rem; }
        .table-hover > tbody > tr:hover > * { background-color: color-mix(in srgb, var(--adat-primary) 6%, transparent); }
        .monthly-breakdown-table th, .sim-table th { background: color-mix(in srgb, var(--adat-primary) 10%, var(--adat-card)); color: var(--adat-primary); text-align: center; vertical-align: middle; font-weight: 700; text-transform: uppercase; font-size: .72rem; letter-spacing: .4px; }
        .monthly-breakdown-table .total-row { background-color: var(--bg-subtle, #f4f6fb); font-weight: bold; border-top: 2px solid var(--adat-border); }
        .sim-table td, .monthly-breakdown-table td { vertical-align: middle; }

        .form-control-sm { font-size: 0.85rem; }
        .calc-amount-input { background-color: #fffaf0; border: 1px solid #fde9c8; font-weight: 700; color: #212529; text-align: right; width: 100%; border-radius: 8px; padding: 4px 8px; transition: border-color .12s, box-shadow .12s; }
        .calc-amount-input:focus { background-color: var(--adat-card); border-color: var(--adat-primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--adat-primary) 22%, transparent); outline: none; }

        .adat-info { color: var(--adat-primary); cursor: pointer; font-size: 0.82em; vertical-align: super; transition: transform .1s; }
        .adat-info:hover, .adat-info:focus { opacity: .78; outline: none; transform: scale(1.15); }
        .monthly-breakdown-table th .adat-info, .sim-table th .adat-info { color: var(--adat-primary); }
        /* Tıklayınca açılan bilgilendirme balonu */
        .adat-popover { position: fixed; z-index: 20000; max-width: 320px; background: #1f2937; color: #f9fafb; text-align: left; font-size: 0.82rem; line-height: 1.5; padding: 12px 14px; border-radius: 12px; box-shadow: 0 12px 34px rgba(0,0,0,.28); border: 1px solid rgba(255,255,255,.08); }
        .adat-popover b { color: #fff; }

        /* RESPONSIVE */
        @@media (max-width: 1200px) { .kpi-grid { grid-template-columns: 1fr; } }
        @@media (max-width: 992px) { .table-split-container { flex-direction: column; } .invoices-wrapper, .checks-wrapper { width: 100%; } .cari-actions { justify-content: flex-start; } }

        /* Cari secimi: kapsayiciyla birlikte kucul/buyu, butonla ayni hizada dursun */
        #bpCode + .select2-container { width: 100% !important; display: block; }
        #bpCode + .select2-container .select2-selection { min-height: 40px; display: flex; align-items: center; border-radius: 10px; border-color: var(--adat-border); }
        #bpCode + .select2-container .select2-selection__rendered { line-height: 1.4; padding-left: 12px; }
        /* SIRALAMA */
        th.siralanabilir { cursor: pointer; user-select: none; white-space: nowrap; }
        th.siralanabilir .sirala-ikon { opacity: .35; margin-left: 4px; font-size: .8em; }
        th.siralanabilir:hover .sirala-ikon, th.siralanabilir .sirala-ikon.aktif { opacity: 1; }

        /* MUTABAKAT MODALI */
        .mt-modal-genis { max-width: 95vw; }
        .mt-tutar { width: 120px; font-weight: bold; text-align: right; border-radius: 10px; border: 1px solid var(--border-color); padding: 5px 10px; }
        .mt-ozet { background-color: var(--bg-card); padding: 10px 15px; border-radius: 12px; min-width: 160px; }

        #aktarimTipi + .select2-container { width: 100% !important; display: block; }
        #aktarimTipi + .select2-container .select2-selection--multiple { min-height: 40px; display: flex; align-items: center; border-radius: 10px; border-color: var(--adat-border); padding: 2px 8px; }
        #aktarimTipi + .select2-container .select2-selection__choice { background: #fff7ed; border-color: #fdba74; color: #9a3412; font-weight: 600; border-radius: 6px; }
</style>
}

<div class="container mt-4">
    @Html.AntiForgeryToken()

    <div class="header">
        <div class="d-flex align-items-center gap-3">
            <i class="fas fa-chart-line hero-icon"></i>
            <div>
                <h2>Finansal Risk &amp; Adat Analizi</h2>
                <p class="mb-0">Aylık adat dağılımı, vade farkı ve ödeme kapanış simülasyonu</p>
            </div>
        </div>
    </div>

    <div class="database-info">
        <i class="fas fa-database me-2"></i> Aktif veritabanı: <strong>@currentSelectedDbDisplay</strong>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form asp-controller="Rapor21" asp-action="Index" method="get">
                
                @if (!string.IsNullOrEmpty(currentDb))
                {
                    <input type="hidden" name="db" value="@currentDb" />
                }

                <div class="row g-2 align-items-end">
                    <div class="col-md-6 mb-2">
                        <label for="bpCode" class="form-label">Cari Seçimi</label>
                        <select class="form-control" id="bpCode" name="bpCode">
                            <option value="">-- Cari Seçiniz --</option>
                            @if (Model.CariList.Any())
                            {
                                foreach (var cari in Model.CariList)
                                {
                                    <option value="@cari.CardCode" selected="@(cari.CardCode.Trim() == Model.SelectedBpCode?.Trim())">@cari.CardCode - @cari.CardName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3 mb-2">
                        <label for="aktarimTipi" class="form-label">İşlem Tipi <span class="text-muted small">(U_BE1_AKTAR · boş = tümü)</span></label>
                        <select class="form-control" id="aktarimTipi" name="aktarimTipi" multiple="multiple" title="Cari ekstredeki gibi birden fazla işlem tipi seçilebilir; yalnızca seçili tiplerdeki belgeler adata girer">
                            @foreach (var tip in Model.AktarimTipiList ?? new List<string>())
                            {
                                <option value="@tip" selected="@((Model.SelectedAktarimTipi ?? new List<string>()).Contains(tip))">@tip</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 mb-2">
                        <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search me-2"></i>Verileri Getir</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SelectedBpCode))
    {
        <div class="cari-bilgi">
            <h4 class="mb-0"><i class="fas fa-user-tie me-2"></i>@Model.SelectedBpCode - @Model.BpName
                @if (Model.SelectedAktarimTipi != null && Model.SelectedAktarimTipi.Any())
                {
                    <span class="badge bg-warning text-dark ms-2" style="font-size:.7rem; vertical-align:middle;" title="Yalnızca bu işlem tiplerindeki belgeler listelendi ve adata girdi"><i class="fas fa-filter me-1"></i>İşlem tipi: @string.Join(", ", Model.SelectedAktarimTipi)</span>
                }
            </h4>
            
            <div class="cari-actions">
                <div class="btn-group shadow-sm me-2" role="group">
                    <button type="button" class="btn btn-outline-danger btnDownloadPdf" data-type="PART1" title="Adat Dağılımı ve Açık Faturalar">
                        <i class="fas fa-file-pdf me-1"></i> PDF: Faturalar
                    </button>
                    <button type="button" class="btn btn-outline-warning text-dark btnDownloadPdf" data-type="PART2" title="Tahsilat Özeti ve Simülasyon">
                        <i class="fas fa-file-pdf me-1"></i> PDF: Tahsilatlar
                    </button>
                    <button type="button" class="btn btn-danger btnDownloadPdf" data-type="ALL" title="Tam Rapor (2 Sayfa)">
                        <i class="fas fa-file-pdf me-1"></i> Tüm PDF
                    </button>
                </div>

                <div class="btn-group shadow-sm me-2" role="group">
                    <button type="button" class="btn btn-outline-success btnDownloadExcel" data-type="PART1" title="Adat Dağılımı ve Açık Faturalar">
                        <i class="fas fa-file-excel me-1"></i> Excel: Faturalar
                    </button>
                    <button type="button" class="btn btn-outline-success btnDownloadExcel" data-type="PART2" title="Tahsilat Özeti ve Simülasyon">
                        <i class="fas fa-file-excel me-1"></i> Excel: Tahsilatlar
                    </button>
                    <button type="button" class="btn btn-success btnDownloadExcel" data-type="ALL" title="Tam Rapor">
                        <i class="fas fa-file-excel me-1"></i> Tüm Excel
                    </button>
                </div>

                <button type="button" class="btn btn-info shadow-sm text-white" onclick="mtAc()" title="SAP iç mutabakat: açık fatura ve ödemeleri eşleştirip kapat (Cari Ekstre ile aynı)">
                    <i class="fas fa-handshake me-1"></i> Mutabakat Yap
                </button>

                <button type="button" class="btn btn-primary shadow-sm" id="btnShowApprovals">
                    <i class="fas fa-tasks me-1"></i> Onay Bekleyenler
                </button>

                <button type="button" class="btn btn-info shadow-sm text-white" id="btnShowApprovalHistory">
                    <i class="fas fa-history me-1"></i> Tüm Onay Geçmişi
                </button>
            </div>
        </div>

        <div class="card mb-3 rate-bar">
            <div class="card-body py-2">
                <div class="row align-items-center">
                    <div class="col d-flex align-items-center gap-2">
                        <i class="fas fa-percent text-primary"></i>
                        <label for="interestRate" class="form-label fw-bold mb-0">Aylık Vade Farkı Oranı</label> @Bilgi("<b>Aylık Vade Farkı Oranı (%)</b><br>Vade farkı bu aylık yüzdeyle hesaplanır.<br><br><b>Formül:</b> Tutar × Gün × Oran ÷ 3000<br>(3000 = 30 gün × 100). Aylık %'yi günlüğe çevirir.")
                    </div>
                    <div class="col-auto" style="max-width: 160px;">
                        <div class="input-group input-group-sm">
                            <input type="number" id="interestRate" class="form-control fw-bold text-center" value="5" min="0" step="0.01">
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <i class="fas fa-calendar-alt me-2"></i> <strong>SEÇİLEN BELGELERİN AYLIK ADAT DAĞILIMI</strong> @Bilgi("Seçili faturalar <b>vade ayına</b> göre gruplanır. Her ay için ağırlıklı ortalama vade, net gecikme günü ve vade farkı payı hesaplanır.")
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover monthly-breakdown-table mb-0" id="tblAylik">
                                <thead>
                                    <tr>
                                        <th style="width: 20%;">Vade Dönemi (Ay-Yıl)</th>
                                        <th style="width: 20%;">Ortalama Vade @Bilgi("Ayın <b>ağırlıklı ortalama vade tarihi</b> = Σ(vade × tutar) ÷ Σtutar. Büyük tutarlı faturalar ortalamayı daha çok etkiler.")</th>
                                        <th class="text-end" style="width: 20%;">Fatura Tutarı (TL) @Bilgi("O vade ayına düşen seçili faturaların <b>toplam tutarı</b>.")</th>
                                        <th class="text-center" style="width: 15%; background-color: #f0f8ff; color: #0c4128;">Net Gecikme @Bilgi("<b>Net Gecikme (gün)</b> = ödemelerin ağırlıklı ortalama tarihi (ödeme yoksa bugün) − ayın ortalama vadesi.<br>Pozitif = geç ödendi.")</th>
                                        <th class="text-end" style="width: 25%;">Net Vade Farkı Payı (TL) @Bilgi("<b>= Ay tutarı × aylık oran × Net Gecikme ÷ 3000.</b><br>O ayın vade farkına katkısı.")</th>
                                    </tr>
                                </thead>
                                <tbody id="monthlyBreakdownBody">
                                    <tr><td colspan="5" class="text-center text-muted py-3">Hesaplama bekleniyor...</td></tr>
                                </tbody>
                                <tfoot id="monthlyBreakdownFooter"></tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="tarihUyari" class="alert alert-warning py-2 px-3 small mb-3" hidden></div>

        <div class="kpi-grid">
            <div class="kpi-card is-danger">
                <div class="kpi-head"><span class="kpi-icon"><i class="fas fa-file-invoice"></i></span><h5>Fatura (Borç) @Bilgi("<b>Fatura (Borç)</b><br>Seçili açık faturaların toplam bakiyesi.<br><br><b>Gün</b> = bugün − vade tarihi (pozitif = gecikme).<br><b>Ort. Vade (Gecikme)</b> = ağırlıklı ortalama:<br>Σ(tutar × gün) ÷ Σtutar")</h5></div>
                <div class="kpi-metric"><span class="kpi-label">Toplam Tutar</span><span class="kpi-value" id="lblInvoiceTotal">0,00</span></div>
                <div class="kpi-metric"><span class="kpi-label">Ort. Vade (Gecikme)</span><span class="kpi-value text-risk" id="lblInvoiceAdatDays">0 Gün</span></div>
            </div>
            <div class="kpi-card is-success">
                <div class="kpi-head"><span class="kpi-icon"><i class="fas fa-money-check-alt"></i></span><h5>Ödemeler (Alacak) @Bilgi("<b>Ödemeler (Alacak)</b><br>Seçili çek/nakit ödemelerin toplamı.<br><br><b>Gün</b> = bugün − ödeme/çek vade tarihi.<br>İleri tarihli çek → negatif gün (vadesi gelmemiş).<br><b>Ort. Vade Uzaklığı</b> = Σ(tutar × gün) ÷ Σtutar")</h5></div>
                <div class="kpi-metric"><span class="kpi-label">Toplam Tutar</span><span class="kpi-value" id="lblCheckTotal">0,00</span></div>
                <div class="kpi-metric"><span class="kpi-label">Ort. Vade Uzaklığı</span><span class="kpi-value text-safe" id="lblCheckAdatDays">0 Gün</span></div>
            </div>
            <div class="kpi-card is-primary">
                <div class="kpi-head"><span class="kpi-icon"><i class="fas fa-balance-scale"></i></span><h5>Net Durum @Bilgi("<b>Net Durum</b><br><b>Kalan Bakiye</b> = Toplam Fatura − Toplam Ödeme.<br><b>Net Adat Farkı (gün)</b> = Σ simülasyon adatı ÷ Toplam Fatura.<br>Ödeme, tutarı kadar günü düşürür.<br><br><b>Vade Farkı (TL)</b> = Σ simülasyon adatı × aylık oran ÷ 3000<br>= Toplam Fatura × Net gün × oran ÷ 3000.<br>adat = tutar × gün<br><br>Vadesi gelmemiş ödenmemiş fatura vadesinde ödenecek sayılır (0 gün); bugün girilen nakit bu faturayı erken kapatır ve vade farkını düşürür.")</h5></div>
                <div class="kpi-metric"><span class="kpi-label">Kalan Bakiye</span><span class="kpi-value" id="lblNetBalance">0,00</span></div>
                <div class="kpi-metric"><span class="kpi-label">Net Adat Farkı</span><span class="kpi-value" id="lblNetAdatDiff">0 Gün</span></div>
                <div id="netInterestContainer" class="mt-2 text-center"></div>
            </div>
        </div>

        <div class="table-split-container">
            <div class="invoices-wrapper">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="m-0 section-title"><i class="fas fa-file-invoice-dollar text-danger"></i> Açık Faturalar @Bilgi("SAP'taki <b>açık (kapanmamış) satış faturaları</b>. Hesap. Tutar hücresini değiştirebilir, vadeyi müşterinin ödeme koşuluna göre dinamik hesaplatabilirsiniz.")</h5>
                    <div class="d-flex align-items-center gap-3">
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" id="chkUseDynamicDueDate">
                            <label class="form-check-label fw-bold text-primary" for="chkUseDynamicDueDate" style="font-size:0.85rem; cursor:pointer;">
                                Vadeyi Müşteri Ödeme Koşuluna Göre Hesapla
                            </label>
                        </div>
                        <div>
                            <button id="selectAllBtn" class="btn btn-sm btn-outline-secondary">Tümünü Seç</button>
                            <button id="deselectAllBtn" class="btn btn-sm btn-outline-secondary">Kaldır</button>
                        </div>
                    </div>
                </div>
                <div class="table-container p-0">
                    <table class="table table-bordered table-striped table-hover table-sm" id="tblFaturalar" style="font-size: 0.9em;">
                        <thead class="table-light sticky-top" style="top: 0; z-index: 10;">
                            <tr>
                                <th class="text-center" style="width: 40px;"><input type="checkbox" id="masterCheckbox" /></th>
                                <th>Belge No</th>
                                <th>Fatura Tarihi</th>
                                <th>Vade Tarihi</th>
                                <th class="text-end" style="width: 140px; background-color: #fff3cd;">Hesap. Tutar</th>
                                <th class="text-end">Orij. Bakiye</th>
                                <th class="text-center">Gün @Bilgi("<b>Gün</b> = bugün − vade tarihi.<br>Pozitif (kırmızı) = gecikmiş, negatif (yeşil) = vadesi gelmemiş.")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OpenInvoices.Any())
                            {
                                foreach (var invoice in Model.OpenInvoices)
                                {
                                    var dynamicDueDate = invoice.DocDate.AddMonths(bpExtraMonth).AddDays(bpExtraDays);
                                    var daysDiff = (DateTime.Today - invoice.DueDate).TotalDays;
                                    var dayClass = daysDiff > 0 ? "text-danger fw-bold" : "text-success";
                                    <tr class="invoice-row" 
                                        data-docdate="@invoice.DocDate.ToString("yyyy-MM-dd")"
                                        data-original-duedate="@invoice.DueDate.ToString("yyyy-MM-dd")"
                                        data-original-duedate-text="@invoice.DueDate.ToString("dd.MM.yyyy")"
                                        data-dynamic-duedate="@dynamicDueDate.ToString("yyyy-MM-dd")"
                                        data-dynamic-duedate-text="@dynamicDueDate.ToString("dd.MM.yyyy")"
                                        data-duedate="@invoice.DueDate.ToString("yyyy-MM-dd")">
                                        
                                        <td class="text-center"><input type="checkbox" class="invoice-checkbox" value="@invoice.DocEntry" /></td>
                                        <td>@invoice.DocNum</td>
                                        <td>@invoice.DocDate.ToString("dd.MM.yyyy")</td>
                                        <td class="due-date-cell">@invoice.DueDate.ToString("dd.MM.yyyy")</td>
                                        <td class="p-1"><input type="text" inputmode="decimal" class="form-control form-control-sm calc-amount-input tr-para" value="@invoice.BalanceDue.ToString("N2", new CultureInfo("tr-TR"))" onfocus="this.select();" /></td>
                                        <td class="text-end text-muted pt-2">@invoice.BalanceDue.ToString("N2", new CultureInfo("tr-TR"))</td>
                                        <td class="text-center @dayClass pt-2 delay-days-cell">@Math.Round(daysDiff)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="checks-wrapper">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="m-0 section-title"><i class="fas fa-money-bill-wave text-success"></i> Ödemeler / Çekler @Bilgi("Cariden alınan <b>çek/nakit ödemeler</b>. Çek vadesi ileri tarihli olabilir. Simülasyonda bu ödemeler faturalara FIFO (en eski önce) ile uygulanır.")</h5>
                    <div>
                        <button id="addCashBtn" class="btn btn-sm btn-info text-white"><i class="fas fa-money-bill-wave"></i> Nakit</button>
                        <button id="addCheckBtn" class="btn btn-sm btn-success"><i class="fas fa-plus"></i> Çek</button>
                        <button id="saveDraftBtn" class="btn btn-sm btn-outline-primary" title="Bu carideki ödeme/çek listesini kaydet; bir sonraki girişte otomatik yüklenir"><i class="fas fa-save"></i> Kaydet</button>
