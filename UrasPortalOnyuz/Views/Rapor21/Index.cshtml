                                {
                                    var duzenlenebilir = check.U_BE1_APPROVALSTATUS != "O" && check.U_BE1_APPROVALSTATUS != "Y" && check.U_BE1_APPROVALSTATUS != "N";
                                    <tr class="existing-check-row" data-docentry="@check.DocEntry" data-amount="@check.U_BE1_AMOUNT.ToString(CultureInfo.InvariantCulture)" data-duedate="@(check.U_BE1_DUEDATE?.ToString("yyyy-MM-dd"))">
                                        <td class="text-center"><input type="checkbox" class="check-checkbox-existing" checked /></td>
                                        <td>
                                            @if(check.U_BE1_APPROVALSTATUS == "O") { <span class="badge bg-warning text-dark">Onay Bek.</span> }
                                            else if(check.U_BE1_APPROVALSTATUS == "Y") { <span class="badge bg-success">Onaylı</span> }
                                            else if(check.U_BE1_APPROVALSTATUS == "N") { <span class="badge bg-danger">Reddedildi</span> }
                                            else { <span class="badge bg-secondary">Kayıtlı</span> }
                                        </td>
                                        @if (duzenlenebilir)
                                        {
                                            <td><input type="date" class="form-control form-control-sm existing-duedate" value="@(check.U_BE1_DUEDATE?.ToString("yyyy-MM-dd"))" /></td>
                                            <td><input type="text" class="form-control form-control-sm existing-checknumber" value="@check.U_BE1_CHECKNUMBER" /></td>
                                            <td class="text-end"><input type="text" inputmode="decimal" class="form-control form-control-sm existing-amount tr-para text-end" value="@check.U_BE1_AMOUNT.ToString("N2", new CultureInfo("tr-TR"))" /></td>
                                        }
                                        else
                                        {
                                            <td>@(check.U_BE1_DUEDATE?.ToString("dd.MM.yyyy"))</td>
                                            <td>@check.U_BE1_CHECKNUMBER</td>
                                            <td class="text-end">@check.U_BE1_AMOUNT.ToString("N2", new CultureInfo("tr-TR"))</td>
