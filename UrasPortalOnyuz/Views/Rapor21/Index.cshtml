                                        <th class="text-end">Ödenen (Kapanan) @Bilgi("Bu satırda faturaya uygulanan ödeme tutarı (FIFO ile min(kalan fatura, kalan ödeme)).")</th>
                                        <th class="text-end">Kalan Bakiye @Bilgi("Uygulama sonrası faturanın <b>kapanmadan kalan</b> bakiyesi.")</th>
                                        <th class="text-end">VF Tutarı @Bilgi("<b>Vade Farkı</b> = Kapanan tutar × aylık oran × Gün ÷ 3000.<br>Pozitif = tahsil edilecek, negatif = lehte.")</th>
                                    </tr>
                                </thead>
                                <tbody id="simulationTableBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4 mb-5 align-items-center gap-2">
            <select id="approverSelect" class="form-select w-auto fw-bold" style="min-width: 200px;">
                <option value="">-- Onaycı Seçiniz --</option>
