@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            // Şirket bilgisini ve CSRF Token'ını alıyoruz
            const currentDbParam = '@currentDb';
            const dbQueryString = currentDbParam ? `?db=${currentDbParam}` : '';
            const antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();

            $('#bpCode').select2({ theme: "bootstrap-5", placeholder: "-- Cari Seçiniz --", width: '100%' });
            // İşlem tipi: cari ekstredeki gibi çoklu seçim (seçince kapanmaz, temizlenebilir)
            $('#aktarimTipi').select2({ theme: "bootstrap-5", placeholder: "Tümü (seçmek için tıklayın)", width: '100%', closeOnSelect: false, allowClear: true });

            // Bilgilendirme (ℹ) ikonlarına TIKLAYINCA açılan popover (Bootstrap'e bağımlı değil).
            (function () {
                var pop = document.createElement('div');
                pop.className = 'adat-popover';
                pop.style.display = 'none';
                document.body.appendChild(pop);
                var acikIkon = null;

                function kapat() { pop.style.display = 'none'; acikIkon = null; }

                function ac(ikon) {
                    pop.innerHTML = ikon.getAttribute('data-bilgi') || '';
                    // position:fixed -> yalnizca viewport koordinatlari (scroll matematigi yok).
                    pop.style.display = 'block';
                    pop.style.visibility = 'hidden';
                    var r = ikon.getBoundingClientRect();
                    var pw = pop.offsetWidth, ph = pop.offsetHeight;
                    var vw = document.documentElement.clientWidth;
                    var vh = document.documentElement.clientHeight;
                    var left = r.left + r.width / 2 - pw / 2;
                    left = Math.max(8, Math.min(left, vw - pw - 8));
                    var top = r.top - ph - 10;             // once ustte
                    if (top < 8) top = r.bottom + 10;      // ustte sigmazsa altta
                    if (top + ph > vh - 8) top = Math.max(8, vh - ph - 8);
                    pop.style.left = left + 'px';
                    pop.style.top = top + 'px';
                    pop.style.visibility = 'visible';
                    acikIkon = ikon;
                }

                document.addEventListener('click', function (e) {
                    var ikon = e.target.closest('.adat-info');
                    if (ikon) {
                        e.preventDefault(); e.stopPropagation();
                        if (acikIkon === ikon) kapat(); else ac(ikon);
                        return;
                    }
                    if (!e.target.closest('.adat-popover')) kapat();
                });
                document.addEventListener('keydown', function (e) { if (e.key === 'Escape') kapat(); });
                window.addEventListener('resize', kapat);
                window.addEventListener('scroll', kapat, true);
            })();

            const monthsTr = ["OCAK", "ŞUBAT", "MART", "NİSAN", "MAYIS", "HAZİRAN", "TEMMUZ", "AĞUSTOS", "EYLÜL", "EKİM", "KASIM", "ARALIK"];
            const formatMoney = (n) => n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const formatNum = (n) => n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const formatDate = (dateObj) => String(dateObj.getDate()).padStart(2, '0') + '.' + String(dateObj.getMonth() + 1).padStart(2, '0') + '.' + dateObj.getFullYear();
            
            const formatDateTime = (dateStr) => {
                if(!dateStr) return '-';
                let d = new Date(dateStr);
                return String(d.getDate()).padStart(2, '0') + '.' + String(d.getMonth() + 1).padStart(2, '0') + '.' + d.getFullYear() + ' ' + String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
            };

            let currentSimulationData = [];

            // Global Filtre Temizleyici
            window.clearReportFilters = function () {
                $('#bpCode').val(null).trigger('change');
                $('.invoice-checkbox, #masterCheckbox').prop('checked', false);
                $('#chkUseDynamicDueDate').prop('checked', false).trigger('change');
                calculateRapor17Adat();
            };

            // Vade Değiştirme (Dinamik Ödeme Koşulu Checkbox Toggle)
            $('#chkUseDynamicDueDate').change(function() {
                const isChecked = $(this).is(':checked');
                const today = new Date();
                today.setHours(0,0,0,0);

                $('.invoice-row').each(function() {
                    const row = $(this);
                    
                    let newDueDateStr = isChecked ? row.attr('data-dynamic-duedate') : row.attr('data-original-duedate');
                    let newDueDateText = isChecked ? row.attr('data-dynamic-duedate-text') : row.attr('data-original-duedate-text');

                    // Attribut ve Görünümü Güncelle
                    row.attr('data-duedate', newDueDateStr);
                    row.find('.due-date-cell').text(newDueDateText);

                    // Gecikme Günü Hücresini Güncelle
                    const dueDateObj = new Date(newDueDateStr);
                    dueDateObj.setHours(0,0,0,0);
                    const diffTime = today.getTime() - dueDateObj.getTime();
                    const diffDays = Math.round(diffTime / (1000 * 3600 * 24));

                    const delayCell = row.find('.delay-days-cell');
                    delayCell.text(diffDays);
                    if(diffDays > 0) {
                        delayCell.removeClass('text-success').addClass('text-danger fw-bold');
                    } else {
                        delayCell.removeClass('text-danger fw-bold').addClass('text-success');
                    }
                });

                // Hesaplamaları ve tabloları komple yeniden çalıştır
                calculateRapor17Adat();
            });

            // Turkce/ondalik guvenli tutar cozumleme (binlik ayraci temizler, ondalik virgul/nokta destekler)
            function paraCoz(v) {
                if (v === null || v === undefined) return NaN;
                var s = v.toString().trim();
                if (s === '') return NaN;
                if (s.indexOf(',') > -1 && s.indexOf('.') > -1) {
                    if (s.lastIndexOf(',') > s.lastIndexOf('.')) s = s.replace(/\./g, '').replace(',', '.');
                    else s = s.replace(/,/g, '');
                } else if (s.indexOf(',') > -1) {
                    s = s.replace(',', '.');
                }
                return parseFloat(s);
            }

            // ===== Tablo siralama: basliga tikla -> artan / tekrar tikla -> azalan =====
            // Durum tablo id'sine gore tutulur; govdesi yeniden cizilen tablolarda (aylik, simulasyon, mutabakat) tekrar uygulanir.
            const siralamaDurumu = {};
            function hucreDegeri(td) {
                if (!td) return '';
                const inp = td.querySelector('input:not([type=checkbox]), select');
                const s = (inp ? inp.value : td.textContent).trim();
                let m = s.match(/^(\d{2})\.(\d{2})\.(\d{4})/);
                if (m) return new Date(+m[3], +m[2] - 1, +m[1]).getTime();
                m = s.match(/^(\d{4})-(\d{2})-(\d{2})$/);
                if (m) return new Date(+m[1], +m[2] - 1, +m[3]).getTime();
                const sayi = s.replace(/₺|TL|Gün|%|\s/g, '');
                if (/^-?[\d.,]+$/.test(sayi)) { const n = paraCoz(sayi); if (!isNaN(n)) return n; }
                return s.toLocaleLowerCase('tr-TR');
            }
            function degerKarsilastir(a, b) {
                const na = typeof a === 'number', nb = typeof b === 'number';
                if (na && nb) return a - b;
                if (na) return -1;
                if (nb) return 1;
                return a.localeCompare(b, 'tr');
            }
            function tabloyuSirala(table) {
                const d = siralamaDurumu[table.id];
                const tbody = table.tBodies[0];
                if (!d || !tbody) return;
                const satirlar = Array.from(tbody.rows).filter(r => r.cells.length > d.col);
                satirlar.sort((x, y) => d.dir * degerKarsilastir(hucreDegeri(x.cells[d.col]), hucreDegeri(y.cells[d.col])));
                satirlar.forEach(r => tbody.appendChild(r));
                $(table).find('thead .sirala-ikon').removeClass('fa-sort-up fa-sort-down aktif').addClass('fa-sort');
                $(table).find('thead tr:first th').eq(d.col).find('.sirala-ikon').removeClass('fa-sort').addClass((d.dir === 1 ? 'fa-sort-up' : 'fa-sort-down') + ' aktif');
            }
            function siralamaIkonlariEkle(kok) {
                $(kok).find('table').addBack('table').each(function () {
                    if (!this.id) return;
                    $(this).find('thead tr:first th').each(function () {
                        const $th = $(this);
                        if ($th.hasClass('siralanabilir') || $th.find('input').length || !$th.text().trim()) return;
                        $th.addClass('siralanabilir').append('<i class="fas fa-sort sirala-ikon"></i>');
                    });
                    tabloyuSirala(this);
                });
            }
            $(document).on('click', 'th.siralanabilir', function (e) {
                if ($(e.target).closest('.adat-info, input, button, .resizable-column-handle').length) return;
                const table = this.closest('table');
                const col = $(this).index();
                const d = siralamaDurumu[table.id];
                siralamaDurumu[table.id] = { col: col, dir: (d && d.col === col && d.dir === 1) ? -1 : 1 };
                tabloyuSirala(table);
            });
            window.adatSiralama = { ikonEkle: siralamaIkonlariEkle, uygula: tabloyuSirala };

            // Odeme satirini (yeni / kayitli; duzenlenebilir input ya da kilitli metin) tek yerden okur.
            // Kayitli satirda tip tutulmuyor: evrak no "NAKİT" ise nakit sayilir (Nakit butonu bunu yaziyor).
            function odemeSatiriOku(row) {
                const yeni = row.hasClass('check-row-new');
                const $no = row.find(yeni ? '.check-number' : '.existing-checknumber');
                const no = ($no.length ? $no.val() : row.find('td:eq(3)').text()).trim();
                const $vade = row.find(yeni ? '.check-duedate' : '.existing-duedate');
                const vade = $vade.length ? $vade.val() : (row.attr('data-duedate') || '');
                const $tutar = row.find(yeni ? '.check-amount' : '.existing-amount');
                const tutar = $tutar.length ? paraCoz($tutar.val()) : parseFloat(row.attr('data-amount'));
                const nakit = yeni ? row.find('td:eq(1)').text().trim() === 'Nakit' : no.toLocaleUpperCase('tr-TR') === 'NAKİT';
                return { Tip: nakit ? 'Nakit' : 'Çek', No: no, Vade: vade, Tutar: tutar };
            }

            function seciliOdemeler() {
                const liste = [];
                $('#checksTableBody tr').each(function () {
                    if ($(this).find('.check-checkbox, .check-checkbox-existing').is(':checked')) liste.push(odemeSatiriOku($(this)));
                });
                return liste;
            }

            function calculateRapor17Adat() {
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                const interestRate = parseFloat($('#interestRate').val()) || 0;
                const GUN = 1000 * 3600 * 24;

                // Gecersiz / absurd tarih korumasi: 62027 gibi hatali yil girisi 21 milyon gunluk satir uretmesin.
                const gecersizTarihler = [];
                function gecerliTarih(d, etiket) {
                    if (!(d instanceof Date) || isNaN(d.getTime())) { gecersizTarihler.push(etiket + ' (geçersiz tarih)'); return false; }
                    const y = d.getFullYear();
                    if (y < 2000 || y > 2100) { gecersizTarihler.push(etiket + ' (' + y + ' yılı hatalı)'); return false; }
                    return true;
                }

                // ===== TEK KAYNAK: yalnizca SECILI faturalar. Ust kartlar + aylik tablo + simulasyon ayni kumeyi kullanir. =====
                let simInvoices = [];
                let totalInvBalance = 0, totalInvAdatNumber = 0;
                $('.invoice-checkbox:checked').each(function () {
                    const row = $(this).closest('tr');
                    let amount = paraCoz(row.find('.calc-amount-input').val());
                    if (isNaN(amount)) amount = 0;
                    const dueDateStr = row.attr('data-duedate');
                    if (amount !== 0 && dueDateStr) {
                        const dueDate = new Date(dueDateStr); dueDate.setHours(0, 0, 0, 0);
                        if (!gecerliTarih(dueDate, 'Fatura ' + row.find('td:eq(1)').text().trim())) return;
                        const gun = (today.getTime() - dueDate.getTime()) / GUN;
                        totalInvBalance += amount;
                        totalInvAdatNumber += amount * gun;
                        simInvoices.push({ DocNum: row.find('td:eq(1)').text().trim(), DueDateObj: dueDate, DueDateStr: formatDate(dueDate), Balance: amount });
                    }
                });

                // ===== SECILI odemeler / cekler =====
                let simPayments = [];
                let totalChkBalance = 0, totalChkAdatNumber = 0;
                seciliOdemeler().forEach(p => {
                    if (!p.Vade || isNaN(p.Tutar)) return;
                    const checkDate = new Date(p.Vade); checkDate.setHours(0, 0, 0, 0);
                    if (!gecerliTarih(checkDate, p.Tip + ' ' + p.No)) return;
                    const gun = (today.getTime() - checkDate.getTime()) / GUN;
                    totalChkBalance += p.Tutar;
                    totalChkAdatNumber += p.Tutar * gun;
                    simPayments.push({ DueDateObj: checkDate, DueDateStr: formatDate(checkDate), Balance: p.Tutar, Tip: p.Tip, No: p.No });
                });

                simInvoices.sort((a, b) => a.DueDateObj - b.DueDateObj);
                // Tarihe gore; ayni gunde once nakit kapatir, sonra cek
                simPayments.sort((a, b) => (a.DueDateObj - b.DueDateObj) || ((a.Tip === 'Nakit' ? 0 : 1) - (b.Tip === 'Nakit' ? 0 : 1)));

                // ===== FIFO simulasyonu: butun hesaplarin TEK dogru kaynagi =====
                currentSimulationData = [];
                let simHtml = '';
                let monthlyGroups = {};
                let toplamVf = 0;

                function ayGrubu(key, monthName, sortDate) {
                    if (!monthlyGroups[key]) monthlyGroups[key] = { monthName: monthName, sortDate: sortDate, tutar: 0, weightedDueSum: 0, gunAgirlik: 0, vf: 0 };
                    return monthlyGroups[key];
                }
                function satirEkle(belgeNo, odeme, vadeTarihi, gun, odenen, kalan, vf, ekGunClass) {
                    const odemeTarihi = odeme ? odeme.DueDateStr : '-';
                    const evrakNo = odeme && odeme.Tip !== 'Nakit' ? odeme.No : '';
                    currentSimulationData.push({ BelgeNo: belgeNo, OdemeTipi: odeme ? odeme.Tip : '-', EvrakNo: evrakNo, OdemeTarihi: odemeTarihi, VadeTarihi: vadeTarihi, Gun: Math.round(gun), Odenen: (typeof odenen === 'number' ? odenen : 0), KalanBakiye: (typeof kalan === 'number' ? kalan : 0), VFTutari: vf });
                    const odStr = (typeof odenen === 'number') ? formatMoney(odenen) : odenen;
                    const klStr = (typeof kalan === 'number') ? formatMoney(kalan) : kalan;
                    const odemeHtml = !odeme ? '-' : (odeme.Tip === 'Nakit' ? '<span class="badge bg-info text-dark">Nakit</span>' : `<span class="badge bg-success">Çek</span> ${$('<div>').text(evrakNo).html()}`);
                    simHtml += `<tr><td>${belgeNo}</td><td>${odemeHtml}</td><td>${odemeTarihi}</td><td>${vadeTarihi}</td><td class="text-center ${ekGunClass || ''}">${Math.round(gun)}</td><td class="text-end">${odStr}</td><td class="text-end">${klStr}</td><td class="text-end ${vf < 0 ? 'text-success' : (vf > 0 ? 'text-danger' : '')}">${formatMoney(vf)}</td></tr>`;
                }

                let pIndex = 0;
                simInvoices.forEach(inv => {
                    let invBalance = inv.Balance;
                    const ayKey = `${inv.DueDateObj.getFullYear()}-${(inv.DueDateObj.getMonth() + 1).toString().padStart(2, '0')}`;
                    const ayAd = `${monthsTr[inv.DueDateObj.getMonth()]} ${inv.DueDateObj.getFullYear()}`;
                    const g = ayGrubu(ayKey, ayAd, inv.DueDateObj.getTime());
                    g.weightedDueSum += inv.Balance * inv.DueDateObj.getTime();

                    if (invBalance <= 0) {
                        // negatif/sifir bakiyeli fatura (iade vb.) -> bugune gore
                        const gun = (today.getTime() - inv.DueDateObj.getTime()) / GUN;
                        const vf = (invBalance * interestRate * gun) / 3000;
                        toplamVf += vf; g.tutar += invBalance; g.gunAgirlik += invBalance * gun; g.vf += vf;
                        satirEkle(inv.DocNum, null, inv.DueDateStr, gun, 0, invBalance, vf, '');
                        return;
                    }

                    while (invBalance > 0 && pIndex < simPayments.length) {
                        let payment = simPayments[pIndex];
                        if (payment.Balance <= 0) { pIndex++; continue; }
                        const applied = Math.min(invBalance, payment.Balance);
                        invBalance -= applied; payment.Balance -= applied;
                        const gun = (payment.DueDateObj.getTime() - inv.DueDateObj.getTime()) / GUN; // odeme vadesi - fatura vadesi
                        const vf = (applied * interestRate * gun) / 3000;
                        toplamVf += vf; g.tutar += applied; g.gunAgirlik += applied * gun; g.vf += vf;
                        satirEkle(inv.DocNum, payment, inv.DueDateStr, gun, applied, invBalance, vf, '');
                        if (payment.Balance <= 0.0001) pIndex++;
                    }

                    if (invBalance > 0) {
                        // kapanmadan kalan fatura: vadesi gecmisse bugune kadar isler; vadesi gelmemisse
                        // vadesinde odenecek sayilir (gun 0). Aksi halde odenmemis borc lehte (-) VF uretir ve
                        // bugun girilen nakit, ayni negatif gunu tasidigi icin toplami hic degistirmezdi.
                        const gun = Math.max(0, (today.getTime() - inv.DueDateObj.getTime()) / GUN);
                        const vf = (invBalance * interestRate * gun) / 3000;
                        toplamVf += vf; g.tutar += invBalance; g.gunAgirlik += invBalance * gun; g.vf += vf;
                        satirEkle(inv.DocNum, null, inv.DueDateStr, gun, 0, invBalance, vf, (gun > 0 ? 'text-danger' : ''));
                    }
                });

                // ===== Faturalara eslesmeyen ARTAN odemeler (avans / fazla odeme) -> kaybolmasin; musteri lehine (-) VF =====
                for (let i = pIndex; i < simPayments.length; i++) {
                    const p = simPayments[i];
                    if (p.Balance <= 0.0001) continue;
                    // gecmis tarihli fazla odeme -> negatif gun, VF lehte (-). Ileri tarihli fazla odeme borc
                    // kapattiktan sonra artan kisimdir; musteriye vade farki yazilmaz (gun 0).
                    const gun = Math.min(0, (p.DueDateObj.getTime() - today.getTime()) / GUN);
                    const vf = (p.Balance * interestRate * gun) / 3000;
                    toplamVf += vf;
                    const g = ayGrubu('ZZZZ-FAZLA', 'FAZLA ÖDEME (AVANS)', 8.64e15);
                    g.tutar += p.Balance; g.weightedDueSum += p.Balance * p.DueDateObj.getTime(); g.gunAgirlik += p.Balance * gun; g.vf += vf;
                    satirEkle('(Fazla Ödeme)', p, '-', gun, p.Balance, '-', vf, 'text-primary');
                }

                if (currentSimulationData.length === 0) simHtml = '<tr><td colspan="8" class="text-center text-muted py-3">Simülasyon için seçili fatura/ödeme bulunamadı.</td></tr>';
                $('#simulationTableBody').html(simHtml);
                tabloyuSirala(document.getElementById('tblSimulasyon'));

                // ===== Ozet degerler (tek gercek toplam = FIFO) =====
                const avgInvDays = totalInvBalance > 0 ? totalInvAdatNumber / totalInvBalance : 0;
                const avgChkDays = totalChkBalance > 0 ? totalChkAdatNumber / totalChkBalance : 0;
                const netBalance = totalInvBalance - totalChkBalance;
                // Tutar agirlikli net gun, FIFO adatindan: VF ile birebir orantili (VF = Toplam Fatura × gun × oran ÷ 3000).
                const toplamAdat = Object.values(monthlyGroups).reduce((s, grp) => s + grp.gunAgirlik, 0);
                const netAdatDiffDays = totalInvBalance !== 0 ? toplamAdat / totalInvBalance : 0;
                const finalInterestAmount = toplamVf; // ust kart = aylik footer = simulasyon toplami

                // ===== Aylik tablo (simulasyondan turetildi -> satirlar footer'i birebir tutar) =====
                const tbody = $('#monthlyBreakdownBody');
                const tfoot = $('#monthlyBreakdownFooter');
                tbody.empty(); tfoot.empty();
                const sortedKeys = Object.keys(monthlyGroups).sort((a, b) => monthlyGroups[a].sortDate - monthlyGroups[b].sortDate);
                if (sortedKeys.length > 0) {
                    let toplamTutarGosterim = 0;
                    sortedKeys.forEach(key => {
                        const grp = monthlyGroups[key];
                        const avgDue = grp.tutar !== 0 ? grp.weightedDueSum / grp.tutar : grp.sortDate;
                        const netGun = grp.tutar !== 0 ? grp.gunAgirlik / grp.tutar : 0;
                        toplamTutarGosterim += grp.tutar;
                        tbody.append(`<tr>
                            <td class="fw-bold text-center">${grp.monthName}</td>
                            <td class="text-center">${formatDate(new Date(avgDue))}</td>
                            <td class="text-end">${formatMoney(grp.tutar)}</td>
                            <td class="text-center ${netGun > 0 ? 'text-danger' : 'text-success'} fw-bold" style="background-color: #f0f8ff;">${formatNum(netGun)} Gün</td>
                            <td class="text-end ${grp.vf > 0 ? 'text-danger' : 'text-success'} fw-bold">${formatMoney(grp.vf)}</td>
                        </tr>`);
                    });
                    tfoot.append(`<tr class="total-row"><td colspan="2" class="text-end">TOPLAM:</td><td class="text-end">${formatMoney(toplamTutarGosterim)}</td><td class="text-center text-muted">-</td><td class="text-end ${finalInterestAmount > 0 ? 'text-danger' : 'text-success'}">${formatMoney(finalInterestAmount)}</td></tr>`);
                } else {
                    tbody.html('<tr><td colspan="5" class="text-center text-muted py-3">Seçili fatura bulunmamaktadır.</td></tr>');
                }

                tabloyuSirala(document.getElementById('tblAylik'));

                // ===== Ust kartlar =====
                $('#lblInvoiceTotal').text(formatMoney(totalInvBalance));
                $('#lblInvoiceAdatDays').html(`${totalInvBalance > 0 ? formatDate(new Date(today.getTime() - (avgInvDays * 86400000))) : "-"} <br> <small>(${formatNum(avgInvDays)} Gün)</small>`);
                $('#lblCheckTotal').text(formatMoney(totalChkBalance));
                $('#lblCheckAdatDays').html(`${totalChkBalance > 0 ? formatDate(new Date(today.getTime() - (avgChkDays * 86400000))) : "-"} <br> <small>(${formatNum(avgChkDays)} Gün)</small>`);
                $('#lblNetBalance').text(formatMoney(netBalance));
                $('#lblNetAdatDiff').text(formatNum(netAdatDiffDays) + " Gün").removeClass('text-danger text-success').addClass(netAdatDiffDays > 0 ? 'text-danger' : 'text-success');
                $('#netInterestContainer').html(`<div class="card bg-light border-0 mt-2"><div class="card-body p-2"><h6 class="text-muted mb-1" style="font-size:0.9em">${finalInterestAmount > 0 ? 'Ödenmesi Gereken Vade Farkı' : 'Hesaplanan Vade Farkı (Lehte)'}:</h6><h3 class="${finalInterestAmount > 0 ? 'text-danger' : 'text-success'} fw-bold m-0">${formatMoney(finalInterestAmount)} TL</h3><small class="text-muted fst-italic">(FIFO eşleştirmesine göre)</small></div></div>`);

                // Hatali tarihli kayitlar hesaba KATILMADI -> kullaniciyi uyar (62027 gibi yil hatalarini yakalar).
                const uy = document.getElementById('tarihUyari');
                if (uy) {
                    if (gecersizTarihler.length > 0) {
                        uy.innerHTML = '<b><i class="fas fa-exclamation-triangle me-1"></i>Hatalı tarih:</b> ' + gecersizTarihler.join(' · ') + ' — bu kayıt(lar) hesaba KATILMADI. Lütfen tarihi düzeltin (yıl 2000–2100 olmalı).';
                        uy.hidden = false;
                    } else {
                        uy.hidden = true;
                    }
                }
            }

            $(document).on('change', '.invoice-checkbox, .check-checkbox, .check-checkbox-existing', calculateRapor17Adat);
            $(document).on('input', '.calc-amount-input, .check-amount, .check-duedate, #interestRate', function() { calculateRapor17Adat(); });

            // ÇEK/NAKİT VADE TARİHİ ANLIK DOĞRULAMA: 31.06 / 31.11 gibi olmayan gün ya da 62027 gibi yıl girilirse
            // alan boş/hatalı kalır -> anında kırmızı işaretle + uyar (kullanıcı fark etmeden hesaba girmesin).
            function cekTarihGecerliMi(el) {
                const $el = $(el);
                const v = $el.val();
                let ok = false;
                if (v) {
                    const d = new Date(v);
                    ok = !isNaN(d.getTime()) && d.getFullYear() >= 2000 && d.getFullYear() <= 2100;
                }
                $el.toggleClass('is-invalid', !ok);
                return ok;
            }
            $(document).on('change blur', '.check-duedate', function () {
                if (!cekTarihGecerliMi(this)) {
                    toastr.warning('Geçersiz vade tarihi. Takvimde olan bir gün ve 2000–2100 arası yıl girin (örn. 31 Haziran / 31 Kasım yoktur).');
                }
            });

            $('#selectAllBtn').click(function(e){ e.preventDefault(); $('.invoice-checkbox').prop('checked', true); $('#masterCheckbox').prop('checked', true); calculateRapor17Adat(); });
            $('#deselectAllBtn').click(function(e){ e.preventDefault(); $('.invoice-checkbox').prop('checked', false); $('#masterCheckbox').prop('checked', false); calculateRapor17Adat(); });
            $('#masterCheckbox').change(function(){ $('.invoice-checkbox').prop('checked', $(this).is(':checked')); calculateRapor17Adat(); });

            // Yerel tarih (toISOString UTC'dir; TR'de 00:00-03:00 arasi dunu verirdi)
            function bugunIso() {
                const d = new Date();
                return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
            }

            function addRow(type) {
                const row = `<tr class="check-row-new"><td class="text-center"><input type="checkbox" class="check-checkbox" checked /></td><td>${type === 'Nakit' ? '<span class="badge bg-info text-dark">Nakit</span>' : '<span class="badge bg-success">Çek</span>'}</td><td><input type="date" class="form-control form-control-sm check-duedate" min="2000-01-01" max="2100-12-31" value="${bugunIso()}" /></td><td><input type="text" class="form-control form-control-sm check-number" value="${type === 'Nakit' ? 'NAKİT' : ''}" placeholder="Evrak No" /></td><td><input type="text" inputmode="decimal" class="form-control form-control-sm check-amount tr-para" placeholder="0,00" /></td><td><button class="btn btn-xs btn-danger remove-row"><i class="fas fa-trash"></i></button></td></tr>`;
                $('#checksTableBody').append(row); calculateRapor17Adat();
            }
            $('#addCashBtn').click(() => addRow('Nakit'));
            $('#addCheckBtn').click(() => addRow('Çek'));
            $(document).on('click', '.remove-row', function() { $(this).closest('tr').remove(); calculateRapor17Adat(); });
            $(document).on('click', '.remove-existing-btn', function() {
                if (!confirm('Silmek istediğinize emin misiniz? Bu işlem kalıcıdır.')) return;
                const row = $(this).closest('tr');
                const docEntry = $(this).data('docentry');
                const btn = $(this);
                btn.prop('disabled', true);
                $.ajax({
                    url: '/Rapor21/DeleteCheck' + dbQueryString,
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': antiForgeryToken },
                    data: JSON.stringify(docEntry),
                    success: function () { row.remove(); calculateRapor17Adat(); },
                    error: function (err) {
                        alert("Silinemedi:\n" + (err.responseText || err.statusText));
                        btn.prop('disabled', false);
                    }
                });
            });

            function postJson(url, payload) {
                return $.ajax({
                    url: url + dbQueryString, type: 'POST', contentType: 'application/json',
                    headers: { 'RequestVerificationToken': antiForgeryToken },
                    data: payload !== undefined ? JSON.stringify(payload) : undefined
                });
            }

            // Onay tablosu (@@CheckApproval) bazı şirketlerde bu ekrandaki alanlar eklenmeden önce
            // oluşturulmuş olabilir ("Invalid column name..." hatası). Kayıt/gönderme hata verirse
            // sessizce SetupOnayTablosu ile eksik alanlar SAP Service Layer'dan tamamlanır ve işlem
            // bir kez daha denenir; onarım da işe yaramazsa ilk hatanın kendisi gösterilir.
            function postJsonOnarmayiDene(url, payload, basariFn, hataFn) {
                postJson(url, payload).done(basariFn).fail(function (ilkHata) {
                    postJson('/Rapor21/SetupOnayTablosu').always(function () {
                        postJson(url, payload).done(basariFn).fail(function () { hataFn(ilkHata); });
                    });
                });
            }

            // Kayitli (taslak) satirlarda yapilan degisiklikleri gunceller
            $('#updateExistingBtn').click(function () {
                const bpCode = '@Model.SelectedBpCode';
                if (!bpCode) { alert("Önce bir cari seçiniz."); return; }

                let rows = [];
                $('.existing-check-row').each(function () {
                    const de = $(this).data('docentry');
                    const $amt = $(this).find('.existing-amount');
                    if (de && $amt.length) {
                        const amountStr = $amt.val();
                        if (amountStr && amountStr.trim() !== "") {
                            rows.push({
                                DocEntry: String(de),
                                CheckNumber: $(this).find('.existing-checknumber').val() || "İsimsiz",
                                DueDate: $(this).find('.existing-duedate').val(),
                                Amount: amountStr
                            });
                        }
                    }
                });

                if (rows.length === 0) { alert("Güncellenecek kayıtlı (taslak) satır bulunamadı. Onaya gönderilmiş/onaylı satırlar düzenlenemez."); return; }

                const safeBpName = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.BpName ?? ""));
                const payload = { BpCode: bpCode, BpName: safeBpName, CheckRows: rows };

                const btn = $(this);
                const originalHtml = btn.html();
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Güncelleniyor...');

                postJson('/Rapor21/UpdateCheckEntries', payload)
                    .done(function (res) {
                        toastr.success(res || 'Güncellendi.');
                        window.location.reload();
                    })
                    .fail(function (err) {
                        alert("Hata Oluştu:\n" + (err.responseText || err.statusText));
                        btn.prop('disabled', false).html(originalHtml);
                    });
            });

            // Kayitli satir input'u degisince adat hesabi icin tr'deki data-* degerlerini tazele
            $(document).on('input change', '.existing-amount, .existing-duedate', function () {
                const $tr = $(this).closest('tr');
                const amt = $tr.find('.existing-amount').val();
                const due = $tr.find('.existing-duedate').val();
                if (amt !== undefined && amt !== null) {
                    const num = parseFloat(String(amt).replace(/\./g, '').replace(',', '.'));
                    if (!isNaN(num)) $tr.attr('data-amount', num);
                }
                if (due) $tr.attr('data-duedate', due);
                if (typeof calculateRapor17Adat === 'function') calculateRapor17Adat();
            });

            $('#sendToApprovalBtn').click(function () {
                const approverCode = $('#approverSelect').val();
                if(!approverCode){
                    alert("Lütfen önce bir onaycı seçiniz!");
                    return;
                }

                let newChecks = [];
                $('.check-row-new').each(function() {
                    if($(this).find('.check-checkbox').is(':checked')) {
                        let rawAmountStr = $(this).find('.check-amount').val();
                        if(rawAmountStr && rawAmountStr.trim() !== "") {
                            newChecks.push({
                                CheckNumber: $(this).find('.check-number').val() || "İsimsiz",
                                DueDate: $(this).find('.check-duedate').val(),
                                Amount: rawAmountStr
                            });
                        }
                    }
                });

                if(newChecks.length === 0) { 
                    alert("Onaya gönderilecek listeye yeni çek / nakit eklemediniz veya ekledikleriniz işaretli değil."); 
                    return; 
                }

                if(!confirm(`Seçili ${newChecks.length} adet evrak ${approverCode} kodlu kişiye onaya gönderilecek. Onaylıyor musunuz?`)) return;

                const safeBpName = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.BpName ?? ""));

                const payload = {
                    BpCode: '@Model.SelectedBpCode',
                    BpName: safeBpName,
                    ApproverCode: approverCode,
                    CheckRows: newChecks
                };

                const btn = $(this);
                const originalHtml = btn.html();
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Gönderiliyor...');

                postJsonOnarmayiDene('/Rapor21/SendForApproval', payload,
                    function (res) {
                        alert("İşlem Başarılı: " + res);
                        window.location.reload();
                    },
                    function (err) {
                        alert("Hata Oluştu:\n" + (err.responseText || err.statusText));
                        btn.prop('disabled', false).html(originalHtml);
                    }
                );
            });

            // Onaya göndermeden, sadece bu carideki ödeme/çek listesini kaydeder — bir sonraki
            // girişte GetCheckStatus zaten kayıtlı satırları "checked" olarak geri getirip hesaba katıyor.
            $('#saveDraftBtn').click(function () {
                const bpCode = '@Model.SelectedBpCode';
                if (!bpCode) { alert("Önce bir cari seçiniz."); return; }

                let rows = [];
                $('.check-row-new').each(function () {
                    if ($(this).find('.check-checkbox').is(':checked')) {
                        let rawAmountStr = $(this).find('.check-amount').val();
                        if (rawAmountStr && rawAmountStr.trim() !== "") {
                            rows.push({
                                CheckNumber: $(this).find('.check-number').val() || "İsimsiz",
                                DueDate: $(this).find('.check-duedate').val(),
                                Amount: rawAmountStr
                            });
                        }
                    }
                });

                if (rows.length === 0) { alert("Kaydedilecek yeni ödeme/çek satırı bulunamadı veya işaretli değil."); return; }

                const safeBpName = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.BpName ?? ""));
                const payload = { BpCode: bpCode, BpName: safeBpName, CheckRows: rows };

                const btn = $(this);
                const originalHtml = btn.html();
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Kaydediliyor...');

                postJsonOnarmayiDene('/Rapor21/SaveDraftEntries', payload,
                    function () {
                        toastr.success('Kaydedildi. Bu cariye bir sonraki girişte otomatik yüklenecek.');
                        window.location.reload();
                    },
                    function (err) {
                        alert("Kaydetme hatası:\n" + (err.responseText || err.statusText));
                        btn.prop('disabled', false).html(originalHtml);
                    }
                );
            });

            $('#btnShowApprovals').click(function() {
                const btn = $(this);
                const originalHtml = btn.html();
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Yükleniyor...');

                $.get('/Rapor21/GetMyPendingApprovalsJson' + dbQueryString, function(data) {
                    const tbody = $('#tblPendingApprovals tbody');
                    tbody.empty();
                    
                    if(data && data.length > 0) {
                        data.forEach(item => {
                            let dueDate = item.u_BE1_DUEDATE ? new Date(item.u_BE1_DUEDATE).toLocaleDateString('tr-TR') : '-';
                            let createDate = formatDateTime(item.createDate);
                            let amount = item.u_BE1_AMOUNT ? item.u_BE1_AMOUNT.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '0,00';
                            
                            tbody.append(`
                                <tr>
                                    <td class="text-center"><input type="checkbox" class="chk-approval" value="${item.docEntry}" /></td>
                                    <td>${item.docEntry}</td>
                                    <td><small>${item.u_BE1_CARDCODE}</small><br/>${item.u_BE1_CARDNAME}</td>
                                    <td>${item.u_BE1_CHECKNUMBER}</td>
                                    <td>${dueDate}</td>
                                    <td>${item.creator || '-'}</td>
                                    <td>${createDate}</td>
                                    <td class="text-end fw-bold">${amount} ₺</td>
                                </tr>
                            `);
                        });
                    } else {
                        tbody.append('<tr><td colspan="8" class="text-center text-muted">Onay bekleyen işleminiz bulunmamaktadır.</td></tr>');
                    }
                    
                    tabloyuSirala(document.getElementById('tblPendingApprovals'));
                    var myModal = new bootstrap.Modal(document.getElementById('approvalModal'));
                    myModal.show();
                }).fail(function(err) {
                    if(err.status === 401) alert("Yetkisiz erişim. Bu ekranı görüntülemeye yetkiniz yok.");
                    else alert("Veriler çekilirken bir hata oluştu.");
                }).always(function() {
                    btn.prop('disabled', false).html(originalHtml);
                });
            });

            $('#chkAllApprovals').change(function() {
                $('.chk-approval').prop('checked', $(this).is(':checked'));
            });

            function processApproval(actionType) {
                const selectedIds = [];
                $('.chk-approval:checked').each(function() {
                    selectedIds.push($(this).val());
                });

                if(selectedIds.length === 0) {
                    alert("Lütfen işlem yapmak için en az bir kayıt seçin.");
                    return;
                }

                if(!confirm(`Seçili ${selectedIds.length} kaydı ${actionType === 'PerformApproval' ? 'ONAYLAMAK' : 'REDDETMEK'} istediğinize emin misiniz?`)) return;

                const payload = { DocEntries: selectedIds };

                $.ajax({
                    url: '/Rapor21/' + actionType + dbQueryString,
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': antiForgeryToken },
                    data: JSON.stringify(payload),
                    success: function(res) {
                        alert("İşlem başarıyla tamamlandı: " + res);
                        $('#approvalModal').modal('hide');
                        window.location.reload(); 
                    },
                    error: function(err) {
                        if(err.status === 401) alert("Bu işlemi yapmaya yetkiniz bulunmamaktadır.");
                        else alert("Hata oluştu: " + err.responseText);
                    }
                });
            }

            $('#btnApproveSelected').click(() => processApproval('PerformApproval'));
            $('#btnRejectSelected').click(() => processApproval('DeclineApproval'));

            $('#btnShowApprovalHistory').click(function() {
                const btn = $(this);
                const originalHtml = btn.html();
                
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Yükleniyor...');

                $.get('/Rapor21/GetApprovalHistoryJson' + dbQueryString, function(data) {
                    const tbody = $('#tblApprovalHistory tbody');
                    tbody.empty();
                    
                    if(data && data.length > 0) {
                        data.forEach(item => {
                            let dueDate = item.u_BE1_DUEDATE ? new Date(item.u_BE1_DUEDATE).toLocaleDateString('tr-TR') : '-';
                            let updateDate = formatDateTime(item.updateDate);
                            let amount = item.u_BE1_AMOUNT ? item.u_BE1_AMOUNT.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '0,00';
                            
                            let statusBadge = '';
                            if (item.u_BE1_APPROVALSTATUS === 'O') {
                                statusBadge = '<span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>Bekliyor</span>';
                            } else if (item.u_BE1_APPROVALSTATUS === 'Y') {
                                statusBadge = '<span class="badge bg-success"><i class="fas fa-check me-1"></i>Onaylandı</span>';
                            } else if (item.u_BE1_APPROVALSTATUS === 'N') {
                                statusBadge = '<span class="badge bg-danger"><i class="fas fa-times me-1"></i>Reddedildi</span>';
                            } else {
                                statusBadge = '<span class="badge bg-secondary">Bilinmiyor</span>';
                            }

                            tbody.append(`
                                <tr>
                                    <td>${item.docEntry}</td>
                                    <td><small>${item.u_BE1_CARDCODE}</small><br/>${item.u_BE1_CARDNAME}</td>
                                    <td>${item.u_BE1_CHECKNUMBER}</td>
                                    <td>${dueDate}</td>
                                    <td class="text-end fw-bold">${amount} ₺</td>
                                    <td class="text-center">${statusBadge}</td>
                                    <td>${item.creator || '-'}</td>
                                    <td>${item.u_BE1_APPROVERCODE || '-'}</td>
                                    <td>${updateDate}</td>
                                </tr>
                            `);
                        });
                    } else {
                        tbody.append('<tr><td colspan="9" class="text-center text-muted">Herhangi bir onay süreci kaydı bulunmamaktadır.</td></tr>');
                    }
                    
                    tabloyuSirala(document.getElementById('tblApprovalHistory'));
                    var historyModal = new bootstrap.Modal(document.getElementById('approvalHistoryModal'));
                    historyModal.show();
                }).fail(function(err) {
                    if(err.status === 401) alert("Yetkisiz erişim. Bu ekranı görüntülemeye yetkiniz yok.");
                    else alert("Onay geçmişi çekilirken bir hata oluştu.");
                }).always(function() {
                    btn.prop('disabled', false).html(originalHtml);
                });
            });

            // PDF/Excel ortak govdesi. Odemeler vade sirasiyla; tarih dd.MM.yyyy.
            function raporPayload(reportType) {
                const invoices = [];
                $('.invoice-row').each(function () {
                    const r = $(this);
                    invoices.push({
                        DocNum: r.find('td:eq(1)').text().trim(),
                        DocDate: r.find('td:eq(2)').text().trim(),
                        DueDate: r.find('td:eq(3)').text().trim(),
                        Amount: paraCoz(r.find('.calc-amount-input').val()) || 0
                    });
                });

                const payments = seciliOdemeler()
                    .filter(p => p.Vade && !isNaN(p.Tutar))
                    .sort((a, b) => (new Date(a.Vade) - new Date(b.Vade)) || ((a.Tip === 'Nakit' ? 0 : 1) - (b.Tip === 'Nakit' ? 0 : 1)))
                    .map(p => ({
                        Type: p.Tip,
                        CheckNumber: p.Tip === 'Nakit' ? '' : p.No,
                        DueDate: isNaN(new Date(p.Vade).getTime()) ? p.Vade : formatDate(new Date(p.Vade)),
                        Amount: p.Tutar
                    }));

                const monthlyData = [];
                $('#monthlyBreakdownBody tr').each(function () {
                    if (!$(this).find('td').hasClass('text-muted')) {
                        monthlyData.push({
                            MonthName: $(this).find('td:eq(0)').text().trim(),
                            AvgDate: $(this).find('td:eq(1)').text().trim(),
                            Amount: parseFloat($(this).find('td:eq(2)').text().replace(/\./g, '').replace(',', '.') || 0),
                            NetGecikme: $(this).find('td:eq(3)').text().trim(),
                            VadeFarki: parseFloat($(this).find('td:eq(4)').text().replace(/\./g, '').replace(',', '.') || 0)
                        });
                    }
                });

                return {
                    BpCode: '@Model.SelectedBpCode',
                    BpName: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.BpName ?? "")),
                    InterestRate: parseFloat($('#interestRate').val()) || 0,
                    ReportType: reportType,
                    Invoices: invoices,
                    Payments: payments,
                    MonthlySummaries: monthlyData,
                    SimulationRows: currentSimulationData
                };
            }

            $('.btnDownloadPdf').click(function () {
                const btn = $(this);
                const reportType = btn.data('type'); 
                const originalHtml = btn.html();
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> İndiriliyor...');
                
                const payload = raporPayload(reportType);
                
                fetch('/Rapor21/DownloadPdf' + dbQueryString, { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken }, 
                    body: JSON.stringify(payload) 
                })
                .then(response => { if (!response.ok) throw new Error("Hata."); return response.blob(); })
                .then(blob => { 
                    const url = window.URL.createObjectURL(blob); 
                    const a = document.createElement('a'); 
                    a.style.display = 'none'; 
                    a.href = url; 
                    let suffix = reportType === 'PART1' ? '_Faturalar' : (reportType === 'PART2' ? '_Tahsilat_Simulasyon' : '_Tam_Rapor'); 
                    a.download = `OdemePlani_@(Model.SelectedBpCode?.Trim() ?? "Cari")_` + new Date().toISOString().slice(0, 10).replace(/-/g, "") + suffix + `.pdf`; 
                    document.body.appendChild(a); 
                    a.click(); 
                    window.URL.revokeObjectURL(url); 
                })
                .catch(err => alert(err.message))
                .finally(() => { btn.prop('disabled', false).html(originalHtml); });
            });

            $('.btnDownloadExcel').click(function () {
                const btn = $(this);
                const reportType = btn.data('type');
                const originalHtml = btn.html();
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> İndiriliyor...');
                
                const payload = raporPayload(reportType);
                
                fetch('/Rapor21/DownloadExcel' + dbQueryString, { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken }, 
                    body: JSON.stringify(payload) 
                })
                .then(response => { if (!response.ok) throw new Error("Hata."); return response.blob(); })
                .then(blob => { 
                    const url = window.URL.createObjectURL(blob); 
                    const a = document.createElement('a'); 
                    a.style.display = 'none'; 
                    a.href = url; 
                    let suffix = reportType === 'PART1' ? '_Faturalar' : (reportType === 'PART2' ? '_Tahsilat_Simulasyon' : '_Tam_Rapor'); 
                    a.download = `OdemePlani_@(Model.SelectedBpCode?.Trim() ?? "Cari")_` + new Date().toISOString().slice(0, 10).replace(/-/g, "") + suffix + `.xlsx`; 
                    document.body.appendChild(a); 
                    a.click(); 
                    window.URL.revokeObjectURL(url); 
                })
                .catch(err => alert("Excel indirilirken hata oluştu: " + err.message))
                .finally(() => { btn.prop('disabled', false).html(originalHtml); });
            });

            // Varsayilan: acilista tum acik faturalar secili gelsin (ozet + aylik + simulasyon ayni kumeden dolsun).
            $('.invoice-checkbox').prop('checked', true);
            $('#masterCheckbox').prop('checked', true);

            siralamaIkonlariEkle(document);
            calculateRapor17Adat();

            // Onay tablosu / alanlari bu sirkette eksikse Service Layer ile tamamla ve sayfayi yenile.
            // Oturum basina sirket basina bir kez denenir (SAP yetkisi yoksa sonsuz yenileme olmasin).
            const onayEksikleri = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.OnayKurulumEksikleri ?? new List<string>()));
            if (onayEksikleri.length > 0) {
                const denemeAnahtari = 'r21-onay-kurulum-' + (currentDbParam || 'varsayilan');
                let denendi = false;
                try { denendi = sessionStorage.getItem(denemeAnahtari) === '1'; sessionStorage.setItem(denemeAnahtari, '1'); } catch (e) { }
                if (!denendi) {
                    toastr.info('Onay tablosunda eksikler var (' + onayEksikleri.join(', ') + '). SAP Service Layer ile tamamlanıyor...');
                    postJson('/Rapor21/SetupOnayTablosu')
                        .done(function (res) {
                            if (res && res.success) { toastr.success(res.message); setTimeout(() => window.location.reload(), 1200); }
                            else toastr.error((res && res.message) || 'Onay tablosu tamamlanamadı.');
                        })
                        .fail(function (err) { toastr.error('Onay tablosu tamamlanamadı: ' + (err.responseText || err.statusText)); });
                } else {
                    toastr.warning('Onay tablosunda eksikler var (' + onayEksikleri.join(', ') + '). Otomatik tamamlama bu oturumda denendi; çek kaydetme çalışmayabilir.');
                }
            }
        });
    </script>

    <script>
        /* MUTABAKAT YAP: Cari Ekstre (Rapor20) "Mutabakat Yap" penceresinin aynisi; ayni /Rapor20 servislerini cagirir. */
        const mtCari = '@Model.SelectedBpCode';
        const mtDbQuery = '@currentDb' ? '?db=@currentDb' : '';
        const mtToken = $('input[name="__RequestVerificationToken"]').val();
        let mtHedefDb = '@currentDb';
        let mtRobotInterval = null;
        let mtDegisti = false; // kapatma/iptal yapildiysa pencere kapaninca acik faturalar tazelenmeli

        const mtPara = (n) => n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const mtVadeKosulu = () => $('#chkUseDynamicDueDate').is(':checked');
        const mtEsc = (s) => $('<div>').text(s == null ? '' : String(s)).html();

        function mtSunucuHatasi(xhr) {
            let msg = 'Bilinmeyen Hata';
            if (xhr.status === 400) msg = 'Parametre hatası (400).';
            if (xhr.status === 403) msg = 'Bu işlem için yetkiniz bulunmuyor (403).';
            if (xhr.status === 404) msg = 'Metod bulunamadı (404).';
            if (xhr.status === 500) msg = 'Sunucu tarafında hata (500).';
            Swal.fire('Sunucu Hatası (Kod: ' + xhr.status + ')', msg + '<br><br><span style="font-size:12px;color:red;">Detay: ' + mtEsc(xhr.responseText ? xhr.responseText.substring(0, 150) : '') + '</span>', 'error');
        }

        function mtAc() {
            if (!mtCari) { Swal.fire('Uyarı', 'Lütfen önce bir cari seçip raporlayın.', 'warning'); return; }
            $('#mtIslemler').hide().empty();
            $('#mtParaFiltre').empty().hide();
            mtToplamlar();
            bootstrap.Modal.getOrCreateInstance(document.getElementById('mtModal')).show();
            mtIslemleriYukle();
        }

        $('#mtModal').on('hidden.bs.modal', function () {
            if (!mtDegisti) return;
            mtDegisti = false;
            Swal.fire({
                title: 'Açık faturalar değişti',
                html: 'Adat hesabının güncel faturalarla yapılması için sayfa yenilensin mi?<br><small class="text-muted">Kaydedilmemiş yeni çek/nakit satırları kaybolur.</small>',
                icon: 'question', showCancelButton: true, confirmButtonText: 'Evet, yenile', cancelButtonText: 'Hayır'
            }).then(r => { if (r.isConfirmed) window.location.reload(); });
        });

        function mtIslemleriYukle() {
            Swal.fire({ title: 'Açık İşlemler Çekiliyor...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
            const params = (mtDbQuery ? mtDbQuery + '&' : '?') + 'isConsolidated=false&useBpDueDate=' + mtVadeKosulu();
            $.ajax({
                url: '/Rapor20/GetOpenTransactions' + params,
                type: 'GET',
                data: { cardCode: mtCari },
                success: function (res) {
                    Swal.close();
                    if (res.success) mtTabloCiz(res.data);
                    else Swal.fire('Hata', res.message, 'error');
                },
                error: function (xhr) { Swal.close(); mtSunucuHatasi(xhr); }
            });
        }

        function mtParaFiltrele(currency, btn) {
            $('.mt-para-btn').removeClass('btn-primary').addClass('btn-outline-primary');
            $(btn).removeClass('btn-outline-primary').addClass('btn-primary');
            if (currency === 'ALL') {
                $('.mt-row').show();
            } else {
                $('.mt-row').hide().filter(function () {
                    return $(this).data('currency') === currency || $(this).data('kfcurrency') === currency;
                }).show();
            }
            $('.mt-row:hidden .mt-chk:checked').each(function () {
                $(this).prop('checked', false);
                mtSatirSec(this, parseFloat($(this).data('maxamount')), true);
            });
            $('.mt-chk-all').prop('checked', false);
            mtToplamlar();
        }

        function mtTabloCiz(data) {
            const container = $('#mtIslemler');
            container.empty();
            $('#mtParaFiltre').empty().hide();

            if (!data || data.length === 0) {
                container.html('<div class="alert alert-success text-center py-4 fw-bold"><i class="fas fa-check-circle fa-2x d-block mb-2"></i> Bakiye tamamen temiz! Kapatılacak açık işlem yok.</div>').fadeIn();
                mtToplamlar();
                return;
            }

            const paraBirimleri = new Set();
            data.forEach(i => { if (i.paraBirimi) paraBirimleri.add(i.paraBirimi); if (i.kurFarkiParaBirimi) paraBirimleri.add(i.kurFarkiParaBirimi); });
            const liste = Array.from(paraBirimleri).filter(c => c && c.trim() !== '');
            if (liste.length > 0) {
                let f = `<button class="btn btn-sm btn-primary mt-para-btn" data-currency="ALL" onclick="mtParaFiltrele('ALL', this)"><i class="fas fa-filter"></i> Tümü</button>`;
                liste.forEach(c => { f += `<button class="btn btn-sm btn-outline-primary mt-para-btn" data-currency="${mtEsc(c)}" onclick="mtParaFiltrele('${mtEsc(c)}', this)">${mtEsc(c)}</button>`; });
                $('#mtParaFiltre').html(f).show();
            }

            const gruplar = {};
            data.forEach(item => {
                const db = item.dbName || '@currentDb';
                if (!gruplar[db]) gruplar[db] = { companyName: item.companyName || db, items: [] };
                gruplar[db].items.push(item);
            });

            let tabs = '<ul class="nav nav-pills mb-3 mt-2" role="tablist">';
            let panes = '<div class="tab-content">';
            let ilk = true;
            for (const db in gruplar) {
                const comp = gruplar[db];
                tabs += `<li class="nav-item" role="presentation">
                            <button class="nav-link ${ilk ? 'active' : ''} fw-bold shadow-sm" data-bs-toggle="pill" data-bs-target="#mt-pane-${db}" type="button" role="tab" data-dbname="${db}">
                                <i class="fas fa-building me-1"></i> ${mtEsc(comp.companyName)} <span class="badge bg-danger ms-2">${comp.items.length}</span>
                            </button>
                         </li>`;
                panes += `<div class="tab-pane fade ${ilk ? 'show active' : ''}" id="mt-pane-${db}" role="tabpanel">
                            <div class="table-responsive bg-white border rounded shadow-sm" style="max-height: 500px; overflow-y: auto;">
                                <table class="table table-hover table-sm mb-0" id="mt-tbl-${db}" style="font-size:.88rem;">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th class="text-center" style="width: 50px;"><input class="form-check-input mt-chk-all bg-warning border-0" type="checkbox" onchange="mtTumunuSec(this, '${db}')" title="Tümünü Seç"></th>
                                            <th>Kayıt T.</th>
                                            <th>Vade T.</th>
                                            <th>Yevm/Satır</th>
                                            <th>İşlem Tipi</th>
                                            <th>Para Birimi</th>
                                            <th>Kur Farkı Para Birimi</th>
                                            <th class="text-end">Dövizli Borç</th>
                                            <th class="text-end">Dövizli Alacak</th>
                                            <th class="text-end">Açık Borç (TL)</th>
                                            <th class="text-end">Açık Alacak (TL)</th>
                                            <th>Açıklama</th>
                                            <th class="text-end pe-3">Kapatılacak Tutar</th>
                                        </tr>
                                    </thead>
                                    <tbody id="mt-tbody-${db}">`;

                comp.items.forEach(item => {
                    const borc = item.openDebit > 0;
                    const maxTutar = parseFloat(borc ? item.openDebit : item.openCredit).toFixed(2);
                    const pBirim = item.paraBirimi || 'TRY';
                    const kfBirim = item.kurFarkiParaBirimi || '';
                    const kfBadge = kfBirim ? `<span class="badge bg-success" title="Kur Farkı Cinsi"><i class="fas fa-coins me-1"></i>KF: ${mtEsc(kfBirim)}</span>` : '<span class="text-muted">-</span>';
                    panes += `<tr class="mt-row" data-transid="${item.transId}" data-lineid="${item.lineId}" data-isdebit="${borc}" data-currency="${mtEsc(pBirim)}" data-kfcurrency="${mtEsc(kfBirim)}">
                                <td class="text-center"><input type="checkbox" class="mt-chk" data-maxamount="${maxTutar}" onchange="mtSatirSec(this, ${maxTutar})"></td>
                                <td>${mtEsc(item.docDate)}</td>
                                <td>${mtEsc(item.dueDate)}</td>
                                <td><span class="fw-bold text-primary">${item.transId}</span><span class="text-muted small">/${item.lineId}</span></td>
                                <td><span class="badge border border-primary text-primary">${mtEsc(item.islemTipi || '-')}</span></td>
                                <td><span class="badge bg-dark">${mtEsc(pBirim)}</span></td>
                                <td class="text-center">${kfBadge}</td>
                                <td class="text-end text-primary">${borc && item.dovizliBorc > 0 ? mtPara(item.dovizliBorc) : '-'}</td>
                                <td class="text-end text-primary">${!borc && item.dovizliAlacak > 0 ? mtPara(item.dovizliAlacak) : '-'}</td>
                                <td class="text-end text-danger fw-bold">${borc ? mtPara(item.openDebit) : '-'}</td>
                                <td class="text-end text-success fw-bold">${!borc ? mtPara(item.openCredit) : '-'}</td>
                                <td title="${mtEsc(item.memo)}" class="text-truncate" style="max-width:200px;">${mtEsc(item.memo)}</td>
                                <td class="text-end pe-3"><input type="number" class="mt-tutar ms-auto" value="0.00" max="${maxTutar}" min="0" step="0.01" disabled onkeyup="mtTutarKontrol(this); mtToplamlar()" onchange="mtTutarKontrol(this); mtToplamlar()"></td>
                              </tr>`;
                });

                panes += '</tbody></table></div></div>';
                if (ilk) { mtHedefDb = db; ilk = false; }
            }
            tabs += '</ul>';
            panes += '</div>';
            container.html(tabs + panes);

            container.find('button[data-bs-toggle="pill"]').on('shown.bs.tab', function (e) {
                mtHedefDb = $(e.target).data('dbname');
                $('#mtParaFiltre button[data-currency="ALL"]').click();
                mtToplamlar();
            });

            if (window.adatSiralama) window.adatSiralama.ikonEkle(container);
            container.fadeIn();
            mtToplamlar();
        }

        function mtTumunuSec(chkAll, db) {
            const secili = $(chkAll).is(':checked');
            $(`#mt-tbody-${db} .mt-row:visible .mt-chk`).each(function () {
                if ($(this).is(':checked') !== secili) {
                    $(this).prop('checked', secili);
                    mtSatirSec(this, parseFloat($(this).data('maxamount')), true);
                }
            });
            mtToplamlar();
        }

        function mtTutarKontrol(input) {
            const val = parseFloat($(input).val()) || 0;
            const max = parseFloat($(input).attr('max')) || 0;
            if (val > max) $(input).val(max.toFixed(2));
            else if (val < 0) $(input).val('0.00');
        }

        function mtSatirSec(chk, maxTutar, hesaplama) {
            const row = $(chk).closest('tr');
            const input = row.find('.mt-tutar');
            if ($(chk).is(':checked')) { row.addClass('table-primary'); input.prop('disabled', false).val(parseFloat(maxTutar).toFixed(2)); }
            else { row.removeClass('table-primary'); input.prop('disabled', true).val('0.00'); }
            if (!hesaplama) mtToplamlar();
        }

        function mtToplamlar() {
            let borc = 0, alacak = 0;
            $(`#mt-tbody-${mtHedefDb} .mt-chk:checked`).each(function () {
                const row = $(this).closest('tr');
                const val = parseFloat(row.find('.mt-tutar').val()) || 0;
                if (row.data('isdebit')) borc += val; else alacak += val;
            });
            const fark = Math.round(Math.abs(borc - alacak) * 100) / 100;
            $('#mtBorc').text(mtPara(borc) + ' ₺');
            $('#mtAlacak').text(mtPara(alacak) + ' ₺');
            $('#mtFark').text(mtPara(fark) + ' ₺');
            const hazir = borc > 0 && alacak > 0 && fark === 0;
            $('#mtFark').toggleClass('text-success', hazir).toggleClass('text-danger', !hazir);
            $('#mtKapatBtn').prop('disabled', !hazir).toggleClass('btn-success', hazir).toggleClass('btn-secondary', !hazir);
        }

        function mtRobotTakip(matchedCardCode, dbName) {
            Swal.fire({
                title: 'SAP UI Robot İşlemde',
                html: '<p class="text-muted small">Arka planda kapanışlar yapılıyor. Lütfen sekmeyi kapatmayın...</p><div id="mtRobotDurum" class="alert alert-warning fw-bold mt-2 border-warning">Robot sırası bekleniyor...</div>',
                allowOutsideClick: false, allowEscapeKey: false, didOpen: () => { Swal.showLoading(); }
            });
            if (mtRobotInterval) clearInterval(mtRobotInterval);
            mtRobotInterval = setInterval(() => {
                $.get('/Rapor20/GetRobotCheckStatus', { matchedCardCode: matchedCardCode, dbName: dbName }, function (res) {
                    if (!res.success) return;
                    $('#mtRobotDurum').html(res.statusMessage);
                    if (res.isFinished) {
                        clearInterval(mtRobotInterval);
                        mtDegisti = true;
                        Swal.fire('İşlem Tamamlandı', res.statusMessage, 'success').then(() => mtIslemleriYukle());
                    }
                });
            }, 3000);
        }

        function mtSecilenleriKapat() {
            const lines = [];
            $(`#mt-tbody-${mtHedefDb} .mt-chk:checked`).each(function () {
                const row = $(this).closest('tr');
                const amt = parseFloat(row.find('.mt-tutar').val()) || 0;
                if (amt > 0) lines.push({ TransId: parseInt(row.data('transid')), LineId: parseInt(row.data('lineid')), ReconcileAmount: amt });
            });

            Swal.fire({
                title: 'Mutabakat Onayı',
                html: `Seçilen işlemler <b class='text-danger'>${mtEsc(mtHedefDb)}</b> şirketinde SAP'de kapatılacaktır. Onaylıyor musunuz?`,
                icon: 'warning', showCancelButton: true, confirmButtonColor: '#10b981', confirmButtonText: 'Evet, Kapat', cancelButtonText: 'İptal'
            }).then(result => {
                if (!result.isConfirmed) return;
                Swal.fire({ title: 'İşleniyor...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                $.ajax({
                    url: '/Rapor20/PerformReconciliation' + mtDbQuery,
                    type: 'POST', contentType: 'application/json', headers: { 'RequestVerificationToken': mtToken },
                    data: JSON.stringify({ CardCode: mtCari, TargetDbName: mtHedefDb, Lines: lines, UseBpDueDate: mtVadeKosulu() }),
                    success: function (res) {
                        if (res.success) {
                            if (res.isRobotPending) { mtRobotTakip(res.matchedCardCode, mtHedefDb); }
                            else { mtDegisti = true; Swal.fire('Başarılı', res.message, 'success').then(() => mtIslemleriYukle()); }
                        } else {
                            Swal.fire({ title: 'Hata', html: res.message, icon: 'error' });
                        }
                    },
                    error: mtSunucuHatasi
                });
            });
        }

        function mtOtomatikKapat() {
            Swal.fire({
                title: 'Otomatik Kapatma',
                html: `Seçili carideki <b>(${mtEsc(mtHedefDb)})</b> tüm açık işlemler analiz edilecek ve eşleşen bakiyeler SAP'de kapatılacaktır.<br><br>Onaylıyor musunuz?`,
                icon: 'info', showCancelButton: true, confirmButtonColor: '#2563eb', cancelButtonColor: '#f43f5e',
                confirmButtonText: '<i class="fas fa-play"></i> Evet, Başlat', cancelButtonText: 'İptal'
            }).then(result => {
                if (!result.isConfirmed) return;
                let ilerleme;
                Swal.fire({
                    title: 'İşlemler Kapatılıyor',
                    html: '<div id="mtOtoIlerleme" class="p-3 text-start bg-light border rounded shadow-sm" style="min-height: 100px;"><div class="text-center text-muted"><i class="fas fa-spinner fa-spin fa-2x mb-2"></i><br>Sistem hazırlanıyor...</div></div>',
                    allowOutsideClick: false, showConfirmButton: false,
                    didOpen: () => {
                        ilerleme = setInterval(() => {
                            $.get('/Rapor20/GetAutoReconcileProgress' + (mtDbQuery ? mtDbQuery + '&' : '?') + 'cardCode=' + encodeURIComponent(mtCari) + '&targetDbName=' + encodeURIComponent(mtHedefDb), function (res) {
                                if (res && res.success && res.message) $('#mtOtoIlerleme').html(res.message);
                            });
                        }, 800);
                    },
                    willClose: () => { clearInterval(ilerleme); }
                });

                $.ajax({
                    url: '/Rapor20/AutoReconcile' + mtDbQuery,
                    type: 'POST', headers: { 'RequestVerificationToken': mtToken },
                    data: { cardCode: mtCari, targetDbName: mtHedefDb, useBpDueDate: mtVadeKosulu() },
                    success: function (res) {
                        mtDegisti = true;
                        if (res.success) {
                            if (res.isRobotPending) mtRobotTakip(res.matchedCardCode, mtHedefDb);
                            else Swal.fire('İşlem Tamamlandı', res.message, 'success').then(() => mtIslemleriYukle());
                        } else {
                            Swal.fire({ title: 'İşlem Sonucu Raporu', html: res.message, icon: 'warning', width: 700 }).then(() => mtIslemleriYukle());
                        }
                    },
                    error: mtSunucuHatasi
                });
            });
        }

        function mtTumunuIptal() {
            Swal.fire({
                title: 'Toplu İptal Onayı',
                html: `Seçili cariye <b>(${mtEsc(mtCari)})</b> ait <b class="text-danger">${mtEsc(mtHedefDb)}</b> şirketindeki tüm açık ve geçerli iç mutabakatlar Service Layer üzerinden iptal edilecektir.<br><br>Bu işlemi geri alamazsınız. Onaylıyor musunuz?`,
                icon: 'warning', showCancelButton: true, confirmButtonColor: '#f43f5e', cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-undo"></i> Evet, Tümünü İptal Et', cancelButtonText: 'Vazgeç'
            }).then(result => {
                if (!result.isConfirmed) return;
                Swal.fire({ title: 'İptal İşlemi Sürüyor...', text: 'Service Layer ile iletişim kuruluyor, bu işlem mutabakat sayısına göre biraz sürebilir...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                $.ajax({
                    url: '/Rapor20/CancelReconciliations' + mtDbQuery,
                    type: 'POST', headers: { 'RequestVerificationToken': mtToken },
                    data: { cardCode: mtCari, targetDbName: mtHedefDb },
                    success: function (res) {
                        if (res.success) {
                            mtDegisti = true;
                            if (res.hasError) Swal.fire({ title: 'Kısmi Başarı / İptal Edilemeyenler', html: res.message, icon: 'warning', width: 700 }).then(() => mtIslemleriYukle());
                            else Swal.fire('Tamamen İptal Edildi', res.message, 'success').then(() => mtIslemleriYukle());
                        } else {
                            Swal.fire('Hata', res.message, 'error');
                        }
                    },
                    error: mtSunucuHatasi
                });
            });
        }
    </script>
}
