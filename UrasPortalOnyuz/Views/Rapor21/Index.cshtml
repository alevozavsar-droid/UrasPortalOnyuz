@{
    ViewData["Title"] = "Adat Hesaplama";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string onKod = (string)ViewBag.Kod ?? "";
}
@*
    ADAT HESAPLAMA — yeni tasarım. Cari (müşteri / tedarikçi) tip + kod / ad aramasıyla seçilir, açık faturalar ve ödeme / çek satırlarıyla FIFO kapanış simülasyonu CANLI hesaplanır:
    gün, vade farkı (tutar × gün × aylık oran ÷ 3000), aylık adat dağılımı, ortalama vade, net adat farkı. Fatura tutarı düzenlenebilir, vade müşterinin ödeme koşuluna göre dinamik hesaplanabilir.
    Ödemeler: portföydeki vade bekleyen çek / senetler ve eşleşmemiş ödemeler otomatik gelir; nakit / çek / senet / havale satırı eklenir; taslak cari bazında saklanır.
    Entegrasyon: Tahsilata Aktar (taslak tahsilat → Tahsilat ekranı), Otomatik Kapat, Ekstre / Kart / Tahsilat / Otomatik Kapatma bağlantıları; PDF / Excel (faturalar, tahsilat, tam).
    Uçlar: Controllers/AdatController.cs · taslak: Data/AdatOrnek.cs · betik: wwwroot/js/adat.js · süzgeç: wwwroot/js/cari-suzgec.js
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<link rel="stylesheet" href="/css/cari-islem.css?v=2" />
<style>
    .ad .ad-oran { display: flex; align-items: center; gap: 8px; font-size: .68rem; } .ad .ad-oran input { width: 70px; height: 24px; font-size: .7rem; font-weight: 800; text-align: center; }
    .ad .ci-liste input.ic.tutar { width: 100px; font-weight: 700; } .ad .ci-liste input.ic.tarih { width: 112px; } .ad .ci-liste input.ic.no { width: 88px; } .ad .ci-liste select.ic.tip { width: 90px; } .ad .ci-liste select.ic.banka { width: 105px; } .ad #adOdemeler td, .ad #adOdemeler th { padding-left: 2px; padding-right: 2px; }
    .ad .ci-liste tr.kapali td { background: #f8fafc; color: #94a3b8; } .ad .gec { color: #b91c1c; font-weight: 700; } .ad .erken { color: #15803d; } .ad .lehte { color: #15803d; }
    .ad .ad-bilgi-ikon { color: #0369a1; cursor: help; font-size: .6rem; }
</style>
}
<div class="container-fluid py-3 na ci ad" id="ad" data-kod="@onKod">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-chart-line"></i></span>Adat Hesaplama</h4>
        <span style="font-size:.68rem;font-weight:700;color:#475569;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:999px;padding:3px 10px"><i class="fas fa-database me-1"></i>Cari Mutabakat + Cari Kartları + Tahsilat</span>
        <span class="sub w-100">Carinin <b>açık faturaları</b> ile <b>ödeme / çek satırları</b> vade sırasına göre eşleştirilir (FIFO); her eşleşmede gün ve <b>vade farkı</b> (tutar × gün × aylık oran ÷ 3000) hesaplanır, <b>aylık adat dağılımı</b> ve net adat farkı canlı güncellenir. Portföydeki vade bekleyen çekler ve eşleşmemiş ödemeler otomatik gelir; yeni nakit / çek / senet / havale satırı eklenir, taslak cari bazında saklanır. Simülasyon <b>Tahsilata Aktar</b> ile taslak tahsilat olur; <b>Otomatik Kapat</b> kapaması yapılmamış ödemeleri önce kapatır. PDF / Excel ve ekstre indirilir.</span>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>
    <div class="na-kart">
        <div class="na-kart-b"><span><i class="fas fa-user-tie me-1"></i>Cari</span><span class="not" id="adCariSayi"></span></div>
        <div class="na-kart-g">
            <div class="d-flex gap-1 align-items-center mb-2 flex-wrap">
                <select class="form-select" id="adTip" style="width:150px;font-size:.78rem;height:32px"><option value="">Müşteri + Tedarikçi</option><option>Müşteri</option><option>Tedarikçi</option></select>
                <input class="form-control" id="adCariAra" placeholder="Kod ya da ad yazın…" style="width:240px;font-size:.78rem;height:32px" autocomplete="off">
                <select class="form-select" id="adCari" style="flex:1;min-width:320px;font-size:.78rem;height:32px"><option value="">Cari seçiniz…</option></select>
            </div>
            <div class="ci-bilgi" id="adCariOzet"><span class="text-muted">Cari seçince bakiye, son ödeme / yükleme, gecikme ve açık faturalar burada görünür.</span></div>
            <div class="d-flex gap-1 flex-wrap mt-1" id="adCariIslem"></div>
        </div>
    </div>
    <div id="adGovde" style="display:none">
        <div class="ci-kpi" id="adKpi"></div>
        <div class="row g-2">
            <div class="col-xl-7">
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-file-invoice-dollar me-1"></i>Açık Faturalar <span class="n" id="adNFat">0</span></span><span class="d-flex gap-1 align-items-center"><label class="na-mini m-0" style="cursor:pointer"><input type="checkbox" id="adDinamik" class="me-1">Vadeyi ödeme koşuluna göre hesapla (<span id="adVadeGun">30</span> gün)</label><button type="button" class="btn btn-light btn-sm py-0" id="adFatHepsi" style="font-size:.62rem">Tümünü Seç</button><button type="button" class="btn btn-light btn-sm py-0" id="adFatHicbiri" style="font-size:.62rem">Kaldır</button></span></div>
                    <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:420px"><table class="na-tablo ci-liste" id="adFaturalar" data-dinamik="kapali"><thead><tr><th class="s"><input type="checkbox" id="adFatMaster" checked></th><th>Belge No</th><th>Fatura Tarihi</th><th>Vade</th><th class="s">PB</th><th class="e">Hesap Tutarı (TL)</th><th class="e">Orij. Kalan</th><th class="s">Gün</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div></div>
            </div>
            <div class="col-xl-5">
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-money-bill-wave me-1"></i>Ödemeler / Çekler <span class="n" id="adNOde">0</span></span><span class="d-flex gap-1 flex-wrap"><button type="button" class="btn btn-outline-primary btn-sm py-0" data-ekle="Nakit" style="font-size:.62rem"><i class="fas fa-plus me-1"></i>Nakit</button><button type="button" class="btn btn-outline-primary btn-sm py-0" data-ekle="Çek" style="font-size:.62rem"><i class="fas fa-plus me-1"></i>Çek</button><button type="button" class="btn btn-outline-primary btn-sm py-0" data-ekle="Senet" style="font-size:.62rem"><i class="fas fa-plus me-1"></i>Senet</button><button type="button" class="btn btn-outline-primary btn-sm py-0" data-ekle="Havale / EFT" style="font-size:.62rem"><i class="fas fa-plus me-1"></i>Havale</button><button type="button" class="btn btn-light btn-sm py-0" id="adTaslakKaydet" style="font-size:.62rem" title="Ödeme satırlarını ve oranı bu cari için sakla"><i class="fas fa-floppy-disk me-1"></i>Taslak Kaydet</button></span></div>
                    <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:420px"><table class="na-tablo ci-liste" id="adOdemeler" data-dinamik="kapali"><thead><tr><th class="s"></th><th>Tip</th><th>Vade / Tarih</th><th>No</th><th>Banka</th><th>Kaynak</th><th class="e">Tutar (TL)</th><th></th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div></div>
            </div>
        </div>
        <div class="row g-2">
            <div class="col-xl-7">
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-list-ol me-1"></i>Ödeme Kapanış Simülasyonu (FIFO)</span><span class="not">vade sırası · aynı gün önce nakit · gün = ödeme − vade</span></div>
                    <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:460px"><table class="na-tablo ci-liste" id="adSim" data-dinamik="kapali"><thead><tr><th>Belge No</th><th>Ödeme</th><th>Ödeme Tarihi</th><th>Vade</th><th class="s">Gün</th><th class="e">Ödenen (Kapanan)</th><th class="e">Kalan Bakiye</th><th class="e">VF Tutarı</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div></div>
            </div>
            <div class="col-xl-5">
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-calendar-alt me-1"></i>Aylık Adat Dağılımı</span><span class="ad-oran"><i class="fas fa-percent"></i> Aylık Vade Farkı Oranı <input class="form-control" id="adOran" inputmode="decimal" value="5"> %</span></div>
                    <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="adAylik" data-dinamik="kapali"><thead><tr><th>Vade Dönemi</th><th>Ortalama Vade</th><th class="e">Fatura Tutarı (TL)</th><th class="s">Net Gecikme</th><th class="e">Net VF Payı (TL)</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div></div>
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-circle-info me-1"></i>Hesap Kuralları</span></div><div class="na-kart-g"><div class="ci-rehber mt-0 pt-0 border-0">
                    <div><b>Gün:</b> ödemeyle kapanan satırda ödeme tarihi − fatura vadesi; kapanmayan faturada bugün − vade (vadesi gelmemişse 0).</div><div><b>VF:</b> kapanan × aylık oran × gün ÷ 3000 (3000 = 30 gün × 100). Negatif = lehte.</div><div><b>Aylık dağılım:</b> seçili faturalar vade ayına göre; ağırlıklı ortalama vade ve net gecikme.</div><div><b>Fazla ödeme:</b> faturalara eşleşmeyen ödeme avans; geçmiş tarihli ise lehte VF.</div><div><b>Tedarikçi carisinde</b> faturalar alış faturaları, ödemeler bizim ödemelerimizdir (vade farkı borç tarafı).</div>
                </div></div></div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
<script src="/js/adat.js?v=2"></script>
}
