@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    <script>
        toastr.options = { 
            positionClass: "toast-top-right", 
            timeOut: "4000",
            progressBar: true,
            preventDuplicates: true
        };

        let currentMode = 'ADD'; 
        let isBindingData = false; 
        let currentDocEntry = 0; 

        function formatNumber(num) {
            return parseFloat(num).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        // Toplami para birimine gore yazar: { USD: 1452, TRY: 5000 } -> "1.452,00 USD" + "5.000,00 TRY" (dovizler karistirilmaz)
        function pbToplamYaz(pbToplam, tlKarsiligi, yerelPb) {
            const pbler = Object.keys(pbToplam).filter(k => pbToplam[k] !== 0 || Object.keys(pbToplam).length === 1);
            if (!pbler.length) { $('#lblCheckTotal').html('0,00'); return; }
            let h = pbler.map(pb => `<div>${formatNumber(pbToplam[pb])} <span class="badge ${(pb === (yerelPb || 'TRY') || pb === 'TL') ? 'bg-secondary' : 'bg-warning text-dark'} align-middle">${pb}</span></div>`).join('');
            if (tlKarsiligi && pbler.some(pb => pb !== (yerelPb || 'TRY') && pb !== 'TL'))
                h += `<div class="small text-muted fw-semibold mt-1">TL karşılığı: ${formatNumber(tlKarsiligi)} ${yerelPb || 'TRY'}</div>`;
            if (pbler.length > 1) h += `<div class="small text-danger fw-semibold mt-1">Farklı para birimleri ayrı ibraz belgelerine bölünür</div>`;
            $('#lblCheckTotal').html(h);
        }

        function calculateSelectedTotals() {
            let count = 0; const pbToplam = {};
            $('.chk-select:checked').each(function() {
                const pb = String($(this).data('cur') || 'TRY');
                pbToplam[pb] = (pbToplam[pb] || 0) + (parseFloat($(this).data('sum')) || 0);
                count++;
            });
            pbToplamYaz(pbToplam);
            $('#lblCheckCount').text(count);
        }

        function updateCheckIndexes() {
            $('#checksBody tr:visible').each(function(index) { 
                $(this).find('.check-index').text(index + 1); 
            });
        }

        function fetchAvailableChecks() {
            if(currentMode !== 'ADD' || isBindingData) return;
            
            const checkType = $('input[name="checkType"]:checked').val();
            let date1 = '', date2 = '';

            if (checkType === 'Cash') {
                date1 = $('#UntilDate').val();
                if (!date1) return;
            } else {
                date1 = $('#FromDate').val();
                date2 = $('#ToDate').val();
                if (!date1 || !date2) return;
            }

            const currency = $('#DocCurrency').val() || '';

            $('#checksBody').html('<tr><td colspan="12" class="text-center text-primary py-5"><div class="spinner-border spinner-border-md mb-2"></div><br/>Çekler sistemden çekiliyor...</td></tr>');

            $.get('/Rapor119/GetAvailableChecks', { checkType: checkType, date1: date1, date2: date2, currency: currency }, function(res) {
                let html = '';
                if(res && res.length > 0) {
                    res.forEach((c, index) => {
                        html += `
                        <tr class="align-middle" data-search="${(c.checkNum + ' ' + (c.bankName || '') + ' ' + (c.cardName || '') + ' ' + (c.cardCode || '')).toLowerCase()}">
                            <td class="text-center text-muted fw-bold check-index">${index + 1}</td>
                            <td class="text-center">
                                <input class="form-check-input chk-select searchable-field border-secondary" style="transform: scale(1.2); cursor:pointer;" type="checkbox" value="${c.checkKey}" data-sum="${c.checkSum}" data-cur="${c.currency || 'TRY'}">
                            </td>
                            <td>${c.dueDate}</td>
                            <td class="fw-bolder">${c.checkNum}</td>
                            <td class="text-truncate" style="max-width: 150px;" title="${c.bankName || c.bankCode || ''}">${c.bankName || c.bankCode || ''}</td>
                            <td>${c.branch || ''}</td>
                            <td>${c.acctNum || ''}</td>
                            <td><span class="badge bg-light text-dark border">${c.cardCode || '-'}</span></td>
                            <td class="text-truncate fw-semibold" style="max-width:200px;" title="${c.cardName || ''}">${c.cardName || ''}</td>
                            <td class="text-end fw-bolder text-primary fs-6 bg-primary bg-opacity-10">${formatNumber(c.checkSum)}${c.currency && !['TRY', 'TL'].includes(c.currency) ? ' <span class="badge bg-warning text-dark ms-1" title="Döviz çek">' + c.currency + '</span>' : ''}</td>
                            <td>${c.project || ''}</td>
                            <td class="text-center align-middle" style="position: sticky; right: 0; background: #fff; z-index: 1;">
                                <button type="button" class="btn btn-sm btn-light text-danger btn-remove-row p-2 shadow-sm rounded-circle" title="Bu Çeki Listeden Çıkar"><i class="fas fa-trash-alt"></i></button>
                            </td>
                        </tr>`;
                    });
                } else {
                    html = '<tr><td colspan="12" class="text-center text-muted py-5"><i class="fas fa-check-circle fs-3 mb-2 d-block text-success"></i>Tarih aralığına uygun ibraz edilebilecek açık çek bulunamadı.</td></tr>';
                }
                $('#checksBody').html(html);
                $('#selectAllChecks').prop('checked', false);
                calculateSelectedTotals();
            });
        }

        $('#checkSearchFilter').on('input', function() {
            const query = $(this).val().toLowerCase().trim();
            $('#checksBody tr').each(function() {
                const searchData = $(this).data('search') || '';
                if (!query || searchData.includes(query)) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
            updateCheckIndexes();
        });

        $(document).on('click', '.btn-remove-row', function() {
            if (currentMode !== 'ADD') return;
            const tr = $(this).closest('tr');
            tr.find('.chk-select').prop('checked', false).trigger('change');
            tr.fadeOut(300, function() { 
                $(this).remove(); 
                updateCheckIndexes(); 
                calculateSelectedTotals();
            });
        });

        function initAccountSelect2() {
            $('#DepositAccount').select2({
                theme: 'bootstrap-5',
                width: '100%',   // bazı ekranlarda/çözünürlüklerde kutu daralıp seçim yapılamıyordu (IT #70)
                width: '100%',  // bazÄ± ekranlarda kutu daralÄ±yordu (IT #70)
                placeholder: "🔍 Kod veya Ad ile arayın...",
                allowClear: true,
                minimumInputLength: 2,
                ajax: {
                    url: '/Rapor119/SearchAccountsAndBPs',
                    dataType: 'json',
                    delay: 350,
                    data: function (params) { 
                        return { q: params.term, type: $('#AccountType').val() }; 
                    },
                    processResults: function (data) {
                        return {
                            results: $.map(data, function (item) {
                                return { id: item.code, text: item.code + " - " + item.name }
                            })
                        };
                    },
                    cache: true
                }
            });
        }

        function setFormMode(mode) {
            currentMode = mode;
            
            if (mode === 'VIEW') {
                $('#mainContainer').removeClass('find-mode').addClass('view-mode');
                $('.searchable-field').prop('disabled', true);
                $('#JournalRemarks').prop('disabled', true);
                $('.req-field select, .req-field input').prop('required', false);

                $('#chkReconcile').prop('disabled', true);

                $('#DocNum').prop('disabled', true);
                $('#divDocNumSearch').hide();
                $('#divStaticDocNum').show();
                $('#gridCard').show();
                $('#btnSave').hide();
                
                $('#documentActionButtons').show();
                $('#divTransAbs').show();
                
                $('#btnCancel').text("Yeni Temiz Kayıt Ekle").removeClass('btn-light').addClass('btn-primary text-white').prop('disabled', false).html('<i class="fas fa-plus-circle me-2"></i>Yeni Kayıt');
                $('#pageTitle').html('<div class="d-flex align-items-center"><div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3"><i class="fas fa-money-check-alt text-primary fs-4"></i></div>İbraz Görüntüle</div>');
                
                $('#documentStatusArea').css('display', 'flex');
            } 
            else if (mode === 'FIND') {
                $('#mainContainer').removeClass('view-mode').addClass('find-mode');
                $('.searchable-field').prop('disabled', false).val('');
                
                $('#DepositAccount').empty().trigger('change.select2');
                $('#AccountType, #DocCurrency, #U_BE1_IADE, #U_BE1_AKTAR, #U_BE1_CEKISLEMTUR').val('').trigger('change');
                $('#JournalRemarks').prop('disabled', true).val('');
                $('.req-field select, .req-field input').prop('required', false);

                $('#chkReconcile').prop('disabled', true);

                $('#divDocNumSearch').show();
                $('#divStaticDocNum').hide();
                $('#gridCard').hide();
                $('#divTransAbs').hide();
                
                $('#SearchDocNum').prop('disabled', false).val('').focus();

                $('#btnSave').show().text("Ara").removeClass('btn-success').addClass('btn-info text-white shadow').html('<i class="fas fa-search me-2"></i>Sistemde Ara');
                $('#documentActionButtons').hide();
                $('#btnCancel').text("İptal").removeClass('btn-primary text-white').addClass('btn-light').prop('disabled', false).html('İptal');
                
                $('#pageTitle').html('<div class="d-flex align-items-center"><div class="bg-info bg-opacity-10 p-2 rounded-3 me-3"><i class="fas fa-search text-info fs-4"></i></div>Kayıt Bul</div>');
                
                $('#documentStatusArea').hide();
            }
            else { 
                $('#mainContainer').removeClass('view-mode find-mode');
                $('.searchable-field').prop('disabled', false);
                $('#JournalRemarks').prop('disabled', false).val('İbraz - ');
                
                $('#chkReconcile').prop('disabled', false).prop('checked', true);

                $('#DocNum, #TransAbs').val('').prop('disabled', true);
                $('#divDocNumSearch, #divTransAbs').hide();
                $('#divStaticDocNum').show();
                $('#gridCard').show();

                $('#btnSave').show().removeClass('btn-info text-white').addClass('btn-success shadow-lg').html('<i class="fas fa-save me-2"></i>İbraz Et (Sisteme Kaydet)');
                $('#documentActionButtons').hide();
                $('#btnCancel').text("Temizle").removeClass('btn-primary text-white').addClass('btn-light').html('Formu Temizle');
                
                $('#pageTitle').html('<div class="d-flex align-items-center"><div class="bg-success bg-opacity-10 p-2 rounded-3 me-3"><i class="fas fa-money-check-alt text-success fs-4"></i></div>Yeni İbraz Oluştur</div>');
                
                $('#documentStatusArea').hide();
                
                currentDocEntry = 0;
                isBindingData = true;
                $('#docChkTypeBadge').remove(); $('#docPbBadge').remove();
                
                $('#depositForm')[0].reset();
                $('#AccountType').val('Account').trigger('change');
                $('#DepositAccount').empty().trigger('change.select2');
                $('#DocCurrency, #U_BE1_IADE, #U_BE1_AKTAR, #U_BE1_CEKISLEMTUR').val('').trigger('change');

                $('#rbNakit').prop('checked', true).trigger('change');
                
                const today = new Date();
                const todayStr = today.toISOString().split('T')[0];
                const tomorrow = new Date(today);
                tomorrow.setDate(tomorrow.getDate() + 1);
                const tomorrowStr = tomorrow.toISOString().split('T')[0];
                
                $('#DepositDate, #UntilDate').val(todayStr);
                $('#FromDate').val(tomorrowStr);
                $('#ToDate').val(todayStr);

                $('#checksBody').html('<tr><td colspan="12" class="text-center text-muted py-5"><i class="fas fa-search fs-3 mb-2 d-block text-black-50"></i>Tarih seçildiğinde ibraz edilmemiş çekler burada listelenecektir.</td></tr>');
                $('#lblCheckTotal').text('0,00');
                $('#lblCheckCount').text('0');
                
                isBindingData = false;
                fetchAvailableChecks(); 
            }
        }

        function loadDepositDetails(deposId) {
            $('#loadingOverlay').css('display', 'flex');
            $.get('/Rapor119/GetDepositDetails', { deposId: deposId }, function(res) {
                if(res && res.success && res.data) {
                    bindDataToForm(res.data);
                } else {
                    toastr.error(res.message || "İbraz detayları alınamadı.");
                }
            }).fail(function(xhr) {
                toastr.error("Kayıt çekilirken hata oluştu: " + (xhr.responseJSON?.message || ""));
            }).always(function() {
                $('#loadingOverlay').hide();
            });
        }

        function bindDataToForm(res) {
            isBindingData = true; 
            currentDocEntry = res.deposId;
            
            $('#headerDocNumVal').text(res.deposNum);
            
            if(res.canceled) {
                $('#docStatusBadge').html('<span class="badge bg-danger bg-opacity-10 text-danger border border-danger fs-6 px-3 py-2 ms-2 rounded-pill shadow-sm"><i class="fas fa-times-circle me-2"></i>İPTAL EDİLDİ</span>');
                $('#documentActionButtons').hide();
            } else {
                $('#docStatusBadge').html('<span class="badge bg-success bg-opacity-10 text-success border border-success fs-6 px-3 py-2 ms-2 rounded-pill shadow-sm"><i class="fas fa-check-circle me-2"></i>GEÇERLİ / AÇIK</span>');
                $('#documentActionButtons').removeClass('d-none').show();
            }
            
            $('#DocNum').val(res.deposNum);
            $('#TransAbs').val(res.transAbs);
            
            $('#AccountType').val(res.bpActType === 'Y' ? 'BP' : 'Account');
            
            let displayObj = res.banckAcct;
            if(res.banckAcctName) {
                displayObj = res.banckAcct + " - " + res.banckAcctName;
            }
            var newOption = new Option(displayObj, res.banckAcct, true, true);
            $('#DepositAccount').append(newOption).trigger('change');

            // SAP'deki çek ibrazı türü (ODPS.ChkType): S = Vadeli, diğerleri Nakit
            const vadeliIbraz = res.chkType === 'S';
            $(vadeliIbraz ? '#rbVadeli' : '#rbNakit').prop('checked', true);
            $('#divCashDate').show();
            $('#divPostDatedDates').hide();
            $('#docChkTypeBadge').remove(); $('#docPbBadge').remove();
            $('#headerDocNumVal').after(vadeliIbraz
                ? '<span id="docChkTypeBadge" class="badge bg-warning text-dark ms-2"><i class="fas fa-calendar-alt me-1"></i>VADELİ ÇEK</span>'
                : '<span id="docChkTypeBadge" class="badge bg-info text-dark ms-2"><i class="fas fa-money-bill me-1"></i>NAKİT ÇEK</span>');

            $('#UntilDate').val(res.deposDate);
            $('#DepositDate').val(res.deposDate);
            // Ibraz para birimi (ODPS.DeposCurr): yerel para birimiyse "Yerel Para Birimi", degilse doviz kodu
            const ibrazPb = (res.docCurr && res.docCurr !== res.yerelPb) ? res.docCurr : '';
            if (ibrazPb && !$('#DocCurrency option').filter(function () { return this.value === ibrazPb; }).length) $('#DocCurrency').append(new Option(ibrazPb, ibrazPb));
            $('#DocCurrency').val(ibrazPb);
            $('#docPbBadge').remove();
            $('#docChkTypeBadge').after(`<span id="docPbBadge" class="badge ${ibrazPb ? 'bg-warning text-dark' : 'bg-secondary'} ms-2">${ibrazPb || (res.yerelPb || 'TRY')}${ibrazPb ? ' · ' + formatNumber(res.fcTotal) : ''}</span>`);
            
            $('#JournalRemarks').val(res.memo);

            $('#U_BE1_IADE').val(res.u_BE1_IADE || '').trigger('change');
            $('#U_BE1_AKTAR').val(res.u_BE1_AKTAR || '').trigger('change');
            $('#U_BE1_CEKISLEMTUR').val(res.u_BE1_CEKISLEMTUR || '').trigger('change');

            let html = '';
            let cSumTotal = 0;
            if(res.checks && res.checks.length > 0) {
                res.checks.forEach((c, index) => {
                    cSumTotal += c.checkSum;
                    html += `
                    <tr class="align-middle">
                        <td class="text-center text-muted fw-bold check-index">${index + 1}</td>
                        <td class="text-center"><i class="fas fa-check-square text-success fs-5"></i></td>
                        <td>${c.dueDate}</td>
                        <td class="fw-bolder">${c.checkNum}</td>
                        <td class="text-truncate" style="max-width: 150px;">${c.bankName || c.bankCode || ''}</td>
                        <td>${c.branch || ''}</td>
                        <td>${c.acctNum || ''}</td>
                        <td><span class="badge bg-light text-dark border">${c.cardCode || '-'}</span></td>
                        <td class="text-truncate fw-semibold" style="max-width:200px;">${c.cardName || ''}</td>
                        <td class="text-end fw-bolder text-primary fs-6 bg-primary bg-opacity-10">${formatNumber(c.checkSum)}${c.currency && !['TRY', 'TL'].includes(c.currency) ? ' <span class="badge bg-warning text-dark ms-1" title="Döviz çek">' + c.currency + '</span>' : ''}</td>
                        <td>${c.project || ''}</td>
                        <td class="text-center"></td>
                    </tr>`;
                });
            } else {
                html = '<tr><td colspan="12" class="text-center text-muted py-5"><i class="fas fa-info-circle fs-3 mb-2 d-block text-black-50"></i>Bu ibrazda çek bulunmuyor.</td></tr>';
            }
            $('#checksBody').html(html);
            const gPb = {}; (res.checks || []).forEach(c => { const pb = c.currency || res.docCurr || res.yerelPb || 'TRY'; gPb[pb] = (gPb[pb] || 0) + (c.checkSum || 0); });
            pbToplamYaz(Object.keys(gPb).length ? gPb : { [res.yerelPb || 'TRY']: 0 }, res.locTotal, res.yerelPb);
            $('#lblCheckCount').text(res.checks.length);

            setFormMode('VIEW'); 
            isBindingData = false;
        }

        function populateSearchResults(list) {
            let html = '';
            list.forEach(row => {
                let nameDisplay = row.banckAcctName ? ` - ${row.banckAcctName}` : '';
                html += `
                <tr style="cursor:pointer;" class="align-middle" onclick="loadDepositFromModal(${row.deposId})">
                    <td class="fw-bold text-primary fs-6"><i class="fas fa-money-check-alt me-2 text-secondary"></i>${row.deposNum}</td>
                    <td>${row.deposDate}</td>
                    <td><span class="badge bg-light text-dark border p-2">${row.banckAcct || ''}${nameDisplay}</span></td>
                    <td class="fw-bolder text-success text-end fs-6">${formatNumber(row.locTotal)}</td>
                    <td class="text-truncate text-muted" style="max-width: 250px;">${row.memo || ''}</td>
                </tr>`;
            });
            $('#searchResultsBody').html(html);
            $('#searchResultsModal').modal('show');
        }

        window.loadDepositFromModal = function(deposId) {
            $('#searchResultsModal').modal('hide');
            loadDepositDetails(deposId);
        }

        // --- TOPLU İŞLEMLER (BULK ACTIONS) YÖNETİMİ ---
      function loadOpenDepositsForBulk() {
    const onlyErrors = $('#switchShowErrorsOnly').is(':checked'); 
    
    $('#bulkDepositsBody').html('<tr><td colspan="7" class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Kayıtlar sistemden yükleniyor...</td></tr>');
    $('#bulkResultArea').hide();
    $('#selectAllBulk').prop('checked', false);
    updateBulkCount();

    $.get('/Rapor119/GetOpenDepositsForBulk', { onlyErrors: onlyErrors }, function (res) {
        if (res.success && res.data) {
            let html = '';
            if (res.data.length > 0) {
                res.data.forEach(d => {
                    let tahsilatRenk = onlyErrors ? "text-danger fw-bold" : "text-dark";
                    
                    html += `
                        <tr class="align-middle">
                            <td class="text-center">
                                <input class="form-check-input bulk-chk border-secondary" style="transform: scale(1.2); cursor:pointer;" type="checkbox" value="${d.deposId}">
                            </td><div class="table-responsive bg-white border rounded shadow-sm mb-4" style="max-height: 350px; overflow-y: auto;">
                            <td class="fw-bold text-primary">${d.deposNum}</td>
                            <td>${d.deposDate}</td>
                            <td class="${tahsilatRenk}">${d.tahsilatTarihi}</td>
                            <td class="text-truncate" style="max-width: 150px; font-size: 0.8rem;" title="${d.cekNumaralari}">${d.cekNumaralari}</td>
                            <td class="text-truncate" style="max-width: 200px;">${d.banckAcctName || d.banckAcct || ''}</td>
                            <td class="text-end fw-bold text-success">${formatNumber(d.locTotal)}</td>
                        </tr>
                    `;
                });
            } else {
                let emptyMsg = onlyErrors ? "Sistemde tarihi hatalı olan (Tahsilattan önce ibraz edilmiş) kayıt bulunamadı." : "İptal edilecek açık ibraz belgesi bulunamadı.";
                html = `<tr><td colspan="7" class="text-center text-muted py-4"><i class="fas fa-check-circle fs-3 text-success mb-2 d-block"></i>${emptyMsg}</td></tr>`;
            }
            $('#bulkDepositsBody').html(html);
        } else {
            $('#bulkDepositsBody').html(`<tr><td colspan="7" class="text-center text-danger py-4"><i class="fas fa-exclamation-circle me-2"></i>Veriler çekilemedi: ${res.message}</td></tr>`);
        }
    }).fail(function () {
        $('#bulkDepositsBody').html(`<tr><td colspan="7" class="text-center text-danger py-4"><i class="fas fa-exclamation-circle me-2"></i>Sunucu bağlantı hatası oluştu.</td></tr>`);
    });
}
        function updateBulkCount() {
            let cnt = $('.bulk-chk:checked').length;
            $('#bulkSelectedCount').text(cnt);
            if(cnt > 0) {
                $('#bulkSelectedCount').removeClass('text-muted').addClass('text-primary fw-bold fs-5');
            } else {
                $('#bulkSelectedCount').removeClass('text-primary fw-bold fs-5').addClass('text-muted');
            }
        }

        $(document).ready(function () {
            initAccountSelect2();

            // TOPLU İŞLEM MODAL ETKİLEŞİMLERİ
            $('#btnOpenBulkModal').click(function () {
                $('#bulkActionCancel').prop('checked', true).trigger('change');
                const today = new Date().toISOString().split('T')[0];
                $('#bulkTargetDate').val(today);
                
                $('#switchShowErrorsOnly').prop('checked', false);
                
                $('#bulkOperationsModal').modal('show');
                loadOpenDepositsForBulk();
            });
            
            $(document).on('change', '#switchShowErrorsOnly', function() {
                loadOpenDepositsForBulk();
            });

            $(document).on('change', '.bulk-chk', function () {
                updateBulkCount();
                if ($('.bulk-chk:checked').length === $('.bulk-chk').length && $('.bulk-chk').length > 0) {
                    $('#selectAllBulk').prop('checked', true);
                } else {
                    $('#selectAllBulk').prop('checked', false);
                }
            });

            $('#selectAllBulk').change(function () {
                $('.bulk-chk').prop('checked', $(this).is(':checked'));
                updateBulkCount();
            });

            // Secilen ibrazlarin tamami TEK bordroda toplanip indirilir.
            // SAP'de degisiklik yapmaz; yalnizca PDF uretir.
            $('#btnBulkBordro').click(function () {
                const secilen = $('.bulk-chk:checked').map(function () {
                    return parseInt($(this).val());
                }).get();

                if (secilen.length === 0) {
                    toastr.warning("Bordro için en az bir ibraz belgesi seçiniz.");
                    return;
                }

                const $btn = $(this);
                const eskiHtml = $btn.html();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Bordro hazırlanıyor...');

                fetch('/Rapor119/CreateIbrazBordro', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(secilen)
                })
                .then(r => {
                    if (r.ok) return r.blob();
                    return r.text().then(t => { throw new Error(t || "Bordro oluşturulamadı."); });
                })
                .then(blob => {
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `Ibraz-Bordrosu-Birlesik-${new Date().getTime()}.pdf`;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(url);
                    toastr.success(secilen.length + " ibraz belgesi tek bordroda birleştirildi.");
                })
                .catch(e => toastr.error(e.message))
                .finally(() => $btn.prop('disabled', false).html(eskiHtml));
            });

            $('input[name="bulkActionType"]').change(function () {
                if ($(this).val() === 'Fix') {
                    $('#bulkTargetDateContainer').slideDown();
                } else {
                    $('#bulkTargetDateContainer').slideUp();
                }
            });

            $('#btnExecuteBulk').click(function () {
                const selectedIds = [];
                $('.bulk-chk:checked').each(function () {
                    selectedIds.push(parseInt($(this).val()));
                });

                if (selectedIds.length === 0) {
                    toastr.warning("Lütfen işlem yapılacak en az bir ibraz belgesi seçiniz.");
                    return;
                }

                const actionType = $('input[name="bulkActionType"]:checked').val();
                let confirmMsg = "";
                let apiUrl = "";
                let payload = { DeposIds: selectedIds };

                if (actionType === 'Cancel') {
                    confirmMsg = `Seçilen ${selectedIds.length} adet belge SAP üzerinden tamamen iptal edilecektir.\nOnaylıyor musunuz?`;
                    apiUrl = '/Rapor119/BulkCancelDeposits';
                } else {
                    const tDate = $('#bulkTargetDate').val();
                    if (!tDate) {
                        toastr.warning("Lütfen ibraz için doğru (hedef) tarihi belirleyiniz.");
                        return;
                    }
                    payload.TargetDate = tDate;
                    confirmMsg = `Seçilen ${selectedIds.length} adet hatalı ibraz iptal edilecek ve içlerindeki çekler ${tDate} tarihi ile yeniden ibraz edilecektir.\nOnaylıyor musunuz?`;
                    apiUrl = '/Rapor119/BulkFixDeposits';
                }

                if (confirm(confirmMsg)) {
                    $('#bulkResultArea').slideUp();
                    $('#loadingOverlay').css('display', 'flex');

                    $.ajax({
                        url: apiUrl,
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(payload),
                        success: function (res) {
                            $('#bulkResultArea').slideDown();
                            let msgClass = res.success ? 'text-success' : 'text-danger';
                            
                            let summaryHtml = `<span class="${msgClass}"><i class="fas ${res.success ? 'fa-check-circle' : 'fa-exclamation-triangle'} me-2"></i>${res.message.replace(/\n/g, '<br/>')}</span>`;
                            $('.bulk-success-list').html(summaryHtml);

                            if (res.errorList && res.errorList.length > 0) {
                                let errHtml = "<b>Alınan Hatalar:</b><br/>" + res.errorList.join('<br/>');
                                $('.bulk-error-list').html(errHtml).show();
                            } else {
                                $('.bulk-error-list').hide();
                            }

                            if (res.success) {
                                toastr.success("Seçili işlemler başarıyla tamamlandı.");
                                loadOpenDepositsForBulk();
                            } else {
                                toastr.warning("İşlemlerde hatalar oluştu. Lütfen detayları inceleyiniz.", "Kısmi Hata", { timeOut: 0, extendedTimeOut: 0, closeButton: true });
                            }
                        },
                        error: function (xhr) {
                            let errMsg = xhr.responseJSON ? xhr.responseJSON.message : "Sunucu hatası oluştu.";
                            toastr.error(errMsg.replace(/\n/g, "<br>"), "İşlem Başarısız", { timeOut: 0, extendedTimeOut: 0, closeButton: true });
                        },
                        complete: function () {
                            $('#loadingOverlay').hide();
                        }
                    });
                }
            });


            $('#AccountType').change(function() {
                $('#DepositAccount').empty().trigger('change.select2');
            });

            $('input[name="checkType"]').change(function() {
                if($(this).val() === 'Cash') {
                    $('#divCashDate').show();
                    $('#divPostDatedDates').hide();
                } else {
                    $('#divCashDate').hide();
                    $('#divPostDatedDates').show();
                }
                fetchAvailableChecks();
            });

            setFormMode('ADD');

            $('.nav-btn').click(function() {
                if (isBindingData) return;
                const dir = $(this).data('dir');
                $('#loadingOverlay').css('display', 'flex');
                
                $.get('/Rapor119/GetDepositNavigation', { currentDocEntry: currentDocEntry, direction: dir }, function(res) {
                    if(res && res.success && res.data) {
                        bindDataToForm(res.data);
                    } else {
                        toastr.warning(res.message || "Bu yönde başka kayıt bulunmuyor.");
                    }
                }).fail(function(xhr) {
                    toastr.error("Kayıt çekilirken hata oluştu: " + (xhr.responseJSON?.message || ""));
                }).always(function() {
                    $('#loadingOverlay').hide();
                });
            });

            $('#btnNewDoc').click(function() { setFormMode('ADD'); });
            $('#btnFindMode').click(function() { setFormMode('FIND'); });

            $('#UntilDate, #FromDate, #ToDate, #DocCurrency').change(function() {
                fetchAvailableChecks();
            });

            $(document).on('change', '.chk-select', function() {
                calculateSelectedTotals();
                const tr = $(this).closest('tr');
                if (!$(this).is(':checked')) {
                    $('#selectAllChecks').prop('checked', false);
                    tr.removeClass('bg-primary bg-opacity-10');
                } else {
                    tr.addClass('bg-primary bg-opacity-10');
                    if ($('.chk-select:checked').length === $('.chk-select:visible').length) {
                        $('#selectAllChecks').prop('checked', true);
                    }
                }
            });

            $('#selectAllChecks').change(function() {
                if(currentMode !== 'ADD') return;
                const isChecked = $(this).is(':checked');
                $('.chk-select:visible').prop('checked', isChecked);
                
                if (isChecked) {
                    $('.chk-select:visible').closest('tr').addClass('bg-primary bg-opacity-10');
                } else {
                    $('.chk-select').closest('tr').removeClass('bg-primary bg-opacity-10');
                }
                
                calculateSelectedTotals();
            });

            // --- STANDART İPTAL BUTONU İŞLEMLERİ ---
            $('#btnCancelDocumentModal').click(function() {
                if (!currentDocEntry) return;
                $('#cancelSystemDate').prop('checked', true);
                $('#cancelOptionsModal').modal('show');
            });

            $('#btnConfirmCancel').click(function() {
                const cancelDateType = $('input[name="cancelDateType"]:checked').val();

                if (confirm("DİKKAT: Seçilen yöntemle belge iptal işlemi başlatılacaktır. Bu işlem geri alınamaz!\n\nOnaylıyor musunuz?")) {
                    $('#cancelOptionsModal').modal('hide');
                    $('#loadingOverlay').css('display', 'flex');
                    
                    $.ajax({
                        url: '/Rapor119/CancelDeposit?deposId=' + currentDocEntry + '&dateType=' + cancelDateType,
                        type: 'POST',
                        success: function (res) {
                            if (res.success) {
                                toastr.success(res.message);
                                loadDepositDetails(currentDocEntry);
                            } else {
                                toastr.error(res.message);
                            }
                        },
                        error: function (xhr) {
                            const errMsg = xhr.responseJSON ? xhr.responseJSON.message : "İptal sırasında hata oluştu.";
                            toastr.error(errMsg);
                        },
                        complete: function () { $('#loadingOverlay').hide(); }
                    });
                }
            });

            // --- İADE ET BUTONU İŞLEMLERİ ---
            $('input[name="returnDateType"]').change(function() {
                if ($(this).val() === 'Custom') {
                    $('#customDateContainer').slideDown();
                } else {
                    $('#customDateContainer').slideUp();
                }
            });

            $('#btnReturnDocument').click(function() {
                if (!currentDocEntry) return;
                const today = new Date().toISOString().split('T')[0];
                $('#ReturnDateInput').val(today);
                
                $('#rdSystem').prop('checked', true);
                $('#customDateContainer').hide();
                
                $('#returnDateModal').modal('show');
            });

            $('#btnConfirmReturn').click(function() {
                const dateType = $('input[name="returnDateType"]:checked').val();
                let returnDate = '';
                
                if (dateType === 'Custom') {
                    returnDate = $('#ReturnDateInput').val();
                    if (!returnDate) {
                        toastr.warning("Lütfen iade tarihini seçiniz.");
                        return;
                    }
                } else {
                    returnDate = new Date().toISOString().split('T')[0]; 
                }

                if (confirm("DİKKAT: Seçilen yöntemle iade işlemi başlatılacaktır. Mevcut belge iptal edilecek, İade UDF alanı 'Evet' olarak güncellenecek ve İade (Ters Kayıt) yevmiyesi atılacaktır.\n\nOnaylıyor musunuz?")) {
                    $('#returnDateModal').modal('hide');
                    $('#loadingOverlay').css('display', 'flex');

                    $.ajax({
                        url: '/Rapor119/ReturnDeposit?deposId=' + currentDocEntry + '&returnDate=' + returnDate + '&dateType=' + dateType,
                        type: 'POST',
                        success: function (res) {
                            if (res.success) {
                                toastr.success(res.message);
                                setTimeout(function() { 
                                    setFormMode('ADD'); 
                                }, 2500); 
                            } else {
                                toastr.error(res.message);
                            }
                        },
                        error: function (xhr) {
                            const errMsg = xhr.responseJSON ? xhr.responseJSON.message : "İade sırasında hata oluştu.";
                            toastr.error(errMsg);
                        },
                        complete: function () { $('#loadingOverlay').hide(); }
                    });
                }
            });

            $('#depositForm').submit(function (e) {
                e.preventDefault();
                
                if(currentMode === 'FIND') {
                    const searchPayload = {
                        DeposNum: $('#SearchDocNum').val() ? parseInt($('#SearchDocNum').val()) : null,
                        BanckAcct: $('#DepositAccount').val(),
                        DeposDate: $('#UntilDate').val() || null 
                    };
                    
                    $('#loadingOverlay').css('display', 'flex');
                    
                    $.ajax({
                        url: '/Rapor119/FindDeposit',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(searchPayload),
                        success: function (res) {
                            if (res.success && res.data && res.data.length > 0) {
                                if (res.data.length === 1) loadDepositDetails(res.data[0].deposId);
                                else populateSearchResults(res.data);
                            } else {
                                toastr.warning(res.message || "Girilen kriterlere uygun kayıt bulunamadı.");
                            }
                        },
                        error: function () { toastr.error("Arama sırasında hata oluştu."); },
                        complete: function () { $('#loadingOverlay').hide(); }
                    });
                    return;
                }
                
                if(currentMode === 'VIEW') return;

                const accCode = $('#DepositAccount').val();
                if (!accCode) { toastr.warning("Lütfen İbraz Yeri (Hesap/Muhatap) seçiniz."); return; }

                const selectedChecks = [];
                $('.chk-select:checked').each(function() {
                    selectedChecks.push(parseInt($(this).val()));
                });

                if (selectedChecks.length === 0) {
                    toastr.warning("Lütfen ibraz edilecek en az bir çek seçiniz."); return;
                }

                let splitChecksChoice = false;
                if (selectedChecks.length > 1) {
                    splitChecksChoice = confirm("Birden fazla çek seçtiniz.\n\nSistemde bu çeklerin her biri için AYRI (tek tek) ibraz belgesi oluşturulsun mu?\n(İptal derseniz TEK BİR toplu ibraz belgesinde toplanacaktır)");
                }

                const vadeliSecili = $('input[name="checkType"]:checked').val() === 'PostDated';
                if (vadeliSecili && !confirm("VADELİ ÇEK olarak ibraz edilecek.\n\nÇekler SAP'de vadeli (tahsile verilen) duruma geçer ve vadesi gelince Vadeli Çek İbrazı ekranında görünür. Devam edilsin mi?")) return;

                const payload = {
                    AccountType: $('#AccountType').val(),
                    DepositAccount: accCode,
                    DepositCurrency: $('#DocCurrency').val() || null,
                    DepositDate: $('#DepositDate').val(),
                    JournalRemarks: $('#JournalRemarks').val(),
                    SplitChecks: splitChecksChoice,
                    CheckDepositType: $('input[name="checkType"]:checked').val() === 'PostDated' ? 'PostDated' : 'Cash',
                    
                    PerformReconciliation: $('#chkReconcile').is(':checked'), 
                    
                    U_BE1_AKTAR: $('#U_BE1_AKTAR').val() || null,
                    U_BE1_IADE: $('#U_BE1_IADE').val() || null,
                    U_BE1_CEKISLEMTUR: $('#U_BE1_CEKISLEMTUR').val() || null,

                    CheckKeys: selectedChecks
                };

                $('#loadingOverlay').css('display', 'flex');

                $.ajax({
                    url: '/Rapor119/CreateDeposit',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            
                            let hasPartialError = res.message && res.message.includes("DİKKAT");
                            
                            if (hasPartialError) {
                                let formattedMsg = res.message.replace(/\n/g, "<br>");
                                toastr.warning(formattedMsg, "Kısmi Başarı / Uyarı", { timeOut: 0, extendedTimeOut: 0, closeButton: true });
                            } else {
                                toastr.success(res.message);
                            }
                            
                            if (res.docNums && res.docNums.length > 0) {
                                fetch('/Rapor119/CreateIbrazBordro', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify(res.docNums)
                                })
                                .then(response => {
                                    if (response.ok) return response.blob();
                                    throw new Error("Bordro/Makbuz oluşturulamadı.");
                                })
                                .then(blob => {
                                    var url = window.URL.createObjectURL(blob);
                                    var a = document.createElement('a');
                                    a.href = url;
                                    a.download = `Ibraz-Bordrosu-${new Date().getTime()}.pdf`;
                                    document.body.appendChild(a);
                                    a.click();
                                    a.remove();
                                    
                                    if (hasPartialError) {
                                        $('#loadingOverlay').hide();
                                    } else {
                                        setTimeout(() => { window.location.reload(); }, 1500); 
                                    }
                                })
                                .catch(err => {
                                    toastr.warning("İbraz oluşturuldu ancak PDF Bordrosu indirilemedi.");
                                    if (hasPartialError) {
                                        $('#loadingOverlay').hide();
                                    } else {
                                        setTimeout(() => { window.location.reload(); }, 2000); 
                                    }
                                });
                            } else {
                                if (hasPartialError) {
                                    $('#loadingOverlay').hide();
                                } else {
                                    setTimeout(() => { window.location.reload(); }, 2000); 
                                }
                            }
                        } else {
                            let formattedError = res.message ? res.message.replace(/\n/g, "<br>") : "Bağlantı hatası.";
                            toastr.error(formattedError, "İşlem Başarısız", { timeOut: 0, extendedTimeOut: 0, closeButton: true });
                            $('#loadingOverlay').hide();
                        }
                    },
                    error: function (xhr) {
                        let errMsg = xhr.responseJSON ? xhr.responseJSON.message : "Bağlantı hatası.";
                        toastr.error(errMsg.replace(/\n/g, "<br>"), "Hata", { timeOut: 0, extendedTimeOut: 0, closeButton: true });
                        $('#loadingOverlay').hide();
                    }
                });
            });
            
            $('#btnCancel').click(function() {
                if(currentMode === 'VIEW' || currentMode === 'FIND') {
                    setFormMode('ADD');
                } else {
                    if(confirm("Tüm form temizlenecek, emin misiniz?")) {
                        setFormMode('ADD');
                    }
                }
            });
        });
    </script>
}
