            $('#depositModal').modal('show');
        });

        // Kaynaktaki gibi manuel CheckKey girişinde SAP'a gitmeden önce hangi çeklerin seçildiğini
        // ve para birimlerinin uyup uymadığını gösterir — "farklı para birimleri ile ibraz edilemez"
        // hatasının SAP'tan gelmeden önce burada, çek numarasıyla birlikte görülmesini sağlar.
        // depositPreviewValidatedFor: son BAŞARIYLA doğrulanan metin (bare boolean değil) — gönderirken
        // kutunun GÜNCEL metniyle birebir eşleşmiyorsa (kullanıcı arada değiştirmiş ama henüz yeni
        // doğrulama gelmemiş demektir) geçersiz sayılır; debounce/yarış penceresinde eski "geçerli"
        // durumun yanlışlıkla güncel metne uygulanmasını engeller.
        let depositPreviewValidatedFor = null, depositPreviewTimer = null;
        $('#DepositCheckKeys').on('input', function () {
            depositPreviewValidatedFor = null;
            clearTimeout(depositPreviewTimer);
            depositPreviewTimer = setTimeout(depositCheckPreviewYukle, 400);
        });

        function depositCheckPreviewYukle() {
            const keysStr = $('#DepositCheckKeys').val();
            const keyArray = (keysStr || '').split(',').map(x => parseInt(x.trim())).filter(x => !isNaN(x) && x > 0);
            if (keyArray.length === 0) { $('#depositCheckPreview').empty(); return; }

            $('#depositCheckPreview').html('<small class="text-muted"><i class="fas fa-spinner fa-spin me-1"></i>Çekler kontrol ediliyor...</small>');
            $.get('/Rapor117/GetCheckKeyDetails', { keys: keyArray.join(',') }, function (res) {
                // Yanıt gelene kadar kutu değiştiyse bu cevap artık geçersiz/eski — ekranı güncelleme.
                if ($('#DepositCheckKeys').val() !== keysStr) return;
                if (!res || !res.success) { $('#depositCheckPreview').html('<small class="text-danger">Çek detayları alınamadı.</small>'); return; }

                let html = '';
                if (res.notFound && res.notFound.length > 0) {
                    html += `<div class="alert alert-danger py-2 px-3 small mb-1"><i class="fas fa-triangle-exclamation me-1"></i>Sistemde bulunamayan Çek ID: ${res.notFound.join(', ')} — CheckNum (çek üzerindeki numara) ile CheckKey (SAP içi ID) karıştırılmış olabilir.</div>`;
                }

                const paraBirimleri = [...new Set((res.data || []).map(c => c.currency || ''))];
                if (res.data && res.data.length > 0) {
                    html += '<table class="table table-sm table-bordered mb-1"><thead><tr><th>CheckKey</th><th>Çek No</th><th>Kimden</th><th>Banka</th><th class="text-end">Tutar</th></tr></thead><tbody>';
                    res.data.forEach(c => {
                        const farkli = paraBirimleri.length > 1;
                        html += `<tr class="${farkli ? 'table-danger' : ''}"><td>${c.checkKey}</td><td>${c.checkNum || ''}</td><td>${c.cardName || ''}</td><td>${c.bankName || ''}</td><td class="text-end fw-bold">${formatNumber(c.checkSum)} ${c.currency || ''}</td></tr>`;
                    });
                    html += '</tbody></table>';
                }

                if (paraBirimleri.length > 1) {
                    html += `<div class="alert alert-danger py-2 px-3 small mb-0"><i class="fas fa-triangle-exclamation me-1"></i><b>Seçilen çekler farklı para biriminde (${paraBirimleri.join(', ')})</b> — SAP bunları aynı ibrazda birleştirmez. Her para birimi için ayrı ibraz oluşturun.</div>`;
                }

                $('#depositCheckPreview').html(html);
                if ((res.data || []).length === keyArray.length && paraBirimleri.length <= 1) depositPreviewValidatedFor = keysStr;
            }).fail(function () {
                if ($('#DepositCheckKeys').val() === keysStr) $('#depositCheckPreview').html('<small class="text-danger">Çek detayları alınamadı.</small>');
            });
        }

        $('#btnConfirmDeposit').click(function() {
            const acc = $('#DepositAccount').val();
            const dDate = $('#DepositDate').val();
            const keysStr = $('#DepositCheckKeys').val();
            const reconcile = $('#ReconcileAfterDeposit').is(':checked');

            if (!acc) { toastr.warning("Lütfen ibraz edilecek banka hesabını seçiniz."); return; }
            if (!dDate) { toastr.warning("Lütfen ibraz tarihi seçiniz."); return; }
            if (!keysStr) { toastr.warning("Lütfen en az bir Çek ID (CheckKey) giriniz."); return; }

            const keyArray = keysStr.split(',').map(x => parseInt(x.trim())).filter(x => !isNaN(x) && x > 0);

            if (keyArray.length === 0) {
                toastr.warning("Geçerli bir Çek ID formatı girilmedi. Lütfen sayısal ID giriniz (Örn: 1097,1098)");
                return;
            }

            if (depositPreviewValidatedFor !== keysStr) {
                toastr.warning("Lütfen önce çek önizlemesinin yüklenmesini bekleyin ve para birimi uyarısı varsa düzeltin.");
                depositCheckPreviewYukle();
                return;
            }

            if (confirm(`Seçilen ${keyArray.length} adet çek bankaya ibraz edilecektir.\n\nİbraz Sonrası Mutabakat (Reconciliation): ${reconcile ? 'EVET' : 'HAYIR'}\n\nOnaylıyor musunuz?`)) {
                $('#depositModal').modal('hide');
                $('#loadingOverlay').css('display', 'flex');

                const payload = {
                    DepositAccount: acc,
                    DepositDate: dDate,
                    ReconcileAfterDeposit: reconcile,
                    CheckKeys: keyArray
                };

                $.ajax({
                    url: '/Rapor117/CreateDeposit',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            toastr.success(res.message);
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function (xhr) {
                        const errMsg = xhr.responseJSON ? xhr.responseJSON.message : "İbraz oluşturulurken hata meydana geldi.";
                        toastr.error(errMsg);
                    },
                    complete: function () { $('#loadingOverlay').hide(); }
                });
            }
        });

