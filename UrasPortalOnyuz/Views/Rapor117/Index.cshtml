            });

            $('#CardCode').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const cardCode = $(this).val();
                if(!cardCode) return;

                $('#invoicesBody').html('<tr><td colspan="7" class="text-center text-primary py-5"><div class="spinner-border spinner-border-md mb-2" role="status"></div><br/>Faturalar sistemden çekiliyor...</td></tr>');
                $('#JournalRemarks').val("Gelen Ödemeler - " + cardCode);

                $.get('/Rapor117/GetCustomerAddresses', { cardCode: cardCode }, function(res) {
                    let payHtml = '<option value="">- Seçiniz -</option>';
                    res.forEach(addr => {
                        if(addr.addressType === 'B') payHtml += `<option value="${addr.addressName}">${addr.addressName}</option>`;
                    });
                    $('#PayToCode').html(payHtml);
                    if(res.find(a => a.addressType === 'B')) $('#PayToCode').val(res.find(a => a.addressType === 'B').addressName);
                });

                $.get('/Rapor117/GetOpenInvoices', { cardCode: cardCode }, function(res) {
                    let rowsHtml = '';
                    if (res && res.length > 0) {
                        res.forEach(inv => {
                            rowsHtml += `
                            <tr data-docentry="${inv.docEntry}">
                                <td class="text-center align-middle">
                                    <input class="form-check-input invoice-checkbox border-secondary" type="checkbox" data-open="${inv.openAmount}" style="transform: scale(1.3); cursor:pointer;">
                                </td>
                                <td class="align-middle fw-bold">${inv.docNum}</td>
                                <td class="align-middle">${inv.docDate}</td>
                                <td class="align-middle">${inv.docDueDate}</td>
                                <td class="text-end align-middle">${formatNumber(inv.docTotal)} ${inv.currency}</td>
                                <td class="text-end align-middle fw-bold text-danger">${formatNumber(inv.openAmount)} ${inv.currency}</td>
                                <td class="text-end align-middle p-1 bg-primary bg-opacity-10">
                                    <input type="text" inputmode="decimal" class="form-control text-end fw-bold text-primary input-pay-amount tr-para shadow-sm border-0 bg-white" value="0,00" disabled />
                                </td>
                            </tr>`;
                        });
                    } else {
                        rowsHtml = '<tr><td colspan="7" class="text-center text-muted py-5"><i class="fas fa-check-circle fs-3 mb-2 d-block text-success"></i>Bu müşteriye ait açık (ödenmemiş) fatura bulunmuyor.</td></tr>';
                    }
                    $('#invoicesBody').html(rowsHtml);
                    calculateSelectedTotal();
                });
            });

            $(document).on('change', '.invoice-checkbox', function() {
                const tr = $(this).closest('tr');
                const inputPay = tr.find('.input-pay-amount');
                const openAmount = parseFloat($(this).data('open'));

                if ($(this).is(':checked')) {
                    inputPay.prop('disabled', false);
                    inputPay.val(formatTurkishNumber(openAmount));
                    tr.addClass('bg-primary bg-opacity-10');
                } else {
                    inputPay.prop('disabled', true);
                    inputPay.val(formatTurkishNumber(0));
                    tr.removeClass('bg-primary bg-opacity-10');
                }
                calculateSelectedTotal();
            });

            $(document).on('input', '.input-pay-amount', function() {
                const tr = $(this).closest('tr');
                const max = parseFloat(tr.find('.invoice-checkbox').data('open'));
                let val = parseTurkishNumber($(this).val());

                if (val > max) {
                    toastr.warning("Ödenecek tutar açık bakiyeden büyük olamaz.");
                    $(this).val(formatTurkishNumber(max));
                }
                calculateSelectedTotal();
            });

            $(document).on('input', '.calc-input', function() {
                calculateEnteredTotal();
            });

            $('#btnAddCheckRow').click(function() {
                if (currentMode === 'ADD') {
                    addCheckRow();
                    applySenetNumbers();
                }
            });

            $(document).on('click', '.btn-remove-check', function() {
                if (currentMode !== 'ADD') return;
                $(this).closest('tr').remove();
                updateCheckIndexes();
                calculateEnteredTotal();
                applySenetNumbers();
            });

            $('#btnOpenPaymentMeans').click(function() {
                calculateSelectedTotal();
                
                if(!isModalInitialized) {
                    $('.select2-modal').select2({ theme: 'bootstrap-5', width: '100%', dropdownParent: $('#paymentMeansModal') });
                    isModalInitialized = true;
                }
                
                $('#paymentMeansModal').modal('show');
            });

            $('#paymentMeansModal').on('shown.bs.modal', function () {
                if(currentMode === 'VIEW') {
                    $('#btnConfirmPaymentMeans').hide();
                } else {
                    $('#btnConfirmPaymentMeans').show();
                }
            });

            $('#btnConfirmPaymentMeans').click(function() {
                calculateEnteredTotal();
                const expectedTotal = parseFloat($('#modalTotalAmountDisplay').val().replace(/\./g, '').replace(',', '.')) || 0;
                const enteredTotal = parseFloat($('#modalEnteredAmountDisplay').val().replace(/\./g, '').replace(',', '.')) || 0;

                if(enteredTotal <= 0) {
                    toastr.warning("Lütfen en az bir sekmeye tahsilat tutarı giriniz.");
                    return;
                }

                let cSum = 0;
                let checkError = false;
                let bankError = false;
                
                $('#checksBody tr').each(function() {
                    let rowSum = parseTurkishNumber($(this).find('.input-chk-sum').val());
                    if(rowSum > 0) {
                        cSum += rowSum;
                        
                        let isCheckSelect = $(this).find('.input-chk-ischeck');
                        let isSenet = isCheckSelect.val() === '2' || isCheckSelect.find('option:selected').text().toLowerCase().includes('senet');

                        let hasDate = $(this).find('.input-chk-date').val();
                        let hasNum = $(this).find('.input-chk-num').val();
                        let hasBank = $(this).find('.input-chk-bank').val();

                        if(!hasDate || !hasNum) {
                            checkError = true;
                        }
                        
                        if(!isSenet && !hasBank) {
                            bankError = true;
                        }
                    }
                });

                if(cSum > 0 && !$('#CheckAccount').val()) {
                    toastr.warning("Çek sekmesinde Genel Çek Hesabını (Defter-i Kebir) seçiniz."); return;
                }
                if(checkError) {
                    toastr.warning("Lütfen tutar girdiğiniz çek/senetlerin Vade Tarihi ve Çek/Senet No alanlarını eksiksiz doldurunuz."); return;
                }
                if(bankError) {
                    toastr.warning("Çek girişlerinde Banka seçimi zorunludur."); return;
                }

                let tSum = parseTurkishNumber($('#TransferSum').val());
                if(tSum > 0 && !$('#TransferAccount').val()) {
                    toastr.warning("Havale sekmesinde Banka Hesabını seçiniz."); return;
                }

                let ccSum = parseTurkishNumber($('#CreditCardSum').val());
                if(ccSum > 0 && (!$('#CreditCardType').val() || !$('#CreditCardAccount').val())) {
                    toastr.warning("Kredi Kartı sekmesinde POS Kart Türü ve Hesap seçiniz."); return;
                }

                let kSum = parseTurkishNumber($('#CashSum').val());
                if(kSum > 0 && !$('#CashAccount').val()) {
                    toastr.warning("Nakit sekmesinde Kasa Hesabını seçiniz."); return;
                }

                // Hesap para birimi belgeyle uyusmuyorsa SAP'ye hic gidilmez;
                // anlasilmaz SAP metni yerine acik uyari verilir.
                // Kontrol TUM odeme yontemleri icin yapilir: yalnizca kasaya
                // bakmak yetmiyordu, ayni hata cek/havale/kredi hesabindan da
                // geliyor.
                var pbHatasi = (function () {
                    var belgePb = getSelectedCurrency();

                    // Belge para birimi secilmemisse SAP yerel para birimini
                    // (TRY) kullanir; karsilastirma da ona gore yapilmalidir.
                    // Aksi hâlde EUR kasasiyla TRY belge olusup SAP hata veriyordu.
                    var etkinPb = belgePb || 'TRY';
                    var secildiMi = !!belgePb;

                    var kontroller = [
                        { sec: '#CashAccount',       tutar: kSum,   ad: 'Nakit kasa' },
                        { sec: '#CheckAccount',      tutar: cSum,   ad: 'Çek hesabı' },
                        { sec: '#TransferAccount',   tutar: tSum,   ad: 'Havale hesabı' },
                        { sec: '#CreditCardAccount', tutar: ccSum,  ad: 'Kredi kartı hesabı' }
                    ];

                    for (var i = 0; i < kontroller.length; i++) {
                        var k = kontroller[i];
                        if (!(k.tutar > 0)) continue;

                        var kod = $(k.sec).val();
                        if (!kod) continue;

                        var hPb = String($(k.sec + ' option:selected').data('pb') || '##').trim();
                        if (hPb !== '##' && hPb !== etkinPb) {
                            return { ad: k.ad, kod: kod, hesapPb: hPb, belgePb: etkinPb, secildiMi: secildiMi };
                        }
                    }
                    return null;
                })();

                if (pbHatasi) {
                    var ekMetin = pbHatasi.secildiMi
                        ? 'Aynı para biriminde bir hesap seçin.'
                        : 'Belge para birimi seçilmediği için belge TRY olarak açılır. '
                          + 'Üstteki <b>Para Birimi</b> alanından ' + pbHatasi.hesapPb + ' seçin.';

                    toastr.error(pbHatasi.ad + ' olarak seçilen ' + pbHatasi.kod + ' hesabı ' +
                                 pbHatasi.hesapPb + ' para birimindedir, belge ise ' + pbHatasi.belgePb +
                                 '. ' + ekMetin,
                                 'Para birimi uyuşmuyor', { timeOut: 12000, enableHtml: true });
                    return;
                }

                let curText = getSelectedCurrency() ? ' ' + getSelectedCurrency() : '';

                if (expectedTotal > 0 && enteredTotal !== expectedTotal) {
                    toastr.info(`Fatura toplamından farklı bir tutar (${formatNumber(enteredTotal)}${curText}) girildi.`);
                }

                let payStr = [];
                if(kSum > 0) payStr.push(`<span class="badge bg-success ms-1 fs-6 px-2"><i class="fas fa-money-bill me-1"></i>Nakit: ${formatNumber(kSum)}${curText}</span>`);
                if(tSum > 0) payStr.push(`<span class="badge bg-info text-dark ms-1 fs-6 px-2"><i class="fas fa-exchange-alt me-1"></i>Havale: ${formatNumber(tSum)}${curText}</span>`);
                if(ccSum > 0) payStr.push(`<span class="badge bg-warning text-dark ms-1 fs-6 px-2"><i class="fas fa-credit-card me-1"></i>K.Kartı: ${formatNumber(ccSum)}${curText}</span>`);
                if(cSum > 0) payStr.push(`<span class="badge bg-dark text-white ms-1 fs-6 px-2"><i class="fas fa-money-check me-1"></i>Çek/Senet: ${formatNumber(cSum)}${curText}</span>`);

                $('#paymentMeansStatusText').html(`<div class="mt-2 d-flex flex-wrap gap-1">${payStr.join('')}</div>`);
                $('#btnOpenPaymentMeans').addClass('active').css('border-color', '#10b981');

                $('#paymentMeansModal').modal('hide');
            });

            $('#paymentForm').submit(function (e) {
                e.preventDefault();
                
                if(currentMode === 'FIND') {
                    const searchPayload = {
                        DocNum: $('#SearchDocNum').val() ? parseInt($('#SearchDocNum').val()) : null,
                        CardCode: $('#CardCode').val(),
                        DocDate: $('#DocDate').val() || null
                    };
                    
                    $('#loadingOverlay').css('display', 'flex');
                    
                    $.ajax({
                        url: '/Rapor117/FindIncomingPayment',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(searchPayload),
                        success: function (res) {
                            if (res.success && res.data && res.data.length > 0) {
                                if (res.data.length === 1) {
                                    loadPaymentDetailsFromId(res.data[0].docEntry);
                                } else {
                                    populateSearchResults(res.data);
                                }
                            } else {
                                toastr.warning(res.message || "Girilen kriterlere uygun kayıt bulunamadı.");
                            }
                        },
                        error: function () { toastr.error("Arama sırasında hata oluştu."); },
                        complete: function () { $('#loadingOverlay').hide(); }
                    });
                    return;
                }
                
                if(currentMode === 'VIEW') return;

                const cardCode = $('#CardCode').val();
                if (!cardCode) { toastr.warning("Sisteme kayıt yapabilmek için Müşteri seçmelisiniz."); return; }

                if (!$('#btnOpenPaymentMeans').hasClass('active')) {
                    toastr.error("Ödeme araçları sekmesinden tahsilat tutarlarını belirlemelisiniz.");
                    $('#paymentMeansModal').modal('show');
                    return;
                }

                let cSum = 0;
                let activeCheckCount = 0;
                $('#checksBody tr').each(function() { 
                    let rowSum = parseTurkishNumber($(this).find('.input-chk-sum').val());
                    if(rowSum > 0) {
                        cSum += rowSum;
                        activeCheckCount++;
                    }
                });

                let splitChecksChoice = false;
                if (activeCheckCount > 1) {
                    splitChecksChoice = confirm("Birden fazla çek/senet girdiniz.\n\nSistemde bu çeklerin her biri için AYRI tahsilat belgesi oluşturulsun mu?\n(İptal derseniz TEK BİR tahsilat belgesinde toplanacaktır)");
                }

                let tSum = parseTurkishNumber($('#TransferSum').val());
                let ccSum = parseTurkishNumber($('#CreditCardSum').val());
                let kSum = parseTurkishNumber($('#CashSum').val());
                let totalEntered = cSum + tSum + ccSum + kSum;

                if (totalEntered <= 0) {
                    toastr.error("Ödeme araçlarına girilen toplam tutar sıfırdan büyük olmalıdır.");
                    return;
                }

                const invoices = [];
                $('.invoice-checkbox:checked').each(function() {
                    const tr = $(this).closest('tr');
                    const payAmount = parseTurkishNumber(tr.find('.input-pay-amount').val());
                    if (payAmount > 0) {
                        invoices.push({ DocEntry: parseInt(tr.data('docentry')), AppliedAmount: payAmount });
                    }
                });

                const checks = [];
                $('#checksBody tr').each(function() {
                    let rowSum = parseTurkishNumber($(this).find('.input-chk-sum').val());
                    if (rowSum > 0) {
                        checks.push({
                            DueDate: $(this).find('.input-chk-date').val(),
                            CheckSum: rowSum,
                            BankCode: $(this).find('.input-chk-bank').val(),
                            CountryCode: $(this).find('.input-chk-bank option:selected').data('country'), 
                            CheckNumber: parseInt($(this).find('.input-chk-num').val()) || 0,
                            CheckAccount: $('#CheckAccount').val(), 
                            AccounttNum: $(this).find('.input-chk-acctnum').val(),
                            Branch: $(this).find('.input-chk-branch').val(),
                            OrigIssdBy: $(this).find('.input-chk-origissdby').val(), 
                            
                            U_BE1_CHECKNUMBER: $(this).find('.input-chk-seri').val(),
                            U_BE1_BANKBRANCH: $(this).find('.input-chk-bankbranch').val(),
                            U_BE1_ISCHECKBOND: $(this).find('.input-chk-ischeck').val(), 
                            U_BE1_CHECKPORTNO: $(this).find('.input-chk-portno').val(),
                            U_BE1_TRANSFERBP: $(this).find('.input-chk-transferbp').val(),
                            U_BE1_CHECKSTATUS: $(this).find('.input-chk-status').val(),
                            U_BE1_BANKNUM: $(this).find('.input-chk-banknum').val(),
                            U_BE1_NOT: $(this).find('.input-chk-not').val(),
                            U_BE1_KLD: $(this).find('.input-chk-kld').val(),
                            Trnsfrable: $(this).find('.input-chk-ciro').val()
                        });
                    }
                });

                const ccs = [];
                if(ccSum > 0) {
                    ccs.push({
                        CreditCard: parseInt($('#CreditCardType').val()),
                        CreditCardNumber: $('#CreditCardNum').val(),
                        VoucherNum: $('#CreditCardVoucher').val(),
                        CreditSum: ccSum,
                        CreditAcct: $('#CreditCardAccount').val()
                    });
                }

                const payload = {
                    CardCode: cardCode,
                    DocCurrency: $('#modalCurrency').val() || null,
                    DocDate: $('#DocDate').val(),
                    TaxDate: $('#TaxDate').val(),
                    Comments: $('#Comments').val(),
                    JournalRemarks: $('#JournalRemarks').val(),
                    TotalPaymentAmount: totalEntered,
                    SplitChecks: splitChecksChoice, 
                    
                    TransferAccount: $('#TransferAccount').val(),
                    TransferDate: $('#TransferDate').val() || null,
                    TransferReference: $('#TransferReference').val(),
                    TransferSum: tSum,
                    
                    CashAccount: $('#CashAccount').val(),
                    CashSum: kSum,

                    PaymentChecks: checks,
                    PaymentCreditCards: ccs,

                    U_BE1_AKTAR: $('#U_BE1_AKTAR').val() || null,
                    U_BE1_DOVIZTIPI: $('#U_BE1_DOVIZTIPI').val() || null,
                    U_BE1_NOT: $('#U_BE1_NOT').val() || null,
                    U_BE1_SLPNAME: $('#U_BE1_SLPNAME').val() || null,
                    U_BE1_COMPANY: $('#U_BE1_COMPANY').val() || null,
                    U_BE1_TAHSILAT: $('#U_BE1_TAHSILAT').val() || null,
                    U_BE1_GRSYAPAN: $('#U_BE1_GRSYAPAN').val() || null,
                    U_BE1_CKSYAPAN: $('#U_BE1_CKSYAPAN').val() || null,
                    U_BE1_IADE: $('#U_BE1_IADE').val() || null,
                    U_BE1_CEKISLEMTUR: $('#U_BE1_CEKISLEMTUR').val() || null, 

                    Invoices: invoices
                };

                $('#loadingOverlay').css('display', 'flex');

                $.ajax({
                    url: '/Rapor117/CreateIncomingPayment',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            toastr.success(res.message);
                            
                            if (res.docNums && res.docNums.length > 0) {
                                fetch('/Rapor117/CreateTahsilatBordro', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify(res.docNums)
                                })
                                .then(response => {
                                    if (response.ok) return response.blob();
                                    // Sunucunun gercek sebebini goster; sabit metin
                                    // sorunun ne oldugunu hic anlatmiyordu.
                                    return response.text().then(function (metin) {
                                        throw new Error(metin && metin.trim().length
                                            ? metin.trim().substring(0, 300)
                                            : 'Bordro oluşturulamadı (HTTP ' + response.status + ').');
                                    });
                                })
                                .then(blob => {
                                    var url = window.URL.createObjectURL(blob);
                                    var a = document.createElement('a');
                                    a.href = url;
                                    a.download = `Tahsilat-Makbuzu-${new Date().getTime()}.pdf`;
                                    document.body.appendChild(a);
                                    a.click();
                                    a.remove();
                                    setTimeout(() => { window.location.reload(); }, 1500); 
                                })
                                .catch(err => {
                                    // Sebebi de yaz: tahsilat kaydedildi, sorun yalnizca
                                    // makbuzda. Sayfa hemen yenilenirse mesaj okunamadigi
                                    // icin bekleme suresi uzatildi.
                                    toastr.warning(
                                        "Tahsilat oluşturuldu ancak PDF makbuzu indirilemedi.<br><small>"
                                        + (err && err.message ? String(err.message) : "") + "</small>",
                                        "", { timeOut: 12000, enableHtml: true });
                                    setTimeout(() => { window.location.reload(); }, 12000);
                                });
                            } else {
                                setTimeout(() => { window.location.reload(); }, 2000); 
                            }
                        } else {
                            toastr.error(res.message);
                            $('#loadingOverlay').hide();
                        }
                    },
                    error: function (xhr) {
                        const response = xhr.responseJSON;
                        const errMsg = response ? response.message : "Sistem hatası meydana geldi.";
                        
                        alert(errMsg); // Hata mesajını pop-up olarak bas
                        
                        // KISMİ BAŞARI YÖNETİMİ: Başarıyla eklenmiş çekleri ekrandaki tablodan kaldır
                        if (response && response.partialSuccess && response.processedChecks) {
                            response.processedChecks.forEach(function (checkNo) {
                                $('#checksBody tr[data-checkno="' + checkNo + '"]').remove();
                            });
                            
                            updateCheckIndexes();
                            calculateEnteredTotal();
                            toastr.info("Başarıyla kaydedilmiş çekler ekrandan temizlendi. Kalan çekleri kontrol edebilirsiniz.");
                        }

                        $('#loadingOverlay').hide();
                    }
                });
            });
            
            $('#btnCancel').click(function() {
                if(currentMode === 'VIEW' || currentMode === 'FIND') {
                    setFormMode('ADD');
                } else {
                    if(confirm("Tüm form temizlenecek, emin misiniz?")) {
                        setFormMode('ADD');
                    }
                }
            });
        });
    </script>
}