                                $('#TransferSum').val(formatTurkishNumber(res.data.transferSum || 0));
                                $('#TransferAccount').val(res.data.transferAccount || '').trigger('change.select2');
                                if(res.data.transferDate) $('#TransferDate').val(res.data.transferDate.split('T')[0]);
                                $('#TransferReference').val(res.data.transferReference || '');

                                if(res.data.paymentCreditCards && res.data.paymentCreditCards.length > 0) {
                                    let cc = res.data.paymentCreditCards[0];
                                    $('#CreditCardType').val(cc.creditCard).trigger('change.select2');
                                    $('#CreditCardAccount').val(cc.creditAcct).trigger('change.select2');
                                    $('#CreditCardSum').val(formatTurkishNumber(cc.creditSum));
                                    $('#CreditCardNum').val(cc.creditCardNumber);
                                    $('#CreditCardVoucher').val(cc.voucherNum);
                                }

                                let curText = getSelectedCurrency() ? ' ' + getSelectedCurrency() : '';
                                let payStr = [];
                                if(res.data.cashSum > 0) payStr.push(`<span class="badge bg-success ms-1 fs-6 px-2"><i class="fas fa-money-bill me-1"></i>Nakit: ${formatNumber(res.data.cashSum)}${curText}</span>`);
                                if(res.data.transferSum > 0) payStr.push(`<span class="badge bg-info text-dark ms-1 fs-6 px-2"><i class="fas fa-exchange-alt me-1"></i>Havale: ${formatNumber(res.data.transferSum)}${curText}</span>`);
                                if(res.data.paymentCreditCards && res.data.paymentCreditCards.length > 0) payStr.push(`<span class="badge bg-warning text-dark ms-1 fs-6 px-2"><i class="fas fa-credit-card me-1"></i>K.Kartı: ${formatNumber(res.data.paymentCreditCards[0].creditSum)}${curText}</span>`);
                                if(cSumTotal > 0) payStr.push(`<span class="badge bg-dark text-white ms-1 fs-6 px-2"><i class="fas fa-money-check me-1"></i>Çek/Senet: ${formatNumber(cSumTotal)}${curText}</span>`);

                                if(payStr.length > 0) {
                                    $('#paymentMeansStatusText').html(`<div class="mt-2 d-flex flex-wrap gap-1">${payStr.join('')}</div>`);
                                    $('#btnOpenPaymentMeans').addClass('active').css('border-color', '#10b981');
                                }

                                calculateSelectedTotal();
                                calculateEnteredTotal();

                                isBindingData = false;
                            } else {
                                toastr.error(res.message || "İşlem gerçekleştirilemedi.");
                            }
                        },
                        error: function (xhr) {
