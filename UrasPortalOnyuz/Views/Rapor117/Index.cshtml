                                $('#U_BE1_IADE').val(res.data.u_BE1_IADE || '').trigger('change');
                                $('#U_BE1_AKTAR').val(res.data.u_BE1_AKTAR || '').trigger('change');
                                $('#U_BE1_NOT').val(res.data.u_BE1_NOT);
                                $('#U_BE1_SLPNAME').val(res.data.u_BE1_SLPNAME);
                                $('#U_BE1_COMPANY').val(res.data.u_BE1_COMPANY);
                                $('#U_BE1_TAHSILAT').val(res.data.u_BE1_TAHSILAT);
                                $('#U_BE1_GRSYAPAN').val(res.data.u_BE1_GRSYAPAN);
                                $('#U_BE1_CKSYAPAN').val(res.data.u_BE1_CKSYAPAN);
                                $('#U_BE1_CEKISLEMTUR').val(res.data.u_BE1_CEKISLEMTUR || '').trigger('change');

                                $('#checksBody').empty();
                                let cSumTotal = 0;
                                if(res.data.paymentChecks && res.data.paymentChecks.length > 0) {
