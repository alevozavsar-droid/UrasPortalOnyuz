                if (confirm("DİKKAT: Bu tahsilat belgesi SAP üzerinde İPTAL EDİLECEK ve içindeki tüm veriler yeni bir tahsilat kaydı olarak ekrana aktarılacaktır.\n\nOnaylıyor musunuz?")) {
