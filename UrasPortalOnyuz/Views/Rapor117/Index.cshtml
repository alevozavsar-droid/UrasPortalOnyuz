                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-primary">Havale Tutarı <span class="text-danger">*</span></label>
                                <input type="text" inputmode="decimal" id="TransferSum" class="form-control form-control-lg text-end fw-bolder text-primary border-primary calc-input tr-para" value="0,00" />
                            </div>
                        </div>
                    </div>

                    <!-- KREDİ KARTI SEKMESİ -->
                    <div class="tab-pane fade" id="kredi" role="tabpanel">
                        <div class="alert alert-info border-info bg-info bg-opacity-10 py-3 mb-4 rounded-3 d-flex align-items-center">
                            <i class="fas fa-info-circle fs-4 me-3 text-info"></i> 
                            <div>Bu ekrandan <strong>tek çekim / tek kart</strong> tahsilatı tanımlanabilir. POS seçimi ve tutarı dikkatlice giriniz.</div>
                        </div>
                        <div class="row g-4 align-items-end mt-2">
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark">Kredi Kartı / POS Türü <span class="text-danger">*</span></label>
                                <select id="CreditCardType" class="form-select form-select-lg select2-modal w-100 shadow-sm">
                                    <option value="">Seçiniz...</option>
                                    @foreach(var cc in creditCards) { <option value="@cc.CreditCard">@cc.CardName</option> }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark">Defter-i Kebir Hesabı <span class="text-danger">*</span></label>
                                <select id="CreditCardAccount" class="form-select form-select-lg select2-modal w-100 shadow-sm">
                                    <option value="">Seçiniz...</option>
                                    @foreach(var acc in accounts) { <option value="@acc.AcctCode" data-pb="@acc.ActCurr">@acc.FormatCode - @acc.AcctName@(acc.ActCurr == "##" ? "" : " [" + acc.ActCurr + "]")</option> }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-primary">Çekim Tutarı <span class="text-danger">*</span></label>
                                <input type="text" inputmode="decimal" id="CreditCardSum" class="form-control form-control-lg text-end fw-bolder text-primary border-primary calc-input tr-para" value="0,00" />
                            </div>
                            
                            <div class="col-md-4 mt-4">
                                <label class="form-label text-muted">Kart No (Son 4 Hane)</label>
                                <input type="text" id="CreditCardNum" class="form-control form-control-lg bg-light" maxlength="4" placeholder="****" />
                            </div>
                            <div class="col-md-4 mt-4">
                                <label class="form-label text-muted">Onay/Fiş No</label>
                                <input type="text" id="CreditCardVoucher" class="form-control form-control-lg bg-light" />
                            </div>
                        </div>
                    </div>

                    <!-- NAKİT SEKMESİ -->
                    <div class="tab-pane fade" id="nakit" role="tabpanel">
                        <div class="row g-4 justify-content-center mt-5">
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-4 bg-light p-4 text-center">
                                    <i class="fas fa-money-bill-wave text-success mb-3" style="font-size: 3rem;"></i>
                                    <label class="form-label fw-bold text-dark fs-5 text-start">Defter-i Kebir Hesabı (Kasa) <span class="text-danger">*</span></label>
                                    <select id="CashAccount" class="form-select form-select-lg select2-modal w-100 mb-4 shadow-sm text-start">
                                        <option value="">Kasa Hesabı Seçiniz...</option>
                                        @foreach(var acc in accounts)
                                        {
                                            <option value="@acc.AcctCode" data-pb="@acc.ActCurr">
                                                @acc.FormatCode - @acc.AcctName@(acc.ActCurr == "##" ? "" : " [" + acc.ActCurr + "]")
                                            </option>
                                        }
                                    </select>
                                    <div id="kasaPbUyari" class="alert alert-warning py-2 px-3 text-start d-none" style="font-size:12.5px;"></div>
                                    
                                    <label class="form-label fw-bold text-success fs-5 text-start w-100">Nakit Alınan Tutar <span class="text-danger">*</span></label>
                                    <input type="text" inputmode="decimal" id="CashSum" class="form-control form-control-lg text-center fw-bolder text-success border-success calc-input tr-para fs-3 py-3" value="0,00" />
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer bg-light border-top p-3">
                <button type="button" class="btn btn-secondary rounded-pill px-4 fw-bold" data-bs-dismiss="modal">İptal / Kapat</button>
                <button type="button" class="btn btn-primary rounded-pill px-5 fw-bold shadow" id="btnConfirmPaymentMeans">
                    <i class="fas fa-check-circle me-2"></i>Tutarları Onayla ve Kapat
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    <script>
        var sysCheckTranTypes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(checkTransactionTypes));
        var sysIsCheckBond = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.IsCheckBond));

        toastr.options = { 
            positionClass: "toast-top-right", 
            timeOut: "4000",
            progressBar: true,
            preventDuplicates: true
        };

        let currentMode = 'ADD'; 
        let isBindingData = false; 
        let currentDocEntry = 0; 
        let isModalInitialized = false;

        let baseSenetNumber = null;

        function applySenetNumbers() {
            if (baseSenetNumber === null) return;
            
            let currentSenet = baseSenetNumber;
            $('#checksBody tr').each(function() {
                let isCheckSelect = $(this).find('.input-chk-ischeck');
                let isSenet = isCheckSelect.val() === '2' || isCheckSelect.find('option:selected').text().toLowerCase().includes('senet');
                let numInput = $(this).find('.input-chk-num');
                
                if (isSenet) {
                    let currentVal = parseInt(numInput.val());
                    if (isNaN(currentVal) || currentVal <= 0 || (currentVal <= 8999 && currentVal >= 7000)) {
                        numInput.val(currentSenet);
                    }
                    currentSenet--;
                }
            });
        }

        function assignSenetNumber(tr) {
            if (baseSenetNumber === null) {
                $.get('/Rapor117/GetNextSenetNumber', function(res) {
                    baseSenetNumber = res.nextNumber;
                    applySenetNumbers();
                });
            } else {
                applySenetNumbers();
            }
        }

        $(document).on('change', '.input-chk-ischeck', function() {
            if (currentMode !== 'ADD') return;
            
            let isSenet = $(this).val() === '2' || $(this).find('option:selected').text().toLowerCase().includes('senet');
            let tr = $(this).closest('tr');
            let bankSelect = tr.find('.input-chk-bank');
            
            if (isSenet) {
                bankSelect.val('');
                bankSelect.prop('disabled', true);
                assignSenetNumber(tr);
            } else {
                bankSelect.prop('disabled', false);
                let numInput = tr.find('.input-chk-num');
                let currentVal = parseInt(numInput.val()) || 0;
                if (currentVal <= 8999 && currentVal >= 7000) {
                    numInput.val('');
                }
                applySenetNumbers();
            }
        });

        function formatNumber(num) {
            return parseFloat(num).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function getSelectedCurrency() {
            return $('#modalCurrency').val() || '';
        }

        // ---------------------------------------------------------------
        // KASA HESABI - BELGE PARA BIRIMI UYUMU (talep 37)
        //
        // SAP, hesabin para birimi ile belgeninki farkliysa tahsilati reddeder:
        //   "Account currency ... not the same as document currency"
        // Ornek: 100.02.0001 EURO kasasidir; USD tahsilatta secilirse hata verir.
        // Bu yuzden liste belge para birimine gore suzulur. '##' cok para birimli
        // hesaptir, her belgede kullanilabilir.
        // ---------------------------------------------------------------
        // Para birimi kurali YALNIZCA kasa icin degil; cek, havale ve kredi
        // karti hesaplari icin de gecerli. SAP hepsinde ayni hatayi veriyor:
        //   "Account currency ... not the same as document currency"
        var HESAP_SECICILERI = ['#CashAccount', '#CheckAccount', '#TransferAccount', '#CreditCardAccount'];

        function hesabinPb(option) {
            return String($(option).data('pb') || '##').trim();
        }

        function kasaHesaplariniSuz() {
            var pb = getSelectedCurrency();
            var toplamUygunsuz = 0;

            HESAP_SECICILERI.forEach(function (sec) {
                var secim = $(sec);
                if (!secim.length) return;

                var uygunsuz = 0;

                secim.find('option').each(function () {
                    if (!$(this).val()) return;                 // "Seçiniz..." satiri

                    var hPb = hesabinPb(this);
                    var olur = (!pb) || (hPb === '##') || (hPb === pb);

                    // select2 gizlenen option'i yok saydigi icin asil engel
                    // "disabled"; gizleme yalnizca duz listelerde ise yarar.
                    $(this).prop('disabled', !olur).toggle(olur);
                    if (!olur) uygunsuz++;
                });

                // Secili hesap artik uygun degilse secim temizlenir.
                var seciliPb = hesabinPb(secim.find('option:selected'));
                if (pb && secim.val() && seciliPb !== '##' && seciliPb !== pb) {
                    secim.val('').trigger('change.select2');
                }

                toplamUygunsuz += uygunsuz;
            });

            var kutu = $('#kasaPbUyari');
            if (pb && toplamUygunsuz > 0) {
                kutu.removeClass('d-none').html(
                    '<b>' + pb + '</b> belgesi için yalnızca ' + pb +
                    ' ve çok para birimli (##) hesaplar seçilebilir. ' +
                    'Farklı para birimindeki hesaplar pasif.');
            } else {
                kutu.addClass('d-none').empty();
            }
        }

        $(document).on('change', '#modalCurrency', kasaHesaplariniSuz);

        // BELGE PARA BIRIMI BOS BIRAKILAMAZ.
        //
        // Bos birakilirsa istekte DocCurrency hic gonderilmiyor ve SAP belgeyi
        // YEREL para biriminde (TRY) aciyor. Kullanici EUR kasasini secmis olsa
        // bile belge TRY oldugu icin
        //   "hesabin para birimi ile belge para birimi ayni degil"
        // hatasi aliniyor. Bu yuzden dovizli bir hesap secildiginde belge para
        // birimi otomatik o hesabin para birimine cekilir.
        $(document).on('change', HESAP_SECICILERI.join(','), function () {
            var hPb = hesabinPb($(this).find('option:selected'));
            if (!hPb || hPb === '##') return;

            var mevcut = $('#modalCurrency').val();
            if (mevcut === hPb) return;

            if (!mevcut) {
                if ($('#modalCurrency option[value="' + hPb + '"]').length) {
                    $('#modalCurrency').val(hPb).trigger('change');
                    toastr.info('Belge para birimi seçilen hesaba göre ' + hPb + ' yapıldı.');
                }
            }
        });

        // Para birimi bazi akislarda 'change.select2' ile ayarlaniyor ve normal
        // change tetiklenmiyor; bu yuzden Nakit sekmesi acildiginda da suzulur.
        $(document).on('shown.bs.tab', '#nakit-tab', kasaHesaplariniSuz);

        // --- Acik faturalar: arama, tumunu sec, sayac ---------------------
        function faturalariSuz() {
            var q = ($('#faturaAra').val() || '').toLocaleLowerCase('tr-TR');
            var gorunen = 0;

            $('#invoicesBody tr').each(function () {
                var satir = $(this);
                if (!satir.find('.invoice-checkbox').length) return;   // "kayit yok" satiri

                var uygun = !q || satir.text().toLocaleLowerCase('tr-TR').indexOf(q) > -1;
                satir.toggle(uygun);
                if (uygun) gorunen++;
            });

            var secili = $('#invoicesBody .invoice-checkbox:checked').length;
            $('#faturaSayaci').text(gorunen + ' fatura' + (secili > 0 ? ' · ' + secili + ' seçili' : ''));
        }

        $(document).on('input', '#faturaAra', faturalariSuz);
        $(document).on('change', '.invoice-checkbox', faturalariSuz);

        // Yalnizca EKRANDA GORUNEN (arama sonucundaki) faturalari secer/birakir.
        $(document).on('click', '#btnTumunuSec', function () {
            var gorunenKutular = $('#invoicesBody tr:visible .invoice-checkbox');
            if (!gorunenKutular.length) { toastr.info('Seçilecek fatura yok.'); return; }

            var hepsiSecili = gorunenKutular.length === gorunenKutular.filter(':checked').length;
            gorunenKutular.prop('checked', !hepsiSecili).trigger('change');

            $(this).html(hepsiSecili
                ? '<i class="fas fa-check-double me-1"></i>Tümünü seç'
                : '<i class="fas fa-xmark me-1"></i>Seçimi kaldır');
        });

        function calculateSelectedTotal() {
            let total = 0;
            $('.invoice-checkbox:checked').each(function() {
                const tr = $(this).closest('tr');
                const payAmount = parseTurkishNumber(tr.find('.input-pay-amount').val());
                total += payAmount;
            });
            
            let cur = getSelectedCurrency();
            let curText = cur ? ' ' + cur : '';
            
            $('#lblTotalSelectedAmount').text(formatNumber(total) + curText);
            $('#modalTotalAmountDisplay').val(formatNumber(total) + curText);
        }

        function calculateEnteredTotal() {
            let cSum = 0;
            $('.input-chk-sum').each(function() {
                cSum += parseTurkishNumber($(this).val());
            });

            let tSum = parseTurkishNumber($('#TransferSum').val());
            let ccSum = parseTurkishNumber($('#CreditCardSum').val());
            let kSum = parseTurkishNumber($('#CashSum').val());

            let total = cSum + tSum + ccSum + kSum;
            let cur = getSelectedCurrency();
            let curText = cur ? ' ' + cur : '';
            
            $('#modalEnteredAmountDisplay').val(formatNumber(total) + curText);

            odemeRozetleriniGuncelle({ cek: cSum, havale: tSum, kredi: ccSum, nakit: kSum });
            farkSeridiniGuncelle(total, cur);
        }

        // Her odeme yonteminin tutarini sekmesinin uzerinde gosterir; hangi
        // sekmede para oldugunu tek tek acmadan gormek icin.
        function odemeRozetleriniGuncelle(tutarlar) {
            $('.tab-tutar').each(function () {
                var anahtar = $(this).data('tab');
                var deger = parseFloat(tutarlar[anahtar]) || 0;
                $(this).text(formatNumber(deger))
                       .toggleClass('d-none', deger <= 0)
                       .toggleClass('bg-secondary', false)
                       .addClass('bg-primary');
            });
        }

        // Hedef tutar ile girilen tutari karsilastirir. Eskiden fark ancak
        // kaydet'e basildiginda bildirimle ogreniliyordu.
        function farkSeridiniGuncelle(girilen, cur) {
            var serit = $('#farkSeridi');
            var hedef = parseFloat(String($('#modalTotalAmountDisplay').val() || '0')
                          .replace(/[^0-9,.-]/g, '').replace(/\./g, '').replace(',', '.')) || 0;

            if (hedef <= 0 && girilen <= 0) { serit.addClass('d-none').empty(); return; }

            var fark = Math.round((girilen - hedef) * 100) / 100;
            var pbMetni = cur ? ' ' + cur : '';

            serit.removeClass('d-none bg-success-subtle bg-danger-subtle bg-warning-subtle text-success text-danger text-warning');

            if (hedef > 0 && Math.abs(fark) < 0.005) {
                serit.addClass('bg-success-subtle text-success')
                     .html('<span><i class="fas fa-circle-check me-2"></i>Girilen tutar seçilen faturalarla birebir eşit.</span>'
                         + '<span class="fw-bold">' + formatNumber(girilen) + pbMetni + '</span>');
            } else if (hedef > 0) {
                var eksikMi = fark < 0;
                serit.addClass(eksikMi ? 'bg-warning-subtle text-warning' : 'bg-danger-subtle text-danger')
                     .html('<span><i class="fas fa-triangle-exclamation me-2"></i>'
                         + (eksikMi ? 'Eksik: ' : 'Fazla: ') + formatNumber(Math.abs(fark)) + pbMetni
                         + ' <span class="text-muted">(hedef ' + formatNumber(hedef) + pbMetni + ')</span></span>'
                         + '<span class="fw-bold">' + formatNumber(girilen) + pbMetni + '</span>');
            } else {
                serit.addClass('bg-warning-subtle text-warning')
                     .html('<span><i class="fas fa-circle-info me-2"></i>Fatura seçilmedi; tutar hesaba mahsuben (avans) kaydedilecek.</span>'
                         + '<span class="fw-bold">' + formatNumber(girilen) + pbMetni + '</span>');
            }
        }

        $('#modalCurrency').change(function() {
            calculateSelectedTotal();
            calculateEnteredTotal();
        });

        function addCheckRow(data = {}) {
            let index = $('#checksBody tr').length + 1;

            let isCheckBondOptions = sysIsCheckBond.length > 0 
                ? sysIsCheckBond.map(x => `<option value="${x.Code}" ${data.u_BE1_ISCHECKBOND == x.Code ? 'selected' : ''}>${x.Description}</option>`).join('')
                : `<option value="1" ${data.u_BE1_ISCHECKBOND == '1' ? 'selected' : ''}>Çek</option>
                   <option value="2" ${data.u_BE1_ISCHECKBOND == '2' ? 'selected' : ''}>Senet</option>`;

            let isSenet = data.u_BE1_ISCHECKBOND === '2'; 
            
            let isCiroNo = (data.trnsfrable === 'tNO' || data.trnsfrable === 'N');

            let checkNoVal = data.checkNumber || '';

            let trHtml = `
            <tr data-checkno="${checkNoVal}">
                <td class="text-center align-middle text-muted fw-bold check-index">${index}</td>
                <td><input type="date" class="table-input input-chk-date searchable-field fw-bold" value="${data.dueDate || ''}"></td>
                <td><input type="text" inputmode="decimal" class="table-input text-end input-chk-sum calc-input tr-para searchable-field fw-bolder text-primary" value="${formatTurkishNumber(data.checkSum || 0)}"></td>
                <td>
                    <select class="form-select form-select-sm table-input input-chk-bank searchable-field">
                        <option value="">Banka Seçiniz...</option>
                        @foreach(var b in banks) { <option value="@b.BankCode" data-country="@b.CountryCode">@b.BankName</option> }
                    </select>
                </td>
                <td><input type="text" class="table-input input-chk-branch searchable-field" value="${data.branch || ''}"></td>
                <td><input type="text" class="table-input input-chk-acctnum searchable-field" value="${data.accounttNum || ''}"></td>
                <td><input type="text" class="table-input input-chk-origissdby searchable-field" value="${data.origIssdBy || ''}"></td>
                <td><input type="number" class="table-input input-chk-num searchable-field fw-bold" value="${checkNoVal}"></td>
                <td><input type="text" class="table-input input-chk-seri searchable-field" value="${data.u_BE1_CHECKNUMBER || ''}"></td>
                <td><input type="text" class="table-input input-chk-bankbranch searchable-field" value="${data.u_BE1_BANKBRANCH || ''}"></td>
                <td>
                    <select class="form-select form-select-sm table-input input-chk-ischeck searchable-field">
                        ${isCheckBondOptions}
                    </select>
                </td>
                <td><input type="text" class="table-input input-chk-portno searchable-field" value="${data.u_BE1_CHECKPORTNO || ''}"></td>
                <td><input type="text" class="table-input input-chk-transferbp searchable-field" value="${data.u_BE1_TRANSFERBP || ''}"></td>
                <td><input type="text" class="table-input input-chk-status searchable-field" value="${data.u_BE1_CHECKSTATUS || ''}"></td>
                <td><input type="text" class="table-input input-chk-banknum searchable-field" value="${data.u_BE1_BANKNUM || ''}"></td>
                <td><input type="text" class="table-input input-chk-not searchable-field" value="${data.u_BE1_NOT || ''}"></td>
                <td><input type="text" class="table-input input-chk-kld searchable-field" value="${data.u_BE1_KLD || ''}"></td>
                <td>
                    <select class="form-select form-select-sm table-input input-chk-ciro searchable-field">
                        <option value="tYES" ${!isCiroNo ? 'selected' : ''}>Evet</option>
                        <option value="tNO" ${isCiroNo ? 'selected' : ''}>Hayır</option>
                    </select>
                </td>
                <td class="text-center align-middle" style="position: sticky; right: 0; background: #fff; border-left: 2px solid #e2e8f0; z-index: 1;">
                    <button type="button" class="btn btn-sm btn-light text-danger btn-remove-check p-2 shadow-sm rounded-circle"><i class="fas fa-trash-alt"></i></button>
                </td>
            </tr>`;
            
            let $tr = $(trHtml);
            if(data.bankCode) $tr.find('.input-chk-bank').val(data.bankCode);
            if(isSenet && currentMode === 'VIEW') $tr.find('.input-chk-bank').prop('disabled', true);

            $('#checksBody').append($tr);
            updateCheckIndexes();
            calculateEnteredTotal();
        }

        $(document).on('input change', '.input-chk-num', function() {
            let tr = $(this).closest('tr');
            tr.attr('data-checkno', $(this).val());
        });

        function updateCheckIndexes() {
            $('#checksBody tr').each(function(index) { $(this).find('.check-index').text(index + 1); });
        }

        function setFormMode(mode) {
            currentMode = mode;
            
            if (mode === 'VIEW') {
                $('#mainContainer').removeClass('find-mode').addClass('view-mode');
                $('.searchable-field').prop('disabled', true);
                $('#Comments, #JournalRemarks').prop('disabled', true);
                $('.req-field select, .req-field input').prop('required', false);

                $('#DocNum').prop('disabled', true);
                $('#divDocNumSearch').hide();
                $('#divStaticDocNum').show();
                
                $('#invoicesSection').show();
                $('#paymentMeansButtonContainer').show();
                
                $('#btnSave').hide();
                
                $('#btnCancel').text("Yeni Temiz Kayıt Ekle").removeClass('btn-light').addClass('btn-primary text-white').prop('disabled', false).html('<i class="fas fa-plus-circle me-2"></i>Yeni Kayıt');
                $('#pageTitle').html('<div class="d-flex align-items-center"><div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3"><i class="fas fa-file-invoice text-primary fs-4"></i></div>Tahsilat Görüntüle</div>');
                
                $('#documentStatusArea').css('display', 'flex');
            } 
            else if (mode === 'FIND') {
                $('#mainContainer').removeClass('view-mode').addClass('find-mode');
                $('.searchable-field').prop('disabled', false).val('');
                
                $('#CardCode').empty().trigger('change.select2');
                $('#PayToCode, #U_BE1_DOVIZTIPI, #U_BE1_IADE, #U_BE1_AKTAR, #U_BE1_CEKISLEMTUR, #modalCurrency').val('').trigger('change.select2');
                $('#Comments, #JournalRemarks').prop('disabled', true).val('');
                $('.req-field select, .req-field input').prop('required', false);

                $('#divDocNumSearch').show();
                $('#divStaticDocNum').hide();
                
                $('#invoicesSection').hide();
                $('#paymentMeansButtonContainer').hide();
                
                $('#SearchDocNum').prop('disabled', false).val('').focus();

                $('#btnSave').show().text("Ara").removeClass('btn-success').addClass('btn-info text-white shadow').html('<i class="fas fa-search me-2"></i>Sistemde Ara');
                $('#documentActionButtons').hide();
                $('#btnCancel').text("İptal").removeClass('btn-primary text-white').addClass('btn-light').prop('disabled', false).html('İptal');
                
                $('#pageTitle').html('<div class="d-flex align-items-center"><div class="bg-info bg-opacity-10 p-2 rounded-3 me-3"><i class="fas fa-search text-info fs-4"></i></div>Kayıt Bul</div>');
                
                $('#documentStatusArea').hide();
            }
            else { 
                baseSenetNumber = null;

                $('#mainContainer').removeClass('view-mode find-mode');
                $('.searchable-field').prop('disabled', false);
                $('#Comments, #JournalRemarks').prop('disabled', false).val('');
                
                $('#DocNum').val('').prop('disabled', true);
