        function bindPaymentToForm(res) {
            isBindingData = true; 
            currentDocEntry = res.docEntry;
            
            $('#headerDocNumVal').text(res.docNum);
            
            if(res.canceled) {
                $('#docStatusBadge').html('<span class="badge bg-danger bg-opacity-10 text-danger border border-danger fs-6 px-3 py-2 ms-2 rounded-pill shadow-sm"><i class="fas fa-times-circle me-2"></i>İPTAL EDİLDİ</span>');
                $('#documentActionButtons').hide();
            } else {
                $('#docStatusBadge').html('<span class="badge bg-success bg-opacity-10 text-success border border-success fs-6 px-3 py-2 ms-2 rounded-pill shadow-sm"><i class="fas fa-check-circle me-2"></i>GEÇERLİ / AÇIK</span>');
                $('#documentActionButtons').removeClass('d-none').show();
            }
            
            $('#DocNum').val(res.docNum);
            
            var newOption = new Option(res.cardCode + " - " + res.cardName, res.cardCode, true, true);
            $('#CardCode').append(newOption).trigger('change');

            $('#DocDate').val(res.docDate);
            $('#TaxDate').val(res.taxDate);
            $('#Comments').val(res.comments);
            $('#JournalRemarks').val(res.journalRemarks);

            $('#modalCurrency').val(res.docCurrency || '').trigger('change');

            $('#U_BE1_DOVIZTIPI').val(res.u_BE1_DOVIZTIPI || '').trigger('change');
            $('#U_BE1_IADE').val(res.u_BE1_IADE || '').trigger('change');
            $('#U_BE1_AKTAR').val(res.u_BE1_AKTAR || '').trigger('change');
            $('#U_BE1_NOT').val(res.u_BE1_NOT);
            $('#U_BE1_SLPNAME').val(res.u_BE1_SLPNAME);
            $('#U_BE1_COMPANY').val(res.u_BE1_COMPANY);
            $('#U_BE1_TAHSILAT').val(res.u_BE1_TAHSILAT);
            $('#U_BE1_GRSYAPAN').val(res.u_BE1_GRSYAPAN);
            $('#U_BE1_CKSYAPAN').val(res.u_BE1_CKSYAPAN);
            $('#U_BE1_CEKISLEMTUR').val(res.u_BE1_CEKISLEMTUR || '').trigger('change');

            $('#checksBody').empty();
            let cSumTotal = 0;
            if(res.checks && res.checks.length > 0) {
                $('#CheckAccount').val(res.checks[0].checkAccount).trigger('change.select2'); 
                res.checks.forEach(chk => {
                    if(chk.dueDate) chk.dueDate = chk.dueDate.split('T')[0];
                    cSumTotal += chk.checkSum;
                    addCheckRow(chk);
                });
            }

            let rowsHtml = '';
            if(res.invoices && res.invoices.length > 0) {
                res.invoices.forEach(inv => {
                    rowsHtml += `
                    <tr>
                        <td class="text-center align-middle"><i class="fas fa-check-square text-success fs-5"></i></td>
                        <td class="align-middle fw-bold">Belge Entry: ${inv.docEntry}</td>
                        <td class="align-middle text-muted">-</td>
                        <td class="align-middle text-muted">-</td>
                        <td class="text-end align-middle text-muted">-</td>
                        <td class="text-end align-middle fw-bold text-danger">-</td>
                        <td class="text-end align-middle fw-bold text-primary fs-6 bg-primary bg-opacity-10">${formatNumber(inv.appliedAmount)}</td>
                    </tr>`;
                });
            } else {
                rowsHtml = '<tr><td colspan="7" class="text-center text-muted py-5"><i class="fas fa-info-circle fs-3 mb-2 d-block text-black-50"></i>Fatura eşleştirmesi yok (Tutar hesaba mahsuben alınmış).</td></tr>';
            }
            $('#invoicesBody').html(rowsHtml);
            
            let curText = getSelectedCurrency() ? ' ' + getSelectedCurrency() : '';
            $('#lblTotalSelectedAmount').text(formatNumber(res.totalAmount) + curText);

            $('#CashSum').val(formatTurkishNumber(res.cashSum));
            $('#TransferSum').val(formatTurkishNumber(res.transferSum));
            $('#CreditCardSum').val(formatTurkishNumber(res.creditSum));

            let payStr = [];
            if(res.cashSum > 0) payStr.push(`<span class="badge bg-success ms-1 fs-6 px-2"><i class="fas fa-money-bill me-1"></i>Nakit: ${formatNumber(res.cashSum)}${curText}</span>`);
            if(res.transferSum > 0) payStr.push(`<span class="badge bg-info text-dark ms-1 fs-6 px-2"><i class="fas fa-exchange-alt me-1"></i>Havale: ${formatNumber(res.transferSum)}${curText}</span>`);
            if(res.creditSum > 0) payStr.push(`<span class="badge bg-warning text-dark ms-1 fs-6 px-2"><i class="fas fa-credit-card me-1"></i>K.Kartı: ${formatNumber(res.creditSum)}${curText}</span>`);
            if(cSumTotal > 0) payStr.push(`<span class="badge bg-dark text-white ms-1 fs-6 px-2"><i class="fas fa-money-check me-1"></i>Çek: ${formatNumber(cSumTotal)}${curText}</span>`);

            if(payStr.length > 0) {
                $('#paymentMeansStatusText').html(`<div class="mt-2 d-flex flex-wrap gap-1">${payStr.join('')}</div>`);
                $('#btnOpenPaymentMeans').addClass('active').css('border-color', '#10b981');
            } else {
                $('#paymentMeansStatusText').html('Ödeme bilgisi bulunamadı.');
                $('#btnOpenPaymentMeans').removeClass('active');
            }

            setFormMode('VIEW'); 
            isBindingData = false;
        }

