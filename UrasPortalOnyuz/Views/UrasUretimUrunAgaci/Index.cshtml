@{
    ViewData["Title"] = "Ürün Ağacı";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0 text-gray-800 fw-bold"><i class="fas fa-sitemap me-2 text-primary"></i> Ürün Ağacı</h2>
    <button class="btn btn-outline-secondary btn-sm" onclick="formuTemizle()"><i class="fas fa-file me-1"></i>Yeni</button>
</div>
<p class="text-muted mb-3">SAP Business One — Ürün Ağacı Tanımlama ve Güncelleme.</p>

<div class="card dash-card mb-3">
    <div class="card-header bg-white fw-bold small text-uppercase text-muted">Ana Ürün</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-bold">Ürün Numarası</label>
                <div class="input-group input-group-sm">
                    <input type="text" id="anaUrunKod" class="form-control" disabled placeholder="Ürün seçin...">
                    <button class="btn btn-outline-primary" type="button" onclick="anaUrunAramaAc()"><i class="fas fa-search"></i></button>
                    <button class="btn btn-outline-danger" type="button" onclick="formuTemizle()"><i class="fas fa-xmark"></i></button>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small fw-bold">Ürün Tanımı</label>
                <input type="text" id="anaUrunAd" class="form-control form-control-sm" disabled placeholder="—">
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-bold">Baz Miktar</label>
                <div class="input-group input-group-sm">
                    <input type="number" min="0" step="0.001" id="bazMiktar" class="form-control">
                    <span class="input-group-text" id="anaBirim"></span>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-bold">Depo</label>
                <div class="input-group input-group-sm">
                    <input type="text" id="anaDepo" class="form-control" disabled placeholder="Depo...">
                    <button class="btn btn-outline-primary" type="button" onclick="depoAramaAc('ana')"><i class="fas fa-search"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card dash-card mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="fw-bold small text-uppercase text-muted">Bileşenler <span id="satirSayisi" class="badge bg-primary ms-1">0</span></span>
        <div class="small text-muted" id="toplamMaliyet"></div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm" onclick="satirEkle()"><i class="fas fa-plus me-1"></i>Satır Ekle</button>
            <button class="btn btn-primary btn-sm" id="btnKaydet" onclick="kaydet()"><i class="fas fa-floppy-disk me-1"></i>Kaydet</button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-custom mb-0">
            <thead>
                <tr><th width="40"></th><th width="70">Durum</th><th width="110">No</th><th>Tanım</th><th class="text-end" width="120">Miktar</th><th width="80">Birim</th><th width="150">Depo</th><th class="text-end" width="150">Birim Maliyet</th></tr>
            </thead>
            <tbody id="tbodySatirlar"></tbody>
        </table>
        <div id="bosMesaj" class="text-center text-muted py-4"><i class="fas fa-inbox me-1"></i>Ürün ağacında bileşen yok.</div>
    </div>
</div>

<!-- Ürün arama modalı -->
<div class="modal fade" id="urunAramaModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title fw-bold" id="urunAramaBaslik">Ürün Seçimi</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="text" id="urunAramaMetin" class="form-control mb-3" placeholder="Ürün kodu veya adı ile ara..." oninput="urunAramaFiltrele()">
                <div class="table-responsive" style="max-height:420px;">
                    <table class="table table-sm table-hover">
                        <thead><tr><th width="50">#</th><th>Ürün Kodu</th><th>Ürün Adı</th></tr></thead>
                        <tbody id="tbodyUrunArama"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Depo arama modalı -->
<div class="modal fade" id="depoAramaModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title fw-bold">Depo Seçimi</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="text" id="depoAramaMetin" class="form-control mb-3" placeholder="Depo kodu veya adı ile ara..." oninput="depoAramaFiltrele()">
                <div class="table-responsive" style="max-height:420px;">
                    <table class="table table-sm table-hover">
                        <thead><tr><th width="110">Depo Kodu</th><th>Depo Adı</th></tr></thead>
                        <tbody id="tbodyDepoArama"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dash-card { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
    .table-custom th { background-color: #f8f9fc; text-transform: uppercase; font-size: 11px; color: #858796; border-bottom: 2px solid #e3e6f0; }
    .table-custom td { vertical-align: middle; font-size: 13px; color: #5a5c69; }
    .rozet { font-size: .68rem; font-weight: 700; padding: .2em .5em; border-radius: 6px; }
    .rozet-yeni { background:#e6f7ee; color:#0f9d58; } .rozet-kayitli { background:#f1f3f5; color:#495057; }
    tr.satir-vurgu { background: #fffbeb; }
</style>

<script>
    let satirlar = [];       // {No, ItemName, Quantity, Warehouse, ChildNum}
    let urunListesi = [];
    let depoListesi = [];
    let aramaHedefSatir = -1;   // -1 = ana ürün için arama, >=0 = o satır için bileşen araması
    let depoHedefSatir = null;  // null = ana ürün deposu, sayı = satır index'i
    let duzenlemeModu = false;

    function fmt(n, d) { return (Number(n) || 0).toLocaleString('tr-TR', { minimumFractionDigits: d, maximumFractionDigits: d }); }

    function formuTemizle() {
        document.getElementById('anaUrunKod').value = '';
        document.getElementById('anaUrunAd').value = '';
        document.getElementById('anaBirim').textContent = '';
        document.getElementById('anaDepo').value = '';
        document.getElementById('bazMiktar').value = '';
        satirlar = [];
        duzenlemeModu = false;
        cizSatirlar();
    }

    async function urunListesiniYukle() {
        const res = await fetch('/UrasUretimUrunAgaci/GetOITM').then(r => r.json());
        if (res.success) urunListesi = res.data || [];
    }
    async function depoListesiniYukle() {
        const res = await fetch('/UrasUretimUrunAgaci/GetOWHS').then(r => r.json());
        if (res.success) depoListesi = res.data || [];
    }

    function anaUrunAramaAc() {
        aramaHedefSatir = -1;
        document.getElementById('urunAramaBaslik').textContent = 'Ana Ürün Seçimi';
        document.getElementById('urunAramaMetin').value = '';
        urunAramaFiltrele();
        new bootstrap.Modal(document.getElementById('urunAramaModal')).show();
    }
    function bilesenAramaAc(index) {
        aramaHedefSatir = index;
        document.getElementById('urunAramaBaslik').textContent = 'Bileşen Seçimi';
        document.getElementById('urunAramaMetin').value = '';
        urunAramaFiltrele();
        new bootstrap.Modal(document.getElementById('urunAramaModal')).show();
    }
    function urunAramaFiltrele() {
        const q = (document.getElementById('urunAramaMetin').value || '').toLowerCase();
        const list = urunListesi.filter(u => !q || u.ItemCode.toLowerCase().includes(q) || (u.ItemName || '').toLowerCase().includes(q));
        document.getElementById('tbodyUrunArama').innerHTML = list.slice(0, 300).map((u, i) => `
            <tr style="cursor:pointer" onclick="urunSecildi('${u.ItemCode}')"><td class="text-muted">${i + 1}</td><td class="fw-bold text-primary">${u.GizliTanim || u.ItemCode}</td><td>${u.ItemName}</td></tr>`).join('')
            || '<tr><td colspan="3" class="text-center text-muted py-3">Kayıt bulunamadı.</td></tr>';
    }
    function urunSecildi(itemCode) {
        const u = urunListesi.find(x => x.ItemCode === itemCode);
        if (!u) return;
        if (aramaHedefSatir === -1) {
            document.getElementById('anaUrunKod').value = u.GizliTanim || u.ItemCode;
            document.getElementById('anaUrunKod').dataset.itemcode = u.ItemCode;
            document.getElementById('anaUrunAd').value = u.ItemName;
            document.getElementById('anaBirim').textContent = u.InvntryUom || '';
        } else {
            satirlar[aramaHedefSatir].No = u.ItemCode;
            satirlar[aramaHedefSatir].ItemName = u.ItemName;
            satirlar[aramaHedefSatir].maliyetHazir = false;
            cizSatirlar();
            getKalemMaliyet(aramaHedefSatir);
        }
        bootstrap.Modal.getInstance(document.getElementById('urunAramaModal')).hide();
    }

    function depoAramaAc(hedef) {
        depoHedefSatir = hedef;
        document.getElementById('depoAramaMetin').value = '';
        depoAramaFiltrele();
        new bootstrap.Modal(document.getElementById('depoAramaModal')).show();
    }
    function depoAramaFiltrele() {
        const q = (document.getElementById('depoAramaMetin').value || '').toLowerCase();
        const list = depoListesi.filter(d => !q || d.WhsCode.toLowerCase().includes(q) || (d.WhsName || '').toLowerCase().includes(q));
        document.getElementById('tbodyDepoArama').innerHTML = list.map(d => `
            <tr style="cursor:pointer" onclick="depoSecildi('${d.WhsCode}')"><td><span class="badge bg-light text-dark border">${d.WhsCode}</span></td><td>${d.WhsName}</td></tr>`).join('')
            || '<tr><td colspan="2" class="text-center text-muted py-3">Kayıt bulunamadı.</td></tr>';
    }
    function depoSecildi(whsCode) {
        if (depoHedefSatir === 'ana') document.getElementById('anaDepo').value = whsCode;
        else { satirlar[depoHedefSatir].Warehouse = whsCode; cizSatirlar(); }
        bootstrap.Modal.getInstance(document.getElementById('depoAramaModal')).hide();
    }

    function satirEkle() {
        satirlar.push({ No: '', ItemName: '', Quantity: 0, Warehouse: '', ChildNum: -1, maliyetHazir: false });
        cizSatirlar();
    }
    function satirSil(index) {
        satirlar.splice(index, 1);
        cizSatirlar();
    }

    // Reçete Birim Maliyet ekranıyla aynı mantık (kur çevrimli TL + USD/EUR karşılığı) —
    // kaynaktaki kopyalaMaliyet fonksiyonuyla birebir.
    function kopyalaMaliyet(row, m) {
        row.BirimCevrimTRY = m.BirimCevrimTRY || 0;
        row.BirimCevrimUSD = m.BirimCevrimUSD || 0;
        row.BirimCevrimEUR = m.BirimCevrimEUR || 0;
        row.KurEksik = !!m.KurEksik;
        row.Kaynak = m.Kaynak;
        row.maliyetHazir = true;
    }

    async function getKalemMaliyet(index) {
        const row = satirlar[index];
        if (!row || !row.No) return;
        const istenenKod = row.No;
        const res = await fetch('/UrasUretimUrunAgaci/GetKalemMaliyet?code=' + encodeURIComponent(istenenKod)).then(r => r.json());
        // Yarış durumu koruması: kullanıcı bu satır için başka bir kalem seçmiş olabilir —
        // yanıt hâlâ ekrandaki güncel kalemle mi eşleşiyor kontrol edilmeden yazılmasın.
        if (res.success && res.data && row.No === istenenKod && res.data.ItemCode === row.No) kopyalaMaliyet(row, res.data);
        cizSatirlar();
    }

    // Kayıtlı ağacın satır maliyetleri: Reçete Birim Maliyet raporundan tek seferde,
    // VisOrder (Sira-1) üzerinden satırlarla eşlenerek alınır (kaynaktaki loadMaliyet).
    async function maliyetleriYukle(itemCode) {
        const res = await fetch('/UrasUretimUrunAgaci/GetReceteMaliyet?code=' + encodeURIComponent(itemCode)).then(r => r.json());
        if (!res.success) return;
        const gelenler = res.data || [];
        satirlar.forEach(row => {
            if (row.ChildNum === -1) return;
            const m = gelenler.find(x => x.Sira - 1 === row.ChildNum);
            if (m) kopyalaMaliyet(row, m);
        });
        cizSatirlar();
    }

    function cizSatirlar() {
        document.getElementById('satirSayisi').textContent = satirlar.length;
        document.getElementById('bosMesaj').style.display = satirlar.length ? 'none' : '';
        document.getElementById('tbodySatirlar').innerHTML = satirlar.map((s, i) => `
            <tr>
                <td><button class="btn btn-sm btn-outline-danger" onclick="satirSil(${i})"><i class="fas fa-trash"></i></button></td>
                <td>${s.ChildNum !== -1 ? '<span class="rozet rozet-kayitli">Kayıtlı</span>' : '<span class="rozet rozet-yeni">Yeni</span>'}</td>
                <td class="text-nowrap">
                    <button class="btn btn-sm btn-outline-primary" onclick="bilesenAramaAc(${i})"><i class="fas fa-search"></i></button>
                    <div class="small fw-bold text-primary mt-1">${s.No || ''}</div>
                </td>
                <td>${s.ItemName || '<span class="text-muted small">Bileşen seçilmedi</span>'}</td>
                <td class="text-end"><input type="number" min="0" step="0.001" class="form-control form-control-sm text-end" value="${s.Quantity}" oninput="satirlar[${i}].Quantity = parseFloat(this.value)||0; cizToplamMaliyet();"></td>
                <td class="text-muted">—</td>
                <td>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" value="${s.Warehouse || ''}" oninput="satirlar[${i}].Warehouse=this.value">
                        <button class="btn btn-outline-primary" onclick="depoAramaAc(${i})"><i class="fas fa-search"></i></button>
                    </div>
                </td>
                <td class="text-end">
                    ${!s.No ? '<span class="text-muted small">—</span>'
                        : (s.maliyetHazir
                            ? `<div class="fw-bold">${fmt(s.BirimCevrimTRY, 2)} ₺</div>
                               <div class="small text-muted">${[s.BirimCevrimUSD > 0 ? '≈ ' + fmt(s.BirimCevrimUSD, 2) + ' $' : '', s.BirimCevrimEUR > 0 ? '≈ ' + fmt(s.BirimCevrimEUR, 2) + ' €' : ''].filter(Boolean).join(' • ')}</div>
                               ${s.KurEksik ? '<span class="rozet" style="background:#fde8e8;color:#c0392b;">Kur eksik</span>' : (s.Kaynak === 'Fiyat yok' ? '<span class="rozet" style="background:#fff8e6;color:#b7791f;">Fiyat yok</span>' : '')}`
                            : '<span class="spinner-border spinner-border-sm text-muted"></span>')}
                </td>
            </tr>`).join('');
        cizToplamMaliyet();
    }

    function cizToplamMaliyet() {
        const hazirOlanlar = satirlar.filter(s => s.maliyetHazir);
        if (!hazirOlanlar.length) { document.getElementById('toplamMaliyet').textContent = ''; return; }
        const toplam = hazirOlanlar.reduce((t, s) => t + (parseFloat(s.Quantity) || 0) * (s.BirimCevrimTRY || 0), 0);
        document.getElementById('toplamMaliyet').innerHTML = hazirOlanlar.length < satirlar.length
            ? `Toplam (kısmi): <b>${fmt(toplam, 2)} ₺</b>`
            : `Toplam Bileşen Maliyeti: <b>${fmt(toplam, 2)} ₺</b>`;
    }

    async function kaydet() {
        const itemCode = document.getElementById('anaUrunKod').dataset.itemcode;
        if (!itemCode) { alert('Ana ürün seçilmedi.'); return; }
        if (!satirlar.length) { alert('En az bir bileşen eklemelisiniz.'); return; }
        for (const s of satirlar) if (!s.No) { alert('Boş bileşen satırı var, doldurun veya silin.'); return; }

        const govde = {
            ItemCode: itemCode,
            Quantity: parseFloat(document.getElementById('bazMiktar').value) || 0,
            Warehouse: document.getElementById('anaDepo').value,
            Items: satirlar.map(s => ({ No: s.No, Quantity: s.Quantity, Warehouse: s.Warehouse, ChildNum: s.ChildNum }))
        };
        const url = duzenlemeModu ? '/UrasUretimUrunAgaci/updateProductTree' : '/UrasUretimUrunAgaci/addProductTree';
        const btn = document.getElementById('btnKaydet');
        btn.disabled = true;
        try {
            const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(govde) }).then(r => r.json());
            alert(res.message);
            if (res.success) { duzenlemeModu = true; await agaciYukle(itemCode); }
        } finally { btn.disabled = false; }
    }

    async function agaciYukle(itemCode) {
        const [baslikRes, satirRes] = await Promise.all([
            fetch('/UrasUretimUrunAgaci/GetUrunAgaciBaslik?code=' + encodeURIComponent(itemCode)).then(r => r.json()),
            fetch('/UrasUretimUrunAgaci/GetITT1?code=' + encodeURIComponent(itemCode)).then(r => r.json())
        ]);
        if (baslikRes.success && baslikRes.data) {
            document.getElementById('bazMiktar').value = baslikRes.data.BazMiktar;
            document.getElementById('anaDepo').value = baslikRes.data.Depo || '';
            document.getElementById('anaBirim').textContent = baslikRes.data.Birim || '';
        }
        if (satirRes.success) {
            satirlar = (satirRes.data || []).map(s => ({ No: s.No, ItemName: s.PrivateDescription, Quantity: s.Quantity, Warehouse: s.Warehouse, ChildNum: s.ChildNum, maliyetHazir: false }));
            cizSatirlar();
            maliyetleriYukle(itemCode);
        }
    }

    (async function init() {
        await Promise.all([urunListesiniYukle(), depoListesiniYukle()]);
    })();
</script>
