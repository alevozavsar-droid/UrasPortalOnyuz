@model List<WebApplication3.Controllers.Rapor61ViewModel>
@using WebApplication3.Models

@{
    ViewData["Title"] = "Stok Hareket Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 1. KURAL: URL'den veya Cookie'den aktif şirketi okuyan değişken
    var currentDb = Context.Request.Query["db"].FirstOrDefault() ?? Context.Request.Cookies["AktifSirket"] ?? "";

    var currentSelectedDbDisplay = (string)ViewBag.CurrentDbDisplay ?? "Bilinmiyor";
    var modelData = Model ?? new List<WebApplication3.Controllers.Rapor61ViewModel>();

    // Alt toplamlar
    var topGirenMiktar = modelData.Sum(x => x.GirenMiktar);
    var topGirisTutar = modelData.Sum(x => x.GirisTutari);
    var topCikanMiktar = modelData.Sum(x => x.CikanMiktar);
    var topCikisTutar = modelData.Sum(x => x.CikisTutari);
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            font-size: 0.85rem;
            overflow-y: hidden;
        }

        .container-fluid { padding: 5px 15px !important; }
        
        /* Form elemanları standart yükseklik (28px - Excel stili) */
        .form-control, .btn, .form-select { 
            font-size: 11px; 
            padding: 2px 6px; 
            height: 28px; 
        }

        /* --- SELECT2 EXCEL STİLİ ÖZELLEŞTİRME --- */
        
        /* 1. Kutu yüksekliğini sabitle ve taşmaları gizle */
        .select2-container--bootstrap-5 .select2-selection--multiple {
            min-height: 28px !important;
            height: 28px !important;
            font-size: 11px;
            padding: 0 4px;
            display: flex;
            align-items: center;
            overflow: hidden !important;
            border-color: #dee2e6;
        }

        /* 2. Seçilen mavi etiketleri (tags) tamamen GİZLE */
        .select2-selection__choice {
            display: none !important;
        }

        /* 3. Metin hizalaması (Örn: "3 Malzeme Seçildi") */
        .select2-selection__rendered {
            padding-left: 4px !important;
            color: #212529;
            width: 100%;
            line-height: 26px !important;
        }

        /* 4. Arama kutusunu hizala */
        .select2-search--inline, .select2-search__field {
            margin: 0 !important;
            height: 24px !important;
            line-height: 24px !important;
        }

        /* --- TABLO AYARLARI --- */
        .table-container {
            height: calc(100vh - 150px); /* Geri dön butonu için bir tık küçültüldü */
            overflow: auto;
            border: 1px solid #dee2e6;
            background-color: white;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            margin-top: 5px;
        }

        table { width: 100%; border-collapse: separate; border-spacing: 0; }
        
        th, td {
            padding: 4px 6px !important;
            font-size: 11px !important;
            border: 1px solid #ddd;
            vertical-align: middle;
            white-space: nowrap;
            color: #212529;
        }

        /* --- STICKY HEADER --- */
        thead { position: sticky; top: 0; z-index: 10; }

        /* 1. Satır Başlıklar (Gruplar) */
        thead tr:nth-child(1) th {
            position: sticky; top: 0;
            background-color: #2c3e50; color: white;
            z-index: 20; height: 28px; text-align: center;
            border: 1px solid #34495e;
        }

        /* 2. Satır Başlıklar (Detaylar) */
        thead tr:nth-child(2) th {
            position: sticky; top: 28px;
            color: #000;
            z-index: 20; height: 32px; text-align: center;
            border-bottom: 2px solid #aaa;
            font-weight: 700;
        }

        /* Renkli Başlıklar */
        .header-giris { background-color: #d4edda !important; }
        .header-cikis { background-color: #f8d7da !important; }
        .header-siparis { background-color: #fff3cd !important; }
        .header-default { background-color: #e9ecef !important; }

        .num { 
            text-align: right; 
            font-family: 'Consolas', 'Monaco', monospace;
            font-weight: 700;
            color: #000;
        }
        
        .text-center { text-align: center; }
        .fw-bold { font-weight: bold; }

        /* Footer */
        tfoot tr {
            position: sticky; bottom: 0; z-index: 20;
            background-color: #dee2e6;
        }
        tfoot td {
            background-color: #dee2e6 !important;
            font-weight: bold; font-size: 12px !important;
            border-top: 2px solid #555; color: #000;
        }
        
        tbody tr:hover { background-color: #fff8b3 !important; cursor: default; }
        .table-striped tbody tr:nth-of-type(odd) { background-color: rgba(0,0,0,.02); }
    </style>
}

@* 2. KURAL: Güvenlik (CSRF) - Yetkisiz veri işlemlerini engellemek için eklendi *@
@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-body p-2">
            <form asp-controller="Rapor61" asp-action="Index" method="get" id="raporForm">
                
                @* 1. KURAL: GET formuna şirket bilgisini ekleyen gizli input *@
                <input type="hidden" name="db" value="@currentDb" />

                <div class="row g-1 align-items-end">
                    <div class="col-auto">
                        <h6 class="m-0 fw-bold text-primary"><i class="fas fa-chart-bar me-2"></i>Stok Hareket <span class="text-secondary small">(@currentSelectedDbDisplay)</span></h6>
                    </div>

                    <div class="col-auto ms-auto">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text fw-bold py-0">Başlangıç</span>
                            <input type="date" class="form-control" name="startDate" value="@ViewBag.StartDate">
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text fw-bold py-0">Bitiş</span>
                            <input type="date" class="form-control" name="endDate" value="@ViewBag.EndDate">
                        </div>
                    </div>

                    <div class="col-auto" style="min-width: 250px; max-width: 300px;">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text py-0"><i class="fas fa-box"></i></span>
                            
                            <select class="form-select" name="selectedItems" id="itemsSelect" multiple="multiple">
                                @if (ViewBag.MaterialList != null)
                                {
                                    foreach (var item in (List<SelectListItem>)ViewBag.MaterialList)
                                    {
                                        var isSelected = ViewBag.SelectedItems != null && ((List<string>)ViewBag.SelectedItems).Contains(item.Value);
                                        <option value="@item.Value" selected="@(isSelected ? "selected" : null)">@item.Text</option>
                                    }
                                }
                            </select>

                        </div>
                    </div>

                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Listele</button>
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-success w-100 fw-bold" id="exportToExcelButton">
                            <i class="fas fa-file-excel"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="table-container">
        @if (modelData.Any())
        {
            <table class="table table-bordered table-striped mb-0">
                <thead>
                    <tr>
                        <th colspan="7">Temel Bilgiler</th>
                        <th colspan="3" class="bg-success text-white">Giriş Bilgileri</th>
                        <th class="bg-warning text-dark">Sipariş</th>
                        <th colspan="6" class="bg-danger text-white">Çıkış & Bağlantı Bilgileri</th>
                        <th colspan="4">Cari Bilgileri</th>
                    </tr>
                    <tr>
                        <th class="header-default">Malzeme Kodu</th>
                        <th class="header-default">Malzeme Adı</th>
                        <th class="header-default">Birim</th>
                        <th class="header-default">İşlem Tarihi</th>
                        <th class="header-default">Belge No</th>
                        <th class="header-default">Hareket</th>
                        <th class="header-default">İade</th>

                        <th class="header-giris">Giren Miktar</th>
                        <th class="header-giris">Birim Fiyat</th>
                        <th class="header-giris">Giriş Tutarı</th>

                        <th class="header-siparis">Anlaş. Döviz</th>

                        <th class="header-cikis">Çıkan Miktar</th>
                        <th class="header-cikis">Sipariş No</th>
                        <th class="header-cikis">Satış Miktar</th>
                        <th class="header-cikis">Fat. Miktar</th>
                        <th class="header-cikis">Çıkış Fiyat</th>
                        <th class="header-cikis">Çıkış Tutar</th>

                        <th class="header-default">Cari Kodu</th>
                        <th class="header-default">Cari Adı</th>
                        <th class="header-default">Cari Tipi</th>
                        <th class="header-default">Depo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in modelData)
                    {
                        <tr>
                            <td class="fw-bold">@item.MalzemeKodu</td>
                            <td title="@item.MalzemeAdi">
                                @if(item.MalzemeAdi != null && item.MalzemeAdi.Length > 35)
                                {
                                    @item.MalzemeAdi.Substring(0, 35) <span class="text-muted">...</span>
                                }
                                else
                                {
                                    @item.MalzemeAdi
                                }
                            </td>
                            <td class="text-center">@item.BirimCinsi</td>
                            <td class="text-center">@item.IslemTarihi.ToString("dd.MM.yyyy")</td>
                            <td>@item.BelgeNo</td>
                            <td class="text-center">@item.StokHareketSekli</td>
                            <td class="text-center text-danger fw-bold">@item.IadeDurumu</td>

                            <td class="num text-success">@item.GirenMiktar.ToString("N2")</td>
                            <td class="num">@item.GirisFiyati.ToString("N2")</td>
                            <td class="num">@item.GirisTutari.ToString("N2")</td>

                            <td class="num text-primary">@item.AnlasilanDoviz</td>

                            <td class="num text-danger">@item.CikanMiktar.ToString("N2")</td>
                            <td class="text-center">@((item.SiparisNo == 0) ? "" : item.SiparisNo.ToString())</td>
                            <td class="num">@item.SatisMiktar.ToString("N2")</td>
                            <td class="num">@item.FaturalanmisMiktar.ToString("N2")</td>
                            <td class="num">@item.CikisFiyati.ToString("N2")</td>
                            <td class="num">@item.CikisTutari.ToString("N2")</td>

                            <td>@item.CariKodu</td>
                            <td title="@item.CariAdi">
                                @if (item.CariAdi != null && item.CariAdi.Length > 25)
                                {
                                    @item.CariAdi.Substring(0, 25)<span class="text-muted">...</span>
                                }
                                else
                                {
                                    @item.CariAdi
                                }
                            </td>
                            <td>@item.CariHesapTipi</td>
                            <td class="text-center">@item.DepoKodu</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="7" class="text-end"><strong>GENEL TOPLAM:</strong></td>
                        
                        <td class="num">@topGirenMiktar.ToString("N2")</td>
                        <td></td>
                        <td class="num">@topGirisTutar.ToString("N2")</td>
                        
                        <td></td>
                        
                        <td class="num">@topCikanMiktar.ToString("N2")</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td class="num">@topCikisTutar.ToString("N2")</td>
                        
                        <td colspan="4"></td>
                    </tr>
                </tfoot>
            </table>
        }
        else
        {
            <div class="alert alert-warning m-3 text-center" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i> Veri bulunamadı veya tarih aralığı seçilmedi.
            </div>
        }
    </div>

    @* 4. KURAL: UI/UX Standartlarına uygun şık, db parametreli Ana Sayfa butonu *@
    <div class="mt-3 mb-2 text-center">
        <a asp-controller="Home" asp-action="Index" asp-route-db="@currentDb" class="btn btn-outline-secondary fw-bold shadow-sm">
            <i class="fas fa-home me-2"></i> Ana Sayfaya Dön
        </a>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            
            // --- EXCEL TİPİ SEÇİM KUTUSU ---
            var $itemSelect = $('#itemsSelect');

            $itemSelect.select2({
                theme: 'bootstrap-5',
                placeholder: "Malzeme Seçiniz",
                allowClear: true,
                width: '100%',
                closeOnSelect: false, // Seçim yapınca kapanmaz
                language: {
                    noResults: function() { return "Sonuç bulunamadı"; }
                }
            });

            // Metin Güncelleme Fonksiyonu
            function updateSelectionText() {
                var count = $itemSelect.val() ? $itemSelect.val().length : 0;
                var $renderedContainer = $itemSelect.next('.select2-container').find('.select2-selection__rendered');

                if (count > 0) {
                    // "X Malzeme Seçildi" yazısını mavi ve kalın yaz
                    $renderedContainer.html('<span class="fw-bold text-primary">' + count + ' Malzeme Seçildi</span>');
                    $renderedContainer.css('opacity', '1');
                } else {
                    // Seçim yoksa temizle (varsayılan placeholder görünür)
                    $renderedContainer.removeAttr('style');
                }
            }

            // Olayları Dinle
            $itemSelect.on('change select2:select select2:unselect select2:close', function () {
                updateSelectionText();
            });

            // Sayfa yüklendiğinde çalıştır
            updateSelectionText();

            // --- EXCEL EXPORT BUTONU ---
            $('#exportToExcelButton').on('click', function () {
                var startDate = $('input[name="startDate"]').val();
                var endDate = $('input[name="endDate"]').val();
                
                var selectedItems = $('#itemsSelect').val();

                // 1. KURAL: Şirket bilgisini Razor'dan garanti şekilde çekiyoruz
                var exportUrl = '@Url.Action("ExportToExcel", "Rapor61")' +
                                '?startDate=' + encodeURIComponent(startDate) +
                                '&endDate=' + encodeURIComponent(endDate) +
                                '&db=' + '@currentDb';

                if (selectedItems && selectedItems.length > 0) {
                    selectedItems.forEach(function(item) {
                        exportUrl += '&selectedItems=' + encodeURIComponent(item);
                    });
                }

                window.location.href = exportUrl;
            });
        });
    </script>
}