@model List<WebApplication3.Controllers.SubAccountViewModel>
@using System.Globalization

<style>
    /* Modal içi özel stiller */
    .sub-table th {
        background-color: #f1f5f9;
        color: #1a252f;
        font-weight: 600;
        border-bottom: 2px solid #e2e8f0;
    }

    .btn-xs {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        border-radius: 0.2rem;
    }
</style>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning m-3 border-0 shadow-sm" style="background-color: #fff3cd; color: #856404;">
        <i class="fas fa-exclamation-circle me-2"></i>
        <strong>Veri Yok:</strong> Bu kriterlere uygun alt hesap hareketi bulunamadı.
    </div>
}
else
{
    <div class="table-responsive p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="badge bg-secondary">@Model.Count Alt Hesap Listeleniyor</span>
        </div>

        <table class="table table-hover mb-0 sub-table align-middle">
            <thead>
                <tr>
                    <th style="width: 20%;">Hesap Kodu</th>
                    <th style="width: 45%;">Hesap Adı</th>
                    <th style="width: 20%;" class="text-end">Bakiye</th>
                    <th style="width: 15%;" class="text-center">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">
                            <i class="fas fa-folder me-2 text-warning opacity-75"></i>@item.AccountCode
                        </td>

                        <td class="text-dark">@item.AccountName</td>

                        <td class="text-end fw-bold text-dark">
                            @item.Balance.ToString("N2", CultureInfo.CurrentCulture)
                        </td>

                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-primary shadow-sm"
                                    onclick="openTransactions('@item.DbCode', '@item.AccountCode')"
                                    title="Hareketleri Gör">
                                <i class="fas fa-list-ul me-1"></i> Ekstre
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-bold border-top">
                <tr>
                    <td colspan="2" class="text-end text-uppercase text-muted small">Grup Toplamı:</td>
                    <td class="text-end text-dark">
                        @Model.Sum(x => x.Balance).ToString("N2", CultureInfo.CurrentCulture)
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
}