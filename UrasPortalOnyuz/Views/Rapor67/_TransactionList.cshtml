@model List<WebApplication3.Controllers.TransactionViewModel>
@using System.Globalization

<div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light border-bottom">
    <div>
        <h6 class="m-0 text-primary fw-bold text-uppercase">
            <i class="fas fa-file-invoice-dollar me-2"></i> @ViewBag.AccountCode
        </h6>
        <small class="text-muted">Hesap Ekstresi Detayları</small>
    </div>
    <div class="badge bg-dark">
        @if (Model != null)
        {
            <span>@Model.Count Adet Fiş</span>
        }
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info m-3 border-0 shadow-sm">
        <i class="fas fa-info-circle me-2"></i> Seçilen filtreler için fiş kaydı bulunamadı.
    </div>
}
else
{
    <div class="table-responsive px-3 pb-3">
        <table class="table table-sm table-striped table-hover table-bordered align-middle" style="font-size: 0.85rem;">
            <thead class="text-center" style="background-color: #2c3e50; color: white;">
                <tr>
                    <th style="width: 50px;">Tip</th>
                    <th>Yevmiye</th>
                    <th>Tarih</th>
                    <th class="text-start">Açıklama</th>
                    <th class="text-end">Borç</th>
                    <th class="text-end">Alacak</th>
                    <th class="text-end">Net Etki</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center fw-bold">
                            @if (item.IslemTipi == "X")
                            {
                                <span class="badge bg-primary">X</span>
                            }
                            else if (item.IslemTipi == "R")
                            {

                                <span class="badge bg-warning text-dark">R</span>
                            }
                            else if (item.IslemTipi == "Y")
                            {

                                <span class="badge bg-info text-dark">Y</span>
                            }
                            else
                            {

                                <span class="badge bg-secondary">-</span>
                            }
                        </td>

                        <td class="text-center">@item.TransId</td>
                        <td class="text-center">@item.RefDate.ToString("dd.MM.yyyy")</td>
                        <td class="text-start text-muted text-truncate" style="max-width: 250px;" title="@item.LineMemo">
                            @item.LineMemo
                        </td>

                        <td class="text-end text-secondary">
                            @if (item.Debit > 0)
                            {
                                @item.Debit.ToString("N2", CultureInfo.CurrentCulture)
                            }
                            else
                            {

                                <small>-</small>
                            }
                        </td>

                        <td class="text-end text-secondary">
                            @if (item.Credit > 0)
                            {
                                @item.Credit.ToString("N2", CultureInfo.CurrentCulture)
                            }
                            else
                            {

                                <small>-</small>
                            }
                        </td>

                        <td class="text-end fw-bold">
                            @if (item.NetTutar > 0)
                            {
                                <span class="text-success">+@item.NetTutar.ToString("N2", CultureInfo.CurrentCulture)</span>
                            }
                            else if (item.NetTutar < 0)
                            {
                                <span class="text-danger">@item.NetTutar.ToString("N2", CultureInfo.CurrentCulture)</span>
                            }
                            else
                            {
                                <span class="text-muted">0.00</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-secondary fw-bold border-top border-secondary">
                <tr>
                    <td colspan="4" class="text-end">TOPLAM:</td>
                    <td class="text-end">@Model.Sum(x => x.Debit).ToString("N2", CultureInfo.CurrentCulture)</td>
                    <td class="text-end">@Model.Sum(x => x.Credit).ToString("N2", CultureInfo.CurrentCulture)</td>
                    <td class="text-end text-dark">@Model.Sum(x => x.NetTutar).ToString("N2", CultureInfo.CurrentCulture)</td>
                </tr>
            </tfoot>
        </table>
    </div>
}