                    }

                    if (!confirm(`DocEntry: ${docEntry} olan kaydı SİLMEK (İptal olarak işaretlemek) istediğinizden emin misiniz?`)) return;

                    const payload = { DocEntry: docEntry };

                    try {
                        const response = await fetch('/Rapor30/Delete' + dbQueryString, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': xsrfToken },
                            body: JSON.stringify(payload)
                        });
                        const result = await response.json();

                        if (response.ok && result.success) {
                            showAlert(result.message + " Sayfa yenileniyor...", 'success');
                            setTimeout(() => { window.location.reload(); }, 300);
                        } else {
                            showAlert(`Silme Başarısız: ${result.message}`, 'error');
                        }
                    } catch (error) {
                        showAlert('Silme sırasında bir ağ hatası oluştu.', 'error');
                    }

                // SÜTUN BOYAMA (GLOBAL)
                } else if (action.startsWith('set-column-color') || action === 'clear-column') {
                    const newColor = actionElement.dataset.color || null;
                    const fieldName = actionElement.dataset.fieldName;
                    const colorValue = newColor ?? 'NULL';

                    if (!confirm(`"${displayNames[fieldName]}" sütununun rengini TÜM KAYITLAR için ${newColor ? newColor.toUpperCase() : 'KALDIRMAK'} istediğinizden emin misiniz?`)) return;

                    await updateGlobalColor(fieldName, colorValue);

                // HÜCRE BOYAMA
                } else if (action.startsWith('set-cell-color') || action === 'clear-cell') {
                    if (!clickedCell || clickedCell.dataset.tableName !== MASTER_TABLE) {
                        showAlert('Hücre boyama sadece Ana Tablo hücrelerinde desteklenir.', 'warning');
                        return;
                    }
                    if (docEntry < 0) { showAlert('Yeni kayıtlar kaydedilmeden boyanamaz.', 'warning'); return; }

                    const newColor = actionElement.dataset.color || null;
                    const localItem = allReportData.find(item => item.DocEntry === docEntry);
                    let hucreRenkleri = {};

                    try {
                        hucreRenkleri = JSON.parse(localItem.HucreRenkleri && localItem.HucreRenkleri !== 'NULL' ? localItem.HucreRenkleri : '{}');
                    } catch { hucreRenkleri = {}; }

                    if (newColor) {
                        hucreRenkleri[cellFieldName] = `cell-color-${newColor}`;
                    } else {
                        delete hucreRenkleri[cellFieldName];
                    }

                    const keys = Object.keys(hucreRenkleri);
                    const newColorJson = keys.length === 0 ? 'NULL' : JSON.stringify(hucreRenkleri);

                    const payload = {
                        DocEntry: docEntry, FieldName: "HucreRenkleri", FieldValue: newColorJson, TableName: MASTER_TABLE
                    };

                    const updateResult = await saveUpdate(payload);

                    if (updateResult.success) {
                        const newClass = newColor ? `cell-color-${newColor}` : '';
                        clickedCell.classList.remove('cell-color-green', 'cell-color-red', 'cell-color-blue');
                        if (newClass) clickedCell.classList.add(newClass);
                        if (localItem) localItem.HucreRenkleri = newColorJson;
                    }

                // ALT KAYIT EKLEME
                } else if (action === 'add-teminat-detail' || action === 'add-kefalet-detail') {

                    if (docEntry < 0) { showAlert('Kaydedilmemiş kayda detay eklenemez.', 'warning'); return; }

                    const isTeminat = action === 'add-teminat-detail';
                    const endpoint = isTeminat ? '/Rapor30/CreateTeminatDetay' : '/Rapor30/CreateKefaletDetay';

                    const firmaAdiCell = clickedRow.querySelector('[data-field-name="FirmaAdi"]');
                    const firmaAdi = firmaAdiCell ? firmaAdiCell.dataset.originalValue : 'Firma';

                    let newDetail = { U_DocEntry: docEntry };

                    if (isTeminat) {
                        newDetail.TeminatTuru = "İpotek";
                        newDetail.IpotekVeren = firmaAdi;
                    } else {
                        newDetail.KefilAdiUnvani = firmaAdi;
                        newDetail.KefaletTuru = "Müşterek";
                    }

                    try {
                        const response = await fetch(endpoint + dbQueryString, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': xsrfToken },
                            body: JSON.stringify(newDetail)
                        });

                        const result = await response.json();

                        if (response.ok && result.success) {
                            showAlert(result.message + " Sayfa yenileniyor...", 'success');
                            setTimeout(() => { window.location.reload(); }, 300);
                        } else {
                            showAlert(`Alt Kayıt Ekleme Başarısız: ${result.message}`, 'error');
                        }
                    } catch (error) {
                        showAlert('Alt kayıt ekleme sırasında bir ağ hatası oluştu.', 'error');
                    }
                }
            });


            // ====================================================================
            // SIRALAMA, FİLTRE VE RENDER LOGIC'İ
            // ====================================================================

            function getColumnValue(item, column) {
                let value = item[column];
                if (item.DocEntry < 0) return sortDirection === 'asc' ? -Infinity : Infinity;

                if (value === null || value === undefined) return sortDirection === 'asc' ? '' : 'zzzzz';

                if (column === "DocNum") return item.DocNum ?? 0;
                if (column === "DosyaYolu") return value ? "Z_Var" : "A_Yok";

                if (dateFields.includes(column) || column.includes('Tarihi')) {
                    const date = new Date(value);
                    return isNaN(date.getTime()) ? (sortDirection === 'asc' ? 0 : Number.MAX_SAFE_INTEGER) : date.getTime();
                }

                if (numberFields.includes(column) || column.includes('Sayisi') || column.includes('Adedi') || column.includes('Vade') || column.includes('Tutar') || column.includes('Orani') || column.includes('Degeri')) {
                    const number = parseFloat(value);
                    return isNaN(number) ? (sortDirection === 'asc' ? -Infinity : Infinity) : number;
                }

                return value.toString().toLowerCase();
            }

            function sortData(data, column, direction) {
                data.sort((a, b) => {
                    const valA = getColumnValue(a, column);
                    const valB = getColumnValue(b, column);

                    if (valA < valB) return direction === 'asc' ? -1 : 1;
                    if (valA > valB) return direction === 'asc' ? 1 : -1;
                    return 0;
                });
                return data;
            }

            function filterAndRenderTable() {
                let filteredData = [...allReportData];

                const filterInputs = document.querySelectorAll('.filter-input');
                const filterSelects = $('.filter-select-bs');

                // Metin Filtreleri
                filterInputs.forEach(input => {
                    const columnKey = input.closest('th').dataset.column;
                    const filterValue = input.value.toLowerCase().trim();

                    if (filterValue) {
                        filteredData = filteredData.filter(item => {
                            const val = item[columnKey];
                            if (val === null || val === undefined) return false;
                            
                            // Sayısal ve Tarih alanlarının formata uygun aranması için
                            const formattedStr = formatValue(val, columnKey).toLowerCase();
                            return formattedStr.includes(filterValue) || val.toString().toLowerCase().includes(filterValue);
                        });
                    }
                });

                // Çoklu Seçim Filtreleri
                filterSelects.each(function () {
                    const selectElement = $(this);
                    const columnKey = selectElement.closest('th').data('column');
                    const selectedValues = selectElement.val();

                    if (selectedValues && selectedValues.length > 0) {
                        filteredData = filteredData.filter(item => {
                            const val = item[columnKey];
                            if (val === null || val === undefined) return false;
                            
                            return selectedValues.some(sv => val.toString().toLowerCase() === sv.toLowerCase());
                        });
                    }
                });

                currentlyFilteredRows = filteredData;

                currentlyFilteredRows = applyFormulasToData(currentlyFilteredRows);

                currentlyFilteredRows = sortData(currentlyFilteredRows, sortColumn, sortDirection);

                renderTableBody(currentlyFilteredRows);
                
                // Kayıt sayısını güncelle
                const recordBadge = document.getElementById('rowCountBadge');
                if (recordBadge) {
                    recordBadge.textContent = 'Kayıt: ' + currentlyFilteredRows.length;
                }
            }

            function renderTableBody(data) {
                const existingRows = Array.from(tableBody.children);
                const rowMap = new Map();

                for (let i = 0; i < existingRows.length; i++) {
                    const row = existingRows[i];
                    if (row.classList.contains('master-row')) {
                        const docEntry = parseInt(row.dataset.docEntry);
                        let details = [row];

                        let next = existingRows[i + 1];
                        while(next && next.classList.contains('detail-row')) {
                            details.push(next);
                            i++;
                            next = existingRows[i + 1];
                        }
                        rowMap.set(docEntry, details);
                    }
                }

                tableBody.innerHTML = '';

                data.forEach(item => {
                    const rowsToAppend = rowMap.get(item.DocEntry);
                    if (rowsToAppend) {
                        const masterRow = rowsToAppend[0];

                        masterRow.querySelectorAll('td.editable-field').forEach(cell => {
                            const fieldName = cell.dataset.fieldName;
                            if (item.hasOwnProperty(fieldName)) {
                                cell.dataset.originalValue = item[fieldName];
                                cell.textContent = formatValue(item[fieldName], fieldName);

                                if (loadedFormulas.hasOwnProperty(fieldName) && loadedFormulas[fieldName]) {
                                    cell.classList.add('calculated-field');
                                } else {
                                    cell.classList.remove('calculated-field');
                                }
                            }
                        });

                        rowsToAppend.forEach(row => {
                            tableBody.appendChild(row);
                        });
                    }
                });

                setupEditableFields();
            }


            // ====================================================================
            // SAYFA BAŞLANGICI VE OLAY BAĞLANTILARI
            // ====================================================================

            async function initializePage() {
                // 1. Formülleri Yükle ve Uygula
                await loadAndInitializeFormulas();
                allReportData = applyFormulasToData(allReportData);
                currentlyFilteredRows = [...allReportData];

                // 2. Tabloyu ilk kez sırala ve render et
                filterAndRenderTable();

                // 3. Select Picker'ları başlat
                $('.filter-select-bs').selectpicker({
                    liveSearch: true,
                    actionsBox: true,
                    selectedTextFormat: 'count > 2',
                    width: '100%',
                    container: 'body'
                }).on('changed.bs.select', function() {
                    filterAndRenderTable();
                });
                
                // 4. Input filtrelerine event ekle
                document.querySelectorAll('.filter-input').forEach(input => {
                    input.addEventListener('keyup', filterAndRenderTable);
                });

                // --- SIRALAMA OLAYLARI ---
                document.querySelectorAll('th.sortable-column').forEach(header => {
                    header.addEventListener('click', function () {
                        const column = this.dataset.column;

                        document.querySelectorAll('th.sortable-column i').forEach(i => {
                            i.classList.remove('fa-sort-up', 'fa-sort-down', 'fa-sort');
                            i.classList.add('fa-sort');
                        });

                        if (sortColumn === column) {
                            sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
                        } else {
                            sortColumn = column;
                            sortDirection = 'asc';
                        }
                        this.querySelector('i').classList.remove('fa-sort');
                        this.querySelector('i').classList.add(sortDirection === 'asc' ? 'fa-sort-up' : 'fa-sort-down');

                        filterAndRenderTable();

                        showAlert(`Veriler '${column}' sütununa göre sıralandı.`, "info");
                    });
                });

                // Formül Modal'ını açma olayını bağla
                document.getElementById('openFormulaModalBtn').addEventListener('click', showFormulaModal);


                // Bootstrap Collapse olay dinleyicisi
                $('#rapor30Table').on('show.bs.collapse hide.bs.collapse', function (e) {
                    const targetRow = $(e.target).prev('tr');
                    const icon = targetRow.find('.fas.fa-chevron-down');
                    if (e.type === 'show') {
                        icon.addClass('fa-rotate-180');
                    } else {
                        icon.removeClass('fa-rotate-180');
                    }
                });

                // Yeni Satır Ekleme Olayı (URL'den db paramını kaybetmemesi lazım)
                if (addNewRowBtn) {
                    addNewRowBtn.addEventListener('click', function() {
                        if (allReportData.find(r => r.DocEntry < 0)) {
                            showAlert('Zaten bir boş kayıt mevcut. Lütfen önce onu kaydedin.', 'warning');
                            return;
                        }

                        showAlert('Boş satır eklendi. Sayfa yenileniyor...', 'info');
                        
                        let currentUrl = new URL(window.location.href);
                        currentUrl.searchParams.set('new', 'true');
                        if (currentDbParam && !currentUrl.searchParams.has('db')) {
                            currentUrl.searchParams.set('db', currentDbParam);
                        }
                        
                        window.location.href = currentUrl.toString();
                    });
                }

                // Başlık düzenleme işleyicileri
                document.querySelectorAll('.column-header-editable').forEach(header => {
                    header.addEventListener('dblclick', function(e) {
                        if (this.querySelector('input')) return;

                        const originalHeader = this;
                        const configKey = originalHeader.dataset.configKey;
                        const currentTitle = originalHeader.dataset.originalTitle;

                        const input = document.createElement('input');
                        input.type = 'text';
                        input.className = 'form-control form-control-sm';
                        input.value = currentTitle;
                        input.style.width = '100%';

                        originalHeader.childNodes.forEach(node => {
                            if (node.nodeType === 3 || node.nodeType === 1 && node.tagName !== 'I') {
                                originalHeader.removeChild(node);
                            }
                        });
                        originalHeader.prepend(input);
                        input.focus();

                        const saveTitle = async () => {
                            const newTitle = input.value.trim();

                            if (newTitle === currentTitle) {
                                restoreHeader(originalHeader, currentTitle);
                                return;
                            }

                            const updateResult = await updateGlobalColumnTitle(configKey, newTitle);

                            if (updateResult.success) {
                                showAlert(updateResult.message + " Sayfa yenileniyor...", 'success');
                                setTimeout(() => { window.location.reload(); }, 300);
                            } else {
                                restoreHeader(originalHeader, currentTitle);
                            }
                        };

                        input.addEventListener('blur', saveTitle);
                        input.addEventListener('keydown', (e) => {
                            if (e.key === 'Enter') {
                                e.preventDefault();
                                saveTitle();
                            } else if (e.key === 'Escape') {
                                e.preventDefault();
                                restoreHeader(originalHeader, currentTitle);
                            }
                        });
                    });
                });
            }

            // Başlık/Formül Güncelleme İşlevselliği
            async function updateGlobalColumnTitle(configKey, newTitle) {
                if (configKey.startsWith("ColumnTitle_") && newTitle && newTitle.trim() === '') {
                    showAlert("Başlık boş olamaz.", "warning");
                    return { success: false };
                }

                try {
                    const response = await fetch('/Rapor30/UpdateGlobalConfig' + dbQueryString, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': xsrfToken },
                        body: JSON.stringify({
                            ConfigKey: configKey,
                            ConfigValue: newTitle
                        })
                    });

                    const result = await response.json();
                    return { success: response.ok && result.success, message: result.message };

                } catch (error) {
                    showAlert('Başlık/Formül kaydetme sırasında bir ağ hatası oluştu.', 'error');
                    return { success: false, message: error.message };
                }
            }


            initializePage();
        });
    </script>
}