                    contextMenu.style.left = e.pageX + 'px';

                    const docEntry = clickedRow.dataset.docEntry;
                    const isNewRecord = docEntry && parseInt(docEntry) < 0;

                    const altKayitMenusu = contextMenu.querySelectorAll('li[data-action*="-detail"]');
                    altKayitMenusu.forEach(item => {
                        item.style.display = isNewRecord ? 'none' : 'block';
                    });

                    const cellColorItems = contextMenu.querySelectorAll('li[data-action*="-cell-color"], li[data-action="clear-cell"]');
                    const headerColorItems = contextMenu.querySelectorAll('li[data-action*="-column-color"], li[data-action="clear-column"]');

                    if (clickedCell && clickedCell.classList.contains('editable-field') && clickedCell.dataset.tableName === MASTER_TABLE) {
                        const isKrediTuruColumn = clickedCell.dataset.fieldName === "KrediTuru";
