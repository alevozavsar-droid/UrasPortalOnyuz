                        DocEntry: docEntry, FieldName: "SatirRengi", FieldValue: newColor ?? 'NULL', TableName: MASTER_TABLE
                    };

                    const updateResult = await saveUpdate(payload);
                    if (updateResult.success) {
                        const newClass = newColor ? `row-color-${newColor}` : '';
                        clickedRow.classList.remove('row-color-green', 'row-color-red', 'row-color-blue', 'row-color-yellow');
                        if (newClass) clickedRow.classList.add(newClass);
                        const localItem = allReportData.find(item => item.DocEntry === docEntry);
                        if (localItem) localItem.SatirRengi = newColor;
                    }

                // KAYIT SİLME
                } else if (action === 'delete-row') {
                    if (docEntry < 0) {
                        const detailRow = document.getElementById(`details-${docEntry}`);
                        if(detailRow) detailRow.remove();
                        clickedRow.remove();
