                                </th>
                                <th data-column="CekIslemTuru">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="İşlem Türü">
                                        @foreach (var type in checkTransactionTypes.OrderBy(t => t.Description))
                                        {
                                            if (type.Code != "0" && type.Code != "12")
                                            {
                                                <option value="@type.Code">@type.Description</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="IslemTipiAdi">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="İşlem Tipi">
                                        @if (distinctValues.ContainsKey("IslemTipiAdi"))
                                        {
                                            foreach (var item in distinctValues["IslemTipiAdi"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="PlanlananTedarikci">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Planlanan Tedarikçi">
                                        @if (distinctValues.ContainsKey("PlanlananTedarikci"))
                                        {
                                            foreach (var item in distinctValues["PlanlananTedarikci"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="CekKimeVerildi">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Çek Kime Verildi">
                                        @if (distinctValues.ContainsKey("CekKimeVerildi"))
                                        {
                                            foreach (var item in distinctValues["CekKimeVerildi"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="TlKarsiligi">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="TL Karşılığı">
                                        @if (distinctValues.ContainsKey("TlKarsiligi"))
                                        {
                                            foreach (var item in distinctValues["TlKarsiligi"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>

                <div class="row mt-2 d-flex justify-content-between align-items-center">
                    <div class="col-md-4">
                        <div id="pagination-info">
                            Toplam Kayıt: <strong id="totalRecords">@(Model?.Count ?? 0)</strong>
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm justify-content-center mb-0" id="page-links"></ul>
                        </nav>
                    </div>
                    <div class="col-md-4 text-right">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3 ms-2 mb-4">
        <a asp-action="Index" asp-controller="Home" asp-route-db="@currentDb" class="btn btn-outline-secondary fw-bold shadow-sm">
            <i class="fas fa-arrow-left me-2"></i> Ana Sayfaya Dön
        </a>
    </div>

</div>

@section Scripts {

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Aktif veritabanı parametresini JS değişkenine alıyoruz
            const currentDbParam = '@currentDb';
            const dbQueryString = currentDbParam ? `?db=${currentDbParam}` : '';

            const allReportData = @Html.Raw(reportDataJson);
            const table = document.getElementById('rapor2Table');
            const tableBody = table.querySelector('tbody');
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            const totalSelectedTlAmountSpan = document.getElementById('totalSelectedTlAmount');
            const selectedCheckCountSpan = document.getElementById('selectedCheckCount');
            const totalRecordsSpan = document.getElementById('totalRecords');

            let currentlyFilteredRows = [...allReportData];
            let currentSortColumn = 'GelmeNedeni'; // Varsayılan sıralama GelmeNedeni
            let currentSortDirection = 'asc';

            const columnMappings = {
                'Checkbox': null,
                'GelmeNedeni': 'GelmeNedeni',
                'CekNumarasi': 'CekNumarasi',
                'CekKimdenGeldi': 'CekKimdenGeldi',
                'AsilBorclu': 'AsilBorclu',
                'Tutar': 'Tutar',
                'ParaBirimi': 'ParaBirimi',
                'VadeTarihi': 'VadeTarihi',
                'VadeAyiVeYili': 'VadeAyiVeYili',
                'PortfoyeGirisTarihi': 'PortfoyeGirisTarihi',
                'IbrazTarihi': 'IbrazTarihi',
                'TahsilatBelgeNo': 'TahsilatBelgeNo',
                'IbrazBelgeNo': 'IbrazBelgeNo',
                'HareketDurumu': 'HareketDurumu',
                'BelgeTipi': 'BelgeTipi',
                'CekIslemTuru': 'CekIslemTuru',
                'IslemTipiAdi': 'IslemTipiAdi',
                'PlanlananTedarikci': 'PlanlananTedarikci',
                'CekKimeVerildi': 'CekKimeVerildi',
                'TlKarsiligi': 'TlKarsiligi'
            };

            const checkTransactionTypesJs = @Html.Raw(checkTransactionTypesJson);

            function updatePaginationInfo(totalCount) {
                const totalRecordsSpan = document.getElementById('totalRecords');
                if (totalRecordsSpan) {
                    totalRecordsSpan.textContent = totalCount;
                }
                const pageLinks = document.getElementById('page-links');
                if (pageLinks) {
                    pageLinks.innerHTML = '';
                }
            }

            function updateSelectAllCheckboxState() {
                if (!selectAllCheckbox) return;
                const visibleCheckboxes = document.querySelectorAll('#rapor2Table tbody tr:not([style*="display: none"]) .row-selector');
                if (visibleCheckboxes.length > 0) {
                    const allChecked = Array.from(visibleCheckboxes).every(checkbox => checkbox.checked);
                    const anyChecked = Array.from(visibleCheckboxes).some(checkbox => checkbox.checked);
                    selectAllCheckbox.checked = allChecked;
                    selectAllCheckbox.indeterminate = !allChecked && anyChecked;
                } else {
                    selectAllCheckbox.checked = false;
                    selectAllCheckbox.indeterminate = false;
                }
            }

            function getRowClassByGelmeNedeni(gelmeNedeni) {
                if (!gelmeNedeni) return '';
                const trimmed = gelmeNedeni.trim();
                if (trimmed.includes('Mükerrer Kayıt') && trimmed.includes('Vadesi Geçmiş')) {
                    return 'status-mukerrer-ve-gecmis';
                }
                if (trimmed.includes('Mükerrer Kayıt Şüphesi')) {
                    return 'status-mukerrer';
                }
                if (trimmed.includes('Vadesi Geçmiş Çek (Portföyde)')) {
                    return 'status-vadesi-gecmis';
                }
                return '';
            }

            function renderTable(data) {
                tableBody.innerHTML = '';
                if (data.length === 0) {
                    tableBody.innerHTML = '<tr><td colspan="20" class="text-center">Gösterilecek veri bulunamadı.</td></tr>';
                    updatePaginationInfo(0);
                    return;
                }
                const frag = document.createDocumentFragment();
                // Bu kısım, kolonların görünürlüğünü ve sırasını dinamik olarak yönetmek için önceki koddan korundu.
                const visibleColumns = window.currentColumnConfig || getInitialColumnConfig();

                data.forEach(item => {
                    const row = document.createElement('tr');

                    const newRowClass = getRowClassByGelmeNedeni(item.GelmeNedeni);
                    row.className = newRowClass;

                    row.dataset.docentry = item.DocEntry;
                    row.dataset.ibrazBelgeNo = item.IbrazBelgeNo;

                    visibleColumns.forEach(col => {
                        if (!col.visible) return;

                        const cell = document.createElement('td');
                        cell.dataset.column = col.columnName;

                        if (col.columnName === 'Checkbox') {
                            cell.className = 'checkbox-column';
                            const checkbox = document.createElement('input');
                            checkbox.type = 'checkbox';
                            checkbox.className = 'form-check-input row-selector';
                            checkbox.dataset.tlValue = item.TlKarsiligi || 0;
                            cell.appendChild(checkbox);
                        } else if (col.columnName === 'IbrazBelgeNo') {
                            if (item.IbrazBelgeNo) {
                                const link = document.createElement('a');
                                // Rota Güncellendi (Şirket parametresi ile indiriyoruz)
                                link.href = `/CekAkibetiRapor37/DownloadAttachment/${item.IbrazBelgeNo}${dbQueryString}`;
                                link.title = 'Eki Görüntüle';
                                link.target = '_blank';
                                link.textContent = item.IbrazBelgeNo;
                                link.addEventListener('click', (e) => { e.stopPropagation(); });
                                cell.appendChild(link);
                            } else {
                                cell.textContent = item.IbrazBelgeNo ?? '';
                            }
                        } else if (col.columnName === 'CekIslemTuru') {
                            const select = document.createElement('select');
                            select.className = 'form-control form-control-sm check-transaction-select';
                            select.dataset.docentry = item.DocEntry;
                            select.dataset.ibrazBelgeNo = item.IbrazBelgeNo;
                            select.dataset.previousValue = item.CekIslemTuru;

                            const emptyOption = document.createElement('option');
                            emptyOption.value = '';
                            emptyOption.textContent = 'Seçiniz';
                            select.appendChild(emptyOption);

                            checkTransactionTypesJs.forEach(type => {
                                if (type.Code !== "0" && type.Code !== "12") {
                                    const option = document.createElement('option');
                                    option.value = type.Code;
                                    option.textContent = type.Description;
                                    if (item.CekIslemTuru == type.Code) {
                                        option.selected = true;
                                    }
                                    select.appendChild(option);
                                }
                            });
                            select.disabled = item.HareketDurumu !== 'Portföyde';
                            select.addEventListener('change', async function() {
                                const newType = this.value;
                                const ibrazBelgeNo = this.dataset.ibrazBelgeNo;
                                if (newType !== "" && (ibrazBelgeNo === null || ibrazBelgeNo === "" || ibrazBelgeNo === "0")) {
                                    toastr.error('Belge ibraz olmamış, durum seçemezsiniz.');
                                    this.value = this.dataset.previousValue || '';
                                    return;
                                }
                                await updateCheckTransactionTypeByIbrazBelge(ibrazBelgeNo, newType);
                            });
                            cell.appendChild(select);
                        } else if (col.columnName === 'PlanlananTedarikci') {
                            const input = document.createElement('input');
                            input.type = 'text';
                            input.className = 'form-control form-control-sm planned-supplier-input';
                            input.setAttribute('list', `suppliersList_${item.DocEntry}`);
                            input.value = item.PlanlananTedarikci || '';
                            input.dataset.docentry = item.DocEntry;
                            input.dataset.previousValue = item.PlanlananTedarikci;
                            input.disabled = item.HareketDurumu !== 'Portföyde';

                            const datalist = document.createElement('datalist');
                            datalist.id = `suppliersList_${item.DocEntry}`;

                            input.addEventListener('input', async function() {
                                const currentText = this.value.trim();
                                if (currentText.length >= 2) {
                                    try {
                                        // Rota Güncellendi (Şirket paramı ile tedarikçi çekiliyor)
                                        const response = await fetch(`/CekAkibetiRapor37/SearchSuppliers?term=${encodeURIComponent(currentText)}${currentDbParam ? '&db=' + currentDbParam : ''}`);
                                        if (response.ok) {
                                            const suppliers = await response.json();
                                            datalist.innerHTML = '';
                                            suppliers.forEach(supplier => {
                                                const option = document.createElement('option');
                                                option.value = supplier;
                                                datalist.appendChild(option);
                                            });
                                        }
                                    } catch (error) {
                                        console.error('Tedarikçi arama hatası:', error);
                                    }
                                } else if (currentText.length === 0) {
                                    datalist.innerHTML = '';
                                }
                            });

                            input.addEventListener('focusout', async function() {
                                const docEntry = parseInt(this.dataset.docentry);
                                const newValue = this.value.trim();
                                const previousValue = this.dataset.previousValue;
                                if (newValue !== previousValue) {
                                    await updatePlannedSupplier(docEntry, newValue);
                                }
                            });

                            input.addEventListener('keydown', function(event) {
                                if (event.key === 'Enter') {
                                    event.preventDefault();
                                    this.blur();
                                }
                            });

                            cell.appendChild(input);
                            cell.appendChild(datalist);
                        } else if (col.columnName.includes('Tarihi')) {
                            cell.textContent = item[col.columnName] ? new Date(item[col.columnName]).toLocaleDateString('tr-TR') : '';
                        } else if (col.columnName === 'Tutar' || col.columnName === 'TlKarsiligi') {
                            cell.textContent = item[col.columnName]?.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) ?? '';
                            cell.style.textAlign = 'right';
                        } else {
                            // GelmeNedeni ve diğer düz metin alanları
                            cell.textContent = item[col.columnName] ?? '';
                        }

                        row.appendChild(cell);
                    });

                    frag.appendChild(row);
                });
                tableBody.appendChild(frag);
                updatePaginationInfo(data.length);
                calculateSelectedTotal();
                updateSelectAllCheckboxState();
            }

            function getInitialColumnConfig() {
                const headers = Array.from(table.querySelectorAll('thead tr:first-child th'));
                return headers.map((header, index) => ({
                    originalIndex: index,
                    newIndex: index,
                    visible: header.style.display !== 'none',
                    columnName: header.dataset.column || 'Unknown'
                }));
            }

            window.clearReportFilters = function () {
                 $('.filter-select-bs').selectpicker('val', '');

                 const quickSearchInput = document.getElementById('quickSearchInput');
                 if (quickSearchInput) {
                     quickSearchInput.value = '';
                 }

                 currentlyFilteredRows = [...allReportData];

                 currentSortColumn = 'GelmeNedeni'; // Filtre temizlenince varsayılana dön
                 currentSortDirection = 'asc';

                 document.querySelectorAll('th.sortable-column i').forEach(icon => {
                     icon.className = 'fas fa-sort float-end';
                 });
                // Varsayılan sıralama ikonunu ayarla
                const defaultSortHeader = document.querySelector('th.sortable-column[data-column="GelmeNedeni"]');
                if (defaultSortHeader) {
                    const sortIcon = defaultSortHeader.querySelector('i');
                    if (sortIcon) {
                        sortIcon.className = `fas fa-sort-up float-end`;
                    }
                }


                 renderTable(currentlyFilteredRows);

                 toastr.success('Filtreler temizlendi ve tablo yenilendi!');
            };

            function filterTableAndRender() {
                const filters = {};
                $('.filter-select-bs').each(function () {
                    const selectElement = $(this);
                    const columnKey = selectElement.closest('th').data('column');
                    const selectedValues = selectElement.val();
                    if (selectedValues && selectedValues.length > 0) {
                        filters[columnKey] = selectedValues.map(v => (v || '').toLowerCase().trim());
                    }
                });

                let filteredData = allReportData.filter(item => {
                    let isMatch = true;
                    for (const column in filters) {
                        const filterValues = filters[column];
                        const propName = columnMappings[column];
                        if (!propName) continue;

                        let itemValue = item[propName];

                        if (itemValue === null || itemValue === undefined) {
                            itemValue = '';
                        } else if (propName.includes('Tarihi')) {
                            const date = new Date(itemValue);
                            itemValue = isNaN(date.getTime()) ? '' : date.toLocaleDateString('tr-TR');
                        } else if (typeof itemValue === 'number') {
                            itemValue = itemValue.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        } else {
                            itemValue = itemValue.toString();
                        }
                        itemValue = itemValue.toLowerCase().trim();

                        if (filterValues.length > 0 && !filterValues.includes(itemValue)) {
                            isMatch = false;
                            break;
                        }
                    }
                    return isMatch;
                });

                if (currentSortColumn && currentSortDirection !== 'none') {
                    const sortType = document.querySelector(`th[data-column="${currentSortColumn}"]`)?.dataset.sortType;
                    const propName = columnMappings[currentSortColumn];
                    filteredData.sort((itemA, itemB) => {
                        let valA = itemA[propName];
                        let valB = itemB[propName];

                        if (valA === null || valA === undefined) valA = '';
                        if (valB === null || valB === undefined) valB = '';

                        let comparison = 0;
                        if (sortType === 'number') {
                            const numA = parseFloat(valA.toString().replace(/\./g, '').replace(',', '.') || 0);
                            const numB = parseFloat(valB.toString().replace(/\./g, '').replace(',', '.') || 0);
                            comparison = numA - numB;
                        } else if (sortType === 'date') {
                            const dateA = valA ? new Date(valA) : null;
                            const dateB = valB ? new Date(valB) : null;
                            if (dateA === null && dateB === null) comparison = 0;
                            else if (dateA === null) comparison = 1;
                            else if (dateB === null) comparison = -1;
                            else comparison = dateA.getTime() - dateB.getTime();
                        } else {
                            comparison = (valA || '').localeCompare((valB || ''), 'tr', { sensitivity: 'base' });
                        }
                        return currentSortDirection === 'asc' ? comparison : -comparison;
                    });
                }

                currentlyFilteredRows = filteredData;
                renderTable(currentlyFilteredRows);
            }

            // Sıralama Event'leri
            document.querySelectorAll('th.sortable-column').forEach(header => {
                header.addEventListener('click', function () {
                    const columnKey = this.dataset.column;
                    let newSortDirection;

                    if (currentSortColumn === columnKey) {
                        if (currentSortDirection === 'asc') {
                            newSortDirection = 'desc';
                        } else if (currentSortDirection === 'desc') {
                            newSortDirection = 'asc';
                        }
                    } else {
                        document.querySelectorAll('th.sortable-column i').forEach(icon => icon.className = 'fas fa-sort float-end');
                        currentSortColumn = columnKey;
                        newSortDirection = 'asc';
                    }

                    currentSortDirection = newSortDirection;

                    const sortIcon = this.querySelector('i');
                    if (sortIcon) {
                        sortIcon.className = `fas fa-sort-${currentSortDirection === 'asc' ? 'up' : 'down'} float-end`;
                    }

                    filterTableAndRender();
                });
            });

            // Filtreleme Event'leri
            document.querySelectorAll('.filter-input').forEach(input => {
                input.addEventListener('keyup', () => filterTableAndRender());
            });

            $('.filter-select-bs').selectpicker({
                liveSearch: true, actionsBox: true, selectedTextFormat: 'count > 2', width: '100%', container: 'body'
            }).on('changed.bs.select', function() {
                filterTableAndRender();
            });

            // Satır seçimi ve hesaplamalar
            $(document).on('change', '.row-selector', function () {
                $(this).closest('tr').toggleClass('selected-row', this.checked);
                calculateSelectedTotal();
                updateSelectAllCheckboxState();
                updateButtonStates();
            });

            $('#selectAllCheckbox').on('change', function () {
                const isChecked = $(this).prop('checked');
                $('#rapor2Table tbody tr:not([style*="display: none"]) .row-selector').prop('checked', isChecked).trigger('change');
            });

            function calculateSelectedTotal() {
                let totalAmount = 0;
                let selectedCount = 0;
                document.querySelectorAll('#rapor2Table tbody tr input.row-selector:checked').forEach(checkbox => {
                    const tlValue = parseFloat(checkbox.dataset.tlValue);
                    if (!isNaN(tlValue)) {
                        totalAmount += tlValue;
                        selectedCount++;
                    }
                });
                totalSelectedTlAmountSpan.textContent = totalAmount.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' TL';
                selectedCheckCountSpan.textContent = selectedCount;
            }

            function updateButtonStates() {
                const selectedRows = document.querySelectorAll('#rapor2Table tbody tr input.row-selector:checked');
                const tahsilatBtn = document.getElementById('createTahsilatBordroBtn');
                const ibrazBtn = document.getElementById('createIbrazBordroBtn');

                if (selectedRows.length > 0) {
                    tahsilatBtn.disabled = false;
                    ibrazBtn.disabled = false;
                } else {
                    tahsilatBtn.disabled = true;
                    ibrazBtn.disabled = true;
                }
            }

            function getSelectedData() {
                const selectedItems = [];
                document.querySelectorAll('#rapor2Table tbody tr input.row-selector:checked').forEach(checkbox => {
                    const row = checkbox.closest('tr');
                    const docEntry = parseInt(row.dataset.docentry);
                    const item = allReportData.find(d => d.DocEntry === docEntry);
                    if (item) {
                        selectedItems.push(item);
                    }
                });
                return selectedItems;
            }

            // AJAX Fonksiyonları (Şirket parametresi ve güvenlik token'ı ile güncellendi)
            async function updateCheckTransactionTypeByIbrazBelge(ibrazBelgeNo, newType) {
                try {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    const response = await fetch('/CekAkibetiRapor37/UpdateCheckTransactionTypeByIbrazBelge' + dbQueryString, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ IbrazBelgeNo: ibrazBelgeNo, NewCheckTransactionType: newType })
                    });

                    if (!response.ok) {
                         let errorMessage = `HTTP Hata: ${response.status} ${response.statusText}`;
                         try {
                             const errorData = await response.text();
                             if (errorData) {
                                 errorMessage = errorData;
                             }
                         } catch (e) { }
                         toastr.error(errorMessage);
                         const selectElement = tableBody.querySelector(`.check-transaction-select[data-ibraz-belge-no="${ibrazBelgeNo}"]`);
                         if (selectElement) {
                             selectElement.value = selectElement.getAttribute('data-previous-value') || '';
                         }
                         return;
                    }

                    const data = await response.json();
                    if (data.success) {
                        toastr.success(data.message);
                        const itemToUpdate = allReportData.find(item => item.IbrazBelgeNo === ibrazBelgeNo);
                        if (itemToUpdate) {
                            itemToUpdate.CekIslemTuru = newType;
                            const transactionType = checkTransactionTypesJs.find(t => t.Code == newType);
                            itemToUpdate.IslemTipiAdi = transactionType ? transactionType.Description : '';
                        }
                    } else {
                        toastr.error(data.message);
                        const selectElement = tableBody.querySelector(`.check-transaction-select[data-ibraz-belge-no="${ibrazBelgeNo}"]`);
                        if (selectElement) {
                            selectElement.value = selectElement.getAttribute('data-previous-value') || '';
                        }
                    }

                } catch (error) {
                    console.error('Çek işlem türü güncellenirken genel bir hata oluştu:', error);
                    toastr.error('Çek işlem türü güncellenirken bir hata oluştu: ' + error.message);
                    const selectElement = tableBody.querySelector(`.check-transaction-select[data-ibraz-belge-no="${ibrazBelgeNo}"]`);
                    if (selectElement) {
                        selectElement.value = selectElement.getAttribute('data-previous-value') || '';
                    }
                }
            }

            async function updatePlannedSupplier(docEntry, newSupplier) {
                try {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    const response = await fetch('/CekAkibetiRapor37/UpdatePlannedSupplier' + dbQueryString, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ DocEntry: docEntry, NewPlannedSupplier: newSupplier })
                    });

                    if (!response.ok) {
                         let errorMessage = `HTTP Hata: ${response.status} ${response.statusText}`;
                         try {
                             const errorData = await response.text();
                             if (errorData) {
                                 errorMessage = errorData;
                             }
                         } catch (e) { }
                         toastr.error(`Planlanan Tedarikçi güncelleme başarısız: ${errorMessage}`);
                         const inputElement = tableBody.querySelector(`.planned-supplier-input[data-docentry="${docEntry}"]`);
                         if (inputElement) {
                             inputElement.value = inputElement.dataset.previousValue || '';
                         }
                         return;
                    }

                    const data = await response.json();
                    if (data.success) {
                        toastr.success(data.message);
                        const itemToUpdate = allReportData.find(item => item.DocEntry === docEntry);
                        if (itemToUpdate) {
                            itemToUpdate.PlanlananTedarikci = newSupplier;
                        }
                        const inputElement = tableBody.querySelector(`.planned-supplier-input[data-docentry="${docEntry}"]`);
                        if (inputElement) {
                            inputElement.dataset.previousValue = newSupplier;
                        }
                    } else {
                        toastr.error(data.message);
                        const inputElement = tableBody.querySelector(`.planned-supplier-input[data-docentry="${docEntry}"]`);
                        if (inputElement) {
                            inputElement.value = inputElement.dataset.previousValue || '';
                        }
                    }

                } catch (error) {
                    console.error('Planlanan Tedarikçi güncellenirken genel bir hata oluştu:', error);
                    toastr.error('Planlanan Tedarikçi güncellenirken bir hata oluştu: ' + error.message);
                    const inputElement = tableBody.querySelector(`.planned-supplier-input[data-docentry="${docEntry}"]`);
                    if (inputElement) {
                        inputElement.value = inputElement.dataset.previousValue || '';
                    }
                }
            }

            async function createBordro(endpoint, data) {
                try {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    const response = await fetch(endpoint + dbQueryString, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(data)
                    });

                    if (response.ok) {
                        const blob = await response.blob();
                        const url = window.URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        const contentDisposition = response.headers.get('Content-Disposition');
                        let fileName = 'bordro.pdf';
                        if (contentDisposition) {
                            const fileNameMatch = contentDisposition.match(/filename="(.+)"/);
                            if (fileNameMatch && fileNameMatch.length > 1) {
                                fileName = fileNameMatch[1];
                            }
                        }
                        a.href = url;
                        a.download = fileName;
                        document.body.appendChild(a);
                        a.click();
                        a.remove();
                        toastr.success('Bordro başarıyla oluşturuldu ve indiriliyor.');
                    } else {
                        const errorText = await response.text();
                        toastr.error(`Bordro oluşturma hatası: ${errorText}`);
                    }
                } catch (error) {
                    console.error('Bordro oluşturma işlemi sırasında hata oluştu:', error);
                    toastr.error('Bordro oluşturulurken beklenmeyen bir hata meydana geldi.');
                }
            }

            document.getElementById('createTahsilatBordroBtn').addEventListener('click', async function () {
                const selectedRows = getSelectedData();
                if (selectedRows.length === 0) {
                    toastr.error('Lütfen bir veya daha fazla çek seçiniz.');
                    return;
                }
                await createBordro('/CekAkibetiRapor37/CreateTahsilatBordro', selectedRows.map(r => r.DocEntry));
            });

            document.getElementById('createIbrazBordroBtn').addEventListener('click', async function () {
                const selectedRows = getSelectedData();
                if (selectedRows.length === 0) {
                    toastr.error('Lütfen bir veya daha fazla çek seçiniz.');
                    return;
                }

                if (selectedRows.every(row => !row.IbrazBelgeNo)) {
                    toastr.warning('Seçili çeklerin hiçbirinin İbraz Belge Numarası bulunmuyor.');
                    return;
                }
                await createBordro('/CekAkibetiRapor37/CreateIbrazBordro', selectedRows.map(r => r.DocEntry));
            });

            // Başlangıç render'ı
            // Varsayılan sıralamayı uygula (Gelme Nedeni)
            const defaultSortHeader = document.querySelector('th.sortable-column[data-column="GelmeNedeni"]');
            if (defaultSortHeader) {
                const sortIcon = defaultSortHeader.querySelector('i');
                if (sortIcon) {
                    sortIcon.className = `fas fa-sort-up float-end`;
                }
            }
            if (currentSortColumn) {
                filterTableAndRender();
            } else {
                renderTable(allReportData);
            }
        });
    </script>
}