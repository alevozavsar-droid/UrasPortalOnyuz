@model List<WebApplication3.Models.Rapor2ViewModel>
@using WebApplication3.Models
@using System.Globalization;
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Xsrf

@{
    ViewData["Title"] = "Çek Akıbeti Raporu (Mükerrer/Vadesi Geçmiş)";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Aktif Veritabanını (Şirketi) URL veya Cookie'den merkezi olarak alıyoruz
    var currentDb = Context.Request.Query["db"].ToString();
    if (string.IsNullOrEmpty(currentDb))
    {
        currentDb = Context.Request.Cookies["SelectedDatabase"];
    }

    var checkTransactionTypes = (List<CheckTransactionType>)ViewBag.CheckTransactionTypes ?? new List<CheckTransactionType>();

    // Modeldeki veriyi JSON formatına çeviriyoruz.
    var reportDataJson = Model != null ? JsonConvert.SerializeObject(Model, new JsonSerializerSettings { DateFormatString = "yyyy-MM-dd" }) : "[]";
    var checkTransactionTypesJson = JsonConvert.SerializeObject(checkTransactionTypes);

    // Filtereleme için gerekli distinct değerler
    var distinctValues = new Dictionary<string, List<string>>();
    if (Model != null)
    {
        distinctValues["GelmeNedeni"] = Model.Where(m => !string.IsNullOrEmpty(m.GelmeNedeni)).Select(m => m.GelmeNedeni).Distinct().OrderBy(s => s).ToList(); // YENİ ALAN
        distinctValues["CekNumarasi"] = Model.Where(m => !string.IsNullOrEmpty(m.CekNumarasi)).Select(m => m.CekNumarasi).Distinct().OrderBy(s => s).ToList();
        distinctValues["CekKimdenGeldi"] = Model.Where(m => !string.IsNullOrEmpty(m.CekKimdenGeldi)).Select(m => m.CekKimdenGeldi).Distinct().OrderBy(s => s).ToList();
        distinctValues["AsilBorclu"] = Model.Where(m => !string.IsNullOrEmpty(m.AsilBorclu)).Select(m => m.AsilBorclu).Distinct().OrderBy(s => s).ToList();
        distinctValues["Tutar"] = Model.Where(m => m.Tutar.HasValue).Select(m => m.Tutar.Value).Distinct().OrderBy(v => v).Select(v => v.ToString("N2", new CultureInfo("tr-TR"))).ToList();
        distinctValues["ParaBirimi"] = Model.Where(m => !string.IsNullOrEmpty(m.ParaBirimi)).Select(m => m.ParaBirimi).Distinct().OrderBy(s => s).ToList();
        distinctValues["VadeTarihi"] = Model.Where(m => m.VadeTarihi.HasValue).Select(m => m.VadeTarihi.Value.ToString("dd.MM.yyyy")).Distinct().OrderBy(s => DateTime.Parse(s, new CultureInfo("tr-TR"))).ToList();
        distinctValues["VadeAyiVeYili"] = Model.Where(m => !string.IsNullOrEmpty(m.VadeAyiVeYili)).Select(m => m.VadeAyiVeYili).Distinct().OrderBy(s => s).ToList();
        distinctValues["PortfoyeGirisTarihi"] = Model.Where(m => m.PortfoyeGirisTarihi.HasValue).Select(m => m.PortfoyeGirisTarihi.Value.ToString("dd.MM.yyyy")).Distinct().OrderBy(s => DateTime.Parse(s, new CultureInfo("tr-TR"))).ToList();
        distinctValues["IbrazTarihi"] = Model.Where(m => m.IbrazTarihi.HasValue).Select(m => m.IbrazTarihi.Value.ToString("dd.MM.yyyy")).Distinct().OrderBy(s => DateTime.Parse(s, new CultureInfo("tr-TR"))).ToList();
        var distinctTahsilatBelgeNoList = Model.Where(m => !string.IsNullOrEmpty(m.TahsilatBelgeNo)).Select(m => m.TahsilatBelgeNo).Distinct().OrderBy(s => s).ToList(); distinctValues["IbrazBelgeNo"] = Model.Where(m => !string.IsNullOrEmpty(m.IbrazBelgeNo)).Select(m => m.IbrazBelgeNo).Distinct().OrderBy(s => s).ToList();
        distinctValues["HareketDurumu"] = Model.Where(m => !string.IsNullOrEmpty(m.HareketDurumu)).Select(m => m.HareketDurumu).Distinct().OrderBy(s => s).ToList();
        distinctValues["BelgeTipi"] = Model.Where(m => !string.IsNullOrEmpty(m.BelgeTipi)).Select(m => m.BelgeTipi).Distinct().OrderBy(s => s).ToList();
        distinctValues["CekIslemTuru"] = Model.Where(m => !string.IsNullOrEmpty(m.CekIslemTuru)).Select(m => m.CekIslemTuru).Distinct().OrderBy(s => s).ToList();
        distinctValues["IslemTipiAdi"] = Model.Where(m => !string.IsNullOrEmpty(m.IslemTipiAdi)).Select(m => m.IslemTipiAdi).Distinct().OrderBy(s => s).ToList();
        distinctValues["PlanlananTedarikci"] = Model.Where(m => !string.IsNullOrEmpty(m.PlanlananTedarikci)).Select(m => m.PlanlananTedarikci).Distinct().OrderBy(s => s).ToList();
        distinctValues["CekKimeVerildi"] = Model.Where(m => !string.IsNullOrEmpty(m.CekKimeVerildi)).Select(m => m.CekKimeVerildi).Distinct().OrderBy(s => s).ToList();
        distinctValues["TlKarsiligi"] = Model.Where(m => m.TlKarsiligi.HasValue).Select(m => m.TlKarsiligi.Value).Distinct().OrderBy(v => v).Select(v => v.ToString("N2", new CultureInfo("tr-TR"))).ToList();
    }
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/css/bootstrap-select.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <style>
        :root {
            --primary-color: #0d6efd;
            --secondary-color: #6c757d;
            --success-color: #198754;
            --danger-color: #dc3545;
            --warning-color: #ffc107;
            --info-color: #0dcaf0;
            --light-bg: #f8f9fa;
            --dark-text: black;
            --border-color: #d0d0d0;
            --header-bg: #212529;
            --header-text: #ffffff;
            --box-shadow-light: 0 0 8px rgba(0, 0, 0, 0.08);
            --box-shadow-medium: 0 2px 3px rgba(0, 0, 0, 0.06);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 12px;
            background-color: var(--light-bg);
            color: var(--dark-text);
        }

        .main-content {
            margin-top: 0 !important;
            padding-top: 0 !important;
            font-size: 1.15em;
            padding: 8px;
            background-color: #ffffff;
            border-radius: 6px;
            box-shadow: var(--box-shadow-light);
            position: relative;
        }

        .container-fluid.py-4 {
            padding-top: 5px;
            padding-bottom: 10px;
            padding-left: 5px;
            padding-right: 5px;
        }

        .database-info {
            background-color: var(--info-color);
            color: #ffffff;
            padding: 4px 8px;
            border-radius: 4px;
            margin-bottom: 6px;
            font-weight: bold;
            display: flex;
            align-items: center;
            font-size: 0.96em;
            line-height: 1.1;
        }

            .database-info .fas {
                margin-right: 4px;
            }

        .sticky-toolbar {
            position: sticky;
            top: 0;
            background-color: #ffffff;
            z-index: 1000;
            padding: 8px 12px;
            border-bottom: 1px solid var(--border-color);
            margin-top: 0px !important;
            margin-bottom: 6px;
            box-shadow: var(--box-shadow-medium);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: nowrap;
            gap: 10px;
        }

            .sticky-toolbar .total-amount-display {
                font-size: 0.96em;
                font-weight: bold;
                color: var(--primary-color);
                margin-left: 5px !important;
                margin-right: 4px !important;
                white-space: nowrap;
            }

            .sticky-toolbar .selected-check-count-display {
                font-size: 0.96em;
                font-weight: bold;
                color: var(--success-color);
                margin-left: 15px;
                white-space: nowrap;
            }

        .table-container {
            overflow-x: auto;
            position: relative;
            border-radius: 6px;
            box-shadow: var(--box-shadow-medium);
            background-color: #ffffff;
            margin-top: 6px;
            border: 1px solid var(--border-color);
        }

        .rapor-tablo {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 0.84em;
            color: var(--dark-text);
            table-layout: fixed;
            min-width: 2200px; /* Yeni sütun için genişletildi */
        }

            .rapor-tablo thead {
                position: sticky;
                top: 0;
                z-index: 101;
                background-color: #ffffff;
            }

                .rapor-tablo thead .main-header-row th {
                    background-color: var(--header-bg);
                    color: var(--header-text);
                    padding: 4px 3px;
                    text-align: center;
                    white-space: nowrap;
                    font-weight: 700;
                    border-bottom: 2px solid var(--border-color);
                    height: auto;
                    line-height: 1.3;
                }

                .rapor-tablo thead .filter-row th {
                    padding: 2px 3px;
                    height: 30px;
                    line-height: normal;
                    vertical-align: top;
                    white-space: nowrap;
                    background-color: #ffffff;
                    border-bottom: 1px solid var(--border-color);
                }

            .rapor-tablo th,
            .rapor-tablo td {
                padding: 1px;
                vertical-align: middle;
                border-right: 1px solid var(--border-color);
            }

                .rapor-tablo th:last-child,
                .rapor-tablo td:last-child {
                    border-right: none;
                }

            .rapor-tablo td {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                height: 25px;
                line-height: 25px;
                border-bottom: 1px solid var(--border-color);
            }

        .table-hover tbody tr:hover {
            background-color: var(--light-bg);
        }

        .checkbox-column {
            min-width: 28px !important;
            max-width: 28px !important;
            width: 28px !important;
            text-align: right !important;
            padding: 0 !important;
            vertical-align: middle !important;
            overflow: visible;
        }

        .filter-row th .form-control,
        .filter-row th .bootstrap-select .btn,
        .check-transaction-select,
        .planned-supplier-input {
            width: 100% !important;
            box-sizing: border-box !important;
            height: 28px !important;
            line-height: normal !important;
            padding: 2px 5px !important;
            font-size: 0.85em !important;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
        }

        /* Yeni raporun durum renkleri */
        .status-mukerrer {
            background-color: #fce5cd !important; /* Açık turuncu/şeftali */
        }

        .status-vadesi-gecmis {
            background-color: #f8d7da !important; /* Açık kırmızı/danger */
        }

        .status-mukerrer-ve-gecmis {
            background-color: #f0c4b2 !important; /* Koyu turuncu/kırmızı tonu */
        }
    </style>
}

<div class="container-fluid py-4">
    @Html.AntiForgeryToken()

    <div class="row g-0">
        <div class="col-md-12">
            <div class="main-report-box">

                <div class="sticky-toolbar">
                    <div class="d-flex align-items-center">
                        <span class="me-2 total-amount-display">Seçilen Toplam TL Tutarı:</span>
                        <strong id="totalSelectedTlAmount" class="text-primary">0,00 TL</strong>
                        <span class="ms-4 selected-check-count-display">Seçilen Çek Adedi:</span>
                        <strong id="selectedCheckCount" class="text-success">0</strong>
                    </div>
                    <div class="database-info">
                        <i class="fas fa-database"></i>
                        Veritabanı: <strong>@ViewBag.CurrentDbDisplay</strong>
                    </div>
                </div>

                <div class="row mt-2 d-flex justify-content-between align-items-center mb-2">
                    <div class="col-md-4">
                        <button id="createTahsilatBordroBtn" class="btn btn-sm btn-outline-success" disabled>
                            <i class="fas fa-file-invoice-dollar me-1"></i> Tahsilat Bordrosu Oluştur
                        </button>
                        <button id="createIbrazBordroBtn" class="btn btn-sm btn-outline-info ms-2" disabled>
                            <i class="fas fa-file-invoice me-1"></i> İbraz Bordrosu Oluştur
                        </button>
                    </div>
                    <div class="col-md-4 text-center">
                        <button class="btn btn-sm btn-secondary" onclick="window.clearReportFilters()">
                            <i class="fas fa-filter-slash me-1"></i> Filtreleri Temizle
                        </button>
                    </div>
                </div>

                <div class="table-container">
                    <table class="table table-bordered table-striped table-hover rapor-tablo" id="rapor2Table">
                        <thead>
                            <tr class="main-header-row">
                                <th class="checkbox-column no-drag" data-column="Checkbox" title="Seçim Kutusu"><input type="checkbox" id="selectAllCheckbox" class="form-check-input" /></th>

                                <th class="sortable-column" data-column="GelmeNedeni" title="Gelme Nedeni" data-sort-type="text">Gelme Nedeni <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="CekNumarasi" title="Çek No" data-sort-type="text">Çek No <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="CekKimdenGeldi" title="Çek Kimden Geldi" data-sort-type="text">Çek Kimden Geldi <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="AsilBorclu" title="Asıl Borçlu" data-sort-type="text">Asıl Borçlu <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="Tutar" title="Çek Tutarı" data-sort-type="number">Çek Tutarı <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="ParaBirimi" title="Para Birimi" data-sort-type="text">Para Birimi <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="VadeTarihi" title="Vade Tarihi" data-sort-type="date">Vade Tarihi <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="VadeAyiVeYili" title="Vade Ayı ve Yılı" data-sort-type="text">Vade Ayı ve Yılı <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="PortfoyeGirisTarihi" title="Portföye Giriş Tarihi" data-sort-type="date">Portföye Giriş Tarihi <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="IbrazTarihi" title="İbraz Tarihi" data-sort-type="date">İbraz Tarihi <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="TahsilatBelgeNo" title="Tahsilat Belge No" data-sort-type="number">Tahsilat Belge No <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="IbrazBelgeNo" title="İbraz Belge No" data-sort-type="text">İbraz Belge No <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="HareketDurumu" title="Hareket Durumu" data-sort-type="text">Hareket Durumu <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="BelgeTipi" title="Belge Tipi" data-sort-type="text">Belge Tipi <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="CekIslemTuru" title="İşlem Türü" data-sort-type="text">İşlem Türü <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="IslemTipiAdi" title="İşlem Tipi" data-sort-type="text">İşlem Tipi <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="PlanlananTedarikci" title="Planlanan Tedarikçi" data-sort-type="text">Planlanan Tedarikçi <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="CekKimeVerildi" title="Çek Kime Verildi" data-sort-type="text">Çek Kime Verildi <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="TlKarsiligi" title="TL Karşılığı" data-sort-type="number">TL Karşılığı <i class="fas fa-sort float-end"></i></th>
                            </tr>
                            <tr class="filter-row">
                                <th class="checkbox-column"></th>

                                <th data-column="GelmeNedeni">
