@{
    ViewData["Title"] = "Gemini AI Asistanı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7fc; font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #2b3445; }
        
        .dashboard-card { background: #ffffff; border-radius: 12px; border: 1px solid #eef2f7; box-shadow: 0 2px 6px rgba(0,0,0,0.03); padding: 20px; height: 100%; transition: all 0.3s ease; position: relative; overflow: hidden; }
        .hover-elevate:hover { transform: translateY(-4px); box-shadow: 0 8px 15px rgba(0,0,0,0.08); cursor: pointer; }
        
        .kpi-title { font-size: 12px; color: #64748b; font-weight: 700; text-transform: uppercase; margin-bottom: 8px; z-index: 2; position: relative; }
        .kpi-value { font-size: 16px; font-weight: 800; color: #0f172a; margin-bottom: 2px; z-index: 2; position: relative; line-height: 1.2; }
        .kpi-desc { font-size: 11px; color: #94a3b8; z-index: 2; position: relative; margin-top: 5px; }
        .kpi-icon-bg { position: absolute; right: -10px; bottom: -10px; font-size: 5rem; color: #e2e8f0; opacity: 0.4; z-index: 1; transform: rotate(-10deg); }
        
        .border-top-primary { border-top: 4px solid #3b82f6 !important; }
        .border-top-warning { border-top: 4px solid #f59e0b !important; }
        .border-top-success { border-top: 4px solid #10b981 !important; }
        .border-top-purple { border-top: 4px solid #8b5cf6 !important; }

        .chat-bubble-user { background-color: #f8fafc; border-left: 4px solid #94a3b8; padding: 15px; border-radius: 0 8px 8px 0; font-size: 14px; font-weight: 500; color: #334155; }
        .chat-bubble-ai { background-color: #f0fdf4; border-left: 4px solid #10b981; padding: 15px; border-radius: 0 8px 8px 0; font-size: 14px; color: #0f172a; white-space: pre-wrap; line-height: 1.6; }
        
        textarea.form-control:focus { border-color: #3b82f6; box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.25); }
    </style>
}

<div class="container-fluid py-4">
    
    <!-- Başlık Alanı -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-dark" style="letter-spacing: -0.5px;">Gemini Yapay Zeka Asistanı</h4>
            <span class="text-muted" style="font-size: 14px;">Google Gemini 1.5 Flash modeli ile entegre hızlı asistanınız.</span>
        </div>
        <div class="d-flex gap-3 align-items-center">
            <a href="/Gemini" class="btn btn-light rounded-pill px-4 shadow-sm fw-bold border">
                <i class="fas fa-broom me-2 text-secondary"></i> Ekranı Temizle
            </a>
        </div>
    </div>

    <!-- Hızlı Sorular (KPI Kartları Tasarımı) -->
    <div class="row mb-4 g-3">
        <div class="col-md-3">
            <div class="dashboard-card p-3 border-0 border-top-primary hover-elevate" onclick="fillPrompt('Bana şirkette çalışanları motive edecek kısa bir günaydın maili yazar mısın?')">
                <i class="fas fa-envelope-open-text kpi-icon-bg"></i>
                <div class="kpi-title text-primary">Hızlı Şablon</div>
                <div class="kpi-value">Motive Edici Mail</div>
                <div class="kpi-desc"><i class="fas fa-hand-pointer me-1"></i> Tıkla ve soruyu doldur</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="dashboard-card p-3 border-0 border-top-success hover-elevate" onclick="fillPrompt('C# .NET Core MVC mimarisinin avantajlarını 3 madde halinde özetler misin?')">
                <i class="fas fa-code kpi-icon-bg"></i>
                <div class="kpi-title text-success">Yazılım Destek</div>
                <div class="kpi-value">MVC Mimarisi Nedir?</div>
                <div class="kpi-desc"><i class="fas fa-hand-pointer me-1"></i> Tıkla ve soruyu doldur</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="dashboard-card p-3 border-0 border-top-warning hover-elevate" onclick="fillPrompt('Müşteriden gelen ödeme gecikmesi durumunda resmi ama kibar bir uyarı yazısı tasarlar mısın?')">
                <i class="fas fa-file-invoice-dollar kpi-icon-bg"></i>
                <div class="kpi-title text-warning">Finans & Cari</div>
                <div class="kpi-value">Gecikmiş Ödeme Uyarı</div>
                <div class="kpi-desc"><i class="fas fa-hand-pointer me-1"></i> Tıkla ve soruyu doldur</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="dashboard-card p-3 border-0 border-top-purple position-relative">
                <span class="badge bg-purple position-absolute top-0 end-0 mt-3 me-3 rounded-pill shadow-sm">Aktif</span>
                <i class="fas fa-microchip kpi-icon-bg"></i>
                <div class="kpi-title text-purple">Sistem Durumu</div>
                <div class="kpi-value">Bağlantı Başarılı</div>
                <div class="kpi-desc">API Servisi Çalışıyor</div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Sol Taraf: Soru Sorma Paneli -->
        <div class="col-md-5 mb-4">
            <div class="dashboard-card border-0">
                <div class="d-flex align-items-center mb-3">
                    <i class="fas fa-robot text-primary fa-2x me-2"></i>
                    <h5 class="card-title fw-bold mb-0">Soru Sor</h5>
                </div>
                
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2" style="font-size: 13px;">
                        <i class="fas fa-exclamation-triangle me-1"></i> @ViewBag.Error
                    </div>
                }

                <form method="post" asp-controller="Gemini" asp-action="Index" id="geminiForm">
                    @Html.AntiForgeryToken()
                    <div class="form-group mb-3">
                        <textarea class="form-control bg-light border-0" id="promptTextarea" name="prompt" rows="6" placeholder="Yapay zekaya sormak istediğiniz konuyu, soruyu veya kodu buraya yapıştırın... (Örn: Bana bir C# class'ı yazar mısın?)" required style="resize: none;"></textarea>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary fw-bold py-2 shadow-sm" id="btnSubmit">
                            <i class="fas fa-paper-plane me-2"></i> Gemini'ye Gönder
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Sağ Taraf: Cevap Paneli -->
        <div class="col-md-7 mb-4">
            <div class="dashboard-card border-0" style="min-height: 400px;">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="card-title fw-bold mb-0"><i class="fas fa-comments text-success me-2"></i>Sohbet Geçmişi</h5>
                    @if (ViewBag.Cevap != null)
                    {
                        <span class="badge bg-success rounded-pill px-3 py-2"><i class="fas fa-check me-1"></i> Yanıt Alındı</span>
                    }
                </div>

                @if (ViewBag.Cevap == null)
                {
                    <div class="text-center py-5 mt-4 text-muted">
                        <i class="fas fa-magic fa-4x mb-3 opacity-25"></i>
                        <h6 class="fw-bold">Henüz bir soru sormadınız.</h6>
                        <p style="font-size: 13px;">Sol taraftaki paneli kullanarak asistan ile iletişime geçebilirsiniz.</p>
                    </div>
                }
                else
                {
                    <!-- Kullanıcının Sorusu -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center mb-1">
                            <i class="fas fa-user-circle text-secondary me-2"></i>
                            <span class="fw-bold text-secondary" style="font-size: 12px;">SİZ SORDUNUZ:</span>
                        </div>
                        <div class="chat-bubble-user">
                            @ViewBag.Prompt
                        </div>
                    </div>

                    <!-- Yapay Zekanın Cevabı -->
                    <div>
                        <div class="d-flex align-items-center mb-1">
                            <i class="fas fa-robot text-success me-2"></i>
                            <span class="fw-bold text-success" style="font-size: 12px;">GEMINI AI YANITI:</span>
                        </div>
                        <div class="chat-bubble-ai shadow-sm">@ViewBag.Cevap</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Hızlı soru kartlarına tıklayınca metin alanını dolduran fonksiyon
        function fillPrompt(text) {
            var textarea = document.getElementById('promptTextarea');
            textarea.value = text;
            
            // Kullanıcıya küçük bir görsel geri bildirim verelim (opsiyonel)
            textarea.style.backgroundColor = '#e0f2fe';
            setTimeout(function() {
                textarea.style.backgroundColor = '#f8fafc';
            }, 300);
            
            textarea.focus();
        }

        // Forma submit dendiğinde butona yükleniyor efekti verelim
        document.getElementById('geminiForm').addEventListener('submit', function() {
            var btn = document.getElementById('btnSubmit');
            btn.innerHTML = '<i class="fas fa-circle-notch fa-spin me-2"></i> Yapay Zeka Düşünüyor...';
            btn.classList.add('disabled');
        });
    </script>
}