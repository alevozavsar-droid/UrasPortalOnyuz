@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sirketler = (string[])ViewBag.Sirketler;
    int yil = (int)ViewBag.Yil;
    string sekme = (string)ViewBag.Sekme ?? "liste";
    string q = Context.Request.Query.ContainsKey("_sekme") ? "?_sekme=1" : "";
    string onKod = (string)ViewBag.Kod ?? "";   // Yeni Ödeme: ön seçili tedarikçi (?kod=)
    string onNo = (string)ViewBag.No ?? "";     // Yeni Ödeme: açılacak kayıtlı ödeme (?no=ÖD-…)
}
@*
    YAPILAN ÖDEMELER — Yönetim › Özel Analizler › Özel Raporlar. Üç sekme:
      Ödeme Listesi             : tüm grup şirketlerinin ödemeleri (Banka (Havale / EFT), Çek, Nakit (Kasa), Nakit Avans) — filtreler, KPI, matrisler, detay drawer
      Şirket Bazlı Ödeme Raporu : "2026 Şirket Bazlı Ödeme Raporu" şablonu (BANKA X/R • ÇEK X/R • NAKİT X/R • aylık şirket detayı)
      Konsolide Ödeme Raporu    : "2026 Konsolide Ödeme Raporu" şablonu (ödeme türü konsolidesi • şirket konsolidesi)
    Veri: /YapilanOdemeler/Veri (Data/YapilanOdemelerOrnek.cs). Betik: wwwroot/js/yapilan-odemeler.js · Ortak stil: wwwroot/css/nakit-avans.css
    Sekme sırası ve varsayılan: Yeni Ödeme Ekle → Şirket Bazlı Ödeme Raporu (açılış) → Konsolide Ödeme Raporu → Ödeme Listesi. Derin bağlantı: /YapilanOdemeler?sekme=konsolide | liste | yeni (&kod=320.xxx | &no=ÖD-…)
    YENİ ÖDEME EKLE: Cari İşler › Tahsilat ekranının (Rapor117) ödeme yönü — aynı betik wwwroot/js/tahsilat.js (data-mod="odeme"), uçlar /Odeme/… (Controllers/OdemeController.cs : TahsilatController), kurallar Data/TahsilatOrnek.cs.
      İşlenen ödeme cari hesabına borç, Kasa Nakit Akışı'na ÖDENDİ satır ve bu listede "Ödeme Ekranı" kaynağı olur (YapilanOdemelerOrnek.OdemeEkrani); "odemeIslendi" olayı listeyi tazeler.
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<link rel="stylesheet" href="/css/cari-islem.css?v=2" />
<link rel="stylesheet" href="/css/tahsilat.css?v=3" />
<style>
    /* Yeni Ödeme Ekle sekmesi: Tahsilat ekranı kökü sayfanın içinde (iç sekmeleri ve panelleri kendi kökünde) */
    #yo #th { padding: 0; } #yo #th .na-ust { margin-bottom: 6px; } #yo #th .na-ust h4 { font-size: .95rem; }
    #yo #th.th { --na-k: #0f766e; }
    .na.yo { --na-k: #1d4ed8; }
    .yo-pill { font-size: .68rem; font-weight: 700; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 3px 10px; }
    .yo-filtre { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 6px 8px; margin-bottom: 8px; }
    .yo-filtre label { display: block; font-size: .6rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 2px; }
    .yo-filtre .form-control, .yo-filtre .form-select { font-size: .72rem; padding: 3px 7px; height: 28px; }
    .yo-filtre .ara { grid-column: span 2; }
    @@media (max-width: 1200px) { .yo-filtre { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    .yo-tur { display: inline-block; font-size: .62rem; font-weight: 700; color: #fff; border-radius: 999px; padding: 2px 8px; white-space: nowrap; }
    .yo-tur.Banka { background: #1d4ed8; } .yo-tur.Cek { background: #b45309; } .yo-tur.Kasa { background: #0f766e; } .yo-tur.Avans { background: #7c3aed; }
    .yo-xr { display: inline-block; font-size: .58rem; font-weight: 800; border: 1px solid #cbd5e1; border-radius: 4px; padding: 0 4px; margin-left: 4px; color: #334155; background: #f8fafc; vertical-align: middle; }
    #yoTablo tbody tr.tik { cursor: pointer; } #yoTablo tbody tr.tik:hover td { background: #eff6ff; }
    #yoTablo tfoot td { font-weight: 700; background: #f8fafc; border-top: 2px solid #cbd5e1; }
    #yoTablo td small, #yoMatris td small { color: #64748b; display: block; font-size: .62rem; }
    .yo-matris td.s, .yo-matris th.s { text-align: right; white-space: nowrap; }
    .yo-matris tr.toplam td { font-weight: 700; background: #f8fafc; border-top: 2px solid #cbd5e1; }
    .yo-bar { display: grid; grid-template-columns: 150px 1fr 110px; gap: 8px; align-items: center; font-size: .7rem; padding: 3px 0; border-bottom: 1px dashed #e2e8f0; }
    .yo-bar .b { height: 10px; background: #e2e8f0; border-radius: 999px; overflow: hidden; } .yo-bar .b i { display: block; height: 100%; background: var(--na-k); }
    .yo-bar .v { text-align: right; font-weight: 700; color: #0f172a; } .yo-bar .v small { color: #64748b; font-weight: 500; }
    .yo-drawer { position: fixed; top: 0; right: -760px; width: 720px; max-width: 95vw; height: 100vh; background: #fff; box-shadow: -8px 0 24px rgba(15,23,42,.18); z-index: 1060; transition: right .25s; overflow: auto; padding: 12px 14px; } .yo-drawer.acik { right: 0; }
    .yo-drawer-ust { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; position: sticky; top: 0; background: #fff; padding-bottom: 6px; border-bottom: 1px solid #e2e8f0; z-index: 2; }
    .yo-perde { position: fixed; inset: 0; background: rgba(15,23,42,.35); z-index: 1055; display: none; } .yo-perde.acik { display: block; }
    .yo-master { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px 12px; font-size: .72rem; }
    .yo-master .l { font-size: .6rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; } .yo-master .v { font-weight: 600; color: #0f172a; word-break: break-word; }
    /* --- Excel şablonu görünümü (Şirket Bazlı / Konsolide Ödeme Raporu) --- */
    .yo-rapor-ust { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; background: linear-gradient(90deg, #1e3a8a, #1d4ed8); color: #fff; border-radius: 10px; padding: 10px 14px; margin-bottom: 8px; }
    .yo-rapor-ust h5 { margin: 0; font-weight: 800; letter-spacing: .05em; font-size: .95rem; text-transform: uppercase; }
    .yo-rapor-ust .alt { font-size: .64rem; letter-spacing: .14em; opacity: .85; text-transform: uppercase; }
    .yo-rapor-ust .ayar { margin-left: auto; display: flex; gap: 6px; align-items: center; } .yo-rapor-ust .ayar select { font-size: .72rem; padding: 2px 6px; height: 26px; width: auto; } .yo-rapor-ust .ayar .btn { font-size: .66rem; }
    .yo-excel { font-size: .68rem; border-collapse: separate; border-spacing: 0; } .yo-excel th, .yo-excel td { white-space: nowrap; padding: 3px 7px; border-bottom: 1px solid #e2e8f0; }
    .yo-excel thead th { position: sticky; top: 0; background: #1e293b; color: #fff; text-transform: uppercase; font-size: .6rem; letter-spacing: .04em; text-align: right; z-index: 3; }
    .yo-excel thead th.ad { text-align: left; } .yo-excel td.s { text-align: right; font-variant-numeric: tabular-nums; }
    .yo-excel th.ad, .yo-excel td.ad { position: sticky; left: 0; background: #fff; min-width: 270px; z-index: 2; text-transform: uppercase; font-weight: 600; box-shadow: 1px 0 0 #e2e8f0; }
    .yo-excel thead th.ad { z-index: 4; background: #1e293b; }
    .yo-excel tr.grp td { background: #cbd5e1; color: #0f172a; font-weight: 800; text-transform: uppercase; letter-spacing: .03em; }
    .yo-excel tr.r td { color: #64748b; } .yo-excel tr.r td.ad { font-weight: 500; }
    .yo-excel tr.top td { font-weight: 700; background: #f1f5f9; border-top: 1px solid #94a3b8; } .yo-excel tr.top td.ad { background: #f1f5f9; }
    .yo-excel tr.genel td { font-weight: 800; background: #dbeafe; border-top: 2px solid #1d4ed8; } .yo-excel tr.genel td.ad { background: #dbeafe; }
    .yo-excel td.top { font-weight: 700; } .yo-excel td.ort { font-style: italic; color: #475569; background: #fafafa; }
    .yo-excel tr.ara td { height: 6px; padding: 0; background: #fff; border: 0; }
    .yo-not { font-size: .66rem; color: #475569; margin-top: 6px; }
</style>
}

<div class="container-fluid py-3 na yo" id="yo" data-sekme="@(q != "" ? "1" : "")" data-baslangic="@sekme" data-yil="@yil">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-money-bill-transfer"></i></span>Yapılan Ödemeler</h4>
        @* Rozetler tıklanabilir (rapor-tema.js): ilgili sekme + filtre alanına gider *@
        <span class="yo-pill" data-git="sirket|#yoRSirket" title="Şirket Bazlı Ödeme Raporu › Şirket seçimi"><i class="fas fa-building me-1"></i>Konsolide · @sirketler.Length Şirket</span>
        <span class="yo-pill" data-git="liste|#yoTur" title="Ödeme Listesi › Ödeme Türü filtresi"><i class="fas fa-layer-group me-1"></i>Banka · Çek · Nakit (Kasa) · Nakit Avans · X / R</span>
        <button type="button" class="btn btn-primary btn-sm py-0" id="yoYeniBtn" style="font-size:.7rem;margin-left:auto" title="Tedarikçiye ödeme: Tahsilat mantığıyla (ödemeyi biz yapıyoruz)"><i class="fas fa-plus me-1"></i>Yeni Ödeme Ekle</button>
        <span class="sub w-100">Grup şirketlerinin yaptığı <b>tüm ödemeler</b> tek listede: <b>Banka (Havale / EFT)</b>, <b>Çek</b> (verilen vadeli çekler), <b>Nakit (Kasa)</b> çıkışları ve <b>Nakit Avans</b> teslimleri; ERP aktarım tipi <b>X / R</b> ayrımıyla. Kaynaklar: ERP banka ve kasa hareketleri, çek bordrosu, Nakit Avans modülü, Aylık Alım Onay'daki ödenmiş tedarikçi faturaları ve bu ekranın <b>Yeni Ödeme Ekle</b> sekmesinden işlenen ödemeler. Döviz ödemeleri işlem günü kuruyla TL'ye çevrilir. <b>Şirket Bazlı</b> ve <b>Konsolide</b> sekmeleri yıllık Excel şablonlarının (12 ay + Toplam + Aylık Ort.) portal karşılığıdır.</span>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>
    @* Sekme sırası: Yeni Ödeme Ekle → Şirket Bazlı (varsayılan açılış) → Konsolide → Ödeme Listesi *@
    <div class="na-sekme" id="yoSekmeler" data-dinamik="kapali">
        <button type="button" data-p="yeni"><i class="fas fa-plus me-1"></i>Yeni Ödeme Ekle</button>
        <button type="button" data-p="sirket"><i class="fas fa-building me-1"></i>Şirket Bazlı Ödeme Raporu</button>
        <button type="button" data-p="konsolide"><i class="fas fa-layer-group me-1"></i>Konsolide Ödeme Raporu</button>
        <button type="button" data-p="liste"><i class="fas fa-list me-1"></i>Ödeme Listesi <span class="n" id="yoNListe">0</span></button>
    </div>

    @* ============================ SEKME 0: YENİ ÖDEME EKLE (Tahsilat ekranının ödeme yönü; wwwroot/js/tahsilat.js data-mod="odeme", uçlar /Odeme) ============================ *@
    <div class="na-panel" data-p="yeni">
        <div class="na ci th" id="th" data-mod="odeme" data-kod="@onKod" data-no="@onNo">
            <div class="na-ust">
                <h4><span class="rt-ikon"><i class="fas fa-money-bill-transfer"></i></span>Yeni Ödeme (Tedarikçiye)</h4>
                <span class="yo-pill"><i class="fas fa-database me-1"></i>Cari Mutabakat + Tedarikçi Kartları + Kasa Nakit Akışı + Takip Paneli</span>
                <span class="th-kur" id="thKurlar"></span>
                <span class="sub w-100">Cari İşler › Tahsilat mantığının tersi: <b>ödemeyi biz yapıyoruz</b>. Tedarikçiyi seçin; bir ödemede <b>birden çok ödeme satırı</b> (havale + nakit + çek + senet + kart) birlikte girilir; her satırın kuru o günün TCMB kurundan <b>otomatik</b> gelir, istenirse elle yazılır. Açık <b>alış faturaları</b> <b>Otomatik</b> (en eski vadeliden FIFO) ya da <b>Manuel</b> (işaretlenen faturalar, istenirse tutar sınırı) seçilir; kapanış simülasyonu her değişiklikte yenilenir: gün, vade farkı, kur farkı, tedarikçiye avans. <b>Kaydet ve İşle</b> cari hesabına borç olarak işler, satırlar <b>Kasa Nakit Akışı</b>'na ÖDENDİ olarak düşer ve <b>Ödeme Listesi</b>'nde görünür; <b>Taslak Kaydet</b> işlemez, istenen zaman "İşleme Al" ile aynı kayıttan işlenir (çek teslim edilince vb.). Ekstre ve simülasyon PDF / Excel indirilir; ödemeden önce <b>Otomatik Kapat</b> ile eşleşmemiş ödemeler kapatılır.</span>
            </div>
            <div class="na-sekme" id="thSekmeler" data-dinamik="kapali">
                <button type="button" data-p="yeni" class="aktif"><i class="fas fa-plus me-1"></i>Yeni Ödeme</button>
                <button type="button" data-p="liste"><i class="fas fa-list me-1"></i>Kayıtlı Ödemeler <span class="n" id="thNListe">0</span> <span class="n" id="thNTaslak" title="taslak">0 taslak</span></button>
            </div>

            <div class="na-panel aktif" data-p="yeni">
                <div class="row g-2">
                    <div class="col-xl-9">
                        <div class="na-kart">
                            <div class="na-kart-b"><span><i class="fas fa-truck me-1"></i>Cari (Tedarikçi)</span><span class="not" id="thCariSayi"></span></div>
                            <div class="na-kart-g">
                                <div class="d-flex gap-1 align-items-center mb-2 flex-wrap">
                                    <input class="form-control" id="thCariAra" placeholder="Kod ya da ad yazın…" style="width:240px;font-size:.78rem;height:32px" autocomplete="off">
                                    <select class="form-select" id="thCari" style="flex:1;min-width:320px;font-size:.78rem;height:32px"><option value="">Tedarikçi seçiniz…</option></select>
                                </div>
                                <div class="ci-bilgi" id="thCariOzet"><span class="text-muted">Tedarikçi seçince borç bakiyesi, son ödememiz / son alış faturası, gecikme ve açık alış faturaları burada görünür.</span></div>
                                <div class="d-flex gap-1 flex-wrap mt-1" id="thCariIslem" style="display:none !important"></div>
                            </div>
                        </div>
                        <div class="na-kart">
                            <div class="na-kart-b"><span><i class="fas fa-money-bill-transfer me-1"></i>Ödeme Satırları <span class="n" id="thNSatir">0</span></span>
                                <span class="d-flex gap-1 align-items-center flex-wrap">
                                    <span class="na-mini me-1">Ödeme Tarihi <input type="date" class="form-control d-inline-block" id="thTarih" style="width:125px;font-size:.66rem;height:22px;padding:0 4px"></span>
                                    <span class="na-mini me-1">İşlem Tipi <select class="form-select d-inline-block" id="thTip" style="width:55px;font-size:.66rem;height:22px;padding:0 16px 0 4px"><option>X</option><option>R</option></select></span>
                                    <span class="na-mini me-1">Para Birimi <select class="form-select d-inline-block" id="thPb" style="width:70px;font-size:.66rem;height:22px;padding:0 16px 0 4px"><option>TL</option></select></span>
                                    <button type="button" class="btn btn-outline-primary btn-sm py-0" data-ekle="Havale / EFT" style="font-size:.62rem"><i class="fas fa-plus me-1"></i>Havale</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm py-0" data-ekle="Nakit" style="font-size:.62rem"><i class="fas fa-plus me-1"></i>Nakit</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm py-0" data-ekle="Çek" style="font-size:.62rem"><i class="fas fa-plus me-1"></i>Çek</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm py-0" data-ekle="Senet" style="font-size:.62rem"><i class="fas fa-plus me-1"></i>Senet</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm py-0" data-ekle="Kredi Kartı" style="font-size:.62rem"><i class="fas fa-plus me-1"></i>Kart</button>
                                    <button type="button" class="btn btn-light btn-sm py-0" id="thSatirTemizle" style="font-size:.62rem">Satırları Sil</button>
                                </span></div>
                            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="thSatirlar" data-dinamik="kapali"><thead><tr><th class="s">#</th><th>Yöntem</th><th>Tarih / Vade</th><th>Belge (Çek) No</th><th>Banka</th><th class="e">Kur</th><th class="s">Kur Kaynağı</th><th class="e">Tutar</th><th class="e">TL Karşılığı</th><th>Not</th><th></th></tr></thead><tbody><tr><td colspan="11" class="na-bos">Yukarıdaki düğmelerle ödeme satırı ekleyin (havale, nakit, çek, senet, kart — birlikte).</td></tr></tbody><tfoot></tfoot></table></div>
                                <div class="na-mini px-2 pb-1"><input class="form-control d-inline-block" id="thAciklama" placeholder="Açıklama (dekont no, not…)" style="width:100%;font-size:.66rem;height:22px"></div></div>
                        </div>
                        <div class="na-kart">
                            <div class="na-kart-b"><span><i class="fas fa-list-check me-1"></i>Açık Alış Faturaları ve Kapanış Simülasyonu (FIFO) <span class="n" id="thNFat">0</span></span>
                                <span class="d-flex gap-1 align-items-center">
                                    <span class="ci-mod" id="thMod"><button type="button" class="aktif" data-mod="Otomatik" title="Ödemeler tüm açık alış faturalarına en eski vadeliden başlayarak otomatik dağıtılır"><i class="fas fa-wand-magic-sparkles me-1"></i>Otomatik (FIFO)</button><button type="button" data-mod="Manuel" title="Ödenecek faturalar işaretlenir; istenirse faturaya tutar sınırı yazılır"><i class="fas fa-hand-pointer me-1"></i>Manuel Seçim</button></span>
                                    <button type="button" class="btn btn-light btn-sm py-0" id="thHepsi" style="font-size:.62rem"><i class="fas fa-check-double me-1"></i>Tümünü Seç</button><button type="button" class="btn btn-light btn-sm py-0" id="thHicbiri" style="font-size:.62rem">Kaldır</button>
                                    <button type="button" class="btn btn-light btn-sm py-0" id="thTutarDoldur" style="font-size:.62rem" title="Seçili faturaların kalanı kadar tek havale satırı oluşturur"><i class="fas fa-equals me-1"></i>Tutarı Faturalardan Al</button>
                                </span></div>
                            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="thFaturalar" data-dinamik="kapali"><thead><tr><th class="s"><input type="checkbox" id="thFatHepsi"></th><th>Belge No</th><th>Tarih</th><th>Vade</th><th class="s">Gecikme</th><th class="s">Tip</th><th class="e">Kalan</th><th class="e">Fatura Kuru</th><th class="e">Sınır (Manuel)</th><th class="e">Kapanan</th><th class="e">Kalan (Sonra)</th><th>Ödeme</th><th class="s">Gün</th><th class="e">Kur Farkı (₺)</th><th class="e">Vade Farkı (₺)</th></tr></thead><tbody><tr><td colspan="15" class="na-bos">Önce tedarikçi seçin.</td></tr></tbody><tfoot></tfoot></table></div></div>
                        </div>
                    </div>
                    <div class="col-xl-3">
                        <div class="na-kart th-sag">
                            <div class="na-kart-b"><span><i class="fas fa-calculator me-1"></i>Hesap Özeti</span><span class="not" id="thOzetNot">otomatik</span></div>
                            <div class="na-kart-g">
                                <div class="ci-ozet" id="thOzet"></div>
                                <div class="d-grid gap-1 mt-2">
                                    <button type="button" class="btn btn-primary btn-sm" id="thKaydetIsle" title="Cari hesabına borç işlenir; satırlar Kasa Nakit Akışı'na ÖDENDİ düşer"><i class="fas fa-floppy-disk me-1"></i>Kaydet ve İşle</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm" id="thKaydetTaslak" title="Cariye işlenmez; Kayıtlı Ödemeler sekmesinden İşleme Al"><i class="fas fa-file-pen me-1"></i>Taslak Kaydet (İşleme Alma)</button>
                                    <div class="d-flex gap-1"><button type="button" class="btn btn-light btn-sm flex-fill" id="thSimPdf"><i class="fas fa-file-pdf me-1"></i>Simülasyon PDF</button><button type="button" class="btn btn-light btn-sm flex-fill" id="thSimExcel"><i class="fas fa-file-excel me-1"></i>Simülasyon Excel</button></div>
                                    <button type="button" class="btn btn-light btn-sm" id="thYeni"><i class="fas fa-file me-1"></i>Yeni Ödeme</button>
                                </div>
                                <div class="ci-rehber" id="thRehber"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="na-panel" data-p="liste">
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-clock-rotate-left me-1"></i>Kayıtlı Ödemeler (Taslak / İşlendi)</span><span class="d-flex gap-1 align-items-center"><input class="form-control" id="thListeAra" placeholder="No, tedarikçi, yöntem, çek no…" style="width:200px;font-size:.66rem;height:24px"><select class="form-select" id="thListeDurum" style="width:auto;font-size:.66rem;height:24px;padding:0 20px 0 6px"><option value="">Tüm Durumlar</option><option>Taslak</option><option>İşlendi</option></select><button type="button" class="btn btn-light btn-sm py-0" id="thListeExcel" style="font-size:.66rem"><i class="fas fa-file-excel me-1"></i>Excel</button></span></div>
                    <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="thListe" data-dinamik="kapali"><thead><tr><th>Ödeme No</th><th>Tarih</th><th>Tedarikçi</th><th>Yöntem</th><th class="s">Tip</th><th class="e">Tutar</th><th class="e">TL</th><th class="s">Mod</th><th>Durum</th><th class="s">Fatura</th><th class="e">Avans</th><th class="e">Kur Farkı</th><th class="e">Vade Farkı</th><th>Nakit Akış</th><th>Kim</th><th></th></tr></thead><tbody></tbody></table></div></div></div>
                <div id="thDetay"></div>
            </div>
        </div>
    </div>

    @* ============================ SEKME 1: ÖDEME LİSTESİ ============================ *@
    <div class="na-panel" data-p="liste">
        <div class="na-kpi" id="yoKpi" data-dinamik="kapali"></div>
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-filter me-1"></i>Filtreler</span><span class="d-flex gap-1"><button type="button" class="btn btn-light btn-sm py-0" id="yoTemizle" style="font-size:.66rem">Temizle</button><button type="button" class="btn btn-light btn-sm py-0" id="yoExcel" style="font-size:.66rem"><i class="fas fa-file-excel me-1"></i>Excel</button><button type="button" class="btn btn-light btn-sm py-0" id="yoMatrisExcel" style="font-size:.66rem"><i class="fas fa-file-excel me-1"></i>Şirket Özeti Excel</button></span></div>
            <div class="na-kart-g">
                <div class="yo-filtre">
                    <div class="ara"><label>Ara</label><input class="form-control" id="yoAra" placeholder="Ödeme no, alıcı, belge, açıklama, hesap…"></div>
                    <div><label>Dönem</label><select class="form-select" id="yoDonem"><option value="buay">Bu Ay</option><option value="gecenay">Geçen Ay</option><option value="30">Son 30 Gün</option><option value="90" selected>Son 90 Gün</option><option value="yil">Bu Yıl</option><option value="">Tümü</option><option value="ozel">Özel Aralık</option></select></div>
                    <div><label>Başlangıç</label><input class="form-control" type="date" id="yoBas"></div>
                    <div><label>Bitiş</label><input class="form-control" type="date" id="yoBit"></div>
                    <div><label>Şirket</label><select class="form-select" id="yoSirket"><option value="">Tümü</option>@foreach (var s in sirketler) { <option>@s</option> }</select></div>
                    <div><label>Ödeme Türü</label><select class="form-select" id="yoTur"><option value="">Tümü</option></select></div>
                    <div><label>X / R</label><select class="form-select" id="yoXr"><option value="">Tümü</option></select></div>
                    <div><label>Kategori</label><select class="form-select" id="yoKategori"><option value="">Tümü</option></select></div>
                    <div><label>Alıcı Tipi</label><select class="form-select" id="yoAliciTipi"><option value="">Tümü</option></select></div>
                    <div><label>Para Birimi</label><select class="form-select" id="yoPb"><option value="">Tümü</option></select></div>
                    <div><label>Durum</label><select class="form-select" id="yoDurum"><option value="">Tümü</option></select></div>
                    <div><label>Kaynak</label><select class="form-select" id="yoKaynak"><option value="">Tümü</option></select></div>
                </div>
                <div class="na-mini" id="yoSayi"></div>
                <div class="table-responsive" style="max-height:560px">
                    <table class="na-tablo" id="yoTablo" data-dinamik="kapali">
                        <thead><tr><th>Tarih</th><th>Ödeme No · X / R</th><th>Şirket</th><th>Ödeme Türü</th><th>Kaynak Hesap</th><th>Alıcı</th><th>Kategori</th><th>Belge</th><th class="s">Tutar</th><th>PB</th><th class="s">Tutar (TL)</th><th>Vade</th><th>Durum</th><th>Kaynak</th></tr></thead>
                        <tbody></tbody>
                        <tfoot><tr><td colspan="8">Toplam (filtre)</td><td class="s" id="yoTopSayi"></td><td></td><td class="s" id="yoTopTl"></td><td colspan="3"></td></tr></tfoot>
                    </table>
                </div>
            </div>
        </div>
        <div class="row g-2">
            <div class="col-lg-7">
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-table-cells me-1"></i>Şirket × Ödeme Türü (TL)</span><span class="not">Filtreye göre · konsolide toplam son satırda</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo yo-matris" id="yoMatris" data-dinamik="kapali"><thead><tr><th>Şirket</th><th class="s">Banka (Havale / EFT)</th><th class="s">Çek</th><th class="s">Nakit (Kasa)</th><th class="s">Nakit Avans</th><th class="s">Toplam</th><th class="s">İşlem</th></tr></thead><tbody></tbody></table></div></div></div>
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-calendar-days me-1"></i>Aylık Ödeme Toplamı (TL)</span><span class="not">Filtreye göre · ay bazında</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo yo-matris" id="yoAylik" data-dinamik="kapali"><thead><tr><th>Ay</th><th class="s">Banka (Havale / EFT)</th><th class="s">Çek</th><th class="s">Nakit (Kasa)</th><th class="s">Nakit Avans</th><th class="s">Toplam</th><th class="s">İşlem</th></tr></thead><tbody></tbody></table></div></div></div>
            </div>
            <div class="col-lg-5">
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-chart-bar me-1"></i>Kategori Dağılımı</span><span class="not">Filtreye göre · TL</span></div><div class="na-kart-g" id="yoKategoriler"></div></div>
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-ranking-star me-1"></i>En Büyük 10 Alıcı</span><span class="not">Filtreye göre · TL</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo" id="yoAlicilar" data-dinamik="kapali"><thead><tr><th>#</th><th>Alıcı</th><th>Tip</th><th class="s">İşlem</th><th class="s">Toplam (TL)</th></tr></thead><tbody></tbody></table></div></div></div>
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-circle-info me-1"></i>Kaynaklar ve Kurallar</span></div><div class="na-kart-g" style="font-size:.7rem;color:#475569"><ul class="mb-0 ps-3"><li><b>Banka (Havale / EFT):</b> ERP banka hareketleri — maaş, vergi / SGK, kira, kredi taksiti, enerji ve hizmet, tedarikçi, ithalat (USD / EUR) ve grup içi ödemeler. Şablon gereği banka ödemesi yalnız tanımlı şirketlerde izlenir; diğer şirketler çek ve nakit ile öder.</li><li><b>Çek:</b> Çek bordrosu — tedarikçilere verilen vadeli çekler; vadesi gelen çek "Ödendi", gelmeyen "Vade Bekliyor" (verildiği ayın ödemesi sayılır).</li><li><b>Nakit (Kasa):</b> ERP kasa çıkış fişleri; iptal edilen fişler "İptal" olarak listelenir, toplama girmez.</li><li><b>Nakit Avans:</b> Nakit Avans modülündeki teslimler; şablon raporlarında "Nakit" satırlarına dahildir.</li><li><b>X / R:</b> ERP aktarım tipi; şablon raporları her ödeme türünü X ve R olarak ayrı satırlarda gösterir.</li><li><b>Tedarikçi faturaları:</b> Aylık Alım Onay ekranında "Ödendi" olan faturalar banka ya da çek ödemesi olarak yer alır.</li></ul></div></div>
            </div>
        </div>
    </div>

    @* ============================ SEKME 2: ŞİRKET BAZLI ÖDEME RAPORU ============================ *@
    <div class="na-panel" data-p="sirket">
        <div class="yo-rapor-ust">
            <div><h5><span id="yoSirketYilBaslik">@yil</span> Şirket Bazlı Ödeme Raporu</h5><div class="alt">Banka X/R • Çek X/R • Nakit X/R • Aylık Şirket Detayı</div></div>
            <div class="ayar"><label class="me-1" style="font-size:.66rem;font-weight:700">Yıl</label><select class="form-select" id="yoRYil"></select><label class="ms-2 me-1" style="font-size:.66rem;font-weight:700">Şirket</label><select class="form-select" id="yoRSirket"><option value="">Tümü</option></select><button type="button" class="btn btn-light btn-sm py-0" id="yoRExcel"><i class="fas fa-file-excel me-1"></i>Excel</button></div>
        </div>
        <div class="na-kart"><div class="na-kart-g p-0"><div class="table-responsive" style="max-height:72vh"><table class="na-tablo yo-excel" id="yoSirketTablo" data-dinamik="kapali"><thead><tr><th class="ad">Açıklama</th><th>Ocak</th><th>Şubat</th><th>Mart</th><th>Nisan</th><th>Mayıs</th><th>Haziran</th><th>Temmuz</th><th>Ağustos</th><th>Eylül</th><th>Ekim</th><th>Kasım</th><th>Aralık</th><th class="yil">Toplam @yil</th><th>Aylık Ort.</th></tr></thead><tbody></tbody></table></div></div></div>
        <div class="yo-not" id="yoSirketNot"></div>
        <div class="yo-not">Şirket bazında ödeme kanalı ve X / R ayrımı aylık olarak izlenir. Banka satırları yalnızca tanımlı şirketlerde gösterilir (<span id="yoBankaSirketleri"></span>). Nakit satırları kasa çıkışları ile nakit avans teslimlerini kapsar; iptal edilen fişler dahil değildir. Tutarlar TL, döviz ödemeleri işlem günü kuruyla çevrilmiştir.</div>
    </div>

    @* ============================ SEKME 3: KONSOLİDE ÖDEME RAPORU ============================ *@
    <div class="na-panel" data-p="konsolide">
        <div class="yo-rapor-ust">
            <div><h5><span id="yoKonsYilBaslik">@yil</span> Konsolide Ödeme Raporu</h5><div class="alt">Ödeme Türü Konsolidesi • Şirket Konsolidesi</div></div>
            <div class="ayar"><label class="me-1" style="font-size:.66rem;font-weight:700">Yıl</label><select class="form-select" id="yoKYil"></select><button type="button" class="btn btn-light btn-sm py-0" id="yoKExcel"><i class="fas fa-file-excel me-1"></i>Excel</button></div>
        </div>
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-layer-group me-1"></i>Ödeme Türü Konsolidesi</span><span class="not">Banka / Çek / Nakit × X / R · tüm şirketler</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo yo-excel" id="yoTurKons" data-dinamik="kapali"><thead><tr><th class="ad">Açıklama</th><th>Ocak</th><th>Şubat</th><th>Mart</th><th>Nisan</th><th>Mayıs</th><th>Haziran</th><th>Temmuz</th><th>Ağustos</th><th>Eylül</th><th>Ekim</th><th>Kasım</th><th>Aralık</th><th class="yil">Toplam @yil</th><th>Aylık Ort.</th></tr></thead><tbody></tbody></table></div></div></div>
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-building me-1"></i>Şirket Konsolidesi</span><span class="not">Şirketlerin toplam ödemeleri · aylık</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo yo-excel" id="yoSirketKons" data-dinamik="kapali"><thead><tr><th class="ad">Açıklama</th><th>Ocak</th><th>Şubat</th><th>Mart</th><th>Nisan</th><th>Mayıs</th><th>Haziran</th><th>Temmuz</th><th>Ağustos</th><th>Eylül</th><th>Ekim</th><th>Kasım</th><th>Aralık</th><th class="yil">Toplam @yil</th><th>Aylık Ort.</th></tr></thead><tbody></tbody></table></div></div></div>
        <div class="yo-not" id="yoKonsNot"></div>
        <div class="yo-not">Üst tablo ödeme türlerini X / R bazında, alt tablo şirketlerin toplam ödemelerini aylık konsolide olarak gösterir. Nakit = kasa çıkışları + nakit avans teslimleri; iptal edilen fişler dahil değildir.</div>
    </div>

    <div class="yo-perde" id="yoPerde"></div>
    <div class="yo-drawer" id="yoDrawer">
        <div class="yo-drawer-ust"><b id="yoDrawerBaslik" style="font-size:.9rem"></b><span class="ms-auto d-flex gap-1" id="yoDrawerAksiyon"></span><button type="button" class="btn btn-light btn-sm py-0" id="yoDrawerKapat" style="font-size:.66rem"><i class="fas fa-xmark"></i></button></div>
        <div id="yoDrawerIc"></div>
    </div>
</div>

@section Scripts {
<script src="/js/yapilan-odemeler.js?v=3"></script>
<script src="/js/tahsilat.js?v=6"></script>
}
