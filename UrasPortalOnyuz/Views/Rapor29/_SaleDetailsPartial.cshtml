@model List<WebApplication3.Models.SaleDetailsViewModel>

<style>
    /* MODALI EKRANA TAM YAYMA (Sağa kaydırmayı engeller) */
    #saleDetailsModal .modal-dialog {
        max-width: 96vw !important; 
    }

    /* Modal İçi Özel Tablo Tasarımı */
    .modal-table-container {
        border-radius: 8px;
        border: 1px solid #dbe2e8;
        background: #ffffff;
    }

    .modal-tablo {
        width: 100%;
        margin-bottom: 0;
        table-layout: auto;
        border-collapse: collapse;
    }

    .modal-tablo th,
    .modal-tablo td {
        padding: 8px 6px;
        vertical-align: middle;
        border-bottom: 1px solid #dbe2e8;
        border-right: 1px solid #e2e8f0;
        white-space: nowrap;
        color: #334155;
        font-size: 11.5px;
    }

    .modal-tablo th:last-child,
    .modal-tablo td:last-child {
        border-right: none;
    }

    .modal-tablo td.desc-col {
        white-space: normal;
        min-width: 180px;
    }

    .modal-tablo thead th {
        background-color: #f1f5f9;
        color: #1e293b;
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
        border-bottom: 2px solid #cbd5e1;
    }

    .modal-tablo tfoot th {
        background-color: #f8fafc;
        color: #0f172a;
        font-weight: 700;
        font-size: 12px;
        border-top: 2px solid #94a3b8;
        border-bottom: none;
        padding: 10px 6px;
    }

    .modal-tablo tbody tr:hover { background-color: #e2e8f0; }
    
    .modal-row-zarar { background-color: #fff5f5 !important; }
    .modal-row-kar { background-color: #f0fdf4 !important; }
    .modal-row-uyari { background-color: #fffbeb !important; }

    .modal-badge {
        padding: 3px 6px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 10.5px;
        display: inline-block;
        text-align: center;
        min-width: 65px;
        border: 1px solid transparent;
    }
    .m-badge-zarar { background-color: #fee2e2; color: #b91c1c; border-color: #fca5a5; }
    .m-badge-kar { background-color: #dcfce7; color: #15803d; border-color: #86efac; }
    .m-badge-uyari { background-color: #fef3c7; color: #b45309; border-color: #fcd34d; }

    .modal-num { font-family: 'Inter', monospace; font-weight: 500; text-align: right; }
    .muted-unit { color: #94a3b8; font-size: 10px; margin-left: 2px; }

    .clickable-purchase { color: #0d6efd; cursor: pointer; font-weight: 600; text-decoration: underline transparent; transition: all 0.2s;}
    .clickable-purchase:hover { color: #0a58ca; text-decoration: underline #0a58ca; }
</style>

<div class="table-responsive modal-table-container" style="max-height: 70vh; overflow-y: auto; overflow-x: hidden;">
    @if (Model != null && Model.Any())
    {
        <table class="table modal-tablo">
            <thead style="position: sticky; top: 0; z-index: 1020;">
                <tr>
                    <th>Malzeme Kodu</th>
                    <th>Malzeme Açıklaması</th>
                    <th class="text-end">Miktar</th>
                    <th class="text-end">Fiyat (PB)</th>
                    <th class="text-end">Fiyat (TL)</th>
                    <th class="text-end">Fiyat (USD)</th>
                    <th class="text-end">Tutar (TL)</th>
                    <th class="text-end">Tutar (USD)</th>
                    
                    <th class="text-center" title="Son Alış Faturası Tarihi">Son Alış Tarihi</th>
                    <th class="text-center" title="Son Alış Faturası Numarası">Alış Fatura No</th>

                    <th class="text-end">Son Alış (PB)</th>
                    <th class="text-end">Alış (TL)</th>
                    <th class="text-end">Alış (USD)</th>
                    <th class="text-end">Kar/Zarar (TL)</th>
                    <th class="text-end">Kar/Zarar (USD)</th>
                    <th class="text-end">K/Z (%) (TL)</th>
                    <th class="text-end">K/Z (%) (USD)</th>
                    <th class="text-center">Durum</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string rowClass = "";
                    string badgeClass = "m-badge-uyari";

                    if (item.Durum == "Kar") { rowClass = "modal-row-kar"; badgeClass = "m-badge-kar"; }
                    else if (item.Durum == "Zarar") { rowClass = "modal-row-zarar"; badgeClass = "m-badge-zarar"; }
                    else if (item.Durum == "Maliyet Yok" || item.Durum == "Başa Baş") { rowClass = "modal-row-uyari"; badgeClass = "m-badge-uyari"; }

                    <tr class="@rowClass">
                        <td><strong>@item.MalzemeKodu</strong></td>
                        <td class="desc-col" title="@item.MalzemeAciklamasi">@item.MalzemeAciklamasi</td>
                        
                        <!-- Miktar (decimal) -->
                        <td class="modal-num">@item.Miktar.ToString("N2")</td>
                        
                        <!-- SatisFiyatiPB (decimal) -->
                        <td class="modal-num">@item.SatisFiyatiPB.ToString("N2") <span class="muted-unit">@item.SatisParaBirimi</span></td>
                        
                        <!-- SatisFiyatiTL (decimal?) -->
                        <td class="modal-num">@(item.SatisFiyatiTL.HasValue ? item.SatisFiyatiTL.Value.ToString("N2") : "-") <span class="muted-unit">TL</span></td>
                        
                        <!-- SatisFiyatiUSD (decimal?) -->
                        <td class="modal-num">@(item.SatisFiyatiUSD.HasValue ? item.SatisFiyatiUSD.Value.ToString("N2") : "-") <span class="muted-unit">USD</span></td>
                        
                        <!-- SatisTutariTL (decimal?) -->
                        <td class="modal-num fw-bold">@(item.SatisTutariTL.HasValue ? item.SatisTutariTL.Value.ToString("N2") : "-") <span class="muted-unit">TL</span></td>
                        
                        <!-- SatisTutariUSD (decimal?) -->
                        <td class="modal-num fw-bold">@(item.SatisTutariUSD.HasValue ? item.SatisTutariUSD.Value.ToString("N2") : "-") <span class="muted-unit">USD</span></td>
                        
                        <!-- SonSatinAlmaTarihi (DateTime?) -->
                        <td class="text-center">@(item.SonSatinAlmaTarihi.HasValue ? item.SonSatinAlmaTarihi.Value.ToString("dd.MM.yyyy") : "-")</td>
                        
                        <!-- SonSatinAlmaBelgeNo (string) -->
                        <td class="text-center">
                            @if(!string.IsNullOrEmpty(item.SonSatinAlmaBelgeNo))
                            {
                                <span class="clickable-purchase" data-docnum="@item.SonSatinAlmaBelgeNo" onclick="showPurchaseDetails('@item.SonSatinAlmaBelgeNo')" title="Alış fatura detayını görmek için tıklayın">
                                    @item.SonSatinAlmaBelgeNo
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>

                        <!-- SonSatinAlmaFiyati (decimal?) -->
                        <td class="modal-num">@(item.SonSatinAlmaFiyati.HasValue ? item.SonSatinAlmaFiyati.Value.ToString("N2") : "-") <span class="muted-unit">@item.SonSatinAlmaParaBirimi</span></td>
                        
                        <!-- AlisFiyatiTL (decimal?) -->
                        <td class="modal-num">@(item.AlisFiyatiTL.HasValue ? item.AlisFiyatiTL.Value.ToString("N2") : "-") <span class="muted-unit">TL</span></td>
                        
                        <!-- AlisFiyatiUSD (decimal?) -->
                        <td class="modal-num">@(item.AlisFiyatiUSD.HasValue ? item.AlisFiyatiUSD.Value.ToString("N2") : "-") <span class="muted-unit">USD</span></td>
                        
                        <!-- ToplamKarZarar (decimal?) -->
                        <td class="modal-num" style="color: @(item.ToplamKarZarar.GetValueOrDefault() < 0 ? "#dc3545" : (item.ToplamKarZarar.GetValueOrDefault() > 0 ? "#198754" : "inherit")); font-weight: 700;">
                            @(item.ToplamKarZarar.HasValue ? item.ToplamKarZarar.Value.ToString("N2") : "-") <span class="muted-unit">TL</span>
                        </td>
                        
                        <!-- ToplamKarZararUSD (decimal?) -->
                        <td class="modal-num" style="color: @(item.ToplamKarZararUSD.GetValueOrDefault() < 0 ? "#dc3545" : (item.ToplamKarZararUSD.GetValueOrDefault() > 0 ? "#198754" : "inherit")); font-weight: 700;">
                            @(item.ToplamKarZararUSD.HasValue ? item.ToplamKarZararUSD.Value.ToString("N2") : "-") <span class="muted-unit">USD</span>
                        </td>

                        <!-- KarZararYuzdesi (decimal?) -->
                        <td class="modal-num">@(item.KarZararYuzdesi.HasValue ? item.KarZararYuzdesi.Value.ToString("N2") : "-") %</td>
                        
                        <!-- KarZararYuzdesiUSD (decimal?) -->
                        <td class="modal-num">@(item.KarZararYuzdesiUSD.HasValue ? item.KarZararYuzdesiUSD.Value.ToString("N2") : "-") %</td>
                        
                        <td class="text-center">
                            <span class="modal-badge @badgeClass">@item.Durum</span>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="6" class="text-end text-muted">Genel Toplamlar (TL):</th>
                    <th class="modal-num" style="color: var(--primary-color);">@((Model.Sum(m => m.SatisTutariTL ?? 0)).ToString("N2")) TL</th>
                    <th></th> <th></th> <th></th> <th></th> 
                    <th class="modal-num text-danger">@((Model.Sum(m => m.AlisFiyatiTL ?? 0)).ToString("N2")) TL</th>
                    <th></th>
                    @{
                        var t_kz_tl = Model.Sum(m => m.ToplamKarZarar ?? 0);
                        string tlColor = t_kz_tl < 0 ? "text-danger" : "text-success";
                    }
                    <th class="modal-num @tlColor">@t_kz_tl.ToString("N2") TL</th>
                    <th></th> <th></th> <th></th> <th></th>
                </tr>
                
                <tr>
                    <th colspan="6" class="text-end text-muted">Genel Toplamlar (USD):</th>
                    <th></th>
                    <th class="modal-num" style="color: var(--primary-color);">@((Model.Sum(m => m.SatisTutariUSD ?? 0)).ToString("N2")) USD</th>
                    <th></th> <th></th> <th></th> <th></th>
                    <th class="modal-num text-danger">@((Model.Sum(m => m.AlisFiyatiUSD ?? 0)).ToString("N2")) USD</th>
                    <th></th>
                    @{
                        var t_kz_usd = Model.Sum(m => m.ToplamKarZararUSD ?? 0);
                        string usdColor = t_kz_usd < 0 ? "text-danger" : "text-success";
                    }
                    <th class="modal-num @usdColor">@t_kz_usd.ToString("N2") USD</th>
                    <th></th> <th></th> <th></th>
                </tr>
            </tfoot>
        </table>
    }
    else
    {
        <div class="text-center py-5 text-muted" style="background-color: #f8fafc; border-radius: 8px;">
            <i class="fas fa-box-open fa-3x mb-3" style="color: #cbd5e1;"></i>
            <h5>Bu fatura için detaylı veri bulunamadı.</h5>
            <p class="mb-0">Seçtiğiniz belge numarasına ait malzeme kalemi kaydedilmemiş olabilir.</p>
        </div>
    }
</div>