    #kn .na-sekme .kn-sekme-islem .btn.kn-yeni-ac, #kn .na-sekme .kn-sekme-islem .btn.kn-talimat-olustur.secili { background: var(--kn-lacivert); border-color: var(--kn-lacivert); color: #fff; } #kn .na-sekme .kn-sekme-islem .btn.kn-yeni-ac:hover { background: #172554; color: #fff; }
