    #kn .na-kart-b .btn:hover { border-color: var(--kn-lacivert) !important; background: #eff6ff !important; color: var(--kn-lacivert) !important; } #kn .na-kart-b .btn.kn-yeni-ac:hover { background: #172554 !important; color: #fff !important; }
    #kn .na-kart-b > span > i, #kn .na-kart-b > span:first-child i { color: var(--kn-lacivert); }
    /* --- üst kartlar: hepsi lacivert çizgi; yalnız uyarı kartları renkli (Geciken · Mükerrer kırmızı, Onay Bekleyen sarı) --- */
    #kn .na-kpi > div { --k: #1e3a8a !important; } #kn .na-kpi > div[data-kpi="geciken"], #kn .na-kpi > div[data-kpi="mukerrer"] { --k: #b91c1c !important; } #kn .na-kpi > div[data-kpi="onay"] { --k: #d97706 !important; }
    #kn .kn-grup > div { --k: #1e3a8a !important; }
    #kn .kn-odeme tr.toplam td { border-top-color: var(--kn-lacivert); }
    #kn .kn-odeme thead th.sira.art, #kn .kn-odeme thead th.sira.azl, #kn .kn-odeme thead th.sira:hover { color: var(--kn-lacivert); }
    /* Özet sekmesi: kutucuklar 5'li iki sıra ve daha okunaklı; dağılım tabloları sade */
    #kn .na-kpi.kn-ozet-kpi { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; margin-bottom: 0; }
    #kn .na-kpi.kn-ozet-kpi > div { padding: 9px 12px; } #kn .na-kpi.kn-ozet-kpi .l { font-size: .62rem; } #kn .na-kpi.kn-ozet-kpi .v { font-size: 1.15rem; } #kn .na-kpi.kn-ozet-kpi .s { font-size: .66rem; }
    #kn .kn-ozet-tablo { table-layout: auto; font-size: .74rem; } #kn .kn-ozet-tablo td { padding: 6px 8px; white-space: nowrap; } #kn .kn-ozet-tablo tr.tik:hover td { background: #eff6ff; } #kn .kn-ozet-tablo tr.toplam td { font-weight: 800; background: #f8fafc; border-top: 2px solid var(--kn-lacivert); }
    .kn-kpi-filtre { display: inline-flex; align-items: center; gap: 5px; font-size: .62rem; font-weight: 700; text-transform: none; letter-spacing: 0; color: #92400e; background: #fffbeb; border: 1px solid #fde68a; border-radius: 6px; padding: 1px 8px; cursor: pointer; text-decoration: none; } .kn-kpi-filtre:hover { background: #fef3c7; color: #92400e; }
    /* ===== 13 Kas 2026 — DİKEY YER KAZANIMI ("sayfanın yarısını kullanamıyoruz, daha verimli kullan"): üst şerit, filtre, sekme şeridi ve tablo başlığı sıkıştırıldı; kart başlığı satırı kalktı
       (işlem düğmeleri sekme şeridinin sağında); filtre etiketleri kutuların solunda; satır dolguları yarıya indi → tablo sayfanın çok daha üstünden başlar ve ekrana daha çok satır sığar ===== */
    #kn.container-fluid { padding-top: 4px !important; padding-bottom: 4px !important; }
    #kn .kn-ust { padding: 5px 10px; margin-bottom: 4px; } #kn .kn-ust-satir { gap: 4px 6px; } #kn .kn-ust-satir + .kn-ust-satir { margin-top: 4px; padding-top: 0; border-top: 0; }
    #kn .kn-ust .btn, #kn .kn-ust .kn-kutu, #kn .kn-ust .kn-pill, #kn .kn-ust .kn-ozel { height: 24px; font-size: .64rem !important; padding: 0 8px !important; border-radius: 7px !important; }
    #kn .kn-ust .btn i, #kn .kn-ust .kn-kutu i, #kn .kn-ust .kn-pill i { font-size: .66rem !important; } #kn .kn-ust .kn-kutu b { font-size: .7rem; }
