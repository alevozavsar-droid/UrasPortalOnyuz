    #kn .na-kart { margin-bottom: 4px; } #kn .kn-filtre-kart .na-kart-g { padding: 4px 10px; }
    #kn .kn-filtre { gap: 4px 10px; align-items: center; grid-template-columns: 1.25fr .95fr .95fr .9fr 1.2fr 1.5fr auto; }
