@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sirketler = (List<KeyValuePair<string, string>>)ViewBag.Sirketler;
    string varsayilan = (string)ViewBag.VarsayilanSirket ?? "";
    string bas = (string)ViewBag.Bas, bit = (string)ViewBag.Bit, sekme = (string)ViewBag.Sekme ?? "tumu";
    var sekmeler = new[] { ("tumu", "Tümü", "fa-list"), ("nakit", "Nakit", "fa-money-bill-wave"), ("cek", "Çek", "fa-money-check-alt"), ("senet", "Senet", "fa-file-signature"), ("havale", "Havale / EFT", "fa-building-columns"), ("kredi", "Kredi / Banka Kartı", "fa-credit-card"), ("mahsup", "Mahsup", "fa-right-left"), ("temlik", "Temlik", "fa-handshake"), ("yansitma", "Yansıtma", "fa-share-nodes"), ("diger", "Diğer", "fa-ellipsis"), ("bakiye", "Bakiye · Projeksiyon", "fa-vault"), ("gunluk", "Günlük", "fa-clock-rotate-left") };
}
@*
    KASA NAKİT AKIŞI (Rapor79) — modern görünüm. Veri /Rapor79/Veri (Data/NakitAkisOrnek.cs ödeme planı + Data/CekAkibetOrnek.cs çek kaydı + Mahsup / Temlik / Yansıtma modülleri),
    betik wwwroot/js/kasa-nakit.js, ortak stil nakit-avans.css. Eski (ana projedeki 23 sütunlu) görünüm: /Rapor79/Eski.
    Sekmeler ödeme yöntemine göre; her sekmede yalnız o yöntemin sütunları. Satır içi düzenleme (durum, tarih, yöntem alanları), çekmece (tüm alanlar, dekont, günlük),
    Çek / Senet: portföyden belge seçimi → Çek Akıbeti'nde Planlandı; Mahsup / Temlik / Yansıtma: ilgili modül kaydına bağlı (durum, tutar, kontrol modülden canlı; kayıt bağlantısı).
    Derin bağlantı: /Rapor79?sirket=URASKIMYA&bas=2026-09-12&bit=2026-12-11&sekme=cek
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<style>
    .na.kn { --na-k: #0f766e; }
    .kn-pill { font-size: .66rem; font-weight: 700; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 3px 10px; }
    .kn-filtre { display: grid; grid-template-columns: 1.2fr .9fr .9fr .9fr .9fr 1.6fr auto; gap: 6px 8px; align-items: end; }
    .kn-filtre label { display: block; font-size: .58rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 2px; }
    .kn-filtre .form-control, .kn-filtre .form-select { font-size: .72rem; padding: 3px 7px; height: 28px; }
    .kn-hizli { display: flex; gap: 4px; }
    .kn-hizli button { font-size: .62rem; padding: 2px 7px; }
    @@media (max-width: 1200px) { .kn-filtre { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    #kn .na-kpi { grid-template-columns: repeat(8, 1fr); }
    #kn .na-kpi .v { font-size: .98rem; }
    /* tablo: sabit düzen (sütunlar ağırlıkla paylaşılır, hücre taşmaz → 12 sütun tek ekranda), sıkı yazı; sütunlar yönteme göre (kasa-nakit.js › KOL) */
    #kn .kn-tablo { font-size: .68rem; table-layout: fixed; width: 100%; }
    #kn .kn-tablo th { font-size: .56rem; padding: 4px 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; position: sticky; top: 0; z-index: 2; }
    #kn .kn-tablo td { padding: 3px 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; vertical-align: middle; }
    #kn .kn-tablo td.sol { text-align: left !important; }
    #kn .kn-tablo td.kurum { font-weight: 700; color: #0f172a; }
    #kn .kn-tablo td small { display: block; font-size: .58rem; color: #64748b; font-weight: 500; line-height: 1.1; overflow: hidden; text-overflow: ellipsis; }
    #kn .kn-tablo td.not { color: #475569; }
    #kn .kn-tablo td.para { font-variant-numeric: tabular-nums; font-weight: 700; }
    #kn #knBakiye, #kn #knProjeksiyon, #kn #knGunluk { table-layout: auto; }
    #kn .kn-tablo tr.tik { cursor: pointer; } #kn .kn-tablo tr.tik:hover td { background: #f0fdfa; }
    #kn .kn-tablo tr.odendi td { background: #f0fdf4; } #kn .kn-tablo tr.gecikti td { background: #fef2f2; } #kn .kn-tablo tr.ozel td { background: #f5f3ff; } #kn .kn-tablo tr.planli td { background: #ecfeff; }
    #kn .kn-tablo tr.toplam td { font-weight: 800; background: #f8fafc; border-top: 2px solid #0f766e; }
    #kn .kn-tablo .kn-alan { width: 100%; min-width: 0; font-size: .66rem; border: 1px solid #e2e8f0; border-radius: 5px; padding: 2px 4px; background: #fff; height: 24px; text-overflow: ellipsis; }
    #kn .kn-tablo .kn-alan:focus { border-color: #0f766e; outline: 0; box-shadow: 0 0 0 2px rgba(15,118,110,.15); }
    #kn .kn-tablo .kn-alan.ok { border-color: #16a34a; background: #f0fdf4; }
    #kn .kn-tablo select.kn-durum { font-weight: 700; }
    #kn .kn-tablo input.kn-tarih { padding: 2px 2px; font-size: .62rem; }
    #kn .kn-tablo .yb { display: block; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .kn-yontem { display: inline-block; font-size: .58rem; font-weight: 800; border-radius: 4px; padding: 1px 6px; color: #fff; white-space: nowrap; }
    .kn-yontem.nakit { background: #15803d; } .kn-yontem.cek, .kn-yontem.senet { background: #0369a1; } .kn-yontem.havale { background: #1d4ed8; } .kn-yontem.kredi { background: #7c3aed; } .kn-yontem.mahsup { background: #b45309; } .kn-yontem.temlik { background: #be185d; } .kn-yontem.yansitma { background: #0f766e; } .kn-yontem.diger { background: #64748b; }
    .kn-kontrol-uyumlu { background: #dcfce7; color: #166534; } .kn-kontrol-farkli { background: #fee2e2; color: #991b1b; } .kn-kontrol-bekliyor { background: #fef9c3; color: #854d0e; } .kn-kontrol-plansiz { background: #e0f2fe; color: #0c4a6e; }
    .kn-grup { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
    .kn-grup > div { background: #fff; border: 1px solid #e2e8f0; border-left: 3px solid var(--k, #94a3b8); border-radius: 8px; padding: 6px 9px; }
    .kn-grup .l { font-size: .58rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: #64748b; } .kn-grup .v { font-size: .92rem; font-weight: 800; color: #0f172a; } .kn-grup .s { font-size: .62rem; color: #64748b; }
    .kn-drawer { position: fixed; top: 0; right: -760px; width: 720px; max-width: 96vw; height: 100vh; background: #fff; box-shadow: -8px 0 24px rgba(15,23,42,.18); z-index: 1060; transition: right .25s; overflow: auto; padding: 12px 14px; } .kn-drawer.acik { right: 0; }
    .kn-drawer-ust { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; position: sticky; top: 0; background: #fff; padding-bottom: 6px; border-bottom: 1px solid #e2e8f0; z-index: 2; flex-wrap: wrap; }
    .kn-perde { position: fixed; inset: 0; background: rgba(15,23,42,.35); z-index: 1055; display: none; } .kn-perde.acik { display: block; }
    .kn-form { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px 10px; }
    .kn-form .g2 { grid-column: span 2; } .kn-form .g4 { grid-column: span 4; }
    .kn-form .form-control, .kn-form .form-select { font-size: .72rem; min-height: 28px; padding: 3px 7px; }
    .kn-liste { font-size: .72rem; } .kn-liste .satir { display: flex; gap: 8px; padding: 4px 0; border-bottom: 1px dashed #e2e8f0; align-items: center; } .kn-liste .satir:last-child { border-bottom: 0; }
    .kn-modal .table { font-size: .7rem; } .kn-modal .table td, .kn-modal .table th { padding: 4px 6px; white-space: nowrap; }
    .kn-gunluk td { font-size: .68rem; }
</style>
}

<div class="container-fluid py-3 na kn" id="kn" data-sirket="@varsayilan" data-bas="@bas" data-bit="@bit" data-sekme="@sekme">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-money-bill-transfer"></i></span>Kasa Nakit Akışı</h4>
        <span class="kn-pill" data-git="tumu|#knSirket" title="Şirket filtresi"><i class="fas fa-building me-1"></i>Şirket Bazlı · Konsolide</span>
        <span class="kn-pill" data-git="cek|#knTablo-cek" title="Çek / Senet sekmesi: portföyden belge seçimi"><i class="fas fa-money-check-alt me-1"></i>Çek · Senet → Çek Akıbeti</span>
        <span class="kn-pill" data-git="mahsup|#knTablo-mahsup" title="Mahsup / Temlik / Yansıtma sekmeleri: grup içi modül kayıtlarına bağlı"><i class="fas fa-share-nodes me-1"></i>Mahsup · Temlik · Yansıtma → Grup İçi</span>
        <span class="kn-pill" data-url="/Rapor123?hesapTipi=CEK" data-baslik="Konsolide Finansal Takip Paneli" title="Plana aykırı çıkan çekler"><i class="fas fa-clipboard-check me-1"></i>Takip Paneli · Plan Kontrolü</span>
        <div class="sag">
            <button type="button" class="btn btn-primary btn-sm" id="knYeni" style="font-size:.7rem"><i class="fas fa-plus me-1"></i>Yeni Ödeme</button>
            <button type="button" class="btn btn-light btn-sm border" id="knExcel" style="font-size:.7rem"><i class="fas fa-file-excel me-1"></i>Excel</button>
            <a class="btn btn-light btn-sm border" href="/Rapor79/Eski" style="font-size:.7rem" title="Ana projedeki 23 sütunlu görünüm"><i class="fas fa-table me-1"></i>Eski Görünüm</a>
        </div>
        <span class="sub w-100">Şirketin ödeme planı <b>ödeme yöntemine göre sekmelerde</b>; her sekmede yalnız o yöntemin sütunları. <b>Çek / Senet</b> satırına portföyden belge seçilir, belge Çek Akıbeti Raporu'nda "Planlandı" olur ve plana aykırı çıkışlar Takip Paneli'nde izlenir. <b>Mahsup, Temlik, Yansıtma</b> satırları Grup İçi Özel Finansal İşlemler modüllerindeki kayıtlara bağlıdır: kurum, tutar, durum ve muhasebe kontrolü modülden canlı gelir, kayıt tek tıkla açılır. Satır içi düzenleme anında kaydedilir; satıra tıklayınca tüm alanlar, dekontlar ve günlük açılır.</span>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>

    <div class="na-kart">
        <div class="na-kart-b"><span><i class="fas fa-filter me-1"></i>Filtreler</span><span class="d-flex gap-2 align-items-center"><span class="not" id="knKapsam"></span><button type="button" class="btn btn-light btn-sm py-0" id="knTemizle" style="font-size:.64rem">Temizle</button></span></div>
        <div class="na-kart-g">
            <div class="kn-filtre">
                <div><label>Şirket</label><select class="form-select" id="knSirket"><option value="">Tümü (Konsolide)</option>@foreach (var s in sirketler) { <option value="@s.Key" selected="@(s.Key == varsayilan)">@s.Value</option> }</select></div>
                <div><label>Başlangıç</label><input type="date" class="form-control" id="knBas" value="@bas" /></div>
                <div><label>Bitiş</label><input type="date" class="form-control" id="knBit" value="@bit" /></div>
                <div><label>Durum</label><select class="form-select" id="knDurum"><option value="">Tümü</option></select></div>
                <div><label>Satınalmacı</label><select class="form-select" id="knSatinalmaci"><option value="">Tümü</option></select></div>
                <div><label>Ara</label><input class="form-control" id="knAra" placeholder="Kurum, belge no, ürün, not, çek no…" /></div>
                <div><label>Hızlı Dönem</label><div class="kn-hizli"><button type="button" class="btn btn-light border" data-gun="7">Bu Hafta</button><button type="button" class="btn btn-light border" data-gun="30">30 Gün</button><button type="button" class="btn btn-light border" data-gun="90">90 Gün</button></div></div>
            </div>
        </div>
    </div>

    <div class="na-kpi" id="knKpi" data-dinamik="kapali"></div>

    <div class="na-sekme" id="knSekmeler" data-dinamik="kapali">
        @foreach (var s in sekmeler) { <button type="button" data-p="@s.Item1"><i class="fas @s.Item3 me-1"></i>@s.Item2 <span class="n" id="knN-@s.Item1"></span></button> }
    </div>

    @foreach (var s in sekmeler.Where(x => x.Item1 != "bakiye" && x.Item1 != "gunluk"))
    {
        <div class="na-panel" data-p="@s.Item1">
            @if (s.Item1 == "mahsup" || s.Item1 == "temlik" || s.Item1 == "yansitma")
            {
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-share-nodes me-1"></i>Grup İçi Özel Finansal İşlemler · @s.Item2 Modülü (Canlı)</span><span class="not" id="knGrupNot-@s.Item1"></span></div><div class="na-kart-g"><div class="kn-grup" id="knGrup-@s.Item1"></div></div></div>
            }
            <div class="na-kart">
                <div class="na-kart-b"><span><i class="fas @s.Item3 me-1"></i>@(s.Item1 == "tumu" ? "Ödeme Listesi · Tüm Yöntemler" : s.Item2 + " Ödemeleri")</span><span class="not" id="knNot-@s.Item1">yükleniyor…</span></div>
                <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:68vh"><table class="na-tablo kn-tablo" id="knTablo-@s.Item1" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
            </div>
        </div>
    }
    <div class="na-panel" data-p="bakiye">
        <div class="row g-2">
            <div class="col-lg-7"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-vault me-1"></i>Banka · Kasa · Portföy Bakiyeleri</span><span class="not" id="knBakiyeNot"></span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo kn-tablo" id="knBakiye" data-dinamik="kapali"><thead><tr><th>Şirket</th><th>Banka / Kasa</th><th>Detay</th><th>PB</th><th class="s">Tutar</th><th class="s">Tutar (₺)</th><th>Güncelleme</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div></div></div>
            <div class="col-lg-5"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-chart-line me-1"></i>Para Birimine Göre Projeksiyon</span><span class="not">mevcut − bekleyen ödeme (ÖDENDİ hariç)</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo kn-tablo" id="knProjeksiyon" data-dinamik="kapali"><thead><tr><th>PB</th><th>Kaynak</th><th class="s">Mevcut</th><th class="s">Bekleyen Ödeme</th><th class="s">Kalan</th></tr></thead><tbody></tbody></table></div></div></div>
                <div class="na-mini rt-aciklama">Nakit / Banka satırı Nakit, Havale / EFT, Kredi Kartı ve Diğer yöntemli bekleyen ödemeleri; Müşteri Çekleri satırı Çek ve Senet yöntemli bekleyen ödemeleri portföyle karşılaştırır. Mahsup, Temlik ve Yansıtma nakit çıkışı olmadığından projeksiyona girmez.</div></div>
        </div>
    </div>
    <div class="na-panel" data-p="gunluk">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-clock-rotate-left me-1"></i>İşlem Günlüğü</span><span class="not" id="knGunlukNot"></span></div><div class="na-kart-g p-0"><div class="table-responsive" style="max-height:68vh"><table class="na-tablo kn-tablo kn-gunluk" id="knGunluk" data-dinamik="kapali"><thead><tr><th>Zaman</th><th>Kullanıcı</th><th>Şirket</th><th>Kayıt</th><th>İşlem</th><th>Açıklama</th></tr></thead><tbody></tbody></table></div></div></div>
    </div>

    @* ===== çekmece: satır detayı / düzenleme / yeni kayıt ===== *@
    <div class="kn-perde" id="knPerde"></div>
    <div class="kn-drawer" id="knDrawer">
        <div class="kn-drawer-ust"><b id="knDBaslik" style="font-size:.88rem"></b><span class="ms-auto d-flex gap-1 flex-wrap" id="knDAksiyon"></span><button type="button" class="btn btn-light btn-sm py-0" id="knDKapat" style="font-size:.66rem"><i class="fas fa-xmark"></i></button></div>
        <div id="knDIc"></div>
    </div>

    @* ===== belge seçimi (Çek / Senet) ===== *@
    <div class="modal fade kn-modal" id="knBelgeModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.84rem"><i class="fas fa-money-check-alt me-2 text-primary"></i><span id="kbBaslik">Belge Seç</span> <span class="kn-pill ms-2" id="kbKurum"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="d-flex gap-2 align-items-center mb-2 flex-wrap"><span class="text-muted" style="font-size:.7rem" id="kbBilgi"></span><input type="text" id="kbAra" class="form-control form-control-sm ms-auto" style="max-width:240px;font-size:.7rem" placeholder="Belge no, keşideci, banka ara…" /></div>
            <div class="table-responsive" style="max-height:52vh"><table class="table table-sm table-hover align-middle mb-0"><thead class="table-light"><tr><th style="width:28px"><input type="checkbox" id="kbHepsi" class="form-check-input" /></th><th>Belge No</th><th>Banka / Şube</th><th>Keşideci</th><th>Kimden Geldi</th><th>Vade</th><th>Vade Durumu</th><th class="text-end">Tutar</th><th>Portföy Giriş</th></tr></thead><tbody id="kbGovde"></tbody></table></div>
        </div>
        <div class="modal-footer py-2"><span class="me-auto" style="font-size:.7rem"><b id="kbSayi">0</b> belge · <b id="kbToplam">0,00</b> ₺ <span class="text-muted" id="kbFark"></span></span><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-primary btn-sm" id="kbOnayla"><i class="fas fa-check me-1"></i>Seçilenleri Planla</button></div>
    </div></div></div>

    @* ===== grup içi kayıt seçimi (Mahsup / Temlik / Yansıtma) ===== *@
    <div class="modal fade kn-modal" id="knGrupModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.84rem"><i class="fas fa-share-nodes me-2 text-primary"></i><span id="kgBaslik">Kayıt Seç</span> <span class="kn-pill ms-2" id="kgKurum"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="d-flex gap-2 align-items-center mb-2 flex-wrap"><span class="text-muted" style="font-size:.7rem" id="kgBilgi"></span><input type="text" id="kgAra" class="form-control form-control-sm ms-auto" style="max-width:240px;font-size:.7rem" placeholder="Kayıt no, taraf, tür ara…" /></div>
            <div class="table-responsive" style="max-height:52vh"><table class="table table-sm table-hover align-middle mb-0"><thead class="table-light"><tr><th style="width:28px"></th><th>Kayıt No</th><th>Tarih</th><th>Tür</th><th>Taraflar</th><th class="text-end">Tutar</th><th>Durum</th><th>Muhasebe</th><th></th></tr></thead><tbody id="kgGovde"></tbody></table></div>
        </div>
        <div class="modal-footer py-2"><span class="me-auto text-muted" style="font-size:.7rem">Kayıt bağlanınca kurum, tutar ve tarih modülden alınır; durum ve kontrol her açılışta modülden okunur.</span><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-primary btn-sm" id="kgOnayla"><i class="fas fa-link me-1"></i>Kaydı Bağla</button></div>
    </div></div></div>
</div>

@section Scripts {
<script src="/js/kasa-nakit.js?v=2"></script>
}
