    .kn-sutun-liste { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 14px; font-size: .74rem; } .kn-sutun-liste label { display: flex; gap: 6px; align-items: center; cursor: pointer; margin: 0; }
    /* ===== 13 Kas 2026 — KURUMSAL STANDART ("ikonları standartlaştır, biri çok büyük biri çok küçük, rengarenk olmasın, kurumsal şık"):
       tek rozet ölçüsü · tek düğme ölçüsü · tek ikon ölçüsü; ana renk lacivert, yazı koyu gri; renk yalnız anlam taşıyan yerde (durum rozetinin küçük noktası: yeşil tamam · sarı bekliyor · kırmızı sorun · lacivert bilgi).
       Bu blok stilin en sonunda durur ve yukarıdaki dağınık rozet / düğme renklerini ezer. ===== */
    #kn { --kn-lacivert: #1e3a8a; --kn-yazi: #0f172a; --kn-soluk: #64748b; --kn-cizgi: #cbd5e1; --kn-ok: #15803d; --kn-bekle: #b45309; --kn-hata: #b91c1c; }
    .na.kn { --na-k: #1e3a8a; }
    /* --- rozetler: hepsi aynı ölçü, beyaz zemin, ince çerçeve --- */
    #kn .rt-durum, #kn .kn-yontem, #kn .na-bs, #kn .kn-onay, #kn .kn-oran, #kn .kn-avans, #kn .kn-mukerrer, #kn .kn-kf, #kn .kn-ek-tur, #kn .kn-talimat-rozet {
        display: inline-flex; align-items: center; gap: 4px; font-size: .56rem !important; font-weight: 700 !important; line-height: 1.25 !important; padding: 1px 6px !important; margin: 1px 0; border-radius: 4px !important;
        border: 1px solid var(--kn-cizgi) !important; background: #fff !important; color: #334155 !important; box-shadow: none !important; text-transform: none !important; letter-spacing: 0 !important; white-space: normal; vertical-align: middle; min-height: 0 !important; text-align: left; }
    #kn .rt-durum, #kn .kn-yontem, #kn .na-bs, #kn .kn-onay, #kn .kn-oran, #kn .kn-avans, #kn .kn-mukerrer, #kn .kn-ek-tur { overflow-wrap: normal !important; word-break: keep-all; white-space: normal !important; }   /* rozet metni kelime ortasından bölünmez, sığmazsa alt satıra iner */
    /* tür rozetleri (ödeme yöntemi, oran, ek türü, talimat no …): açık gri zemin, renksiz */
    #kn .kn-yontem, #kn .kn-oran, #kn .kn-kf, #kn .kn-ek-tur, #kn .kn-talimat-rozet { background: #f1f5f9 !important; border-color: #e2e8f0 !important; color: var(--kn-yazi) !important; }
    #kn .kn-talimat-rozet { color: var(--kn-lacivert) !important; }
    /* durum rozetleri: solda 6 px durum noktası */
    #kn .rt-durum::before, #kn .na-bs::before, #kn .kn-onay::before, #kn .kn-avans::before, #kn .kn-mukerrer::before { content: "" !important; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #94a3b8; flex: none; position: static; margin: 0; }
    #kn .rt-durum.rt-ok::before, #kn .kn-onay.onayli::before, #kn .na-bs.kn-kontrol-uyumlu::before { background: var(--kn-ok); }
    #kn .rt-durum.rt-bekle::before, #kn .kn-onay.bekliyor::before, #kn .kn-onay.gmy::before, #kn .na-bs.kn-kontrol-bekliyor::before, #kn .kn-avans::before { background: #d97706; }
    #kn .rt-durum.rt-hata::before, #kn .kn-onay.red::before, #kn .na-bs.kn-kontrol-farkli::before, #kn .kn-mukerrer::before { background: #dc2626; }
    #kn .rt-durum.rt-bilgi::before, #kn .na-bs.kn-kontrol-plansiz::before { background: var(--kn-lacivert); }
    #kn .rt-durum.rt-hata, #kn .kn-mukerrer, #kn .na-bs.kn-kontrol-farkli, #kn .kn-onay.red { border-color: #fca5a5 !important; color: var(--kn-hata) !important; }
    /* --- hücre içi düğmeler: hepsi aynı ölçü, beyaz zemin, lacivert yazı; üstüne gelince lacivert dolar --- */
    #kn .kn-tablo td .btn, #kn .kn-dekont-yukle { display: inline-flex !important; align-items: center; justify-content: center; gap: 4px; width: auto; max-width: 100%; min-height: 20px; height: auto; font-size: .58rem !important; font-weight: 700 !important; line-height: 1.1 !important;
        padding: 2px 6px !important; margin: 1px 0; border-radius: 5px !important; border: 1px solid var(--kn-cizgi) !important; background: #fff !important; color: var(--kn-lacivert) !important; box-shadow: none !important; text-decoration: none !important; white-space: normal; vertical-align: middle; }
    #kn .kn-tablo td .btn:hover:not(:disabled), #kn .kn-dekont-yukle:hover { background: var(--kn-lacivert) !important; border-color: var(--kn-lacivert) !important; color: #fff !important; }
