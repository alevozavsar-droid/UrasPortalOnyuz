    var sekmeler = new[] { ("tumu", "Tümü", "fa-list"), ("nakit", "Nakit", "fa-money-bill-wave"), ("cek", "Çek", "fa-money-check-alt"), ("senet", "Senet", "fa-file-signature"), ("havale", "Havale / EFT", "fa-building-columns"), ("kredi", "Kredi / Banka Kartı", "fa-credit-card"), ("ozet", "Özet", "fa-chart-pie"), ("oncelik", "Öncelik Planı", "fa-list-ol"), ("talimat", "Talimatlar", "fa-file-contract"), ("aylik", "Aylık Ödeme · Çek Vade", "fa-calendar-days"), ("bakiye", "Banka / Kasa Bakiyesi", "fa-vault"), ("gunluk", "İşlem Günlüğü", "fa-clock-rotate-left") };
