    #kn .kn-tablo td .btn:disabled { opacity: .4; }
    #kn .kn-tablo td .btn.text-danger { border-color: transparent !important; background: transparent !important; color: #94a3b8 !important; padding: 2px 4px !important; }   /* kaldır (×) düğmeleri: soluk, üstüne gelince kırmızı */
    #kn .kn-tablo td .btn.text-danger:hover:not(:disabled) { background: #fee2e2 !important; border-color: #fca5a5 !important; color: var(--kn-hata) !important; }
    #kn .kn-dk .kn-dekont-yukle, #kn .kn-dekont-yukle { width: 26px; max-width: 26px; padding: 2px 0 !important; }
    /* --- satır işlem ikonları ve bağlantılar: tek ölçü --- */
    #kn .kn-satir-islem { gap: 8px; } #kn .kn-satir-islem a { font-size: .74rem; line-height: 1; } #kn .kn-satir-islem .kn-ac { color: var(--kn-lacivert); } #kn .kn-satir-islem .kn-sil { color: #94a3b8; } #kn .kn-satir-islem .kn-sil:hover { color: var(--kn-hata); }
    #kn .kn-belge-link, #kn .kn-tablo td a:not(.btn):not(.kn-sil) { color: var(--kn-lacivert); } #kn .kn-tablo td a .fas, #kn .kn-tablo td a .far { font-size: .62rem; }
    #kn .kn-tablo td .text-primary { color: var(--kn-lacivert) !important; }
    /* --- seçim kutuları (işlem türü, muafiyet): sade çerçeve; eksik olan sarı çerçeveyle belirtilir --- */
    #kn .kn-muaf { border: 1px solid #e2e8f0; border-radius: 4px; color: var(--kn-soluk); background: rgba(255,255,255,.6); } #kn .kn-muaf.dolu { border-color: var(--kn-lacivert); background: #fff; color: var(--kn-yazi); font-weight: 700; }
    /* --- dolaşım adımları: beyaz kutu, solda ince durum çizgisi --- */
    #kn .kn-dz-b { color: var(--kn-lacivert); }
    #kn .kn-dz-a, #kn .kn-dz-a.ok, #kn .kn-dz-a.plan { background: #fff; border: 1px solid #e2e8f0; border-left: 3px solid #cbd5e1; color: var(--kn-yazi); box-shadow: none; }
    #kn .kn-dz-a small, #kn .kn-dz-a.ok small, #kn .kn-dz-a.plan small { color: var(--kn-soluk); } #kn .kn-dz-a i, #kn .kn-dz-a.ok i { color: #94a3b8; }
    #kn .kn-dz-a.ok { border-left-color: #16a34a; } #kn .kn-dz-a.ok small i { color: #16a34a; } #kn .kn-dz-a.sirada { border-left-color: var(--kn-lacivert); border-color: #bfdbfe #bfdbfe #bfdbfe var(--kn-lacivert); }
    /* --- üst şerit, sekmeler, kart başlığı düğmeleri: tek yükseklik, beyaz zemin, lacivert ikon; yalnız ana işlem (Getir, Yeni Ödeme Ekle, Talimat Oluştur) dolu lacivert --- */
    #kn .kn-ust .rt-ikon { background: var(--kn-lacivert) !important; }
    #kn .kn-ust .btn, #kn .kn-ust .kn-kutu, #kn .kn-ust .kn-pill, #kn .kn-ust .kn-ozel { display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 10px !important; font-size: .68rem !important; font-weight: 700; line-height: 1; border-radius: 8px !important;
        border: 1px solid var(--kn-cizgi) !important; background: #fff !important; color: var(--kn-yazi) !important; white-space: nowrap; text-decoration: none; box-shadow: none !important; margin: 0; }
    #kn .kn-ust .btn i, #kn .kn-ust .kn-kutu i, #kn .kn-ust .kn-pill i { font-size: .72rem !important; color: var(--kn-lacivert) !important; margin: 0 !important; }
    #kn .kn-ust .btn:hover, #kn .kn-ust a.kn-pill:hover, #kn .kn-ust .kn-pill[data-git]:hover, #kn .kn-ust .kn-pill[data-url]:hover { border-color: var(--kn-lacivert) !important; color: var(--kn-lacivert) !important; background: #f8fafc !important; }
    #kn .kn-ust #knGetir { background: var(--kn-lacivert) !important; border-color: var(--kn-lacivert) !important; color: #fff !important; } #kn .kn-ust #knGetir i { color: #fff !important; } #kn .kn-ust #knGetir:hover { background: #172554 !important; color: #fff !important; }
    #kn .kn-ust .kn-kutu b { color: var(--kn-yazi); font-size: .76rem; } #kn .kn-ust .badge { background: var(--kn-lacivert) !important; color: #fff !important; font-size: .58rem !important; border-radius: 999px; padding: 2px 6px; }
    #kn .kn-ust .kn-ozel.acik { background: var(--kn-hata) !important; border-color: var(--kn-hata) !important; color: #fff !important; }
    #kn .na-sekme button { color: var(--kn-yazi); } #kn .na-sekme button i { color: var(--kn-soluk); } #kn .na-sekme button:hover { border-color: var(--kn-lacivert); color: var(--kn-lacivert); }
    #kn .na-sekme button.aktif { background: var(--kn-lacivert); border-color: var(--kn-lacivert); color: #fff; } #kn .na-sekme button.aktif i { color: #fff; }
    #kn .na-kart-b .btn { display: inline-flex; align-items: center; gap: 5px; height: 22px; padding: 0 9px !important; font-size: .62rem !important; font-weight: 700; line-height: 1; border-radius: 6px !important; border: 1px solid var(--kn-cizgi) !important; background: #fff !important; color: var(--kn-lacivert) !important; box-shadow: none !important; white-space: nowrap; }
