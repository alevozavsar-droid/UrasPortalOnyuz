@section Scripts {
    <script>
        // Bulanık/tıklanamaz pencere düzeltmesi.
        // Layout @@RenderBody()'yi .table-container içinde render ediyor; bu
        // sayfadaki .table-container kuralı oraya da uyduğu için oluşan
        // stacking context modali backdrop'un altında bırakıyordu.
        (function modalleriBodyeTasi() {
            var idler = ['topluDekontUploadModal', 'odenenlerModal', 'detayModal', 'satirCekSecimModal', 'portfoyCekEkleModal', 'ekleModal', 'duzenleModal', 'pdfPreviewModal', 'logModal', 'sistemLoglariModal', 'dekontListeModal', 'dekontUploadModal', 'mukerrerModal'];
            idler.forEach(function (id) {
                var el = document.getElementById(id);
                if (el && el.parentElement !== document.body) {
                    document.body.appendChild(el);
                }
            });
        })();
    </script>

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // Kaydirma payi: sabit arac cubugu sarabildigi icin yuksekligi
        // degisken. Sabit 90px kullanildiginda hedef satir cubugun
        // arkasinda kaliyordu.
        // NOT: Bu fonksiyon her acilista gerekir (sekme geri yukleme ve
        // hizli-git dugmeleri cagirir). Eskiden yalnizca TempData["Success"]
        // doluyken cizilen blogun icindeydi; normal acilista tanimsiz kalip
        // "kaydirmaPayi is not defined" hatasi veriyordu.
        function kaydirmaPayi() {
            var cubuk = document.querySelector('.top-toolbar');
            return (cubuk ? cubuk.offsetHeight : 78) + 16;
        }
    </script>

    @if (TempData["Success"] != null)
    {
        <script>
            $(document).ready(function () {
                toastr.success('@Html.Raw(TempData["Success"])');
            });
        </script>
    }
    @if (TempData["Error"] != null)
    {
        <script>
            $(document).ready(function () {
                toastr.error('@Html.Raw(TempData["Error"])');
            });
        </script>
    }

    <script src="~/js/rapor79.js" asp-append-version="true"></script>

<script>
    // Sabit arac cubugu sarabildigi icin yuksekligi degisken. Govde ust
    // boslugunu her zaman cubugun GERCEK yuksekligine esitliyoruz; aksi
    // halde alttaki butonlar cubugun arkasinda kaliyordu.
    (function () {
        function toolbarBosluguAyarla() {
            var cubuk = document.querySelector('.top-toolbar');
            if (!cubuk) return;
            var y = cubuk.offsetHeight;
            // Sayfa ici kaydirma payi da ayni yukseklige baglanir
            document.documentElement.style.setProperty('--cubuk-yuksekligi', y + 'px');
        }

        window.toolbarBosluguAyarla = toolbarBosluguAyarla;

        document.addEventListener('DOMContentLoaded', toolbarBosluguAyarla);
        window.addEventListener('resize', toolbarBosluguAyarla);
        window.addEventListener('load', toolbarBosluguAyarla);

        // Icerik sonradan degisirse (filtre, rol secimi) tekrar olc
        if (window.ResizeObserver) {
            document.addEventListener('DOMContentLoaded', function () {
                var cubuk = document.querySelector('.top-toolbar');
                if (cubuk) new ResizeObserver(toolbarBosluguAyarla).observe(cubuk);
            });
        }
    })();
</script>

@* ============================================================
   SUTUN SECIMI (kisiye ozel)
   Odeme listesi tablolarindaki 23 sutundan istenenler gizlenir.
   Tercih Z_KullaniciTercih / Rapor79GizliKolon'a "3,5,9" olarak yazilir.
   - Normal hucreler CSS ile (nth-child) gizlenir; sayfa acilirken sunucu
     ayni CSS'i urettigi icin titreme olmaz.
   - colspan iceren satirlar (TOPLAM, "Kayit yok", detay alt satiri)
     CSS ile gizlenemez; JS bu satirlarin colspan'ini gorunen sutun
     sayisina gore yeniden hesaplar. Sonradan eklenen satirlar icin
     MutationObserver ayni duzeltmeyi tekrarlar.
   ============================================================ *@
<div class="modal fade" id="kolonSecimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title fw-bold"><i class="fas fa-columns me-2 text-primary"></i>Görünecek Sütunlar</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-2">İşaretli sütunlar görünür. Seçim yalnızca sizin hesabınıza kaydedilir ve tüm firmalar için geçerlidir.</p>
                <div class="d-flex gap-2 mb-2">
                    <button type="button" class="btn btn-sm btn-outline-primary" id="kolonTumunuSec">Tümünü seç</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="kolonTumunuKaldir">Tümünü kaldır</button>
                </div>
                <div id="kolonListesi" class="row g-1"></div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-light" id="kolonVarsayilan"><i class="fas fa-rotate-left me-1"></i>Varsayılana dön</button>
                <button type="button" class="btn btn-sm btn-primary" id="kolonKaydet"><i class="fas fa-save me-1"></i>Kaydet ve uygula</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var TERCIH_ANAHTARI = 'Rapor79GizliKolon';
        var SUTUN_SAYISI = 23;
        var KILITLI = [1];   // secim kutusu sutunu her zaman gorunur
        var gizli = new Set(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(gizliKolonlar)));

        var stil = document.getElementById('r79KolonStil');
        var sayac = document.getElementById('kolonGizliSayac');

        // Sutun basliklari ilk tablonun basligindan okunur.
        function sutunAdlari() {
            var adlar = [];
            var bas = document.querySelector('.main-payment-table thead tr:nth-child(2)');
            if (!bas) return adlar;
            Array.prototype.forEach.call(bas.children, function (th, i) {
                var span = th.querySelector('.header-content span');
                var ad = span ? span.textContent : th.textContent;
                ad = (ad || '').replace(/\s+/g, ' ').trim();
                if (i === 0) ad = 'Seçim kutusu';
                if (ad === '#') ad = '# (Satır No)';
                adlar.push(ad || ('Sütun ' + (i + 1)));
            });
            return adlar;
        }

        function stilYaz() {
            var kurallar = [];
            gizli.forEach(function (k) {
                kurallar.push(
                    '.main-payment-table thead tr:nth-child(2) > th:nth-child(' + k + '), ' +
                    '.main-payment-table tbody > tr:not(:has(> td[colspan])) > td:nth-child(' + k + ') { display: none !important; }');
            });
            if (stil) stil.textContent = kurallar.join('\n');
            if (sayac) {
                sayac.textContent = gizli.size + ' gizli';
                sayac.style.display = gizli.size ? '' : 'none';
            }
        }

        // colspan iceren satirlar: her hucrenin kapsadigi sutunlardan gorunenleri say.
        function colspanDuzelt() {
            var satirlar = document.querySelectorAll('.main-payment-table tr');
            Array.prototype.forEach.call(satirlar, function (tr) {
                var hucreler = tr.children;
                var colspanVar = false;
                for (var i = 0; i < hucreler.length; i++) {
                    if (hucreler[i].dataset.orjColspan || hucreler[i].colSpan > 1) { colspanVar = true; break; }
                }
                if (!colspanVar) return;   // duz satirlar CSS ile hallolur

                var c = 1;
                for (var j = 0; j < hucreler.length; j++) {
                    var h = hucreler[j];
                    var orj = parseInt(h.dataset.orjColspan, 10);
                    if (!orj) { orj = h.colSpan || 1; h.dataset.orjColspan = orj; }
                    var gorunen = 0;
                    for (var k = c; k < c + orj; k++) if (!gizli.has(k)) gorunen++;
                    if (gorunen === 0) {
                        h.style.display = 'none';
                    } else {
                        h.style.display = '';
                        if (orj > 1) h.colSpan = gorunen;
                    }
                    c += orj;
                }
            });
        }

        function uygula() { stilYaz(); colspanDuzelt(); }

        // Sonradan eklenen satirlar (detay alt satiri, yeni kayit) icin.
        var bekleyen = null;
        function gozlemBasla() {
            if (!window.MutationObserver) return;
            var g = new MutationObserver(function () {
                clearTimeout(bekleyen);
                bekleyen = setTimeout(colspanDuzelt, 50);
            });
            Array.prototype.forEach.call(document.querySelectorAll('.main-payment-table tbody'), function (tb) {
                g.observe(tb, { childList: true });
            });
        }

        function listeCiz() {
            var kap = document.getElementById('kolonListesi');
            if (!kap) return;
            var adlar = sutunAdlari();
            var html = '';
            for (var i = 1; i <= SUTUN_SAYISI; i++) {
                var kilitli = KILITLI.indexOf(i) >= 0;
                html += '<div class="col-6">' +
                    '<div class="form-check">' +
                    '<input class="form-check-input kolon-kutu" type="checkbox" id="kolonKutu' + i + '" value="' + i + '"' +
                    (gizli.has(i) ? '' : ' checked') + (kilitli ? ' disabled' : '') + '>' +
                    '<label class="form-check-label small" for="kolonKutu' + i + '">' + (i) + '. ' +
                    (adlar[i - 1] || ('Sütun ' + i)) + (kilitli ? ' <span class="text-muted">(sabit)</span>' : '') + '</label>' +
                    '</div></div>';
            }
            kap.innerHTML = html;
        }

        function secimdenOku() {
            var yeni = new Set();
            Array.prototype.forEach.call(document.querySelectorAll('#kolonListesi .kolon-kutu'), function (k) {
                var i = parseInt(k.value, 10);
                if (!k.checked && KILITLI.indexOf(i) < 0) yeni.add(i);
            });
            return yeni;
        }

        function kaydet(yeniGizli, bitti) {
            var deger = Array.from(yeniGizli).sort(function (a, b) { return a - b; }).join(',');
            var veri = new FormData();
            veri.append('anahtar', TERCIH_ANAHTARI);
            veri.append('deger', deger);   // bos = kayit silinir (varsayilan)
            fetch('/Home/KullaniciTercihKaydet', { method: 'POST', body: veri })
                .then(function (r) { return r.json(); })
                .then(function (c) {
                    if (!c || !c.success) { toastr.error((c && c.message) || 'Sütun tercihi kaydedilemedi.'); bitti(false); return; }
                    bitti(true);
                })
                .catch(function () { toastr.error('Sunucuya ulaşılamadı.'); bitti(false); });
        }

        document.addEventListener('DOMContentLoaded', function () {
            uygula();
            gozlemBasla();

            var modalEl = document.getElementById('kolonSecimModal');
            var btn = document.getElementById('kolonSecimBtn');
            if (!modalEl || !btn) return;

            btn.addEventListener('click', function () {
                listeCiz();
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            });

            document.getElementById('kolonTumunuSec').addEventListener('click', function () {
                Array.prototype.forEach.call(document.querySelectorAll('#kolonListesi .kolon-kutu'), function (k) { k.checked = true; });
            });
            document.getElementById('kolonTumunuKaldir').addEventListener('click', function () {
                Array.prototype.forEach.call(document.querySelectorAll('#kolonListesi .kolon-kutu'), function (k) { if (!k.disabled) k.checked = false; });
            });

            document.getElementById('kolonKaydet').addEventListener('click', function () {
                var yeni = secimdenOku();
                var dugme = this; dugme.disabled = true;
                kaydet(yeni, function (ok) {
                    dugme.disabled = false;
                    if (!ok) return;
                    gizli = yeni;
                    uygula();
                    bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                    toastr.success(gizli.size ? gizli.size + ' sütun gizlendi.' : 'Tüm sütunlar görünür.');
                });
            });

            document.getElementById('kolonVarsayilan').addEventListener('click', function () {
                var dugme = this; dugme.disabled = true;
                kaydet(new Set(), function (ok) {
                    dugme.disabled = false;
                    if (!ok) return;
                    gizli = new Set();
                    uygula();
                    bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                    toastr.success('Sütunlar varsayılana döndü.');
                });
            });
        });
    })();
</script>

}