    /* belge penceresi (belge no tıklanınca): solda kayıt detayı, sağda belge görüntüsü (PDF) */
    #knBelgeDetayModal .kdt-genis { max-width: min(1760px, 97vw); }
    #knBelgeDetayModal .kdt-govde { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 12px; padding: 10px 12px; height: calc(100vh - 150px); overflow: hidden; }
