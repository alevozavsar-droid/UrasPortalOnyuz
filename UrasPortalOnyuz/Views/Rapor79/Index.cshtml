    #kn .kn-odeme tbody td { font-weight: 600; padding: 7px 5px; border-bottom: 1px solid #fff; white-space: normal; line-height: 1.2; }   /* hücre metni kısalmaz, sarılır (firma adı, satınalmacı …) */
