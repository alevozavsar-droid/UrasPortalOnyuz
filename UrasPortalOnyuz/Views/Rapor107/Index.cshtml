@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/gg-kod-secici.js?v=1"></script>
    @await Html.PartialAsync("_GiderKodTalep")
    <script>
        // -----------------------------------------------------------------
        // TUTAR BİÇİMLENDİRME (talep 23)
        //
        // Tutarlar ekranda Türkçe yazımla gösterilir: 1.234.567,89
        // (binlik = nokta, ondalık = virgül). Diğer giriş ekranlarındaki
        // formatNumber ile aynı biçim kullanılır.
        //
        // Kullanıcı hem "1.234,56" hem "1234.56" hem de "1234,56" yazabilir;
        // tutarOku üçünü de doğru okur. Alandan çıkıldığında değer tekrar
        // Türkçe yazıma çevrilir, böylece kullanıcı yorumu anında görür.
        // -----------------------------------------------------------------
        function tutarOku(kaynak) {
            var m = (typeof kaynak === 'string') ? kaynak : $(kaynak).val();
            if (m === null || m === undefined) return 0;
            m = String(m).replace(/\s/g, '').replace(/[^0-9.,+-]/g, '');
            if (!m) return 0;

            var sonNokta = m.lastIndexOf('.');
            var sonVirgul = m.lastIndexOf(',');

            if (sonNokta >= 0 && sonVirgul >= 0) {
                // Iki ayirici da var: SONDAKI ondalik ayiricidir.
                if (sonVirgul > sonNokta) m = m.replace(/\./g, '').replace(',', '.');
                else                      m = m.replace(/,/g, '');
            } else if (sonVirgul >= 0) {
                var pv = m.split(',');
                // "1,234" gibi tam 3 haneli tek parca binlik sayilir; digerleri ondalik.
                if (pv.length === 2 && pv[1].length === 3) m = m.replace(/,/g, '');
                else m = m.replace(/,/g, '.');
            } else if (sonNokta >= 0) {
                var pn = m.split('.');
                // "1.234" ve "1.234.567" binlik; "1234.5" / "1234.56" ondalik.
                if (pn.length > 2) m = m.replace(/\./g, '');
                else if (pn.length === 2 && pn[1].length === 3) m = m.replace(/\./g, '');
            }

            var n = parseFloat(m);
            return isNaN(n) ? 0 : n;
        }

        function tutarYaz(deger) {
            var n = (typeof deger === 'number') ? deger : tutarOku(deger);
            if (isNaN(n)) n = 0;
            return n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        let currentMode = 'ADD';
        let currentTransId = 0;
        let isBindingData = false;
        
        let systemExchangeRates = {}; 
        let currentSystemCurrency = '@systemCurrency';

        $(document).ready(function () {
            toastr.options = { positionClass: "toast-bottom-right", timeOut: "3000" };
            $('.select2-init').select2({ theme: 'bootstrap-5' });

            // Tutar alanindan cikildiginda deger Turkce yazima cevrilir (talep 23).
            // change olayi blur'dan once tetiklendigi icin "100 USD" gibi para
            // birimli girisler once kendi mantiginda islenir; burada yalnizca
            // sayisal hale gelmis deger bicimlendirilir.
            $(document).on('blur', '.input-debit, .input-credit, .input-fc-debit, .input-fc-credit', function () {
                var ham = $(this).val();
                if (ham === null || String(ham).trim() === '') { $(this).val(tutarYaz(0)); return; }
                if (/[A-Za-z]/.test(String(ham))) return;   // para birimi yazimi: dokunma
                $(this).val(tutarYaz(tutarOku(ham)));
            });
            
            // İthalat / İhracat Dosya Numaraları için özel Select2 (Klavyeden giriş serbest - Tags)
            $('.select2-tags').select2({ theme: 'bootstrap-5', tags: true, placeholder: "Seçiniz / Yazınız", allowClear: true });
            
            setFormMode('ADD');

            $('#RefDate').on('change', function() {
                if(currentMode === 'ADD' && !isBindingData) fetchRatesAndCalculate();
            });

            $('#btnFindMode').click(() => setFormMode('FIND'));
            $('#btnNewDoc').click(() => setFormMode('ADD'));
            $('#btnAddRow').click(() => { if (currentMode === 'ADD') addRow(); });

            // TOPLU İPTAL MODALINI AÇ
            $('#btnBulkCancelModal').click(function() {
                $('#loadingOverlay').css('display', 'flex');
                $.get('/Rapor107/GetOpenManualJEs', function(res) {
                    if (res.success) {
                        let html = '';
                        res.data.forEach(d => {
                            html += `<tr style="cursor:pointer;" onclick="$(this).find('.chk-cancel').prop('checked', !$(this).find('.chk-cancel').prop('checked'))">
                                <td class="text-center" onclick="event.stopPropagation()"><input type="checkbox" class="chk-cancel" value="${d.transId}"></td>
                                <td class="fw-bold text-primary">${d.transId}</td>
                                <td>${d.number}</td>
                                <td>${d.refDate}</td>
                                <td class="text-truncate" style="max-width:300px;">${d.memo || ''}</td>
                            </tr>`;
                        });
                        $('#openJEsBody').html(html);
                        $('#chkAllCancel').prop('checked', false);
                        $('#bulkCancelModal').modal('show');
                    } else toastr.error("Açık kayıtlar getirilemedi.");
                }).always(() => $('#loadingOverlay').hide());
            });

            $('#chkAllCancel').change(function() {
                $('.chk-cancel').prop('checked', $(this).is(':checked'));
            });

            // TOPLU İPTAL ÇALIŞTIR
            $('#btnExecuteBulkCancel').click(function() {
                let ids = [];
                $('.chk-cancel:checked').each(function() { ids.push(parseInt($(this).val())); });
                
                if (ids.length === 0) { toastr.warning("Lütfen iptal edilecek kayıtları seçin."); return; }

                if (confirm(`Toplam ${ids.length} adet belge iptal edilecek (Ters kayıt oluşturulacak). Onaylıyor musunuz?`)) {
                    $('#bulkCancelModal').modal('hide');
                    $('#loadingOverlay').css('display', 'flex');
                    
                    $.ajax({
                        url: '/Rapor107/BulkCancelJournalEntries',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ TransIds: ids }),
                        success: function(res) {
                            if (res.success) {
                                if (res.hasErrors) toastr.warning(res.message);
                                else toastr.success(res.message);
                                if (currentMode === 'VIEW') loadJEDetails(currentTransId);
                            } else toastr.error(res.message);
                        },
                        error: function() { toastr.error("Toplu iptal işlemi sırasında hata oluştu."); },
                        complete: function() { $('#loadingOverlay').hide(); }
                    });
                }
            });

            $(document).on('click', '.btn-remove-row', function () {
                if (currentMode !== 'ADD') return;
                $(this).closest('tr').find('.select-account, .input-gider').select2('destroy');
                $(this).closest('tr').remove();
                updateRowIndexes();
                calculateTotals();
            });

            // OTOMATİK SATIR EKLEME KORUMASI: En son satıra dokunulduğunda yenisi eklenir.
            $(document).on('input change', '#linesBody tr:last-child input, #linesBody tr:last-child select', function() {
                if (currentMode === 'ADD' && !isBindingData) addRow();
            });

            // KURLARI SQL'E (ORTT) KAYDETME
            $('#btnUpdateRates').click(function() {
                const dateVal = $('#RefDate').val();
                if (!dateVal) { toastr.warning("Lütfen kayıt tarihi seçin."); return; }

                const rates = {};
                if ($('#rate_USD').val()) rates['USD'] = parseFloat($('#rate_USD').val());
                if ($('#rate_EUR').val()) rates['EUR'] = parseFloat($('#rate_EUR').val());
                if ($('#rate_GBP').val()) rates['GBP'] = parseFloat($('#rate_GBP').val());
                if ($('#rate_RUB').val()) rates['RUB'] = parseFloat($('#rate_RUB').val());

                if (Object.keys(rates).length === 0) { toastr.warning("Lütfen en az bir kur değeri girin."); return; }

                $('#loadingOverlay').css('display', 'flex');
                $.ajax({
                    url: '/Rapor107/UpdateExchangeRates',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ Date: dateVal, Rates: rates }),
                    success: function(res) {
                        if (res.success) {
                            toastr.success(res.message);
                            fetchRatesAndCalculate(); 
                        } else toastr.error(res.message);
                    },
                    error: function() { toastr.error("Kur güncelleme sırasında hata oluştu."); },
                    complete: function() { $('#loadingOverlay').hide(); }
                });
            });

            // OTOMATİK KDV SATIRI OLUŞTURMA
            $(document).on('change', '.input-vat', function() {
                if (currentMode !== 'ADD') return;
                if (!$('#AutoVAT').is(':checked')) return; 
                
                const vatCode = $(this).val();
                if (!vatCode) return;
                const tr = $(this).closest('tr');
                
                setTimeout(() => {
                    let lcDebit = tutarOku(tr.find('.input-debit'));
                    let lcCredit = tutarOku(tr.find('.input-credit'));
                    let fcDebit = tutarOku(tr.find('.input-fc-debit'));
                    let fcCredit = tutarOku(tr.find('.input-fc-credit'));
                    let fcCur = tr.find('.input-fc-cur').val();

                    if (lcDebit === 0 && lcCredit === 0) return; 

                    $('#loadingOverlay').css('display', 'flex');
                    $.get('/Rapor107/GetVatDetail', { vatCode: vatCode }, function(res) {
                        if (res.success && res.account) {
                            let rate = res.rate || 0;
                            let taxLcDebit = 0, taxLcCredit = 0;
                            let taxFcDebit = 0, taxFcCredit = 0;

                            if (lcDebit > 0) taxLcDebit = (lcDebit * rate / 100);
                            if (lcCredit > 0) taxLcCredit = (lcCredit * rate / 100);
                            if (fcDebit > 0) taxFcDebit = (fcDebit * rate / 100);
                            if (fcCredit > 0) taxFcCredit = (fcCredit * rate / 100);

                            addRow(); 
                            const newRow = $('#linesBody tr:nth-last-child(2)'); 
                            
                            newRow.find('.select-account').val(res.account).trigger('change.select2');
                            
                            if (taxLcDebit > 0) newRow.find('.input-debit').val(tutarYaz(taxLcDebit));
                            if (taxLcCredit > 0) newRow.find('.input-credit').val(tutarYaz(taxLcCredit));
                            
                            if (fcCur) {
                                newRow.find('.input-fc-cur').val(fcCur);
                                if (taxFcDebit > 0) newRow.find('.input-fc-debit').val(tutarYaz(taxFcDebit));
                                if (taxFcCredit > 0) newRow.find('.input-fc-credit').val(tutarYaz(taxFcCredit));
                            }
                            
                            newRow.find('.input-memo').val("Otomatik Vergi (" + vatCode + ")");
                            
                            let sysRate = parseFloat($('#SystemRate').val()) || 0;
                            if (sysRate > 0) {
                                newRow.find('.input-sys-debit').val(tutarYaz(taxLcDebit / sysRate));
                                newRow.find('.input-sys-credit').val(tutarYaz(taxLcCredit / sysRate));
                            }
                            calculateTotals();
                            
                        } else {
                            toastr.warning(res.message || "Vergi detayı alınamadı.");
                        }
                    }).always(function() { $('#loadingOverlay').hide(); });
                }, 100);
            });

            // SAP STANDART B1 YEVMİYE HESAPLAMA
            $(document).on('change', '.calc-trigger, .fc-trigger', function () {
                if (currentMode !== 'ADD') return;
                
                const tr = $(this).closest('tr');
                let isDebit = $(this).hasClass('input-debit') || $(this).hasClass('input-fc-debit');
                let isCredit = $(this).hasClass('input-credit') || $(this).hasClass('input-fc-credit');
                let isLC = $(this).hasClass('input-debit') || $(this).hasClass('input-credit'); 

                if (isLC || $(this).hasClass('input-fc-debit') || $(this).hasClass('input-fc-credit')) {
                    // Kullanici "100 USD" yazarak para birimi secebiliyor.
                    // Tutar kismi virgullu de olabilecegi icin ayirici DEGISTIRILMEZ;
                    // sayiya cevirmeyi tutarOku yapar. (Onceden ilk virgul noktaya
                    // cevriliyordu ve "1.234,56" -> "1.234.56" olup yanlis okunuyordu.)
                    let rawVal = $(this).val().trim().toUpperCase();
                    let match = rawVal.match(/^([0-9.,]+)\s*([A-Z]{3})?$/);

                    if (match && match[2]) {
                        let parsedAmount = tutarOku(match[1]);
                        let typedCur = match[2];

                        if (tr.find(`.input-fc-cur option[value="${typedCur}"]`).length > 0) {
                            tr.find('.input-fc-cur').val(typedCur);

                            if (isDebit) {
                                tr.find('.input-fc-debit').val(tutarYaz(parsedAmount));
                                tr.find('.input-fc-credit').val(tutarYaz(0));
                            } else {
                                tr.find('.input-fc-credit').val(tutarYaz(parsedAmount));
                                tr.find('.input-fc-debit').val(tutarYaz(0));
                            }
                            
                            isLC = false; 
                        } else {
                            toastr.warning(`Geçersiz para birimi kodu girdiniz: ${typedCur}`);
                            $(this).val(tutarYaz(parsedAmount));
                        }
                    } else if (match) {
                        // Duz sayisal giris de tutarOku ile okunur. Onceden parseFloat
                        // kullaniliyordu: "1.500.000" -> 1,50 ve "12345,67" -> 12345,00
                        // oluyordu (buyuk tutarlar "yuvarlaniyor" gibi gorunuyordu).
                        $(this).val(tutarYaz(tutarOku(match[1])));
                    } else {
                        $(this).val(tutarYaz(0));
                    }
                }

                let lcDebit = tutarOku(tr.find('.input-debit'));
                let lcCredit = tutarOku(tr.find('.input-credit'));
                let fcDebit = tutarOku(tr.find('.input-fc-debit'));
                let fcCredit = tutarOku(tr.find('.input-fc-credit'));
                let sysRate = parseFloat($('#SystemRate').val()) || 0;
                let fcCur = tr.find('.input-fc-cur').val();
                let fcRate = (fcCur && systemExchangeRates[fcCur]) ? systemExchangeRates[fcCur] : 1;

                if (isDebit) {
                    tr.find('.input-credit, .input-fc-credit').val(tutarYaz(0));
                    lcCredit = 0; fcCredit = 0;
                } else if (isCredit) {
                    tr.find('.input-debit, .input-fc-debit').val(tutarYaz(0));
                    lcDebit = 0; fcDebit = 0;
                }

                if (isLC) {
                    tr.find('.input-fc-debit, .input-fc-credit').val(tutarYaz(0));
                    tr.find('.input-fc-cur').val(''); 
                    fcDebit = 0; fcCredit = 0;
                } else {
                    if (fcCur && fcRate > 0) {
                        if (isDebit && !isLC) {
                            lcDebit = fcDebit * fcRate;
                            tr.find('.input-debit').val(tutarYaz(lcDebit));
                        } else if (isCredit && !isLC) {
                            lcCredit = fcCredit * fcRate;
                            tr.find('.input-credit').val(tutarYaz(lcCredit));
                        }
                    }
                }

                if (sysRate > 0) {
                    tr.find('.input-sys-debit').val(tutarYaz(lcDebit / sysRate));
                    tr.find('.input-sys-credit').val(tutarYaz(lcCredit / sysRate));
                }

                calculateTotals();
            });

