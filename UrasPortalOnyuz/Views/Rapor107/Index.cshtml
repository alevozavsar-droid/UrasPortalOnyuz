                $('#btnDownloadMahsup').hide();
                $('#btnCancelDocument').hide();
                $('#btnUpdateDoc').hide();
                $('#btnDuplicate').hide();

                $('#btnCancel').text("İptal").removeClass('btn-primary text-white').addClass('btn-light');
                $('#pageTitle').html('<i class="fas fa-book text-warning me-2"></i>Yevmiye Kaydı Oluştur');
                
                currentTransId = 0;
                addRow();
                fetchRatesAndCalculate(); 
                calculateTotals();
            }
        }

        function loadJEDetails(transId) {
            $('#loadingOverlay').css('display', 'flex');
            $.get('/Rapor107/GetJournalEntry', { transId: transId }, function(res) {
                if (res.success && res.data) bindDataToForm(res.data);
                else toastr.error(res.message);
            }).always(function() { $('#loadingOverlay').hide(); });
        }

        window.loadJEDetailsFromModal = function(transId) {
            $('#searchModal').modal('hide');
            loadJEDetails(transId);
        }

        function populateSearchModal(data) {
            let html = '';
            data.forEach(d => {
                html += `
                <tr style="cursor:pointer;" onclick="loadJEDetailsFromModal(${d.transId})">
                    <td class="fw-bold text-primary">${d.transId}</td>
                    <td>${d.number}</td>
                    <td>${d.refDate}</td>
                    <td class="text-truncate" style="max-width: 250px;">${d.memo || ''}</td>
                </tr>`;
            });
            $('#searchResultsBody').html(html);
            $('#searchModal').modal('show');
        }

        function bindDataToForm(je) {
            isBindingData = true;
            
            setFormMode('VIEW');

            currentTransId = je.transId;
            
            if (je.transType !== 30) {
                $('#btnCancelDocument').hide();
                $('#pageTitle').html(`<i class="fas fa-book text-primary me-2"></i>Yevmiye Kaydı (İşlem No: ${je.transId}) <span class="badge bg-warning text-dark ms-2" title="Belge başka bir modülden otomatik oluşmuş.">${je.originName} (İptal Edilemez)</span>`);
            }
            else if (je.isCanceled) {
                $('#btnCancelDocument').hide();
                $('#pageTitle').html(`<i class="fas fa-book text-danger me-2"></i>Yevmiye Kaydı (İşlem No: ${je.transId}) <span class="badge bg-danger ms-2">İPTAL EDİLDİ</span> <span class="badge bg-secondary ms-1">${je.originName}</span>`);
            } else {
                $('#btnCancelDocument').show();
                $('#pageTitle').html(`<i class="fas fa-book text-primary me-2"></i>Yevmiye Kaydı Görüntüle (İşlem No: ${je.transId}) <span class="badge bg-secondary ms-2">${je.originName}</span>`);
            }
            
            // Güncelleme Butonunu her View Mode durumunda göster
            $('#btnUpdateDoc').show();
            
            $('#TransId').val(je.transId); 
            $('#Number').val(je.number);
            $('#RefDate').val(je.refDate); 
            $('#DueDate').val(je.dueDate); 
            $('#TaxDate').val(je.taxDate);
            $('#Memo').val(je.memo); 
            $('#Ref1').val(je.ref1); 
            $('#Ref2').val(je.ref2); 
            $('#Ref3').val(je.ref3);
            
            if(je.transCode) $('#TransCode').val(je.transCode).trigger('change.select2'); 
            else $('#TransCode').val('').trigger('change.select2');
            
            if(je.project) $('#Project').val(je.project).trigger('change.select2');
            else $('#Project').val('').trigger('change.select2');

            $('#Indicator').val(je.indicator); 
            $('#AutoVAT').prop('checked', je.autoVAT);
            
            $('#SystemRate').val(je.systemRate || 1.00);

            $('#U_BE1_AKTAR').val(je.u_BE1_AKTAR); 
            $('#U_BE1_TARGETDOC').val(je.u_BE1_TARGETDOC);
            $('#U_BE1_TARGETTYPE').val(je.u_BE1_TARGETTYPE); 
            $('#U_BE1_KREDITAKSITNO').val(je.u_BE1_KREDITAKSITNO);
            $('#U_BE1_ISTAHAKKUK').val(je.u_BE1_ISTAHAKKUK); 
            $('#U_BE1_FINDOC').val(je.u_BE1_FINDOC);
            $('#U_BE1_FINTIP').val(je.u_BE1_FINTIP); 
            
            if(je.u_BE1_AGENTNUM) {
                if($('#U_BE1_AGENTNUM').find("option[value='" + je.u_BE1_AGENTNUM + "']").length) {
                    $('#U_BE1_AGENTNUM').val(je.u_BE1_AGENTNUM).trigger('change.select2');
                } else { 
                    var newOption = new Option(je.u_BE1_AGENTNUM, je.u_BE1_AGENTNUM, true, true);
                    $('#U_BE1_AGENTNUM').append(newOption).trigger('change');
                } 
            } else $('#U_BE1_AGENTNUM').val('').trigger('change.select2');

            $('#U_BE1_BABSFLAG').val(je.u_BE1_BABSFLAG); 
            $('#U_BE1_TERSKYT').val(je.u_BE1_TERSKYT);
            $('#U_BE1_AKTARMA').val(je.u_BE1_AKTARMA === 'Y' ? 'Y' : 'N');
            $('#U_BE1_BABSKDV').val(je.u_BE1_BABSKDV); 
            $('#U_BE1_KURFARKTRANS').val(je.u_BE1_KURFARKTRANS);
            $('#U_BE1_ISCHECKBOND').val(je.u_BE1_ISCHECKBOND); 
            $('#U_BE1_TRAN_STATUS').val(je.u_BE1_TRAN_STATUS);
            $('#U_BE1_MANUELC').val(je.u_BE1_MANUELC); 
            $('#U_BE1_DOVIZTIPI').val(je.u_BE1_DOVIZTIPI || '-');
            $('#U_BE1_TAHAKKUKKREDINO').val(je.u_BE1_TAHAKKUKKREDINO); 
            $('#U_BE1_TAHAKKUKKREDISATIRNO').val(je.u_BE1_TAHAKKUKKREDISATIRNO);
            $('#U_BE1_TransKind').val(je.u_BE1_TransKind); 
            $('#U_BE1_YEVIPTAL').val(je.u_BE1_YEVIPTAL);

            if(je.u_BE1_IHRDOSNO) {
                if($('#U_BE1_IHRDOSNO').find("option[value='" + je.u_BE1_IHRDOSNO + "']").length) {
                    $('#U_BE1_IHRDOSNO').val(je.u_BE1_IHRDOSNO).trigger('change.select2');
                } else { 
                    var newOption2 = new Option(je.u_BE1_IHRDOSNO, je.u_BE1_IHRDOSNO, true, true);
                    $('#U_BE1_IHRDOSNO').append(newOption2).trigger('change');
                } 
            } else $('#U_BE1_IHRDOSNO').val('').trigger('change.select2');

            $('#U_BE1_TAHSILAT').val(je.u_BE1_TAHSILAT);
            $('#U_BE1_YEVIPTALLOG').val(je.u_BE1_YEVIPTALLOG); 
            $('#U_BE1_DAGIT_HDR').val(je.u_BE1_DAGIT);

            $('#linesBody').empty();
            
            je.lines.forEach((line, index) => {
                addRow();
                
                const tr = $('#linesBody tr').last();
                
                tr.find('.select-account').val(line.accountCode).trigger('change.select2');
                
                tr.find('.input-debit').val(tutarYaz(line.debit));
                tr.find('.input-credit').val(tutarYaz(line.credit));
                tr.find('.input-sys-debit').val(tutarYaz(line.sysDebit));
                tr.find('.input-sys-credit').val(tutarYaz(line.sysCredit));
                tr.find('.input-fc-cur').val(line.fcCurrency || '');
                tr.find('.input-fc-debit').val(tutarYaz(line.fcDebit));
                tr.find('.input-fc-credit').val(tutarYaz(line.fcCredit));
                tr.find('.input-memo').val(line.lineMemo || '');
                tr.find('.input-vat').val(line.taxGroup || '');
                
                tr.find('.input-dagit').val(line.u_BE1_DAGIT || 'N');
                tr.find('.input-chkno').val(line.u_BE1_CHECKNO || '');
                tr.find('.input-chkid').val(line.u_BE1_CHECKID || '');
                tr.find('.input-chkportfoy').val(line.u_BE1_CHECKPORTFOY || '');
                tr.find('.input-chktrnsno').val(line.u_BE1_CHCKTRNSNO || '');
                
                if (line.u_BE1_CHECKDUEDATE) {
                    let dDate = line.u_BE1_CHECKDUEDATE.split('T')[0];
                    tr.find('.input-chkduedate').val(dDate);
                }

                tr.find('.input-mhtanim').val(line.u_BE1_MHTANIM || '');
                tr.find('.input-contraact').val(line.u_BE1_CONTRAACT || '');
                tr.find('.input-giderkodu').val(line.u_GiderKodu || '');
                ggKodSec(tr.find('.input-gider'), line.gider);
                tr.find('.input-plaka').val(line.plaka || '');
                tr.find('.input-sasi').val(line.sasi || '');
            });

            calculateTotals();
            isBindingData = false;
        }

        function addRow() {
            const template = document.getElementById('rowTemplate').innerHTML;
            const $newRow = $(template);
            $('#linesBody').append($newRow);
            
            const headerMemo = $('#Memo').val();
            if(headerMemo) $newRow.find('.input-memo').val(headerMemo);
            
            if(currentMode !== 'ADD') {
                $newRow.find('.req-field-add').prop('required', false);
            }

            $newRow.find('.select-account').select2({ 
                theme: 'bootstrap-5',
                width: '100%',
                dropdownAutoWidth: true
            });
            ggKodSeciciKur($newRow.find('.input-gider'));
            updateRowIndexes();
        }

        // ===================== GİDER / GELİR KODU (Rapor164 kataloğu, satır UDF U_BE1_GIDER) =====================
        // Sayfa açılınca alan yoksa Service Layer ile otomatik açılır; kodlar seçili şirketin ekiyle yüklenir.
        window.GG_KODLAR = []; window.GG_AD = {};
        function ggEsc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;'); }
        function ggKodlariYukle() {
            $.getJSON('/Rapor164/Kodlar', function (res) {
                if (!res || !res.success) { toastr.warning((res && res.message) || 'Gider/gelir kodları alınamadı.'); return; }
                window.GG_KODLAR = res.data || []; window.GG_AD = {};
                window.GG_KODLAR.forEach(function (k) { window.GG_AD[k.kod] = k.ad; window.GG_AD[k.kokKod] = k.ad; });
                if (res.uyari) toastr.warning(res.uyari, '', { timeOut: 12000 });
                $('#linesBody tr .input-gider').each(function () { var v = $(this).val(); ggOptgroups($(this)); ggKodSeciciKur($(this)); if (v) ggKodSec($(this), v); });
            }).fail(function () { toastr.warning('Gider/gelir kod kataloğuna ulaşılamadı.'); });
        }
        function ggOptgroups($sel, tip) {
            if (!$sel.length || $sel.find('optgroup').length || !window.GG_KODLAR.length) return;
            tip = tip || $sel.attr('data-tip') || '';   // satırın hesabına göre: GELIR → yalnızca gelir kodları, GIDER → yalnızca gider kodları (+ teşvik)
            var grp = function (t, ad) { if (tip && t !== tip && t !== 'TIS') return ''; var g = window.GG_KODLAR.filter(function (k) { return k.tip === t; }); if (!g.length) return ''; return '<optgroup label="' + ad + '">' + g.map(function (k) { return '<option value="' + ggEsc(k.kod) + '">' + ggEsc(k.kod) + ' — ' + ggEsc(k.ad) + '</option>'; }).join('') + '</optgroup>'; };
            $sel.append(grp('GIDER', 'GİDER') + grp('GELIR', 'GELİR') + grp('TIS', 'TEŞVİK / İSTİSNA'));
        }
        // Satırın hesabına göre kod listesi: tip GELIR/GIDER → liste daraltılır; hesap 6/7 değilse kod kutusu kapatılır ("kod gerekmez").
        function ggSatirTipiAyarla($tr, tip, hesap) {
            var $sel = $tr.find('.input-gider'); if (!$sel.length) return;
            tip = tip || ''; hesap = hesap || '';
            var mevcut = $sel.val() || '';
            $sel.attr('data-tip', tip).attr('data-hesap', hesap);
            if ($sel.hasClass('select2-hidden-accessible')) $sel.select2('destroy');
            $sel.find('optgroup').remove();
            ggOptgroups($sel, tip);
            var gerekmez = !!hesap && !tip;
            var yerTutucu = gerekmez ? ('kod gerekmez (' + hesap + ')') : (tip === 'GELIR' ? '- gelir kodu seç -' : tip === 'GIDER' ? '- gider kodu seç -' : '- kod seç -');
            $sel.attr('title', hesap ? ('Satırın hesabı ' + hesap + (gerekmez ? ': gider/gelir kodu gerekmez' : (tip === 'GELIR' ? ': GELİR (GLR) kodu zorunlu' : ': GİDER (GDR) kodu zorunlu'))) : 'Gider / gelir kodu');
            if (gerekmez || (mevcut && !$sel.find('option[value="' + mevcut + '"]').length)) mevcut = '';
            $sel.val(mevcut);
            $sel.prop('disabled', gerekmez);
            $sel.select2({ theme: 'bootstrap-5', width: '100%', placeholder: yerTutucu, allowClear: true, dropdownAutoWidth: true });
            if (!mevcut && !gerekmez && window.GG_SABIT && window.GG_SABIT.kod && (!tip || window.GG_SABIT.tip === tip) && (typeof currentMode === 'undefined' || currentMode === 'ADD')) ggKodSec($sel, window.GG_SABIT.kod);
            $tr.find('.btn-gg-sec').prop('disabled', gerekmez);
        }
        function ggKodSeciciKur($sel) {
            if (!$sel.length) return;
            ggOptgroups($sel);
            if (!$sel.hasClass('select2-hidden-accessible')) $sel.select2({ theme: 'bootstrap-5', width: '100%', placeholder: '- kod seç -', allowClear: true, dropdownAutoWidth: true });
        }
        function ggKodSec($sel, kod) {
            kod = (kod || '').trim(); if (!$sel.length) return; ggOptgroups($sel);
            if (kod && !$sel.find('option[value="' + kod + '"]').length) $sel.append(new Option(kod + (window.GG_AD[kod] ? ' — ' + window.GG_AD[kod] : ''), kod));
            $sel.val(kod || '').trigger('change.select2');
        }
        // Hesap seçilince satırın kod listesi hesabın tipine göre daralır (6'lı gelir → gelir kodları, 7'li / (-) 6'lı → gider kodları, diğer → kod gerekmez)
        $('#linesBody').on('change', '.select-account', function () {
            var $tr = $(this).closest('tr'), acct = $(this).val() || '';
            var isBP = $(this).find('option:selected').data('isbp') === true;
            ggSatirTipiAyarla($tr, (acct && !isBP) ? GGSecici.hesapTipi(acct) : '', isBP ? '' : acct);
        });
        $.ajax({ url: '/Rapor107/GiderAlaniniHazirla', type: 'POST' }).done(function (res) {
            if (!res || !res.success) { toastr.warning((res && res.message) || 'Gider alanı kontrol edilemedi.', '', { timeOut: 9000 }); return; }
            if (res.olusturuldu) toastr.info('"Gider / Gelir Kodu" satır alanı (JDT1.U_BE1_GIDER) SAP\'de Service Layer ile otomatik açıldı.', '', { timeOut: 9000 });
        }).always(ggKodlariYukle);
        // ===================== ARAC PLAKASI / SASI NO (satir UDF U_BE1_PLAKA / U_BE1_SASI) =====================
        // Sayfa acilinca alanlar yoksa Service Layer ile acilir; daha once yazilmis plaka/sasi ciftleri listeden secilebilir.
        var aracListesi = [];
        $('body').append('<datalist id="aracPlakaListesi"></datalist><datalist id="aracSasiListesi"></datalist>');
        function aracListesiniYukle() {
            $.getJSON('/Rapor107/AracListesi').done(function (r) {
                aracListesi = (r && r.araclar) || [];
                $('#aracPlakaListesi').html(aracListesi.map(function (a) { return '<option value="' + a.plaka + '">' + (a.sasi ? a.sasi : '') + '</option>'; }).join(''));
                $('#aracSasiListesi').html(aracListesi.filter(function (a) { return a.sasi; }).map(function (a) { return '<option value="' + a.sasi + '">' + a.plaka + '</option>'; }).join(''));
            });
        }
        $.ajax({ url: '/Rapor107/AracAlanlariniHazirla', type: 'POST' }).done(function (res) {
            if (!res || !res.success) { toastr.warning((res && res.message) || 'Ara\u00e7 alanlar\u0131 kontrol edilemedi.', '', { timeOut: 9000 }); return; }
            if (res.olusturulan && res.olusturulan.length) toastr.info('Yevmiye sat\u0131r alanlar\u0131 ' + res.olusturulan.join(', ') + ' SAP\'de Service Layer ile otomatik a\u00e7\u0131ld\u0131.', '', { timeOut: 9000 });
        }).always(aracListesiniYukle);
        // Plaka secilince sasi otomatik dolar (ve tersi); bosluklar temizlenir
        $(document).on('change', '.input-plaka', function () {
            var p = ($(this).val() || '').replace(/\s+/g, '').toUpperCase(); $(this).val(p);
            var $s = $(this).closest('tr').find('.input-sasi');
            if (p && !$s.val()) { var a = aracListesi.find(function (x) { return x.plaka === p; }); if (a && a.sasi) $s.val(a.sasi); }
        });
        $(document).on('change', '.input-sasi', function () {
            var s = ($(this).val() || '').trim().toUpperCase(); $(this).val(s);
            var $p = $(this).closest('tr').find('.input-plaka');
            if (s && !$p.val()) { var a = aracListesi.find(function (x) { return x.sasi === s; }); if (a) $p.val(a.plaka); }
        });

        function updateRowIndexes() {
            $('#linesBody tr').each(function (index) { $(this).find('.row-index').text(index + 1); });
        }

        function resetTotals() {
            $('#totalDebit, #totalCredit').val(tutarYaz(0));
            $('#diffAmount').text('0.00').removeClass('text-danger').addClass('text-success');
        }

        function calculateTotals() {
            let tDebit = 0, tCredit = 0;
            $('#linesBody tr').each(function () {
                tDebit += tutarOku($(this).find('.input-debit'));
                tCredit += tutarOku($(this).find('.input-credit'));
            });

            $('#totalDebit').val(tutarYaz(tDebit));
            $('#totalCredit').val(tutarYaz(tCredit));
            
            const diff = Math.abs(tDebit - tCredit);
            $('#diffAmount').text(diff.toFixed(2));
            if (diff > 0) $('#diffAmount').removeClass('text-success').addClass('text-danger');
            else $('#diffAmount').removeClass('text-danger').addClass('text-success');
        }

        // "Aktarılmasın" alanı bu şirkette yoksa Service Layer ile aç (yalnızca yönetici)
        function aktarmaAlaniniAc(tum) {
            const msg = tum ? 'Alanı olmayan TÜM şirketlerde OJDT.U_BE1_AKTARMA (Evet/Hayır) alanı açılacak. Devam?'
                            : 'Bu şirkette OJDT.U_BE1_AKTARMA (Evet/Hayır) alanı Service Layer ile açılacak. Devam?';
            if (!confirm(msg)) return;
            $('#loadingOverlay').css('display', 'flex');
            $.post('/Rapor107/AktarmaAlaniniAc', { tumSirketler: tum }, function (res) {
                toastr[res.success ? 'success' : 'error'](res.message || (res.success ? 'Alan açıldı.' : 'Alan açılamadı.'), '', { timeOut: 10000 });
                if (res.success) setTimeout(() => window.location.reload(), 1500);
            }).fail(() => toastr.error('Sunucu hatası.')).always(() => $('#loadingOverlay').hide());
        }
        $('#btnAktarmaAlaniAc').click(() => aktarmaAlaniniAc(false));
        $('#btnAktarmaAlaniAcTum').click(() => aktarmaAlaniniAc(true));
    </script>
}