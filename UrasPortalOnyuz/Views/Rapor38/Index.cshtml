@model List<WebApplication3.Models.Rapor2ViewModel>
@using WebApplication3.Models
@using System.Globalization;
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Xsrf

@{
    ViewData["Title"] = "Çek Akıbeti Raporu (Mükerrer/Farklı Kayıtlar)";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 1. KURAL: URL'den veya varsa Cookie'den aktif şirketi okuma (currentDb)
    var currentDb = Context.Request.Query["db"].ToString();
    if (string.IsNullOrEmpty(currentDb))
    {
        currentDb = Context.Request.Cookies["ActiveDb"] ?? "VarsayilanSirket";
    }

    var checkTransactionTypes = (List<CheckTransactionType>)ViewBag.CheckTransactionTypes ?? new List<CheckTransactionType>();

    // Modeldeki veriyi JSON formatına çeviriyoruz.
    var reportDataJson = Model != null ? JsonConvert.SerializeObject(Model, new JsonSerializerSettings { DateFormatString = "yyyy-MM-dd" }) : "[]";
    var checkTransactionTypesJson = JsonConvert.SerializeObject(checkTransactionTypes);

    // Filtereleme için gerekli distinct değerler
    var distinctValues = new Dictionary<string, List<string>>();
    if (Model != null)
    {
        // Yeni Alanlar için distinct değerler
        distinctValues["GelmeNedeni"] = Model.Where(m => !string.IsNullOrEmpty(m.GelmeNedeni)).Select(m => m.GelmeNedeni).Distinct().OrderBy(s => s).ToList();
        distinctValues["SirketAdi"] = Model.Where(m => !string.IsNullOrEmpty(m.SirketAdi)).Select(m => m.SirketAdi).Distinct().OrderBy(s => s).ToList();
        distinctValues["CekinBankasi"] = Model.Where(m => !string.IsNullOrEmpty(m.CekinBankasi)).Select(m => m.CekinBankasi).Distinct().OrderBy(s => s).ToList();

        // Mevcut Alanlar
        distinctValues["CekNumarasi"] = Model.Where(m => !string.IsNullOrEmpty(m.CekNumarasi)).Select(m => m.CekNumarasi).Distinct().OrderBy(s => s).ToList();
        distinctValues["CekKimdenGeldi"] = Model.Where(m => !string.IsNullOrEmpty(m.CekKimdenGeldi)).Select(m => m.CekKimdenGeldi).Distinct().OrderBy(s => s).ToList();
        distinctValues["AsilBorclu"] = Model.Where(m => !string.IsNullOrEmpty(m.AsilBorclu)).Select(m => m.AsilBorclu).Distinct().OrderBy(s => s).ToList();
        distinctValues["Tutar"] = Model.Where(m => m.Tutar.HasValue).Select(m => m.Tutar.Value).Distinct().OrderBy(v => v).Select(v => v.ToString("N2", new CultureInfo("tr-TR"))).ToList();
        distinctValues["ParaBirimi"] = Model.Where(m => !string.IsNullOrEmpty(m.ParaBirimi)).Select(m => m.ParaBirimi).Distinct().OrderBy(s => s).ToList();
        distinctValues["VadeTarihi"] = Model.Where(m => m.VadeTarihi.HasValue).Select(m => m.VadeTarihi.Value.ToString("dd.MM.yyyy")).Distinct().OrderBy(s => DateTime.ParseExact(s, "dd.MM.yyyy", new CultureInfo("tr-TR"))).ToList();
        distinctValues["VadeAyiVeYili"] = Model.Where(m => !string.IsNullOrEmpty(m.VadeAyiVeYili)).Select(m => m.VadeAyiVeYili).Distinct().OrderBy(s => s).ToList();
        distinctValues["PortfoyeGirisTarihi"] = Model.Where(m => m.PortfoyeGirisTarihi.HasValue).Select(m => m.PortfoyeGirisTarihi.Value.ToString("dd.MM.yyyy")).Distinct().OrderBy(s => DateTime.ParseExact(s, "dd.MM.yyyy", new CultureInfo("tr-TR"))).ToList();
        distinctValues["IbrazTarihi"] = Model.Where(m => m.IbrazTarihi.HasValue).Select(m => m.IbrazTarihi.Value.ToString("dd.MM.yyyy")).Distinct().OrderBy(s => DateTime.ParseExact(s, "dd.MM.yyyy", new CultureInfo("tr-TR"))).ToList();
        var distinctTahsilatBelgeNoList = Model.Where(m => !string.IsNullOrEmpty(m.TahsilatBelgeNo)).Select(m => m.TahsilatBelgeNo).Distinct().OrderBy(s => s).ToList(); distinctValues["IbrazBelgeNo"] = Model.Where(m => !string.IsNullOrEmpty(m.IbrazBelgeNo)).Select(m => m.IbrazBelgeNo).Distinct().OrderBy(s => s).ToList();
        distinctValues["HareketDurumu"] = Model.Where(m => !string.IsNullOrEmpty(m.HareketDurumu)).Select(m => m.HareketDurumu).Distinct().OrderBy(s => s).ToList();
        distinctValues["BelgeTipi"] = Model.Where(m => !string.IsNullOrEmpty(m.BelgeTipi)).Select(m => m.BelgeTipi).Distinct().OrderBy(s => s).ToList();
        distinctValues["CekIslemTuru"] = Model.Where(m => !string.IsNullOrEmpty(m.CekIslemTuru)).Select(m => m.CekIslemTuru).Distinct().OrderBy(s => s).ToList();
        distinctValues["IslemTipiAdi"] = Model.Where(m => !string.IsNullOrEmpty(m.IslemTipiAdi)).Select(m => m.IslemTipiAdi).Distinct().OrderBy(s => s).ToList();
        distinctValues["PlanlananTedarikci"] = Model.Where(m => !string.IsNullOrEmpty(m.PlanlananTedarikci)).Select(m => m.PlanlananTedarikci).Distinct().OrderBy(s => s).ToList();
        distinctValues["CekKimeVerildi"] = Model.Where(m => !string.IsNullOrEmpty(m.CekKimeVerildi)).Select(m => m.CekKimeVerildi).Distinct().OrderBy(s => s).ToList();
        distinctValues["TlKarsiligi"] = Model.Where(m => m.TlKarsiligi.HasValue).Select(m => m.TlKarsiligi.Value).Distinct().OrderBy(v => v).Select(v => v.ToString("N2", new CultureInfo("tr-TR"))).ToList();
    }

    // Renk paleti tanımlama (10 farklı renk tonu)
    var colorPalette = new List<string>
    {
        "#ffebee", // Red 50
        "#f3e5f5", // Purple 50
        "#e8eaf6", // Indigo 50
        "#e1f5fe", // Light Blue 50
        "#e8f5e9", // Green 50
        "#fffde7", // Yellow 50
        "#fff3e0", // Orange 50
        "#fbe9e7", // Deep Orange 50
        "#f5f5f5", // Grey 100
        "#eceff1"  // Blue Grey 50
    };
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/css/bootstrap-select.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <style>
        :root {
            --primary-color: #0d6efd;
            --info-color: #0dcaf0;
            --light-bg: #f8f9fa;
            --dark-text: black;
            --border-color: #d0d0d0;
            --header-bg: #212529;
            --header-text: #ffffff;
            --box-shadow-light: 0 0 8px rgba(0, 0, 0, 0.08);
            --box-shadow-medium: 0 2px 3px rgba(0, 0, 0, 0.06);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 12px;
            background-color: var(--light-bg);
            color: var(--dark-text);
        }

        .main-content {
            margin-top: 0 !important;
            padding-top: 0 !important;
            font-size: 1.15em;
            padding: 8px;
            background-color: #ffffff;
            border-radius: 6px;
            box-shadow: var(--box-shadow-light);
            position: relative;
        }

        .container-fluid.py-4 {
            padding-top: 5px;
            padding-bottom: 10px;
            padding-left: 5px;
            padding-right: 5px;
        }

        .database-info {
            background-color: var(--info-color);
            color: #ffffff;
            padding: 4px 8px;
            border-radius: 4px;
            margin-bottom: 6px;
            font-weight: bold;
            display: flex;
            align-items: center;
            font-size: 0.96em;
            line-height: 1.1;
        }

            .database-info .fas {
                margin-right: 4px;
            }

        .sticky-toolbar {
            position: sticky;
            top: 0;
            background-color: #ffffff;
            z-index: 1000;
            padding: 8px 12px;
            border-bottom: 1px solid var(--border-color);
            margin-top: 0px !important;
            margin-bottom: 6px;
            box-shadow: var(--box-shadow-medium);
            display: flex;
            justify-content: flex-end; /* Sadece veritabanı bilgisini göster */
            align-items: center;
            flex-wrap: nowrap;
            gap: 10px;
        }

        .table-container {
            overflow-x: auto;
            position: relative;
            border-radius: 6px;
            box-shadow: var(--box-shadow-medium);
            background-color: #ffffff;
            margin-top: 6px;
            border: 1px solid var(--border-color);
        }

        .rapor-tablo {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 0.84em;
            color: var(--dark-text);
            table-layout: fixed;
            min-width: 2500px; /* Yeni sütunlar için genişletildi */
        }

            .rapor-tablo thead {
                position: sticky;
                top: 0;
                z-index: 101;
                background-color: #ffffff;
            }

                .rapor-tablo thead .main-header-row th {
                    background-color: var(--header-bg);
                    color: var(--header-text);
                    padding: 4px 3px;
                    text-align: center;
                    white-space: nowrap;
                    font-weight: 700;
                    border-bottom: 2px solid var(--border-color);
                    height: auto;
                    line-height: 1.3;
                }

                .rapor-tablo thead .filter-row th {
                    padding: 2px 3px;
                    height: 30px;
                    line-height: normal;
                    vertical-align: top;
                    white-space: nowrap;
                    background-color: #ffffff;
                    border-bottom: 1px solid var(--border-color);
                }

            .rapor-tablo th,
            .rapor-tablo td {
                padding: 1px;
                vertical-align: middle;
                border-right: 1px solid var(--border-color);
            }

                .rapor-tablo th:last-child,
                .rapor-tablo td:last-child {
                    border-right: none;
                }

            .rapor-tablo td {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                height: 25px;
                line-height: 25px;
                border-bottom: 1px solid var(--border-color);
            }

        .table-hover tbody tr:hover {
            background-color: #e9ecef !important;
        }

        .filter-row th .form-control,
        .filter-row th .bootstrap-select .btn {
            width: 100% !important;
            box-sizing: border-box !important;
            height: 28px !important;
            line-height: normal !important;
            padding: 2px 5px !important;
            font-size: 0.85em !important;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
        }

        /* Renk Sınıfları */
        @{
            for (int i = 0; i < colorPalette.Count; i++)
            {
                <text>
                .color-group-@(i) {
                    background-color: @colorPalette[i] !important;
                }
                </text>
            }
        }
        
        /* Mükerrer olmayan ve diğer durumlar için varsayılan arka plan */
        .rapor-tablo tbody tr:not([class*="color-group-"]) {
            background-color: #ffffff;
        }
        
        /* Sadece metin olarak gösterilen hücreler için stil */
        .read-only-cell {
            padding: 4px 6px !important;
            text-align: left;
        }
    </style>
}

