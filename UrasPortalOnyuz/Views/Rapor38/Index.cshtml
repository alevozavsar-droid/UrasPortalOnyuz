                                </th>
                                <th data-column="BelgeTipi">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Belge Tipi">
                                        @if (distinctValues.ContainsKey("BelgeTipi"))
                                        {
                                            foreach (var item in distinctValues["BelgeTipi"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="CekIslemTuru">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Çek İşlem Türü Kodu">
                                        @foreach (var type in checkTransactionTypes.OrderBy(t => t.Description))
                                        {
                                            if (type.Code != "0" && type.Code != "12")
                                            {
                                                <option value="@type.Code">@type.Description</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="IslemTipiAdi">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="İşlem Tipi">
                                        @if (distinctValues.ContainsKey("IslemTipiAdi"))
                                        {
                                            foreach (var item in distinctValues["IslemTipiAdi"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="PlanlananTedarikci">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Planlanan Tedarikçi">
                                        @if (distinctValues.ContainsKey("PlanlananTedarikci"))
                                        {
                                            foreach (var item in distinctValues["PlanlananTedarikci"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="CekKimeVerildi">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Çek Kime Verildi">
                                        @if (distinctValues.ContainsKey("CekKimeVerildi"))
                                        {
                                            foreach (var item in distinctValues["CekKimeVerildi"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="TlKarsiligi">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="TL Karşılığı">
                                        @if (distinctValues.ContainsKey("TlKarsiligi"))
                                        {
                                            foreach (var item in distinctValues["TlKarsiligi"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>

                <div class="row mt-2 d-flex justify-content-between align-items-center">
                    <div class="col-md-4">
                        <div id="pagination-info">
                            Toplam Kayıt: <strong id="totalRecords">@(Model?.Count ?? 0)</strong>
                        </div>
                    </div>
                </div>

                <div class="row mt-4 mb-2">
                    <div class="col-12 text-end">
                        <a href="@Url.Action("Index", "Home", new { db = currentDb })" class="btn btn-outline-secondary fw-bold shadow-sm">
                            <i class="fas fa-arrow-left me-1"></i> Ana Sayfaya Dön
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // --- GÜVENLİK VE AJAX STANDARTLARI (KURAL 1 ve 2) ---
            const currentDb = document.getElementById('currentDb').value;
            const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

            // Tüm jQuery AJAX isteklerine otomatik olarak Token ve db parametresi eklenmesi
            $.ajaxSetup({
                headers: { 'RequestVerificationToken': csrfToken },
                data: { db: currentDb }
            });

            // Fetch API kullanıyorsanız URL sonuna "?db=" eklemek için yardımcı bir fonksiyon
            window.getDbUrl = function(url) {
                const separator = url.includes('?') ? '&' : '?';
                return `${url}${separator}db=${encodeURIComponent(currentDb)}`;
            };
            // ----------------------------------------------------

            const allReportData = @Html.Raw(reportDataJson);
            const table = document.getElementById('rapor2Table');
            const tableBody = table.querySelector('tbody');
            const totalRecordsSpan = document.getElementById('totalRecords');

            // Renk paletini tanımla (CSS'tekiyle aynı olmalı)
            const colorPalette = @Html.Raw(JsonConvert.SerializeObject(colorPalette)); 

            let currentlyFilteredRows = [...allReportData];
            let currentSortColumn = 'GelmeNedeni'; // Varsayılan sıralama GelmeNedeni
            let currentSortDirection = 'asc';

            const columnMappings = {
                'SirketAdi': 'SirketAdi',
                'CekinBankasi': 'CekinBankasi',
                'GelmeNedeni': 'GelmeNedeni',
                'CekNumarasi': 'CekNumarasi',
                'CekKimdenGeldi': 'CekKimdenGeldi',
                'AsilBorclu': 'AsilBorclu',
                'Tutar': 'Tutar',
                'ParaBirimi': 'ParaBirimi',
                'VadeTarihi': 'VadeTarihi',
                'VadeAyiVeYili': 'VadeAyiVeYili',
                'PortfoyeGirisTarihi': 'PortfoyeGirisTarihi',
                'IbrazTarihi': 'IbrazTarihi',
                'TahsilatBelgeNo': 'TahsilatBelgeNo',
                'IbrazBelgeNo': 'IbrazBelgeNo',
                'HareketDurumu': 'HareketDurumu',
                'BelgeTipi': 'BelgeTipi',
                'CekIslemTuru': 'CekIslemTuru',
                'IslemTipiAdi': 'IslemTipiAdi',
                'PlanlananTedarikci': 'PlanlananTedarikci',
                'CekKimeVerildi': 'CekKimeVerildi',
                'TlKarsiligi': 'TlKarsiligi'
            };

            const checkTransactionTypesJs = @Html.Raw(checkTransactionTypesJson);
            const checkTransactionTypeMap = new Map(checkTransactionTypesJs.map(t => [t.Code, t.Description]));

            function updatePaginationInfo(totalCount) {
                const totalRecordsSpan = document.getElementById('totalRecords');
                if (totalRecordsSpan) {
                    totalRecordsSpan.textContent = totalCount;
                }
                const pageLinks = document.getElementById('page-links');
                if (pageLinks) {
                    pageLinks.innerHTML = ''; // Sayfalama bağlantıları kaldırıldı
                }
            }
            
            function renderTable(data) {
                tableBody.innerHTML = '';
                if (data.length === 0) {
                    // Checkbox sütunu kaldırıldığı için colspan 21'e ayarlandı
                    tableBody.innerHTML = '<tr><td colspan="21" class="text-center">Gösterilecek veri bulunamadı.</td></tr>'; 
                    updatePaginationInfo(0);
                    return;
                }
                
                const frag = document.createDocumentFragment();
                
                let colorMap = new Map();
                let currentColorIndex = 0;
                let lastGroupKey = null;

                data.forEach(item => {
                    const row = document.createElement('tr');
                    
                    // Renk atama mantığı: Çek Numarası ve Çekin Bankası bazında gruplama
                    const currentGroupKey = `${item.CekNumarasi}_${item.CekinBankasi}`;
                    let rowClass = '';

                    // Eğer yeni bir gruba geçiliyorsa, rengi değiştir ve haritada sakla
                    if (currentGroupKey !== lastGroupKey) {
                        if (!colorMap.has(currentGroupKey)) {
                            colorMap.set(currentGroupKey, `color-group-${currentColorIndex % colorPalette.length}`);
                            currentColorIndex++;
                        }
                    }
                    
                    // Sadece 'Getirilme Sebebi' doluysa renklendir (yani bir sorun varsa)
                    if (item.GelmeNedeni && !item.GelmeNedeni.includes("Hata") && item.GelmeNedeni !== '3 - Çek No/Banka Aynı (Tüm Değerler Aynı)') {
                        rowClass = colorMap.get(currentGroupKey);
                    }
                    
                    row.className = rowClass;
                    lastGroupKey = currentGroupKey;

                    row.dataset.docentry = item.DocEntry;
                    row.dataset.ibrazBelgeNo = item.IbrazBelgeNo;

                    Object.keys(columnMappings).forEach(columnKey => {
                        const propName = columnMappings[columnKey];

                        const cell = document.createElement('td');
                        cell.dataset.column = columnKey;
                        cell.className = 'read-only-cell'; // Sadece metin gösterileceği için genel sınıf eklendi

                        if (columnKey === 'IbrazBelgeNo' && item.IbrazBelgeNo) {
                            // Link sadece PDF indirme için kalıyor (KURAL 1 URL Güncellemesi yapıldı)
                            const link = document.createElement('a');
                            link.href = window.getDbUrl(`/CekAkibetiRapor38/DownloadAttachment/${item.IbrazBelgeNo}`);
                            link.title = 'Eki Görüntüle';
                            link.target = '_blank';
                            link.textContent = item.IbrazBelgeNo;
                            link.addEventListener('click', (e) => { e.stopPropagation(); });
                            cell.appendChild(link);
                        } else if (columnKey.includes('Tarihi')) {
                            // Tarih formatlama
                            cell.textContent = item[propName] ? new Date(item[propName]).toLocaleDateString('tr-TR') : '';
                        } else if (columnKey === 'Tutar' || columnKey === 'TlKarsiligi') {
                            // Tutar formatlama
                            cell.textContent = item[propName]?.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) ?? '';
                            cell.style.textAlign = 'right';
                        } else if (columnKey === 'CekIslemTuru') {
                            // Sadece kodu gösterir, açıklama değil
                            cell.textContent = item.CekIslemTuru ?? '';
                            cell.title = checkTransactionTypeMap.get(item.CekIslemTuru) || ''; // Tooltip olarak tam açıklama
                        } else {
                            // Diğer tüm alanlar
                            cell.textContent = item[propName] ?? '';
                        }

                        row.appendChild(cell);
                    });

                    frag.appendChild(row);
                });
                tableBody.appendChild(frag);
                updatePaginationInfo(data.length);
            }

            function getInitialColumnConfig() {
                const headers = Array.from(table.querySelectorAll('thead tr:first-child th'));
                return headers.map((header, index) => ({
                    originalIndex: index,
                    newIndex: index,
                    visible: header.style.display !== 'none',
                    columnName: header.dataset.column || 'Unknown'
                }));
            }
            
            function filterTableAndRender() {
                const filters = {};
                $('.filter-select-bs').each(function () {
                    const selectElement = $(this);
                    const columnKey = selectElement.closest('th').data('column');
                    const selectedValues = selectElement.val();
                    if (selectedValues && selectedValues.length > 0) {
                        filters[columnKey] = selectedValues.map(v => (v || '').toLowerCase().trim());
                    }
                });

                let filteredData = allReportData.filter(item => {
                    let isMatch = true;
                    for (const column in filters) {
                        const filterValues = filters[column];
                        const propName = columnMappings[column];
                        if (!propName) continue;

                        let itemValue = item[propName];

                        if (itemValue === null || itemValue === undefined) {
                            itemValue = '';
                        } else if (propName.includes('Tarihi') && itemValue) {
                            const date = new Date(itemValue);
                            itemValue = isNaN(date.getTime()) ? '' : date.toLocaleDateString('tr-TR'); 
                        } else if (typeof itemValue === 'number' || propName === 'Tutar' || propName === 'TlKarsiligi') {
                            itemValue = (itemValue || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        } else if (propName === 'CekIslemTuru') {
                            itemValue = itemValue.toString();
                        } else {
                            itemValue = itemValue.toString();
                        }
                        itemValue = itemValue.toLowerCase().trim();

                        if (filterValues.length > 0 && !filterValues.includes(itemValue)) {
                            isMatch = false;
                            break;
                        }
                    }
                    return isMatch;
                });

                if (currentSortColumn && currentSortDirection !== 'none') {
                    const sortType = document.querySelector(`th[data-column="${currentSortColumn}"]`)?.dataset.sortType;
                    const propName = columnMappings[currentSortColumn];
                    filteredData.sort((itemA, itemB) => {
                        let valA = itemA[propName];
                        let valB = itemB[propName];

                        if (valA === null || valA === undefined) valA = '';
                        if (valB === null || valB === undefined) valB = '';

                        let comparison = 0;
                        if (sortType === 'number') {
                            const numA = parseFloat(valA.toString().replace(/\./g, '').replace(',', '.') || 0);
                            const numB = parseFloat(valB.toString().replace(/\./g, '').replace(',', '.') || 0);
                            comparison = numA - numB;
                        } else if (sortType === 'date') {
                            const dateA = valA ? new Date(valA) : null;
                            const dateB = valB ? new Date(valB) : null;
                            if (dateA === null && dateB === null) comparison = 0;
                            else if (dateA === null) comparison = 1;
                            else if (dateB === null) comparison = -1;
                            else comparison = dateA.getTime() - dateB.getTime();
                        } else {
                            comparison = (valA || '').localeCompare((valB || ''), 'tr', { sensitivity: 'base' });
                        }
                        return currentSortDirection === 'asc' ? comparison : -comparison;
                    });
                }

                currentlyFilteredRows = filteredData;
                renderTable(currentlyFilteredRows);
            }

            function initializePage() {
                window.currentColumnConfig = getInitialColumnConfig();

                $('.filter-select-bs').selectpicker({
                    liveSearch: true,
                    actionsBox: true,
                    selectedTextFormat: 'count > 2',
                    width: '100%',
                    container: 'body'
                }).on('changed.bs.select', function () {
                    filterTableAndRender();
                });

                document.querySelectorAll('th.sortable-column').forEach(header => {
                    header.addEventListener('click', function () {
                        const columnKey = this.dataset.column;
                        if (currentSortColumn === columnKey) {
                            if (currentSortDirection === 'asc') {
                                currentSortDirection = 'desc';
                            } else if (currentSortDirection === 'desc') {
                                currentSortDirection = 'none';
                                currentSortColumn = null;
                            } else {
                                currentSortDirection = 'asc';
                            }
                        } else {
                            if (currentSortColumn !== null) {
                                const prevHeader = document.querySelector(`th.sortable-column[data-column="${currentSortColumn}"] i`);
                                if (prevHeader) {
                                    prevHeader.className = 'fas fa-sort float-end';
                                }
                            }
                            currentSortColumn = columnKey;
                            currentSortDirection = 'asc';
                        }

                        document.querySelectorAll('th.sortable-column i').forEach(icon => icon.className = 'fas fa-sort float-end');

                        const sortIcon = this.querySelector('i');
                        if (sortIcon && currentSortDirection !== 'none') {
                            sortIcon.className = `fas fa-sort-${currentSortDirection === 'asc' ? 'up' : 'down'} float-end`;
                        }

                        filterTableAndRender();
                    });
                });

                const defaultSortHeader = document.querySelector('th.sortable-column[data-column="GelmeNedeni"]');
                if (defaultSortHeader) {
                    const sortIcon = defaultSortHeader.querySelector('i');
                    if (sortIcon) {
                        sortIcon.className = `fas fa-sort-up float-end`;
                    }
                }
                
                if (currentSortColumn) {
                    filterTableAndRender();
                } else {
                    renderTable(allReportData);
                }
            }

            initializePage();
        });
    </script>
}