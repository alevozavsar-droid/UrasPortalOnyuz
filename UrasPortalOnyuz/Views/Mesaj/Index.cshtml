@{
    ViewData["Title"] = "Mesajlar";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string ben = (string)ViewBag.Ben ?? "";
    string ile = (string)ViewBag.Ile ?? "";
}
@section Styles {
    <link rel="stylesheet" href="~/css/mesaj.css" asp-append-version="true" />
}

<div class="msj" data-ben="@ben" data-ile="@ile">
    @Html.AntiForgeryToken()
    <aside class="msj-sol">
        <div class="msj-sol-bas">
            <div class="msj-baslik"><span class="msj-baslik-ic"><i class="fas fa-comment-dots"></i></span> Mesajlar <span class="msj-toplam" id="msjToplam"></span></div>
            <div class="msj-ara"><i class="fas fa-magnifying-glass"></i><input id="msjAra" class="form-control" placeholder="Kişi ara…" autocomplete="off" /></div>
        </div>
        <div class="msj-kisiler" id="msjKisiler"><div class="msj-bos"><i class="fas fa-spinner fa-spin me-1"></i> kişiler yükleniyor…</div></div>
    </aside>

    <section class="msj-sag" id="msjSag">
        <div class="msj-sag-bas" id="msjSagBas">
            <button type="button" class="msj-geri" id="msjGeri" title="Kişilere dön"><i class="fas fa-arrow-left"></i></button>
            <div class="msj-avatar" id="msjAvatar">?</div>
            <div class="msj-kisi-bilgi">
                <div class="msj-kisi-ad" id="msjKisiAd">Bir kişi seçin</div>
                <div class="msj-kisi-kod" id="msjKisiKod">Soldaki listeden sohbet başlatın</div>
            </div>
            <div class="msj-sag-arac">
                <button type="button" class="msj-ikon" id="msjYenile" title="Yenile"><i class="fas fa-rotate"></i></button>
            </div>
        </div>
        <div class="msj-akis" id="msjAkis">
            <div class="msj-hosgeldin">
                <span class="msj-hosgeldin-ic"><i class="fas fa-comments"></i></span>
                <h5>Mesajlaşmaya başla</h5>
                <p>Soldan bir kişi seç. Dosya, görsel ve PDF göndermek için ataç simgesini kullan, sürükleyip bırak ya da panodaki görseli yapıştır.<br /><small>Enter gönderir · Shift+Enter yeni satır</small></p>
            </div>
        </div>
        <div class="msj-birak" id="msjBirak"><i class="fas fa-cloud-arrow-up"></i><div>Dosyayı buraya bırak</div></div>
        <div class="msj-yaz" id="msjYaz" style="display:none;">
            <div class="msj-ekler" id="msjEkler"></div>
            <div class="msj-emoji" id="msjEmoji">
                <div class="msj-emoji-sekme" id="msjEmojiSekme"></div>
                <div class="msj-emoji-izgara" id="msjEmojiIzgara"></div>
            </div>
            <div class="msj-yaz-satir">
                <button type="button" class="msj-ikon" id="msjEmojiBtn" title="Emoji"><i class="far fa-face-smile"></i></button>
                <button type="button" class="msj-ikon" id="msjEkBtn" title="Dosya ekle (görsel, PDF, Office, zip · en çok 25 MB)"><i class="fas fa-paperclip"></i></button>
                <input type="file" id="msjDosya" multiple hidden accept=".jpg,.jpeg,.png,.gif,.webp,.bmp,.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.ppt,.pptx,.zip,.rar,.7z,.xml,.json,.msg,.eml" />
                <textarea id="msjMetin" rows="1" placeholder="Mesaj yazın…"></textarea>
                <button type="button" class="msj-gonder" id="msjGonder" title="Gönder (Enter)"><i class="fas fa-paper-plane"></i></button>
            </div>
        </div>
    </section>
</div>

<!-- Görsel büyütme -->
<div class="msj-buyut" id="msjBuyut"><button type="button" class="msj-buyut-kapat" id="msjBuyutKapat"><i class="fas fa-xmark"></i></button><a id="msjBuyutIndir" class="msj-buyut-indir" href="#" title="İndir"><i class="fas fa-download"></i></a><img id="msjBuyutImg" alt="" /></div>

@section Scripts {
    <script src="~/js/mesaj.js" asp-append-version="true"></script>
}
