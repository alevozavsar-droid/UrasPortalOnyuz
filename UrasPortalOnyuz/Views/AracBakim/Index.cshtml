@{
    ViewData["Title"] = "Araç Bakım ve Onarım Takibi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string onSekme = (string)ViewBag.Sekme ?? "kayitlar";
    string onPlaka = (string)ViewBag.Plaka ?? "";
    string onId = (string)ViewBag.Id ?? "";
    string ben = (string)ViewBag.Ben ?? "";
}
@*
    ARAÇ BAKIM VE ONARIM TAKİBİ — İK ve İdari İşler › İdari İşler › Araç ve Seyahat (Yönetim › Şirket Dökümanları › Araç, Taşınmaz kısayolu). Tüm grup araçları: periyodik bakım, arıza, kaza,
    lastik, akü, fren, klima, kaporta, muayene; servis (yetkili / özel), giriş-çıkış, km, parça ve işçilik kalemleri, KDV, fatura, ödeme, garanti, sonraki bakım (km / tarih), dosyalar (servis fişi,
    fatura PDF). Sekmeler: Bakım Kayıtları · Araçlar (sonraki bakım, muayene, kasko / trafik bitişi, maliyet) · Bakım Takvimi · Maliyet Analizi (araç × ay, tür) · Yeni Kayıt · Günlük.
    Çekmece: süreç (Planlandı → Serviste → Tamamlandı → Faturalandı), bilgiler, kalemler, dosya yükleme, günlük; araç çekmecesi: araç dosyası, bakım geçmişi, km / zimmet güncelleme, sigorta.
    Veri: /AracBakim/Veri (Controllers/AracBakimController.cs, Data/AracBakimOrnek.cs) · betik: wwwroot/js/arac-bakim.js
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<style>
    .na.ab { --na-k: #b45309; }
    .ab-pill { font-size: .66rem; font-weight: 700; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 3px 10px; } a.ab-pill { text-decoration: none; } a.ab-pill:hover { background: #ffedd5; color: #9a3412; border-color: #fed7aa; }
    #ab .na-kpi { grid-template-columns: repeat(8, 1fr); } @@media (max-width: 1400px) { #ab .na-kpi { grid-template-columns: repeat(4, 1fr); } } #ab .na-kpi > div.aktif { outline: 2px solid var(--k, #b45309); outline-offset: -1px; }
    .ab-filtre { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1.6fr auto; gap: 6px 8px; align-items: end; } @@media (max-width: 1300px) { .ab-filtre { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    .ab-filtre label, .ab-form label, .ab-ic label { display: block; font-size: .58rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 2px; }
    .ab-filtre .form-control, .ab-filtre .form-select, .ab-form .form-control, .ab-form .form-select, .ab-ic .form-control, .ab-ic .form-select { font-size: .72rem; padding: 3px 7px; height: 28px; }
    #ab .ab-tablo { font-size: .68rem; table-layout: fixed; width: 100%; }
    #ab .ab-tablo th { font-size: .56rem; padding: 5px 5px; white-space: normal; line-height: 1.15; vertical-align: middle; position: sticky; top: 0; z-index: 3; background: #f8fafc; box-shadow: 0 1px 0 #e2e8f0; }
    #ab .ab-tablo td { padding: 4px 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; vertical-align: middle; line-height: 1.2; border-bottom: 1px solid #e2e8f0; }
    #ab .ab-tablo td.sol { text-align: left !important; } #ab .ab-tablo td.para { font-variant-numeric: tabular-nums; text-align: right !important; font-weight: 700; }
    #ab .ab-tablo td small { display: block; font-size: .56rem; color: #64748b; font-weight: 500; line-height: 1.15; overflow: hidden; text-overflow: ellipsis; }
    #ab .ab-tablo tr.tik { cursor: pointer; } #ab .ab-tablo tr.tik:hover td { background: #fff7ed; }
    #ab .ab-tablo tr.serviste td { background: #fffbeb; } #ab .ab-tablo tr.planli td { background: #eff6ff; } #ab .ab-tablo tr.gec td { background: #fef2f2; } #ab .ab-tablo tr.iptal td { background: #f8fafc; color: #94a3b8; }
    #ab .ab-tablo tr.ara td { background: #f1f5f9; font-weight: 800; border-top: 1px solid #cbd5e1; } #ab .ab-tablo tr.toplam td { font-weight: 800; background: #f8fafc; border-top: 2px solid var(--na-k); }
    .ab-rozet { display: inline-block; font-size: .58rem; font-weight: 800; border-radius: 4px; padding: 1px 6px; white-space: nowrap; } .ab-rozet.ok { background: #dcfce7; color: #166534; } .ab-rozet.uyar { background: #fef3c7; color: #92400e; } .ab-rozet.hata { background: #fee2e2; color: #991b1b; } .ab-rozet.bilgi { background: #dbeafe; color: #1e40af; } .ab-rozet.notr { background: #f1f5f9; color: #475569; } .ab-rozet.mor { background: #ede9fe; color: #5b21b6; }
    .ab-plaka { display: inline-block; font-family: monospace; font-weight: 800; font-size: .66rem; background: #fff; border: 1.5px solid #0f172a; border-left: 6px solid #1d4ed8; border-radius: 4px; padding: 0 5px; white-space: nowrap; }
    .ab-tur { display: inline-block; font-size: .56rem; font-weight: 800; border-radius: 4px; padding: 1px 6px; color: #fff; background: #64748b; white-space: nowrap; } .ab-tur.bakim { background: #0f766e; } .ab-tur.ariza { background: #b45309; } .ab-tur.kaza { background: #be123c; } .ab-tur.lastik { background: #1d4ed8; } .ab-tur.muayene { background: #7c3aed; }
    .ab-surec { display: flex; gap: 2px; align-items: center; } .ab-surec span { font-size: .52rem; font-weight: 700; border-radius: 999px; padding: 1px 6px; background: #f1f5f9; color: #94a3b8; border: 1px solid #e2e8f0; white-space: nowrap; } .ab-surec span.ok { background: #dcfce7; color: #166534; border-color: #bbf7d0; } .ab-surec span.simdi { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; } .ab-surec span.iptal { background: #fee2e2; color: #991b1b; }
    #ab .btn-xs { font-size: .58rem; padding: 1px 6px; line-height: 1.3; }
    .ab-bar { display: inline-block; width: 60px; height: 7px; background: #e2e8f0; border-radius: 999px; overflow: hidden; vertical-align: middle; margin-right: 4px; } .ab-bar i { display: block; height: 100%; background: #16a34a; } .ab-bar i.uyar { background: #d97706; } .ab-bar i.hata { background: #dc2626; }
    /* takvim */
    .ab-takvim { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; } @@media (max-width: 1200px) { .ab-takvim { grid-template-columns: repeat(2, 1fr); } }
    .ab-hafta { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 8px 10px; } .ab-hafta.gecmis { border-color: #fecaca; background: #fef2f2; } .ab-hafta .b { font-size: .72rem; font-weight: 800; color: #0f172a; display: flex; justify-content: space-between; } .ab-hafta ul { list-style: none; margin: 4px 0 0; padding: 0; } .ab-hafta li { font-size: .62rem; padding: 3px 0; border-top: 1px dashed #e2e8f0; cursor: pointer; line-height: 1.2; } .ab-hafta li:hover { background: #f8fafc; } .ab-hafta li small { display: block; color: #64748b; font-size: .56rem; }
    /* çekmece */
    .ab-drawer { position: fixed; top: 0; right: -860px; width: 820px; max-width: 97vw; height: 100vh; background: #fff; box-shadow: -8px 0 24px rgba(15,23,42,.18); z-index: 1060; transition: right .25s; overflow: auto; padding: 12px 14px; } .ab-drawer.acik { right: 0; }
    .main-content #abDrawer { height: 100vh !important; max-height: 100vh !important; overflow: auto !important; }
    .ab-drawer-ust { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; position: sticky; top: 0; background: #fff; padding-bottom: 6px; border-bottom: 1px solid #e2e8f0; z-index: 2; flex-wrap: wrap; }
    .ab-perde { position: fixed; inset: 0; background: rgba(15,23,42,.35); z-index: 1055; display: none; } .ab-perde.acik { display: block; }
    .ab-adimlar { display: flex; } .ab-adimlar > div { flex: 1; text-align: center; font-size: .62rem; font-weight: 700; padding: 6px 4px; background: #f1f5f9; color: #94a3b8; border-right: 2px solid #fff; } .ab-adimlar > div.ok { background: #dcfce7; color: #166534; } .ab-adimlar > div.simdi { background: #b45309; color: #fff; } .ab-adimlar > div small { display: block; font-size: .54rem; font-weight: 500; }
    .ab-ic { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px 8px; align-items: end; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 10px; padding: 8px 10px; } @@media (max-width: 900px) { .ab-ic { grid-template-columns: repeat(2, 1fr); } }
    .ab-form { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 6px 8px; align-items: end; } @@media (max-width: 1200px) { .ab-form { grid-template-columns: repeat(3, minmax(0, 1fr)); } } .ab-form .g2 { grid-column: span 2; } .ab-form .g3 { grid-column: span 3; }
    .ab-kalem { width: 90px; text-align: right; font-size: .7rem; height: 26px; padding: 2px 5px; }
    #ab .ab-maliyet td { text-align: center !important; padding: 3px 4px; } .ab-m { display: block; font-size: .6rem; font-weight: 700; border-radius: 5px; padding: 2px 3px; background: #f1f5f9; color: #334155; cursor: pointer; } .ab-m.var { background: #ffedd5; color: #9a3412; } .ab-m.yuksek { background: #fee2e2; color: #991b1b; } .ab-m.bos { color: #cbd5e1; }
</style>
}

<div class="container-fluid py-3 na ab" id="ab" data-sekme="@onSekme" data-plaka="@onPlaka" data-id="@onId">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-car-wrench"></i></span>Araç Bakım ve Onarım Takibi</h4>
        <span class="ab-pill" id="abKapsam">…</span>
        <a class="ab-pill" href="/Sigorta?sekme=araclar" target="_blank" rel="noopener"><i class="fas fa-shield-halved me-1"></i>Sigorta ve Kasko Poliçeleri</a>
        <a class="ab-pill" href="/SirketDokuman/Varlik" target="_blank" rel="noopener"><i class="fas fa-folder-tree me-1"></i>Araç Ruhsat ve Muayene Belgeleri</a>
        <span class="ab-pill"><i class="fas fa-user me-1"></i>@ben</span>
        <span class="sub w-100">Tüm grup araçlarının bakım ve onarım geçmişi tek yerde: periyodik bakım, arıza, kaza onarımı, lastik, akü, fren, klima, kaporta, muayene. Her kayıtta <b>servis detayı</b> (yetkili / özel servis, giriş-çıkış, km), <b>parça ve işçilik kalemleri</b>, KDV, fatura, ödeme, garanti ve <b>sonraki bakım</b> (km / tarih); servis fişi ve fatura PDF'i yüklenir. Araçlar sekmesinde sonraki bakıma kalan km / gün, muayene ve kasko / trafik bitişi, yıl ve toplam maliyet izlenir; bakımı yaklaşan sarı, geciken kırmızı.</span>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>

    <div class="na-kpi" id="abKpi" data-dinamik="kapali"></div>

    <div class="na-sekme" id="abSekmeler" data-dinamik="kapali">
        <button type="button" data-p="kayitlar" class="aktif"><i class="fas fa-list me-1"></i>Bakım Kayıtları <span class="n" id="abN-kayitlar">0</span></button>
        <button type="button" data-p="araclar"><i class="fas fa-car me-1"></i>Araçlar <span class="n" id="abN-araclar">0</span></button>
        <button type="button" data-p="takvim"><i class="fas fa-calendar-check me-1"></i>Bakım Takvimi <span class="n" id="abN-takvim">0</span></button>
        <button type="button" data-p="maliyet"><i class="fas fa-chart-column me-1"></i>Maliyet Analizi</button>
        <button type="button" data-p="yeni"><i class="fas fa-plus me-1"></i>Yeni Kayıt</button>
        <button type="button" data-p="gunluk"><i class="fas fa-clock-rotate-left me-1"></i>Günlük</button>
    </div>

    <div class="na-panel aktif" data-p="kayitlar">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-list me-1"></i>Bakım ve Onarım Kayıtları</span><span class="not" id="abSayi"></span></div>
            <div class="na-kart-g">
                <div class="ab-filtre">
                    <div><label>Araç</label><select class="form-select" id="abPlakaF"><option value="">Tümü</option></select></div>
                    <div><label>Şirket</label><select class="form-select" id="abSirketF"><option value="">Tümü</option></select></div>
                    <div><label>Tür</label><select class="form-select" id="abTurF"><option value="">Tümü</option></select></div>
                    <div><label>Durum</label><select class="form-select" id="abDurumF"><option value="">Tümü</option><option value="acik">Açık (Planlı · Serviste)</option><option value="Planlandı">Planlandı</option><option value="Serviste">Serviste</option><option value="Tamamlandı">Tamamlandı</option><option value="Faturalandı">Faturalandı</option><option value="İptal">İptal</option></select></div>
                    <div><label>Dönem</label><select class="form-select" id="abDonemF"><option value="">Tümü</option><option value="ay">Bu Ay</option><option value="yil">Bu Yıl</option><option value="12">Son 12 Ay</option></select></div>
                    <div><label>Ara</label><input class="form-control" id="abAra" placeholder="Plaka, servis, kalem, fatura, şikâyet…" autocomplete="off"></div>
                    <div><label>&nbsp;</label><div class="d-flex gap-1"><button type="button" class="btn btn-light border btn-sm py-0" id="abExcel" style="font-size:.66rem;height:28px"><i class="fas fa-file-excel me-1"></i>Excel</button><button type="button" class="btn btn-primary btn-sm py-0" id="abYeniBtn" style="font-size:.66rem;height:28px"><i class="fas fa-plus me-1"></i>Yeni Kayıt</button></div></div>
                </div>
            </div>
            <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:64vh"><table class="na-tablo ab-tablo" id="abTablo" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>

    <div class="na-panel" data-p="araclar">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-car me-1"></i>Araçlar · Sonraki Bakım, Muayene, Sigorta ve Maliyet</span><span class="not">satıra tıklayınca araç dosyası (bakım geçmişi, km / zimmet güncelleme, poliçeler) açılır</span></div>
            <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:64vh"><table class="na-tablo ab-tablo" id="abAracTablo" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>

    <div class="na-panel" data-p="takvim">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-calendar-check me-1"></i>Bakım Takvimi · Planlı Servisler, Yaklaşan Bakımlar ve Muayeneler</span><span class="d-flex gap-2 align-items-center"><span class="not">haftalık · önce gecikenler · tıklayınca kayıt / araç açılır</span><select class="form-select" id="abTakvimGun" style="font-size:.66rem;height:24px;width:auto;padding:2px 20px 2px 6px"><option value="30">30 Gün</option><option value="60" selected>60 Gün</option><option value="90">90 Gün</option></select></span></div>
            <div class="na-kart-g"><div class="ab-takvim" id="abTakvim"></div></div>
        </div>
    </div>

    <div class="na-panel" data-p="maliyet">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-chart-column me-1"></i>Maliyet Analizi · Araç × Ay (Son 12 Ay, KDV Dahil ₺)</span><span class="not">hücreye tıklayınca kayıtlar süzülür · sağda yıl toplamı ve km başına maliyet</span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ab-tablo ab-maliyet" id="abMaliyet" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
        <div class="row g-2"><div class="col-lg-6"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-tags me-1"></i>Tür Dağılımı</span></div><div class="na-kart-g p-0"><table class="na-tablo ab-tablo" id="abTurTablo" data-dinamik="kapali"><thead><tr><th>Tür</th><th class="s">Kayıt</th><th class="s">Tutar (₺)</th><th class="s">Pay</th></tr></thead><tbody></tbody></table></div></div></div><div class="col-lg-6"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-calendar me-1"></i>Aylık Toplam</span></div><div class="na-kart-g p-0"><table class="na-tablo ab-tablo" id="abAyTablo" data-dinamik="kapali"><thead><tr><th>Ay</th><th class="s">Kayıt</th><th class="s">Tutar (₺)</th></tr></thead><tbody></tbody></table></div></div></div></div>
    </div>

    <div class="na-panel" data-p="yeni">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-plus me-1"></i>Yeni Bakım / Onarım Kaydı</span><span class="not">planlı randevu ya da yapılmış işlem; kalemler parça / işçilik / hizmet; periyodik bakımda sonraki bakım otomatik (15.000 km / 12 ay)</span></div>
            <div class="na-kart-g">
                <div class="ab-form">
                    <input type="hidden" id="ynId">
                    <div><label>Araç</label><select class="form-select" id="ynPlaka"></select></div>
                    <div><label>Tür</label><select class="form-select" id="ynTur"></select></div>
                    <div><label>Tarih</label><input type="date" class="form-control" id="ynTarih"></div>
                    <div><label>Km</label><input type="number" class="form-control" id="ynKm"></div>
                    <div><label>Durum</label><select class="form-select" id="ynDurum"><option>Planlandı</option><option>Serviste</option><option>Tamamlandı</option></select></div>
                    <div><label>Ödeme</label><select class="form-select" id="ynOdeme"></select></div>
                    <div class="g2"><label>Servis</label><input class="form-control" id="ynServis" list="ynServisler"><datalist id="ynServisler"></datalist></div>
                    <div><label>Servis Türü</label><select class="form-select" id="ynServisTuru"></select></div>
                    <div><label>Şehir</label><input class="form-control" id="ynSehir"></div>
                    <div><label>Sorumlu</label><input class="form-control" id="ynSorumlu" list="ynSorumlular"><datalist id="ynSorumlular"></datalist></div>
                    <div><label>Hasar Dosyası (Kaza)</label><input class="form-control" id="ynHasar" placeholder="HSR-…"></div>
                    <div class="g3"><label>Şikâyet / Talep</label><input class="form-control" id="ynSikayet"></div>
                    <div class="g3"><label>Yapılan İşlem / Açıklama</label><input class="form-control" id="ynAciklama"></div>
                    <div><label>Sonraki Bakım Km</label><input type="number" class="form-control" id="ynSonrakiKm"></div>
                    <div><label>Sonraki Bakım Tarihi</label><input type="date" class="form-control" id="ynSonrakiTarih"></div>
                    <div><label>Garanti (Ay)</label><input type="number" class="form-control" id="ynGaranti"></div>
                    <div><label>Fatura No</label><input class="form-control" id="ynFatura"></div>
                    <div class="g2"><label>Not</label><input class="form-control" id="ynNot"></div>
                </div>
                <div class="mt-2"><label style="font-size:.58rem;font-weight:700;color:#64748b;text-transform:uppercase">Kalemler · Parça / İşçilik / Hizmet (KDV hariç)</label>
                    <div class="table-responsive"><table class="na-tablo ab-tablo" id="ynKalemTablo" data-dinamik="kapali"><thead><tr><th style="width:46%">Kalem</th><th style="width:12%">Tür</th><th style="width:10%">Miktar</th><th style="width:14%">Birim Fiyat (₺)</th><th style="width:14%">Tutar (₺)</th><th style="width:4%"></th></tr></thead><tbody></tbody><tfoot></tfoot></table></div>
                    <button type="button" class="btn btn-light border btn-sm py-0" id="ynKalemEkle" style="font-size:.66rem"><i class="fas fa-plus me-1"></i>Kalem Ekle</button>
                </div>
                <div class="d-flex gap-2 align-items-center mt-2"><button type="button" class="btn btn-primary btn-sm" id="ynKaydet" style="font-size:.72rem"><i class="fas fa-floppy-disk me-1"></i>Kaydet</button><button type="button" class="btn btn-light border btn-sm" id="ynTemizle" style="font-size:.72rem">Temizle</button><span class="text-muted" style="font-size:.66rem" id="ynOzet"></span></div>
            </div>
        </div>
    </div>

    <div class="na-panel" data-p="gunluk">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-clock-rotate-left me-1"></i>Günlük</span></div>
            <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:64vh"><table class="na-tablo ab-tablo" id="abGunlukTablo" data-dinamik="kapali"><thead></thead><tbody></tbody></table></div></div>
        </div>
    </div>

    <div class="ab-perde" id="abPerde"></div>
    <div class="ab-drawer" id="abDrawer">
        <div class="ab-drawer-ust"><b id="abDBaslik" style="font-size:.88rem"></b><span class="ms-auto"></span><button type="button" class="btn btn-light btn-sm py-0" id="abDKapat" style="font-size:.66rem"><i class="fas fa-xmark"></i></button></div>
        <div id="abDIc"></div>
    </div>
</div>
@section Scripts {
<script src="/js/arac-bakim.js?v=1"></script>
}
