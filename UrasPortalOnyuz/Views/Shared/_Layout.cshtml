        // ---- Sayfa yakinlastirma (kisiye ozel) --------------------------
        // Ust cubuktaki [-] [%100] [+] dugmeleri. Deger once ekrana uygulanir,
        // sonra kisa bir gecikmeyle Z_KullaniciTercih / Zoom'a yazilir.
        // Acik sekmelere (iframe) de ayni anda yansitilir.
        (function () {
            var eksi = document.getElementById('zoomEksiBtn');
            var arti = document.getElementById('zoomArtiBtn');
            var etiket = document.getElementById('zoomSifirlaBtn');
            if (!eksi || !arti || !etiket) return;

            var kademeler = window.ZOOM_KADEMELERI;
            var mevcut = window.SUNUCU_ZOOM;
            var kayitZamanlayici = null;

            function goster() {
                etiket.textContent = mevcut + '%';
                eksi.disabled = kademeler.indexOf(mevcut) <= 0;
                arti.disabled = kademeler.indexOf(mevcut) >= kademeler.length - 1;
            }

            function kaydet() {
                clearTimeout(kayitZamanlayici);
                kayitZamanlayici = setTimeout(function () {
                    var veri = new FormData();
                    veri.append('anahtar', 'Zoom');
                    veri.append('deger', mevcut === 100 ? '' : String(mevcut));
                    fetch('/Home/KullaniciTercihKaydet', { method: 'POST', body: veri })
                        .then(function (r) { return r.json(); })
                        .then(function (c) { if (!c || !c.success) toastr.warning('Yakınlaştırma kaydedilemedi.'); })
                        .catch(function () { toastr.warning('Yakınlaştırma kaydedilemedi.'); });
                }, 500);
            }

            function degistir(yeni) {
                if (kademeler.indexOf(yeni) < 0 || yeni === mevcut) return;
                mevcut = yeni;
                window.SUNUCU_ZOOM = yeni;
                window.zoomUygula(yeni);
                goster();
                kaydet();
                // Acik sekmeler de yeni degere gecsin; cerceve yuksekligi yeniden hesaplansin.
                var cerceveler = document.querySelectorAll('#sekmeCerceveler iframe');
                for (var i = 0; i < cerceveler.length; i++) window.zoomCerceveyeUygula(cerceveler[i]);
                try { window.dispatchEvent(new Event('resize')); } catch (e) { }
            }

            eksi.addEventListener('click', function () { degistir(kademeler[kademeler.indexOf(mevcut) - 1]); });
            arti.addEventListener('click', function () { degistir(kademeler[kademeler.indexOf(mevcut) + 1]); });
            etiket.addEventListener('click', function () { degistir(100); });
            goster();
        })();

        // Tarayici, getBoundingClientRect'i zoom'lu mu zoom'suz mu donduruyor?
        // 100px'lik bir sonda elemanla olculur: 1 = zoom'suz, zoom orani = zoom'lu.
        window.zoomApiOrani = function () {
            try {
                var sonda = document.createElement('div');
                sonda.style.cssText = 'position:absolute;left:-9999px;top:0;width:100px;height:1px;';
                document.body.appendChild(sonda);
                var o = sonda.getBoundingClientRect().width / 100;
                sonda.remove();
                return o || 1;
            } catch (e) { return 1; }
        };

        // Sekme cercevesine zoom uygular. Chrome, kabuktaki zoom'u cerceve
        // icerigine kendiliginden gecirir; boyle bir tarayicida iceriye
        // ayrica zoom verilirse cift buyume olur. Bu yuzden once olculur:
        // cercevenin ic genisligi kabuktaki yerlesim genisligine esitse zoom
        // zaten gecmistir, dokunulmaz; degilse iceriye uygulanir.
        window.zoomCerceveyeUygula = function (f) {
            try {
                var yuzde = window.SUNUCU_ZOOM || 100;
                var oran = yuzde / 100;
                var ic = f.contentWindow;
                if (!ic || !ic.document || !ic.document.documentElement) return;
                if (oran === 1) { window.zoomUygula(100, ic.document); return; }

                // Once icerideki eski zoom kaldirilir ki olcum temiz olsun.
                window.zoomUygula(100, ic.document);

                // Tarayicilar getBoundingClientRect'i zoom'lu ya da zoom'suz
                // dondurebilir; cercevenin yerlesim genisligi (zoom'suz CSS px)
                // olculen orana gore bulunur.
                var apiOran = window.zoomApiOrani();
                var yerlesim = f.getBoundingClientRect().width / apiOran;
                var icGenislik = ic.innerWidth;         // cerceve icinin gordugu genislik
                if (!yerlesim || !icGenislik) return;

                // Zoom iceriye kendiliginden gectiyse ic genislik yerlesime esittir;
                // gecmediyse yerlesim * oran'a esittir. Hangisine yakinsa o.
                var gecmisFark = Math.abs(icGenislik - yerlesim);
                var gecmemisFark = Math.abs(icGenislik - yerlesim * oran);
                if (gecmemisFark < gecmisFark) window.zoomUygula(yuzde, ic.document);
            } catch (e) { /* farkli kaynakli cerceve; dokunulmaz */ }
        };

        $(document).ready(function() {
            const themeToggleBtn = document.getElementById('themeToggleBtn');
            const currentTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', currentTheme);
            updateThemeIcon(currentTheme);

            if (themeToggleBtn) {
                themeToggleBtn.addEventListener('click', () => {
                    let theme = document.documentElement.getAttribute('data-theme');
                    let switchToTheme = theme === 'light' ? 'dark' : 'light';
                    document.documentElement.setAttribute('data-theme', switchToTheme);
                    localStorage.setItem('theme', switchToTheme);
                    updateThemeIcon(switchToTheme);
                });
            }

            function updateThemeIcon(theme) {
                if(!themeToggleBtn) return;
                const icon = themeToggleBtn.querySelector('i');
                if (theme === 'dark') icon.className = 'fas fa-sun text-warning fs-5';
                else icon.className = 'fas fa-moon fs-5';
            }

            const $sidebar = $('#sidebar');
            
            // Grup ERP teması: kenar menü sabit; daralma/genişleme yok (window.KM_SABIT_MENU).
            $sidebar.on('mouseenter', function() { if (window.KM_SABIT_MENU) return; $(this).addClass('expanded'); });
            $sidebar.on('mouseleave', function() {
                if (window.KM_SABIT_MENU) return;
                $(this).removeClass('expanded');
                $('.sidebar-submenu').slideUp(250);
                $('.custom-menu-toggle').removeClass('menu-open');
                // Menü daralınca alttaki şirket seçici (Bootstrap dropdown) de kapanır; açık kalıp boşlukta sarkıyordu.
                $sidebar.find('.dropdown-toggle.show, .dropdown-menu.show').each(function () {
                    var tetik = this.classList.contains('dropdown-menu') ? this.previousElementSibling : this;
                    var dd = tetik && window.bootstrap && bootstrap.Dropdown ? bootstrap.Dropdown.getInstance(tetik) : null;
                    if (dd) dd.hide(); else $(this).removeClass('show');
                });
            });

            $('.custom-menu-toggle').on('click', function(e) {
                e.preventDefault(); e.stopPropagation();
                if (!$sidebar.hasClass('expanded')) $sidebar.addClass('expanded');
                var targetId = $(this).data('target-menu');
                var $target = $('#' + targetId);
                $(this).toggleClass('menu-open');
                $target.slideToggle(250);
            });

            $('#mobile-sidebar-toggle').on('click', function() {
                $sidebar.toggleClass('mobile-open').addClass('expanded');
            });

            let isFullscreen = false;
            // Onay rozeti: 2 dakika sessionStorage'da tutulur, sayfa geçişlerinde tekrar sorulmaz.
            (function () {
                var btn = document.getElementById('onayEkraniBtn'); if (!btn) return;
                function uygula(r) {
                    var rozet = document.getElementById('onayRozet'); if (!rozet || !r || !r.success) return;
                    var n = r.rozet || 0;
                    if (n > 0) { rozet.textContent = n > 99 ? '99+' : n; rozet.style.display = ''; rozet.className = 'badge rounded-pill ' + (r.benim > 0 ? 'bg-danger' : 'bg-secondary') + ' position-absolute'; }
                    else rozet.style.display = 'none';
                    var detay = (r.sirketler || []).map(function (s) { return (s.secili ? '> ' : '') + s.sirket + ': ' + (r.yonetici ? s.havuz : s.benim); }).join('\n');
                    btn.title = 'Onay Ekranı — ' + (r.seciliSirket || '') + ' satıcı faturası bekleyen: ' + n
                              + (r.yonetici ? ' (tüm şirketler: ' + r.toplamHavuz + ')' : (r.toplamBenim > n ? ' (tüm şirketler: ' + r.toplamBenim + ')' : ''))
                              + (detay ? '\n' + detay : '');
                }
                try {
                    var c = sessionStorage.getItem('onayRozet'); var z = sessionStorage.getItem('onayRozetZaman');
                    if (c && z && (Date.now() - parseInt(z, 10)) < 120000) { uygula(JSON.parse(c)); return; }
                } catch (e) { }
                $.getJSON('/OnayEkrani/BekleyenSayisi').done(function (r) {
                    uygula(r);
                    try { sessionStorage.setItem('onayRozet', JSON.stringify(r)); sessionStorage.setItem('onayRozetZaman', String(Date.now())); } catch (e) { }
                });
            })();

            $('#toggleFullscreenBtn').on('click', function() {
