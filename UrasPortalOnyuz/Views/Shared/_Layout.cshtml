    <script>
        // Kisiye ozel vurgu rengi - sayfa boyanmadan ONCE uygulanir ki
        // acilista bir an varsayilan mavi gorunmesin.
        (function () {
            window.VURGU_ANAHTARI = 'vurguRengi_' + '@(User.Identity?.Name ?? "misafir")';

            window.vurguUygula = function (renk) {
                if (!renk) {
                    // Varsayilana don: ezilen degiskenleri kaldir
                    ['--metro-primary', '--metro-primary-dark', '--metro-primary-light',
                     '--sidebar-active-bg', '--sidebar-text-active', '--ring', '--accent-gradient']
                        .forEach(function (d) { document.documentElement.style.removeProperty(d); });
                    return;
                }

                var r = parseInt(renk.substr(1, 2), 16),
                    g = parseInt(renk.substr(3, 2), 16),
                    b = parseInt(renk.substr(5, 2), 16);

                function koyu(k) {
                    return '#' + [r, g, b].map(function (v) {
                        return ('0' + Math.max(0, Math.round(v * k)).toString(16)).slice(-2);
                    }).join('');
                }

                var k = document.documentElement.style;
                k.setProperty('--metro-primary', renk);
                k.setProperty('--metro-primary-dark', koyu(0.82));
                k.setProperty('--metro-primary-light', 'rgba(' + r + ',' + g + ',' + b + ',.10)');
                k.setProperty('--sidebar-active-bg', 'rgba(' + r + ',' + g + ',' + b + ',.12)');
                k.setProperty('--sidebar-text-active', koyu(0.78));
                k.setProperty('--ring', '0 0 0 3px rgba(' + r + ',' + g + ',' + b + ',.22)');
                k.setProperty('--accent-gradient',
                    'linear-gradient(135deg, ' + renk + ' 0%, ' + koyu(0.7) + ' 100%)');
            };

            // Sunucudaki kayit onceliklidir; yoksa tarayici onbellegine bakilir.
            window.SUNUCU_VURGU = '@(kayitliVurguRengi ?? "")';
            try {
                var _r = window.SUNUCU_VURGU || localStorage.getItem(window.VURGU_ANAHTARI);
                if (window.SUNUCU_VURGU) localStorage.setItem(window.VURGU_ANAHTARI, window.SUNUCU_VURGU);
                window.vurguUygula(_r);
            } catch (e) { }
        })();
    </script>
    <!-- ========================================================
         TEMEL KUTUPHANELER (jQuery, Bootstrap, toastr, bootstrap-select,
         SweetAlert2, xlsx) <head> icinde yuklenir.
         Sebep: bazi raporlar (Rapor82, 84, 85, 86, 90, 98, 99, 137, 144 ...)
         script bolumu kullanmayip veri ceken kodu dogrudan sayfa govdesine
         yazar. Kutuphaneler govde sonunda yuklendiginde bu kodlarda $
         tanimsiz kaliyor ve ekran "Yukleniyor"da takiliyordu. Ayrica hicbir
         sayfanin kendi jQuery/Bootstrap kopyasini yuklemesi gerekmez;
         cift yukleme cift modal golgesine yol aciyordu.
         ======================================================== -->
    <!-- SCRIPT YÜKLEME SIRASI (DOĞRULANDI) -->
    <!-- 1. jQuery -->
    <script src="@Url.Content("~/lib/jquery/dist/jquery.min.js")"></script>
    <script src="~/js/mesaj-rozet.js" asp-append-version="true" defer></script>
    <script>
        // =================================================================
        // ZOOM ALTINDA ACILIR LISTE KONUMU DUZELTMESI
        //
        // Sayfa yakinlastirmasi CSS "zoom" ile yapilir. Bu durumda
        // getBoundingClientRect (dolayisiyla jQuery offset) EKRANDAKI olcuyu
        // dondururken, top/left stilleri YERLESIM olcusuyle yazilir. Select2,
        // bootstrap-select (container:'body') ve offset() ile konumlanan diger
        // bilesenler bu yuzden zoom oraninda kayiyordu.
        //
        // Cozum: offset() okumasi, elemanin ekran/yerlesim oranina bolunur.
        // Oran, elemanin kendi rect.width / offsetWidth'inden olculur; boylece
        // tarayici rect'i zoom'lu da dondurse, zoom'suz da dondurse (eski Chrome,
        // zoom'u devralan iframe) sonuc her zaman yerlesim olcusudur.
        // Yazma (offset({top,left})) davranisi degismez.
        // =================================================================
        // Bazi raporlar (54 view) Scripts bolumunde jQuery'yi CDN'den yeniden
        // yukler ve window.jQuery degisir; yama silinmis olur. Bu yuzden yama
        // yeniden uygulanabilir bir fonksiyondur ve Scripts bolumunden sonra
        // bir kez daha cagrilir. Ayni jQuery'ye iki kez uygulanmaz.
        window.zoomOffsetYamasi = function ($) {
            if (!$ || !$.fn || !$.fn.offset || $.fn.offset.zoomYamali) return;
            var orjinal = $.fn.offset;
            var kademeler = [1, 0.6, 0.67, 0.75, 0.8, 0.9, 1.1, 1.25, 1.5];

            function yakinKademe(o) {
                var enYakin = 1, fark = Infinity;
                for (var i = 0; i < kademeler.length; i++) {
                    var f = Math.abs(kademeler[i] - o);
                    if (f < fark) { fark = f; enYakin = kademeler[i]; }
                }
                return enYakin;
            }

            function oran(el) {
                try {
                    // Once olcum: her tarayici modelinde kendi icinde tutarlidir.
                    var g = el.offsetWidth;
                    if (g > 0) return yakinKademe(el.getBoundingClientRect().width / g);
                    // Olculemiyorsa (genisligi 0) tarayicinin bildirdigi zoom, o da yoksa kok stil.
                    if (typeof el.currentCSSZoom === 'number' && el.currentCSSZoom > 0) return el.currentCSSZoom;
                    var kok = el.ownerDocument && el.ownerDocument.documentElement;
                    var z = kok && parseFloat(kok.style.zoom);
                    return z > 0 ? z : 1;
                } catch (e) { return 1; }
            }

            $.fn.offset = function () {
                if (arguments.length) return orjinal.apply(this, arguments);
                var s = orjinal.apply(this, arguments);
                var el = this[0];
                if (!s || !el || el.nodeType !== 1) return s;
                var o = oran(el);
                if (o === 1) return s;
                return { top: s.top / o, left: s.left / o };
            };
            $.fn.offset.zoomYamali = true;
        };
        window.zoomOffsetYamasi(window.jQuery);
    </script>

    <!-- 2. Bootstrap Bundle -->
    <script src="@Url.Content("~/lib/bootstrap/dist/js/bootstrap.bundle.min.js")"></script>
    
