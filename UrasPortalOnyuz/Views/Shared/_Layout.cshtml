                    background: linear-gradient(135deg, #1e1b4b 0%, #b45309 50%, #1e1b4b 100%);
                    background-size: 200% 100%; animation: maintShimmer 6s ease-in-out infinite;
                    color: #ffffff; border-bottom: 1px solid rgba(255,255,255,.18);
                    box-shadow: 0 6px 18px rgba(15,23,42,.22);">
