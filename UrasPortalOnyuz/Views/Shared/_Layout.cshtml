                <button class="icon-btn" id="toggleFullscreenBtn" title="Tam Ekran">
                    <i class="fas fa-expand fs-5"></i>
                </button>
            </div>
        </header>

        <!-- ============================================== -->
        <!-- DİNAMİK SİSTEM GÜNCELLEME DUYURU BANDI (YENİ ŞIK TASARIM) -->
        <!-- ============================================== -->
