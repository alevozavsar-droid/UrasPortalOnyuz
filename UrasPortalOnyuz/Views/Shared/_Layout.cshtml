    </div>

    <div class="page-container" id="page-container">
        <header class="top-header">
            <div class="d-flex align-items-center gap-3">
                <button class="mobile-toggle d-lg-none" id="mobile-sidebar-toggle">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    @* Grup ERP Portalı üst çubuğu: selam + bugünün tarihi (tarih kurumsal-menu.js ile yazılır) *@
                    <div class="km-hi">Merhaba @((displayName ?? "").Split(' ')[0])!</div>
                    <div class="km-date"><span class="on">Bugün</span> <span id="kmTarih"></span></div>
                    @if (!anaSayfada)
                    {
                        <ul class="breadcrumb-modern">
                            <li><span class="text-muted">Ana Sayfa</span></li>
                            <li><i class="fas fa-chevron-right"></i> <span class="active">@ViewData["Title"]</span></li>
                        </ul>
                    }
                </div>
            </div>

            @* Rapor / ekran / modül arama (menü yapısında; "/" tuşu odaklar) *@
            <form class="km-search" id="kmAramaForm" role="search" autocomplete="off">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input id="kmArama" placeholder="Rapor, ekran veya modül ara…" autocomplete="off">
                <kbd>/</kbd>
                <div class="dd" id="kmAramaDd" hidden></div>
            </form>

            <div class="d-flex align-items-center gap-2">
                <!-- GÜVENLİK TOKEN'I HERKES İÇİN BURADA OLMALI -->
                <form id="antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

                <!-- ============================================== -->
                <!-- BAKIM PLANLA VE İMHA ET BUTONLARI (SADECE "A" YETKİLİSİ)-->
                <!-- ============================================== -->
                @* Bakım Planla / Sistemi Kapat düğmeleri Sistem Yetkileri › Sistem İşlemleri sekmesine taşındı
                   (bakimPlaniOlustur / imhaEtProtokolu işlevleri aşağıdaki betikte durur; oradan çağrılır). *@
                <!-- ============================================== -->

                @* Sayfa yakinlastirma: Chrome'daki gibi, kisiye ozel kaydedilir. *@
                <div id="zoomKontrol" title="Yakınlaştırma (size özel kaydedilir)">
                    <button class="icon-btn" id="zoomEksiBtn" title="Uzaklaştır" type="button">
                        <i class="fas fa-minus"></i>
                    </button>
                    <button class="icon-btn" id="zoomSifirlaBtn" title="%100'e dön" type="button">@(kayitliZoom)%</button>
                    <button class="icon-btn" id="zoomArtiBtn" title="Yakınlaştır" type="button">
                        <i class="fas fa-plus"></i>
                    </button>
                    @if (string.Equals(User.Identity?.Name, "it02", StringComparison.OrdinalIgnoreCase))
                    {
                        @* Yalnizca it02: tum kullanicilarin zoom'unu goren/degistiren ekran. *@
                        <button class="icon-btn" id="zoomYonetimBtn" title="Kullanıcı yakınlaştırma yönetimi" type="button"
                                onclick="if (window.portalSekmeAc) { window.portalSekmeAc('Yakınlaştırma Yönetimi', '/Home/ZoomYonetimi'); } else { window.location.href = '/Home/ZoomYonetimi'; }">
                            <i class="fas fa-users-gear"></i>
                        </button>
                    }
                </div>
                <button class="icon-btn" id="themeToggleBtn" title="Açık/Koyu Tema">
                    <i class="fas fa-moon fs-5"></i>
                </button>
                <a class="icon-btn position-relative" id="mesajZili" href="/Mesaj" title="Mesajlar">
                    <i class="fas fa-comment-dots fs-5"></i>
                    <span id="mesajSayaci" class="position-absolute translate-middle badge rounded-pill bg-primary" style="top: 6px; left: 78%; font-size: 9px; display: none;">0</span>
                </a>
                <div class="dropdown">
                    <button class="icon-btn position-relative" id="bildirimZili" title="Bildirimler"
                            data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                        <i class="fas fa-bell fs-5"></i>
                        <span id="bildirimSayaci"
                              class="position-absolute translate-middle badge rounded-pill bg-danger"
                              style="top: 6px; left: 78%; font-size: 9px; display: none;">0</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow border-0 p-0"
                         style="width: 340px; max-height: 420px; overflow-y: auto; border-radius: 14px;"
