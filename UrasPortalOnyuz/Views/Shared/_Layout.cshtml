    <!-- Temel kutuphaneler <head> icine tasindi (bkz. head). -->

    <script>
        // ==========================================
        // İMHA ET BUTONU JAVASCRIPT PROTOKOLÜ
        // ==========================================
        function imhaEtProtokolu() {
            Swal.fire({
                title: 'DİKKAT: SİSTEMİ İMHA EDİYORSUNUZ!',
                text: "Bu işlem sistemi tamamen kapatacak. Arka plandan (sunucudan) app_offline.htm dosyası silinmeden sistem tekrar açılamaz! Devam etmek istediğinize emin misiniz?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Evet, Sistemi Çökert!',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    var token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value;
                    
                    fetch('/Home/ImhaEt', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token,
                            'Content-Type': 'application/json'
                        }
                    })
                    .then(response => {
                        window.location.reload(true); 
                    })
                    .catch(error => {
                        console.error("Hata:", error);
                        window.location.reload(true);
                    });
                }
            });
        }

        // ==========================================
        // BAKIM PLANI OLUŞTURMA (GÜNCELLENDİ: SÜRÜM NOTLARI DESTEKLİ)
        // ==========================================
        // Son bakımdan bu yana yapılan değişiklikleri sunucudan çekip
        // sürüm notları alanına yazar.
        function surumNotlariniOtomatikDoldur(zorla, gun) {
            var alan = document.getElementById('swal-notes');
            var bilgi = document.getElementById('swal-notes-info');
            if (!alan) return;

            if (!zorla && alan.value.trim().length > 0) return;

            if (bilgi) bilgi.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Değişiklikler toplanıyor...';

            var adres = '/Home/SonGuncellemeler' + (gun ? ('?gun=' + gun) : '');

            fetch(adres, { cache: 'no-store' })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (!res.success || !res.notlar || res.notlar.length === 0) {
                        if (bilgi) {
                            bilgi.innerHTML = '<i class="fas fa-circle-info me-1"></i> '
                                + (res.baslangic || '') + ' sonrası (' + (res.temel || '') + ') için değişiklik bulunamadı. '
                                + 'Yandaki listeden daha geniş bir aralık seçebilirsiniz.';
                        }
                        return;
                    }

                    // Sunucu satırları hazır biçimlendirilmiş gönderir ("- Ekran ...", "    • commit")
                    alan.value = res.notlar.join('\n');

                    var kaynakAdi = res.kaynak === 'git' ? 'sürüm geçmişinden' : 'değişen dosyalardan';
                    if (bilgi) {
                        bilgi.innerHTML = '<i class="fas fa-wand-magic-sparkles me-1 text-success"></i> '
                            + res.baslangic + ' sonrası (' + (res.temel || '') + ') değişiklikler '
                            + kaynakAdi + ' derlendi. Düzenleyebilirsiniz.';
                    }
                })
                .catch(function () {
                    if (bilgi) bilgi.innerHTML = '<i class="fas fa-triangle-exclamation me-1 text-warning"></i> Değişiklikler alınamadı, elle yazabilirsiniz.';
                });
        }

        function bakimPlaniOlustur() {
            Swal.fire({
                title: 'Planlı Güncelleme Ayarla',
                didOpen: function () { surumNotlariniOtomatikDoldur(false); },
                html:
                    '<label class="d-block text-start fw-bold mb-1">Saat Seçin:</label>' +
                    '<input id="swal-date" type="datetime-local" class="form-control mb-3" required>' +
                    '<label class="d-block text-start fw-bold mb-1">Duyuru Mesajı:</label>' +
                    '<input id="swal-message" type="text" class="form-control mb-3" value="Sistem Güncellemesi: Yeni versiyon yüklenecektir. Lütfen işlemlerinizi kaydedin.">' +
                    '<div class="d-flex justify-content-between align-items-center mb-1">' +
                        '<label class="fw-bold mb-0">Yapılan Değişiklikler / Sürüm Notları:</label>' +
                        '<div class="d-flex gap-2 align-items-center">' +
                            '<select id="swal-notes-range" class="form-select form-select-sm" style="width:auto;">' +
                                '<option value="0">Son yayından beri</option>' +
                                '<option value="1">Son 1 gün</option>' +
                                '<option value="7">Son 7 gün</option>' +
                                '<option value="30">Son 30 gün</option>' +
                            '</select>' +
                            '<button type="button" class="btn btn-sm btn-light-primary" onclick="surumNotlariniOtomatikDoldur(true, parseInt(document.getElementById(\'swal-notes-range\').value) || 0)">' +
                                '<i class="fas fa-rotate me-1"></i>Otomatik doldur</button>' +
                        '</div>' +
                    '</div>' +
                    '<textarea id="swal-notes" class="form-control" rows="6" placeholder="Örn:&#10;- IT Destek modülü eklendi.&#10;- Rapor 95 şirket seçimi güncellendi."></textarea>' +
                    '<div id="swal-notes-info" class="text-start text-muted mt-2" style="font-size:.78rem;"></div>',
                showCancelButton: true,
                showDenyButton: true,
                confirmButtonText: 'Başlat',
                denyButtonText: 'Bakımı İptal Et',
                cancelButtonText: 'Vazgeç',
                confirmButtonColor: '#3085d6',
                denyButtonColor: '#d33',
                width: '550px'
            }).then((result) => {
                var token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value;
                if (result.isConfirmed) {
                    var dateVal = document.getElementById('swal-date').value;
                    var msgVal = document.getElementById('swal-message').value;
                    var notesVal = document.getElementById('swal-notes').value;
                    if(!dateVal) { toastr.error("Lütfen bir tarih seçin!"); return; }

                    $.post('/Home/SetMaintenance', { 
                        targetTime: dateVal, 
                        message: msgVal, 
                        releaseNotes: notesVal,
                        isActive: true,
                        __RequestVerificationToken: token 
                    }, function(res) {
                        if(res.success) {
                            toastr.success("Bakım planlandı, tüm kullanıcılara bildiriliyor...");
                        }
                    });
                } else if (result.isDenied) {
                    $.post('/Home/SetMaintenance', { 
                        targetTime: "", 
                        message: "", 
                        releaseNotes: "",
                        isActive: false,
                        __RequestVerificationToken: token 
                    }, function(res) {
                        if(res.success) {
                            toastr.success("Bakım planı başarıyla iptal edildi.");
                        }
                    });
                }
            });
        }

        // SIRKET PENCERE / SEKME BAZLIDIR (talep 52).
        //
        // Sayfa hangi sirketle uretildiyse adresine db=X yazilir; ust pencere ya da
        // sekme cercevesi fark etmez. Boylece bu sayfadan cikan her istegin
        // Referer'inda sirket bulunur ve Startup'taki ara katman istegi o sirkete
        // sabitler. Baska bir pencerede sirket degistirilmesi bu sayfayi etkilemez.
        (function () {
            try {
                var u = new URL(window.location.href);
                if (u.searchParams.get('db') === '@selectedDb') return;
                u.searchParams.set('db', '@selectedDb');
                window.history.replaceState(null, '', u.toString());
            } catch (e) { }
        })();
        window.portalSekmeDb = function () {
            try { return new URL(window.location.href).searchParams.get('db') || '@selectedDb'; } catch (e) { return '@selectedDb'; }
        };

        // Her XHR (jQuery dahil) ve fetch istegine sayfanin sirketi X-Selected-Db
        // basligiyla eklenir. Referer gelmese bile sabitleme calisir.
        (function () {
            if (window.XMLHttpRequest) {
                var asilGonder = XMLHttpRequest.prototype.send;
                XMLHttpRequest.prototype.send = function () {
                    try {
                        if (!this.__dbEklendi) { this.setRequestHeader('X-Selected-Db', window.portalSekmeDb()); this.__dbEklendi = true; }
                    } catch (e) { }
                    return asilGonder.apply(this, arguments);
                };
            }
            if (window.fetch) {
                var asilFetch = window.fetch;
                window.fetch = function (kaynak, secenek) {
                    try {
                        var adres = (kaynak && kaynak.url) ? kaynak.url : String(kaynak);
                        var ayniKok = adres.indexOf('/') === 0 || adres.indexOf(window.location.origin) === 0;
                        if (ayniKok) {
                            secenek = secenek || {};
                            var basliklar = new Headers(secenek.headers || (kaynak && kaynak.headers) || undefined);
                            if (!basliklar.has('X-Selected-Db')) basliklar.set('X-Selected-Db', window.portalSekmeDb());
                            secenek.headers = basliklar;
                            return asilFetch.call(this, kaynak, secenek);
                        }
                    } catch (e) { }
                    return asilFetch.apply(this, arguments);
                };
            }
        })();

        @if (cerezGecersiz)
        {
            <text>
            // Gecerli bir sirket cerezi yok (ilk giris): varsayilan olarak bu sayfanin
            // sirketi yazilir. Yalnizca EN UST pencere yazar; sekme cercevesi dokunmaz.
            (function () {
                var cercevede = false;
                try { cercevede = (window.self !== window.top); } catch (e) { cercevede = true; }
                if (cercevede) return;
                document.cookie = "SelectedDatabase=@selectedDb; path=/; max-age=" + (30 * 24 * 60 * 60);
            })();
            </text>
        }

        function changeCompanyDatabase(dbKey, dbAdi) {
            document.cookie = "SelectedDatabase=" + dbKey + "; path=/; max-age=" + (30 * 24 * 60 * 60);

            // SEKME KABUGU ACIKKEN SAYFAYI TERK ETME.
            //
            // Onceden burada her zaman tam sayfa yenileme yapiliyordu. Kabuk
            // genelde ana sayfada durdugu icin kullanici, bir rapor sekmesinde
            // calisirken sirket degistirdiginde ana sayfaya dusuyordu.
            // Artik acik sekmeler yerinde tazeleniyor: cerez yeni sirketle
            // yazildigi icin her cerceve yeni sirketin verisiyle geliyor,
            // kullanici bulundugu sekmede kaliyor.
            // Bu pencerenin sirketi de degisir: adrese yazilir ki sonraki istekler
            // (Referer / X-Selected-Db) yeni sirketle gitsin.
            try {
                var uDeg = new URL(window.location.href);
                uDeg.searchParams.set('db', dbKey);
                window.history.replaceState(null, '', uDeg.toString());
            } catch (e) { }

            if (window.portalSirketTazele && window.portalSirketTazele(dbAdi, dbKey)) return;

            // Tam sayfa yenilemede de filtre parametreleri dusurulur (urlSirketiDegistir ile ayni kural)
            if (typeof urlSirketiDegistir === 'function') { window.location.href = urlSirketiDegistir(window.location.href, dbKey); return; }
            var currentUrl = new URL(window.location.href);
            currentUrl.searchParams.set('db', dbKey);
            window.location.href = currentUrl.toString();
        }
    </script>

    <script>
        // =====================================================================
        // OTURUM DENETIMI (portal geneli)
        // Oturum dustugunde AJAX cagrilari artik 401 doner. Boyle bir cevap
        // gelirse kullaniciyi bilgilendirip giris sayfasina goturuyoruz.
        // Onceden bu durumda ekranda sonsuza kadar donen bir yukleniyor
        // kaliyor, kullanici "veri gelmiyor, takildi" olarak goruyordu.
        // =====================================================================
        (function () {
            var uyariVerildi = false;

            $(document).ajaxError(function (olay, jqXHR) {
                if (jqXHR.status !== 401 && jqXHR.status !== 403) return;
                if (uyariVerildi) return;

                uyariVerildi = true;

                if (jqXHR.status === 403) {
                    alert('Bu işlem için yetkiniz yok.');
                    return;
                }

                alert('Oturumunuz sona ermiş. Giriş sayfasına yönlendiriliyorsunuz.');

                // Sayfa bir sekmenin icinde (iframe) olabilir. O durumda giris
                // ekrani sekmenin icinde acilmamali; en ust pencere yonlendirilir.
                var hedef = '/Account/Login?ReturnUrl='
                          + encodeURIComponent(window.location.pathname + window.location.search);
                try { window.top.location.href = hedef; }
                catch (e) { window.location.href = hedef; }
            });
        })();
    </script>


    <script>
        // ---- Üst bardaki bildirim zili -------------------------------------
        (function () {
            const zil = document.getElementById('bildirimZili');
            const sayac = document.getElementById('bildirimSayaci');
            const liste = document.getElementById('bildirimListesi');
            if (!zil || !liste) return;

            function kacir(m) {
                const d = document.createElement('div');
                d.textContent = m == null ? '' : m;
                return d.innerHTML;
            }

            async function bildirimleriYukle() {
                try {
                    const c = await fetch('/Home/Bildirimler', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!c.ok) return;
                    const v = await c.json();

                    if (v.okunmamis > 0) {
                        sayac.textContent = v.okunmamis > 99 ? '99+' : v.okunmamis;
                        sayac.style.display = '';
                    } else {
                        sayac.style.display = 'none';
                    }

                    if (!v.liste || v.liste.length === 0) {
                        liste.innerHTML = '<div class="text-center text-muted py-4" style="font-size:12px;">Bildirim yok.</div>';
                        return;
                    }

                    liste.innerHTML = v.liste.map(function (b) {
                        const govde =
                            '<div class="fw-semibold" style="font-size:12.5px;">' + kacir(b.baslik) + '</div>' +
                            (b.mesaj ? '<div class="text-muted" style="font-size:11.5px;">' + kacir(b.mesaj) + '</div>' : '') +
                            '<div class="text-muted" style="font-size:10.5px;">' + kacir(b.tarih) + '</div>';
                        const zemin = b.yeni ? 'background:rgba(59,130,246,.06);' : '';
                        return b.link
                            ? '<a href="' + kacir(b.link) + '" class="d-block text-decoration-none text-reset px-3 py-2 border-bottom" style="' + zemin + '">' + govde + '</a>'
                            : '<div class="px-3 py-2 border-bottom" style="' + zemin + '">' + govde + '</div>';
                    }).join('');
                } catch (e) { /* bildirim sessizce atlanir */ }
            }

            // Zil açıldığında okundu sayılır.
            zil.addEventListener('click', function () {
                bildirimleriYukle();
                fetch('/Home/BildirimleriGordum', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                }).then(function () { setTimeout(function () { sayac.style.display = 'none'; }, 400); })
                  .catch(function () { });
            });

            bildirimleriYukle();
            setInterval(bildirimleriYukle, 120000);
        })();

        // =================================================================
        // EKRAN ROZETLERİ (IT #16): menü / favori / dashboard kartlarında,
        // kullanıcının görmediği (başkalarının yaptığı) hareket sayısı.
        // Rozete tıklayınca son hareketler listelenir; ekran açılınca sıfırlanır.
        // =================================================================
        (function () {
            // Sekme (iframe) içindeki sayfalarda menü yoktur; kabuk hesaplar.
            try { if (window.self !== window.top) return; } catch (e) { return; }
            var rozetler = document.querySelectorAll('.menu-rozet[data-controller]');
            if (!rozetler.length) return;
            var SON = {};

            function kacir(m) { var d = document.createElement('div'); d.textContent = m == null ? '' : m; return d.innerHTML; }

            function uygula(veri) {
                var harita = {};
                (veri || []).forEach(function (r) { harita[(r.controller || '').toLowerCase()] = r; });
                SON = harita;
                document.querySelectorAll('.menu-rozet[data-controller]').forEach(function (el) {
                    var r = harita[(el.dataset.controller || '').toLowerCase()];
                    if (r && r.adet > 0) {
                        el.textContent = r.adet > 99 ? '99+' : r.adet;
                        el.title = r.adet + ' görülmemiş hareket · son: ' + (r.sonKullanici || '') + ' ' + (r.sonTarih || '') + (r.sonAciklama ? ' · ' + r.sonAciklama : '');
                        el.hidden = false;
                    } else {
                        el.hidden = true;
                    }
                });
            }

            function yukle() {
                fetch('/Home/EkranRozetleri', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (v) { if (v && v.success) uygula(v.data); })
                    .catch(function () { });
            }

            // Ekran sekmede/sayfada açılınca rozet hemen düşsün (sunucu görüldü işaretini GET'te atar).
            window.ekranRozetSifirla = function (controller) {
                if (!controller) return;
                document.querySelectorAll('.menu-rozet[data-controller="' + controller + '"]').forEach(function (el) { el.hidden = true; });
            };
            document.addEventListener('click', function (e) {
                var a = e.target.closest('a.sidebar-link[href], a.report-card[href]');
                if (!a || e.target.closest('.menu-rozet')) return;
                var m = /^\/([A-Za-z0-9]+)/.exec(a.getAttribute('href') || '');
                if (m) window.ekranRozetSifirla(m[1]);
            });

            // Rozete tıklama: son hareketler penceresi.
            var pop = null;
            function popKapat() { if (pop) { pop.remove(); pop = null; } }
            document.addEventListener('click', function (e) {
                var el = e.target.closest('.menu-rozet[data-controller]');
                if (!el) { if (pop && !e.target.closest('.rozet-popover')) popKapat(); return; }
                e.preventDefault(); e.stopPropagation();
                popKapat();
                var ctrl = el.dataset.controller;
                var ad = (el.closest('a') && el.closest('a').querySelector('.link-text, .card-title')) ? el.closest('a').querySelector('.link-text, .card-title').textContent.trim() : ctrl;
                pop = document.createElement('div');
                pop.className = 'rozet-popover';
                pop.innerHTML = '<div class="bas"><span><i class="fas fa-bell me-1 text-danger"></i>' + kacir(ad) + ' — son hareketler</span><span><button class="btn btn-sm btn-outline-secondary py-0" data-is="gordum" title="Rozeti sıfırla">Gördüm</button> <button class="btn btn-sm btn-light py-0" data-is="kapat">✕</button></span></div><div class="p-3 text-muted">Yükleniyor...</div>';
                document.body.appendChild(pop);
                var r = el.getBoundingClientRect();
                pop.style.top = Math.min(window.innerHeight - 320, r.bottom + 6) + 'px';
                pop.style.left = Math.min(window.innerWidth - 430, Math.max(8, r.left)) + 'px';
                pop.querySelector('[data-is="kapat"]').addEventListener('click', popKapat);
                pop.querySelector('[data-is="gordum"]').addEventListener('click', function () {
                    fetch('/Home/EkranGordum', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' }, body: 'controller=' + encodeURIComponent(ctrl) })
                        .then(function () { window.ekranRozetSifirla(ctrl); popKapat(); }).catch(function () { });
                });
                fetch('/Home/EkranHareketleri?controller=' + encodeURIComponent(ctrl), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (x) { return x.json(); })
                    .then(function (v) {
                        if (!pop) return;
                        var govde = pop.querySelector('.p-3');
                        if (!v.success || !v.data || !v.data.length) { govde.textContent = 'Hareket yok.'; return; }
                        govde.className = '';
                        govde.innerHTML = v.data.map(function (h) {
                            return '<div class="sat"><span class="k">' + kacir(h.kullanici) + '</span> <span>' + kacir(h.aciklama || h.islem) + '</span>' + (h.sirket ? ' <span class="t">· ' + kacir(h.sirket) + '</span>' : '') + '<div class="t">' + kacir(h.tarih) + '</div></div>';
                        }).join('');
                    }).catch(function () { if (pop) pop.querySelector('.p-3').textContent = 'Okunamadı.'; });
            });

            yukle();
            setInterval(yukle, 120000);
        })();
    </script>

