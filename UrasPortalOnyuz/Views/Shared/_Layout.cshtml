    <script>
        (function () {
            // Cerceve icinde (sekme govdesinde) kilavuz gosterilmez.
            try { if (window.self !== window.top) return; } catch (e) { return; }

            var perde = document.getElementById('kilavuzPerde');
            if (!perde) return;

            function bolumSec(ad) {
                document.querySelectorAll('#kilavuzMenu button').forEach(function (b) {
                    b.classList.toggle('secili', b.dataset.bolum === ad);
                });
                document.querySelectorAll('#kilavuzIcerik .bolum').forEach(function (b) {
                    b.classList.toggle('acik', b.dataset.bolum === ad);
                });
                document.getElementById('kilavuzIcerik').scrollTop = 0;
            }

            function ac(bolum) {
                if (bolum) bolumSec(bolum);
                perde.classList.add('acik');
            }
            function kapat() {
                perde.classList.remove('acik');
                try { localStorage.setItem('portalKilavuzu', '1'); } catch (e) { }
            }

            document.querySelectorAll('#kilavuzMenu button').forEach(function (b) {
                b.addEventListener('click', function () { bolumSec(b.dataset.bolum); });
            });

            var dugme = document.getElementById('kilavuzBtn');
            if (dugme) dugme.addEventListener('click', function () { ac(null); });

            document.getElementById('kilavuzKapat').addEventListener('click', kapat);
            document.getElementById('kilavuzTamam').addEventListener('click', kapat);
            perde.addEventListener('click', function (e) { if (e.target === perde) kapat(); });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && perde.classList.contains('acik')) kapat();
            });

            // Kilavuzu hic gormemis kullaniciya bir kez kendiliginden acilir.
            var gorulmus = true;
            try { gorulmus = localStorage.getItem('portalKilavuzu') === '1'; } catch (e) { }
            if (!gorulmus) setTimeout(function () { ac('sekme'); }, 900);

            // Baska ekranlardan cagirmak icin: portalKilavuzAc('tablo')
            window.portalKilavuzAc = ac;
        })();
    </script>

