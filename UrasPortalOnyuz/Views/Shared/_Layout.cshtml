    <!-- SİSTEM İPTAL KONTROLÜ (KILL SWITCH) - OTOMATİK SAYFA YENİLE -->
    <!-- ========================================================== -->
    <script>
        // Sayfa action'larının çoğu [HttpGet] olduğu için doğrudan sayfaya HEAD atmak 405 üretiyordu.
        // Nabız artık hem GET hem HEAD kabul eden hafif /Home/Ping ucuna gidiyor.
        (function () {
            var artArdaHata = 0;

            setInterval(function () {
                fetch('/Home/Ping', { method: 'HEAD', cache: 'no-store' })
                    .then(function (response) {
                        if (response.status === 503) {
                            window.location.reload(true);
                            return;
                        }
                        artArdaHata = 0;
                    })
                    .catch(function () {
                        // Tek seferlik ağ dalgalanmasında sayfayı yenileme; üst üste iki hatada yenile.
                        artArdaHata++;
                        if (artArdaHata >= 2) window.location.reload(true);
                    });
            }, 3000);
        })(); 
    </script>
