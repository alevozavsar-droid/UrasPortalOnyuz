<script>
    // Kisiye ozel vurgu rengi - palet ve kaydetme
    (function () {
        var RENKLER = [
            { ad: 'Mavi',    kod: '#2563eb' },
            { ad: 'Lacivert', kod: '#3b5bdb' },
            { ad: 'Mor',     kod: '#7048e8' },
            { ad: 'Turkuaz', kod: '#0ca678' },
            { ad: 'Yeşil',   kod: '#37b24d' },
            { ad: 'Turuncu', kod: '#f76707' },
            { ad: 'Kırmızı', kod: '#e03131' },
            { ad: 'Gri',     kod: '#5c7cfa' }
        ];

        function secilen() {
            if (window.SUNUCU_VURGU) return window.SUNUCU_VURGU;
            try { return localStorage.getItem(window.VURGU_ANAHTARI); } catch (e) { return null; }
        }

        function kaydet(renk) {
            // Once aninda uygula (bekleme hissi olmasin)
            try {
                if (renk) localStorage.setItem(window.VURGU_ANAHTARI, renk);
                else localStorage.removeItem(window.VURGU_ANAHTARI);
            } catch (e) { }
            window.vurguUygula(renk);
            window.SUNUCU_VURGU = renk || '';
            paletiCiz();

            // Sonra kisiye bagli olarak sunucuya yaz
            var veri = new FormData();
            veri.append('anahtar', 'VurguRengi');
            veri.append('deger', renk || '');

            fetch('/Home/KullaniciTercihKaydet', { method: 'POST', body: veri })
                .then(function (y) { return y.json(); })
                .then(function (s) {
                    if (!s.success && window.toastr) toastr.warning('Renk kaydedilemedi: ' + (s.message || ''));
                })
                .catch(function () {
                    if (window.toastr) toastr.warning('Renk sunucuya kaydedilemedi; yalnızca bu tarayıcıda geçerli.');
                });
        }

        window.vurguSifirla = function () { kaydet(null); };

        function paletiCiz() {
            var kap = document.getElementById('vurguPaleti');
            if (!kap) return;
            var aktif = (secilen() || '').toLowerCase();
            kap.innerHTML = '';
            RENKLER.forEach(function (r) {
                var d = document.createElement('button');
                d.type = 'button';
                d.title = r.ad;
                d.style.cssText = 'width:22px;height:22px;border-radius:50%;cursor:pointer;background:' + r.kod +
                    ';border:2px solid ' + (aktif === r.kod ? 'rgba(15,23,42,.55)' : 'transparent') +
                    ';box-shadow:0 0 0 1px rgba(15,23,42,.12);padding:0;';
                d.onclick = function (e) { e.stopPropagation(); kaydet(r.kod); };
                kap.appendChild(d);
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            paletiCiz();
            var ozel = document.getElementById('vurguOzel');
            if (ozel) {
                ozel.value = secilen() || '#2563eb';
                ozel.addEventListener('input', function () { kaydet(this.value); });
                ozel.addEventListener('click', function (e) { e.stopPropagation(); });
            }
            // Renk secerken menu kapanmasin
            var kap = document.getElementById('vurguPaleti');
            if (kap) kap.addEventListener('click', function (e) { e.stopPropagation(); });
        });
    })();
</script>

