    <script>
        // Sayfa kendi Scripts bolumunde jQuery'yi yeniden yuklediyse zoom
        // offset yamasi yeni jQuery'ye de uygulanir (bkz. jQuery'nin altindaki yama).
        if (window.zoomOffsetYamasi) window.zoomOffsetYamasi(window.jQuery);

        // ---- Kalan modal golgesi (backdrop) temizligi ----------------------
        // Bir modal kapandiginda acik baska modal kalmadiysa ortada kalan
        // .modal-backdrop katmanlari ve body.modal-open sinifi temizlenir.
        // (Eskiden bazi sayfalar Bootstrap'i ikinci kez yukluyordu; ayni dugme
        // iki modal ornegi acip iki golge birakiyordu. Yukleme tekrarlari
        // kaldirildi; bu kod baska bir nedenle golge kalirsa emniyet kemeridir.)
        document.addEventListener('hidden.bs.modal', function () {
            setTimeout(function () {
                if (document.querySelector('.modal.show')) return;
                document.querySelectorAll('.modal-backdrop').forEach(function (b) { b.remove(); });
                document.body.classList.remove('modal-open');
                document.body.style.overflow = '';
                document.body.style.paddingRight = '';
            }, 0);
        });
    </script>

    <script>
        // =================================================================
        // BULANIK / TIKLANAMAZ PENCERE DÜZELTMESİ  (tüm ekranlar)
        //
        // Layout, @@RenderBody()'yi <div class="table-container"> içinde
        // render ediyor. Bu sarmalayıcı (overflow + sayfaların kendi
        // position: relative kuralları) bir yığın bağlamı oluşturuyor ve
        // sayfa gövdesinde tanımlı modal, body'ye eklenen backdrop'un
        // ALTINDA kalıyor: ekran kararıyor/bulanıklaşıyor ama pencere
        // görünmüyor ve tıklanamıyor.
        //
        // Çözüm modali body'ye taşımak. Tek tek 76 ekranı düzeltmek yerine
        // burada bir kez yapılıyor.
        //
        // Form içindeki modallere DOKUNULMAZ: taşınırsa o modaldeki alanlar
        // formdan kopar ve gönderim bozulur.
        // =================================================================
        (function modalleriBodyeTasi() {
            // Bootstrap .modal'ların yanı sıra sayfaların kendi yazdığı tam ekran
            // pencereler de taşınır: "…-modal-bg" sınıflı kaplar (gg-modal-bg,
            // ib-modal-bg vb.) ve "…Overlay" kimlikli örtüler. Aksi halde
            // .table-container içinde kalan pencere kesik / kaydırmalı görünüyor.
            var SECICI = '.modal, [class*="modal-bg"], [id$="Overlay"], [id$="overlay"]';
            function tasi() {
                document.querySelectorAll(SECICI).forEach(function (m) {
                    if (m.parentElement === document.body) return;
                    if (m.closest('form')) return;
                    // Bir modalın İÇİNDEKİ örtü/overlay taşınmaz (closest kendisini de saydığı için üst öğeden bakılır).
                    if (m.parentElement && m.parentElement.closest('.modal')) return;
                    document.body.appendChild(m);
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', tasi);
            } else {
                tasi();
            }
        })();
    </script>

    <script>
        function parseTurkishNumber(numberString) {
            if (!numberString) return 0;
            const cleanedString = numberString.replace(/\./g, '').replace(',', '.');
            return parseFloat(cleanedString) || 0;
        }
        function formatTurkishNumber(n) {
            return Number(n || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        /*
         * TL tutar girişi (talep 68): input type="number" HTML5 spec gereği locale'den bağımsız hep nokta-ondalık
         * kullanır. Bunun yerine type="text" + class="tr-para" verilen alanlar burada otomatik yönetilir:
         * yazarken sadece rakam/virgül (en fazla 2 ondalık hane) kabul edilir, odaklanınca binlik nokta kaldırılıp
         * ham haliyle düzenlenir, odak kaybedilince "1.550,25" biçiminde yeniden biçimlendirilir ve bir "change"
         * olayı tetiklenir (var olan hesap/toplam kodu değişikliği yakalayabilsin diye). Değeri okumak için
         * parseTurkishNumber(el.value) kullanın (input type="number" değil artık, .value her zaman metin).
         */
        (function () {
            function temizle(ham) {
                let v = (ham || '').replace(/[^0-9,]/g, '');
                const ilkVirgul = v.indexOf(',');
                if (ilkVirgul >= 0) v = v.slice(0, ilkVirgul + 1) + v.slice(ilkVirgul + 1).replace(/,/g, '');
                const parcalar = v.split(',');
                if (parcalar.length > 1) v = parcalar[0] + ',' + parcalar[1].substring(0, 2);
                return v;
            }
            document.addEventListener('input', function (e) {
                const el = e.target;
                if (!(el.classList && el.classList.contains('tr-para'))) return;
                const temiz = temizle(el.value);
                if (temiz !== el.value) el.value = temiz;
            }, true);
            document.addEventListener('focusin', function (e) {
                const el = e.target;
                if (!(el.classList && el.classList.contains('tr-para'))) return;
                if (el.value) el.value = el.value.replace(/\./g, '');
            }, true);
            document.addEventListener('focusout', function (e) {
                const el = e.target;
                if (!(el.classList && el.classList.contains('tr-para'))) return;
                const deger = parseTurkishNumber(el.value);
                el.value = (el.value.trim() === '') ? '' : formatTurkishNumber(deger);
                el.dispatchEvent(new Event('change', { bubbles: true }));
            }, true);
        })();

        /*
         * Uras Üretim > Rapor ekranlarının paylaştığı Excel dışa aktarım yardımcısı — kaynaktaki
         * Scripts/RaporOrtak.js'in rp.excel(dosyaAdi, sheets) fonksiyonuyla aynı imza:
         * sheets: [{ ad, kolonlar: [{ k, b }], satirlar }] — k: alan adı veya (satir)=>deger fonksiyonu, b: başlık.
         */
        function raporExcel(dosyaAdi, sheets) {
            if (typeof XLSX === 'undefined') { alert('Excel kütüphanesi yüklenemedi; sayfayı yenileyip tekrar deneyin.'); return; }
            const wb = XLSX.utils.book_new();
            (sheets || []).forEach(function (sh) {
                const aoa = [sh.kolonlar.map(k => k.b)];
                (sh.satirlar || []).forEach(function (r) {
                    aoa.push(sh.kolonlar.map(function (k) {
                        const v = typeof k.k === 'function' ? k.k(r) : r[k.k];
                        return (v === null || v === undefined) ? '' : v;
                    }));
                });
                const ws = XLSX.utils.aoa_to_sheet(aoa);
                ws['!cols'] = sh.kolonlar.map(k => ({ wch: Math.max(10, Math.min(45, (k.b || '').length + 6)) }));
                XLSX.utils.book_append_sheet(wb, ws, (sh.ad || 'Rapor').substring(0, 31));
            });
            XLSX.writeFile(wb, dosyaAdi + '.xlsx');
        }

        /*
         * Uras Üretim > Kalite ekranlarının paylaştığı PDF dışa aktarım yardımcısı (html2pdf.js gerekir,
         * her ekran kendi CDN script'ini yükler). Kaynaktaki downloadPDFRender ile aynı mantık: ekrandaki
         * form alanını (elementId) olduğu gibi (input değerleriyle) yakalayıp A4 yatay PDF olarak indirir.
         */
        function htmlToPdfIndir(elementId, dosyaAdi, secenekler) {
            if (typeof html2pdf === 'undefined') { alert('PDF kütüphanesi yüklenemedi; sayfayı yenileyip tekrar deneyin.'); return; }
            const el = document.getElementById(elementId);
            if (!el) { alert('PDF alanı bulunamadı.'); return; }
            const opt = Object.assign({
                margin: [5, 5, 5, 5],
                filename: dosyaAdi + '.pdf',
                image: { type: 'jpeg', quality: 1.0 },
                html2canvas: { scale: 2, useCORS: true, logging: false, scrollY: 0, scrollX: 0 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape', compress: true },
                pagebreak: { mode: ['css', 'legacy'] }
            }, secenekler || {});
            html2pdf().set(opt).from(el).save();
        }

