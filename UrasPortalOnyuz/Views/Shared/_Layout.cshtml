    <!-- 5. Bootstrap Select Türkçe Dil Dosyası (JS'den Sonra Olmalı) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/js/i18n/defaults-tr_TR.min.js"></script>
    
