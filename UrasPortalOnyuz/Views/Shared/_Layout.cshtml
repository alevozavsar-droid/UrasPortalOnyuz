                @* Sekme kabugunu isteyen kapatabilsin (kisiye bagli tercih). *@
                <button class="icon-btn" id="sekmeModuBtn"
                        title="@(sekmeKapali ? "Sekmeli görünümü aç" : "Sekmeli görünümü kapat")"
                        data-kapali="@(sekmeKapali ? "1" : "0")">
                    <i class="fas @(sekmeKapali ? "fa-window-restore" : "fa-window-maximize") fs-5"></i>
                </button>
