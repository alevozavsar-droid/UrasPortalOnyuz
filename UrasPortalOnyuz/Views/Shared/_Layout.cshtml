    <script>
    // =====================================================================
    // SEKME KABUGU (talep 35)
    //
    // Portal cok sayfali (her rapor ayri bir sayfa). Sekme mantigi, acilan
    // sayfalari ayni kabuk icinde iframe olarak tutarak saglanir:
    //   - Menuden tiklanan sayfa gezinmek yerine yeni bir sekmede acilir
    //   - Sekmeler ust cubukta, kucultulenler alt gorev cubugunda durur
    //   - Acik sekmeler tarayici yenilense de geri gelir (localStorage)
    //
    // Sekmenin icindeki sayfa "_sekme=1" ile yuklenir; o modda menu ve ust
    // baslik gizlenir, yalnizca sayfanin kendi govdesi cizilir.
    // =====================================================================
    (function () {
        // Kabuk YALNIZCA en ust pencerede calisir.
        //
        // Sekmenin icinde bir baglantiya tiklandiginda yeni istekte "_sekme"
        // parametresi olmadigi icin bu betik cerceve icinde de yuklenebiliyor;
        // o durumda kayitli sekmeleri yeniden acip ic ice cerceve yigini
        // olusturuyordu. Cerceve icindeysek hicbir sey yapilmaz.
        try { if (window.self !== window.top) return; } catch (e) { return; }

        var ANAHTAR = 'portalSekmeler';

        // Kullanicinin yetkili oldugu sirketler; bir sekmeyi baska sirkette
        // kopyalamak icin kullanilir.
        var SIRKETLER = [
@foreach (var db in allowedDatabases)
{
            <text>            { anahtar: '@db.DbKey', ad: '@db.Display' },
</text>
}
        ];

        var cubuk    = document.getElementById('sekmeCubugu');
        var kapsayan = document.getElementById('sekmeCerceveler');
        var gorevler = document.getElementById('gorevCubugu');
        var ana      = document.getElementById('sekmeAna');
        if (!cubuk || !kapsayan || !ana) return;

        function kacir(m) {
            var d = document.createElement('div');
            d.textContent = m == null ? '' : m;
            return d.innerHTML;
        }

        // Bu sayfanin kendisi 0 numarali, kapatilamayan sekmedir.
        var aktifBag = document.querySelector('.sidebar-link.active .link-text');
        var anaBaslik = (aktifBag ? aktifBag.textContent : (document.title || 'Ana Sayfa'));
        anaBaslik = anaBaslik.trim().substring(0, 40);

        var sekmeler = [];   // { id, ad, url, kucuk }
        var aktifId  = 0;
        var sayac    = 0;

        function kaydet() {
            try {
                var aktif = sekmeler.filter(function (t) { return t.id === aktifId; })[0];
                localStorage.setItem(ANAHTAR, JSON.stringify({
                    // Aktif sekmenin ADRESI de saklanir. Aksi hâlde sayfa her
                    // yenilendiginde (ornegin sirket degistirince) kullanici
                    // acik sekmesinden kopup dashboard'a dusuyordu.
                    aktifUrl: aktif ? aktif.url : null,
                    liste: sekmeler.map(function (t) { return { ad: t.ad, url: t.url, kucuk: t.kucuk }; })
                }));
            } catch (e) { /* depolama kapaliysa sekmeler yalnizca bu sayfada yasar */ }
        }

        function oku() {
            try {
                var ham = JSON.parse(localStorage.getItem(ANAHTAR) || 'null');
                if (!ham) return { aktifUrl: null, liste: [] };
                // Eski surumde dogrudan dizi saklaniyordu; o bicim de okunur.
                if (Array.isArray(ham)) return { aktifUrl: null, liste: ham };
                return { aktifUrl: ham.aktifUrl || null, liste: ham.liste || [] };
            } catch (e) { return { aktifUrl: null, liste: [] }; }
        }

        function yukseklikAyarla() {
            // Kabuk zoom'luyken innerHeight zoom'suz, yerlesim olculeri ise
            // zoom'ludur. Gorunen (ekrandaki) degerler uzerinden hesaplanip
            // sonuc zoom'a bolunur; boylece cerceve ekrana tam oturur.
            var oran = (window.SUNUCU_ZOOM || 100) / 100;
            var apiOran = window.zoomApiOrani ? window.zoomApiOrani() : oran;
            var ust = kapsayan.getBoundingClientRect().top * oran / apiOran;
            var alt = ((gorevler && gorevler.classList.contains('acik')) ? 44 : 0) * oran;
            // Kapsayici kabuk dolgusundan disari tastigi icin alt bosluk birakilmaz;
            // 2px yalnizca gereksiz kaydirma cubugunu onlemek icin.
            var h = Math.max(320, (window.innerHeight - ust - alt - 2) / oran);
            var cerceveler = kapsayan.querySelectorAll('iframe');
            for (var i = 0; i < cerceveler.length; i++) cerceveler[i].style.height = h + 'px';
        }

        // Adresinde db olan sekme baska bir sirkete sabitlenmistir; sirketin adini dondurur.
        function sabitSirket(url) {
            var m = /[?&]db=([^&#]+)/.exec(url || '');
            if (!m) return '';
            var anahtar = decodeURIComponent(m[1]);
            var s = (typeof SIRKETLER !== 'undefined' ? SIRKETLER : []).filter(function (x) { return x.anahtar === anahtar; })[0];
            return s ? s.ad : anahtar;
        }

        function ciz() {
            var h = '<div class="sekme' + (aktifId === 0 ? ' aktif' : '') + '" data-id="0">'
                  + '<i class="fas fa-home"></i><span class="ad">' + kacir(anaBaslik) + '</span></div>';

            sekmeler.forEach(function (t) {
                if (t.kucuk) return;
                var sabitDb = sabitSirket(t.url);
                h += '<div class="sekme' + (aktifId === t.id ? ' aktif' : '')
                   + (mesgulSekmeler[t.id] ? ' mesgul' : '') + (sabitDb ? ' sabit' : '') + '" data-id="' + t.id + '"'
                   + (sabitDb ? ' title="Bu sekme ' + kacir(sabitDb) + ' şirketine sabit; üstteki şirket değişse de değişmez"' : '') + '>'
                   + '<span class="donen"></span>'
                   + (sabitDb ? '<i class="fas fa-thumbtack sabit-ikon"></i>' : '')
                   + '<span class="ad">' + kacir(t.ad) + '</span>'
                   + '<button class="dugme" data-is="yenile" title="Bu sekmeyi yenile">&#8635;</button>'
                   + '<button class="dugme" data-is="kopyala" title="Başka şirkette kopyala">&#10697;</button>'
                   + '<button class="dugme" data-is="kucult" title="Alta indir">&#8211;</button>'
                   + '<button class="dugme" data-is="kapat" title="Kapat">&times;</button>'
                   + '</div>';
            });
            cubuk.innerHTML = h;

            var kucukler = sekmeler.filter(function (t) { return t.kucuk; });
            if (gorevler) {
                gorevler.classList.toggle('acik', kucukler.length > 0);
                document.body.classList.toggle('gorev-cubugu-acik', kucukler.length > 0);
                gorevler.innerHTML = '<span class="baslik">KUCULTULENLER</span>' + kucukler.map(function (t) {
                    return '<div class="gorev' + (mesgulSekmeler[t.id] ? ' mesgul' : '') + (sabitSirket(t.url) ? ' sabit' : '') + '" data-id="' + t.id + '">'
                         + '<span class="donen"></span>'
                         + '<i class="fas ' + (sabitSirket(t.url) ? 'fa-thumbtack' : 'fa-window-maximize') + '"></i><span class="ad">' + kacir(t.ad) + '</span>'
                         + '<button class="dugme" data-is="yenile" title="Bu sekmeyi yenile">&#8635;</button></div>';
                }).join('');
            }

            ana.style.display = (aktifId === 0) ? '' : 'none';
            sekmeler.forEach(function (t) {
                var f = document.getElementById('cerceve_' + t.id);
                if (f) f.style.display = (aktifId === t.id && !t.kucuk) ? 'block' : 'none';
            });

            yukseklikAyarla();
        }

        // ---- SEKME MESGULIYETI ----------------------------------------
        //
        // Sekmenin icindeki sayfa yuklenirken ya da veri cekerken sekme
        // basliginda donen bir halka gosterilir; boylece butona basildiginda
        // bir sey olup olmadigi anlasilir. Cerceve icindeki sayfa durumunu
        // postMessage ile bildirir (asagidaki "cerceve habercisi" betigi).
        var mesgulSekmeler = {};

        function mesgulIsaretle(id, durum) {
            if (durum) mesgulSekmeler[id] = true; else delete mesgulSekmeler[id];

            var sekmeEl = cubuk ? cubuk.querySelector('.sekme[data-id="' + id + '"]') : null;
            if (sekmeEl) sekmeEl.classList.toggle('mesgul', !!durum);

            var gorevEl = gorevler ? gorevler.querySelector('.gorev[data-id="' + id + '"]') : null;
            if (gorevEl) gorevEl.classList.toggle('mesgul', !!durum);
        }

        function cerceveninSekmesi(pencere) {
            for (var i = 0; i < sekmeler.length; i++) {
                var f = document.getElementById('cerceve_' + sekmeler[i].id);
                if (f && f.contentWindow === pencere) return sekmeler[i].id;
            }
            return null;
        }

        window.addEventListener('message', function (olay) {
            var v = olay.data;
            if (!v || v.kaynak !== 'portal') return;

            var id = cerceveninSekmesi(olay.source);
            if (id === null) return;

            if (v.tip === 'mesgul') {
                mesgulIsaretle(id, !!v.durum);
                return;
            }

            if (v.tip === 'hata') {
                // Sekme icindeki sayfada JS hatasi olustu. Bu hata sessizce
                // dugmeleri calismaz hale getirebilir; gorunur kilinir.
                mesgulIsaretle(id, false);
                var t = sekmeler.filter(function (x) { return x.id === id; })[0];
                var ad = t ? t.ad : ('Sekme ' + id);
                console.error('[Sekme hatası] ' + ad, v);
                if (window.toastr) {
                    toastr.error(
                        '<b>' + ad + '</b> sekmesinde betik hatası:<br>' + (v.mesaj || '') +
                        (v.dosya ? '<br><span style="font-size:11px;">' + v.dosya + ':' + (v.satir || '?') + '</span>' : ''),
                        '', { timeOut: 15000, enableHtml: true });
                }
            }
        });

        // ---- TEK SEKMEYI YENILE ----------------------------------------
        //
        // Yalnizca ilgili cerceve yeniden yuklenir; diger sekmeler ve icerideki
        // durumlari etkilenmez. Cerceve icinde suzgec uygulanmis olabilecegi
        // icin once BULUNULAN adres yenilenir (filtreler korunur); bu mumkun
        // degilse sekmenin acilis adresine donulur.
        function sekmeyiYenile(id) {
            var f = document.getElementById('cerceve_' + id);
            if (!f) return;

            var t = sekmeler.filter(function (x) { return x.id === id; })[0];
            mesgulIsaretle(id, true);   // yuklenene kadar gostergesi donsun

            try {
                f.contentWindow.location.reload();
                return;
            } catch (e) {
                // Ayni kaynak degilse ya da erisilemiyorsa acilis adresine don.
            }

            if (t) f.src = sekmeUrl(t.url);
            else mesgulIsaretle(id, false);
        }

        function sekmeUrl(url) {
            var u = url + (url.indexOf('?') >= 0 ? '&' : '?') + '_sekme=1';
            // Sekme, kabugun (bu pencerenin) sirketiyle acilir; adresinde db varsa o korunur.
            if (!/[?&]db=/.test(u)) {
                var kabukDb = window.portalSekmeDb ? (window.portalSekmeDb() || '') : '';
                if (kabukDb) u += '&db=' + encodeURIComponent(kabukDb);
            }
            return u;
        }

        function ac(ad, url, kucuk, aktifYap) {
            // Ayni sayfa zaten aciksa yenisi acilmaz, o sekmeye gecilir.
            var mevcut = sekmeler.filter(function (t) { return t.url === url; })[0];
            if (mevcut) {
                mevcut.kucuk = false;
                if (aktifYap !== false) aktifId = mevcut.id;
                ciz(); kaydet();
                return;
            }

            var id = ++sayac;
            var f = document.createElement('iframe');
            f.className = 'sekme-cerceve';
            f.id = 'cerceve_' + id;
            f.src = sekmeUrl(url);
            f.setAttribute('title', ad);
            f.addEventListener('load', function () {
                mesgulIsaretle(id, false);
                // Sekme her yuklendiginde (ic gecisler dahil) kullanicinin zoom'u uygulanir.
                if (window.zoomCerceveyeUygula) window.zoomCerceveyeUygula(f);
            });
            kapsayan.appendChild(f);
            mesgulSekmeler[id] = true;   // yuklenene kadar donsun

            sekmeler.push({ id: id, ad: ad, url: url, kucuk: !!kucuk });
            if (aktifYap !== false && !kucuk) aktifId = id;
            ciz(); kaydet();
        }

        function kapat(id) {
            var f = document.getElementById('cerceve_' + id);
            if (f) f.remove();
            sekmeler = sekmeler.filter(function (t) { return t.id !== id; });
            if (aktifId === id) {
                var kalan = sekmeler.filter(function (t) { return !t.kucuk; });
                aktifId = kalan.length ? kalan[kalan.length - 1].id : 0;
            }
            ciz(); kaydet();
        }

        cubuk.addEventListener('click', function (e) {
            var dg = e.target.closest('.dugme');
            var sk = e.target.closest('.sekme');
            if (!sk) return;
            var id = Number(sk.dataset.id);

            if (dg) {
                e.stopPropagation();
                if (dg.dataset.is === 'yenile') { sekmeyiYenile(id); return; }
                if (dg.dataset.is === 'kopyala') { sirketSecTIkla(id, dg); return; }
                if (dg.dataset.is === 'kapat') { kapat(id); return; }
                if (dg.dataset.is === 'kucult') {
                    var t = sekmeler.filter(function (x) { return x.id === id; })[0];
                    if (t) { t.kucuk = true; if (aktifId === id) aktifId = 0; }
                    ciz(); kaydet();
                    return;
                }
            }
            aktifId = id;
            ciz(); kaydet();   // yenilemede ayni sekmeye donulsun
        });

        if (gorevler) {
            gorevler.addEventListener('click', function (e) {
                var g = e.target.closest('.gorev');
                if (!g) return;
                var id = Number(g.dataset.id);

                // Yenile dugmesi geri getirmeyi degil, yalnizca yenilemeyi yapar.
                var dg = e.target.closest('.dugme');
                if (dg && dg.dataset.is === 'yenile') {
                    e.stopPropagation();
                    sekmeyiYenile(id);
                    return;
                }

                var t = sekmeler.filter(function (x) { return x.id === id; })[0];
                if (t) { t.kucuk = false; aktifId = id; }
                ciz(); kaydet();
            });
        }

        // Menu tiklamalari: gezinmek yerine sekmede ac.
        document.addEventListener('click', function (e) {
            var a = e.target.closest('a.sidebar-link[href], a.report-card[href]');
            if (!a) return;
            if (e.ctrlKey || e.metaKey || e.shiftKey || e.button === 1) return;
            if (a.getAttribute('target')) return;
            if (e.target.closest('.toggle-favorite-btn')) return;

            var url = a.getAttribute('href');
            if (!url || url === '#' || url.indexOf('javascript:') === 0) return;
            if (url.indexOf('/Account/') === 0) return;          // giris/cikis kabukta kalir

            // Ana sayfa kabugun kendisidir; sekmede acilmaz, normal gezinir.
            var kok = url.split('?')[0].replace(/\/+$/, '').toLowerCase();
            if (kok === '' || kok === '/home' || kok === '/home/index') {
                // Ana Sayfa: kabuk yeniden yuklenir; onceki aktif sekme degil ANA SAYFA gosterilsin.
                try { sessionStorage.setItem('portalAnaSayfaIstek', '1'); } catch (x) { }
                return;
            }

            e.preventDefault();
            var etiket = a.querySelector('.link-text, .card-title');   // menü bağlantısı ya da ana sayfa rapor kartı
            var ad = (etiket ? etiket.textContent : a.textContent).trim().substring(0, 40);
            ac(ad, url, false, true);
        });

        window.addEventListener('resize', yukseklikAyarla);

        // Onceki oturumdan kalan sekmeleri geri getir.
        var kayit = oku();
        kayit.liste.forEach(function (t) { ac(t.ad, t.url, t.kucuk, false); });

        // Yenilemeden once hangi sekme aciksa ona geri don.
        aktifId = 0;
        // Onceki aktif sekmeye YALNIZCA kabuk ana sayfada yeniden yuklendiyse donulur.
        // Kabuk baska bir sayfada acildiysa (dogrudan adres / kart) o sayfa gosterilir;
        // "Ana Sayfa" baglantisiyla gelindiyse ana sayfa gosterilir.
        var anaIstek = false;
        try { anaIstek = sessionStorage.getItem('portalAnaSayfaIstek') === '1'; sessionStorage.removeItem('portalAnaSayfaIstek'); } catch (x) { }
        var kabukYolu = (location.pathname || '').replace(/\/+$/, '').toLowerCase();
        var kabukAnaSayfada = (kabukYolu === '' || kabukYolu === '/home' || kabukYolu === '/home/index');
        // Tarayici YENILEME (F5) ise kabuk hangi sayfada olursa olsun onceki aktif
        // sekmeye donulur; kullanici sekmenin icindeyken F5'e basinca ana sayfaya
        // dusmesin. Yeni gezinmede (adres yazma, baglanti) eski davranis korunur.
        var tarayiciYenileme = false;
        try {
            var nav = (performance.getEntriesByType && performance.getEntriesByType('navigation')[0]) || null;
            tarayiciYenileme = nav ? (nav.type === 'reload' || nav.type === 'back_forward')
                                   : !!(performance.navigation && performance.navigation.type === 1);
        } catch (x) { }
        if (kayit.aktifUrl && (kabukAnaSayfada || tarayiciYenileme) && !anaIstek) {
            var geri = sekmeler.filter(function (t) { return t.url === kayit.aktifUrl && !t.kucuk; })[0];
            if (geri) aktifId = geri.id;
        }
        ciz();

        // Geri getirme sirasinda ac() her sekme icin kaydet() cagiriyor ve o an
        // aktifId henuz 0 oldugu icin depodaki aktif sekme bilgisi siliniyordu.
        // Sonuc: sirketi ust uste degistirince ikincisinde ana sayfaya dusuluyordu.
        // Dogru aktif sekme belirlendikten sonra bir kez daha kaydedilir.
        kaydet();

        // ---- SEKMEYI BASKA SIRKETTE KOPYALA -------------------------------
        //
        // Sirket normalde cerezle tasinir, dolayisiyla butun sekmeler ayni
        // sirketi gosterir. Oysa adres satirindaki "db" parametresi cerezden
        // once geliyor (GetSelectedDatabase once query'ye bakar). Bu sayede bir
        // sekme URL'sine db eklenerek O SEKME baska bir sirkete sabitlenebilir;
        // digerleri etkilenmez. Boylece ayni rapor iki sekmede iki sirketle
        // yan yana acilabiliyor.
        function urlSirketiDegistir(url, dbAnahtar) {
            var parcalar = url.split('#');
            var temel = parcalar[0];
            var kalan = parcalar.length > 1 ? '#' + parcalar.slice(1).join('#') : '';

            var ikiye = temel.split('?');
            var yol = ikiye[0];
            // Sirket degisince rapor filtreleri (hesap kodu, cari, tarih...) onceki sirkete aittir; adreste tasinirsa
            // yeni sirkette yanlis secimlerle rapor calisiyor ve kafa karistiriyordu. Yalnizca kabuk parametreleri korunur.
            var korunan = ['portal', 'sekme', 'tab', 'lang'];
            var sorgu = (ikiye[1] || '').split('&').filter(function (p) {
                var ad = p.split('=')[0];
                return p && ad !== 'db' && korunan.indexOf(ad) >= 0;
            });

            sorgu.push('db=' + encodeURIComponent(dbAnahtar));
            return yol + '?' + sorgu.join('&') + kalan;
        }

        function sirketSecTIkla(id, dugme) {
            var t = sekmeler.filter(function (x) { return x.id === id; })[0];
            if (!t) return;

            // Acik bir menu varsa kapat
            var eski = document.getElementById('sekmeSirketMenu');
            if (eski) eski.remove();

            var menu = document.createElement('div');
            menu.id = 'sekmeSirketMenu';
            menu.style.cssText = 'position:fixed; z-index:2000; background:#fff; border:1px solid #dee2e6;'
                               + 'border-radius:8px; box-shadow:0 6px 20px rgba(0,0,0,.15); padding:6px;'
                               + 'max-height:320px; overflow:auto; min-width:220px; font-size:12.5px;';

            var baslik = document.createElement('div');
            baslik.textContent = 'Bu sayfayı hangi şirkette açalım?';
            baslik.style.cssText = 'font-weight:700; color:#64748b; padding:6px 8px; font-size:11px; text-transform:uppercase;';
            menu.appendChild(baslik);

            SIRKETLER.forEach(function (sir) {
                var satir = document.createElement('div');
                satir.textContent = sir.ad;
                satir.style.cssText = 'padding:7px 10px; cursor:pointer; border-radius:5px; white-space:nowrap;';
                satir.onmouseenter = function () { satir.style.background = '#eef2f7'; };
                satir.onmouseleave = function () { satir.style.background = ''; };
                satir.onclick = function () {
                    menu.remove();
                    ac(t.ad + ' · ' + sir.ad, urlSirketiDegistir(t.url, sir.anahtar), false, true);
                };
                menu.appendChild(satir);
            });

            document.body.appendChild(menu);

            var k = dugme.getBoundingClientRect();
            menu.style.left = Math.max(8, Math.min(k.left, window.innerWidth - menu.offsetWidth - 8)) + 'px';
            menu.style.top = (k.bottom + 4) + 'px';

            setTimeout(function () {
                document.addEventListener('click', function kapatMenu(ev) {
                    if (!menu.contains(ev.target)) { menu.remove(); document.removeEventListener('click', kapatMenu); }
                });
            }, 0);
        }

        window.portalSekmeAc = function (ad, url) { ac(ad, url, false, true); };

        // Sirket degisiminde kabugu yeniden yuklemeden acik sekmeleri tazeler.
        // true donerse cagiran taraf tam sayfa yenileme YAPMAZ.
        //
        // Ana sayfa sekmesi (kabugun kendi govdesi) aktifse false doner; o icerik
        // sunucuda uretildigi icin yerinde tazelenemez, tam yenileme gerekir.
        window.portalSirketTazele = function (dbAdi, dbKey) {
            if (aktifId === 0) return false;

            var acikOlan = sekmeler.filter(function (t) { return !t.kucuk; });
            if (!acikOlan.length) return false;

            sekmeler.forEach(function (t) {
                // Adresinde "db" olan sekme belirli bir sirkete sabitlenmistir;
                // ust taraftaki sirket degisiminden etkilenmemelidir.
                if (/[?&]db=/.test(t.url)) return;

                var f = document.getElementById('cerceve_' + t.id);
                if (f) f.src = dbKey ? urlSirketiDegistir(sekmeUrl(t.url), dbKey) : sekmeUrl(t.url);   // sekme yeni sirketle yeniden yuklenir
            });

            // Menudeki sirket adi ve secili isareti de yenilemeden guncellensin.
            if (dbAdi) {
                var etiket = document.getElementById('aktifSirketAdi');
                if (etiket) etiket.textContent = dbAdi;

                document.querySelectorAll('[aria-labelledby="databaseUserDropdown"] .dropdown-item')
                    .forEach(function (x) {
                        var kendiAdi = (x.textContent || '').trim();
                        x.classList.toggle('active-db', kendiAdi === dbAdi);
                    });
            }

            if (window.toastr) toastr.info('Şirket değişti, açık sekmeler yenilendi.');
            return true;
        };
    })();
    </script>
}
    @* ---- CERCEVE HABERCISI ----------------------------------------------
       Sekme icinde acilan sayfa, mesgul oldugunu (sayfa yukleniyor / veri
       cekiliyor) ve icinde bir betik hatasi olustugunu ust kabuga bildirir.
       Ust kabuk bunu sekme basligindaki donen halka ve hata bildirimi olarak
       gosterir. Sayfa cerceve icinde degilse hicbir sey yapmaz. *@
    <script>
        (function () {
            try { if (window.self === window.top) return; } catch (e) { return; }

            function bildir(veri) {
                try {
                    veri.kaynak = 'portal';
                    parent.postMessage(veri, window.location.origin);
                } catch (e) { }
            }

            // --- Mesguliyet sayaci ---------------------------------------
            //
            // Layout'un KENDI arka plan sorgulari sayilmaz. Bunlar her sayfada
            // ve her cercevede surekli doner (/Home/Ping ve /Home/CheckMaintenance
            // 10 saniyede bir, /Home/Bildirimler 2 dakikada bir); sayilirsa
            // kullanici hicbir sey yapmadigi halde butun sekmeler doner durur.
            var SAYILMAZ = [
                '/home/ping',
                '/home/checkmaintenance',
                '/home/bildirimler',
                '/home/bildirimokundu',
                '/rapor20/getautoreconcileprogress',
                '/rapor20/getrobotcheckstatus'
            ];

            function sayilirMi(url) {
                if (!url) return true;
                var u = String(url).toLowerCase();
                for (var i = 0; i < SAYILMAZ.length; i++) {
                    if (u.indexOf(SAYILMAZ[i]) >= 0) return false;
                }
                return true;
            }

            var acikIstek = 0;
            var zaman = null;
            var guvenlikZamani = null;

            function basladi() {
                acikIstek++;
                if (acikIstek === 1) {
                    clearTimeout(zaman);
                    bildir({ tip: 'mesgul', durum: true });

                    // Bir istek yanit vermeden kalirsa gosterge sonsuza kadar
                    // donmesin: 90 saniye sonra kendiliginden sifirlanir.
                    clearTimeout(guvenlikZamani);
                    guvenlikZamani = setTimeout(function () {
                        acikIstek = 0;
                        bildir({ tip: 'mesgul', durum: false });
                    }, 90000);
                }
            }

            function bitti() {
                acikIstek = Math.max(0, acikIstek - 1);
                if (acikIstek === 0) {
                    clearTimeout(guvenlikZamani);
                    clearTimeout(zaman);
                    // Art arda gelen isteklerde gosterge yanip sonmesin.
                    zaman = setTimeout(function () {
                        if (acikIstek === 0) bildir({ tip: 'mesgul', durum: false });
                    }, 250);
                }
            }

            // NOT: jQuery de XMLHttpRequest kullanir. Ikisini birden baglamak
            // ayni istegi iki kez sayar ve bir taraf eksik biterse sayac
            // sifira inmez; bu yuzden yalnizca XHR ve fetch baglanir.
            if (window.fetch) {
                var asilFetch = window.fetch;
                window.fetch = function (kaynak) {
                    var adres = (kaynak && kaynak.url) ? kaynak.url : kaynak;
                    if (!sayilirMi(adres)) return asilFetch.apply(this, arguments);

                    basladi();
                    return asilFetch.apply(this, arguments)
                        .then(function (c) { bitti(); return c; })
                        .catch(function (h) { bitti(); throw h; });
                };
            }

            if (window.XMLHttpRequest) {
                var asilAc = XMLHttpRequest.prototype.open;
                XMLHttpRequest.prototype.open = function (yontem, adres) {
                    if (sayilirMi(adres)) {
                        var bittiCagrildi = false;
                        var birKezBitti = function () {
                            if (bittiCagrildi) return;
                            bittiCagrildi = true;
                            bitti();
                        };
                        this.addEventListener('loadstart', basladi);
                        this.addEventListener('loadend', birKezBitti);
                        this.addEventListener('error', birKezBitti);
                        this.addEventListener('abort', birKezBitti);
                        this.addEventListener('timeout', birKezBitti);
                    }
                    return asilAc.apply(this, arguments);
                };
            }

            // Sayfa yenileniyor / form gonderiliyor
            window.addEventListener('beforeunload', function () {
                bildir({ tip: 'mesgul', durum: true });
            });

            // --- "_sekme" isaretini koru ---------------------------------
            //
            // Rapor formlarinin cogu kendi adresine gonderim yapiyor
            // (orn. action="/Rapor141"), bu da adresteki _sekme=1 isaretini
            // dusuruyordu. Isaret dusunce sayfa cerceve icinde TAM layout ile
            // (kenar menu, ust baslik, sekme cubugu) yeniden yukleniyor ve
            // ekran bozuk/tepkisiz gorunuyor. Cerceve icindeki her gezinmede
            // isaret geri konur.
            function sekmeliAdres(adres) {
                try {
                    var u = new URL(adres, window.location.href);
                    if (u.origin !== window.location.origin) return adres;   // dis baglanti
                    if (!u.searchParams.has('_sekme')) u.searchParams.set('_sekme', '1');
                    return u.pathname + u.search + u.hash;
                } catch (e) { return adres; }
            }

            document.addEventListener('submit', function (o) {
                var form = o.target;
                if (!form || form.tagName !== 'FORM') return;

                var yontem = (form.getAttribute('method') || 'get').toLowerCase();

                if (yontem === 'get') {
                    // GET gonderiminde adresteki sorgu tamamen forma gore yeniden
                    // kurulur; bu yuzden isareti gizli alan olarak eklemek gerekir.
                    if (!form.querySelector('input[name="_sekme"]')) {
                        var gizli = document.createElement('input');
                        gizli.type = 'hidden';
                        gizli.name = '_sekme';
                        gizli.value = '1';
                        form.appendChild(gizli);
                    }
                    return;
                }

                var hedef = form.getAttribute('action');
                if (hedef) form.setAttribute('action', sekmeliAdres(hedef));
            }, true);

            document.addEventListener('click', function (o) {
                var a = o.target && o.target.closest ? o.target.closest('a[href]') : null;
                if (!a) return;

                var href = a.getAttribute('href');
                if (!href || href.charAt(0) === '#') return;
                if (/^(javascript|mailto|tel):/i.test(href)) return;
                if (a.hasAttribute('download')) return;
                if (a.target && a.target !== '_self') return;   // yeni sekmede acilanlar

                var yeni = sekmeliAdres(href);
                if (yeni !== href) a.setAttribute('href', yeni);
            }, true);

            // --- Betik hatalari ------------------------------------------
            // Sekme icindeki bir hata, sayfadaki dugmeleri sessizce calismaz
            // hale getirebiliyordu; artik ust kabukta gorunur.
            window.addEventListener('error', function (o) {
                bildir({
                    tip: 'hata',
                    mesaj: (o && o.message) ? o.message : 'Bilinmeyen betik hatası',
                    dosya: o ? o.filename : '',
                    satir: o ? o.lineno : 0
                });
            });

            window.addEventListener('unhandledrejection', function (o) {
                bildir({
                    tip: 'hata',
                    mesaj: 'İşlenmemiş hata: ' + ((o && o.reason) ? o.reason : ''),
                    dosya: '', satir: 0
                });
            });
        })();
    </script>

