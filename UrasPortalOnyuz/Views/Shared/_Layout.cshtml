@using System.Security.Claims
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Configuration
@using WebApplication3.Data
@using WebApplication3.Models
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Configuration
@inject ApplicationDbContext DbContext

@{
    ViewData["Title"] = ViewData["Title"] ?? "Ana Sayfa";

    // ---------------------------------------------------------
    // 0. KULLANICI ADI EŞLEŞTİRME
    // ---------------------------------------------------------
    var kullaniciIsimleri = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        { "it02", "Ali Veli" }, { "ykb", "Sevgi Ay" }, { "gk", "Personel 17" },
        { "fns1", "Pınar Ak" }, { "fns2", "Kerem Aksoy" }, { "fns3", "Personel 01" },
        { "fns4", "Personel 02" }, { "muh100", "Çağla Keskin" }, { "sat5", "Tolga Yaman" },
        { "sat8", "Gizem Tan" }, { "muh36", "Nazlı Erdem" }, { "muh65", "Nevruz Sarıtaş" },
        { "MUH86", "Personel 11" }, { "MUH42", "Sedef Yılmaz" }, { "MUH01", "İsmail Uluğ" },
        { "MUH58", "Onur Bal" }, { "MUH74", "Özlem Güleryüz" }
    };

    string currentUserCode = User.Identity?.Name ?? "";
    string displayName = currentUserCode; displayName = WebApplication3.Data.OrnekVeri.KullaniciAdi(currentUserCode);
    displayName = WebApplication3.Data.OrnekVeri.KullaniciAdi(currentUserCode);
    if (!string.IsNullOrEmpty(currentUserCode) && kullaniciIsimleri.ContainsKey(currentUserCode))
    {
        displayName = kullaniciIsimleri[currentUserCode];
    }

    // ---------------------------------------------------------
    // 1. ŞİRKET (VERİTABANI) LİSTESİ VE YETKİ KONTROLÜ
    // ---------------------------------------------------------
    var currentUserAuthority = User.FindFirst("UserAuthority")?.Value ?? "";
    List<AppDatabase> allowedDatabases = new List<AppDatabase>();

    // Yetki kodu boş olabilir (kişi / rapor bazlı yetki); ölçüt giriş yapılmış olmasıdır.
    if (User?.Identity?.IsAuthenticated == true)
    {
        // Kişi bazlı yetki (A/B/S tüm şirketler). Bkz. Services/YetkiServisi.cs
        try { allowedDatabases = WebApplication3.Services.YetkiServisi.YetkiliSirketler(DbContext, User.Identity?.Name, currentUserAuthority); }
        catch { allowedDatabases = new List<AppDatabase>(); }
    }

    var urlDb = Context.Request.Query["db"].ToString();
    var cookieDb = Context.Request.Cookies["SelectedDatabase"];
    string selectedDb = "";

    if (!string.IsNullOrEmpty(urlDb) && allowedDatabases.Any(d => d.DbKey == urlDb)) selectedDb = urlDb;
    else if (!string.IsNullOrEmpty(cookieDb) && allowedDatabases.Any(d => d.DbKey == cookieDb)) selectedDb = cookieDb;
    else if (allowedDatabases.Any()) selectedDb = allowedDatabases.First().DbKey;
    else selectedDb = "DefaultConnection";

    string currentDbDisplay = allowedDatabases.FirstOrDefault(d => d.DbKey == selectedDb)?.Display ?? "Şirket Seçilmedi";

    // SAP Bilgilerim: secili sirket icin kullanicinin kendi SAP hesabi kayitli mi?
    // Varsayilan hesabi secebilenler (it02) icin uyari yok. Kontrol hata verirse sessiz.
    // Sekme icinde (iframe) acilan rapor sayfalarinda da hesaplanir; bant orada gosterilir.
    bool sapBilgiEksik = false;
    if (!string.IsNullOrEmpty(currentUserCode)
        && !WebApplication3.Services.SapKimlik.VarsayilanHesapKullanabilir(Yapilandirma, currentUserCode))
    {
        try
        {
            var sapKoruyucu = Context.RequestServices.GetService(typeof(Microsoft.AspNetCore.DataProtection.IDataProtectionProvider)) as Microsoft.AspNetCore.DataProtection.IDataProtectionProvider;
            sapBilgiEksik = !WebApplication3.Services.SapKimlik.KendiHesabiHazir(Yapilandirma, sapKoruyucu, currentUserCode, selectedDb);
        }
        catch { sapBilgiEksik = false; }
    }
    // Profil: kullanicinin SAP kartinda (OUSR, merkez sirket) e-posta yoksa her sayfada bant + menude "eksik" rozeti.
    // Bildirim e-postalari (kod talebi, onay, mutabakat) bu adrese gittigi icin bos kalmamali. Kontrol hata verirse sessiz.
    bool mailEksik = false;   // ON YUZ ORNEGI: e-posta kontrolu yok
    // Talep 52: cerez yalnizca gecerli bir secim yoksa (ilk giris) bu sayfadan yazilir.
    bool cerezGecersiz = string.IsNullOrEmpty(cookieDb) || !allowedDatabases.Any(d => d.DbKey == cookieDb);

    // ---------------------------------------------------------
    // 2. DİNAMİK MENÜ VE FAVORİLERİN KONTROLÜ
    // ---------------------------------------------------------
    List<AppMenu> allowedMenus = new List<AppMenu>();
    List<int> userFavoriteMenuIds = new List<int>();
    List<AppMenu> favoriteMenus = new List<AppMenu>();
        
    // Sekme icinde menu cizilmedigi icin bu sorgular hic calistirilmaz.
    if (!sekmeIcinde && User?.Identity?.IsAuthenticated == true)
    {
        // Kişi bazlı yetki (A/S her şeyi görür). Bkz. Services/YetkiServisi.cs
        try { allowedMenus = WebApplication3.Services.YetkiServisi.YetkiliMenuler(DbContext, User.Identity?.Name, currentUserAuthority); }
        catch { allowedMenus = new List<AppMenu>(); }
    }

    // FAVORİLERİ ÇEK
    if (!sekmeIcinde && !string.IsNullOrEmpty(currentUserCode))
    {
        userFavoriteMenuIds = DbContext.UserFavoriteMenus
                                .Where(x => x.UserCode == currentUserCode)
                                .Select(x => x.MenuId)
                                .ToList();

        favoriteMenus = allowedMenus.Where(m => userFavoriteMenuIds.Contains(m.Id)).ToList();
    }

    // Eski başlık/üst grup ağacı yardımcıları (kategori ikonları, hat renkleri) kaldırıldı; menü Grup ERP yapısıyla
    // Data/KurumsalMenu.cs üzerinden çizilir.
}

