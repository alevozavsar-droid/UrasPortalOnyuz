@inject Microsoft.Extensions.Configuration.IConfiguration Yapilandirma
@{
    // ---------------------------------------------------------
    // SEKME KABUGU (talep 35)
    //
    // Sayfa bir sekmenin icinde (iframe) acildiginda "_sekme=1" ile gelir.
    // O durumda menu, ust baslik, sekme cubugu ve gorev cubugu gosterilmez;
    // yalnizca sayfanin kendi govdesi cizilir. Boylece ayni sablon hem
    // kabuk hem de sekme icerigi olarak kullanilabilir.
    // Body sinifindan once okundugu icin en ustte tanimlanir.
    // ---------------------------------------------------------
    bool sekmeIcinde = Context.Request.Query.ContainsKey("_sekme");

    // Kullanicinin kayitli vurgu rengi. Sunucudan okunur ki secim cihaza
    // degil KISIYE bagli olsun. Tablo yoksa/okunamazsa varsayilan kullanilir.
    string kayitliVurguRengi = null;

    // Sekme kabugu kapatilabilir (talep 35 ek istegi). Tercih KISIYE baglidir;
    // "1" ise sayfalar eskisi gibi dogrudan acilir, sekme cubugu hic cizilmez.
    bool sekmeKapali = false;

    // Sayfa yakinlastirma (Chrome'daki gibi). Yuzde olarak tutulur; KISIYE
    // baglidir. Yalnizca izin verilen kademeler kabul edilir, gerisi %100 sayilir.
    int kayitliZoom = 100;
    int[] zoomKademeleri = new[] { 60, 67, 75, 80, 90, 100, 110, 125, 150 };

    // ON YUZ ORNEGI: tercihler bellek ici (HomeController.Tercih)
    if (User.Identity?.IsAuthenticated == true)
    {
        var _vr = WebApplication3.Controllers.HomeController.Tercih(User.Identity.Name, "VurguRengi"); if (!string.IsNullOrEmpty(_vr)) kayitliVurguRengi = _vr;
        sekmeKapali = WebApplication3.Controllers.HomeController.Tercih(User.Identity.Name, "SekmeKapali") == "1";
        int _z; if (int.TryParse(WebApplication3.Controllers.HomeController.Tercih(User.Identity.Name, "Zoom"), out _z) && Array.IndexOf(zoomKademeleri, _z) >= 0) kayitliZoom = _z;
    }
}
<!DOCTYPE html>
<html lang="tr" data-theme="light" data-zoom="@kayitliZoom">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- ========================================================
         SEKME KABUGU: cerceve tespiti (talep 35)

         "_sekme=1" yalnizca sekme ILK acilirken URL'de bulunur.
         Sekmenin icinde bir baglantiya tiklandiginda ya da form
         gonderildiginde yeni istekte o parametre olmaz ve kabuk
         cerceve icinde yeniden cizilirdi (ic ice layout).

         Bu yuzden asil olcut URL degil, pencerenin kendisidir:
         sayfa bir cerceve icindeyse kabuk her durumda gizlenir.
         Boyama oncesi calissin diye <head> icinde ve <html>
         uzerinde isaretlenir; boylece kisa bir an bile gorunmez.
         ======================================================== -->
    <script>
        try {
            if (window.self !== window.top) {
                document.documentElement.classList.add('cerceve-icinde');
            }
        } catch (e) {
            // Farkli kaynakli cerceve erisimi engellenirse cerceve icinde sayilir.
            document.documentElement.classList.add('cerceve-icinde');
        }

        // ---------------------------------------------------------
        // SAYFA YAKINLASTIRMA (Chrome'daki gibi, kisiye ozel)
        //
        // Deger sunucudan (Z_KullaniciTercih / Zoom) gelir; boyama
        // oncesi <html> uzerine yazilir ki sayfa zipla(ma)sin.
        // CSS "zoom" ozelligi kullanilir: Chrome'un kendi yakinlastirmasi
        // ile ayni motor oldugundan yerlesim bozulmaz.
        //
        // Cerceve (sekme) icindeki sayfalar KENDILERINE zoom uygulamaz;
        // kabuk, cerceve yuklendiginde olcup gerekirse iceri uygular
        // (bkz. zoomCerceveyeUygula). Boylece cift zoom olusmaz.
        // ---------------------------------------------------------
        window.ZOOM_KADEMELERI = [60, 67, 75, 80, 90, 100, 110, 125, 150];
        window.SUNUCU_ZOOM = parseInt(document.documentElement.getAttribute('data-zoom'), 10) || 100;
        window.zoomUygula = function (yuzde, belge) {
            belge = belge || document;
            var k = belge.documentElement;
            if (!k) return;
            if (window.ZOOM_KADEMELERI.indexOf(yuzde) < 0) yuzde = 100;
            var oran = yuzde / 100;
            k.setAttribute('data-zoom', yuzde);
            if (yuzde === 100) {
                k.style.zoom = '';
                k.style.removeProperty('--zoom');
            } else {
                k.style.zoom = oran;
                k.style.setProperty('--zoom', oran);
            }
        };
        try {
            if (window.self === window.top) window.zoomUygula(window.SUNUCU_ZOOM);
        } catch (e) { }
    </script>
    
    <!-- ======================================================== -->
    <!-- GERİ TUŞU İLE ESKİ SAYFANIN GELMESİNİ ENGELLEYEN KODLAR  -->
    <!-- ======================================================== -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <!-- ======================================================== -->

    <base href="@Url.Content("~/")" />
    
    <title>@ViewData["Title"] - Grup ERP Portalı</title>

    <link rel="stylesheet" href="@Url.Content("~/lib/bootstrap/dist/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Metronic Standart Fontu: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    
    <!-- BOOTSTRAP SELECT CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/css/bootstrap-select.min.css">
    
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" asp-append-version="true" />
    <link rel="icon" href="@Url.Content("~/images/HOLDING.png")" type="image/png" />

    <style>
        /* ========================================
           METRONIC V8 STİLİ UI & DARK MODE TEMA
           ======================================== */
        :root {
            /* Beyaza yakin, yumusak ve hafif seffaf acik tema */
            --bg-main: #fcfdfe;
            --bg-card: rgba(255, 255, 255, 0.74);
            --bg-card-solid: #ffffff;              /* seffaflik istemeyen yerler icin */
            --bg-subtle: #f7f9fb;
            --text-primary: #3F4254;
            --text-secondary: #7E8299;
            --border-color: rgba(15, 23, 42, 0.06);
            
            --metro-primary: #2563eb;
            --metro-primary-light: #eaf1ff;
            --metro-success: #12b76a;
            --metro-danger: #ef4444;
            --metro-warning: #f59e0b;
            
            --sidebar-bg: #1E1E2D;
            --sidebar-hover: #2B2B40;
            --sidebar-active-bg: #2B2B40;
            --sidebar-text: #9899ac;
            --sidebar-text-active: #ffffff;
            
            --shadow-sm: 0 1px 2px rgba(16, 24, 40, 0.03), 0 8px 24px rgba(16, 24, 40, 0.035);
            --shadow-md: 0 2px 4px rgba(16, 24, 40, 0.04), 0 16px 40px rgba(16, 24, 40, 0.055);

            --header-height: 75px;
            --sidebar-width: 80px; 
            --sidebar-expanded-width: 265px;
            --transition-speed: 0.3s;
            --font-main: 'Inter', sans-serif;
        }

        [data-theme="dark"] {
            --bg-main: #151521;
            --bg-card: #1E1E2D;
            --text-primary: #FFFFFF;
            --text-secondary: #9899ac;
            --border-color: #2B2B40;
            --sidebar-bg: #151521;
            --sidebar-hover: #1E1E2D;
            --sidebar-active-bg: #1E1E2D;
            --shadow-sm: 0px 0px 20px 0px rgba(0, 0, 0, 0.2);
            --shadow-md: 0px 0px 20px 0px rgba(0, 0, 0, 0.4);
        }

        body {
            font-family: var(--font-main);
            background-color: var(--bg-main);
            color: var(--text-primary);
            margin: 0; padding: 0;
            overflow-x: hidden;
            transition: background-color 0.3s, color 0.3s;
            -webkit-font-smoothing: antialiased;
        }

        /* Scrollbar Metronic Style */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #eff2f5; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #d8dce6; }
        [data-theme="dark"] ::-webkit-scrollbar-thumb { background: #2B2B40; }

        /* Loader */
        #page-loader-bar {
            position: fixed; top: 0; left: 0; height: 3px; width: 0%;
            background: var(--metro-primary);
            z-index: 99999; transition: width 0.3s ease, opacity 0.3s ease;
        }

        /* ================= SIDEBAR (ASIDE) ================= */
        .sidebar {
            width: var(--sidebar-width);
            /* vh birimleri CSS zoom'dan etkilenmez; zoom'a bolunerek ekrana sigdirilir. */
            height: calc(100vh / var(--zoom, 1));
            background: var(--sidebar-bg);
            color: var(--sidebar-text);
            position: fixed; top: 0; left: 0;
            display: flex; flex-direction: column;
            transition: width var(--transition-speed) ease;
            z-index: 1040;
        }
        .sidebar.expanded { width: var(--sidebar-expanded-width); }

        .sidebar-header {
            height: var(--header-height);
            display: flex; align-items: center; padding: 0 25px;
            border-bottom: 1px dashed rgba(255,255,255,0.1);
            white-space: nowrap; overflow: hidden;
        }

        .sidebar-logo {
            height: 30px; width: 30px; object-fit: contain;
            transition: transform var(--transition-speed); flex-shrink: 0;
        }
        .sidebar.expanded .sidebar-logo { margin-right: 15px; }

        .logo-text {
            font-weight: 600; font-size: 1.25rem;
            opacity: 0; transition: opacity 0.2s ease;
            color: var(--text-primary, #0f172a);
        }
        .sidebar.expanded .logo-text { opacity: 1; transition-delay: 0.1s; }

        .sidebar-menu {
            list-style: none; padding: 15px 10px; margin: 0;
            flex-grow: 1; overflow-y: auto; overflow-x: hidden;
        }

        .sidebar-link {
            display: flex; align-items: center; padding: 10px 15px;
            color: var(--sidebar-text); text-decoration: none;
            border-radius: 6px; transition: all 0.2s ease;
            font-weight: 500; font-size: 0.95rem; margin-bottom: 5px;
            cursor: pointer; user-select: none; border: none; background: transparent;
        }
        .sidebar-link:hover, .sidebar-link.menu-open { background-color: var(--sidebar-hover); color: var(--metro-primary); }
        
        .sidebar-link.active {
            background-color: var(--sidebar-active-bg); color: var(--sidebar-text-active);
        }
        .sidebar-link.active i { color: var(--metro-primary); }

        .sidebar-link i {
            width: 25px; text-align: center; font-size: 1.1rem;
            margin-right: 10px; transition: color 0.2s; flex-shrink: 0;
        }
        .sidebar:not(.expanded) .sidebar-link i { margin-right: 0; }

        .sidebar .dropdown-toggle::after {
            margin-left: auto; opacity: 0; transition: transform 0.3s ease;
            content: "\f105"; font-family: "Font Awesome 6 Free"; font-weight: 900;
            border: none; font-size: 0.8rem; color: var(--sidebar-text);
        }
        .sidebar.expanded .dropdown-toggle::after { opacity: 1; }
        .sidebar .dropdown-toggle.menu-open::after { transform: rotate(90deg); }

        .sidebar .link-text { opacity: 0; width: 0; overflow: hidden; transition: opacity 0.2s; white-space: normal;}
        .sidebar.expanded .link-text { opacity: 1; width: 100%; }

        .sidebar-submenu {
            list-style: none; padding: 0; margin: 0 0 10px 0; display: none;
        }
        .sidebar-submenu .sidebar-link { 
            padding: 8px 15px 8px 45px; font-size: 0.9rem; color: var(--sidebar-text); margin-bottom: 2px;
            position: relative;
        }
        .sidebar-submenu .sidebar-link::before {
            content: "\f111"; font-family: "Font Awesome 6 Free"; font-weight: 900; font-size: 4px;
            position: absolute; left: 25px; top: 50%; transform: translateY(-50%); color: var(--sidebar-text); opacity: 0.5;
        }
        .sidebar-submenu .sidebar-link:hover { color: var(--sidebar-text-active); background: transparent;}
        .sidebar-submenu .sidebar-link:hover::before { color: var(--metro-primary); opacity: 1; }
        .sidebar-submenu .sidebar-link.active { color: var(--sidebar-text-active); background: transparent; }
        .sidebar-submenu .sidebar-link.active::before { content: "\f054"; color: var(--metro-primary); opacity: 1; font-size: 8px;}

        /* ---- Üst Grup › Başlık › Rapor (3 seviye) ---- */
        .sidebar-submenu .sidebar-sub-toggle { padding: 7px 15px 7px 32px; font-size: 0.86rem; font-weight: 600; }
        .sidebar-submenu .sidebar-sub-toggle::before { content: none; }
        .sidebar-submenu .sidebar-sub-toggle i { font-size: 0.85rem; width: 20px; margin-right: 8px; }
        .sidebar:not(.expanded) .sidebar-submenu .sidebar-sub-toggle i { margin-right: 0; }
        .sidebar-submenu .sidebar-sub-toggle .alt-sayac { font-size: .65rem; opacity: .6; margin-left: 4px; }
        /* IT #16: görülmemiş hareket rozeti (menü, favoriler, dashboard kartı) */
        .menu-rozet { display: inline-flex; align-items: center; justify-content: center; min-width: 20px; height: 20px; padding: 0 6px; margin-left: 6px; border-radius: 999px; background: #dc2626; color: #fff; font-size: .68rem; font-weight: 800; line-height: 1; box-shadow: 0 0 0 2px rgba(220,38,38,.25); cursor: pointer; flex: 0 0 auto; }
        .menu-rozet[hidden] { display: none !important; }
        .sidebar:not(.expanded) .menu-rozet { position: absolute; right: 6px; top: 6px; margin: 0; min-width: 16px; height: 16px; font-size: .58rem; padding: 0 4px; }
        .report-card .menu-rozet { position: absolute; top: 10px; right: 10px; margin: 0; }
        .rozet-popover { position: fixed; z-index: 3000; width: min(420px, 92vw); max-height: 60vh; overflow: auto; background: var(--bg-card, #fff); color: var(--text-primary, #0f172a); border: 1px solid var(--border-color, #e2e8f0); border-radius: 12px; box-shadow: 0 18px 50px -12px rgba(15,23,42,.35); font-size: .78rem; }
        .rozet-popover .bas { display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; border-bottom: 1px solid var(--border-color, #e2e8f0); font-weight: 700; }
        .rozet-popover .sat { padding: 7px 12px; border-bottom: 1px solid var(--border-color, #f1f5f9); }
        .rozet-popover .sat .k { font-weight: 700; } .rozet-popover .sat .t { color: var(--text-secondary, #64748b); font-size: .7rem; }
        .sidebar-submenu-2 .sidebar-link { padding-left: 62px; font-size: 0.84rem; }
        .sidebar-submenu-2 .sidebar-link::before { left: 46px; }

        /* ================= FAVORİ MENÜ STİLLERİ ================= */
        .favorite-icon {
            margin-left: auto;
            font-size: 0.9rem;
            color: var(--sidebar-text);
            opacity: 0; 
            transition: all 0.2s;
        }
        .sidebar-link:hover .favorite-icon {
            opacity: 0.5; 
        }
        .favorite-icon.is-favorite {
            color: var(--metro-warning) !important;
            opacity: 1 !important; 
        }
        .favorite-icon:hover {
            color: var(--metro-warning);
            opacity: 1;
            transform: scale(1.2);
        }

        /* User Profile in Sidebar */
        .sidebar-bottom { padding: 15px; border-top: 1px dashed rgba(255,255,255,0.1); }
        .user-card-btn {
            width: 100%; background: var(--sidebar-hover); border: none;
            color: var(--text-primary, #0f172a); padding: 10px; border-radius: 6px;
            display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.3s;
        }
        .sidebar.expanded .user-card-btn { justify-content: flex-start; }
        .user-card-btn:hover { background: #323248; }
        .user-card-btn i { font-size: 1.5rem; color: var(--sidebar-text); flex-shrink:0; }

        /* ================= SEÇİLİ ŞİRKET RENK DÜZELTMESİ ================= */
        .dropdown-menu .dropdown-item.active-db {
            background-color: #009EF7 !important;
            color: #ffffff !important;
            font-weight: 700 !important;
        }
        .dropdown-menu .dropdown-item.active-db i {
            color: #ffffff !important;
        }

        /* ================= HEADER & WRAPPER ================= */
        .page-container {
            margin-left: var(--sidebar-width);
            width: calc(100% - var(--sidebar-width));
            min-height: calc(100vh / var(--zoom, 1)); display: flex; flex-direction: column;
            transition: margin-left var(--transition-speed) ease, width var(--transition-speed) ease;
        }
        .sidebar.expanded ~ .page-container {
            margin-left: var(--sidebar-expanded-width);
            width: calc(100% - var(--sidebar-expanded-width));
        }

        .top-header {
            height: var(--header-height);
            background-color: var(--bg-card);
            border-bottom: 1px solid var(--border-color);
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 25px; position: sticky; top: 0; z-index: 1020;
            box-shadow: var(--shadow-sm);
        }
        
        .breadcrumb-modern { margin: 0; padding: 0; list-style: none; display: flex; align-items: center; gap: 8px; font-size: 0.95rem; font-weight: 500; color: var(--text-secondary); }
        .breadcrumb-modern li { display: flex; align-items: center; gap: 8px; }
        .breadcrumb-modern li.active { color: var(--text-primary); font-weight: 600; }
        .breadcrumb-modern i { font-size: 0.6rem; opacity: 0.5; }

        .icon-btn {
            width: 40px; height: 40px; border-radius: 6px; border: none;
            background: var(--bg-main); color: var(--text-secondary);
            display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;
        }
        .icon-btn:hover { background: var(--metro-primary-light); color: var(--metro-primary); }

        /* Ust/sag/sol dolgu yok: icerik ekran kenarlarina dayanir. Yalnizca alt dolgu kalir. */
        .main-content { padding: 0 0 30px 0 !important; flex-grow: 1; display: flex; flex-direction: column; }

        /* ================= CARDS & TABLES ================= */
        .toolbar-container {
            background: var(--bg-card); padding: 15px 25px !important; border-radius: 0.475rem;
            box-shadow: var(--shadow-sm); margin-bottom: 30px !important; display: flex;
            justify-content: space-between; align-items: center; gap: 15px; flex-wrap: wrap; border: 1px solid var(--border-color);
        }
        
        .table-container {
            background: var(--bg-card); border-radius: 0.475rem; box-shadow: var(--shadow-sm);
            border: 1px solid var(--border-color); overflow: auto; flex-grow: 1; padding: 0 !important;
        }
        
        table.rapor-tablo { width: 100%; border-collapse: separate; border-spacing: 0; table-layout: fixed; min-width: 1000px; }
        
        .rapor-tablo thead tr:first-child th {
            background-color: var(--bg-card); color: var(--text-secondary); font-weight: 600; font-size: 0.8rem;
            letter-spacing: 0.5px; text-transform: uppercase; padding: 15px 15px !important;
            border-bottom: 1px dashed var(--border-color); position: sticky; top: 0; z-index: 10;
        }
        .rapor-tablo tbody td {
            padding: 12px 15px !important; border-bottom: 1px dashed var(--border-color);
            color: var(--text-primary); vertical-align: middle; font-size: 0.9rem; background: var(--bg-card);
        }
        .rapor-tablo tbody tr:hover td { background-color: var(--bg-main); }
        .rapor-tablo tbody tr:last-child td { border-bottom: none; }

        .resizable-column-handle {
            position: absolute; right: 0; top: 0; bottom: 0; width: 5px; cursor: col-resize; z-index: 15;
        }
        .resizable-column-handle:hover { background: var(--metro-primary); opacity: 0.5; }

        /* Metronic Buttons */
        .btn { border-radius: 6px; font-weight: 500; font-size: 0.9rem; padding: 0.6rem 1.25rem; }
        .btn-primary { background-color: var(--metro-primary); border-color: var(--metro-primary); }
        .btn-primary:hover { background-color: #008be1; border-color: #008be1; }
        .btn-light-primary { background-color: var(--metro-primary-light); color: var(--metro-primary); border: none;}
        .btn-light-primary:hover { background-color: var(--metro-primary); color: #fff;}

        /* Inputs */
        .form-control, .input-group-text { background-color: var(--bg-main); border: 1px solid var(--border-color); color: var(--text-primary); border-radius: 6px; }
        .form-control:focus { background-color: var(--bg-card); border-color: var(--metro-primary); box-shadow: none; }
        
        /* Modals */
        .modal-content { background-color: var(--bg-card); border: none; border-radius: 0.475rem; box-shadow: var(--shadow-md); color: var(--text-primary); }
        .modal-header { border-bottom: 1px solid var(--border-color); }
        .modal-footer { border-top: 1px dashed var(--border-color); }

        @@media (max-width: 991px) {
            .sidebar { transform: translateX(-100%); width: var(--sidebar-expanded-width); }
            .sidebar.mobile-open { transform: translateX(0); }
            .page-container, .sidebar.expanded ~ .page-container { margin-left: 0; width: 100%; }
            .mobile-toggle { display: block; background: transparent; border: none; font-size: 1.5rem; color: var(--text-primary);}
            .breadcrumb-modern { display: none; }
        }
    
        /* Yumusak/seffaf gorunum: kart zeminleri hafif saydam oldugu icin
           arkalarini bulaniklastiriyoruz. Yalnizca ACIK temada uygulanir;
           koyu temada kartlar opak kalir. */
        :root:not([data-theme="dark"]) .card,
        :root:not([data-theme="dark"]) .sap-card,
        :root:not([data-theme="dark"]) .eb-kart,
        :root:not([data-theme="dark"]) .eb-panel,
        :root:not([data-theme="dark"]) .eb-ust,
        :root:not([data-theme="dark"]) .eb-filtre,
        /* Kart/tablo kaplarındaki backdrop-filter kaldırıldı: koca tablo kabının arkasını her kaydırma
           karesinde yeniden bulanıklaştırmak sayfayı ağırlaştırıyordu (görsel farkı yok denecek kadar azdı). */
        :root:not([data-theme="dark"]) .ifa-kart,
        :root:not([data-theme="dark"]) .dashboard-widget,
        :root:not([data-theme="dark"]) .dashboard-chart-card,
        :root:not([data-theme="dark"]) .table-container,
        :root:not([data-theme="dark"]) .modal-content {
            -webkit-backdrop-filter: none;
            backdrop-filter: none;
        }

        /* Tablo basliklari saydam zeminde okunakli kalsin */
        :root:not([data-theme="dark"]) thead th {
            background-color: #f7f9fb;
        }
</style>
    <!-- ============================================================
         MODERN UI REFRESH — tasarım katmanı
         Mevcut Metronic tabanını bozmadan token / bileşen tazelemesi.
         Rapor sayfalarının kendi @@section Styles blokları bunun
         ARDINDAN yüklendiği için sayfa özel stilleri hâlâ öncelikli.
         ============================================================ -->
    <style>
        :root {
            /* --- Nötr palet --- */
            --bg-main: #fbfcfe;
            --bg-card: rgba(255, 255, 255, .78);
            --bg-card-solid: #ffffff;
            --bg-subtle: #f7f9fc;
            --text-primary: #0f172a;
            --text-secondary: #64748b;
            --border-color: rgba(15, 23, 42, .065);

            /* --- Marka --- */
            --metro-primary: #2563eb;
            --metro-primary-light: #eaf1ff;
            --metro-primary-dark: #1d4ed8;
            --accent-2: #0ea5e9;
            --accent-gradient: linear-gradient(135deg, #2563eb 0%, #0ea5e9 100%);
            --metro-success: #10b981;
            --metro-danger: #ef4444;
            --metro-warning: #f59e0b;

            /* --- Sidebar --- */
            --sidebar-bg: rgba(255, 255, 255, .82);
            --sidebar-hover: rgba(15, 23, 42, .045);
            --sidebar-active-bg: rgba(0, 158, 247, .12);
            --sidebar-text: #5b6577;
            --sidebar-text-active: #0b7fd4;

            /* --- Yarıçap --- */
            --r-xs: 8px;
            --r-sm: 10px;
            --r-md: 13px;
            --r-lg: 18px;
            --r-xl: 24px;

            /* --- Gölge --- */
            --shadow-sm: 0 1px 2px rgba(15, 23, 42, .04), 0 1px 3px rgba(15, 23, 42, .05);
            --shadow-md: 0 4px 14px rgba(15, 23, 42, .06), 0 14px 34px rgba(15, 23, 42, .07);
            --shadow-lg: 0 10px 24px rgba(15, 23, 42, .09), 0 26px 60px rgba(15, 23, 42, .10);
            --ring: 0 0 0 3px rgba(0, 158, 247, .22);

            --header-height: 72px;
            --sidebar-width: 84px;
            --sidebar-expanded-width: 280px;
            --transition-speed: .28s;
            --ease: cubic-bezier(.4, 0, .2, 1);
        }

        [data-theme="dark"] {
            --bg-main: #0b0f1a;
            --bg-card: #131a28;
            --bg-subtle: #0f1521;
            --text-primary: #e8edf7;
            --text-secondary: #8b98ad;
            --border-color: #1f2937;
            --sidebar-bg: #080c15;
            --sidebar-hover: rgba(255, 255, 255, .05);
            --metro-primary-light: rgba(0, 158, 247, .12);
            --shadow-sm: 0 1px 2px rgba(0, 0, 0, .35);
            --shadow-md: 0 6px 20px rgba(0, 0, 0, .45);
            --shadow-lg: 0 18px 50px rgba(0, 0, 0, .55);
        }

        html { scroll-behavior: smooth; }

        body {
            font-feature-settings: "cv02", "cv03", "cv04", "tnum";
            letter-spacing: -.01em;
            -moz-osx-font-smoothing: grayscale;
        }

        ::selection { background: rgba(0, 158, 247, .18); }

        :focus-visible {
            outline: none;
            box-shadow: var(--ring);
            border-radius: var(--r-xs);
        }

        /* ---------- Scrollbar ---------- */
        ::-webkit-scrollbar { width: 10px; height: 10px; }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1; border-radius: 99px;
            border: 3px solid transparent; background-clip: content-box;
        }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; background-clip: content-box; }
        [data-theme="dark"] ::-webkit-scrollbar-thumb { background: #263244; background-clip: content-box; }

        /* ---------- Yükleme çubuğu ---------- */
        #page-loader-bar { height: 2.5px; background: var(--accent-gradient); box-shadow: 0 0 12px rgba(0, 158, 247, .6); }

        /* ================== SIDEBAR ================== */
        .sidebar {
            background:
                radial-gradient(680px 320px at -10% -5%, rgba(0, 158, 247, .16), transparent 60%),
                radial-gradient(520px 300px at 110% 105%, rgba(99, 102, 241, .16), transparent 60%),
                var(--sidebar-bg);
            border-right: 1px solid rgba(255, 255, 255, .05);
            transition: width var(--transition-speed) var(--ease);
        }

        .sidebar-header {
            border-bottom: 1px solid rgba(255, 255, 255, .06);
            padding: 0 26px;
            gap: 12px;
        }
        .sidebar-logo {
            height: 34px; width: 34px; border-radius: 10px;
            background: rgba(15, 23, 42, .05); padding: 4px;
        }
        .sidebar.expanded .sidebar-logo { margin-right: 0; }
        .logo-text { font-size: 1.05rem; font-weight: 700; letter-spacing: -.02em; }

        .sidebar-menu { padding: 14px 12px 20px; }
        .sidebar-menu::-webkit-scrollbar-thumb { background: rgba(15, 23, 42, .14); background-clip: content-box; }

        .sidebar-link {
            position: relative;
            padding: 11px 14px;
            border-radius: var(--r-sm);
            font-size: .92rem;
            font-weight: 500;
            margin-bottom: 3px;
            transition: background-color .18s var(--ease), color .18s var(--ease), transform .18s var(--ease);
        }
        .sidebar-link:hover { background-color: var(--sidebar-hover); color: var(--metro-primary); }
        .sidebar-link:active { transform: scale(.985); }

        .sidebar-link.active {
            background-color: var(--sidebar-active-bg);
            color: var(--sidebar-text-active);
            font-weight: 600;
        }
        .sidebar-link.active::before {
            content: ""; position: absolute; left: -12px; top: 50%;
            width: 3px; height: 20px; transform: translateY(-50%);
            border-radius: 0 4px 4px 0; background: var(--metro-primary);
            box-shadow: 0 0 12px rgba(0, 158, 247, .8);
        }
        .sidebar-link.active i { color: var(--metro-primary); }
        .sidebar-link i { font-size: 1.05rem; width: 26px; }

        .sidebar-submenu .sidebar-link { padding-left: 46px; font-size: .86rem; }
        .sidebar-submenu .sidebar-link.active { background: var(--sidebar-hover); }
        .sidebar-submenu .sidebar-link.active::before {
            content: "\f111"; font-family: "Font Awesome 6 Free"; font-weight: 900;
            left: 26px; width: auto; height: auto; font-size: 5px;
            box-shadow: none; background: none; color: var(--metro-primary);
        }

        /* Daraltılmış modda ipucu balonu */
        .sidebar:not(.expanded) .sidebar-link { justify-content: center; }
        .sidebar:not(.expanded) .sidebar-menu > li > .sidebar-link::after { display: none; }

        .sidebar-bottom { border-top: 1px solid rgba(255, 255, 255, .06); padding: 14px; }
        .user-card-btn {
            background: rgba(15, 23, 42, .05);
            border: 1px solid rgba(255, 255, 255, .06);
            border-radius: var(--r-sm);
            padding: 11px;
            font-weight: 600;
            transition: background .2s var(--ease), border-color .2s var(--ease);
        }
        .user-card-btn:hover { background: rgba(15, 23, 42, .08); border-color: rgba(255, 255, 255, .14); }

        .favorite-icon:hover { transform: scale(1.25) rotate(8deg); }

        /* ================== HEADER ================== */
        .top-header {
            background: color-mix(in srgb, var(--bg-card) 82%, transparent);
            -webkit-backdrop-filter: saturate(180%) blur(14px);
            backdrop-filter: saturate(180%) blur(14px);
            border-bottom: 1px solid var(--border-color);
            box-shadow: none;
            padding: 0 clamp(16px, 2vw, 30px);
        }
        @@supports not (background: color-mix(in srgb, red 50%, blue)) {
            .top-header { background: var(--bg-card); }
        }
        .top-header h4 { font-size: 1.05rem; letter-spacing: -.02em; margin-bottom: 2px !important; }
        .breadcrumb-modern { font-size: .82rem; }

        .icon-btn {
            width: 42px; height: 42px; border-radius: var(--r-md);
            background: var(--bg-subtle);
            border: 1px solid var(--border-color);
            transition: all .2s var(--ease);
        }
        .icon-btn:hover {
            background: var(--metro-primary-light);
            color: var(--metro-primary);
            border-color: color-mix(in srgb, var(--metro-primary) 30%, transparent);
            transform: translateY(-1px);
        }
        .icon-btn:active { transform: translateY(0) scale(.96); }

        /* ================== İÇERİK ================== */
        .main-content {
            /* Ust/sag/sol sifir; alt dolgu --icerik-dolgu kadar. Sekme cubugu ve
               cerceve kabi ayni degiskeni kullanir; boylece sekmeli gorunumde
               negatif marjlar dolguyla birebir eslesir, tasma/cakisma olmaz. */
            --icerik-dolgu: clamp(16px, 2.2vw, 32px);
            padding: 0 0 var(--icerik-dolgu) 0 !important;
            gap: 0;
        }
        /* Not: .main-content alt elemanlarına giriş animasyonu verilmiyor.
           Animasyon (opacity/transform) o elemanlarda stacking context yaratıp
           sayfa içindeki modalleri, body'ye eklenen backdrop'un altında
           bırakabiliyordu; ekran bulanık ve tıklanamaz görünüyordu. */

        /* Modal her koşulda backdrop'un üstünde kalsın */
        .modal { z-index: 1060; }
        .modal-backdrop { z-index: 1050; }

        .toolbar-container {
            border-radius: var(--r-lg);
            padding: 14px 18px !important;
            margin-bottom: clamp(16px, 2vw, 26px) !important;
            box-shadow: var(--shadow-sm);
            position: sticky; top: calc(var(--header-height) + 8px); z-index: 15;
            background: color-mix(in srgb, var(--bg-card) 88%, transparent);
            -webkit-backdrop-filter: blur(12px);
            backdrop-filter: blur(12px);
        }
        @@supports not (background: color-mix(in srgb, red 50%, blue)) {
            .toolbar-container { background: var(--bg-card); }
        }

        .table-container {
            border-radius: var(--r-lg);
            box-shadow: var(--shadow-sm);
        }
        .table-container.border-0 { background: transparent !important; }

        /* ================== TABLO ================== */
        .rapor-tablo thead tr:first-child th {
            background: var(--bg-subtle);
            font-size: .72rem; letter-spacing: .06em;
            padding: 14px 16px !important;
            border-bottom: 1px solid var(--border-color);
        }
        .rapor-tablo tbody td {
            border-bottom: 1px solid color-mix(in srgb, var(--border-color) 60%, transparent);
            font-size: .875rem;
        }
        .rapor-tablo tbody tr { transition: background .15s var(--ease); }
        .rapor-tablo tbody tr:hover td { background: var(--metro-primary-light); }

        /* ================== BİLEŞENLER ================== */
        .btn {
            border-radius: var(--r-sm);
            font-weight: 600;
            letter-spacing: -.01em;
            transition: transform .16s var(--ease), box-shadow .16s var(--ease), background-color .16s var(--ease), color .16s var(--ease);
        }
        .btn:hover { transform: translateY(-1px); }
        .btn:active { transform: translateY(0) scale(.98); }
        .btn-primary {
            background: var(--accent-gradient);
            border: none;
            box-shadow: 0 6px 16px rgba(0, 158, 247, .26);
        }
        .btn-primary:hover, .btn-primary:focus {
            background: var(--accent-gradient);
            filter: brightness(1.06);
            box-shadow: 0 10px 22px rgba(0, 158, 247, .32);
        }
        .btn-sm { padding: .45rem .85rem; font-size: .82rem; }
        .rounded-pill { border-radius: 99px !important; }

        .form-control, .form-select, .input-group-text {
            border-radius: var(--r-sm);
            border-color: var(--border-color);
            transition: border-color .18s var(--ease), box-shadow .18s var(--ease), background-color .18s var(--ease);
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--metro-primary);
            box-shadow: var(--ring);
        }
        .form-control::placeholder { color: color-mix(in srgb, var(--text-secondary) 75%, transparent); }

        .card { border-radius: var(--r-lg); border-color: var(--border-color); }

        .dropdown-menu {
            border-radius: var(--r-md);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-md);
            padding: 6px;
            background: var(--bg-card);
        }
        .dropdown-item { border-radius: var(--r-xs); padding: .55rem .75rem; font-size: .88rem; }
        .dropdown-item:hover { background: var(--metro-primary-light); color: var(--metro-primary); }
        .dropdown-menu .dropdown-item.active-db {
            background: var(--accent-gradient) !important;
            box-shadow: 0 4px 12px rgba(0, 158, 247, .3);
        }

        .modal-content { border-radius: var(--r-xl); box-shadow: var(--shadow-lg); }
        .modal-header, .modal-footer { padding: 1.1rem 1.4rem; }
        .modal-body { padding: 1.4rem; }
        .modal-backdrop.show { opacity: .5; }

        .badge { border-radius: 7px; font-weight: 600; letter-spacing: -.01em; }

        .alert { border-radius: var(--r-md); border: 1px solid var(--border-color); }

        /* ================== MOBİL ================== */
        @@media (max-width: 991px) {
            .sidebar { box-shadow: var(--shadow-lg); }
            .main-content { --icerik-dolgu: 16px; padding: 0 0 16px 0 !important; }
            .toolbar-container { position: static; }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: .01ms !important;
                transition-duration: .01ms !important;
                scroll-behavior: auto !important;
            }
        }

        /* ================= SAYFA YAKINLASTIRMA ================= */
        /* Yazdirirken ekran zoom'u kagida yansimasin. */
        @@media print {
            html { zoom: 1 !important; --zoom: 1 !important; }
        }

        /* ================= ZOOM ALTINDA TAM EKRAN KATMANLAR ================= */
        /* Bootstrap golge katmani 100vw x 100vh ile boyutlanir. CSS zoom'da vw/vh
           zoom ile carpilir, % carpilmaz: zoom %60'ta golge ekranin sol ustunde
           %60'lik bir kare olarak kaliyordu. Sabit konumlu katmanlarda % kullanilir. */
        .modal-backdrop,
        .offcanvas-backdrop {
            width: 100% !important;
            height: 100% !important;
        }

        /* ================= SAYFA BOYU KISITLAMASI YOK ================= */
        /* Raporlardaki tablo kutulari (max-height: 400px / 60vh, DataTables
           scrollY vb.) kendi icinde kaydirmasin; icerige gore uzasin ve sayfa
           en alta kadar kaysin. Inline stiller de !important ile ezilir.
           Modal ve acilir menuler kapsam disidir. */
        .main-content div:has(table):not(.modal *):not(.dropdown-menu):not(.dropdown-menu *),
        .main-content .table-responsive:not(.modal *),
        .main-content .dataTables_scrollBody {
            max-height: none !important;
            height: auto !important;
        }
        /* Bazi raporlar body kaydirmasini kapatiyor; sayfa her zaman kayabilsin. */
        body:not(.modal-open) { overflow-y: auto !important; }

        /* ================= ACILIR LISTE ILK KARE ================= */
        /* Popper / bootstrap-select (container:'body') / Select2 acilir
           listeleri once eklenip bir sonraki karede konumlanir; o tek karede
           sayfanin basinda gorunuyordu. Acildiktan sonraki ilk 80ms boyunca
           saydam tutulur (opacity: odak ve olcum etkilenmez), sonra gorunur. */
        .dropdown-menu.show,
        .bs-container.show .dropdown-menu,
        .select2-container--open .select2-dropdown {
            animation: acilirIlkKare .08s step-end;
        }
        @@keyframes acilirIlkKare { from { opacity: 0; } to { opacity: 1; } }
        #zoomKontrol { display: flex; align-items: center; gap: 2px; }
        #zoomKontrol .icon-btn { width: 32px; height: 42px; }
        #zoomKontrol .icon-btn i { font-size: .8rem; }
        #zoomKontrol #zoomSifirlaBtn {
            width: auto; min-width: 48px; padding: 0 6px;
            font-size: .78rem; font-weight: 600; font-variant-numeric: tabular-nums;
        }
        #zoomKontrol .icon-btn:disabled { opacity: .35; cursor: default; }
        @@media (max-width: 768px) { #zoomKontrol { display: none; } }
    </style>

    <!-- Portal teması (açık): yüzen dock menü, cam üst çubuk, yumuşak zemin — wwwroot/css/portal-tema.css -->
    <link rel="stylesheet" href="~/css/portal-tema.css" asp-append-version="true" />
    <!-- Grup ERP Portalı teması: sabit beyaz sol menü (düz modül listesi), selam/tarih/arama çubuğu — wwwroot/css/grup-erp-tema.css -->
    <link rel="stylesheet" href="~/css/grup-erp-tema.css" asp-append-version="true" />
    <!-- Rapor teması: tüm rapor ekranlarında Inter yazı tipi, tek palet, durum rozetleri — wwwroot/css/rapor-tema.css -->
    <link rel="stylesheet" href="~/css/rapor-tema.css" asp-append-version="true" />
    <script>window.KM_SABIT_MENU = true;   // kenar menü sabit (daralıp genişlemez)</script>

    @RenderSection("Styles", required: false)

    <style>
        /* ============ SEKME KABUGU (talep 35) ============ */

        /* Sekme icinde acilan sayfada kabuk gizlenir.
           Iki olcut de gecerlidir: sunucudan gelen "_sekme" isareti (ilk yukleme)
           ve cerceve icinde olma (sekme icindeki her turlu gezinme). */
        body.sekme-icinde .sidebar,
        body.sekme-icinde .top-header,
        body.sekme-icinde #sekmeCubugu,
        body.sekme-icinde #gorevCubugu,
        body.sekme-icinde #sekmeCerceveler,
        html.cerceve-icinde .sidebar,
        html.cerceve-icinde .top-header,
        html.cerceve-icinde #sekmeCubugu,
        html.cerceve-icinde #gorevCubugu,
        html.cerceve-icinde #sekmeCerceveler { display: none !important; }
        /* Bakim bandi yalnizca ust kabukta; sekme icindeki sayfada tekrar gosterilmez. */
        html.cerceve-icinde #maintenance-banner { display: none !important; }

        /* Bosluk cift saymasin.
           Cozum: dolguyu CERCEVEDEKI sayfa verir, kabuk vermez.
           Iframe kabugun dolgusundan disari tasirilir (asagida
           #sekmeCerceveler negatif marjla kenarlara dayanir), cercevedeki
           sayfa ise kendi normal dolgusunu korur. Boylece rapor, dashboard
           ile birebir ayni hizada baslar; menu ile arasinda fazladan bosluk
           kalmaz. Yalnizca sol marj sifirlanir (menu kabukta, cercevede yok). */
        body.sekme-icinde .main-content,
        html.cerceve-icinde .main-content {
            margin-left: 0 !important;
            width: 100% !important;
        }

        /* ASIL BOSLUK BURADAN GELIYORDU:
           .page-container { margin-left: var(--sidebar-width) } yani 80px.
           Menuyu display:none ile gizlemek bu marji kaldirmiyor; cerceve
           icinde solda 80px bos serit kaliyordu. Kucuk ekran medya sorgusu
           (max-width) bunu zaten sifirladigi icin sorun yalnizca masaustunde
           gorunuyordu. Cerceve icinde marj ve genislik acikca sifirlanir.
           .sidebar.expanded ~ .page-container kurali daha ozgul oldugu icin
           o bicim de ayrica ezilir. */
        html.cerceve-icinde .page-container,
        html.cerceve-icinde .sidebar.expanded ~ .page-container,
        body.sekme-icinde .page-container,
        body.sekme-icinde .sidebar.expanded ~ .page-container {
            margin-left: 0 !important;
            width: 100% !important;
        }

        html.cerceve-icinde body,
        body.sekme-icinde {
            margin: 0 !important;
            padding-bottom: 0 !important;
        }

        /* Ust sekme cubugu */
        #sekmeCubugu {
            display: flex; align-items: stretch; gap: 4px;
            padding: 6px 8px 0 8px; overflow-x: auto; overflow-y: hidden;
            border-bottom: 2px solid #dee2e6; background: #f1f3f5;
            /* .main-content'in ust/yan dolgusu sifir oldugundan cubuk zaten
               kenarlara oturur; negatif marj gerekmez (tasma olmasin). */
            margin: 0 0 12px 0;
        }
        /* Sekme basligindaki yuklenme gostergesi (tarayici sekmesi gibi) */
        .sekme .donen {
            width: 12px; height: 12px; flex: 0 0 12px; margin-right: 2px;
            border: 2px solid rgba(0,0,0,.18); border-top-color: #0d6efd;
            border-radius: 50%; display: none; animation: sekmeDon .7s linear infinite;
        }
        .sekme.mesgul .donen { display: inline-block; }
        @@keyframes sekmeDon { to { transform: rotate(360deg); } }

        .gorev .donen {
            width: 10px; height: 10px; flex: 0 0 10px; margin-right: 4px;
            border: 2px solid rgba(255,255,255,.25); border-top-color: #74b0ff;
            border-radius: 50%; display: none; animation: sekmeDon .7s linear infinite;
        }
        .gorev.mesgul .donen { display: inline-block; }

        #sekmeCubugu::-webkit-scrollbar { height: 5px; }
        #sekmeCubugu::-webkit-scrollbar-thumb { background: #ced4da; border-radius: 3px; }

        .sekme {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 7px 10px; font-size: 12.5px; font-weight: 600; white-space: nowrap;
            background: #e9ecef; color: #495057; cursor: pointer;
            border: 1px solid #dee2e6; border-bottom: none;
            border-radius: 7px 7px 0 0; max-width: 260px;
        }
        .sekme:hover { background: #dfe4ea; }
        .sekme.aktif { background: #fff; color: #0d6efd; border-color: #dee2e6; box-shadow: 0 -2px 0 0 #0d6efd inset; }
        /* Baska sirkete sabitlenmis sekme (adresinde db var): turuncu; ust cubuktaki
           sirket degisse de bu sekme degismez. */
        .sekme.sabit { background: #fff3e0; color: #9a3412; border-color: #fdba74; }
        .sekme.sabit:hover { background: #ffe8cc; }
        .sekme.sabit.aktif { background: #fff7ed; color: #c2410c; box-shadow: 0 -2px 0 0 #f97316 inset; }
        .sekme.sabit .sabit-ikon { color: #f97316; font-size: 11px; }
        .gorev.sabit { background: #7c2d12; }
        .sekme .ad { overflow: hidden; text-overflow: ellipsis; }
        .sekme .dugme {
            border: 0; background: transparent; color: #868e96; line-height: 1;
            padding: 0 2px; font-size: 12px; cursor: pointer; border-radius: 3px;
        }
        .sekme .dugme:hover { background: rgba(0,0,0,.12); color: #212529; }

        .gorev .dugme {
            border: none; background: transparent; color: #adb5bd; cursor: pointer;
            line-height: 1; padding: 0 3px; margin-left: 4px; border-radius: 3px; font-size: 13px;
        }
        .gorev .dugme:hover { background: rgba(255,255,255,.15); color: #fff; }

        /* Sekme govdeleri: kabugun .main-content dolgusundan disari tasar ki
           cercevedeki sayfa menuye sifir hizada otursun. */
        #sekmeCerceveler {
            position: relative;
            /* Yan dolgu sifir: yalnizca alt dolgu kadar disari tasar ki cerceve tabana insin. */
            margin-left: 0;
            margin-right: 0;
            margin-bottom: calc(-1 * var(--icerik-dolgu, clamp(16px, 2.2vw, 32px)));
        }
        /* Zemin cercevedeki sayfanin kendisinden gelsin; iframe kendi rengini basmasin. */
        .sekme-cerceve { width: 100%; border: 0; display: block; background: transparent; }

