            $('#refreshBtn').click(() => { startPageLoader(); window.location.reload(true); });

            // ---- Sekmeli gorunum ac/kapa ------------------------------------
            // Tercih kisiye baglidir (Z_KullaniciTercih / SekmeKapali).
            // Kapatilinca kayitli sekmeler de temizlenir ki acildiginda
            // kullaniciyi eski sekmeler karsilamasin.
            $('#sekmeModuBtn').click(function () {
                var suAnKapali = $(this).data('kapali') === 1 || $(this).data('kapali') === '1';
                var yeniDeger = suAnKapali ? '0' : '1';

                var veri = new FormData();
                veri.append('anahtar', 'SekmeKapali');
                veri.append('deger', yeniDeger);

                fetch('/Home/KullaniciTercihKaydet', { method: 'POST', body: veri })
                    .then(function () {
                        if (yeniDeger === '1') { try { localStorage.removeItem('portalSekmeler'); } catch (e) {} }
                        window.location.href = '/';
                    })
                    .catch(function () { toastr.error('Tercih kaydedilemedi.'); });
            });

            // Hızlı arama: eskiden her tuşta bütün satırların metni yeniden okunup satır satır toggle ediliyordu;
            // büyük tablolarda her satır ayrı reflow yaratıp yazmayı geciktiriyordu. Şimdi satır metinleri bir kez
            // önbelleğe alınır, arama 120 ms gecikmeli çalışır ve görünürlük tek karede topluca uygulanır.
            (function () {
                var zamanlayici = null, onbellek = null, onbellekTablo = null;
                function satirlar() {
                    var govde = document.querySelector('.rapor-tablo tbody');
                    if (!govde) return [];
                    var n = govde.rows.length;
                    var gecerli = onbellek && onbellekTablo === govde && onbellek.length === n
                        && (n === 0 || (onbellek[0].tr === govde.rows[0] && onbellek[n - 1].tr === govde.rows[n - 1]));
                    if (gecerli) return onbellek;
                    onbellekTablo = govde;
                    onbellek = Array.prototype.map.call(govde.rows, function (tr) { return { tr: tr, metin: (tr.textContent || '').toLowerCase() }; });
                    return onbellek;
                }
                function uygula(q) {
                    var liste = satirlar();
                    window.requestAnimationFrame(function () {
                        for (var i = 0; i < liste.length; i++) {
                            var tr = liste[i].tr, gizle = q && liste[i].metin.indexOf(q) < 0;
                            if (gizle) { if (tr.style.display !== 'none') tr.style.display = 'none'; }
                            else if (tr.style.display === 'none') tr.style.display = '';
                        }
                    });
                }
                $('#quickSearchInput').on('input', function (e) {
                    var q = (e.target.value || '').toLowerCase().trim();
                    clearTimeout(zamanlayici);
                    zamanlayici = setTimeout(function () { uygula(q); }, 120);
                });
            })();

            $('#clearFiltersBtn').click(() => {
                $('.filter-select-bs').selectpicker('val', '');
                $('.filter-row input').val('');
                if(window.clearReportFilters) window.clearReportFilters();
                else if(window.filterTableAndRender) window.filterTableAndRender();
                else if(window.filterTable) window.filterTable();
                else $('.rapor-tablo tbody tr').css('display', '');
                $('#quickSearchInput').val('').trigger('input');
                toastr.success('Filtreler temizlendi.');
            });

            $('#exportExcelBtn').click(() => {
                const table = document.querySelector('.rapor-tablo');
                if(!table) return toastr.error("Tablo bulunamadı.");
                toastr.info("Excel hazırlanıyor...");

                const headerRow = table.querySelector('thead tr:first-child');
                const allRows = Array.from(table.querySelectorAll('tr'));
                const dataRows = allRows.filter(row => !row.classList.contains('filter-row'));
                const headers = Array.from(headerRow.querySelectorAll('th:not([style*="display: none"])'));

                const workbook = XLSX.utils.book_new();
                const worksheet = XLSX.utils.aoa_to_sheet([]);

                const headerTexts = headers.map(th => th.textContent.trim());
                XLSX.utils.sheet_add_aoa(worksheet, [headerTexts], { origin: "A1" });

                const data = dataRows.slice(1).map(row => {
                    const visibleCells = Array.from(row.querySelectorAll('td')).filter(td => td.style.display !== 'none');
                    return visibleCells.map((cell, cellIndex) => {
                        const header = headers[cellIndex];
                        const value = cell.textContent.trim();
                        if (header && header.dataset.sortType === 'number') return parseTurkishNumber(value);
                        else if (header && header.dataset.sortType === 'date' && value) {
                            const parts = value.split('.');
                            if (parts.length === 3) return new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));
                        }
                        return value;
                    });
                });

                XLSX.utils.sheet_add_aoa(worksheet, data, { origin: "A2" });
                XLSX.utils.book_append_sheet(workbook, worksheet, "Rapor");
                const pageTitle = document.title.replace(' - Rapor Sistemi', '').trim();
                XLSX.writeFile(workbook, `${pageTitle.replace(/[^a-z0-9]/gi, '_') || 'rapor_data'}.xlsx`);
            });
            
            const columnManagerList = document.getElementById('column-manager-list');
            window.currentColumnConfig = null;

            function makeColumnsResizable() {
                const tables = document.querySelectorAll('.rapor-tablo');
                if (!tables.length) return;
                tables.forEach(table => {
                    const headers = table.querySelectorAll('thead tr:first-child th');
                    headers.forEach((header) => {
                        if (header.querySelector('.resizable-column-handle')) { return; }
                        const handle = document.createElement('div');
                        handle.classList.add('resizable-column-handle');
                        // Baslik zaten konumlandirilmissa (rapor tablolarinda
                        // position: sticky) dokunma; relative'e cevirmek
                        // yapiskan basligi bozuyordu.
                        if (getComputedStyle(header).position === 'static') {
                            header.style.position = 'relative';
                        }
                        header.appendChild(handle);
                        let isResizing = false, startX = 0, startWidth = 0;

                        const onMouseMove = function (e) {
                            if (!isResizing) return;
                            const newWidth = startWidth + (e.clientX - startX);
                            if (newWidth > 30) {
                                header.style.width = `${newWidth}px`;
                                header.style.minWidth = `${newWidth}px`;
                                header.style.maxWidth = `${newWidth}px`;
                            }
                        };

                        const onMouseUp = function () {
                            if (!isResizing) return;
                            isResizing = false;
                            // Bu kolonun genisligini kullanici belirledi: otomatik
                            // genislik hesabi artik buraya dokunmasin.
                            header.dataset.elleAyarlandi = '1';
                            document.body.style.userSelect = '';
                            document.removeEventListener('mousemove', onMouseMove);
                            document.removeEventListener('mouseup', onMouseUp);
                        };

                        // Tutamactaki tiklama baslik hucresine cikmasin. Aksi halde
                        // her genisletme ayni zamanda siralamayi tetikliyor, tablo
                        // yeniden ciziliyor ve yeni genislik siliniyordu.
                        handle.addEventListener('click', function (e) { e.stopPropagation(); });
                        handle.addEventListener('dblclick', function (e) { e.stopPropagation(); });

                        handle.addEventListener('mousedown', function (e) {
                            isResizing = true;
                            startX = e.clientX;
                            startWidth = header.offsetWidth;
                            e.preventDefault();
                            document.body.style.userSelect = 'none';
                            document.addEventListener('mousemove', onMouseMove);
                            document.addEventListener('mouseup', onMouseUp);
                        });
                    });
                });
            }

            window.manageReportColumns = function () {
                const table = document.querySelector('.rapor-tablo');
                if (!table) return toastr.error('Tablo bulunamadı.', 'Hata!');
                const mainHeaders = table.querySelectorAll('thead tr:first-child th');
                columnManagerList.innerHTML = '';

                mainHeaders.forEach((header, index) => {
                    const isHidden = header.style.display === 'none';
                    const isDraggable = !header.classList.contains('no-drag');
                    const headerText = (header.querySelector('.header-content') || header).textContent.trim() || 'Kolon ' + (index + 1);

                    const li = document.createElement('li');
                    li.classList.add('d-flex', 'align-items-center', 'justify-content-between', 'list-group-item', 'border-bottom', 'py-3');
                    li.textContent = headerText;
                    li.draggable = isDraggable;
                    li.dataset.colIndex = index;
                    li.dataset.columnName = header.dataset.column;
                    if (!isDraggable) li.classList.add('disabled-drag', 'text-muted');

                    const checkboxContainer = document.createElement('div');
                    checkboxContainer.classList.add('form-check', 'form-switch', 'form-check-custom', 'form-check-solid', 'mb-0');
                    const checkbox = document.createElement('input');
                    checkbox.classList.add('form-check-input');
                    checkbox.type = 'checkbox';
                    checkbox.checked = !isHidden;
                    checkboxContainer.appendChild(checkbox);
                    li.appendChild(checkboxContainer);
                    columnManagerList.appendChild(li);
                });

                let draggedItem = null;
                columnManagerList.ondragstart = (e) => {
                    if (e.target.draggable) {
                        draggedItem = e.target;
                        setTimeout(() => e.target.classList.add('opacity-50'), 0);
                    }
                };
                columnManagerList.ondragover = (e) => { e.preventDefault(); };
                columnManagerList.ondrop = (e) => {
                    e.preventDefault();
                    const dropTarget = e.target.closest('li');
                    if (draggedItem && dropTarget && dropTarget !== draggedItem && !dropTarget.classList.contains('disabled-drag')) {
                        if (e.clientY > dropTarget.getBoundingClientRect().y + dropTarget.offsetHeight / 2) {
                            columnManagerList.insertBefore(draggedItem, dropTarget.nextSibling);
                        } else {
                            columnManagerList.insertBefore(draggedItem, dropTarget);
                        }
                    }
                    if(draggedItem) draggedItem.classList.remove('opacity-50');
                    draggedItem = null;
                };
                columnManagerList.ondragend = () => { if (draggedItem) draggedItem.classList.remove('opacity-50'); draggedItem = null; };

                $('#columnManagerModal').modal('show');
            };

            $('#manageColumnsBtn').click(window.manageReportColumns);

            $('#saveColumnsBtn').click(function () {
                const listItems = Array.from(columnManagerList.querySelectorAll('li'));
                const newConfig = listItems.map((item, newIndex) => ({
                    originalIndex: parseInt(item.dataset.colIndex),
                    newIndex: newIndex,
                    visible: item.querySelector('input[type="checkbox"]').checked,
                    columnName: item.dataset.columnName
                }));
                window.applyColumnConfig(newConfig);
                localStorage.setItem(`columnConfig_${window.location.pathname}`, JSON.stringify(newConfig));
                $('#columnManagerModal').modal('hide');
                toastr.success('Sütun ayarları kaydedildi.');
            });

            window.applyColumnConfig = function (config) {
                const table = document.querySelector('.rapor-tablo');
                if (!table) return;

                const sortedConfig = [...config].sort((a, b) => a.newIndex - b.newIndex);
                window.currentColumnConfig = sortedConfig;

                const theadRow = table.querySelector('thead tr:first-child');
                const filterRow = table.querySelector('thead tr.filter-row');
                const originalHeaders = new Map(Array.from(theadRow.children).map((el, i) => [i, el]));
                const originalFilterCells = new Map(Array.from(filterRow?.children || []).map((el, i) => [i, el]));
                const newHeadersFragment = document.createDocumentFragment();
                const newFilterRowFragment = document.createDocumentFragment();

                sortedConfig.forEach(item => {
                    const header = originalHeaders.get(item.originalIndex);
                    const filterCell = originalFilterCells.get(item.originalIndex);
                    if (header) { header.style.display = item.visible ? '' : 'none'; newHeadersFragment.appendChild(header); }
                    if (filterCell) { filterCell.style.display = item.visible ? '' : 'none'; newFilterRowFragment.appendChild(filterCell); }
                });

                theadRow.innerHTML = ''; theadRow.appendChild(newHeadersFragment);
                if (filterRow) { filterRow.innerHTML = ''; filterRow.appendChild(newFilterRowFragment); }

                const tbody = table.querySelector('tbody');
                if (tbody) {
                    Array.from(tbody.rows).forEach(row => {
                        const originalCells = Array.from(row.cells);
                        const newRowFragment = document.createDocumentFragment();
                        sortedConfig.forEach(item => {
                            const cell = originalCells[item.originalIndex];
                            if (cell) { cell.style.display = item.visible ? '' : 'none'; newRowFragment.appendChild(cell); }
                        });
                        row.innerHTML = ''; row.appendChild(newRowFragment);
                    });
                }
                window.dispatchEvent(new Event('columnConfigUpdated'));
            };

            function loadAndApplyColumnConfig() {
                const table = document.querySelector('.rapor-tablo');

                // Bazi raporlar (or. Cek Akibeti) kendi sutun duzenini kendisi
                // kuruyor. Buradaki gecikmeli yukleyici onlarin ayarini "hepsi
                // gorunur, orijinal sira" ile eziyordu; artik karismiyor.
                if (window.sayfaKolonlariniKendiYonetir) {
                    makeColumnsResizable();
                    return;
                }

                const savedConfig = localStorage.getItem(`columnConfig_${window.location.pathname}`);
                
                function createInitialConfig() {
                    if (!table) return [];
                    return Array.from(table.querySelectorAll('thead tr:first-child th')).map((header, index) => ({ originalIndex: index, newIndex: index, visible: true, columnName: header.dataset.column }));
                }

                if (savedConfig) {
                    try { window.applyColumnConfig(JSON.parse(savedConfig)); } 
                    catch (e) { window.applyColumnConfig(createInitialConfig()); }
                } else {
                    window.applyColumnConfig(createInitialConfig());
                }
                makeColumnsResizable();
            }

            const columnWidthsContainer = document.getElementById('column-widths-container');

            window.manageReportColumnWidths = function () {
                const table = document.querySelector('.rapor-tablo');
                if (!table) return toastr.error('Tablo bulunamadı.', 'Hata!');

                const headers = table.querySelectorAll('thead tr:first-child th');
                columnWidthsContainer.innerHTML = '';

                headers.forEach((header, index) => {
                    if (header.style.display === 'none') return;

                    const headerText = (header.querySelector('.header-content') || header).textContent.trim() || 'Kolon ' + (index + 1);
                    let currentWidth = header.style.width ? parseInt(header.style.width) : '';

                    const div = document.createElement('div');
                    div.classList.add('col-md-6', 'col-lg-4');
                    div.innerHTML = `
                        <div class="d-flex align-items-center justify-content-between p-3 rounded border border-gray-300" style="background:var(--bg-card)">
                            <div class="form-check form-check-custom form-check-solid mb-0 me-2 text-truncate">
                                <input class="form-check-input width-auto-check" type="checkbox" id="width-toggle-${index}" data-col-index="${index}">
                                <label class="form-check-label fw-bold text-dark" for="width-toggle-${index}" title="${headerText}">${headerText}</label>
                            </div>
                            <div class="d-flex align-items-center">
                                <span class="small text-muted me-2">px</span>
                                <input type="number" class="form-control form-control-sm form-control-solid width-manual-input" id="width-input-${index}" data-col-index="${index}" value="${currentWidth}" placeholder="Oto" style="width: 75px;">
                            </div>
                        </div>
                    `;
                    columnWidthsContainer.appendChild(div);

                    const checkbox = div.querySelector(`#width-toggle-${index}`);
                    const input = div.querySelector(`#width-input-${index}`);

                    checkbox.addEventListener('change', function() {
                        if(this.checked) {
                            input.value = ''; input.disabled = true; input.placeholder = "Oto";
                        } else {
                            input.disabled = false; input.placeholder = "Oto";
                        }
                    });
                });

                $('#columnWidthsModal').modal('show');
            };

            $('#manageColumnWidthsBtn').click(window.manageReportColumnWidths);

            $('#autoFitBtn').click(function() {
                const table = document.querySelector('.rapor-tablo');
                if (!table) return;

                toastr.info('Genişlikler Hesaplanıyor...');
                const headers = table.querySelectorAll('thead th');
                const rowsToCheck = Array.from(table.querySelectorAll('tbody tr')).slice(0, 50);

                headers.forEach((header, index) => {
                    if (header.style.display === 'none') return;
                    const checkbox = columnWidthsContainer.querySelector(`input[type="checkbox"][data-col-index="${index}"]`);
                    const input = columnWidthsContainer.querySelector(`input[type="number"][data-col-index="${index}"]`);
                    let finalWidth = 0;

                    if (checkbox && checkbox.checked) {
                        let maxWidth = 0;
                        const headerContent = header.cloneNode(true);
                        headerContent.style.width = 'auto'; headerContent.style.display = 'inline-block'; headerContent.style.visibility = 'hidden'; headerContent.style.position = 'absolute';
                        document.body.appendChild(headerContent);
                        maxWidth = headerContent.offsetWidth;
                        document.body.removeChild(headerContent);

                        rowsToCheck.forEach(row => {
                            const cells = row.querySelectorAll('td');
                            if (cells[index]) {
                                const tempDiv = document.createElement('div');
                                tempDiv.style.position = 'absolute'; tempDiv.style.visibility = 'hidden'; tempDiv.style.whiteSpace = 'nowrap'; tempDiv.style.font = getComputedStyle(cells[index]).font; tempDiv.textContent = cells[index].textContent.trim();
                                document.body.appendChild(tempDiv);
                                maxWidth = Math.max(maxWidth, tempDiv.offsetWidth);
                                document.body.removeChild(tempDiv);
                            }
                        });
                        finalWidth = maxWidth + 30; // Extra padding for Metronic
                    }
                    else if (input && input.value && parseInt(input.value) > 0) finalWidth = parseInt(input.value);
                    else {
                        const currentStyleWidth = header.style.width ? parseInt(header.style.width) : 0;
                        finalWidth = currentStyleWidth > 50 ? currentStyleWidth : 120;
                    }

                    header.style.width = `${finalWidth}px`; header.style.minWidth = `${finalWidth}px`; header.style.maxWidth = `${finalWidth}px`;
                });

                $('#columnWidthsModal').modal('hide');
                toastr.success('Genişlikler başarıyla ayarlandı.');
            });

            $('#resetWidthsBtn').click(() => {
                document.querySelectorAll('.rapor-tablo thead th').forEach(header => { header.style.width = ''; header.style.minWidth = ''; header.style.maxWidth = ''; });
                $('#columnWidthsModal').modal('hide');
                toastr.success('Genişlikler sıfırlandı.');
            });

            $('#selectAllWidthsBtn').click(() => $('.width-auto-check').prop('checked', true).trigger('change'));
            $('#unselectAllWidthsBtn').click(() => $('.width-auto-check').prop('checked', false).trigger('change'));

            setTimeout(loadAndApplyColumnConfig, 100);

            // =========================================================================
            // FAVORİ MENÜ EKLE/ÇIKAR AJAX VE DİNAMİK GÜNCELLEME (SAYFA YENİLENMEZ)
            // =========================================================================
            $(document).on('click', '.toggle-favorite-btn', function(e) {
                e.preventDefault(); 
                e.stopPropagation(); 

                var $clickedIcon = $(this);
                var menuId = $clickedIcon.data('id');
                var isCurrentlyFavorite = $clickedIcon.hasClass('is-favorite');

                // O anki menüye ait ekranda kaç tane yıldız varsa (Favorilerde ve Normal listede) hepsini bul
                var $allMatchingIcons = $('.toggle-favorite-btn[data-id="' + menuId + '"]');

                // 1. Arayüzü ANINDA Güncelle (Sayfa yenilenmesini beklemeden)
                if (isCurrentlyFavorite) {
                    $allMatchingIcons.removeClass('is-favorite').attr('title', 'Favorilere Ekle');
                    // Menüyü Favorilerim listesinden anında sil
                    $('#submenu_favorites').find('.toggle-favorite-btn[data-id="' + menuId + '"]').closest('li').remove();
                    // Eğer favoriler listesi tamamen boşaldıysa "Favorilerim" ana başlığını gizle
                    if ($('#submenu_favorites li').length === 0) {
                        $('#favorites-menu-container').hide();
                    }
                } else {
                    $allMatchingIcons.addClass('is-favorite').attr('title', 'Favorilerden Çıkar');
                    // Normal menüdeki li öğesini kopyala ve Favorilerim listesine ekle
                    var $originalLi = $('.sidebar-menu > li:not(#favorites-menu-container) .toggle-favorite-btn[data-id="' + menuId + '"]').closest('li');
                    
                    if ($originalLi.length > 0 && $('#submenu_favorites .toggle-favorite-btn[data-id="' + menuId + '"]').length === 0) {
                        var $clonedLi = $originalLi.clone();
                        $('#submenu_favorites').append($clonedLi);
                        // Favoriler listesinde artık eleman olduğu için başlığı görünür yap
                        $('#favorites-menu-container').show();
                    }
                }

                // 2. Arka Plana (C# Controller'a) Sessizce Kaydet
                var token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value;

                $.ajax({
                    url: '/Home/ToggleFavoriteMenu', 
                    type: 'POST',
                    data: { 
                        menuId: menuId, 
                        __RequestVerificationToken: token 
                    },
                    success: function(response) {
                        if(response.success) {
                            toastr.success(isCurrentlyFavorite ? "Favorilerden çıkarıldı." : "Favorilere eklendi.");
                        } else {
                            // C# tarafında hata olursa işlemleri UI'da geri al
                            if (isCurrentlyFavorite) {
                                $allMatchingIcons.addClass('is-favorite');
                            } else {
                                $allMatchingIcons.removeClass('is-favorite');
                            }
                            toastr.error("İşlem başarısız oldu: " + response.message);
                        }
                    },
                    error: function() {
                        // Sunucu hatasında işlemleri UI'da geri al
                        if (isCurrentlyFavorite) {
                            $allMatchingIcons.addClass('is-favorite');
                        } else {
                            $allMatchingIcons.removeClass('is-favorite');
                        }
                        toastr.error("Sunucu ile iletişim kurulamadı.");
                    }
                });
            });
        });
    </script>

    <!-- ========================================================== -->
    <!-- GERÇEK ZAMANLI BAKIM KONTROLÜ VE TAM EKRAN KİLİT (SÜRÜM NOTLARI DESTEKLİ) -->
    <!-- ========================================================== -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Sekme icinde (iframe) acilan sayfada bakim kontrolu YAPILMAZ: bant ve kilit ekrani
            // ust kabukta bir kez gosterilir; aksi halde uyari her sekmede ayrica cikip ikiye katlaniyordu.
            try { if (window.self !== window.top) return; } catch (e) { return; }
            const banner = document.getElementById("maintenance-banner");
            const timerElement = document.getElementById("countdown-timer");
            const msgElement = document.getElementById("maintenance-msg");
            const isAdmin = @(User.FindFirst("UserAuthority")?.Value == "A" ? "true" : "false");
            
            let maintenanceTargetTime = null;
            let maintenanceTimerInterval = null;

            // Zamanlayıcıyı ekranda güncelleyen fonksiyon
            function updateTimerDisplay(relNotes) {
                if (!maintenanceTargetTime) return;
                
                var now = new Date().getTime();
                var distance = maintenanceTargetTime - now;

                if (distance > 0) {
                    var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                    var seconds = Math.floor((distance % (1000 * 60)) / 1000);

                    let timeStr = (hours > 0 ? hours + "s " : "") + minutes + "d " + seconds + "sn";
                    timerElement.innerHTML = timeStr;
                } else {
                    // SÜRE DOLDU!
                    if (isAdmin) {
                        timerElement.innerHTML = "PUBLISH İŞLEMİNİ YAPABİLİRSİNİZ";
                        timerElement.classList.replace("text-danger", "text-dark");
                        timerElement.classList.replace("bg-white", "bg-warning");
                    } else {
                        showLockScreen(relNotes);
                    }
                }
            }

            // Kilitleme ekranını çizen fonksiyon (Sürüm Notları Destekli)
            function showLockScreen(relNotes) {
                if (!document.getElementById("full-screen-lock")) {
                    var notesHtml = relNotes ? `
                        <div style="margin-top:20px; padding:15px; background:rgba(255, 255, 255, 0.05); border-radius:8px; border:1px solid rgba(255, 255, 255, 0.1); max-width:600px; width:90%; text-align:left;">
                            <h6 style="color:#FFC700; font-weight:700; margin-bottom:10px;"><i class="fas fa-sparkles me-2"></i>Bu Güncellemede Neler Yeni?</h6>
                            <div style="color:#9899ac; font-size:0.9rem; white-space:pre-line; line-height:1.5;">${relNotes}</div>
                        </div>` : '';

                    var lockScreen = document.createElement("div");
                    lockScreen.id = "full-screen-lock";
                    lockScreen.innerHTML = `
                        <div style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(21, 21, 33, 0.98); z-index:999999; display:flex; flex-direction:column; align-items:center; justify-content:center; color:white; backdrop-filter: blur(5px);">
                            <i class="fas fa-cogs fa-4x mb-4 text-warning" style="animation: spin 3s linear infinite;"></i>
                            <h1 class="text-danger fw-bolder mb-3" style="font-size: 2.5rem;">SİSTEM BAKIMA ALINDI</h1>
                            <p class="fs-4 text-center px-4" style="color: #9899ac;">Şu anda sisteme yeni bir versiyon yüklenmektedir.</p>
                            ${notesHtml}
                            <p class="fs-5 text-center text-muted mt-4">Lütfen sayfayı kapatmayınız. İşlem bittiğinde sayfanız otomatik olarak açılacaktır...</p>
                        </div>
                        <style>
                            @@keyframes spin { 100% { transform: rotate(360deg); } }
                            body { overflow: hidden !important; pointer-events: none; user-select: none; }
                            #full-screen-lock { pointer-events: auto; }
                        
        /* Acik menu: arkasini bulaniklastir ve sag kenara ince bir ayirici koy.
           Yalnizca ACIK temada; koyu temada menu opak kalir. */
        :root:not([data-theme="dark"]) .sidebar {
            -webkit-backdrop-filter: saturate(1.2) blur(14px);
            backdrop-filter: saturate(1.2) blur(14px);
            border-right: 1px solid rgba(15, 23, 42, .06);
        }
        /* Acik zeminde aktif satir daha okunakli olsun */
        :root:not([data-theme="dark"]) .sidebar-link.active {
            font-weight: 600;
        }

        /* ---- Menu KAPALIYKEN: butun ikonlar ekrana sigsin ----
           Genis satir araliklari yuzunden alttaki ikonlar tasiyordu.
           Acik (genisletilmis) durumda olculer degismez. */
        .sidebar:not(.expanded) .sidebar-menu {
            padding: 8px 8px 12px;
        }
        .sidebar:not(.expanded) .sidebar-link {
            padding: 9px 0;
            margin-bottom: 2px;
            justify-content: center;
        }
        .sidebar:not(.expanded) .sidebar-link i {
            width: auto;
            font-size: 1.1rem;
        }
        /* Kapaliyken alt menuler yer kaplamasin */
        .sidebar:not(.expanded) .sidebar-submenu {
            display: none !important;
        }
        /* Aktif satirin sol seridi kapaliyken tasmasin */
        .sidebar:not(.expanded) .sidebar-link.active::before {
            left: -8px;
        }
        .sidebar:not(.expanded) .sidebar-header {
            padding-top: 12px;
            padding-bottom: 12px;
        }
</style>
                    `;
                    document.body.appendChild(lockScreen);
                }
            }

            // Sunucuya "Bakım var mı?" diye soran fonksiyon
            function checkMaintenanceStatus() {
                fetch('/Home/CheckMaintenance', { cache: 'no-store' })
                    .then(res => res.json())
                    .then(data => {
                        if (data.active) {
                            maintenanceTargetTime = new Date(data.targetTime).getTime();
                            msgElement.textContent = "DİKKAT: " + data.message;
                            banner.style.setProperty("display", "flex", "important");
                            
                            if (!maintenanceTimerInterval) {
                                maintenanceTimerInterval = setInterval(() => updateTimerDisplay(data.releaseNotes), 1000);
                                updateTimerDisplay(data.releaseNotes);
                            }
                        } else {
                            banner.style.setProperty("display", "none", "important");
                            maintenanceTargetTime = null;
                            
                            if (maintenanceTimerInterval) {
                                clearInterval(maintenanceTimerInterval);
                                maintenanceTimerInterval = null;
                            }
                            
                            const lock = document.getElementById("full-screen-lock");
                            if(lock) {
                                lock.remove();
                                document.body.style.overflow = '';
                            }
                        }
                    })
                    .catch(err => console.log(err));
            }

            checkMaintenanceStatus();
            setInterval(checkMaintenanceStatus, 10000);
        });
    </script>
