@using WebApplication3.Helpers
@using WebApplication3.Services
@inject WebApplication3.Data.ApplicationDbContext UDb
@{
    // Portal menüsü kişi bazlı yetkiye göre süzülür (Sistem Yetkileri › Uras Üretim: … başlıkları). null = tümü (A/S).
    var uYetkiler = YetkiServisi.UretimEkranYetkileri(UDb, User.Identity?.Name, User.FindFirst("UserAuthority")?.Value ?? "");
    Func<string, string, bool> uIzin = (c, a) => uYetkiler == null || uYetkiler.Contains(c + "/" + a);
    // Sistem Yetkileri'nde başlığı "Uras Üretim: …" yapılan dış raporlar (ör. Parti Yaşlandırma) modüllerin altına eklenir.
    var uDisEkranlar = UretimMenu.DisEkranlar(UDb);
    // Uras Üretim modülünün KENDİ kabuğu (portal _Layout'undan bağımsız). Modül her zaman
    // URASKIMYA'da çalışır; şirket seçici gerekmez. Sadece üretim ekranlarının kullandığı
    // paylaşılan bağımlılıklar (jQuery, Bootstrap, FontAwesome, toastr, bootstrap-select,
    // XLSX, SweetAlert2) + iki paylaşılan yardımcı (raporExcel, htmlToPdfIndir) taşınır.
    // ÖNEMLİ: kütüphaneler <head>'de yüklenir (portal _Layout gibi), çünkü ekranlar JS'lerini
    // doğrudan gövdeye inline koyuyor ve jQuery'nin önceden yüklü olmasını bekliyor.
    var uCtrl = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    Func<string, string> uAktif = c => string.Equals(uCtrl, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var uAct = (ViewContext.RouteData.Values["action"] ?? "").ToString();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Uras Üretim</title>

    <link rel="stylesheet" href="@Url.Content("~/lib/bootstrap/dist/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/css/bootstrap-select.min.css">
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
    @* Ana portal raporları ?portal=1 ile bu kabukta açılınca kendi Styles bölümlerini de getirir *@
    @await RenderSectionAsync("Styles", required: false)

    <style>
        :root {
            /* Ana portal (portal-tema.css) ile birebir aynı palet: lacivert → mavi → gök; nötr gri; tek sıcak vurgu amber */
            --u-bg: #f4f6fb; --u-card: #ffffff; --u-ink: #0f172a; --u-muted: #64748b;
            --u-border: rgba(15, 23, 42, .07); --u-primary: #2563eb; --u-primary-dark: #1d4ed8; --u-primary-soft: #eaf1ff;
            --u-accent-2: #0ea5e9; --u-gradient: linear-gradient(135deg, #2563eb 0%, #0ea5e9 100%);
            --u-sidebar: #ffffff; --u-sidebar-ink: #5b6577; --u-sidebar-hover: #f1f5ff; --u-sidebar-active: #ffffff;
            --u-shadow: 0 1px 2px rgba(15,23,42,.04), 0 12px 32px rgba(15,23,42,.07);
            --u-shadow-deep: 0 20px 50px rgba(15,23,42,.12);
            --u-inset: 12px; --u-side-w: 250px;
        }
        * { box-sizing: border-box; }
        body.uretim-body { margin: 0; font-family: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
            background: var(--u-bg); color: var(--u-ink); font-size: 14px; }
        a { text-decoration: none; }

        /* Zemin: ana portaldaki yumuşak mavi lekeler + ince ızgara */
        .u-zemin { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden;
            background:
                radial-gradient(820px 420px at 8% -20%, rgba(37,99,235,.14), transparent 62%),
                radial-gradient(680px 420px at 96% 118%, rgba(14,165,233,.12), transparent 60%),
                linear-gradient(135deg, #ffffff 0%, #f7fbff 55%, #f4f6fb 100%); }
        .u-zemin::before { content: ""; position: absolute; inset: 0; opacity: .5;
            background-image: linear-gradient(rgba(15,23,42,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(15,23,42,.035) 1px, transparent 1px);
            background-size: 32px 32px;
            mask-image: radial-gradient(700px 380px at 22% 0%, #000 10%, transparent 72%);
            -webkit-mask-image: radial-gradient(700px 380px at 22% 0%, #000 10%, transparent 72%); }

        .u-shell { display: flex; min-height: 100vh; position: relative; z-index: 1; }

        /* Sol menü: ana portaldaki gibi beyaz, yüzen "dock" */
        .u-side { width: var(--u-side-w); flex-shrink: 0; background: var(--u-sidebar); color: var(--u-sidebar-ink);
            display: flex; flex-direction: column; position: fixed; top: var(--u-inset); bottom: var(--u-inset); left: var(--u-inset);
            z-index: 1030; border-radius: 22px; border: 1px solid var(--u-border); box-shadow: var(--u-shadow);
            overflow: hidden; animation: uDockIn .5s cubic-bezier(.2,.8,.2,1) both; }
        @@keyframes uDockIn { from { opacity: 0; transform: translateX(-20px); } to { opacity: 1; transform: none; } }
        .u-side::before { content: ""; position: absolute; left: 22px; right: 22px; top: 0; height: 3px; border-radius: 0 0 4px 4px; background: var(--u-gradient); opacity: .9; }
        .u-side-head { padding: 22px 18px 14px; display: flex; align-items: center; gap: 12px; border-bottom: 1px solid var(--u-border); }
        .u-side-logo { width: 40px; height: 40px; border-radius: 12px; background: var(--u-gradient);
            display: flex; align-items: center; justify-content: center; color: #fff; font-size: 18px; flex-shrink: 0; box-shadow: 0 8px 18px rgba(37,99,235,.28); }
        .u-side-title { font-weight: 800; color: var(--u-ink); font-size: 1.02rem; line-height: 1.1; letter-spacing: -.2px; }
        .u-side-sub { font-size: .66rem; color: var(--u-muted); letter-spacing: .1em; text-transform: uppercase; font-weight: 700; margin-top: 2px; }
        .u-side-menu { padding: 12px 10px; overflow-y: auto; flex: 1; scrollbar-width: thin; }
        .u-side-menu::-webkit-scrollbar { width: 6px; } .u-side-menu::-webkit-scrollbar-thumb { background: rgba(15,23,42,.12); border-radius: 6px; }
        .u-side-menu a, .u-side-menu .u-grp-toggle { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: 12px;
            color: var(--u-sidebar-ink); font-weight: 600; font-size: .92rem; margin-bottom: 3px; transition: background .15s, color .15s, transform .15s; cursor: pointer; user-select: none; }
        .u-side-menu a i, .u-side-menu .u-grp-toggle > i:first-child { width: 22px; text-align: center; font-size: 1rem; color: #94a3b8; transition: color .15s; }
        .u-side-menu a:hover, .u-side-menu .u-grp-toggle:hover { background: var(--u-sidebar-hover); color: var(--u-primary); }
        .u-side-menu a:hover i, .u-side-menu .u-grp-toggle:hover > i:first-child { color: var(--u-primary); }
        .u-side-menu a.active { background: var(--u-gradient); color: #fff; box-shadow: 0 8px 20px rgba(37,99,235,.32); }
        .u-side-menu a.active i { color: #fff; }
        .u-side-menu .u-grp-toggle .u-caret { margin-left: auto; font-size: .68rem; color: #94a3b8; transition: transform .2s; }
        .u-side-menu .u-grp-toggle[aria-expanded="true"] { color: var(--u-primary); }
        .u-side-menu .u-grp-toggle[aria-expanded="true"] > i:first-child { color: var(--u-primary); }
        .u-side-menu .u-grp-toggle[aria-expanded="true"] .u-caret { transform: rotate(180deg); }
        .u-side-menu .collapse, .u-side-menu .collapsing { position: relative; margin: 0 0 6px; }
        .u-side-menu .collapse::before, .u-side-menu .collapsing::before { content: ""; position: absolute; left: 24px; top: 2px; bottom: 6px; width: 2px; border-radius: 2px;
            background: linear-gradient(to bottom, var(--u-primary), transparent); opacity: .3; }
        .u-side-menu .u-sub { display: block; padding: 7px 12px 7px 42px; border-radius: 10px; position: relative;
            color: var(--u-sidebar-ink); font-size: .85rem; font-weight: 500; margin-bottom: 1px; }
        .u-side-menu .u-sub::before { content: ""; position: absolute; left: 20px; top: 50%; width: 10px; height: 10px; border-radius: 50%;
            background: #fff; border: 2px solid #cbd5e1; transform: translateY(-50%); transition: border-color .15s, background .15s, transform .15s; }
        .u-side-menu .u-sub:hover { background: var(--u-sidebar-hover); color: var(--u-primary); }
        .u-side-menu .u-sub:hover::before { border-color: var(--u-primary); }
        .u-side-menu .u-sub.active { background: var(--u-primary-soft); color: var(--u-primary-dark); font-weight: 700; }
        .u-side-menu .u-sub.active::before { background: var(--u-primary); border-color: var(--u-primary); transform: translateY(-50%) scale(1.15); }
        .u-side-foot { padding: 12px; border-top: 1px solid var(--u-border); }
        .u-back { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%;
            padding: 11px; border-radius: 12px; background: linear-gradient(135deg, #0f172a, #1e3a8a); color: #fff; font-weight: 700; border: none;
            box-shadow: 0 8px 20px rgba(15,23,42,.25); transition: transform .16s, box-shadow .16s; position: relative; overflow: hidden; }
        .u-back::after { content: ""; position: absolute; inset: 0; background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,.18) 50%, transparent 70%); transform: translateX(-100%); transition: transform .6s; }
        .u-back:hover { color: #fff; transform: translateY(-1px); box-shadow: 0 12px 26px rgba(15,23,42,.32); }
        .u-back:hover::after { transform: translateX(100%); }
        .u-back i { color: #7dd3fc; }

        /* İçerik: yüzen cam üst şerit */
        .u-main { margin-left: calc(var(--u-side-w) + var(--u-inset) * 2); flex: 1; min-width: 0; display: flex; flex-direction: column; padding: var(--u-inset) var(--u-inset) 0 0; }
        .u-top { height: 62px; background: rgba(255,255,255,.78); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
            border: 1px solid var(--u-border); border-radius: 18px; box-shadow: var(--u-shadow);
            display: flex; align-items: center; gap: 14px; padding: 0 20px; position: sticky; top: var(--u-inset); z-index: 1020; }
        .u-top-title { font-weight: 800; font-size: 1.05rem; letter-spacing: -.2px; color: var(--u-ink); }
        .u-badge-db { margin-left: auto; background: var(--u-primary-soft); color: var(--u-primary-dark); border: 1px solid rgba(37,99,235,.15);
            font-weight: 700; font-size: .74rem; padding: 6px 12px; border-radius: 999px; }
        .u-content { padding: 22px 12px 26px 12px; flex: 1; }

        .u-menu-toggle { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 10px;
            background: #fff; border: 1px solid var(--u-border); font-size: 1.05rem; color: var(--u-ink); cursor: pointer; transition: background .15s, color .15s; }
        .u-menu-toggle:hover { background: var(--u-primary-soft); color: var(--u-primary); }

        /* --- Sidebar aç/kapa (daralt): ana portaldaki gibi ikon-only'ye daralır --- */
        .u-side, .u-main { transition: width .2s ease, margin-left .2s ease; }
        .u-shell.side-collapsed .u-side { width: 76px; }
        .u-shell.side-collapsed .u-main { margin-left: calc(76px + var(--u-inset) * 2); }
        .u-shell.side-collapsed .u-side-title,
        .u-shell.side-collapsed .u-side-sub,
        .u-shell.side-collapsed .u-side-menu span,
        .u-shell.side-collapsed .u-side-menu .u-caret,
        .u-shell.side-collapsed .u-side-menu .collapse,
        .u-shell.side-collapsed .u-side-head > div:last-child,
        .u-shell.side-collapsed .u-back span { display: none !important; }
        .u-shell.side-collapsed .u-side-menu > a,
        .u-shell.side-collapsed .u-side-menu .u-grp-toggle,
        .u-shell.side-collapsed .u-back { justify-content: center; padding-left: 0; padding-right: 0; }
        .u-shell.side-collapsed .u-side-head { justify-content: center; }

        @@media (max-width: 991px) {
            .u-side { transform: translateX(-110%); transition: transform .2s; top: 8px; bottom: 8px; left: 8px; }
            .u-side.open { transform: translateX(0); box-shadow: var(--u-shadow-deep); }
            .u-main { margin-left: 0; padding: 8px 8px 0 8px; }
            .u-content { padding: 16px 0 20px; }
            .u-menu-toggle { display: inline-flex; }
        }

        .u-card { background: var(--u-card); border: 1px solid var(--u-border); border-radius: 16px; box-shadow: var(--u-shadow); }

        /* --- Ekranların (raporlar dahil) kabukla UYUMLU görünmesi için Bootstrap teması --- */
        /* Sadece .uretim-body altında geçerli; portal etkilenmez. Ekran-içi inline style'lar
           yine üstte kalır (bu sadece tutarlı bir taban sağlar). */
        .uretim-body {
            --bs-primary: #2563eb; --bs-primary-rgb: 37,99,235;
            --bs-link-color: #2563eb; --bs-link-hover-color: #1d4ed8;
            --bs-body-font-family: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
            --bs-body-color: #1f2733; --bs-border-radius: .6rem;
        }
        .uretim-body h1, .uretim-body h2, .uretim-body h3,
        .uretim-body h4, .uretim-body h5, .uretim-body h6 { font-weight: 700; color: var(--u-ink); }
        .uretim-body .card { border: 1px solid var(--u-border); border-radius: 14px; box-shadow: var(--u-shadow); }
        .uretim-body .card-header { background: #f8fafc; border-bottom: 1px solid var(--u-border); font-weight: 600; }
        .uretim-body .btn { border-radius: 9px; font-weight: 600; }
        .uretim-body .btn-primary { background: var(--u-primary); border-color: var(--u-primary); }
        .uretim-body .btn-primary:hover, .uretim-body .btn-primary:focus { background: #1d4ed8; border-color: #1d4ed8; }
        .uretim-body .btn-outline-primary { color: var(--u-primary); border-color: var(--u-primary); }
        .uretim-body .btn-outline-primary:hover { background: var(--u-primary); border-color: var(--u-primary); color: #fff; }
        .uretim-body .form-control, .uretim-body .form-select { border-radius: 9px; border-color: var(--u-border); }
        .uretim-body .form-control:focus, .uretim-body .form-select:focus { border-color: var(--u-primary); box-shadow: 0 0 0 .2rem rgba(37,99,235,.18); }
        .uretim-body .table { --bs-table-hover-bg: #f6f7fb; }
        .uretim-body .table > thead th { font-weight: 600; color: var(--u-muted); background: #f6f7fb; border-bottom: 2px solid var(--u-border); }
        .uretim-body .nav-tabs .nav-link { color: var(--u-muted); }
        .uretim-body .nav-tabs .nav-link.active,
        .uretim-body .nav-pills .nav-link.active { color: #fff; background: var(--u-primary); border-color: var(--u-primary); }
        .uretim-body .modal-content { border-radius: 14px; border: none; box-shadow: 0 20px 50px rgba(20,26,46,.2); }
        .uretim-body .badge.bg-primary { background: var(--u-primary) !important; }
        .uretim-body .page-link { color: var(--u-primary); }
        .uretim-body .page-item.active .page-link { background: var(--u-primary); border-color: var(--u-primary); }
    </style>

    @* Kütüphaneler head'de: ekranların gövdeye inline koyduğu script'ler jQuery'yi hazır bulsun *@
    <script src="@Url.Content("~/lib/jquery/dist/jquery.min.js")"></script>
    <script src="@Url.Content("~/lib/bootstrap/dist/js/bootstrap.bundle.min.js")"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/js/bootstrap-select.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/js/i18n/defaults-tr_TR.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // --- Uras Üretim > Rapor ekranlarının paylaştığı Excel dışa aktarım yardımcısı (portal _Layout ile aynı imza) ---
        function raporExcel(dosyaAdi, sheets) {
            if (typeof XLSX === 'undefined') { alert('Excel kütüphanesi yüklenemedi; sayfayı yenileyip tekrar deneyin.'); return; }
            const wb = XLSX.utils.book_new();
            (sheets || []).forEach(function (sh) {
                const aoa = [sh.kolonlar.map(k => k.b)];
                (sh.satirlar || []).forEach(function (r) {
                    aoa.push(sh.kolonlar.map(function (k) {
                        const v = typeof k.k === 'function' ? k.k(r) : r[k.k];
                        return (v === null || v === undefined) ? '' : v;
                    }));
                });
                const ws = XLSX.utils.aoa_to_sheet(aoa);
                ws['!cols'] = sh.kolonlar.map(k => ({ wch: Math.max(10, Math.min(45, (k.b || '').length + 6)) }));
                XLSX.utils.book_append_sheet(wb, ws, (sh.ad || 'Rapor').substring(0, 31));
            });
            XLSX.writeFile(wb, dosyaAdi + '.xlsx');
        }

        // --- Uras Üretim > Kalite ekranlarının paylaştığı PDF dışa aktarım yardımcısı (portal _Layout ile aynı) ---
        function htmlToPdfIndir(elementId, dosyaAdi, secenekler) {
            if (typeof html2pdf === 'undefined') { alert('PDF kütüphanesi yüklenemedi; sayfayı yenileyip tekrar deneyin.'); return; }
            const el = document.getElementById(elementId);
            if (!el) { alert('PDF alanı bulunamadı.'); return; }
            const opt = Object.assign({
                margin: [5, 5, 5, 5],
                filename: dosyaAdi + '.pdf',
                image: { type: 'jpeg', quality: 1.0 },
                html2canvas: { scale: 2, useCORS: true, logging: false, scrollY: 0, scrollX: 0 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape', compress: true },
                pagebreak: { mode: ['css', 'legacy'] }
            }, secenekler || {});
            html2pdf().set(opt).from(el).save();
        }
    </script>

    <!-- Portal kabuğunun modül sayfasında (Üretim ve Kalite › Uras Üretim Portalı) çerçeve içinde açılınca
         bu uygulamanın kendi kenar menüsü ve üst çubuğu gizlenir; gezinme dıştaki modül menüsünden yapılır. -->
    <script>
        try { if (window.self !== window.top) document.documentElement.classList.add('cerceve-icinde'); }
        catch (e) { document.documentElement.classList.add('cerceve-icinde'); }
    </script>
    <style>
        html.cerceve-icinde .u-side, html.cerceve-icinde .u-top { display: none !important; }
        html.cerceve-icinde .u-shell { display: block; }
        html.cerceve-icinde .u-main { margin: 0; width: 100%; }
        html.cerceve-icinde .u-content { padding: 12px 14px; }
        /* Çerçeve içinde özet (KPI) kartları alçak olsun */
        html.cerceve-icinde .ozet-kart, html.cerceve-icinde .kpi-card { padding: 8px 12px !important; border-radius: 10px !important; gap: 8px !important; }
        html.cerceve-icinde .kpi-card .l, html.cerceve-icinde .ozet-kart .l, html.cerceve-icinde .ozet-kart small { font-size: .64rem !important; }
        html.cerceve-icinde .kpi-card .v, html.cerceve-icinde .ozet-kart .v, html.cerceve-icinde .ozet-kart b, html.cerceve-icinde .ozet-kart strong { font-size: 1.1rem !important; line-height: 1.2; }
        html.cerceve-icinde .kpi-card .s, html.cerceve-icinde .ozet-kart .s { font-size: .64rem !important; }
        html.cerceve-icinde .ozet-kart > i, html.cerceve-icinde .ozet-kart > span:first-child { width: 32px !important; height: 32px !important; font-size: .95rem !important; }
    </style>
</head>

<body class="uretim-body">
    <div class="u-zemin" aria-hidden="true"></div>
    <div class="u-shell" id="uShell">
        <aside class="u-side" id="uSide">
            <div class="u-side-head">
                <div class="u-side-logo"><i class="fas fa-industry"></i></div>
                <div>
                    <div class="u-side-title">Uras Üretim</div>
                    <div class="u-side-sub">Üretim Yönetimi</div>
                </div>
            </div>
            <nav class="u-side-menu">
                <a class="@uAktif("UrasUretim")" href="@Url.Action("Index", "UrasUretim")"><i class="fas fa-gauge-high"></i> <span>Dashboard</span></a>
                @{ int uGi = 0; }
                @foreach (var mod in UretimMenu.Moduller)
                {
                    var izinliEkranlar = mod.Ekranlar.Where(e => uIzin(mod.Key, e.Action)).ToArray();
                    var disEkranlar = (uDisEkranlar.TryGetValue(mod.Key, out var dl) ? dl : new List<UretimDisEkran>()).Where(d => uIzin(d.Controller, d.Action)).ToList();
                    if (izinliEkranlar.Length == 0 && disEkranlar.Count == 0) { continue; }
                    uGi++;
                    var aktifMod = string.Equals(uCtrl, mod.Key, StringComparison.OrdinalIgnoreCase)
                                   || disEkranlar.Any(d => string.Equals(uCtrl, d.Controller, StringComparison.OrdinalIgnoreCase) && string.Equals(uAct, d.Action, StringComparison.OrdinalIgnoreCase));
                    <a class="u-grp-toggle" data-bs-toggle="collapse" href="#uGrp@(uGi)" role="button" aria-expanded="@(aktifMod ? "true" : "false")">
                        <i class="fas @mod.Ikon"></i> <span>@mod.Baslik</span> <i class="fas fa-chevron-down u-caret"></i>
                    </a>
                    <div class="collapse @(aktifMod ? "show" : "")" id="uGrp@(uGi)">
                        @foreach (var ek in izinliEkranlar)
                        {
                            var aktifEk = aktifMod && string.Equals(uAct, ek.Action, StringComparison.OrdinalIgnoreCase);
                            <a class="u-sub @(aktifEk ? "active" : "")" href="@Url.Action(ek.Action, mod.Key)">@ek.Etiket</a>
                        }
                        @foreach (var d in disEkranlar)
                        {
                            var aktifDis = string.Equals(uCtrl, d.Controller, StringComparison.OrdinalIgnoreCase) && string.Equals(uAct, d.Action, StringComparison.OrdinalIgnoreCase);
                            <a class="u-sub @(aktifDis ? "active" : "")" href="@d.Url">@d.Etiket</a>
                        }
                    </div>
                }
            </nav>
            <div class="u-side-foot">
                <a class="u-back" href="@Url.Action("Index", "Home")"><i class="fas fa-arrow-left"></i> <span>Portal'e Dön</span></a>
            </div>
        </aside>

        <div class="u-main">
            <header class="u-top">
                <button class="u-menu-toggle" id="uMenuToggle" type="button"><i class="fas fa-bars"></i></button>
                <span class="u-top-title">@ViewData["Title"]</span>
                <span class="u-badge-db"><i class="fas fa-database me-1"></i> URASKIMYA</span>
            </header>
            <main class="u-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script>
        // Sidebar aç/kapa: masaüstünde daraltır (ikon-only), mobilde çekmeceyi açar. Durum hatırlanır.
        (function () {
            var btn = document.getElementById('uMenuToggle'),
                shell = document.getElementById('uShell'),
                side = document.getElementById('uSide');
            var mobil = function () { return window.matchMedia('(max-width: 991px)').matches; };
            try { if (localStorage.getItem('uSideCollapsed') === '1' && !mobil()) shell.classList.add('side-collapsed'); } catch (e) { }
            if (btn && shell && side) {
                btn.addEventListener('click', function () {
                    if (mobil()) {
                        side.classList.toggle('open');
                    } else {
                        shell.classList.toggle('side-collapsed');
                        try { localStorage.setItem('uSideCollapsed', shell.classList.contains('side-collapsed') ? '1' : '0'); } catch (e) { }
                    }
                });
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
