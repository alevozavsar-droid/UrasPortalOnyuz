<button id="manageColumnsBtn" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#columnVisibilityModal">Sütunları Yönet</button>

<div class="modal fade" id="columnVisibilityModal" tabindex="-1" aria-labelledby="columnVisibilityModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="columnVisibilityModalLabel">Sütunları Yönet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Görünür sütunları seçin ve sıralamak için sürükleyip bırakın.</p>
                <div class="list-group sortable-list" id="sortable-column-list">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary" id="saveColumnVisibilityBtn">Kaydet</button>
            </div>
        </div>
    </div>
</div>