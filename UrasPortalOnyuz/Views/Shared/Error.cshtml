@model WebApplication3.Models.ErrorViewModel
@{
    // Hata sayfası kendi başına çizilir: _Layout veritabanı okur, menü kurar;
    // hata anında bunlar da patlayabilir ve yine boş ekran kalır.
    Layout = null;
    string yol = Model?.Yol ?? "";
    bool raporYolu = !string.IsNullOrEmpty(yol) && yol != "/" && !yol.StartsWith("/Home/Error", System.StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bir sorun oluştu - Uras Raporlama</title>
    <style>
        body { margin: 0; font-family: "Segoe UI", Arial, sans-serif; background: #f4f6f9; color: #0f172a; }
        .kutu { max-width: 560px; margin: 8vh auto; background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 32px 36px; box-shadow: 0 8px 30px rgba(15,23,42,.06); }
        h1 { font-size: 1.35rem; margin: 0 0 8px; }
        p { margin: 6px 0; line-height: 1.5; color: #334155; }
        .yol { font-family: Consolas, monospace; font-size: .82rem; background: #f1f5f9; padding: 2px 6px; border-radius: 6px; }
        .btnler { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 20px; }
        a.btn { display: inline-block; padding: 9px 16px; border-radius: 9px; text-decoration: none; font-weight: 600; font-size: .9rem; }
        a.p { background: #2563eb; color: #fff; }
        a.s { background: #f1f5f9; color: #0f172a; border: 1px solid #e2e8f0; }
        .detay { margin-top: 22px; font-size: .74rem; color: #94a3b8; word-break: break-all; }
        .ikon { width: 48px; height: 48px; border-radius: 50%; background: #fee2e2; color: #b91c1c; display: flex; align-items: center; justify-content: center; font-size: 26px; font-weight: 700; margin-bottom: 14px; }
    </style>
</head>
<body>
    <div class="kutu">
        <div class="ikon">!</div>
        <h1>Sayfa açılırken bir sorun oluştu</h1>
        <p>İşlem tamamlanamadı. Hata kaydedildi; Bilgi İşlem gerekirse ayrıntılara ulaşabilir.</p>
        @if (raporYolu)
        {
            <p>İstenen sayfa: <span class="yol">@yol</span></p>
        }
        <p>Genellikle sayfayı yenilemek yeterlidir. Sorun sürerse tarih aralığını daraltıp tekrar deneyin ya da Bilgi İşlem'e bu ekranın görüntüsünü iletin.</p>
        <div class="btnler">
            @if (raporYolu)
            {
                <a class="btn p" href="@yol">Yeniden dene</a>
            }
            else
            {
                <a class="btn p" href="javascript:location.reload()">Yeniden dene</a>
            }
            <a class="btn s" href="/Home/Index" target="_top">Ana sayfa</a>
        </div>
        <div class="detay">
            @if (Model != null && Model.ShowRequestId) { <div>İstek No: @Model.RequestId</div> }
            @if (Model != null && !string.IsNullOrEmpty(Model.Message)) { <div>@Model.Message</div> }
        </div>
    </div>
</body>
</html>
