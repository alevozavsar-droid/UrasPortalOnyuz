        function topluSatirHata($row, $actionCell, butonlar, mesaj, sapNo) {
            addLog('[SAP: ' + sapNo + '] ' + mesaj, 'error');
            $row.removeClass('table-success table-warning').addClass('table-danger');
            $actionCell.html(butonlar);
            $actionCell.append('<div class="hata-mesaji text-danger mt-2 small fw-bold" '
                + 'style="line-height:1.2; word-wrap:break-word; max-width:250px;">'
                + '<i class="fas fa-exclamation-triangle"></i> ' + mesaj + '</div>');
        }

        /** Tek belgeyi gonderir. Doner: 'basarili' | 'bekleyen' | 'hatali' */
        async function topluTekBelge(docEntry, objType) {
            var $row = $('#row-belge-' + docEntry + '-' + objType);
            var $actionCell = $row.find('.action-cell');
            var butonlar = $actionCell.html();
            var sapNo = $row.find('td:first').text().trim();
            var useCari = $row.attr('data-usecari') === 'true';

            $row.removeClass('table-danger table-warning table-success');
            $actionCell.find('.hata-mesaji').remove();
            $actionCell.html('<span class="text-primary fw-bold">'
                + '<i class="fas fa-spinner fa-spin me-1"></i> İletiliyor...</span>');

            // 1) Seri
            var seriler;
            try {
                seriler = await getMergedSeries(docEntry, objType);
            } catch (e) {
                topluSatirHata($row, $actionCell, butonlar, 'Seri listesi alınamadı.', sapNo);
                return 'hatali';
            }
            if (!seriler || seriler.length === 0) {
                topluSatirHata($row, $actionCell, butonlar, 'Bu belgeye uygun aktif seri bulunamadı.', sapNo);
                return 'hatali';
            }
            // İade faturasında orijinal fatura referansı yoksa QNB reddeder; toplu gönderimde atlanır, tekil gönderimden girilir.
            try {
                var iadeRef = await $.get('/Rapor88/IadeReferans', { docEntry: docEntry, objType: objType });
                if (iadeRef && iadeRef.success && iadeRef.iadeMi && !iadeRef.gecerli) {
                    topluSatirHata($row, $actionCell, butonlar, 'İade faturası: iade edilen faturanın 16 haneli numarası belgede yok. Satırdaki Gönder ile açılan pencereden girin.', sapNo);
                    return 'hatali';
                }
            } catch (e) { /* okunamazsa gönderim sunucuda yine denetlenir */ }
            var prefix = topluSeriSec(seriler, objType);

            // 2) Sıradaki GİB numarası
            var numRes;
            try {
                numRes = await $.get('/Rapor88/GetNextSequence', { prefix: prefix });
            } catch (e) {
                topluSatirHata($row, $actionCell, butonlar, 'Sıradaki numara alınamadı.', sapNo);
                return 'hatali';
            }
            if (!numRes.success || !numRes.nextNumber || numRes.nextNumber.length !== 16) {
                topluSatirHata($row, $actionCell, butonlar,
                    'Sıradaki numara hesaplanamadı: ' + (numRes.message || 'geçersiz numara'), sapNo);
                return 'hatali';
            }
            var gibNo = numRes.nextNumber;
            addLog('[SAP: ' + sapNo + '] QNB iletimi başlatıldı (GİB No: ' + gibNo + ')...', 'info');

            // 3) Gönder
            var res;
            try {
                res = await $.post('/Rapor88/FaturaGonderOtomatik', {
                    docEntry: docEntry, objType: objType,
                    gibFaturaNo: gibNo, useCariAddress: useCari
                });
            } catch (e) {
                topluSatirHata($row, $actionCell, butonlar,
                    'Sunucu bağlantı hatası. Belgenin gidip gitmediği belirsiz, Giden Belgeler ekranından kontrol edin.', sapNo);
                return 'hatali';
            }

            if (!res.success) {
                topluSatirHata($row, $actionCell, butonlar, res.message, sapNo);
                return 'hatali';
            }

            $row.find('.toplu-sec').prop('checked', false).prop('disabled', true);
            $row.find('td:eq(1)').text(res.gibNo);

            // QNB kesin sonuc vermedi: listeden DUSURULMEZ.
            if (res.dogrulandi === false) {
                addLog('[SAP: ' + sapNo + '] ONAY BEKLİYOR - ' + res.message + ' (OID: ' + res.oid + ')', 'warning', res.oid);
                $row.addClass('table-warning');
                $actionCell.html(
                    '<span class="text-warning fw-bold d-block mb-1">'
                  + '<i class="fas fa-hourglass-half me-1"></i>Onay bekliyor</span>'
                  + '<button class="btn btn-sm btn-outline-warning" onclick="durumSorgula(\'' + res.oid + '\')">'
                  + '<i class="fas fa-satellite-dish me-1"></i>Durum Sorgula</button>');
                return 'bekleyen';
            }

            // QNB'de dogrulandi: yesil ve listeden dus.
            addLog('[SAP: ' + sapNo + '] ' + res.message + ' (OID: ' + res.oid + ')', 'success', res.oid);
            $row.addClass('table-success');
            $actionCell.html('<span class="text-success fw-bold">'
                + '<i class="fas fa-check-circle me-1"></i> QNB\'de doğrulandı</span>');

            $row.fadeOut(1200, function () {
                var $tbody = $(this).closest('tbody');
                $(this).remove();
                if ($tbody.find('tr').length === 0) {
                    $tbody.html('<tr><td colspan="8" class="text-center py-4 text-success fw-bold">'
                        + '<i class="fas fa-check-circle me-1"></i> Bu bölümde bekleyen belge bulunmuyor!</td></tr>');
                }
                topluSecimSay();
            });
            return 'basarili';
        }

        async function topluGonder() {
            var secilenler = $('.toplu-sec:checked').map(function () {
                var $r = $(this).closest('tr');
                return { docEntry: $r.data('docentry'), objType: String($r.data('objtype')) };
            }).get();

            if (secilenler.length === 0) return;

            if (!confirm(secilenler.length + ' belge SIRAYLA QNB\'ye gönderilecek.\n\n'
                       + 'Her belge için sıradaki GİB numarası otomatik alınır.\n'
                       + 'Onayı gelen satır yeşile döner ve listeden düşer.\n\n'
                       + 'Devam edilsin mi?')) return;

            topluCalisiyor = true;
            topluDurdur = false;
            $('#btnTopluGonder').prop('disabled', true);
            $('#btnTopluDurdur').show();
            $('#topluIlerleme').show();

            var basarili = 0, bekleyen = 0, hatali = 0;

            for (var i = 0; i < secilenler.length; i++) {
                if (topluDurdur) {
                    addLog('Toplu gönderim durduruldu. Kalan ' + (secilenler.length - i) + ' belge gönderilmedi.', 'warning');
                    break;
                }

                $('#topluIlerleme').text('Gönderiliyor: ' + (i + 1) + ' / ' + secilenler.length);

                var sonuc = await topluTekBelge(secilenler[i].docEntry, secilenler[i].objType);
                if (sonuc === 'basarili') basarili++;
                else if (sonuc === 'bekleyen') bekleyen++;
                else hatali++;
            }

            topluCalisiyor = false;
            $('#btnTopluDurdur').hide();
            $('#topluIlerleme').hide();
            $('#chkTumunuSec').prop('checked', false);
            topluSecimSay();

            var ozet = 'Toplu gönderim bitti.\n\n'
                     + 'QNB\'de doğrulanan : ' + basarili + '\n'
                     + 'Onay bekleyen      : ' + bekleyen + '\n'
                     + 'Hata alan          : ' + hatali;
            addLog(ozet.replace(/\n/g, ' | '), hatali > 0 ? 'error' : 'success');
            alert(ozet);
        }

        // ================= BELGE GÖNDERİMİ (SARI/KIRMIZI/YEŞİL MANTIĞI) =================
        function executeSendDoc() {
            var docEntry = $("#hdnSendDocEntry").val();
            var objType = $("#hdnSendObjType").val();
            var finalGibNo = $("#txtCalculatedGibNo").val().trim(); 
            var $row = $(`#row-belge-${docEntry}-${objType}`);
            var sapNo = $row.find("td:first").text().trim();
            var cardCode = $row.data("cardcode");
            var useCari = $row.attr('data-usecari') === 'true';

            if(finalGibNo.length !== 16) {
                alert("GİB Belge numarası tam olarak 16 hane olmalıdır! (Örn: SLV2026000000001)");
                $("#txtCalculatedGibNo").focus();
                return;
            }

            // İade faturası: orijinal fatura no (16 hane) ve tarihi zorunlu
            var iadeNo = '', iadeTarih = '';
            if ($("#iadeRefAlan").is(':visible')) {
                iadeNo = ($("#txtIadeFaturaNo").val() || '').trim().toUpperCase();
                iadeTarih = $("#txtIadeFaturaTarihi").val() || '';
                if (iadeNo.length !== 16) { alert("İade faturası: iade edilen (orijinal) faturanın numarası tam 16 hane olmalıdır. GİB bu referansı zorunlu tutar."); $("#txtIadeFaturaNo").focus(); return; }
                if (!iadeTarih) { alert("İade faturası: iade edilen faturanın tarihini girin."); $("#txtIadeFaturaTarihi").focus(); return; }
            }

            var modalInstance = bootstrap.Modal.getInstance(document.getElementById('seriSecimModal'));
            if(modalInstance) modalInstance.hide();

            addLog(`[SAP: ${sapNo}] QNB iletimi başlatıldı (Kullanılacak GİB No: ${finalGibNo})...`, "info");
            
            var $actionCell = $row.find('.action-cell');
            var originalButtons = $actionCell.html(); // Butonların yedeğini al
            $actionCell.html(`<span class="text-primary fw-bold"><i class="fas fa-spinner fa-spin me-1"></i> İletiliyor...</span>`);

            gonderimSuruyor = true;

            $.post('/Rapor88/FaturaGonderOtomatik', { docEntry: docEntry, objType: objType, gibFaturaNo: finalGibNo, useCariAddress: useCari, iadeFaturaNo: iadeNo, iadeFaturaTarihi: iadeTarih }, function (res) {
                // Yanit gecikirse tablo yeniden cizilmis olabilir; satiri
                // DOM'dan tekrar coz ki dogru elemani guncelleyelim.
                $row = $(`#row-belge-${docEntry}-${objType}`);
                $actionCell = $row.find('.action-cell');

                // QNB kesin sonuc vermediyse "gonderildi" deyip yesile boyamayiz.
                // Belge QNB'ye girdi (OID var) ama sonucu henuz dogrulanmadi.
                if (res.beklemede || (res.success && res.dogrulandi === false)) {
                    addLog(`[SAP: ${sapNo}] ONAY BEKLİYOR - ${res.message} (OID: ${res.oid})`, "warning", res.oid);

                    $row.removeClass('table-success table-danger').addClass('table-warning onay-bekliyor');
                    $row.find("td:eq(1)").html(res.gibNo + ' <small class="text-warning">(onay bekliyor)</small>'); $row.find('.toplu-sec').prop('checked', false).prop('disabled', true);

                    $actionCell.find('.hata-mesaji').remove();
                    $actionCell.html(
                        '<span class="text-warning fw-bold d-block mb-1">'
                      + '<i class="fas fa-hourglass-half me-1"></i>Onay bekliyor</span>'
                      + '<button class="btn btn-sm btn-outline-warning" onclick="durumSorgula(\'' + res.oid + '\', ' + docEntry + ', \'' + objType + '\')">'
                      + '<i class="fas fa-satellite-dish me-1"></i>Durum Sorgula</button>');

                    alert(res.message);
                    return;
                }

                if (res.success) {
                    // BAŞARILI İŞLEM -> SATIR YEŞİL OLUR VE KAYBOLUR
                    let isWarning = res.message.includes("DİKKAT");
                    let logType = isWarning ? "warning" : "success";

                    addLog(`[SAP: ${sapNo}] ${res.message} (OID: ${res.oid})`, logType, res.oid);
                    
                    // Satırı yeşile boya ve GİB No'yu yaz
                    $row.removeClass('table-danger table-warning').addClass('table-success');
                    $row.find("td:eq(1)").text(res.gibNo);
                    
                    // Varsa önceki hata mesajını temizle ve "Başarılı" yaz
                    $actionCell.find('.hata-mesaji').remove();
                    $actionCell.html(`<span class="text-success fw-bold"><i class="fas fa-check-circle me-1"></i> Başarılı</span>`);
                    
                    if(isWarning) {
                        alert(res.message);
                    }
                    
                    // 2 Saniye sonra satırı yavaşça gizle ve DOM'dan sil
                    $row.fadeOut(2000, function() { 
                        let $tbody = $(this).closest("tbody"); 
                        $(this).remove(); 
                        if ($tbody.find("tr").length === 0) { 
                            $tbody.html(`<tr><td colspan="8" class="text-center py-4 text-success fw-bold"><i class="fas fa-check-circle me-1"></i> Bu bölümde bekleyen belge bulunmuyor!</td></tr>`); 
                        }
                    });
                } 
                else if (res.message && res.message.toLowerCase().indexOf("adres bilgileri eksik") !== -1) {
                    $actionCell.html(originalButtons);
                    openAddressModal(docEntry, objType, cardCode, true, res.message);
                }
                else {
                    // HATALI İŞLEM -> SATIR KIRMIZI OLUR VE EKRANDA KALIR (GİZLENMEZ)
                    addLog(`[SAP: ${sapNo}] Gönderim Hata Aldı: ${res.message}`, "error");
                    
                    $row.removeClass('table-success table-warning').addClass('table-danger');
                    $actionCell.html(originalButtons); // Tekrar deneyebilmesi için butonları geri getir
                    
                    // Butonların altına hata divini oluştur veya güncelle
                    let $errorDiv = $actionCell.find('.hata-mesaji');
                    if ($errorDiv.length === 0) {
                        $actionCell.append('<div class="hata-mesaji text-danger mt-2 small fw-bold" style="line-height:1.2; word-wrap: break-word; max-width: 250px;"></div>');
                        $errorDiv = $actionCell.find('.hata-mesaji');
                    }
                    $errorDiv.html(`<i class="fas fa-exclamation-triangle"></i> ${res.message}`);
                }
            }).fail(function () { 
                // SUNUCU / BAĞLANTI HATASI -> SATIR KIRMIZI OLUR VE KALIR
                addLog(`[SAP: ${sapNo}] Sunucu bağlantı hatası oluştu. Veri iletilemedi.`, "error"); 
                
                $row.removeClass('table-success table-warning').addClass('table-danger');
                $actionCell.html(originalButtons);
                
                let $errorDiv = $actionCell.find('.hata-mesaji');
                if ($errorDiv.length === 0) {
                    $actionCell.append('<div class="hata-mesaji text-danger mt-2 small fw-bold" style="line-height:1.2; word-wrap: break-word; max-width: 250px;"></div>');
                    $errorDiv = $actionCell.find('.hata-mesaji');
                }
                $errorDiv.html(`<i class="fas fa-plug"></i> Bağlantı Hatası! Sunucuya ulaşılamıyor.`);
            }).always(function () {
                // Hangi sonuc olursa olsun otomatik yenileme tekrar devreye girer.
                gonderimSuruyor = false;
            });
        }

        function seriTipEtiket(t){
            if(t==='EFATURA') return '<span class="badge bg-info text-dark">e-Fatura</span>';
            if(t==='EARSIV') return '<span class="badge bg-secondary">e-Arşiv</span>';
            if(t==='IRSALIYE') return '<span class="badge bg-success">İrsaliye</span>';
            return t||'';
        }
        function seriYonEtiket(y){
            if(y==='YURTDISI') return '<span class="badge bg-warning text-dark">Yurtdışı</span>';
            return '<span class="badge bg-light text-dark border">Yurtiçi</span>';
        }

        async function loadSeriesStatus() {
            $("#tbodySeries").html(`<tr><td colspan="7" class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i><br>Seriler yükleniyor...</td></tr>`);
            $.get('/Rapor88/SeriYonetimListe', function (res) {
                if (!res.success) {
                    $("#tbodySeries").html(`<tr><td colspan="7" class="text-danger text-center py-3">Hata: ${res.message}</td></tr>`);
                    return;
                }
                if (!res.data || res.data.length === 0) {
                    $("#tbodySeries").html(`<tr><td colspan="7" class="text-center py-4 text-muted">Henüz seri tanımlanmadı. "Yeni Seri Ekle" ile seri ekleyin.</td></tr>`);
                    return;
                }
                let rows = "";
                res.data.forEach(item => {
                    rows += `
                        <tr>
                            <td class="fw-bold text-dark fs-5 align-middle">${item.seri}</td>
                            <td class="align-middle">${seriTipEtiket(item.belgeTipi)}</td>
                            <td class="align-middle">${seriYonEtiket(item.yon)}</td>
                            <td class="text-muted align-middle small">${item.aciklama || ''}</td>
                            <td class="text-danger fw-bold align-middle">${item.sonNumara}</td>
                            <td class="text-success fw-bold align-middle">${item.siradaki}</td>
                            <td class="align-middle">
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control seri-yetki-input ${item.yetkili ? 'border-warning fw-bold' : ''}" id="seriYetki_${item.id}" value="${(item.yetkili || '').replace(/"/g, '&quot;')}" placeholder="herkes" title="Virgülle kullanıcı kodları, ör. MUH87,IT02. Boş = herkes.">
                                    <button class="btn btn-outline-primary" onclick="saveSeriesAuth(${item.id})" title="İzinli kullanıcıları kaydet"><i class="fas fa-save"></i></button>
                                </div>
                                ${item.yetkili ? `<div class="small mt-1 ${item.banaAcik ? 'text-warning' : 'text-danger'}"><i class="fas fa-lock"></i> Kısıtlı${item.banaAcik ? '' : ' — size kapalı'}</div>` : ''}
                            </td>
                            <td class="text-center align-middle">
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteSeries(${item.id})" title="Bu Seriyi Sil"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>`;
                });
                $("#tbodySeries").html(rows);
            }).fail(()=> $("#tbodySeries").html(`<tr><td colspan="7" class="text-danger text-center py-3">Sunucu hatası.</td></tr>`));
        }

        function updateManualCounter(prefix) {
            let val = $("#txtManualNext_" + prefix).val().trim();
            if(val.length !== 16) { alert("Lütfen tam 16 haneli bir GİB numarası girin! (Örn: SLV2026000000015)"); return; }
            localStorage.setItem("ManualCounter_" + prefix, val);
            addLog(`Sistem Sayacı Geçersiz Kılındı: ${prefix} serisi için bir sonraki belge ${val} numarasından başlayacaktır.`, "success");
            alert("Yeni başlangıç numarası kaydedildi!");
            loadSeriesStatus();
        }

        function openAddSeriesModal() {
            $("#txtNewSeriesPrefix").val("");
            $("#txtNewSeriesDesc").val("");
            $("#txtNewSeriesAuth").val("");
            $("#ddlNewSeriesTip").val("EFATURA");
            $("#ddlNewSeriesYon").val("YURTICI");
            new bootstrap.Modal(document.getElementById('addSeriesModal')).show();
        }

        function saveNewSeries() {
            let prefix = $("#txtNewSeriesPrefix").val().trim().toUpperCase();
            let tip = $("#ddlNewSeriesTip").val();
            let yon = $("#ddlNewSeriesYon").val();
            let desc = $("#txtNewSeriesDesc").val().trim();

            if (prefix.length !== 3) { alert("Seri ön eki tam 3 harf olmalıdır!"); return; }

            $.ajax({
                url: '/Rapor88/SeriKaydet', type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ Seri: prefix, BelgeTipi: tip, Yon: yon, Aciklama: desc, YetkiliKullanicilar: $("#txtNewSeriesAuth").val().trim() }),
                success: function(res) {
                    if (!res.success) { alert(res.message || "Seri eklenemedi."); return; }
                    bootstrap.Modal.getInstance(document.getElementById('addSeriesModal')).hide();
                    loadSeriesStatus();
                },
                error: function(){ alert("Sunucu hatası: seri eklenemedi."); }
            });
        }

        // IT #62: serinin izinli kullanıcı listesi (boş = herkes). Yalnızca A yetkisi kaydedebilir.
        function saveSeriesAuth(id) {
            let liste = $("#seriYetki_" + id).val().trim();
            $.ajax({
                url: '/Rapor88/SeriYetkiGuncelle', type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ Id: id, YetkiliKullanicilar: liste }),
                success: function (res) { if (!res.success) { alert(res.message || "Kaydedilemedi."); return; } if (window.toastr) toastr.success(res.message); loadSeriesStatus(); },
                error: function () { alert("Sunucu hatası: izinli kullanıcılar kaydedilemedi."); }
            });
        }

        function deleteSeries(id) {
            if(!confirm("Bu seri tanımı silinecek. (SAP'taki mevcut belgeler etkilenmez.) Onaylıyor musunuz?")) return;
            $.ajax({
                url: '/Rapor88/SeriSilDb', type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ Id: id }),
                success: function(res){ if(!res.success){ alert(res.message||"Silinemedi."); return; } loadSeriesStatus(); },
                error: function(){ alert("Sunucu hatası: silinemedi."); }
            });
        }

        // ================= DİNAMİK İŞLEM GEÇMİŞİ (VERİTABANINDAN ÇEKME) =================
        function loadIslemGecmisi() {
            let $logContainer = $("#islemLoglari");
            $logContainer.html('<div class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i><br>İşlem geçmişi yükleniyor...</div>');

            $.get('/Rapor88/GetGunlukIslemGecmisi', function(res) {
                if (res.success) {
                    $logContainer.empty();
                    
                    if (res.data.length === 0) {
                        $logContainer.html('<div class="text-center py-4 text-muted"><em>Bugün için veritabanında kayıtlı bir işlem bulunmuyor...</em></div>');
                        return;
                    }
                    
                    let html = '';
                    res.data.forEach(log => {
                        // Gelen nesnedeki property'ler duruma göre camelCase veya PascalCase gelebilir, ikisini de kontrol edelim.
                        let durum = log.durum || log.Durum;
                        let tarihObj = new Date(log.tarih || log.Tarih);
                        let timeStr = tarihObj.toLocaleTimeString('tr-TR');
                        let mesaj = log.mesaj || log.Mesaj;
                        let sapNo = log.sapBelgeNo || log.SapBelgeNo;
                        let islemTipi = log.islemTipi || log.IslemTipi;
                        let oid = log.oid || log.Oid;

                        let type = "info";
                        if (durum === "BAŞARILI") type = "success";
                        else if (durum === "HATA" || durum === "SL_HATASI" || durum === "SİSTEM_HATASI") type = "error";
                        else if (durum === "UYARI") type = "warning";

                        const colors = { success: 'text-success fw-bold', error: 'text-danger fw-bold', info: 'text-dark fw-bold', warning: 'text-warning fw-bold' };
                        const icons = { success: '<i class="fas fa-check-circle me-1"></i>', error: '<i class="fas fa-times-circle me-1"></i>', info: '<i class="fas fa-info-circle me-1"></i>', warning: '<i class="fas fa-exclamation-triangle me-1"></i>'};
                        
                        let actionBtn = "";
                        if (oid && oid.trim() !== "") {
                            actionBtn = `<button class="btn btn-sm btn-outline-info ms-2 py-0" onclick="sorgulaFaturaDurumu('${oid}')" title="Bu belgenin güncel QNB durumunu sorgula">
                                            <i class="fas fa-sync-alt"></i> Durum Sorgula
                                         </button>`;
                        }

                        let msgText = `[SAP: ${sapNo}] ${islemTipi} - ${mesaj}`;

                        html += `<div class="${colors[type]} mb-2 border-bottom pb-2 border-secondary" style="border-opacity: 0.1;">
                                    [${timeStr}] ${icons[type]} ${msgText} ${actionBtn}
                                 </div>`;
                    });
                    
                    $logContainer.html(html);
                } else {
                    $logContainer.html(`<div class="text-danger fw-bold text-center py-4"><i class="fas fa-exclamation-triangle"></i> Geçmiş yüklenemedi: ${res.message}</div>`);
                }
            }).fail(function() {
                $logContainer.html(`<div class="text-danger fw-bold text-center py-4"><i class="fas fa-plug"></i> Sunucuya bağlanırken hata oluştu. Veriler alınamadı.</div>`);
            });
        }

        // (Sayfada ilk işlem yapıldığında da güncel geçici logları göstermek için standart addLog fonksiyonu)
        function addLog(message, type = 'info', oid = null) {
            const colors = { success: 'text-success fw-bold', error: 'text-danger fw-bold', info: 'text-dark fw-bold', warning: 'text-warning fw-bold' };
            const icons = { success: '<i class="fas fa-check-circle me-1"></i>', error: '<i class="fas fa-times-circle me-1"></i>', info: '<i class="fas fa-info-circle me-1"></i>', warning: '<i class="fas fa-exclamation-triangle me-1"></i>'};
            const time = new Date().toLocaleTimeString('tr-TR');
            
            let actionBtn = "";
            if (oid) {
                actionBtn = `<button class="btn btn-sm btn-outline-info ms-2 py-0" onclick="sorgulaFaturaDurumu('${oid}')" title="Bu belgenin güncel QNB durumunu sorgula">
                                <i class="fas fa-sync-alt"></i> Durum Sorgula
                             </button>`;
            }

            const logHtml = `<div class="${colors[type]} mb-2 border-bottom pb-2 border-secondary" style="border-opacity: 0.1;">
                                [${time}] ${icons[type]} ${message} ${actionBtn}
                             </div>`;
            
            // Eğer islemLoglari içinde "yükleniyor" veya "işlem bulunmuyor" varsa onları sil
            $("#islemLoglari .text-center").remove();
            $("#islemLoglari").prepend(logHtml);
        }

        function cariAra() {
            let q = $("#txtCariAra").val().trim();
            $("#tbodyCari").html(`<tr><td colspan="5" class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i></td></tr>`);

            $.get('/Rapor88/AraCari?q=' + q, function (res) {
                if (res.success && res.data.length > 0) {
                    let rows = "";
                    res.data.forEach((cari, index) => {
                        let durumHtml = cari.eBelgeMukellefi === "Y" ? `<span class="badge bg-info text-dark" id="lblTurCari-${index}"><i class="fas fa-file-invoice"></i> e-Fatura / e-İrsaliye Mükellefi</span>` : `<span class="badge bg-secondary" id="lblTurCari-${index}"><i class="fas fa-file-alt"></i> e-Arşiv / Matbu Mükellefi</span>`;
                        let kimlikHtml = "";
                        if(cari.vkn) kimlikHtml += `<span class="badge bg-dark me-1" title="VKN">V: ${cari.vkn}</span>`;
                        if(cari.tckn) kimlikHtml += `<span class="badge bg-secondary" title="TC">T: ${cari.tckn}</span>`;

                        rows += `<tr><td class="fw-bold">${cari.cardCode}</td><td class="small fw-bold">${cari.cardName}</td><td>${kimlikHtml}</td><td>${durumHtml}</td><td class="text-center"><button class="btn btn-sm btn-primary rounded-pill fw-bold shadow-sm px-3" onclick="mukellefGuncelle('${cari.vkn}', '${cari.tckn}', '${cari.cardCode}', 'cari', ${index}, 'Cari', this)"><i class="fas fa-sync-alt me-1"></i> Sorgula</button></td></tr>`;
                    });
                    $("#tbodyCari").html(rows);
                } else {
                    $("#tbodyCari").html(`<tr><td colspan="5" class="text-center py-4 text-danger fw-bold">Sonuç bulunamadı.</td></tr>`);
                }
            });
        }
        $("#txtCariAra").on('keypress', function (e) { if (e.which === 13) cariAra(); });

        function mukellefGuncelle(vkn, tckn, cardCode, source, id, objType, btnElement) {
            let kimlik = (vkn && vkn.trim().length > 0) ? vkn : tckn;
            if (!kimlik || kimlik.trim().length === 0) { alert("VKN/TCKN bilgisi eksik, sorgulama yapılamaz."); return; }
            addLog(`[${cardCode}] Cari (VKN/TC: ${kimlik}) için GİB mükellefiyet sorgusu başlatıldı...`, "info");
            let icon = $(btnElement).find("i"); icon.removeClass("fa-sync-alt").addClass("fa-spinner fa-spin");

            $.ajax({
                url: '/Rapor88/MukellefSorgulaVeGuncelle', type: 'POST', data: { vkn: kimlik, cardCode: cardCode },
                success: function (res) {
                    icon.removeClass("fa-spinner fa-spin").addClass("fa-sync-alt");
                    if (res.success) {
                        addLog(res.message, "success"); alert(res.message);
                        if (source === "belge") {
                            let lblId = `#lblTurBelge-${id}-${objType}`; let lbl = $(lblId); let isIrsaliye = (objType === "15" || objType === "21");
                            if(res.yeniDurum === "Y") {
                                if(isIrsaliye) { lbl.removeClass("bg-secondary bg-danger").addClass("bg-warning text-dark").html('<i class="fas fa-truck"></i> e-İrsaliye'); } 
                                else { lbl.removeClass("bg-secondary bg-danger").addClass("bg-info text-dark").html('<i class="fas fa-file-invoice"></i> e-Fatura'); }
                            } else {
                                if(isIrsaliye) { lbl.removeClass("bg-warning text-dark bg-danger").addClass("bg-secondary").html('<i class="fas fa-file-signature"></i> Matbu İrsaliye'); } 
                                else { lbl.removeClass("bg-info text-dark bg-danger").addClass("bg-secondary").html('<i class="fas fa-file-alt"></i> e-Arşiv'); }
                            }
                        } else {
                            let lblId = `#lblTurCari-${id}`; let lbl = $(lblId);
                            if(res.yeniDurum === "Y") { lbl.removeClass("bg-secondary bg-danger").addClass("bg-info text-dark").html('<i class="fas fa-file-invoice"></i> e-Fatura / e-İrsaliye Mükellefi'); } 
                            else { lbl.removeClass("bg-info text-dark bg-danger").addClass("bg-secondary").html('<i class="fas fa-file-alt"></i> e-Arşiv / Matbu Mükellefi'); }
                        }
                    } else { addLog(res.message, "error"); alert("Hata: " + res.message); }
                },
                error: function () {
                    icon.removeClass("fa-spinner fa-spin").addClass("fa-sync-alt");
                    addLog(`Sunucu bağlantı hatası oluştu, mükellef sorgulanamadı.`, "error"); alert("Sorgulama yapılamadı, sunucu hatası.");
                }
            });
        }

        function setTestMode(isTest) {
            let mesaj = isTest 
                ? "Test ortamına geçiş yapmak üzeresiniz. Fatura gönderimleri gerçek GİB sistemine İLETİLMEYECEKTİR. Onaylıyor musunuz?" 
                : "CANLI ortama geçiş yapmak üzeresiniz. Fatura gönderimleri GERÇEK GİB sistemine iletilecektir! Onaylıyor musunuz?";
                
            if (confirm(mesaj)) {
                $.post('/Rapor88/ToggleTestMode', { isTest: isTest }, function (res) {
                    if (res.success) {
                        location.reload(); 
                    }
                }).fail(function() {
                    alert("Ortam değiştirilirken bir hata oluştu.");
                });
            }
        }

        // ================= KALEM ÖLÇÜ BİRİMİ YÖNETİMİ =================
        function openBirimModal(docEntry, objType) {
            $("#hdnBirimDocEntry").val(docEntry);
            $("#hdnBirimObjType").val(objType);
            $("#tbodyBirimler").html(`<tr><td colspan="5" class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i><br>Kalemler SAP'den çekiliyor...</td></tr>`);
            
            new bootstrap.Modal(document.getElementById('birimUpdateModal')).show();

            const standartBirimler = [
                "ADET", "KG", "ÇUVAL", "KOLİ", "PAKET", "KUTU", 
                "LİTRE", "METRE", "GRAM", "TON", "SET", 
                "AY", "YIL", "SAAT", "GÜN"
            ];

            $.get('/Rapor88/GetBelgeKalemleri', { docEntry: docEntry, objType: objType }, function(res) {
                if(res.success && res.data && res.data.length > 0) {
                    let rows = "";
                    res.data.forEach(kalem => {
                        let defaultBirim = kalem.yeniBirim && kalem.yeniBirim !== "" ? kalem.yeniBirim.toUpperCase() : (kalem.mevcutBirim ? kalem.mevcutBirim.toUpperCase() : "ADET");
                        
                        if (defaultBirim === "C62" || defaultBirim === "AD") defaultBirim = "ADET";
                        if (defaultBirim === "KGM") defaultBirim = "KG";
                        if (defaultBirim === "LTR" || defaultBirim === "LT") defaultBirim = "LİTRE";
                        if (defaultBirim === "MTR" || defaultBirim === "MT") defaultBirim = "METRE";

                        let selectOptions = "";
                        let bulundu = false;

                        standartBirimler.forEach(birim => {
                            let selected = (birim === defaultBirim) ? "selected" : "";
                            if (selected) bulundu = true;
                            selectOptions += `<option value="${birim}" ${selected}>${birim}</option>`;
                        });

                        if (!bulundu && defaultBirim !== "") {
                            selectOptions = `<option value="${defaultBirim}" selected>${defaultBirim}</option>` + selectOptions;
                        }

                        rows += `
                            <tr data-linenum="${kalem.lineNum}">
                                <td class="align-middle fw-bold">${kalem.siraNo}</td>
                                <td class="align-middle text-muted">${kalem.urunKodu}</td>
                                <td class="align-middle small fw-bold">${kalem.urunAdi}</td>
                                <td class="align-middle">${kalem.miktar}</td>
                                <td class="align-middle">
                                    <select class="form-select form-select-sm text-uppercase fw-bold text-primary input-yeni-birim">
                                        ${selectOptions}
                                    </select>
                                </td>
                            </tr>
                        `;
                    });
                    $("#tbodyBirimler").html(rows);
                } else {
                    $("#tbodyBirimler").html(`<tr><td colspan="5" class="text-center py-4 text-danger">Kalem verisi alınamadı veya belge boş.</td></tr>`);
                }
            }).fail(function() {
                $("#tbodyBirimler").html(`<tr><td colspan="5" class="text-center py-4 text-danger">Sunucu ile bağlantı hatası oluştu.</td></tr>`);
            });
        }
        
        function saveBirimler() {
            let docEntry = $("#hdnBirimDocEntry").val();
            let objType = $("#hdnBirimObjType").val();
            
            let kalemler = [];
            $("#tbodyBirimler tr").each(function() {
                let lineNum = $(this).data("linenum");
                if(lineNum !== undefined) {
                    let yeniBirim = $(this).find(".input-yeni-birim").val().trim().toUpperCase();
                    kalemler.push({
                        lineNum: lineNum,
                        yeniBirim: yeniBirim
                    });
                }
            });

            if(kalemler.length === 0) {
                alert("Güncellenecek kalem bulunamadı!");
                return;
            }

            let btn = $("#btnSaveBirim");
            let originalHtml = btn.html();
            btn.html('<i class="fas fa-spinner fa-spin"></i> Kaydediliyor...').prop('disabled', true);

            let requestData = {
                docEntry: parseInt(docEntry),
                objType: objType,
                kalemler: kalemler
            };

            $.ajax({
                url: '/Rapor88/UpdateKalemBirimleri',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(requestData),
                success: function(res) {
                    btn.html(originalHtml).prop('disabled', false);
                    if(res.success) {
                        let modal = bootstrap.Modal.getInstance(document.getElementById('birimUpdateModal'));
                        if(modal) modal.hide();
                        addLog(res.message, "success");
                        alert("Başarılı: " + res.message);
                    } else {
                        alert("Hata: " + res.message);
                    }
                },
                error: function() {
                    btn.html(originalHtml).prop('disabled', false);
                    alert("Sunucuya ulaşılamadı.");
                }
            });
        }
    
    // ==================== GIDEN BELGELER ====================
    // Liste, gonderim aninda kaydedilen OID'lerden kurulur.
    // Goruntuleme/indirme QNB'nin gidenBelgeleriIndir metoduyla yapilir.
    function gbKacir(m) { return $('<div>').text(m == null ? '' : m).html(); }

    function gidenBelgeleriGetir() {
        $('#gbLoader').show();

        var istek = $.getJSON('/Rapor88/GetGidenBelgeler', {
            tur: $('#gbTur').val() || '',
            ara: $('#gbAra').val() || '',
            bas: $('#gbBas').val() || '',
            bit: $('#gbBit').val() || ''
        });

        istek.always(function () { $('#gbLoader').hide(); });

        istek.done(function (res) {
            if (!res || !res.success) {
                $('#gbTablo').html('<tr><td colspan="8" class="text-center text-danger py-4">'
                    + gbKacir((res && res.message) ? res.message : 'Liste alınamadı.') + '</td></tr>');
                return;
            }

            var d = res.data || [];

            if (!d.length) {
                $('#gbTablo').html('<tr><td colspan="8" class="text-center text-muted py-4">'
                    + gbKacir(res.mesaj || 'Bu kriterde giden belge yok.') + '</td></tr>');
                return;
            }

            var html = '';

            d.forEach(function (r) {
                var durum = (r.Durum || '').trim();

                var durumSinif = /Basar|Başar|Onay|Kabul/i.test(durum) ? 'bg-success'
                               : (/Hata|Red|Iptal|İptal/i.test(durum) ? 'bg-danger'
                               : (durum ? 'bg-info text-dark' : 'bg-secondary'));

                // e-Arsiv belgelerinin OID'i YOKTUR; kimlikleri fatura numarasi + UUID'dir
                // ve QNB'nin ayri e-Arsiv ucundan indirilirler.
                var eArsivMi = (r.Kanal || '') === 'EARSIV';

                var turMetin = eArsivMi ? 'e-Arşiv' : (r.BelgeTuru || '-');
                var turSinif = r.BelgeTuru === 'eIrsaliye' ? 'bg-primary'
                             : (eArsivMi ? 'bg-warning text-dark' : 'bg-success');

                // Indirme icin OID gerekir; yoksa UUID ile denenir
                var kimlik = (r.Oid && r.Oid.length) ? r.Oid : r.Uuid;

                var kimlikHtml = '<code class="small">' + gbKacir(r.Uuid) + '</code>';
                if (r.Oid) kimlikHtml += '<div class="small text-muted">OID: ' + gbKacir(r.Oid) + '</div>';
                else if (eArsivMi) kimlikHtml += '<div class="small text-muted">e-Arşiv (OID kullanılmaz)</div>';
                else kimlikHtml += '<div class="small text-danger">OID yok - indirme başarısız olabilir</div>';

                // Indirme cagrisinin ortak eklentileri
                var gbEk = ',\'' + gbKacir(r.Kanal || '') + '\',\'' + gbKacir(r.GibNo || '') + '\',\'' + gbKacir(r.Uuid || '') + '\'';

                html += '<tr>'
                      + '<td class="small">' + gbKacir(r.Tarih) + '</td>'
                      + '<td><span class="badge ' + turSinif + '">' + gbKacir(turMetin) + '</span>'
                        + (r.Kaynak === 'PORTAL'
                            ? '<div><span class="badge bg-dark mt-1" style="font-size:.6rem;">PORTAL</span></div>' : '')
                        + (r.Yon ? '<div class="small text-muted">' + gbKacir(r.Yon) + '</div>' : '') + '</td>'
                      + '<td class="fw-bold">' + gbKacir(r.SapBelgeNo) + '</td>'
                      + '<td class="small" title="' + gbKacir(r.CariAdi || '') + '">' + gbKacir(r.CariAdi || '-') + '</td>'
                      + '<td class="small">' + gbKacir(r.GibNo) + '</td>'
                      + '<td><span class="badge ' + durumSinif + '">' + gbKacir(durum || '-') + '</span></td>'
                      + '<td>' + kimlikHtml + '</td>'
                      + '<td class="text-end">'
                        // Durum sorgusu e-Fatura konnektorunundur; e-Arsiv'de karsiligi yok.
                        + (eArsivMi ? ''
                            : '<button class="btn btn-sm btn-outline-warning me-1" title="QNB\'deki güncel durumu sorgula"'
                              + ' onclick="durumSorgula(\'' + gbKacir(r.Oid) + '\')">'
                              + '<i class="fas fa-satellite-dish"></i></button>')
                        + '<button class="btn btn-sm btn-outline-danger me-1" title="PDF olarak aç"'
                          + ' onclick="gidenBelgeIndir(\'' + gbKacir(kimlik) + '\',\'' + gbKacir(r.QnbTuru) + '\',\'PDF\'' + gbEk + ')">'
                          + '<i class="fas fa-file-pdf me-1"></i>PDF</button>'
                        + '<button class="btn btn-sm btn-outline-primary me-1" title="Tarayıcıda önizle"'
                          + ' onclick="gidenBelgeIndir(\'' + gbKacir(kimlik) + '\',\'' + gbKacir(r.QnbTuru) + '\',\'HTML\'' + gbEk + ')">'
                          + '<i class="fas fa-eye me-1"></i>Önizle</button>'
                        + '<button class="btn btn-sm btn-outline-secondary" title="UBL (XML) indir"'
                          + ' onclick="gidenBelgeIndir(\'' + gbKacir(kimlik) + '\',\'' + gbKacir(r.QnbTuru) + '\',\'UBL\'' + gbEk + ')">'
                          + '<i class="fas fa-file-code"></i></button>'
                      + '</td>'
                      + '</tr>';
            });

            $('#gbTablo').html(html);
            $('#gbOzet').text(d.length + ' belge' + (d.length >= 1000 ? ' (ilk 1000)' : ''));
        });

        istek.fail(function () {
            $('#gbTablo').html('<tr><td colspan="7" class="text-center text-danger py-4">Sunucuya ulaşılamadı.</td></tr>');
        });
    }

    /**
     * Bir belgenin QNB'deki GUNCEL durumunu canli sorgular.
     * Gonderimin gercekten QNB'ye ulasip ulasmadiginin dogrulama yoludur.
     */
    function durumSorgula(oid, docEntry, objType) {
        if (!oid) {
            alert('Bu belgenin QNB kimliği (OID) yok, sorgulanamaz.');
            return;
        }

        $.getJSON('/Rapor88/DurumSorgula', { oid: oid, docEntry: docEntry || null, objType: objType || null })
            .done(function (r) {
                if (!r.success) { alert(r.message); return; }

                var baslik = r.sorguHatasi ? 'DURUM ÖĞRENİLEMEDİ'
                           : r.hatali ? 'BELGE HATALI'
                           : (r.kesin ? 'BELGE QNB\'DE İŞLENDİ' : 'HENÜZ İŞLENİYOR (ONAY BEKLENİYOR)');

                var ek = '';
                if (r.sapYazildi) ek = '\n\n✔ ' + (r.tamamlandiMesaj || 'GİB numarası SAP\'ye yazıldı.');
                else if (r.reddedildi) ek = '\n\n✖ ' + (r.tamamlandiMesaj || 'QNB belgeyi reddetti; düzeltip yeniden gönderebilirsiniz.');
                else if (!r.kesin && !r.hatali && !r.sorguHatasi) ek = '\n\nSAP\'ye numara, onay gelince otomatik yazılacak. Tekrar göndermeyin.';

                alert(baslik + '\n\n'
                    + 'Ortam      : ' + r.ortam + '\n'
                    + 'Durum kodu : ' + r.durumKodu + '\n\n'
                    + r.mesaj + ek);

                // Belge tamamlandıysa (SAP'ye yazıldı / reddedildi) bekleyen ve giden listeleri tazele
                if (r.tamamlandi) {
                    if (typeof otomatikTabloYenile === 'function') otomatikTabloYenile();
                    if (typeof gidenBelgeleriGetir === 'function') gidenBelgeleriGetir();
                }
            })
            .fail(function () { alert('Durum sorgulanamadı. Sunucuya ulaşılamıyor.'); });
    }

function gidenBelgeIndir(oid, belgeTuru, format, kanal, faturaNo, uuid) {
        // e-Arsiv belgelerinin OID'i yoktur; kimlik fatura numarasi/UUID'dir.
        var eArsivMi = (kanal || '') === 'EARSIV';
        if (!oid && !eArsivMi) return;
        if (eArsivMi && !faturaNo && !uuid) {
            alert('Bu e-Arşiv belgesinin fatura numarası ve UUID bilgisi yok, indirilemiyor.');
            return;
        }

        // Dosya indirmesi oldugu icin dogrudan yonlendiriyoruz; hata olursa
        // sunucu metni tarayicida gorunur.
        var url = '/Rapor88/GidenBelgeIndirTek'
                + '?oid=' + encodeURIComponent(oid || '')
                + '&belgeTuru=' + encodeURIComponent(belgeTuru || 'FATURA')
                + '&format=' + encodeURIComponent(format || 'PDF')
                + '&kanal=' + encodeURIComponent(kanal || '')
                + '&faturaNo=' + encodeURIComponent(faturaNo || '')
                + '&uuid=' + encodeURIComponent(uuid || '');

        window.open(url, '_blank');
    }

    $(document).on('keypress', '#gbAra', function (e) {
        if (e.which === 13) { e.preventDefault(); gidenBelgeleriGetir(); }
    });

    // Sekmeye ilk girildiginde son 30 gunu getirir; sonra secim korunur.
    var gbAcildi = false;

    function gidenIlkAcilis() {
        if (gbAcildi) return;
        gbAcildi = true;

        var bugun = new Date();

        function bicim(t) {
            return t.getFullYear() + '-'
                 + ('0' + (t.getMonth() + 1)).slice(-2) + '-'
                 + ('0' + t.getDate()).slice(-2);
        }

        // Acilista bugun gelir; kullanici isterse araligi genisletir.
        if (!$('#gbBas').val()) $('#gbBas').val(bicim(bugun));
        if (!$('#gbBit').val()) $('#gbBit').val(bicim(bugun));

        gidenBelgeleriGetir();
    }

    // ================= BANKA HESAPLARI / IBAN =================
    function ibanKacir(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    // IBAN'i 4'lu gruplar halinde gosterir (TR12 0006 ...).
    function ibanBicimle(s) {
        return String(s || '').replace(/\s+/g, '').toUpperCase().replace(/(.{4})/g, '$1 ').trim();
    }

    function ibanListesiYukle() {
        var tbody = $('#ibanTablo tbody');
        tbody.html('<tr><td colspan="7" class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin me-1"></i>Yükleniyor...</td></tr>');
        $.get('/Rapor88/IbanListesi', function (c) {
            if (!c || !c.success) { tbody.html('<tr><td colspan="7" class="text-danger text-center py-3">Liste alınamadı.</td></tr>'); return; }
            if (!c.data || !c.data.length) {
                tbody.html('<tr><td colspan="7" class="text-center text-muted py-3">Bu şirket için kayıtlı banka hesabı yok. Yukarıdan ekleyin.</td></tr>');
                return;
            }
            var html = '';
            c.data.forEach(function (s, i) {
                // Eski surumden kalan tek satirlik kayitlarin IBAN'i bostur; faturaya gitmez.
                var ibanYok = !s.iban;
                html += '<tr data-id="' + s.id + '"' + (ibanYok ? ' class="table-warning"' : '') + '>'
                    + '<td class="text-muted">' + (i + 1) + '</td>'
                    + '<td class="fw-semibold">' + ibanKacir(s.bankaAdi) + '</td>'
                    + '<td>' + ibanKacir(s.subeAdi) + '</td>'
                    + '<td class="text-center">' + ibanKacir(s.paraBirimi) + '</td>'
                    + '<td class="font-monospace small text-nowrap">'
                    + (ibanYok
                        ? '<span class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>IBAN eksik: bu satırı silip yeniden ekleyin</span>'
                        : ibanKacir(ibanBicimle(s.iban)))
                    + '</td>'
                    + '<td class="text-center"><div class="form-check form-switch d-inline-block m-0">'
                    + '<input class="form-check-input iban-goster" type="checkbox"' + (s.faturadaGoster ? ' checked' : '') + (ibanYok ? ' disabled' : '') + ' title="Faturada göster"></div></td>'
                    + '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger border-0 iban-sil" title="Sil"><i class="fas fa-trash"></i></button></td>'
                    + '</tr>';
            });
            tbody.html(html);
        }).fail(function () { tbody.html('<tr><td colspan="7" class="text-danger text-center py-3">Sunucuya ulaşılamadı.</td></tr>'); });
    }

    function openIbanModal() {
        ibanListesiYukle();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('ibanModal')).show();
    }

    // ---------------- e-ARSIV AYARLARI (AE00008 teshisi) ----------------
    function openEArsivAyarModal() {
        eArsivAyarlariYukle();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('eArsivAyarModal')).show();
    }

    function eArsivHtmlKacir(v) {
        return $('<div>').text(v == null ? '' : String(v)).html();
    }

    function eArsivAyarlariYukle() {
        var kutu = $('#eArsivAyarIcerik');
        kutu.html('<div class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin me-1"></i> QNB\'den yapılandırma alınıyor...</div>');

        $.getJSON('/Rapor88/EArsivAyarlari').done(function (r) {
            if (r.message && !r.vkn) {
                kutu.html('<div class="alert alert-danger mb-0"><i class="fas fa-times-circle me-1"></i> ' + eArsivHtmlKacir(r.message) + '</div>');
                return;
            }

            var ortamBadge = r.ortam === 'TEST'
                ? '<span class="badge bg-danger">TEST</span>'
                : '<span class="badge bg-success">CANLI</span>';

            var html = '';
            html += '<div class="row g-3 mb-3">';
            html += '  <div class="col-md-6"><div class="card h-100 border-primary"><div class="card-header bg-primary text-white py-1 small fw-bold"><i class="fas fa-paper-plane me-1"></i> Uygulamanın Gönderdiği</div><div class="card-body p-2 small">';
            html += '    <table class="table table-sm table-borderless mb-0">';
            html += '      <tr><td class="text-muted" style="width:40%">Ortam</td><td>' + ortamBadge + '</td></tr>';
            html += '      <tr><td class="text-muted">Şirket</td><td><code>' + eArsivHtmlKacir(r.sirket) + '</code></td></tr>';
            html += '      <tr><td class="text-muted">VKN</td><td><b>' + eArsivHtmlKacir(r.vkn) + '</b></td></tr>';
            html += '      <tr><td class="text-muted">QNB Kullanıcısı</td><td>' + eArsivHtmlKacir(r.kullanici) + '</td></tr>';
            html += '      <tr><td class="text-muted">Şube</td><td><b>' + eArsivHtmlKacir(r.gonderilen.sube) + '</b></td></tr>';
            html += '      <tr><td class="text-muted">Kasa</td><td><b>' + eArsivHtmlKacir(r.gonderilen.kasa) + '</b></td></tr>';
            html += '      <tr><td class="text-muted">ERP Kodu</td><td>' + eArsivHtmlKacir(r.gonderilen.erpKodu) + '</td></tr>';
            html += '    </table>';
            html += '    <div class="text-muted mt-2" style="font-size:.72rem">Şirkete özel değer için appsettings: <code>QnbEArsiv:Sube:' + eArsivHtmlKacir(r.sirket) + '</code>, <code>QnbEArsiv:Kasa:' + eArsivHtmlKacir(r.sirket) + '</code></div>';
            html += '  </div></div></div>';

            var sonucSinif = r.success ? 'border-success' : 'border-danger';
            var sonucBaslik = r.success ? 'bg-success' : 'bg-danger';
            html += '  <div class="col-md-6"><div class="card h-100 ' + sonucSinif + '"><div class="card-header ' + sonucBaslik + ' text-white py-1 small fw-bold"><i class="fas fa-server me-1"></i> QNB\'nin Döndürdüğü</div><div class="card-body p-2 small">';
            html += '    <div class="mb-2"><span class="badge ' + (r.success ? 'bg-success' : 'bg-danger') + '">' + eArsivHtmlKacir(r.sonucKodu || '-') + '</span> ' + eArsivHtmlKacir(r.mesaj || '') + '</div>';

            var anahtarlar = r.ekler ? Object.keys(r.ekler) : [];
            if (anahtarlar.length === 0) {
                html += '    <div class="text-muted fst-italic">QNB bu sorguda şube/kasa listesini döndürmez; yalnızca kullanıcı adı, parola ve VKN\'nin geçerli olduğunu doğrular. Ham yanıt aşağıdadır.</div>';
            } else {
                html += '    <table class="table table-sm table-striped mb-0">';
                anahtarlar.forEach(function (k) {
                    var v = r.ekler[k];
                    var vurgu = /sube|kasa|kaynak|erp|seri/i.test(k) ? ' class="fw-bold"' : '';
                    html += '<tr><td class="text-muted" style="width:40%">' + eArsivHtmlKacir(k) + '</td><td' + vurgu + '>' + eArsivHtmlKacir(v) + '</td></tr>';
                });
                html += '    </table>';
            }
            html += '  </div></div></div>';
            html += '</div>';

            if (r.success) {
                html += '<div class="alert alert-info small mb-3"><i class="fas fa-check-circle me-1"></i> Kimlik bilgileri ve VKN QNB tarafından kabul edildi. Buna rağmen gönderimde <b>AE00008</b> alınıyorsa sorun kesinlikle QNB portalındaki şube/kasa tanımındadır: yukarıdaki <b>Şube / Kasa</b> değerleri bu VKN adına QNB e-Arşiv portalında (Tanımlar &raquo; Şube / Kasa) açılmalı ya da QNB destekten istenmelidir. Tanım <b>DFLT / DFLT</b> olarak açılırsa uygulamada değişiklik gerekmez.</div>';
            } else {
                html += '<div class="alert alert-warning small mb-3"><i class="fas fa-exclamation-triangle me-1"></i> QNB bu VKN için yapılandırma vermedi. Önce kullanıcı adı, parola ve VKN eşleşmesini (appsettings QnbApi bölümü) kontrol edin.</div>';
            }

            html += '<div class="accordion" id="eArsivHamAkordiyon"><div class="accordion-item">';
            html += '  <h2 class="accordion-header"><button class="accordion-button collapsed py-2 small" type="button" data-bs-toggle="collapse" data-bs-target="#eArsivHamPanel"><i class="fas fa-code me-1"></i> Ham QNB Yanıtı</button></h2>';
            html += '  <div id="eArsivHamPanel" class="accordion-collapse collapse" data-bs-parent="#eArsivHamAkordiyon"><div class="accordion-body p-2">';
            html += '    <pre class="bg-light border rounded p-2 mb-0" style="max-height:320px; overflow:auto; font-size:.72rem; white-space:pre-wrap;">' + eArsivHtmlKacir(r.ham || '(boş)') + '</pre>';
            html += '  </div></div>';
            html += '</div></div>';

            kutu.html(html);
        }).fail(function (xhr) {
            kutu.html('<div class="alert alert-danger mb-0"><i class="fas fa-times-circle me-1"></i> İstek başarısız: ' + eArsivHtmlKacir(xhr.status + ' ' + xhr.statusText) + '</div>');
        });
    }

    $(function () {
        // IBAN alani yazilirken 4'lu gruplanir.
        $('#ibanNo').on('input', function () {
            var bicimli = ibanBicimle(this.value);
            if (bicimli !== this.value) this.value = bicimli;
        });

        $('#ibanEkleBtn').on('click', function () {
            var veri = {
                bankaAdi: ($('#ibanBanka').val() || '').trim(),
                subeAdi: ($('#ibanSube').val() || '').trim(),
                paraBirimi: $('#ibanParaBirimi').val(),
                iban: ($('#ibanNo').val() || '').trim(),
                faturadaGoster: $('#ibanYeniGoster').is(':checked')
            };
            if (!veri.bankaAdi) { toastr.warning('Banka adı boş olamaz.'); $('#ibanBanka').focus(); return; }
            if (!veri.iban) { toastr.warning('IBAN boş olamaz.'); $('#ibanNo').focus(); return; }

            var btn = $(this).prop('disabled', true);
            $.post('/Rapor88/IbanKaydet', veri, function (c) {
                btn.prop('disabled', false);
                if (!c || !c.success) { toastr.error((c && c.message) || 'Kaydedilemedi.'); return; }
                $('#ibanBanka, #ibanSube, #ibanNo').val('');
                toastr.success('Banka hesabı eklendi.');
                ibanListesiYukle();
                $('#ibanBanka').focus();
            }).fail(function () { btn.prop('disabled', false); toastr.error('Sunucuya ulaşılamadı.'); });
        });

        $('#ibanBanka, #ibanSube, #ibanNo').on('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); $('#ibanEkleBtn').click(); } });

        // Faturada goster tiki: aninda kaydedilir.
        $('#ibanTablo').on('change', '.iban-goster', function () {
            var tr = $(this).closest('tr');
            var kutu = $(this);
            $.post('/Rapor88/IbanGosterAyarla', { id: tr.data('id'), faturadaGoster: kutu.is(':checked') }, function (c) {
                if (!c || !c.success) { toastr.error((c && c.message) || 'Güncellenemedi.'); kutu.prop('checked', !kutu.is(':checked')); return; }
                toastr.success(kutu.is(':checked') ? 'Bu hesap faturalarda gösterilecek.' : 'Bu hesap faturalarda gösterilmeyecek.');
            }).fail(function () { toastr.error('Sunucuya ulaşılamadı.'); kutu.prop('checked', !kutu.is(':checked')); });
        });

        $('#ibanTablo').on('click', '.iban-sil', function () {
            var tr = $(this).closest('tr');
            var ozet = tr.children().eq(1).text() + ' ' + tr.children().eq(4).text();
            if (!confirm('Bu banka hesabı silinsin mi?\n\n' + ozet)) return;
            $.post('/Rapor88/IbanSil', { id: tr.data('id') }, function (c) {
                if (!c || !c.success) { toastr.error((c && c.message) || 'Silinemedi.'); return; }
                toastr.success('Banka hesabı silindi.');
                ibanListesiYukle();
            }).fail(function () { toastr.error('Sunucuya ulaşılamadı.'); });
        });
    });
    </script>
}
