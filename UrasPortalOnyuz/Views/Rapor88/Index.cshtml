@model WebApplication3.Controllers.Rapor88DashboardViewModel
@{
    ViewData["Title"] = "e-Belge Gönderimi & Önizleme (Rapor88)";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentSelectedDbDisplay = (string)ViewBag.CurrentDbDisplay ?? "Bilinmiyor";

    var faturalar = Model.BekleyenFaturalar.Where(x => x.ObjType == "13" || x.ObjType == "19").ToList();
    var eFaturaList = faturalar.Where(x => x.EBelgeMukellefi == "Y").ToList();
    var eArsivList = faturalar.Where(x => x.EBelgeMukellefi != "Y").ToList();

    var irsaliyeler = Model.BekleyenFaturalar.Where(x => x.ObjType == "15" || x.ObjType == "21").ToList();
    var eIrsaliyeList = irsaliyeler.Where(x => x.EBelgeMukellefi == "Y").ToList();
    var matbuIrsaliyeList = irsaliyeler.Where(x => x.EBelgeMukellefi != "Y").ToList();
}

@section Styles {
    <style>
        /* Layout'un tema degiskenleri kullanilir; sayfa acik/koyu temaya uyar. */

        .eb-ust, .eb-filtre, .eb-toplu, .eb-panel {
            background: var(--bg-card, #fff);
            border: 1px solid var(--border-color, #e8ecf4);
            border-radius: var(--r-lg, 14px);
        }

        .eb-ust { display: flex; align-items: center; justify-content: space-between;
                  flex-wrap: wrap; gap: 10px; padding: 12px 16px; margin-bottom: 14px; }

        .eb-filtre { display: flex; align-items: flex-end; flex-wrap: wrap;
                     gap: 12px; padding: 12px 16px; margin-bottom: 14px; }

        .eb-toplu { display: flex; align-items: center; flex-wrap: wrap;
                    gap: 10px; padding: 10px 14px; margin-bottom: 14px; }

        .eb-panel { padding: 14px 16px; margin-bottom: 24px; }

        /* --- Ozet kartlari --- */
        /* Filtre satirindaki kompakt sayaclar */
        .eb-sayaclar { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
        .eb-sayac {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 4px 12px; border-radius: 999px; font-size: .82rem;
            background: #f4f6fa; border: 1px solid #e6ebf2; white-space: nowrap;
        }
        .eb-sayac b { font-size: 1.05rem; font-weight: 800; }
        .eb-sayac .etiket { color: var(--text-secondary, #7E8299); font-size: .74rem; }
        .eb-sayac.sari    { border-color: #ffe2a8; } .eb-sayac.sari    i, .eb-sayac.sari    b { color: #b45309; }
        .eb-sayac.kirmizi { border-color: #fecaca; } .eb-sayac.kirmizi i, .eb-sayac.kirmizi b { color: #b91c1c; }
        .eb-sayac.yesil   { border-color: #bbf7d0; } .eb-sayac.yesil   i, .eb-sayac.yesil   b { color: #047857; }

        .eb-kart { display: flex; align-items: center; gap: 14px; height: 100%;
                   background: var(--bg-card, #fff);
                   border: 1px solid var(--border-color, #e8ecf4);
                   border-radius: var(--r-lg, 14px); padding: 14px 16px; }
        .eb-kart .sayi   { font-size: 1.7rem; font-weight: 700; line-height: 1.1; }
        .eb-kart .etiket { font-size: .72rem; text-transform: uppercase; letter-spacing: .04em;
                           font-weight: 700; color: var(--text-secondary, #7E8299); }

        .eb-ikon { width: 46px; height: 46px; border-radius: 12px; flex: 0 0 46px;
                   display: flex; align-items: center; justify-content: center; font-size: 20px; }
        .eb-ikon.sari    { background: rgba(246,194,62,.15);  color: #c9930b; }
        .eb-ikon.kirmizi { background: rgba(231,74,59,.15);   color: #e74a3b; }
        .eb-ikon.yesil   { background: rgba(28,200,138,.15);  color: #12a06a; }

        /* --- Tablolar --- */
        .table-custom { margin-bottom: 0; }
        .table-custom th {
            background: var(--bg-subtle, #f1f5f9);
            text-transform: uppercase; font-size: .72rem; letter-spacing: .03em;
            font-weight: 700; color: var(--text-secondary, #7E8299);
            border-bottom: 1px solid var(--border-color, #e8ecf4);
            position: sticky; top: 0; z-index: 2; white-space: nowrap;
        }
        .table-custom td { vertical-align: middle; font-size: .82rem; }

        /* Tabloda DIKEY kisitlama yok: sayfa uzar, tarayici kaydirir.
           Onceden max-height: calc(100vh - 430px) vardi; dizustu ekranlarda
           (orn. 768px yukseklik) tabloya ~330px kaliyordu ve ekranin cogu bos
           dururken yalnizca birkac satir gorunuyordu. Yatay kaydirma korunur,
           basliklar sayfa kaydirilirken de ustte kalir. */
        .tab-pane > .table-responsive {
            border: 1px solid var(--border-color, #e8ecf4);
            border-radius: 12px;
            overflow-x: auto;
            overflow-y: visible;
        }

        /* Sayfa kayarken tablo basliklari ustte kalsin. */
        .tab-pane > .table-responsive thead th {
            position: sticky;
            top: 0;
            z-index: 3;
            background: #f8f9fc;
        }

        /* --- Sekmeler --- */
        .nav-pills-custom .nav-link {
            color: var(--text-secondary, #5a5c69); font-weight: 600;
            border-radius: 10px; padding: 8px 16px; margin: 0 8px 6px 0;
            border: 1px solid transparent; transition: all .15s ease;
        }
        .nav-pills-custom .nav-link:hover { background: var(--bg-subtle, #f1f5f9); }
        .nav-pills-custom .nav-link.active {
            background: var(--metro-primary, #0d6efd); color: #fff;
            box-shadow: var(--shadow-sm, 0 2px 8px rgba(13,110,253,.25));
        }
        .nav-pills-custom .nav-link.active i,
        .nav-pills-custom .nav-link.active .badge { color: #fff !important; }

        .nav-tabs-custom { border-bottom: 1px solid var(--border-color, #e8ecf4); }
        .nav-tabs-custom .nav-link {
            font-weight: 600; color: var(--text-secondary, #6c757d); border: none;
            border-bottom: 2px solid transparent; padding: 9px 16px; border-radius: 0;
        }
        .nav-tabs-custom .nav-link:hover { border-bottom-color: var(--border-color, #e9ecef); }
        .nav-tabs-custom .nav-link.active {
            color: var(--metro-primary, #0d6efd); background: transparent;
            border-bottom-color: var(--metro-primary, #0d6efd);
        }

        /* --- Onizleme penceresi (A4) --- */
        .modal-body-pdf-bg { background-color: #4a4f57; padding: 20px 0; overflow: auto; }

        /* Onizleme penceresi: A4 sayfasi 21cm (~794px) sabit genisliktedir ve
           modal-xl icinde dizustu ekranlarda kucuk kaliyordu. Pencere neredeyse
           tam ekran yapildi; belge de "zoom" ile ekrana sigacak sekilde
           buyutuluyor (zoom, transform'un aksine sayfa akisini de buyuttugu
           icin kaydirma cubuklari dogru calisir). */
        /* Portal yakinlastirmasi <html> uzerinde CSS zoom ile yapilir ve vw/vh
           birimleri zoom oraniyla carpilir: %60 zoom'da pencere ekranin %58'i
           kadar dar kaliyordu. Olculer --zoom'a bolunerek ekrana gore verilir. */
        .onizleme-dialog {
            width: calc(96vw / var(--zoom, 1));
            max-width: calc(96vw / var(--zoom, 1));
            height: calc(94vh / var(--zoom, 1));
            margin: calc(3vh / var(--zoom, 1)) auto;
        }
        .onizleme-dialog .modal-content { height: 100%; }
        .onizleme-dialog .modal-body { flex: 1 1 auto; min-height: 0; }

        .pdf-a4-container { width: 21cm; min-height: 29.7cm; margin: 0 auto; background: #fff;
                            box-shadow: 0 10px 40px rgba(0,0,0,.45); border-radius: 4px;
                            zoom: var(--pdf-olcek, 1); }
        /* XSLT'nin ekran stili belgeye ayrica cerceve/golge veriyor; kutu zaten
           kagit gibi gorunuyor, ic ice cerceve olmasin. */
        .pdf-a4-container .belgeSayfasi { border: none !important; box-shadow: none !important; }

        /* PDF alinirken (html2canvas) kutu kagit gorunumunden cikar: sabit A4
           yuksekligi yuvarlama yuzunden bos ikinci sayfa uretiyordu; golge ve
           kose yuvarlama da ciktiya gitmesin. Ic bosluk yazdirma degeriyle ayni. */
        .pdf-a4-container.pdf-cikti { min-height: 0; box-shadow: none; border-radius: 0; }
        .pdf-a4-container.pdf-cikti .belgeSayfasi { padding: 20px !important; }

        .fatura-satiri { transition: background-color .4s ease; }
        .toplu-sec { cursor: pointer; }
    </style>
}

<div class="container-fluid py-2">
    <div class="eb-ust">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <span class="eb-ikon yesil"><i class="fas fa-database"></i></span>
            <div>
                <div class="etiket" style="font-size:.7rem; text-transform:uppercase; letter-spacing:.04em; font-weight:700; color:var(--text-secondary,#7E8299);">Aktif Şirket</div>
                <div class="fw-bold" style="font-size:1.05rem;">@currentSelectedDbDisplay</div>
            </div>

            @if (ViewBag.IsTestEnvironment != null && (bool)ViewBag.IsTestEnvironment)
            {
                <span class="badge bg-danger ms-3 py-2 px-3"><i class="fas fa-flask me-1"></i> QNB TEST ORTAMI</span>
            }
            else
            {
                <span class="badge bg-success ms-3 py-2 px-3"><i class="fas fa-globe me-1"></i> CANLI ORTAM</span>
            }
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button class="btn btn-sm btn-outline-warning fw-bold" onclick="openQnbDownloadModal()">
                <i class="fas fa-file-archive me-1"></i> QNB Arşiv İndir
            </button>

            @* QNB'de secili sirketin VKN'si icin tanimli e-Arsiv sube/kasa yapilandirmasi (AE00008 teshisi). *@
            <button class="btn btn-sm btn-outline-info fw-bold" onclick="openEArsivAyarModal()" title="QNB e-Arşiv tarafında bu şirket için tanımlı şube / kasa / kaynak bilgisi">
                <i class="fas fa-cogs me-1"></i> e-Arşiv Ayarları
            </button>

            @* Faturanin altindaki "Banka Hesap Bilgileri" tablosuna gidecek hesaplar (secili sirkete ozel). *@
            <button class="btn btn-sm btn-outline-primary fw-bold" onclick="openIbanModal()" title="Faturaların altındaki Banka Hesap Bilgileri tablosunda gösterilecek IBAN'lar">
                <i class="fas fa-university me-1"></i> IBAN'lar
            </button>

            @* Ortam degistirme yalnizca A yetkisinde. Digerleri her zaman canlida. *@
            @if (ViewBag.TestOrtamiYetkisi != null && (bool)ViewBag.TestOrtamiYetkisi)
            {
                @if (ViewBag.IsTestEnvironment != null && (bool)ViewBag.IsTestEnvironment)
                {
                    <button class="btn btn-sm btn-success fw-bold" onclick="setTestMode(false)">
                        <i class="fas fa-power-off me-1"></i> Canlı Ortama Geç
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-danger fw-bold" onclick="setTestMode(true)">
                        <i class="fas fa-flask me-1"></i> Test Ortamına Geç
                    </button>
                }
            }

            <button class="btn btn-sm btn-outline-secondary fw-bold" onclick="location.reload()">
                <i class="fas fa-redo me-1"></i> Yenile
            </button>
        </div>
    </div>
    
    <form method="get" action="/Rapor88/Index" class="eb-filtre" id="filterForm">
        <div>
            <label class="fw-bold small mb-1" style="color:var(--text-secondary,#7E8299);">Başlangıç Tarihi</label>
            <input type="date" class="form-control form-control-sm" id="startDate" name="startDate" value="@ViewBag.StartDate" style="width:170px;" />
        </div>
        <div>
            <label class="fw-bold small mb-1" style="color:var(--text-secondary,#7E8299);">Bitiş Tarihi</label>
            <input type="date" class="form-control form-control-sm" id="endDate" name="endDate" value="@ViewBag.EndDate" style="width:170px;" />
        </div>
        <button type="submit" class="btn btn-primary btn-sm fw-bold px-4">
            <i class="fas fa-filter me-1"></i> Filtrele
        </button>

        @* Sayaclar ayri bir kart satiri olarak duruyordu ve dikeyde ~110px
           yiyordu. Ayni bilgi filtre satirinin sagina sikistirildi; asagidaki
           tabloya bir satir daha yer kaldi. *@
        <div class="eb-sayaclar ms-auto">
            <span class="eb-sayac sari" title="Gönderilmeyen (Bekleyen)">
                <i class="fas fa-hourglass-half"></i>
                <b id="dash-bekleyen">@Model.BekleyenSayisi.ToString("N0")</b>
                <span class="etiket">Bekleyen</span>
            </span>
            <span class="eb-sayac kirmizi" title="Hatalı İşlemler">
                <i class="fas fa-times-circle"></i>
                <b id="dash-hatali">@Model.HataliSayisi.ToString("N0")</b>
                <span class="etiket">Hatalı</span>
            </span>
            <span class="eb-sayac yesil" title="Başarılı İşlemler">
                <i class="fas fa-check-double"></i>
                <b id="dash-basarili">@Model.BasariliSayisi.ToString("N0")</b>
                <span class="etiket">Başarılı</span>
            </span>
            <span class="small text-nowrap" style="color:var(--text-secondary,#7E8299);">
                <i class="fas fa-sync fa-spin me-1 text-success"></i> 30 sn'de bir yenilenir
            </span>
        </div>
    </form>

    <div class="eb-panel">
        <ul class="nav nav-pills nav-pills-custom mb-3 border-bottom pb-2" id="pills-tab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="pills-fatura-tab" data-bs-toggle="pill" data-bs-target="#pills-fatura" type="button" role="tab">
                    <i class="fas fa-file-invoice text-info me-1"></i> Fatura Gönderimi
                    <span class="badge bg-danger ms-1">@faturalar.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-irsaliye-tab" data-bs-toggle="pill" data-bs-target="#pills-irsaliye" type="button" role="tab">
                    <i class="fas fa-truck text-warning me-1"></i> İrsaliye Gönderimi
                    <span class="badge bg-danger ms-1">@irsaliyeler.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-cari-tab" data-bs-toggle="pill" data-bs-target="#pills-cari" type="button" role="tab">
                    <i class="fas fa-search me-1 text-primary"></i> Mükellef Sorgula
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-seri-tab" data-bs-toggle="pill" data-bs-target="#pills-seri" type="button" role="tab" onclick="loadSeriesStatus()">
                    <i class="fas fa-list-ol me-1 text-success"></i> Seri & Sayaç Yönetimi
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-giden-tab" data-bs-toggle="pill" data-bs-target="#pills-giden" type="button" role="tab" onclick="gidenIlkAcilis()">
                    <i class="fas fa-paper-plane me-1 text-primary"></i> Giden Belgeler
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-log-tab" data-bs-toggle="pill" data-bs-target="#pills-log" type="button" role="tab" onclick="loadIslemGecmisi()">
                    <i class="fas fa-history me-1 text-secondary"></i> İşlem Geçmişi
                </button>
            </li>
        </ul>

        <!-- ==================== TOPLU GÖNDERİM ==================== -->
        <div class="d-flex align-items-center flex-wrap gap-2 mb-3 p-2 rounded"
             style="background:#f8fafc; border:1px solid #e8ecf4;">

            <div class="form-check mb-0 me-2">
                <input class="form-check-input" type="checkbox" id="chkTumunuSec" onchange="topluTumunuSec(this)">
                <label class="form-check-label fw-bold small" for="chkTumunuSec">Görünen sekmedeki tümünü seç</label>
            </div>

            <span class="badge bg-dark" id="topluSayiRozet">0 belge seçili</span>
            <span class="badge bg-primary" id="topluIlerleme" style="display:none;"></span>

            <button class="btn btn-sm btn-success fw-bold" id="btnTopluGonder" onclick="topluGonder()" disabled>
                <i class="fas fa-paper-plane me-1"></i>Seçilenleri Sırayla Gönder
            </button>

            <button class="btn btn-sm btn-outline-danger fw-bold" id="btnTopluDurdur" onclick="topluDurdur = true;" style="display:none;">
                <i class="fas fa-stop me-1"></i>Durdur
            </button>

            <span class="small text-muted ms-auto">
                Belgeler tek tek gönderilir. QNB onayı gelen satır yeşile döner ve listeden düşer.
            </span>
        </div>

        <div class="tab-content" id="pills-tabContent">
            
            <!-- FATURA TAB -->
            <div class="tab-pane fade show active" id="pills-fatura" role="tabpanel">
                <ul class="nav nav-tabs nav-tabs-custom mb-3" id="fatura-sub-tabs" role="tablist">
                    <li class="nav-item" role="presentation"><button class="nav-link active text-info" id="tab-efatura" data-bs-toggle="tab" data-bs-target="#pane-efatura" type="button" role="tab"><i class="fas fa-file-invoice me-1"></i> e-Fatura Bekleyenler <span class="badge bg-info text-dark ms-1">@eFaturaList.Count</span></button></li>
                    <li class="nav-item" role="presentation"><button class="nav-link text-secondary" id="tab-earsiv" data-bs-toggle="tab" data-bs-target="#pane-earsiv" type="button" role="tab"><i class="fas fa-file-alt me-1"></i> e-Arşiv Bekleyenler <span class="badge bg-secondary text-white ms-1">@eArsivList.Count</span></button></li>
                </ul>
                <div class="tab-content" id="fatura-sub-tabs-content">
                    <div class="tab-pane fade show active" id="pane-efatura" role="tabpanel">
                        <div class="table-responsive mb-5">
                            <table class="table table-hover table-custom mb-0">
                                <thead class="sticky-top" style="background-color: #e3f2fd;">
                                    <tr>
                                        <th style="width: 8%;">SAP No</th>
                                        <th style="width: 14%;">GİB Belge No</th>
                                        <th style="width: 9%;">Tarih</th>
                                        <th style="width: 25%;">Alıcı Unvan / Cari</th>
                                        <th style="width: 14%;">Alıcı VKN / TC</th>
                                        <th style="width: 10%;">Tutar</th>
                                        <th class="text-center" style="width: 10%;">Tür</th>
                                        <th class="text-center" style="width: 10%;">Aksiyon</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if(!eFaturaList.Any()){ <tr><td colspan="8" class="text-center py-4 text-success fw-bold"><i class="fas fa-check-circle me-1"></i> Bekleyen e-Fatura bulunmuyor!</td></tr> }
                                    @foreach (var fatura in eFaturaList)
                                    {
                                        <tr id="row-belge-@fatura.DocEntry-@fatura.ObjType" class="fatura-satiri" data-vkn="@fatura.AliciVkn" data-tckn="@fatura.AliciTckn" data-cardcode="@fatura.CardCode" data-docentry="@fatura.DocEntry" data-objtype="@fatura.ObjType" data-usecari="false">
                                            <td class="text-muted fw-bold"><input type="checkbox" class="form-check-input toplu-sec me-2" onchange="topluSecimSay()" title="Toplu gönderim için seç">@fatura.SapBelgeNo</td>
                                            <td class="fw-bold text-primary">@(string.IsNullOrEmpty(fatura.BelgeNo) ? "Belirlenmedi" : fatura.BelgeNo)</td>
                                            <td>@fatura.Tarih.ToString("dd.MM.yyyy")</td>
                                            <td class="small fw-bold">@fatura.AliciUnvan<br><small class="text-muted">@fatura.CardCode</small></td>
                                            <td>
                                                @if(!string.IsNullOrEmpty(fatura.AliciVkn)) { <span class="badge bg-dark me-1" title="Vergi No (VKN)">V: @fatura.AliciVkn</span> }
                                                @if(!string.IsNullOrEmpty(fatura.AliciTckn)) { <span class="badge bg-secondary me-1" title="TC Kimlik No">T: @fatura.AliciTckn</span> }
                                                <button class="btn btn-sm btn-outline-primary px-2 py-0 border-0" onclick="mukellefGuncelle('@fatura.AliciVkn', '@fatura.AliciTckn', '@fatura.CardCode', 'belge', @fatura.DocEntry, '@fatura.ObjType', this)" title="GİB'den Sorgula"><i class="fas fa-sync-alt"></i></button>
                                            </td>
                                            <td class="fw-bold text-danger">@fatura.ToplamTutar.ToString("N2") @fatura.ParaBirimi</td>
                                            <td class="text-center"><span class="badge @(fatura.ObjType == "13" ? "bg-primary" : "bg-danger") mb-1 d-block">@fatura.BelgeTipi</span><span class="badge bg-info text-dark d-block" id="lblTurBelge-@fatura.DocEntry-@fatura.ObjType"><i class="fas fa-file-invoice"></i> e-Fatura</span></td>
                                            <td class="text-center border-start action-cell">
                                                <div class="btn-group-vertical w-100">
                                                    <button class="btn btn-sm btn-outline-dark shadow-sm fw-bold mb-1" onclick="previewDoc(@fatura.DocEntry, '@fatura.ObjType')"><i class="fas fa-eye"></i> Önizle</button>
                                                    <div class="btn-group w-100 mb-1">
                                                        <button class="btn btn-sm btn-outline-secondary shadow-sm fw-bold dropdown-toggle"
                                                                type="button" data-bs-toggle="dropdown" data-toggle="dropdown" aria-expanded="false"
                                                                title="Adres, şoför ve birim bilgileri">
                                                            <i class="fas fa-sliders-h"></i> Bilgiler
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end shadow">
                                                            <li><button class="dropdown-item" type="button" onclick="openAddressModal(@fatura.DocEntry, '@fatura.ObjType', '@fatura.CardCode')"><i class="fas fa-map-marker-alt text-primary me-2"></i>Adres</button></li>
                                                            <li><button class="dropdown-item" type="button" onclick="openDriverModal(@fatura.DocEntry, '@fatura.ObjType')"><i class="fas fa-id-card text-info me-2"></i>Şoför</button></li>
                                                        </ul>
                                                    </div>
                                                    <button class="btn btn-sm btn-success shadow-sm fw-bold" onclick="sendDoc(@fatura.DocEntry, '@fatura.ObjType')"><i class="fas fa-paper-plane"></i> Gönder</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="pane-earsiv" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table table-hover table-custom mb-0">
                                <thead class="sticky-top" style="background-color: #f1f3f5;">
                                    <tr>
                                        <th style="width: 8%;">SAP No</th>
