        // ---- PDF INDIR: ekranda gorunen belgenin birebir A4 kopyasi -----------
        // Belge (.belgeSayfasi) dogrudan html2canvas ile resme cevrilir ve jsPDF ile
        // A4 sayfa genisligine tam oturtulur. Onceki html2pdf katmani belgeyi kendi
        // kabina kopyalayip yeniden olcekledigi icin sag/sol kenarlar kesiliyordu.
        function downloadPdf() {
            var docEntry = $("#hdnActiveDocEntry").val();
            if (!docEntry) { alert("İndirilecek belge bulunamadı!"); return; }
            if (typeof html2canvas !== 'function' || !window.jspdf || !window.jspdf.jsPDF) {
                alert("PDF kütüphanesi yüklenemedi. Sayfayı yenileyip tekrar deneyin."); return;
            }

            var kutu = document.getElementById('previewModalBody');
            var sayfa = kutu.querySelector('.belgeSayfasi') || kutu;
            var btn = $("#btnDownloadPdf"); var originalHtml = btn.html();
            btn.html('<i class="fas fa-spinner fa-spin"></i> Hazırlanıyor...').prop('disabled', true);

            // Cekim 1:1 olculerle yapilir: onizleme olcegi ve portal zoom'u gecici kapatilir.
            // (html2canvas CSS zoom altinda konumlari yanlis olcuyor.)
            var olcekYedek = onizlemeOlcek;
            kutu.style.setProperty('--pdf-olcek', 1);
            kutu.classList.add('pdf-cikti');

            var kok = document.documentElement;
            var kokZoomYedek = kok.style.zoom;
            var kokZoomDegiskenYedek = kok.style.getPropertyValue('--zoom');
            kok.style.zoom = '';
            kok.style.removeProperty('--zoom');

            var govde = document.querySelector('#previewModal .modal-body');
            var kaydirmaYedek = govde ? govde.scrollTop : 0;
            if (govde) govde.scrollTop = 0;

            function geriAl() {
                kok.style.zoom = kokZoomYedek;
                if (kokZoomDegiskenYedek) kok.style.setProperty('--zoom', kokZoomDegiskenYedek);
                kutu.classList.remove('pdf-cikti');
                onizlemeOlcek = olcekYedek;
                onizlemeOlcekUygula();
                if (govde) govde.scrollTop = kaydirmaYedek;
                btn.html(originalHtml).prop('disabled', false);
            }

            html2canvas(sayfa, {
                scale: 2, useCORS: true, logging: false, backgroundColor: '#ffffff',
                scrollX: 0, scrollY: 0,
                width: sayfa.offsetWidth, height: sayfa.offsetHeight,
                windowWidth: Math.max(sayfa.offsetWidth, document.documentElement.clientWidth)
            }).then(function (canvas) {
                var pdf = new window.jspdf.jsPDF({ unit: 'mm', format: 'a4', orientation: 'portrait' });
                var sayfaGen = pdf.internal.pageSize.getWidth();
                var sayfaYuk = pdf.internal.pageSize.getHeight();
                var resimYuk = canvas.height * sayfaGen / canvas.width;
                var veri = canvas.toDataURL('image/jpeg', 0.98);

                if (resimYuk <= sayfaYuk + 1) {
                    // Tek sayfa: genislik A4'e tam oturur, kucuk tasma payi kirpilir.
                    pdf.addImage(veri, 'JPEG', 0, 0, sayfaGen, Math.min(resimYuk, sayfaYuk));
                } else {
                    // Uzun belge: ayni resim sayfa sayfa kaydirilarak basilir.
                    var konum = 0;
                    while (konum < resimYuk - 0.5) {
                        if (konum > 0) pdf.addPage();
                        pdf.addImage(veri, 'JPEG', 0, -konum, sayfaGen, resimYuk);
                        konum += sayfaYuk;
                    }
                }
                pdf.save('e-Belge_' + docEntry + '.pdf');
                geriAl();
            }).catch(function (err) {
                console.error("PDF Hatası:", err); alert("PDF oluşturulurken bir hata meydana geldi.");
                geriAl();
            });
        }

        // ---- YAZDIR: tarayicinin yazdirma penceresi -----------------------------
        // XSLT ciktisi (tam HTML) gizli bir cerceveye yuklenir ve oradan yazdirilir.
        // Belgenin kendi yazdirma (print) stilleri ve A4 sayfa tanimi kullanilir; PDF olarak
        // kaydetmek icin yazdirma penceresinde "PDF olarak kaydet" secilebilir.
        function onizlemeYazdir() {
            if (!sonOnizlemeHtml) { alert("Yazdırılacak belge yok. Önce önizleme oluşturun."); return; }

            var eski = document.getElementById('onizlemeYazdirCerceve');
            if (eski) eski.remove();

            var yazdirStili = '<style>@@page { size: A4 portrait; margin: 8mm; } ' +
                              '@@media print { html, body { zoom: 1 !important; background: #fff !important; } }</style>';
            var html = sonOnizlemeHtml.indexOf('</head>') > -1
                ? sonOnizlemeHtml.replace('</head>', yazdirStili + '</head>')
                : yazdirStili + sonOnizlemeHtml;

            var cerceve = document.createElement('iframe');
            cerceve.id = 'onizlemeYazdirCerceve';
            cerceve.setAttribute('aria-hidden', 'true');
            // Ekran disinda ama gercek olculerde: 0x0 cerceveden yazdirma bazi
            // tarayicilarda bos sayfa veriyor.
            cerceve.style.cssText = 'position:fixed; left:-10000px; top:0; width:900px; height:1200px; border:0; opacity:0; pointer-events:none;';
            cerceve.onload = function () {
                // QR kodu ve gomulu logolar cizilsin diye kisa bekleme.
                setTimeout(function () {
                    try { cerceve.contentWindow.focus(); cerceve.contentWindow.print(); }
                    catch (e) { console.error("Yazdırma hatası:", e); alert("Yazdırma penceresi açılamadı."); }
                }, 400);
            };
            document.body.appendChild(cerceve);
            cerceve.srcdoc = html;
        }

