        // ---- ÖNİZLEME YAKINLAŞTIRMA -------------------------------------
        // A4 sayfası 21cm sabittir. Pencere her açıldığında ölçek %105'e döner;
        // kullanıcı +/- düğmeleriyle değiştirir, ortadaki düğme %105'e alır.
        var ONIZLEME_VARSAYILAN_OLCEK = 1.05;
        var onizlemeOlcek = ONIZLEME_VARSAYILAN_OLCEK;

        function onizlemeOlcekUygula() {
            onizlemeOlcek = Math.min(4, Math.max(0.4, onizlemeOlcek));
            document.getElementById('previewModalBody').style.setProperty('--pdf-olcek', onizlemeOlcek);

            var yazi = document.getElementById('onizlemeOlcekYazi');
            if (yazi) yazi.textContent = '%' + Math.round(onizlemeOlcek * 100);
        }

        function onizlemeOlcekle(fark) {
            onizlemeOlcek += fark;
            onizlemeOlcekUygula();
        }

        function onizlemeSigdir() {
            onizlemeOlcek = ONIZLEME_VARSAYILAN_OLCEK;
            onizlemeOlcekUygula();
        }

