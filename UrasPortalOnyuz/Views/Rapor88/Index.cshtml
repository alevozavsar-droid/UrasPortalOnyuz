                    $("#txtIadeFaturaNo").val(iade.faturaNo || '');
                    $("#txtIadeFaturaTarihi").val(iade.tarih || iade.belgeTarihi || '');
                    $("#iadeRefAlan").show();
                }
            } catch (e) { console.warn('İade referansı okunamadı', e); }

            new bootstrap.Modal(document.getElementById('seriSecimModal')).show();
            fetchNextNumber();
        }

        function fetchNextNumber() {
            var prefix = $("#ddlSeriPrefix").val();
            $("#txtCalculatedGibNo").val("");
            $("#numLoader").show();

            $.get('/Rapor88/GetNextSequence', { prefix: prefix }, function (res) {
                $("#numLoader").hide();
                if (res.success) { 
                    let dbNext = res.nextNumber;
                    let manualNext = localStorage.getItem("ManualCounter_" + prefix);
                    let finalNext = dbNext;
                    
                    if(manualNext && manualNext > dbNext) {
                        finalNext = manualNext;
                    } else if(manualNext) {
                        localStorage.removeItem("ManualCounter_" + prefix);
                    }

                    $("#txtCalculatedGibNo").val(finalNext); 
                } 
                else { alert("Sıradaki numara hesaplanamadı: " + res.message); }
            });
        }


        // ==================== TOPLU GÖNDERİM ====================
