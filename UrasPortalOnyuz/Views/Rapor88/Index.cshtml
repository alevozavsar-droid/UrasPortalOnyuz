        async function sendDoc(docEntry, objType) {
            // QNB onayı bekleyen belge yeniden gönderilmez (mükerrer belge). Sunucu da ayrıca kilitler.
            if ($('#row-belge-' + docEntry + '-' + objType).hasClass('onay-bekliyor')) {
                alert('Bu belge daha önce QNB\'ye gönderildi ve ONAY BEKLİYOR.\n\nTekrar göndermeyin; onay gelince GİB numarası SAP\'ye otomatik yazılır. İsterseniz "Şimdi Sorgula" ile durumu kontrol edin.');
                return;
            }
            $("#hdnSendDocEntry").val(docEntry);
            $("#hdnSendObjType").val(objType);
            
            $("#ddlSeriPrefix").html('<option value="">Seriler Yükleniyor...</option>');
            await populateSeriesDropdown(docEntry, objType);

            if(objType === "15" || objType === "21") {
                if($("#ddlSeriPrefix option[value='IRS']").length > 0) $("#ddlSeriPrefix").val("IRS");
                else $("#ddlSeriPrefix").prop('selectedIndex', 0);
            } else {
                if($("#ddlSeriPrefix option[value='SLV']").length > 0) $("#ddlSeriPrefix").val("SLV");
                else $("#ddlSeriPrefix").prop('selectedIndex', 0);
            }

            // İade faturası mı? Orijinal fatura no/tarihi alanlarını göster ve SAP'deki değerle doldur.
            $("#iadeRefAlan").hide(); $("#txtIadeFaturaNo, #txtIadeFaturaTarihi").val('');
