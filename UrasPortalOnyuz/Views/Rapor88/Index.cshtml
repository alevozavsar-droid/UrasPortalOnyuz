        function downloadQnbDocs() {
            let oidsRaw = $("#txtQnbOids").val();
            let oids = oidsRaw.split(/[\n,]+/).map(s => s.trim()).filter(s => s.length > 0);
            
            if (oids.length === 0) { 
                alert("Lütfen indirilecek belgelerin OID numaralarını girin."); 
                return; 
            }
            
            let tur = $("#ddlQnbBelgeTuru").val();
            let format = $("#ddlQnbBelgeFormati").val();
            
            let btn = $("#btnQnbDownload");
            let originalHtml = btn.html();
            btn.html('<i class="fas fa-spinner fa-spin"></i> İndiriliyor...').prop('disabled', true);
            
            fetch('/Rapor88/QnbGidenBelgeIndir?belgeTuru=' + tur + '&belgeFormati=' + format, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(oids)
            })
            .then(response => {
                if (!response.ok) throw new Error('Ağ hatası veya indirme başarısız');
                
                const contentType = response.headers.get('content-type');
                if (contentType && contentType.indexOf('application/json') !== -1) {
                    return response.json().then(data => {
                        throw new Error(data.message || "İndirme hatası");
                    });
                }
                
                return response.blob();
            })
            .then(blob => {
                btn.html(originalHtml).prop('disabled', false);
                
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                const dateStr = new Date().toISOString().replace(/[-:T]/g, '').slice(0, 14);
                a.download = `Giden_${tur}_${dateStr}.zip`;
                
                document.body.appendChild(a);
                a.click();
                
                window.URL.revokeObjectURL(url);
                let modal = bootstrap.Modal.getInstance(document.getElementById('qnbDownloadModal'));
                if(modal) modal.hide();
                
                addLog(`${oids.length} adet ${tur} belgesi başarıyla Zip olarak indirildi.`, "success");
            })
            .catch(error => {
                btn.html(originalHtml).prop('disabled', false);
                alert("Hata: " + error.message);
                addLog("Zip İndirme Hatası: " + error.message, "error");
            });
        }
