        /**
         * Belgeye uygun seriyi secer. GetActiveSeriesList zaten belge tipine
         * gore filtreli donuyor; tek tek gonderimdeki tercih burada da korunur.
         */
        function topluSeriSec(seriler, objType) {
            var tercih = (objType === '15' || objType === '21') ? 'IRS' : 'SLV';
            for (var i = 0; i < seriler.length; i++) {
                if (seriler[i].prefix === tercih) return tercih;
