    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title fw-bold"><i class="fas fa-university me-2 text-primary"></i>Faturada Gösterilecek Banka Hesapları (IBAN)</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-3">
                    Bu liste yalnızca <b>seçili şirket</b> için geçerlidir. "Faturada göster" işaretli hesaplar, faturanın en altında
                    <b>Banka Hesap Bilgileri</b> tablosunda (Banka Adı / Şube Adı / Para Birimi / IBAN No) gösterilir. İrsaliyelere eklenmez.
                    Değişiklik bir sonraki önizleme ve gönderimden itibaren geçerlidir.
                </p>

                <div class="row g-2 align-items-end mb-2">
                    <div class="col-md-3">
                        <label class="form-label small mb-1 fw-semibold" for="ibanBanka">Banka Adı <span class="text-danger">*</span></label>
                        <input type="text" id="ibanBanka" class="form-control form-control-sm" maxlength="100" placeholder="Örn: GARANTİ BBVA">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1 fw-semibold" for="ibanSube">Şube Adı</label>
                        <input type="text" id="ibanSube" class="form-control form-control-sm" maxlength="100" placeholder="Örn: BURSA TİCARİ ŞUBE">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1 fw-semibold" for="ibanParaBirimi">Para Birimi</label>
                        <select id="ibanParaBirimi" class="form-select form-select-sm">
                            <option value="TRY">TRY</option>
                            <option value="USD">USD</option>
                            <option value="EUR">EUR</option>
                            <option value="GBP">GBP</option>
                            <option value="CHF">CHF</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1 fw-semibold" for="ibanNo">IBAN No <span class="text-danger">*</span></label>
                        <input type="text" id="ibanNo" class="form-control form-control-sm font-monospace" maxlength="42"
                               placeholder="TR00 0000 0000 0000 0000 0000 00" autocomplete="off">
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" id="ibanYeniGoster" checked>
                        <label class="form-check-label small" for="ibanYeniGoster">Faturada göster</label>
                    </div>
                    <button type="button" class="btn btn-sm btn-primary" id="ibanEkleBtn"><i class="fas fa-plus me-1"></i>Ekle</button>
                </div>

                <table class="table table-sm align-middle mb-0" id="ibanTablo">
                    <thead class="table-light">
                        <tr>
                            <th style="width:36px;">#</th>
                            <th>Banka Adı</th>
                            <th>Şube Adı</th>
                            <th style="width:90px;" class="text-center">Para Birimi</th>
                            <th style="width:270px;">IBAN No</th>
                            <th style="width:130px;" class="text-center">Faturada göster</th>
                            <th style="width:60px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td colspan="7" class="text-center text-muted py-3">Yükleniyor...</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" integrity="sha512-BNaRQnYJYiPSqHHDb58B0yaPfCu+Wgds8Gp/gU33kqBtgNS4tSPHuGibyoeqMV/TJlSKda6FXzoEyYGjTe+vXA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js" integrity="sha512-qZvrmS2ekKPF2mSznTQsxqPgnpkI4DNTlrdUmTzrDgektczlKNRRhy5X5AAOnx5S09ydFYWWNSfcEqDTTHgtNA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script>
        async function getMergedSeries(docEntry = 0, objType = "") {
            // Seriler artık veritabanındaki tanımlardan (Rapor88_Seri) gelir; belgenin tipine+yönüne göre filtrelenir.
            let dbSeries = [];
            try {
                let res = await $.get(`/Rapor88/SeriGonderimListe?docEntry=${docEntry}&objType=${objType}`);
                if (res.success && res.data) {
                    res.data.forEach(s => dbSeries.push({ prefix: s.prefix, desc: s.desc }));
                }
            } catch (e) {
                console.error("Seri tanımları çekilemedi", e);
            }
            let map = new Map();
            dbSeries.forEach(s => map.set(s.prefix, s));
            return Array.from(map.values());
        }

        async function populateSeriesDropdown(docEntry = 0, objType = "") {
            let series = await getMergedSeries(docEntry, objType);
            let $ddl = $("#ddlSeriPrefix");
            $ddl.empty();
            
            if(series.length === 0) {
                $ddl.append(`<option value="">Bu belgeye uygun aktif seri bulunamadı</option>`);
                return;
            }

            series.forEach(s => {
                $ddl.append(`<option value="${s.prefix}">${s.prefix} - ${s.desc}</option>`);
            });
        }

        $(document).ready(function() {
            populateSeriesDropdown();
            
            // SAYFA YÜKLENDİĞİNDE OTOMATİK TOPLU MÜKELLEF SORGULAMASINI ÇALIŞTIR
            otomatikMukellefSorgula();

            // 30 saniyede bir arka planda tabloyu yenile
            setInterval(otomatikTabloYenile, 30000);
            // Sayfa açılışında sunucu tarafı satırlar onay kilidini bilmez; JS çizimi hemen devreye alınır.
            setTimeout(otomatikTabloYenile, 800); 
        });

        // ================= OTOMATİK TABLO YENİLEME =================
        function otomatikTabloYenile() {
            if (topluCalisiyor || gonderimSuruyor) return;
            // Onay bekleyen belgeler varsa önce QNB'de sorgulanır; onaylananların GİB no'su SAP'ye yazılır, sonra tablo çekilir.
            $.getJSON('/Rapor88/OnayBekleyenleriKontrol').done(function (r) {
                if (r && r.success && (r.tamamlanan > 0 || r.hatali > 0)) {
                    (r.detay || []).forEach(function (d) {
                        if (d.sonuc === 'BASARILI') addLog('[SAP: ' + d.sapBelgeNo + '] ' + d.mesaj, 'success', d.oid);
                        else if (d.sonuc === 'HATA') addLog('[SAP: ' + d.sapBelgeNo + '] ' + d.mesaj, 'error', d.oid);
                    });
                    if (typeof gidenBelgeleriGetir === 'function' && $('#gbTablo').is(':visible')) gidenBelgeleriGetir();
                }
            }).always(function () { bekleyenTabloyuCek(); });
        }

        function bekleyenTabloyuCek() {
            // Gonderim surerken tabloyu yeniden cizme: secimler ve islenmekte
            // olan satirlar kaybolur, islenen satir DOM'dan kopar.
            if (topluCalisiyor || gonderimSuruyor) return;

            let startDate = $("#startDate").val();
            let endDate = $("#endDate").val();

            $.ajax({
                url: '/Rapor88/GetBekleyenBelgelerJson',
                type: 'GET',
                data: { startDate: startDate, endDate: endDate },
                success: function(res) {
                    if (res.success) {
                        // Sayacı güncelle
                        $("#dash-bekleyen").text(res.bekleyenSayisi);

                        let efaturaHtml = "";
                        let earsivHtml = "";
                        let eirsaliyeHtml = "";
                        let matbuHtml = "";
                        
                        let eFaturaCount = 0;
                        let eArsivCount = 0;
                        let eIrsaliyeCount = 0;
                        let matbuCount = 0;

                        res.data.forEach(function(fatura) {
                            let tarihObj = new Date(fatura.tarih);
                            let gun = ("0" + tarihObj.getDate()).slice(-2);
                            let ay = ("0" + (tarihObj.getMonth() + 1)).slice(-2);
                            let yil = tarihObj.getFullYear();
                            let tarih = `${gun}.${ay}.${yil}`;
                            
                            let tutar = fatura.toplamTutar.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " " + fatura.paraBirimi;
                            
                            let vknHtml = fatura.aliciVkn ? `<span class="badge bg-dark me-1" title="Vergi No (VKN)">V: ${fatura.aliciVkn}</span>` : '';
                            let tcknHtml = fatura.aliciTckn ? `<span class="badge bg-secondary me-1" title="TC Kimlik No">T: ${fatura.aliciTckn}</span>` : '';
                            let gibNo = fatura.belgeNo ? fatura.belgeNo : (fatura.sonGibNo ? fatura.sonGibNo + ' <small class="text-warning">(onay bekliyor)</small>' : 'Belirlenmedi');

                            // QNB onayı bekleyen belge: SAP'ye numara henüz yazılmadı; yeniden gönderim kilitli, yalnızca durum sorgulanır.
                            let onayKilit = fatura.sonDurum === 'ONAY_BEKLIYOR' || fatura.sonDurum === 'SL_HATASI';
                            let gonderHtml = onayKilit
                                ? `<div class="onay-kilit small text-start"><span class="badge bg-warning text-dark d-block mb-1"><i class="fas fa-hourglass-half me-1"></i>${fatura.sonDurum === 'SL_HATASI' ? 'QNB onayladı, SAP yazımı bekliyor' : 'QNB onayı bekleniyor'}</span>`
                                  + `<div class="text-muted" style="line-height:1.2;">Tekrar <b>göndermeyin</b>. GİB no <b>${fatura.sonGibNo || ''}</b> ayrıldı; onay gelince SAP'ye otomatik yazılır (30 sn'de bir kontrol edilir).</div>`
                                  + `<button class="btn btn-sm btn-outline-warning w-100 mt-1" onclick="durumSorgula('${fatura.sonOid}', ${fatura.docEntry}, '${fatura.objType}')"><i class="fas fa-satellite-dish me-1"></i>Şimdi Sorgula</button></div>`
                                : `<button class="btn btn-sm btn-success shadow-sm fw-bold" onclick="sendDoc(${fatura.docEntry}, '${fatura.objType}')"><i class="fas fa-paper-plane"></i> Gönder</button>`;
                            
                            let isFatura = (fatura.objType === "13" || fatura.objType === "19");
                            let isIrsaliye = (fatura.objType === "15" || fatura.objType === "21");
                            
                            let turBadgeClass = (fatura.objType === "13" || fatura.objType === "15") ? "bg-primary" : "bg-danger";
                            
                            let altBadge = "";
                            if(isFatura && fatura.eBelgeMukellefi === "Y") altBadge = '<span class="badge bg-info text-dark d-block" id="lblTurBelge-'+fatura.docEntry+'-'+fatura.objType+'"><i class="fas fa-file-invoice"></i> e-Fatura</span>';
                            else if(isFatura && fatura.eBelgeMukellefi !== "Y") altBadge = '<span class="badge bg-secondary text-white d-block" id="lblTurBelge-'+fatura.docEntry+'-'+fatura.objType+'"><i class="fas fa-file-alt"></i> e-Arşiv</span>';
                            else if(isIrsaliye && fatura.eBelgeMukellefi === "Y") altBadge = '<span class="badge bg-warning text-dark d-block" id="lblTurBelge-'+fatura.docEntry+'-'+fatura.objType+'"><i class="fas fa-truck"></i> e-İrsaliye</span>';
                            else altBadge = '<span class="badge bg-secondary text-white d-block" id="lblTurBelge-'+fatura.docEntry+'-'+fatura.objType+'"><i class="fas fa-file-signature"></i> Matbu İrsaliye</span>';

                            // Birim yalnizca irsaliyelerde anlamli; "Bilgiler" listesine oge olarak girer.
                            let birimBtn = isIrsaliye ? `<li><button class="dropdown-item" type="button" onclick="openBirimModal(${fatura.docEntry}, '${fatura.objType}')"><i class="fas fa-balance-scale text-warning me-2"></i>Birim</button></li>` : "";

                            let rowHtml = `<tr id="row-belge-${fatura.docEntry}-${fatura.objType}" class="fatura-satiri ${onayKilit ? 'table-warning onay-bekliyor' : ''}" data-vkn="${fatura.aliciVkn}" data-tckn="${fatura.aliciTckn}" data-cardcode="${fatura.cardCode}" data-docentry="${fatura.docEntry}" data-objtype="${fatura.objType}" data-usecari="false">
                                <td class="text-muted fw-bold"><input type="checkbox" class="form-check-input toplu-sec me-2" onchange="topluSecimSay()" title="Toplu gönderim için seç" ${onayKilit ? 'disabled' : ''}>${fatura.sapBelgeNo}</td>
                                <td class="fw-bold text-primary">${gibNo}</td>
                                <td>${tarih}</td>
                                <td class="small fw-bold">${fatura.aliciUnvan}<br><small class="text-muted">${fatura.cardCode}</small></td>
                                <td>
                                    ${vknHtml}
                                    ${tcknHtml}
                                    <button class="btn btn-sm btn-outline-primary px-2 py-0 border-0" onclick="mukellefGuncelle('${fatura.aliciVkn}', '${fatura.aliciTckn}', '${fatura.cardCode}', 'belge', ${fatura.docEntry}, '${fatura.objType}', this)" title="GİB'den Sorgula"><i class="fas fa-sync-alt"></i></button>
                                </td>
                                <td class="fw-bold text-danger">${tutar}</td>
                                <td class="text-center">
                                    <span class="badge ${turBadgeClass} mb-1 d-block">${fatura.belgeTipi}</span>
                                    ${altBadge}
                                </td>
                                <td class="text-center border-start action-cell">
                                    <div class="btn-group-vertical w-100">
                                        <button class="btn btn-sm btn-outline-dark shadow-sm fw-bold mb-1" onclick="previewDoc(${fatura.docEntry}, '${fatura.objType}')"><i class="fas fa-eye"></i> Önizle</button>
                                                    <div class="btn-group w-100 mb-1">
                                                        <button class="btn btn-sm btn-outline-secondary shadow-sm fw-bold dropdown-toggle"
                                                                type="button" data-bs-toggle="dropdown" data-toggle="dropdown" aria-expanded="false"
                                                                title="Adres, şoför ve birim bilgileri">
                                                            <i class="fas fa-sliders-h"></i> Bilgiler
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end shadow">
                                                            <li><button class="dropdown-item" type="button" onclick="openAddressModal(${fatura.docEntry}, '${fatura.objType}', '${fatura.cardCode}')"><i class="fas fa-map-marker-alt text-primary me-2"></i>Adres</button></li>
                                                            <li><button class="dropdown-item" type="button" onclick="openDriverModal(${fatura.docEntry}, '${fatura.objType}')"><i class="fas fa-id-card text-info me-2"></i>Şoför</button></li>
                                                            ${birimBtn}
                                                        </ul>
                                                    </div>
                                        ${gonderHtml}
                                    </div>
                                </td>
                            </tr>`;

                            if (isFatura && fatura.eBelgeMukellefi === "Y") { efaturaHtml += rowHtml; eFaturaCount++; }
                            else if (isFatura && fatura.eBelgeMukellefi !== "Y") { earsivHtml += rowHtml; eArsivCount++; }
                            else if (isIrsaliye && fatura.eBelgeMukellefi === "Y") { eirsaliyeHtml += rowHtml; eIrsaliyeCount++; }
                            else if (isIrsaliye && fatura.eBelgeMukellefi !== "Y") { matbuHtml += rowHtml; matbuCount++; }
                        });

                        $("#pane-efatura tbody").html(efaturaHtml || '<tr><td colspan="8" class="text-center py-4 text-success fw-bold"><i class="fas fa-check-circle me-1"></i> Bekleyen e-Fatura bulunmuyor!</td></tr>');
                        $("#pane-earsiv tbody").html(earsivHtml || '<tr><td colspan="8" class="text-center py-4 text-success fw-bold"><i class="fas fa-check-circle me-1"></i> Bekleyen e-Arşiv bulunmuyor!</td></tr>');
                        $("#pane-eirsaliye tbody").html(eirsaliyeHtml || '<tr><td colspan="8" class="text-center py-4 text-success fw-bold"><i class="fas fa-check-circle me-1"></i> Bekleyen e-İrsaliye bulunmuyor!</td></tr>');
                        $("#pane-matbu tbody").html(matbuHtml || '<tr><td colspan="8" class="text-center py-4 text-success fw-bold"><i class="fas fa-check-circle me-1"></i> Bekleyen Matbu/Diğer İrsaliye bulunmuyor!</td></tr>');
                        
                        // Tab sayısını guncelle
                        $("#tab-efatura span.badge").text(eFaturaCount);
                        $("#tab-earsiv span.badge").text(eArsivCount);
                        $("#tab-eirsaliye span.badge").text(eIrsaliyeCount);
                        $("#tab-matbu span.badge").text(matbuCount);
                        
                        // Ust butonlardaki bage'leri guncelle
                        $("#pills-fatura-tab span.badge").text(eFaturaCount + eArsivCount);
                        $("#pills-irsaliye-tab span.badge").text(eIrsaliyeCount + matbuCount);
                    }
                }
            });
        }
        
        // ================= OTOMATİK TOPLU MÜKELLEF SORGULAMA YÖNETİMİ =================
        function otomatikMukellefSorgula() {
            let sorgulanacakCariler = [];

            $(".fatura-satiri").each(function() {
                let vkn = $(this).data("vkn");
                let tckn = $(this).data("tckn");
                let cardCode = $(this).data("cardcode");
                let kimlik = (vkn && vkn.toString().trim().length > 0) ? vkn : tckn;

                if (kimlik && cardCode && !sorgulanacakCariler.some(x => x.CardCode === cardCode)) {
                    sorgulanacakCariler.push({ Vkn: kimlik.toString(), CardCode: cardCode.toString() });
                }
            });

            if (sorgulanacakCariler.length > 0) {
                addLog(`Sayfa yüklendi, ${sorgulanacakCariler.length} farklı cari için otomatik GİB mükellefiyet sorgusu arka planda başlatıldı...`, "info");
                
                $.ajax({
                    url: '/Rapor88/TopluMukellefSorgula',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(sorgulanacakCariler),
                    success: function(res) {
                        if (res.success) {
                            addLog("Toplu mükellef sorgulamaları tamamlandı. Tablo güncelleniyor...", "success");
                            
                            res.data.forEach(item => {
                                $(`.fatura-satiri[data-cardcode='${item.cardCode}']`).each(function() {
                                    let dEntry = $(this).data("docentry");
                                    let oType = $(this).data("objtype").toString();
                                    let isIrsaliye = (oType === "15" || oType === "21");
                                    let lbl = $(`#lblTurBelge-${dEntry}-${oType}`);
                                    
                                    if (item.yeniDurum === "Y") {
                                        if(isIrsaliye) { lbl.removeClass("bg-secondary bg-danger text-white").addClass("bg-warning text-dark").html('<i class="fas fa-truck"></i> e-İrsaliye'); } 
                                        else { lbl.removeClass("bg-secondary bg-danger text-white").addClass("bg-info text-dark").html('<i class="fas fa-file-invoice"></i> e-Fatura'); }
                                    } else if (item.yeniDurum === "N") {
                                        if(isIrsaliye) { lbl.removeClass("bg-warning bg-danger text-dark").addClass("bg-secondary text-white").html('<i class="fas fa-file-signature"></i> Matbu İrsaliye'); } 
                                        else { lbl.removeClass("bg-info bg-danger text-dark").addClass("bg-secondary text-white").html('<i class="fas fa-file-alt"></i> e-Arşiv'); }
                                    } else if (item.yeniDurum === "HATA") {
                                        lbl.removeClass("bg-secondary bg-warning bg-info text-dark text-white").addClass("bg-danger text-white").html('<i class="fas fa-exclamation-triangle"></i> Eksik Cari Bilgisi');
                                        
                                        let actionCell = $(this).find('.action-cell');
                                        if(actionCell.find('.text-danger.small').length === 0) {
                                            actionCell.prepend(`<div class="text-danger small fw-bold mb-1 text-center" title="${item.mesaj}"><i class="fas fa-exclamation-circle"></i> SAP'den Cariyi Düzelt</div>`);
                                        }
                                    }
                                });
                            });
                        } else {
                            addLog("Toplu sorgulama başarısız: " + res.message, "error");
                        }
                    },
                    error: function() {
                        addLog("Toplu sorgulama için sunucuya ulaşılamadı.", "error");
                    }
                });
            }
        }

        // ================= ADRES EKSİKLİĞİ YÖNETİMİ =================
        function openAddressModal(docEntry, objType, cardCode, isErrorTrigger = false, errorMsg = "") {
            $("#hdnAddressDocEntry").val(docEntry);
            $("#hdnAddressObjType").val(objType);
            $("#hdnAddressCardCode").val(cardCode);
            
            if(isErrorTrigger) {
                $("#addressMissingMessage").html(errorMsg).show();
            } else {
                $("#addressMissingMessage").hide();
            }

            $("#divBelgeAdresi").html('<i class="fas fa-spinner fa-spin"></i> Yükleniyor...');
            
            let rowUseCari = $(`#row-belge-${docEntry}-${objType}`).attr('data-usecari') === 'true';
            $("#chkUseCariAddress").prop('checked', rowUseCari);

            new bootstrap.Modal(document.getElementById('addressUpdateModal')).show();

            $.get('/Rapor88/GetAdresBilgileri', { docEntry: docEntry, objType: objType, cardCode: cardCode }, function(res) {
                if(res.success) {
                    let bAdres = `${res.belgeAdres.sokak} ${res.belgeAdres.ilce} ${res.belgeAdres.il} ${res.belgeAdres.postaKodu} ${res.belgeAdres.ulke}`;
                    $("#divBelgeAdresi").html(res.belgeAdres.isDolu ? bAdres : "<span class='text-danger'><i class=\"fas fa-exclamation-circle\"></i> Belge üzerinde adres bilgisi BOŞ veya EKSİK!</span>");
                    window.currentBelgeAdres = res.belgeAdres;
                    
                    $("#txtAddressStreet").val(res.cariAdres.sokak);
                    $("#txtAddressCity").val(res.cariAdres.ilce);
                    $("#txtAddressCounty").val(res.cariAdres.il);
                    $("#txtAddressZipCode").val(res.cariAdres.postaKodu);
                    $("#txtAddressCountry").val(res.cariAdres.ulke || "TR");

                } else {
                    $("#divBelgeAdresi").html("<span class='text-danger'>Hata: " + res.message + "</span>");
                }
            }).fail(function() {
                $("#divBelgeAdresi").html("<span class='text-danger'>Sunucu bağlantı hatası!</span>");
            });
        }

        function copyBelgeToCari() {
            if(window.currentBelgeAdres) {
                $("#txtAddressStreet").val(window.currentBelgeAdres.sokak);
                $("#txtAddressCity").val(window.currentBelgeAdres.ilce);
                $("#txtAddressCounty").val(window.currentBelgeAdres.il);
                $("#txtAddressZipCode").val(window.currentBelgeAdres.postaKodu);
                $("#txtAddressCountry").val(window.currentBelgeAdres.ulke || "TR");
            }
        }

        function saveAddressInfo() {
            let docEntry = $("#hdnAddressDocEntry").val();
            let objType = $("#hdnAddressObjType").val();
            let cardCode = $("#hdnAddressCardCode").val();
            
            let sokak = $("#txtAddressStreet").val().trim();
            let ilce = $("#txtAddressCity").val().trim();
            let il = $("#txtAddressCounty").val().trim();
            let posta = $("#txtAddressZipCode").val().trim();
            let ulke = $("#txtAddressCountry").val().trim();
            
            let useCariAddress = $("#chkUseCariAddress").is(":checked");

            if(!sokak || !ilce || !il) {
                alert("Lütfen Adres Satır 1, İlçe ve İl alanlarını boş bırakmayınız!");
                return;
            }

