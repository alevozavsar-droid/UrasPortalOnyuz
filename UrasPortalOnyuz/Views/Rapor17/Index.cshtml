@{
    ViewData["Title"] = "Konsolide Tahsilat Takip Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*
    KONSOLİDE TAHSİLAT TAKİP RAPORU — yeni tasarım. Tüm grup şirketlerinin müşteri carileri tek listede: açık fatura vade kırılımı (gecikmiş · bu hafta · 8–30 · 31–60 · 60+ gün),
    içerideki çek / senet, son 30 gün tahsilatı, son tahsilat, risk ve limit durumu, temsilci; şirket / temsilci / risk süzgeçleri; haftalık beklenen tahsilat planı; şirket bazlı özet.
    Veri: /Tahsilat/KonsolideTakip (cari kartları + Cari Mutabakat + Tahsilat ekranı). Betik: wwwroot/js/konsolide-tahsilat.js
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<link rel="stylesheet" href="/css/cari-islem.css?v=1" />
}
<div class="container-fluid py-3 na ci kt" id="kt">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-building-columns"></i></span>Konsolide Tahsilat Takip Raporu</h4>
        <span style="font-size:.68rem;font-weight:700;color:#475569;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:999px;padding:3px 10px"><i class="fas fa-database me-1"></i>Tüm Şirketler · Cari Kartları + Cari Mutabakat + Tahsilat</span>
        <span class="sub w-100">Grup şirketlerinin müşteri carileri tek listede: <b>vade kırılımı</b> (gecikmiş · bu hafta · 8–30 · 31–60 · 60+ gün), içerideki <b>çek / senet</b>, <b>son 30 gün tahsilat</b>, son tahsilat, <b>risk</b> ve limit durumu, temsilci. Haftalık sekmesi önümüzdeki 8 haftanın <b>beklenen tahsilat planını</b> fatura vadelerinden çıkarır; Şirket Özeti şirket bazında toplar. Satırdan Tahsilat ekranına, karta ve ekstreye geçilir.</span>
    </div>
    <div class="na-sekme" id="ktSekmeler" data-dinamik="kapali">
        <button type="button" data-p="liste" class="aktif"><i class="fas fa-list me-1"></i>Cari Listesi <span class="n" id="ktN">0</span></button>
        <button type="button" data-p="hafta"><i class="fas fa-calendar-week me-1"></i>Haftalık Beklenen</button>
        <button type="button" data-p="sirket"><i class="fas fa-building me-1"></i>Şirket Özeti</button>
        <button type="button" data-p="tahsilat"><i class="fas fa-hand-holding-dollar me-1"></i>Son Tahsilatlar <span class="n" id="ktNT">0</span></button>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>
    <div class="ci-kpi" id="ktKpi"></div>
    <div class="na-panel aktif" data-p="liste">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-filter me-1"></i>Filtreler</span><span class="d-flex gap-1"><button type="button" class="btn btn-light btn-sm py-0" id="ktTemizle" style="font-size:.66rem">Temizle</button><button type="button" class="btn btn-light btn-sm py-0" id="ktExcel" style="font-size:.66rem"><i class="fas fa-file-excel me-1"></i>Excel</button></span></div>
            <div class="na-kart-g">
                <div class="ci-filtre">
                    <div><label>Ara</label><input class="form-control" id="ktAra" placeholder="Kod, ünvan, temsilci…"></div>
                    <div><label>Şirket</label><select class="form-select" id="ktSirket"><option value="">Tümü</option></select></div>
                    <div><label>Temsilci</label><select class="form-select" id="ktTemsilci"><option value="">Tümü</option></select></div>
                    <div><label>Bölge</label><select class="form-select" id="ktBolge"><option value="">Tümü</option><option>Yurtiçi</option><option>Yurtdışı</option></select></div>
                    <div><label>Risk</label><select class="form-select" id="ktRisk"><option value="">Tümü</option><option>Riskli</option><option>İzlemede</option><option>Risksiz</option></select></div>
                    <div><label>Durum</label><select class="form-select" id="ktDurum"><option value="">Tümü</option><option value="gecmis">Gecikmiş Alacağı Olan</option><option value="buhafta">Bu Hafta Vadesi Gelen</option><option value="cek">Çek / Senedi Olan</option><option value="tahsilatsiz">30 Gündür Tahsilat Yok</option><option value="acik">Açık Bakiyesi Olan</option></select></div>
                    <div><label>Sırala</label><select class="form-select" id="ktSirala"><option value="gecmis">Gecikmiş (Büyükten)</option><option value="acik">Açık Toplam</option><option value="buhafta">Bu Hafta</option><option value="bakiye">Bakiye</option><option value="son30">Son 30 Gün Tahsilat</option><option value="kod">Cari Kodu</option></select></div>
                    <div class="ms-auto na-mini" id="ktSayi"></div>
                </div>
                <div class="table-responsive"><table class="na-tablo ci-liste" id="ktTablo" data-dinamik="kapali"><thead><tr><th>Şirket</th><th>Cari · Temsilci</th><th class="e">Bakiye (TL)</th><th class="e">Gecikmiş</th><th class="e">Bu Hafta</th><th class="e">8–30 Gün</th><th class="e">31–60 Gün</th><th class="e">60+ Gün</th><th class="e">Açık Toplam</th><th class="e">Çek / Senet</th><th class="e">Son 30 Gün · Son Tahsilat</th><th>Vade Dağılımı</th><th>Risk</th><th></th></tr></thead><tbody></tbody><tfoot></tfoot></table></div>
            </div>
        </div>
    </div>
    <div class="na-panel" data-p="hafta">
        <div class="row g-2">
            <div class="col-lg-7"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-calendar-week me-1"></i>Haftalık Beklenen Tahsilat (Fatura Vadelerine Göre)</span><span class="not">liste süzgecine göre · gecikmişler ilk satırda</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="ktHafta" data-dinamik="kapali"><thead><tr><th>Hafta</th><th>Tarih Aralığı</th><th class="s">Fatura</th><th class="s">Cari</th><th class="e">Beklenen (TL)</th><th>Dağılım</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div></div></div>
            <div class="col-lg-5"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-list-ol me-1"></i>Seçili Haftanın Faturaları</span><span class="not" id="ktHaftaNot">satıra tıklayın</span></div><div class="na-kart-g p-0"><div class="table-responsive" style="max-height:480px"><table class="na-tablo ci-liste" id="ktHaftaDetay" data-dinamik="kapali"><thead><tr><th>Vade</th><th>Cari</th><th>Belge</th><th class="s">Tip</th><th class="e">Kalan</th><th class="e">TL</th></tr></thead><tbody><tr><td colspan="6" class="na-bos">Haftalık tablodan bir satır seçin.</td></tr></tbody></table></div></div></div></div>
        </div>
    </div>
    <div class="na-panel" data-p="sirket">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-building me-1"></i>Şirket Bazlı Tahsilat Özeti</span><span class="not">liste süzgecine göre · satıra tıklayınca liste o şirkete süzülür</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="ktSirketTablo" data-dinamik="kapali"><thead><tr><th>Şirket</th><th class="s">Cari</th><th class="e">Bakiye (TL)</th><th class="e">Gecikmiş</th><th class="s">Gecikmeli Cari</th><th class="e">Bu Hafta</th><th class="e">8–30 Gün</th><th class="e">31–60 Gün</th><th class="e">60+ Gün</th><th class="e">Çek / Senet</th><th class="e">Son 30 Gün Tahsilat</th><th class="s">Riskli</th><th>Tahsilat Oranı (30 Gün)</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div></div>
    </div>
    <div class="na-panel" data-p="tahsilat">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-hand-holding-dollar me-1"></i>Tahsilat Ekranından Kaydedilen Tahsilatlar</span><span class="not">tüm şirketler · Konsolide Finansal Takip Paneli'ne de düşer</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="ktTahsilat" data-dinamik="kapali"><thead><tr><th>Tahsilat No</th><th>Tarih</th><th>Şirket</th><th>Cari</th><th>Yöntem</th><th class="s">Tip</th><th class="e">Tutar</th><th class="e">TL</th><th>Mod</th><th class="s">Kapanan</th><th class="e">Vade Farkı</th><th class="e">Kur Farkı</th><th>Fark Faturası</th><th></th></tr></thead><tbody></tbody></table></div></div></div>
    </div>
</div>
@section Scripts {
<script src="/js/konsolide-tahsilat.js?v=2"></script>
}
