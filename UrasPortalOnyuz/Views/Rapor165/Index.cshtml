@{
    ViewData["Title"] = "Gider / Gelir Kodu Talep Onayı";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool onaylayici = (bool)(ViewBag.Onaylayici ?? false);
    string onaylayanlar = (string)ViewBag.Onaylayanlar ?? "";
}

<link href="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.css" rel="stylesheet" />

<style>
    .gt-wrap { padding: 0 14px 40px; }
    .gt-hero { background: linear-gradient(120deg, #7c2d12 0%, #ea580c 55%, #fb923c 100%); color: #fff; border-radius: 16px; padding: 18px 24px; margin: 14px 0 16px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; box-shadow: 0 10px 30px -12px rgba(234,88,12,.55); }
    .gt-hero h1 { font-size: 1.3rem; font-weight: 700; margin: 0; }
    .gt-hero p { margin: 4px 0 0; opacity: .92; font-size: .84rem; }
    .gt-hero .gt-rol { background: rgba(255,255,255,.18); padding: 8px 14px; border-radius: 10px; font-weight: 600; font-size: .88rem; }
    .gt-tabs { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
    .gt-tab { display: flex; align-items: center; gap: 8px; border: 1px solid #d7dce5; background: #fff; color: #475569; font-weight: 700; font-size: .9rem; padding: 10px 18px; border-radius: 11px 11px 0 0; cursor: pointer; }
    .gt-tab .cnt { font-size: .72rem; background: #e2e8f0; color: #475569; border-radius: 20px; padding: 1px 9px; }
    .gt-tab.active { background: #fff7ed; border-color: #fdba74; color: #c2410c; border-bottom-color: #fff7ed; }
    .gt-tab.active .cnt { background: #fed7aa; color: #9a3412; }
    .gt-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 0 12px 12px 12px; box-shadow: 0 4px 14px -8px rgba(15,23,42,.15); }
    .gt-note { font-size: .78rem; color: #92400e; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 8px 12px; margin: 12px 16px; }
    .gt-list { padding: 8px 16px 16px; display: grid; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); gap: 12px; }
    .gt-item { border: 1px solid #e5e7eb; border-radius: 12px; padding: 14px 16px; background: #fff; display: flex; flex-direction: column; gap: 8px; }
    .gt-item.bekliyor { border-left: 5px solid #f59e0b; }
    .gt-item.onaylandi { border-left: 5px solid #16a34a; }
    .gt-item.red { border-left: 5px solid #dc2626; }
    .gt-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
    .gt-tip { font-size: .68rem; font-weight: 700; padding: 2px 9px; border-radius: 20px; }
    .gt-tip.GIDER { background: #fee2e2; color: #b91c1c; } .gt-tip.GELIR { background: #dcfce7; color: #166534; } .gt-tip.TIS { background: #ede9fe; color: #6d28d9; }
    .gt-yol { font-size: .8rem; color: #475569; }
    .gt-yol b { color: #0f172a; font-size: .95rem; }
    .gt-meta { font-size: .74rem; color: #64748b; }
    .gt-aciklama { font-size: .82rem; color: #334155; background: #f8fafc; border-radius: 8px; padding: 8px 10px; white-space: pre-wrap; }
    .gt-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 4px; }
    .gt-actions input { flex: 1; min-width: 160px; border: 1px solid #d7dce5; border-radius: 8px; padding: 7px 10px; font-size: .82rem; }
    .gt-btn { border: none; border-radius: 9px; padding: 8px 16px; font-weight: 700; font-size: .84rem; cursor: pointer; }
    .gt-btn.ok { background: #16a34a; color: #fff; } .gt-btn.ok:hover { background: #15803d; }
    .gt-btn.no { background: #fff; color: #b91c1c; border: 1px solid #fca5a5; } .gt-btn.no:hover { background: #fef2f2; }
    .gt-sonuc { font-size: .8rem; padding: 6px 10px; border-radius: 8px; }
    .gt-sonuc.onaylandi { background: #dcfce7; color: #166534; } .gt-sonuc.red { background: #fee2e2; color: #991b1b; }
    .gt-kod { font-family: Consolas, monospace; font-weight: 700; color: #1d4ed8; }
    .gt-empty { text-align: center; color: #94a3b8; padding: 40px 0; grid-column: 1 / -1; }
    .gt-btn.dz { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; } .gt-btn.dz:hover { background: #dbeafe; }
    .gt-edit { border: 1px dashed #93c5fd; background: #f8fbff; border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 6px; }
    .gt-edit-row { display: grid; grid-template-columns: 90px 1fr; align-items: center; gap: 8px; }
    .gt-edit-row label { font-size: .7rem; font-weight: 700; color: #475569; text-transform: uppercase; }
    .gt-edit-row input, .gt-edit-row select, .gt-edit-row textarea { width: 100%; border: 1px solid #d7dce5; border-radius: 8px; padding: 6px 9px; font-size: .82rem; font-family: inherit; }
    .gt-edit-ipucu { font-size: .72rem; color: #64748b; }
</style>

<div class="gt-wrap">
    <div class="gt-hero">
        <div>
            <h1><i class="fa-solid fa-clipboard-check"></i> Gider / Gelir Kodu Talep Onayı</h1>
            <p>Fatura ve yevmiye ekranlarından gelen yeni kod talepleri. Onaylanan kalem Gider / Gelir Kod Yönetimi kataloğuna eklenir ve talep edene e-posta gider.</p>
        </div>
        <div class="gt-rol"><i class="fa-solid fa-user-check"></i> @(onaylayici ? "Onaylayıcı: " + ViewBag.Kullanici : "Yalnızca kendi taleplerinizi görürsünüz (onaylayıcı: " + onaylayanlar + ")")</div>
    </div>

    <div class="gt-tabs">
        <div class="gt-tab active" data-d="BEKLIYOR"><i class="fa-solid fa-hourglass-half"></i> Bekleyen <span class="cnt" id="cntBEKLIYOR">0</span></div>
        <div class="gt-tab" data-d="ONAYLANDI"><i class="fa-solid fa-check"></i> Onaylanan <span class="cnt" id="cntONAYLANDI">0</span></div>
        <div class="gt-tab" data-d="RED"><i class="fa-solid fa-xmark"></i> Reddedilen <span class="cnt" id="cntRED">0</span></div>
    </div>

    <div class="gt-card">
        @if (!onaylayici)
        {
            <div class="gt-note"><i class="fa-solid fa-circle-info"></i> Onay yetkisi <b>@onaylayanlar</b> kullanıcılarındadır. Talebiniz sonuçlanınca e-posta ile bilgilendirilirsiniz.</div>
        }
        <div class="gt-list" id="liste"><div class="gt-empty">Yükleniyor...</div></div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.js"></script>
<script>
    toastr.options = { positionClass: "toast-bottom-right", timeOut: 5000, progressBar: true };
    const ONAYLAYICI = @(onaylayici ? "true" : "false");
    let TALEPLER = [], aktif = 'BEKLIYOR';
    const TIP_AD = { GIDER: 'Gider', GELIR: 'Gelir', TIS: 'Teşvik / İstisna' };
    function esc(s) { return (s == null ? "" : String(s)).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])); }
    function tarih(s) { if (!s) return ''; const d = new Date(s); return isNaN(d) ? esc(s) : d.toLocaleDateString('tr-TR') + ' ' + d.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }

    function yukle() {
        fetch('/Rapor164/Talepler').then(r => r.json()).then(res => {
            if (!res.success) { toastr.error(res.message); return; }
            TALEPLER = res.data || [];
            ['BEKLIYOR', 'ONAYLANDI', 'RED'].forEach(d => document.getElementById('cnt' + d).textContent = TALEPLER.filter(t => t.durum === d).length);
            render();
        }).catch(e => toastr.error('Yüklenemedi: ' + e));
    }
    function render() {
        const arr = TALEPLER.filter(t => t.durum === aktif);
        const el = document.getElementById('liste');
        if (!arr.length) { el.innerHTML = `<div class="gt-empty">${aktif === 'BEKLIYOR' ? 'Bekleyen talep yok.' : 'Kayıt yok.'}</div>`; return; }
        el.innerHTML = arr.map(t => `
            <div class="gt-item ${t.durum.toLowerCase()}">
                <div class="gt-head">
                    <div class="gt-yol"><span class="gt-tip ${esc(t.tip)}">${esc(TIP_AD[t.tip] || t.tip)}</span> &nbsp;<span>#${t.id}</span><br>
                        ${esc(t.anaGrup)} › ${esc(t.altGrup)} › <b>${esc(t.kalem)}</b></div>
                </div>
                ${t.aciklama ? `<div class="gt-aciklama">${esc(t.aciklama)}</div>` : ''}
                <div class="gt-meta"><i class="fa-solid fa-user"></i> ${esc(t.talepEden)} ${esc(t.talepEdenAd || '')} · <i class="fa-regular fa-clock"></i> ${tarih(t.talepTarihi)}
                    ${t.ekran ? ' · <i class="fa-solid fa-display"></i> ' + esc(t.ekran) : ''}${t.sirketDb ? ' · <i class="fa-solid fa-database"></i> ' + esc(t.sirketDb) : ''}${t.hesapKodu ? ' · hesap ' + esc(t.hesapKodu) : ''}</div>
                ${t.durum === 'BEKLIYOR'
                    ? (ONAYLAYICI ? (DUZENLE === t.id ? duzenleFormu(t) : `<div class="gt-actions"><input type="text" id="not-${t.id}" placeholder="Not (isteğe bağlı)"><button class="gt-btn ok" onclick="onayla(${t.id})"><i class="fa-solid fa-check"></i> Onayla ve Kataloğa Ekle</button><button class="gt-btn dz" onclick="duzenle(${t.id})" title="Onaydan önce tip, grup, kalem adı ve açıklamayı düzelt"><i class="fa-solid fa-pen"></i> Düzenle</button><button class="gt-btn no" onclick="reddet(${t.id})"><i class="fa-solid fa-xmark"></i> Reddet</button></div>`) : '<div class="gt-meta"><i class="fa-solid fa-hourglass-half"></i> Onay bekliyor</div>')
                    : `<div class="gt-sonuc ${t.durum.toLowerCase()}">${t.durum === 'ONAYLANDI' ? '<i class="fa-solid fa-check"></i> Onaylandı → kök kod <span class="gt-kod">' + esc(t.olusanKokKod) + '</span>' : '<i class="fa-solid fa-xmark"></i> Reddedildi'} · ${esc(t.onaylayan || '')} ${tarih(t.onayTarihi)}${t.onayNotu ? ' · ' + esc(t.onayNotu) : ''}</div>`}
            </div>`).join('');
        if (DUZENLE) { const f = document.getElementById('dzTip'); if (f) { dzListeleriDoldur(); } }
    }

    // ---- onaylayıcı düzenlemesi: bekleyen talebi onaydan önce düzelt ----
    let DUZENLE = null, KATALOG = [];
    function katalogYukle() {
        fetch('/Rapor164/Kodlar').then(r => r.json()).then(res => { if (res.success) KATALOG = res.data || []; }).catch(() => { });
    }
    function duzenleFormu(t) {
        const opt = (v, ad) => `<option value="${v}" ${t.tip === v ? 'selected' : ''}>${ad}</option>`;
        return `<div class="gt-edit">
            <div class="gt-edit-row"><label>Tip</label><select id="dzTip" onchange="dzListeleriDoldur()">${opt('GIDER', 'Gider')}${opt('GELIR', 'Gelir')}${opt('TIS', 'Teşvik / İstisna')}</select></div>
            <div class="gt-edit-row"><label>Ana Grup</label><input type="text" id="dzAna" list="dzAnaListe" value="${esc(t.anaGrup)}" oninput="dzListeleriDoldur()"><datalist id="dzAnaListe"></datalist></div>
            <div class="gt-edit-row"><label>Alt Grup</label><input type="text" id="dzAlt" list="dzAltListe" value="${esc(t.altGrup)}"><datalist id="dzAltListe"></datalist></div>
            <div class="gt-edit-row"><label>Kalem</label><input type="text" id="dzKalem" value="${esc(t.kalem)}"></div>
            <div class="gt-edit-row"><label>Hesap</label><input type="text" id="dzHesap" value="${esc(t.hesapKodu || '')}" placeholder="İlgili hesap kodu (isteğe bağlı)"></div>
            <div class="gt-edit-row"><label>Açıklama</label><textarea id="dzAciklama" rows="3">${esc(t.aciklama || '')}</textarea></div>
            <div class="gt-edit-ipucu"><i class="fa-solid fa-circle-info"></i> Katalogda var olan bir ana / alt grup adı seçilirse kalem o grubun altına numaralanır; yeni ad yazılırsa yeni grup açılır.</div>
            <div class="gt-actions">
                <button class="gt-btn ok" onclick="dzKaydet(${t.id}, true)"><i class="fa-solid fa-check"></i> Kaydet ve Onayla</button>
                <button class="gt-btn dz" onclick="dzKaydet(${t.id}, false)"><i class="fa-solid fa-floppy-disk"></i> Sadece Kaydet</button>
                <button class="gt-btn no" onclick="DUZENLE = null; render();"><i class="fa-solid fa-xmark"></i> Vazgeç</button>
            </div>
        </div>`;
    }
    function dzListeleriDoldur() {
        const tip = (document.getElementById('dzTip') || {}).value, ana = ((document.getElementById('dzAna') || {}).value || '').trim().toLocaleLowerCase('tr-TR');
        const k = KATALOG.filter(x => x.tip === tip);
        const analar = [...new Set(k.map(x => x.anaGrup))].sort();
        const altlar = [...new Set(k.filter(x => (x.anaGrup || '').toLocaleLowerCase('tr-TR') === ana).map(x => x.altGrup))].sort();
        const al = document.getElementById('dzAnaListe'), bl = document.getElementById('dzAltListe');
        if (al) al.innerHTML = analar.map(a => `<option value="${esc(a)}">`).join('');
        if (bl) bl.innerHTML = altlar.map(a => `<option value="${esc(a)}">`).join('');
    }
    function duzenle(id) { if (!KATALOG.length) katalogYukle(); DUZENLE = id; render(); }
    function dzKaydet(id, onaylaDa) {
        const v = k => (document.getElementById(k) || {}).value || '';
        const body = new URLSearchParams({ id, tip: v('dzTip'), anaGrup: v('dzAna').trim(), altGrup: v('dzAlt').trim(), kalem: v('dzKalem').trim(), aciklama: v('dzAciklama').trim(), hesapKodu: v('dzHesap').trim() });
        if (!body.get('anaGrup') || !body.get('altGrup') || !body.get('kalem')) { toastr.warning('Ana grup, alt grup ve kalem adı boş olamaz.'); return; }
        fetch('/Rapor164/TalepDuzenle', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body.toString() })
            .then(r => r.json()).then(res => {
                if (!res.success) { toastr.error(res.message, '', { timeOut: 9000 }); return; }
                DUZENLE = null;
                if (onaylaDa) {
                    if (!confirm('Talep düzeltilmiş haliyle onaylanacak ve kalem kataloğa eklenecek. Devam edilsin mi?')) { yukle(); return; }
                    fetch('/Rapor164/TalepOnayla', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'id=' + id + '&not=' + encodeURIComponent('Onaylayıcı düzelterek onayladı.') })
                        .then(r => r.json()).then(r2 => { if (r2.success) toastr.success(r2.message, '', { timeOut: 9000 }); else toastr.error(r2.message, '', { timeOut: 9000 }); yukle(); });
                } else { toastr.success(res.message); yukle(); }
            }).catch(e => toastr.error('Hata: ' + e));
    }
    function onayla(id) {
        const not = (document.getElementById('not-' + id) || {}).value || '';
        if (!confirm('Talep onaylanacak ve kalem kataloğa eklenecek. Devam edilsin mi?')) return;
        fetch('/Rapor164/TalepOnayla', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'id=' + id + '&not=' + encodeURIComponent(not) })
            .then(r => r.json()).then(res => { if (res.success) { toastr.success(res.message, '', { timeOut: 9000 }); yukle(); } else toastr.error(res.message, '', { timeOut: 9000 }); });
    }
    function reddet(id) {
        const not = (document.getElementById('not-' + id) || {}).value || '';
        if (!confirm('Talep reddedilecek. Devam edilsin mi?')) return;
        fetch('/Rapor164/TalepReddet', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'id=' + id + '&not=' + encodeURIComponent(not) })
            .then(r => r.json()).then(res => { if (res.success) { toastr.success(res.message); yukle(); } else toastr.error(res.message); });
    }
    document.querySelectorAll('.gt-tab').forEach(t => t.addEventListener('click', function () { document.querySelectorAll('.gt-tab').forEach(x => x.classList.remove('active')); this.classList.add('active'); aktif = this.dataset.d; render(); }));
    yukle();
    if (ONAYLAYICI) katalogYukle();
</script>
