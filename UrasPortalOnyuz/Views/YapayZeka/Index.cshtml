@{
    ViewData["Title"] = "AI Asistanı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-brain me-2"></i>Akıllı Asistan</h5>
                </div>
                <div class="card-body">

                    <div id="chatBox" class="border rounded p-3 mb-3 bg-light" style="height: 400px; overflow-y: auto;">
                        <div class="text-center text-muted mt-5">
                            <i class="fas fa-robot fa-3x mb-3 text-success"></i>
                            <p>Hangi şirketi merak ediyorsan direkt sorabilirsin!</p>
                            <span class="badge bg-white text-dark border p-2 m-1">"Avrupa'da en çok satış yapılan gün?"</span>
                            <span class="badge bg-white text-dark border p-2 m-1">"Makine şirketinde maaş toplamı ne?"</span>
                        </div>
                    </div>

                    <div class="input-group input-group-lg">
                        <input type="text" id="txtSoru" class="form-control" placeholder="Örn: Avrupa'da satışlar nasıl?" onkeydown="if(event.key==='Enter') sendQuestion()">
                        <button class="btn btn-success" type="button" onclick="sendQuestion()">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function sendQuestion() {
            var input = document.getElementById("txtSoru");
            var soru = input.value;
            if (!soru.trim()) return;

            var chatBox = document.getElementById("chatBox");

            // Kullanıcı mesajı
            chatBox.innerHTML += `<div class="text-end mb-2"><span class="bg-success text-white p-2 rounded">${soru}</span></div>`;
            input.value = "";
            chatBox.scrollTop = chatBox.scrollHeight;

            // Loading
            var loadingId = "load-" + Date.now();
            chatBox.innerHTML += `<div id="${loadingId}" class="text-start mb-2"><span class="bg-white border p-2 rounded text-muted"><i class="fas fa-spinner fa-spin"></i> Düşünüyorum...</span></div>`;

            // Veri gönderimi (Sadece soru gidiyor, şirket seçimi yok)
            const formData = new FormData();
            formData.append('soru', soru);

            try {
                const res = await fetch('/YapayZeka/Sor', { method: 'POST', body: formData });
                const data = await res.json();

                document.getElementById(loadingId).remove();

                // Cevap Mesajı
                chatBox.innerHTML += `
                    <div class="text-start mb-3">
                        <div class="bg-white border p-3 rounded shadow-sm">
                            <div class="small text-success fw-bold mb-1"><i class="fas fa-magic"></i> Gemini AI</div>
                            ${data.cevap}
                            ${data.debug ? `<br><small class="text-muted" style="font-size:0.75rem">${data.debug}</small>` : ''}
                        </div>
                    </div>`;
            } catch (err) {
                document.getElementById(loadingId).innerHTML = "Hata oluştu.";
            }
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    </script>
}