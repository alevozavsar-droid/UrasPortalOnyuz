                <div class="na-mini" id="ibSayi"></div>
                <div class="table-responsive" style="max-height:560px">
                    <table class="na-tablo" id="ibTablo" data-dinamik="kapali">
                        <thead><tr><th>Tarih</th><th>Gönderim No</th><th>İhracatçı Şirket</th><th>Dosya / Fatura</th><th>Cari Kodu</th><th>Kısa Ad / Resmi Ünvan</th><th>Ödeme Şekli</th><th>Alıcı</th><th>Amaç</th><th>Belge Seti</th><th>Akreditif · İbraz Son</th><th>İbraz Riski</th><th>Kargo Firması</th><th>Gönderim No</th><th class="s">Masraf (TL)</th><th>Durum</th><th>Teslim</th><th>Banka Sonucu</th><th>Gönderen</th></tr></thead>
                        <tbody></tbody>
                        <tfoot><tr><td colspan="9">Toplam (filtre)</td><td class="s" id="ibTopBelge"></td><td colspan="4" id="ibTopSayi"></td><td class="s" id="ibTopMasraf"></td><td colspan="4" id="ibTopSonuc"></td></tr></tfoot>
                    </table>
