                    <div><label>Bitiş</label><input class="form-control" type="date" id="ibBit"></div>
                    <div><label>İhracatçı Şirket</label><select class="form-select" id="ibSirket"><option value="">Tümü</option>@foreach (var s in sirketler) { <option>@s</option> }</select></div>
                    <div><label>Ödeme Şekli</label><select class="form-select" id="ibOdeme"><option value="">Tümü</option></select></div>
                    <div><label>Amaç</label><select class="form-select" id="ibAmacF"><option value="">Tümü</option></select></div>
                    <div><label>Alıcı Tipi</label><select class="form-select" id="ibAliciTipi"><option value="">Tümü</option></select></div>
                    <div><label>Kargo Firması</label><select class="form-select" id="ibKargoF"><option value="">Tümü</option></select></div>
                    <div><label>Gönderim Durumu</label><select class="form-select" id="ibDurum"><option value="">Tümü</option></select></div>
                    <div><label>Banka Sonucu</label><select class="form-select" id="ibBanka"><option value="">Tümü</option></select></div>
                    <div><label>İbraz Riski</label><select class="form-select" id="ibRiskF"><option value="">Tümü</option></select></div>
                    <div><label>Belge Türü</label><select class="form-select" id="ibBelgeTur"><option value="">Tümü</option></select></div>
                    <div><label>Gönderen</label><select class="form-select" id="ibGonderenF"><option value="">Tümü</option></select></div>
                    <div><label>Ülke</label><select class="form-select" id="ibUlke"><option value="">Tümü</option></select></div>
                    <div><label>Cari Sınıfı</label><select class="form-select" id="ibSinif"><option value="">Tümü</option></select></div>
                    <div><label>İlişki Durumu</label><select class="form-select" id="ibIliski"><option value="">Tümü</option></select></div>
