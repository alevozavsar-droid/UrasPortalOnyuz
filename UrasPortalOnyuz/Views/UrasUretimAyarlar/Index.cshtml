@{
    ViewData["Title"] = "Yetkilendirme";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0 text-gray-800 fw-bold"><i class="fas fa-user-lock me-2 text-primary"></i> Yetkilendirme (Referans)</h2>
</div>

<div class="alert alert-warning py-2 mb-3">
    <i class="fas fa-triangle-exclamation me-1"></i>
    Bu ekran uras_production'dan taşınan <b>birebir referans kopyadır</b>. Buradaki izin ayarları bu projenin
    <b>gerçek yetki sistemini etkilemez</b>. Kişi bazlı gerçek erişim kontrolü için
    <a href="/Permission">Sistem Yetkileri</a> ekranını kullanın.
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><button class="nav-link active" id="tabYetkiBtn" onclick="sekmeSec('yetki')"><i class="fas fa-user-shield me-1"></i>Kullanıcı Yetkileri</button></li>
    <li class="nav-item"><button class="nav-link" id="tabMailBtn" onclick="sekmeSec('mail')"><i class="fas fa-envelope me-1"></i>Mail Alıcıları</button></li>
</ul>

<div id="sekmeYetki">
    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <div class="card dash-card h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold small text-uppercase text-muted">Kullanıcılar</span>
                    <span class="badge bg-primary" id="kullaniciSayisi">0</span>
                </div>
                <div class="card-body">
                    <input type="text" id="fAra" class="form-control form-control-sm mb-2" placeholder="Ad veya kod ara…" oninput="listeCiz()">
                    <div id="listeYukleniyor" class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span>Yükleniyor…</div>
                    <div id="kullaniciListe" style="max-height:65vh; overflow-y:auto;"></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-8">
            <div id="detayYok" class="card dash-card p-5 text-center text-muted">
                <i class="fas fa-user-shield fs-1 mb-2"></i>
                Yetkilerini düzenlemek için soldan bir kullanıcı seçin.
            </div>
            <div id="detayKart" class="card dash-card" style="display:none;">
                <div class="card-header bg-white">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <div class="flex-grow-1">
                            <h5 class="mb-0" id="dUsername"></h5>
                            <small class="text-muted" id="dCode"></small>
                            <span class="badge bg-warning text-dark ms-2" id="dOzelRozet" style="display:none;">Özel yetki tanımlı</span>
                        </div>
                        <div class="input-group input-group-sm" style="width:auto;">
                            <span class="input-group-text">Rol</span>
                            <select id="dRol" class="form-select form-select-sm"></select>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="izinGruplari"></div>
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <button class="btn btn-outline-danger btn-sm" onclick="sablonaDondur()"><i class="fas fa-rotate-left me-1"></i>Şablona Döndür</button>
                        <button class="btn btn-primary" onclick="yetkiKaydet()"><i class="fas fa-save me-1"></i>Kaydet</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="sekmeMail" style="display:none;">
    <div class="card dash-card mb-3">
        <div class="card-header bg-white fw-bold small text-uppercase text-muted">Yeni Alıcı Ekle</div>
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-3"><label class="form-label small fw-bold">Ad / Tanım</label><input type="text" id="nAd" class="form-control form-control-sm" placeholder="örn. Kalite Sorumlusu"></div>
                <div class="col-12 col-md-3"><label class="form-label small fw-bold">E-posta *</label><input type="email" id="nEmail" class="form-control form-control-sm" placeholder="kullanici@ornek.local"></div>
                <div class="col-6 col-md-1 text-center"><label class="form-label small d-block">Giriş KK</label><input type="checkbox" id="nGirisKK" class="form-check-input"></div>
                <div class="col-6 col-md-1 text-center"><label class="form-label small d-block">Satınalma KK</label><input type="checkbox" id="nSatinalmaKK" class="form-check-input"></div>
                <div class="col-6 col-md-1 text-center"><label class="form-label small d-block">Tutanak</label><input type="checkbox" id="nTutanak" class="form-check-input"></div>
                <div class="col-6 col-md-1 text-center"><label class="form-label small d-block">Bakım</label><input type="checkbox" id="nBakim" class="form-check-input"></div>
                <div class="col-6 col-md-1 text-center"><label class="form-label small d-block">Üretim Onay</label><input type="checkbox" id="nUretimOnay" class="form-check-input"></div>
                <div class="col-6 col-md-1"><button class="btn btn-primary btn-sm w-100" onclick="aliciEkle()"><i class="fas fa-plus"></i></button></div>
            </div>
        </div>
    </div>
    <div class="card dash-card">
        <div class="table-responsive">
            <table class="table table-hover table-custom mb-0">
                <thead><tr><th>Ad</th><th>E-posta</th><th class="text-center">Giriş KK</th><th class="text-center">Satınalma KK</th><th class="text-center">Tutanak</th><th class="text-center">Bakım</th><th class="text-center">Üretim Onay</th><th></th></tr></thead>
                <tbody id="tbodyAlicilar"></tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .dash-card { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
    .table-custom th { background-color: #f8f9fc; text-transform: uppercase; font-size: 11px; color: #858796; border-bottom: 2px solid #e3e6f0; }
    .table-custom td { vertical-align: middle; font-size: 13px; color: #5a5c69; }
    .kullanici-satir { padding: 8px 10px; border-radius: 8px; cursor: pointer; }
    .kullanici-satir:hover { background: #f8f9fc; }
    .kullanici-satir.secili { background: #eef2ff; border-left: 3px solid #4e73df; }
    .izin-grup { border: 1px solid #e3e6f0; border-radius: 8px; margin-bottom: 8px; }
    .izin-grup-baslik { background: #f8f9fc; padding: 8px 12px; font-weight: 700; font-size: 12px; text-transform: uppercase; color: #4a5568; cursor: pointer; }
    .izin-grup-govde { padding: 6px; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2px; }
    .izin-satir { display: flex; align-items: center; gap: 6px; padding: 4px 8px; font-size: 13px; }
    .izin-satir label { cursor: pointer; margin: 0; }
</style>

<script>
    let kullanicilar = [], tanimlar = [], roller = [], secili = null, izinler = {}, varsayilan = {};

    function sekmeSec(s) {
        document.getElementById('sekmeYetki').style.display = s === 'yetki' ? '' : 'none';
        document.getElementById('sekmeMail').style.display = s === 'mail' ? '' : 'none';
        document.getElementById('tabYetkiBtn').classList.toggle('active', s === 'yetki');
        document.getElementById('tabMailBtn').classList.toggle('active', s === 'mail');
        if (s === 'mail') mailAlicilariYukle();
    }

    async function baslangicYukle() {
        const [uRes, tRes] = await Promise.all([
            fetch('/UrasUretimAyarlar/GetUsers').then(r => r.json()),
            fetch('/UrasUretimAyarlar/GetTanimlar').then(r => r.json())
        ]);
        document.getElementById('listeYukleniyor').style.display = 'none';
        if (uRes.success) kullanicilar = uRes.data;
        if (tRes.success) { tanimlar = tRes.data.tanimlar; roller = tRes.data.roller; }
        document.getElementById('dRol').innerHTML = roller.map(r => `<option value="${r.kod}">${r.ad}</option>`).join('');
        listeCiz();
    }

    function listeCiz() {
        const q = (document.getElementById('fAra').value || '').toLowerCase();
        const list = kullanicilar.filter(u => !q || (u.Username || '').toLowerCase().includes(q) || (u.Code || '').toLowerCase().includes(q));
        document.getElementById('kullaniciSayisi').textContent = list.length;
        document.getElementById('kullaniciListe').innerHTML = list.map(u => `
            <div class="kullanici-satir ${secili && secili.Code === u.Code ? 'secili' : ''}" onclick='kullaniciSec(${JSON.stringify(u)})'>
                <div class="fw-semibold">${u.Username || u.Code}</div>
                <small class="text-muted">${u.Code}${u.Ozel ? ' • <span class=\"text-warning\">özel yetki</span>' : ''}</small>
            </div>`).join('') || '<div class="text-muted text-center py-3">Kayıt yok.</div>';
    }

    async function kullaniciSec(u) {
        secili = u;
        listeCiz();
        document.getElementById('detayYok').style.display = 'none';
        document.getElementById('detayKart').style.display = '';
        document.getElementById('dUsername').textContent = u.Username || u.Code;
        document.getElementById('dCode').textContent = u.Code;
        document.getElementById('dOzelRozet').style.display = u.Ozel ? '' : 'none';
        document.getElementById('dRol').value = u.WebCode || '';
        const res = await fetch(`/UrasUretimAyarlar/GetUserYetki?code=${encodeURIComponent(u.Code)}&webCode=${encodeURIComponent(u.WebCode || '')}`).then(r => r.json());
        if (!res.success) { alert('Yetki bilgisi alınamadı: ' + res.message); return; }
        izinler = { ...res.data.perms };
        varsayilan = { ...res.data.defaults };
        izinGruplariCiz();
    }

    document.addEventListener('change', e => { if (e.target && e.target.id === 'dRol') rolDegisti(); });
    async function rolDegisti() {
        if (!secili) return;
        const webCode = document.getElementById('dRol').value;
        const res = await fetch(`/UrasUretimAyarlar/GetUserYetki?code=${encodeURIComponent(secili.Code)}&webCode=${encodeURIComponent(webCode)}`).then(r => r.json());
        if (res.success) { varsayilan = { ...res.data.defaults }; if (!secili.Ozel) izinler = { ...varsayilan }; izinGruplariCiz(); }
    }

    function izinGruplariCiz() {
        const gruplar = [...new Set(tanimlar.map(t => t.grup))];
        document.getElementById('izinGruplari').innerHTML = gruplar.map(g => {
            const satirlar = tanimlar.filter(t => t.grup === g).map(t => `
                <div class="izin-satir">
                    <input type="checkbox" id="izin_${t.key}" ${izinler[t.key] ? 'checked' : ''} onchange="izinler['${t.key}']=this.checked">
                    <label for="izin_${t.key}" title="${t.aciklama}">${t.ad}${varsayilan[t.key] !== izinler[t.key] ? ' <span class="text-info">●</span>' : ''}</label>
                </div>`).join('');
            const acikSayi = tanimlar.filter(t => t.grup === g && izinler[t.key]).length;
            return `<div class="izin-grup">
                        <div class="izin-grup-baslik">${g} <span class="text-muted fw-normal">(${acikSayi}/${tanimlar.filter(t => t.grup === g).length})</span></div>
                        <div class="izin-grup-govde">${satirlar}</div>
                    </div>`;
        }).join('');
    }

    function sablonaDondur() { izinler = { ...varsayilan }; izinGruplariCiz(); }

    async function yetkiKaydet() {
        if (!secili) return;
        const res = await fetch('/UrasUretimAyarlar/SaveUserYetki', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ Code: secili.Code, Username: secili.Username, WebCode: document.getElementById('dRol').value, Perms: izinler })
        }).then(r => r.json());
        alert(res.message);
        if (res.success) { secili.Ozel = true; secili.WebCode = document.getElementById('dRol').value; listeCiz(); }
    }

    // ---- Mail Alıcıları ----
    let alicilar = [];
    async function mailAlicilariYukle() {
        const res = await fetch('/UrasUretimAyarlar/GetMailAlicilar').then(r => r.json());
        if (res.success) { alicilar = res.data; aliciTabloCiz(); }
    }
    function aliciTabloCiz() {
        document.getElementById('tbodyAlicilar').innerHTML = alicilar.map(a => `
            <tr><td class="fw-semibold">${a.Ad || ''}</td><td>${a.Email}</td>
                <td class="text-center">${a.GirisKK === 'Y' ? '✓' : ''}</td><td class="text-center">${a.SatinalmaKK === 'Y' ? '✓' : ''}</td>
                <td class="text-center">${a.Tutanak === 'Y' ? '✓' : ''}</td><td class="text-center">${a.Bakim === 'Y' ? '✓' : ''}</td>
                <td class="text-center">${a.UretimOnay === 'Y' ? '✓' : ''}</td>
                <td><button class="btn btn-sm btn-outline-danger" onclick="aliciSil(${a.Id})"><i class="fas fa-trash"></i></button></td></tr>`).join('')
            || '<tr><td colspan="8" class="text-center text-muted py-3">Tanımlı mail alıcısı yok.</td></tr>';
    }
    async function aliciEkle() {
        const email = document.getElementById('nEmail').value.trim();
        if (!email) { alert('E-posta adresi zorunludur.'); return; }
        const body = {
            Ad: document.getElementById('nAd').value.trim(), Email: email,
            GirisKK: document.getElementById('nGirisKK').checked ? 'Y' : 'N',
            SatinalmaKK: document.getElementById('nSatinalmaKK').checked ? 'Y' : 'N',
            Tutanak: document.getElementById('nTutanak').checked ? 'Y' : 'N',
            Bakim: document.getElementById('nBakim').checked ? 'Y' : 'N',
            UretimOnay: document.getElementById('nUretimOnay').checked ? 'Y' : 'N'
        };
        const res = await fetch('/UrasUretimAyarlar/SaveMailAlici', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        if (!res.success) { alert(res.message); return; }
        ['nAd', 'nEmail'].forEach(id => document.getElementById(id).value = '');
        ['nGirisKK', 'nSatinalmaKK', 'nTutanak', 'nBakim', 'nUretimOnay'].forEach(id => document.getElementById(id).checked = false);
        mailAlicilariYukle();
    }
    async function aliciSil(id) {
        if (!confirm('Bu alıcıyı silmek istediğinize emin misiniz?')) return;
        const res = await fetch('/UrasUretimAyarlar/DeleteMailAlici', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ Id: id }) }).then(r => r.json());
        if (!res.success) { alert(res.message); return; }
        mailAlicilariYukle();
    }

    baslangicYukle();
</script>
