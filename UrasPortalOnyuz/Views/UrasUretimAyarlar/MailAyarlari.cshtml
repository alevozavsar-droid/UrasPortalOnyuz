@{
    ViewData["Title"] = "Mail Ayarları";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0 text-gray-800 fw-bold"><i class="fas fa-envelope-circle-check me-2 text-primary"></i> Mail (SMTP) Ayarları</h2>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-6">
        <div class="card dash-card">
            <div class="card-body">
                <div class="alert alert-secondary py-2 small">
                    <i class="fas fa-circle-info me-1"></i>
                    Bu bilgiler <code>appsettings.json → SmtpSettings</code> üzerinden okunur ve bu projenin diğer tüm
                    mail gönderen ekranlarıyla aynı hesabı kullanır — <b>buradan değiştirilemez</b>. Alıcı listesi
                    yönetimi için <a href="/UrasUretimAyarlar">Yetkilendirme &gt; Mail Alıcıları</a> sekmesini kullanın.
                </div>

                <div id="yukleniyor" class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span>Yükleniyor…</div>

                <div id="icerik" style="display:none;">
                    <div class="row g-3">
                        <div class="col-12 col-md-8"><label class="form-label small fw-bold">SMTP Sunucusu</label><input type="text" id="fHost" class="form-control" disabled></div>
                        <div class="col-12 col-md-4"><label class="form-label small fw-bold">Port</label><input type="text" id="fPort" class="form-control" disabled></div>
                        <div class="col-12"><label class="form-label small fw-bold">Gönderici E-posta</label><input type="text" id="fEmail" class="form-control" disabled></div>
                        <div class="col-12"><label class="form-label small fw-bold">SSL / TLS</label><input type="text" id="fSsl" class="form-control" disabled></div>
                    </div>

                    <hr class="my-4">

                    <label class="form-label small fw-bold">Test Maili Gönder</label>
                    <div class="input-group">
                        <input type="email" id="fTestAlici" class="form-control" placeholder="kullanici@ornek.local">
                        <button class="btn btn-primary" onclick="testGonder()"><i class="fas fa-paper-plane me-1"></i>Gönder</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dash-card { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
</style>

<script>
    async function yukle() {
        const res = await fetch('/UrasUretimAyarlar/GetMailAyar').then(r => r.json());
        document.getElementById('yukleniyor').style.display = 'none';
        if (!res.success) { alert('Ayarlar alınamadı: ' + res.message); return; }
        document.getElementById('icerik').style.display = '';
        document.getElementById('fHost').value = res.data.Host || '';
        document.getElementById('fPort').value = res.data.Port || '';
        document.getElementById('fEmail').value = res.data.Email || '';
        document.getElementById('fSsl').value = res.data.Ssl === 'Y' ? 'Açık' : 'Kapalı';
    }

    async function testGonder() {
        const alici = document.getElementById('fTestAlici').value.trim();
        if (!alici) { alert('Test için alıcı adresi girin.'); return; }
        const res = await fetch('/UrasUretimAyarlar/SendTestMail', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ Alici: alici }) }).then(r => r.json());
        alert(res.message);
    }

    yukle();
</script>
