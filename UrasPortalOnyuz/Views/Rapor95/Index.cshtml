        <button type="button" data-p="urun"><i class="fas fa-flask me-1"></i>Ürün Bazında</button>
        <button type="button" data-p="gunluk"><i class="fas fa-clock-rotate-left me-1"></i>Günlük <span class="n" id="ofN-gunluk">0</span></button>
    </div>

    <div class="na-panel aktif" data-p="musteri">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-wand-magic-sparkles me-1"></i>Toplu Fiyat Oluştur · Fiyat Verilmemiş Kalemlere Min Fiyat Listesi + %</span><span class="not">önce önizlenir, Yeni Fiyat sütununa yazılır; Kaydet ile tanımlanır</span></div>
            <div class="na-kart-g">
                <div class="of-toplu">
                    <div class="satir">
                        <div><label>Taban Fiyat</label><select class="form-select" id="ofTaban"><option value="min">Min Fiyat Listesi</option><option value="liste">Liste Fiyatı</option><option value="sonSatis">Son Satış Fiyatı (Yoksa Min)</option></select></div>
                        <div><label>Eklenecek %</label><input type="number" step="0.5" class="form-control" id="ofOran" value="15"></div>
                        <div><label>Kapsam</label><select class="form-select" id="ofKapsam"><option value="fiyatsiz">Yalnız Fiyatsız Kalemler</option><option value="aldigi">Aldığı Ama Fiyatsız Kalemler</option><option value="grup">Seçili Gruptaki Fiyatsız Kalemler</option><option value="secili">Tabloda İşaretli Kalemler</option><option value="tumu">Tüm Kalemler (Üzerine Yaz)</option></select></div>
                        <div><label>Ürün Grubu (Kapsam Grup)</label><select class="form-select" id="ofTopluGrup"></select></div>
                        <div><label>Yuvarlama</label><select class="form-select" id="ofYuvarla"><option value="0.01">0,01 $</option><option value="0.05">0,05 $</option><option value="0.10">0,10 $</option></select></div>
                        <div><label>&nbsp;</label><button type="button" class="btn btn-primary btn-sm py-0" id="ofTopluUygula" style="font-size:.68rem;height:28px"><i class="fas fa-calculator me-1"></i>Hesapla ve Tabloya Yaz</button></div>
                        <div><label>&nbsp;</label><button type="button" class="btn btn-light border btn-sm py-0" id="ofTopluTemizle" style="font-size:.68rem;height:28px" title="Kaydedilmemiş yeni fiyatları temizle">Temizle</button></div>
                    </div>
                    <div class="of-grup-oran" id="ofGrupOranlar"></div>
                    <div class="formul" id="ofFormul"></div>
                </div>
            </div>
        </div>

        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-table-list me-1"></i>Tüm Ürünler · Müşteri Fiyat Listesi</span><span class="not" id="ofSayi"></span></div>
            <div class="na-kart-g">
                <div class="of-filtre">
                    <div><label>Durum</label><select class="form-select" id="ofDurumF"><option value="">Tümü</option><option value="fiyatsiz">Fiyatsız</option><option value="aldigi-fiyatsiz">Aldığı · Fiyatsız</option><option value="aldigi">Aldığı Ürünler</option><option value="fiyatli">Özel Fiyatı Olan</option><option value="degisen">Kaydedilmemiş Değişiklik</option><option value="minalti">Min Altı</option><option value="suresi">Süresi Dolan / Dolacak</option></select></div>
                    <div><label>Ürün Grubu</label><select class="form-select" id="ofGrupF"><option value="">Tümü</option></select></div>
                    <div><label>Ürün Ara</label><input class="form-control" id="ofAra" placeholder="Kod, ürün adı, seri…" autocomplete="off"></div>
                    <div><label>Geçerlilik Başlangıç</label><input type="date" class="form-control" id="ofBas"></div>
                    <div><label>Geçerlilik Bitiş</label><input type="date" class="form-control" id="ofBit" title="boş = süresiz"></div>
                    <div><label>&nbsp;</label><button type="button" class="btn btn-light border btn-sm py-0" id="ofSeciliHepsi" style="font-size:.64rem;height:28px" title="Görünen satırların tümünü işaretle / kaldır"><i class="fas fa-check-double me-1"></i>Görünenleri İşaretle</button></div>
                    <div><label>&nbsp;</label><button type="button" class="btn btn-light border btn-sm py-0" id="ofSeciliMin" style="font-size:.64rem;height:28px" title="İşaretli satırlara Min Fiyat + % (yukarıdaki oran) yaz"><i class="fas fa-plus me-1"></i>İşaretlilere Min + %</button></div>
                    <div><label>&nbsp;</label><button type="button" class="btn btn-light border btn-sm py-0" id="ofSeciliSil" style="font-size:.64rem;height:28px" title="İşaretli satırların özel fiyatını kaldır (Kaydet ile)"><i class="fas fa-eraser me-1"></i>İşaretlilerin Fiyatını Kaldır</button></div>
                    <div><label>&nbsp;</label><button type="button" class="btn btn-light border btn-sm py-0" id="ofCsv" style="font-size:.64rem;height:28px" title="Tablo (min, liste, son satış, özel fiyat) CSV"><i class="fas fa-file-csv me-1"></i>Tablo CSV</button></div>
                </div>
            </div>
            <div class="na-kart-g p-0 pt-0"><div class="table-responsive" style="max-height:62vh"><table class="na-tablo of-tablo" id="ofTablo" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
