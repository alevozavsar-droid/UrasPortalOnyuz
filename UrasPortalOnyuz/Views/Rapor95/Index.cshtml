@{
    ViewData["Title"] = "Muhataplar İçin Özel Fiyatlar";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string onSatici = (string)ViewBag.Satici ?? "";
    string onKod = (string)ViewBag.Kod ?? "";
    string onUrun = (string)ViewBag.Urun ?? "";
    string onSekme = (string)ViewBag.Sekme ?? "musteri";
    bool yonetici = (bool)(ViewBag.Yonetici ?? false);
    string ben = (string)ViewBag.Ben ?? "";
}
@*
    MUHATAPLAR İÇİN ÖZEL FİYATLAR — Satış ve Operasyon › Müşteri ve CRM Yönetimi › Fiyat ve Müşteri Koşulları. Her müşteri için TÜM ürünlerde satış fiyatı:
      • Müşteri Fiyat Listesi : satıcı şirket + müşteri seçilir; tüm ürünler tek tabloda — Min Fiyat, Liste Fiyatı, son satış, mevcut özel fiyat, Yeni Fiyat (düzenlenir), min üstü %, ₺ karşılığı, geçerlilik.
                                Toplu fiyat: fiyatsız (ya da aldığı / grup / seçili / tüm) kalemlere Min Fiyat Listesi (ya da Liste Fiyatı / Son Satış) + % ile fiyat üretilir, önizlenir, Kaydet ile tanımlanır.
                                Kopyala: başka müşterinin fiyatlarını (yalnız fiyatsız kalemlere) ± % ile al. PDF / Excel: müşteriye gönderilecek fiyat listesi (min / liste fiyatı yazılmaz).
      • Ürün Bazında          : bir ürünün satıcının tüm müşterilerindeki fiyatı, son satışı, Fiyat Yönetimi oran fiyatı.
      • Günlük                : kim, ne zaman, hangi müşteri / ürün, eski → yeni, kaynak.
    Kurallar: Min Fiyat Listesi = satıcı alış fiyatı (Fiyat Yönetimi) × (1 + %5); özel fiyat min fiyatın altına inemez (yalnız Yönetici onayıyla). Veri: /Rapor95/Veri · Toplu · Kaydet · Kopyala · Urun · Gunluk · Pdf · Excel
    (Controllers/Rapor95Controller.cs, Data/OzelFiyatOrnek.cs) · betik: wwwroot/js/ozel-fiyat.js · derin bağlantı: ?satici=Selvi Kimya&kod=120.001&sekme=musteri|urun|gunluk&urun=BOY-EMP-001
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<style>
    .na.of { --na-k: #0e7490; }
    .of-pill { font-size: .66rem; font-weight: 700; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 3px 10px; } a.of-pill { text-decoration: none; } a.of-pill:hover { background: #e0f2fe; color: #0c4a6e; border-color: #bae6fd; }
    .of-pill.yetki { background: #dcfce7; color: #166534; border-color: #bbf7d0; } .of-pill.salt { background: #fef3c7; color: #92400e; border-color: #fde68a; }
    .of-sec { display: grid; grid-template-columns: 1fr 1.6fr 1.2fr 1fr 1fr 1fr; gap: 6px 8px; align-items: end; }
    .of-sec label, .of-toplu label, .of-filtre label, .of-kopya label { display: block; font-size: .58rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 2px; }
    .of-sec .form-control, .of-sec .form-select, .of-toplu .form-control, .of-toplu .form-select, .of-filtre .form-control, .of-filtre .form-select, .of-kopya .form-control, .of-kopya .form-select { font-size: .72rem; padding: 3px 7px; height: 28px; }
    @@media (max-width: 1200px) { .of-sec { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    #of .na-kpi { grid-template-columns: repeat(7, 1fr); } @@media (max-width: 1300px) { #of .na-kpi { grid-template-columns: repeat(4, 1fr); } }
    #of .na-kpi > div.aktif { outline: 2px solid var(--k, #0e7490); outline-offset: -1px; }
    /* toplu fiyat paneli: taban + % + kapsam + yuvarlama; grup bazında oran kutuları */
    .of-toplu { background: #ecfeff; border: 1px solid #a5f3fc; border-radius: 10px; padding: 8px 10px; }
    .of-toplu .satir { display: grid; grid-template-columns: 1.2fr .8fr 1.2fr 1.2fr .9fr auto auto; gap: 6px 8px; align-items: end; } @@media (max-width: 1300px) { .of-toplu .satir { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    .of-toplu .formul { font-size: .68rem; color: #155e75; margin-top: 6px; } .of-toplu .formul b { color: #0e7490; }
    .of-grup-oran { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; } .of-grup-oran > div { display: flex; align-items: center; gap: 4px; background: #fff; border: 1px solid #a5f3fc; border-radius: 8px; padding: 3px 8px; font-size: .66rem; }
    .of-grup-oran input { width: 58px; font-size: .68rem; height: 24px; padding: 1px 5px; text-align: right; } .of-grup-oran small { color: #64748b; }
    .of-filtre { display: grid; grid-template-columns: 1.1fr 1fr 1.6fr .9fr .9fr auto auto auto auto; gap: 6px 8px; align-items: end; } @@media (max-width: 1300px) { .of-filtre { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    #of .of-tablo { font-size: .68rem; table-layout: fixed; width: 100%; }
    #of .of-tablo th { font-size: .56rem; padding: 5px 5px; white-space: normal; line-height: 1.15; vertical-align: middle; position: sticky; top: 0; z-index: 3; background: #f8fafc; box-shadow: 0 1px 0 #e2e8f0; }
    #of .of-tablo td { padding: 3px 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; vertical-align: middle; line-height: 1.2; border-bottom: 1px solid #e2e8f0; }
    #of .of-tablo td.sol { text-align: left !important; } #of .of-tablo td.para { font-variant-numeric: tabular-nums; text-align: right !important; } #of .of-tablo td.para b { font-weight: 800; }
    #of .of-tablo td small { display: block; font-size: .56rem; color: #64748b; font-weight: 500; line-height: 1.15; overflow: hidden; text-overflow: ellipsis; }
    #of .of-tablo tr.aldi-fiyatsiz td { background: #fef2f2; } #of .of-tablo tr.fiyatsiz td { background: #fffbeb; } #of .of-tablo tr.degisti td { background: #ecfeff; } #of .of-tablo tr.minalti td { background: #fee2e2; } #of .of-tablo tr.suresi td { background: #f5f3ff; }
    #of .of-tablo tr.toplam td { font-weight: 800; background: #f8fafc; border-top: 2px solid #0e7490; }
    #of .of-tablo tr.ara td { background: #f1f5f9; font-weight: 800; border-top: 1px solid #cbd5e1; }
    .of-fiyat { width: 92px; text-align: right; font-size: .72rem; padding: 2px 6px; height: 26px; font-variant-numeric: tabular-nums; margin: 0 auto; }
    .of-fiyat.degisti { border-color: #0e7490; background: #ecfeff; } .of-fiyat.minalti { border-color: #dc2626; background: #fee2e2; color: #991b1b; font-weight: 700; }
    .of-rozet { display: inline-block; font-size: .56rem; font-weight: 800; border-radius: 4px; padding: 1px 5px; white-space: nowrap; } .of-rozet.ok { background: #dcfce7; color: #166534; } .of-rozet.uyar { background: #fef3c7; color: #92400e; } .of-rozet.hata { background: #fee2e2; color: #991b1b; } .of-rozet.bilgi { background: #dbeafe; color: #1e40af; } .of-rozet.notr { background: #f1f5f9; color: #475569; } .of-rozet.mor { background: #ede9fe; color: #5b21b6; }
    .of-kaynak { display: inline-block; font-size: .54rem; font-weight: 800; border-radius: 4px; padding: 0 4px; background: #e2e8f0; color: #334155; white-space: nowrap; }
    #of .btn-xs { font-size: .58rem; padding: 1px 5px; line-height: 1.3; }
    .of-kaydet { position: sticky; bottom: 0; background: #fff; border-top: 1px solid #e2e8f0; padding: 8px 12px; display: flex; gap: 6px; align-items: center; z-index: 4; flex-wrap: wrap; }
    .of-kaydet .n { margin-left: auto; font-size: .68rem; color: #64748b; } .of-kaydet .uyari { font-size: .66rem; color: #991b1b; font-weight: 700; }
    .of-kopya { background: #fff7ed; border: 1px solid #fed7aa; border-radius: 10px; padding: 8px 10px; display: none; } .of-kopya.acik { display: block; }
    .of-kopya .satir { display: grid; grid-template-columns: 2fr 1fr .8fr auto auto; gap: 6px 8px; align-items: end; }
    .of-urun-sec { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1fr; gap: 6px 8px; align-items: end; }
    #of .of-tablo tr.tik { cursor: pointer; } #of .of-tablo tr.tik:hover td { background: #f0f9ff; }
    .of-uyari { font-size: .68rem; color: #991b1b; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 5px 10px; }
</style>
}

<div class="container-fluid py-3 na of" id="of" data-satici="@onSatici" data-kod="@onKod" data-urun="@onUrun" data-sekme="@onSekme" data-yonetici="@(yonetici ? "1" : "")">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-tags"></i></span>Muhataplar İçin Özel Fiyatlar</h4>
        <span class="of-pill" id="ofSaticiPill"><i class="fas fa-store me-1"></i>…</span>
        <span class="of-pill @(yonetici ? "yetki" : "salt")" title="@(yonetici ? "Yönetici: min fiyatın altına onaylayarak fiyat girebilir" : "Min Fiyat Listesi'nin altına fiyat giremez")"><i class="fas @(yonetici ? "fa-user-shield" : "fa-user") me-1"></i>@(yonetici ? "Yönetici · Min Altı Onay Yetkili" : "Satış · Min Fiyat Sınırı") · @ben</span>
        <a class="of-pill" href="/FiyatYonetimi?sekme=musteri" target="_blank" rel="noopener" title="Min Fiyat Listesi'nin kaynağı: üretici → satıcı kâr oranları ve fiyatlandırma kuru"><i class="fas fa-percent me-1"></i>Fiyat Yönetimi · Min Fiyat Kaynağı</a>
        <a class="of-pill" id="ofCariLink" href="/Rapor120" target="_blank" rel="noopener"><i class="fas fa-address-book me-1"></i>Cari Bilgileri</a>
