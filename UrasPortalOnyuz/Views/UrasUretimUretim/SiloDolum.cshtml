@{
    ViewData["Title"] = "Silo Dolum";
}

<script src="https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h2 class="h4 mb-0 text-gray-800 fw-bold"><i class="fas fa-database me-2 text-primary"></i> Silo Dolum</h2>
    <ul class="nav nav-pills" id="sekmeler">
        <li class="nav-item"><a class="nav-link active" href="javascript:void(0)" onclick="sekmeSec('silolar')" id="tabSilolar">Silolar <span id="siloSayisi" class="badge bg-white text-primary ms-1"></span></a></li>
        <li class="nav-item"><a class="nav-link" href="javascript:void(0)" onclick="sekmeSec('hareketler')" id="tabHareketler">Hareketler</a></li>
        <li class="nav-item"><a class="nav-link" href="javascript:void(0)" onclick="sekmeSec('tanimlar')" id="tabTanimlar">Tanımlar</a></li>
    </ul>
</div>

<div class="row g-2 mb-3" id="ozetSatiri"></div>

<div id="panelSilolar">
    <div class="card dash-card">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <div class="btn-group btn-group-sm" id="filtreGrup">
                        <button class="btn btn-primary" onclick="filtreSec('hepsi')">Tümü</button>
                        <button class="btn btn-outline-primary" onclick="filtreSec('dolu')">Dolu</button>
                        <button class="btn btn-outline-primary" onclick="filtreSec('bos')">Boş</button>
                        <button class="btn btn-outline-primary" onclick="filtreSec('kritik')">Kritik</button>
                    </div>
                    <div class="form-check form-switch ms-2 mb-0"><input class="form-check-input" type="checkbox" id="pasifGoster" onchange="cizSilolar()"><label class="form-check-label small" for="pasifGoster">Pasifleri göster</label></div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm" onclick="tumunuYukle()"><i class="fas fa-rotate me-1"></i>Yenile</button>
                    <button class="btn btn-primary btn-sm" onclick="siloTanimAc(null)"><i class="fas fa-plus me-1"></i>Yeni Silo</button>
                </div>
            </div>
            <div id="siloBos" class="text-center text-muted py-5" style="display:none;"><i class="fas fa-database fs-1 d-block mb-2 opacity-50"></i>Bu filtreye uyan silo yok.</div>
            <div class="silo-grid" id="siloGrid"></div>
        </div>
    </div>
</div>

<div id="panelHareketler" style="display:none;">
    <div class="card dash-card">
        <div class="card-body">
            <div class="row g-2 align-items-end mb-3">
                <div class="col-6 col-md-3 col-xl-2"><label class="form-label small mb-1">Silo</label><select class="form-select form-select-sm" id="hrkSilo" onchange="hrkYukle(1)"><option value="">Tümü</option></select></div>
                <div class="col-6 col-md-3 col-xl-2"><label class="form-label small mb-1">Tip</label><select class="form-select form-select-sm" id="hrkTip" onchange="hrkYukle(1)"><option value="">Tümü</option><option value="D">Dolum</option><option value="T">Tüketim</option><option value="B">Boşaltma</option><option value="Z">Düzeltme</option></select></div>
                <div class="col-6 col-md-3 col-xl-2"><label class="form-label small mb-1">Başlangıç</label><input type="date" class="form-control form-control-sm" id="hrkBas" onchange="hrkYukle(1)"></div>
                <div class="col-6 col-md-3 col-xl-2"><label class="form-label small mb-1">Bitiş</label><input type="date" class="form-control form-control-sm" id="hrkBit" onchange="hrkYukle(1)"></div>
                <div class="col-12 col-md-8 col-xl-3"><label class="form-label small mb-1">Ara</label><input type="text" class="form-control form-control-sm" id="hrkArama" placeholder="Kalem, parti, iş emri, kullanıcı..." oninput="hrkAramaGecikmeli()"></div>
                <div class="col-12 col-md-4 col-xl-1 d-grid"><button class="btn btn-outline-secondary btn-sm" onclick="hrkYukle(1)"><i class="fas fa-rotate"></i></button></div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-custom mb-0">
                    <thead><tr><th>Zaman</th><th>Silo</th><th>Tip</th><th>Hammadde</th><th>Parti</th><th class="text-end">Miktar</th><th class="text-end">Önceki→Sonraki</th><th>İş Emri</th><th>Kullanıcı</th><th>Açıklama</th></tr></thead>
                    <tbody id="hrkTbody"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-2" id="hrkSayfalama" style="display:none;">
                <small class="text-muted" id="hrkBilgi"></small>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-secondary" id="hrkOnceki" onclick="hrkSayfaDegis(-1)"><i class="fas fa-chevron-left"></i></button>
                    <button class="btn btn-outline-secondary" id="hrkSonraki" onclick="hrkSayfaDegis(1)"><i class="fas fa-chevron-right"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="panelTanimlar" style="display:none;">
    <div class="card dash-card">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <div class="text-muted small"><i class="fas fa-circle-info me-1"></i>Silo adı, kapasite ve depo tanımlanır. Pasif silolar dolum ve üretimde kullanılmaz.</div>
                <button class="btn btn-primary btn-sm" onclick="siloTanimAc(null)"><i class="fas fa-plus me-1"></i>Yeni Silo</button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-custom mb-0">
                    <thead><tr><th>Sıra</th><th>Kod</th><th>Ad</th><th class="text-end">Kapasite</th><th>Depo</th><th>Durum</th><th>İçerik</th><th>Açıklama</th><th></th></tr></thead>
                    <tbody id="tanimTbody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Dolum Modal -->
<div class="modal fade" id="dolumModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title"><i class="fas fa-qrcode me-2"></i>Silo Dolumu — <span id="dolumSiloAd"></span></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <label class="form-label small fw-bold">Hammadde etiketini okutun / yazın (KalemKodu|PartiNo)</label>
                <div class="input-group mb-1">
                    <input type="text" id="dolumOkut" class="form-control" placeholder="örn. HM001|LOT2026001" onkeydown="if(event.key==='Enter') okutIsle()">
                    <button class="btn btn-outline-primary" onclick="okutIsle()">Doğrula</button>
                    <button class="btn btn-outline-secondary" type="button" id="kameraBtn" onclick="kameraToggle()" style="display:none;"><i class="fas fa-camera"></i></button>
                </div>
                <div class="text-muted small mb-2">El terminali okutmaları otomatik algılanır. Kamera için cihaz izni gerekir (HTTPS).</div>
                <div id="qrKamera" style="display:none; max-width:360px; margin:0 auto 10px; border-radius:12px; overflow:hidden;"></div>
                <div id="lotKart" style="display:none;" class="alert alert-secondary py-2"></div>
                <div id="dolumMiktarAlani" style="display:none;">
                    <label class="form-label small fw-bold mt-2">Miktar (kg)</label>
                    <input type="number" step="0.01" class="form-control" id="dolumMiktar" oninput="dolumOnizle()">
                    <div class="d-flex gap-1 flex-wrap mt-2">
                        <button class="btn btn-sm btn-outline-primary" id="doldurBtn" onclick="miktarSec(bosAlanHesapla())">Doldur</button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="miktarSec(250)">250</button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="miktarSec(500)">500</button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="miktarSec(1000)">1000</button>
                        <button class="btn btn-sm btn-outline-secondary" id="stokKadarBtn" style="display:none;" onclick="miktarSec(dolumLot.Stok)">Stok kadar</button>
                    </div>
                    <div id="dolumUyari" class="text-danger small mt-1"></div>
                    <label class="form-label small fw-bold mt-2">Açıklama (isteğe bağlı)</label>
                    <input type="text" class="form-control" id="dolumAciklama" maxlength="254">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary" id="dolumKaydetBtn" onclick="dolumKaydet()" disabled><i class="fas fa-check me-1"></i>Dolumu Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- Düzelt Modal -->
<div class="modal fade" id="duzeltModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Kalanı Düzelt — <span id="duzeltSiloAd"></span></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <label class="form-label small fw-bold">Yeni Kalan (kg)</label>
                <input type="number" step="0.01" class="form-control mb-2" id="duzeltMiktar">
                <label class="form-label small fw-bold">Açıklama (zorunlu)</label>
                <input type="text" class="form-control" id="duzeltAciklama" maxlength="254">
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-warning" onclick="duzeltKaydet()">Kaydet</button></div>
        </div>
    </div>
</div>

<!-- Tanım Modal -->
<div class="modal fade" id="tanimModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="tanimBaslik">Yeni Silo</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="tCode">
                <div class="row g-2">
                    <div class="col-8"><label class="form-label small fw-bold">Silo Adı</label><input type="text" class="form-control" id="tAd" maxlength="30"></div>
                    <div class="col-4"><label class="form-label small fw-bold">Sıra</label><input type="number" class="form-control" id="tSira" value="0"></div>
                    <div class="col-6"><label class="form-label small fw-bold">Kapasite (kg)</label><input type="number" step="0.01" class="form-control" id="tKapasite"></div>
                    <div class="col-6"><label class="form-label small fw-bold">Depo</label><select class="form-select" id="tWhsCode"><option value="">Tüm depolar</option></select></div>
                    <div class="col-12"><label class="form-label small fw-bold">Açıklama</label><input type="text" class="form-control" id="tAciklama" maxlength="254"></div>
                    <div class="col-12"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="tAktif" checked><label class="form-check-label" for="tAktif">Aktif</label></div></div>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-primary" onclick="siloTanimKaydet()">Kaydet</button></div>
        </div>
    </div>
</div>

<style>
    .dash-card { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
    .table-custom th { background-color: #f8f9fc; text-transform: uppercase; font-size: 11px; color: #858796; border-bottom: 2px solid #e3e6f0; }
    .table-custom td { vertical-align: middle; font-size: 13px; color: #5a5c69; }
    .kpi-card { border-radius: 10px; border: 1px solid #e3e6f0; padding: 10px 14px; background: #fff; }
    .kpi-card .l { font-size: .64rem; font-weight: 800; letter-spacing: .5px; text-transform: uppercase; color: #858796; }
    .kpi-card .v { font-size: 1.1rem; font-weight: 700; color: #1e293b; }
    .kpi-card .s { font-size: .68rem; color: #94a3b8; }
    .silo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; }
    .silo-kart { background: #fff; border: 1px solid #e3e6f0; border-radius: 14px; padding: 14px; }
    .silo-kart.pasif { opacity: .55; }
    .silo-kart .sk-ad { font-weight: 800; font-size: 1rem; color: #1e293b; }
    .silo-kart .sk-kod { font-size: .68rem; color: #94a3b8; font-weight: 700; }
    .sk-durum { font-size: .64rem; font-weight: 800; padding: 3px 8px; border-radius: 999px; text-transform: uppercase; }
    .sk-durum.dolu { background: #dcfce7; color: #166534; } .sk-durum.orta { background: #fef3c7; color: #92400e; }
    .sk-durum.kritik { background: #fee2e2; color: #991b1b; } .sk-durum.bos { background: #f1f5f9; color: #64748b; } .sk-durum.pasif { background: #e2e8f0; color: #475569; }
    .doluluk-bar { height: 10px; border-radius: 6px; background: #f1f5f9; overflow: hidden; margin: 8px 0; }
    .doluluk-bar > div { height: 100%; border-radius: 6px; }
    .sk-btnlar { display: flex; gap: 6px; margin-top: 10px; }
    .sk-btnlar .btn { flex: 1; font-size: .78rem; }
</style>

<script>
    let silolar = [], ozet = {}, filtre = 'hepsi', aktifSekme = 'silolar';
    let hrkSayfa = 1, hrkToplam = 0, hrkBoy = 50;
    let dolumSilo = null, dolumLot = null;
    function fmt(n, d) { return (Number(n) || 0).toLocaleString('tr-TR', { minimumFractionDigits: d, maximumFractionDigits: d }); }

    function sekmeSec(s) {
        aktifSekme = s;
        ['Silolar', 'Hareketler', 'Tanimlar'].forEach(x => document.getElementById('tab' + x).classList.toggle('active', x.toLowerCase() === s));
        document.getElementById('panelSilolar').style.display = s === 'silolar' ? '' : 'none';
        document.getElementById('panelHareketler').style.display = s === 'hareketler' ? '' : 'none';
        document.getElementById('panelTanimlar').style.display = s === 'tanimlar' ? '' : 'none';
        if (s === 'hareketler') hrkYukle(1);
        if (s === 'tanimlar') cizTanimlar();
    }

    function filtreSec(f) {
        filtre = f;
        document.querySelectorAll('#filtreGrup .btn').forEach(b => b.className = 'btn btn-outline-primary');
        event.target.className = 'btn btn-primary';
        cizSilolar();
    }

    async function tumunuYukle() {
        const [rSilo, rOzet, rWhs] = await Promise.all([
            fetch('/UrasUretimUretim/GetSilolar').then(r => r.json()),
            fetch('/UrasUretimUretim/GetSiloOzet').then(r => r.json()),
            fetch('/UrasUretimUretim/GetWarehousesUretim').then(r => r.json())
        ]);
        if (rSilo.success) silolar = rSilo.data;
        if (rOzet.success) ozet = rOzet.data;
        if (rWhs.success) {
            const selT = document.getElementById('tWhsCode'), selH = document.getElementById('hrkSilo');
            rWhs.data.forEach(w => { selT.innerHTML += `<option value="${w.WhsCode}">${w.WhsCode} - ${w.WhsName}</option>`; });
        }
        document.getElementById('hrkSilo').innerHTML = '<option value="">Tümü</option>' + silolar.map(s => `<option value="${s.Code}">${s.Ad}</option>`).join('');
        cizOzet(); cizSilolar(); cizTanimlar();
    }

    function cizOzet() {
        document.getElementById('siloSayisi').textContent = silolar.length || '';
        document.getElementById('ozetSatiri').innerHTML = `
            <div class="col-6 col-md-2"><div class="kpi-card" style="border-left:3px solid #2a78d6"><div class="l">Aktif Silo</div><div class="v">${ozet.Aktif || 0}</div><div class="s">toplam ${ozet.Toplam || 0}</div></div></div>
            <div class="col-6 col-md-2"><div class="kpi-card" style="border-left:3px solid #1baf7a"><div class="l">Dolu</div><div class="v">${ozet.Dolu || 0}</div><div class="s">${fmt(ozet.ToplamKalan, 0)}/${fmt(ozet.ToplamKapasite, 0)} kg</div></div></div>
            <div class="col-6 col-md-2"><div class="kpi-card" style="border-left:3px solid #94a3b8"><div class="l">Boş</div><div class="v">${ozet.Bos || 0}</div><div class="s">dolum bekliyor</div></div></div>
            <div class="col-6 col-md-3"><div class="kpi-card" style="border-left:3px solid #e34948"><div class="l">Kritik (&lt;%20)</div><div class="v">${ozet.Kritik || 0}</div><div class="s">yakında bitecek</div></div></div>
            <div class="col-6 col-md-3"><div class="kpi-card" style="border-left:3px solid #4a3aa7"><div class="l">Bugün Hareket</div><div class="v">${ozet.BugunHareket || 0}</div><div class="s">dolum/tüketim</div></div></div>`;
    }

    function durumSinif(s) { if (s.Aktif !== 'Y') return 'pasif'; if (!s.ItemCode) return 'bos'; if (s.DolulukYuzde < 20) return 'kritik'; if (s.DolulukYuzde < 60) return 'orta'; return 'dolu'; }
    function durumMetin(s) { const c = durumSinif(s); return { pasif: 'Pasif', bos: 'Boş', kritik: 'Kritik', orta: 'Orta', dolu: 'Dolu' }[c]; }
    function renkSinif(s) { const c = durumSinif(s); return { kritik: '#e34948', orta: '#eda100', dolu: '#1baf7a', bos: '#cbd5e1', pasif: '#94a3b8' }[c]; }

    function gorunenSilolar() {
        return silolar.filter(s => {
            if (s.Aktif !== 'Y' && !document.getElementById('pasifGoster').checked) return false;
            if (filtre === 'dolu') return s.Kalan > 0;
            if (filtre === 'bos') return !(s.Kalan > 0);
            if (filtre === 'kritik') return s.DolulukYuzde < 20 && s.Kalan > 0;
            return true;
        });
    }

    function cizSilolar() {
        const list = gorunenSilolar();
        document.getElementById('siloBos').style.display = list.length ? 'none' : '';
        document.getElementById('siloGrid').innerHTML = list.map(s => `
            <div class="silo-kart ${s.Aktif !== 'Y' ? 'pasif' : ''}">
                <div class="d-flex justify-content-between align-items-start">
                    <div><div class="sk-ad">${s.Ad}</div><div class="sk-kod">#${s.Code} ${s.WhsCode ? '• ' + s.WhsCode : ''} • ${fmt(s.Kapasite, 0)} kg</div></div>
                    <span class="sk-durum ${durumSinif(s)}">${durumMetin(s)}</span>
                </div>
                <div class="doluluk-bar"><div style="width:${Math.min(100, s.DolulukYuzde)}%; background:${renkSinif(s)}"></div></div>
                <div class="fw-bold">${fmt(s.Kalan, 2)} <span class="text-muted small">/ ${fmt(s.Kapasite, 0)} ${s.Birim || 'KG'} (${fmt(s.DolulukYuzde, 0)}%)</span></div>
                ${s.ItemCode ? `<div class="small mt-1"><b>${s.ItemName || s.ItemCode}</b><div class="text-muted">${s.ItemCode} • parti ${s.Parti}</div>${(s.PartiStok + 0.0005 < s.Kalan) ? `<div class="text-danger small"><i class="fas fa-triangle-exclamation"></i> depo stoğu (${fmt(s.PartiStok, 2)} kg) kalandan az</div>` : ''}</div>` : '<div class="text-muted small mt-1"><i class="fas fa-arrow-down"></i> Boş — etiket okutup dolum yapın</div>'}
                <div class="sk-btnlar">
                    <button class="btn btn-primary" ${s.Aktif !== 'Y' ? 'disabled' : ''} onclick='dolumAc(${JSON.stringify(s)})'><i class="fas fa-qrcode me-1"></i>Dolum</button>
                    <button class="btn btn-outline-danger" ${(!s.ItemCode && s.Kalan <= 0) ? 'disabled' : ''} onclick="bosalt('${s.Code}')"><i class="fas fa-box-open"></i></button>
                    <button class="btn btn-outline-warning" ${!s.ItemCode ? 'disabled' : ''} onclick='duzeltAc(${JSON.stringify(s)})'><i class="fas fa-pen"></i></button>
                </div>
            </div>`).join('');
    }

    function cizTanimlar() {
        document.getElementById('tanimTbody').innerHTML = silolar.map(s => `
            <tr><td>${s.Sira}</td><td class="text-muted">#${s.Code}</td><td class="fw-bold">${s.Ad}</td><td class="text-end">${fmt(s.Kapasite, 0)} kg</td><td>${s.WhsCode || '—'}</td>
                <td><span class="badge ${s.Aktif === 'Y' ? 'bg-success' : 'bg-secondary'}">${s.Aktif === 'Y' ? 'Aktif' : 'Pasif'}</span></td>
                <td class="small">${s.ItemCode ? `${s.ItemCode} / ${s.Parti} — ${fmt(s.Kalan, 2)} kg` : '<span class="text-muted">boş</span>'}</td>
                <td class="small text-muted">${s.Aciklama || ''}</td>
                <td><button class="btn btn-sm btn-outline-primary" onclick='siloTanimAc(${JSON.stringify(s)})'><i class="fas fa-pen"></i></button></td></tr>`).join('') || '<tr><td colspan="9" class="text-center text-muted py-3">Silo tanımı yok.</td></tr>';
    }

    // ---- Dolum ----
    // Kaynaktaki etiketAyristir ile birebir: ayraç |, ; veya tab; tek değer girilirse (kalem zaten
    // siloda varsa) parti numarası olarak kabul edilir.
    function etiketAyristir(metin) {
        const t = (metin || '').trim();
        if (!t) return null;
        const parcalar = t.split(/[|;\t]/).map(x => x.trim()).filter(Boolean);
        if (parcalar.length >= 2) return { itemCode: parcalar[0], parti: parcalar[1] };
        if (dolumSilo && dolumSilo.ItemCode) return { itemCode: dolumSilo.ItemCode, parti: parcalar[0] };
        return { itemCode: '', parti: parcalar[0] };
    }
    function bosAlanHesapla() {
        if (!dolumSilo) return 0;
        return Math.max(0, Math.round((dolumSilo.Kapasite - dolumSilo.Kalan) * 1000) / 1000);
    }

    function dolumAc(s) {
        dolumSilo = s; dolumLot = null;
        document.getElementById('dolumSiloAd').textContent = s.Ad;
        document.getElementById('dolumOkut').value = ''; document.getElementById('lotKart').style.display = 'none';
        document.getElementById('dolumMiktarAlani').style.display = 'none'; document.getElementById('dolumMiktar').value = '';
        document.getElementById('dolumKaydetBtn').disabled = true;
        document.getElementById('kameraBtn').style.display = kameraDestekVarMi() ? '' : 'none';
        new bootstrap.Modal('#dolumModal').show();
        setTimeout(() => document.getElementById('dolumOkut').focus(), 300);
    }

    async function okutIsle() {
        const ham = document.getElementById('dolumOkut').value;
        const p = etiketAyristir(ham);
        const kart = document.getElementById('lotKart');
        if (!p) return;
        if (!p.itemCode) {
            kart.style.display = ''; kart.className = 'alert alert-danger py-2';
            kart.textContent = 'Etikette kalem kodu bulunamadı. Format: KalemNo|PartiNo';
            document.getElementById('dolumMiktarAlani').style.display = 'none'; document.getElementById('dolumKaydetBtn').disabled = true;
            return;
        }
        const res = await fetch(`/UrasUretimUretim/GetLotBilgi?itemCode=${encodeURIComponent(p.itemCode)}&parti=${encodeURIComponent(p.parti)}&whsCode=${encodeURIComponent(dolumSilo.WhsCode || '')}`).then(r => r.json());
        kart.style.display = '';
        if (!res.success) { kart.className = 'alert alert-danger py-2'; kart.textContent = res.message; document.getElementById('dolumMiktarAlani').style.display = 'none'; document.getElementById('dolumKaydetBtn').disabled = true; return; }
        dolumLot = res.data;
        if (!dolumLot.PartiliKalem) { kart.className = 'alert alert-danger py-2'; kart.textContent = 'Kalem parti yönetimli değil; siloya alınamaz.'; document.getElementById('dolumMiktarAlani').style.display = 'none'; document.getElementById('dolumKaydetBtn').disabled = true; return; }
        if (dolumLot.Stok <= 0) { kart.className = 'alert alert-warning py-2'; kart.textContent = 'Bu partinin depoda stoğu yok.'; document.getElementById('dolumMiktarAlani').style.display = 'none'; document.getElementById('dolumKaydetBtn').disabled = true; return; }
        if (dolumSilo.Kalan > 0 && (dolumSilo.ItemCode !== dolumLot.ItemCode || String(dolumSilo.Parti || '').toUpperCase() !== String(dolumLot.Parti || '').toUpperCase())) {
            kart.className = 'alert alert-danger py-2';
            kart.textContent = `Silo dolu (${dolumSilo.ItemCode} / ${dolumSilo.Parti}, ${fmt(dolumSilo.Kalan, 2)} kg). Farklı parti için önce siloyu boşaltın.`;
            document.getElementById('dolumMiktarAlani').style.display = 'none'; document.getElementById('dolumKaydetBtn').disabled = true;
            return;
        }
        kart.className = 'alert alert-success py-2';
        kart.innerHTML = `<b>${dolumLot.ItemName || dolumLot.ItemCode}</b> (${dolumLot.ItemCode})<br>Parti: <span class="font-monospace">${dolumLot.Parti}</span> • Depo stoğu: ${fmt(dolumLot.Stok, 2)} ${dolumLot.Birim} • Giriş: ${dolumLot.GirisTarihi || '—'}`;
        document.getElementById('dolumMiktarAlani').style.display = '';
        document.getElementById('stokKadarBtn').style.display = dolumLot.Stok < bosAlanHesapla() ? '' : 'none';
        // Kaynaktaki gibi varsayılan miktar: boş alan ile depo stoğu arasındaki küçük olan.
        document.getElementById('dolumMiktar').value = Math.min(bosAlanHesapla(), dolumLot.Stok);
        dolumOnizle();
        if (kameraAcik) kameraToggle();
    }

    function miktarSec(v) { document.getElementById('dolumMiktar').value = Math.round(Math.max(0, v) * 1000) / 1000; dolumOnizle(); }
    function dolumOnizle() {
        const m = Number(document.getElementById('dolumMiktar').value) || 0;
        const uyari = document.getElementById('dolumUyari');
        uyari.textContent = '';
        if (m > 0 && dolumSilo.Kalan + m > dolumSilo.Kapasite + 0.0005)
            uyari.textContent = `Kapasite aşımı: en fazla ${fmt(bosAlanHesapla(), 2)} kg dolum yapılabilir.`;
        else if (m > 0 && dolumLot && (dolumSilo.Kalan + m) > dolumLot.Stok + 0.0005)
            uyari.textContent = `Partinin depo stoğu (${fmt(dolumLot.Stok, 2)} kg) yetersiz.`;
        document.getElementById('dolumKaydetBtn').disabled = !(m > 0) || uyari.textContent !== '';
    }

    // ---- Kamera (html5-qrcode) ----
    let kameraAcik = false, qrOkuyucu = null;
    function kameraDestekVarMi() { return !!(window.Html5Qrcode && navigator.mediaDevices && navigator.mediaDevices.getUserMedia); }
    function kameraToggle() {
        if (!kameraDestekVarMi()) return;
        const kutu = document.getElementById('qrKamera'), btn = document.getElementById('kameraBtn');
        if (kameraAcik) {
            kameraAcik = false; kutu.style.display = 'none'; btn.innerHTML = '<i class="fas fa-camera"></i>';
            if (qrOkuyucu) qrOkuyucu.stop().then(() => qrOkuyucu.clear()).catch(() => { });
            return;
        }
        kameraAcik = true; kutu.style.display = ''; btn.innerHTML = '<i class="fas fa-camera-slash"></i>';
        setTimeout(() => {
            if (!kameraAcik) return; // bu gecikme içinde kapatılmışsa başlatma
            try {
                qrOkuyucu = qrOkuyucu || new Html5Qrcode('qrKamera');
                qrOkuyucu.start({ facingMode: 'environment' }, { fps: 10, qrbox: { width: 220, height: 220 } },
                    metin => { document.getElementById('dolumOkut').value = metin; okutIsle(); },
                    () => { });
            } catch (e) {
                kameraAcik = false; kutu.style.display = 'none'; btn.innerHTML = '<i class="fas fa-camera"></i>';
                alert('Kamera başlatılamadı: ' + (e.message || e));
            }
        }, 100);
    }
    document.getElementById('dolumModal').addEventListener('hidden.bs.modal', () => {
        if (kameraAcik) {
            kameraAcik = false; document.getElementById('qrKamera').style.display = 'none';
            if (qrOkuyucu) qrOkuyucu.stop().then(() => qrOkuyucu.clear()).catch(() => { });
        }
    });

    async function dolumKaydet() {
        const m = Number(document.getElementById('dolumMiktar').value) || 0;
        const body = { siloCode: dolumSilo.Code, itemCode: dolumLot.ItemCode, parti: dolumLot.Parti, miktar: m, aciklama: document.getElementById('dolumAciklama').value };
        const res = await fetch('/UrasUretimUretim/SiloDolumKaydet', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        alert(res.message);
        if (res.success) { bootstrap.Modal.getInstance(document.getElementById('dolumModal')).hide(); tumunuYukle(); }
    }

    async function bosalt(code) {
        if (!confirm('Silo boşaltılsın mı?')) return;
        const res = await fetch('/UrasUretimUretim/SiloBosalt', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ siloCode: code, aciklama: 'Boşaltma' }) }).then(r => r.json());
        alert(res.message);
        if (res.success) tumunuYukle();
    }

    let duzeltCode = null;
    function duzeltAc(s) {
        duzeltCode = s.Code;
        document.getElementById('duzeltSiloAd').textContent = s.Ad;
        document.getElementById('duzeltMiktar').value = s.Kalan;
        document.getElementById('duzeltAciklama').value = '';
        new bootstrap.Modal('#duzeltModal').show();
    }
    async function duzeltKaydet() {
        const body = { siloCode: duzeltCode, miktar: Number(document.getElementById('duzeltMiktar').value) || 0, aciklama: document.getElementById('duzeltAciklama').value };
        const res = await fetch('/UrasUretimUretim/SiloDuzelt', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        alert(res.message);
        if (res.success) { bootstrap.Modal.getInstance(document.getElementById('duzeltModal')).hide(); tumunuYukle(); }
    }

    function siloTanimAc(s) {
        document.getElementById('tanimBaslik').textContent = s ? 'Silo Düzenle' : 'Yeni Silo';
        document.getElementById('tCode').value = s ? s.Code : '';
        document.getElementById('tAd').value = s ? s.Ad : '';
        document.getElementById('tSira').value = s ? s.Sira : 0;
        document.getElementById('tKapasite').value = s ? s.Kapasite : '';
        document.getElementById('tWhsCode').value = s ? (s.WhsCode || '') : '';
        document.getElementById('tAciklama').value = s ? (s.Aciklama || '') : '';
        document.getElementById('tAktif').checked = s ? s.Aktif === 'Y' : true;
        new bootstrap.Modal('#tanimModal').show();
    }
    async function siloTanimKaydet() {
        const body = {
            code: document.getElementById('tCode').value, ad: document.getElementById('tAd').value, kapasite: Number(document.getElementById('tKapasite').value) || 0,
            whsCode: document.getElementById('tWhsCode').value, aktif: document.getElementById('tAktif').checked, sira: Number(document.getElementById('tSira').value) || 0, aciklama: document.getElementById('tAciklama').value
        };
        const res = await fetch('/UrasUretimUretim/SiloTanimKaydet', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        alert(res.message);
        if (res.success) { bootstrap.Modal.getInstance(document.getElementById('tanimModal')).hide(); tumunuYukle(); }
    }

    // ---- Hareketler ----
    let hrkZamanlayici = null;
    function hrkAramaGecikmeli() { clearTimeout(hrkZamanlayici); hrkZamanlayici = setTimeout(() => hrkYukle(1), 350); }
    async function hrkYukle(sayfa) {
        hrkSayfa = sayfa;
        const qs = new URLSearchParams({ siloCode: document.getElementById('hrkSilo').value, tip: document.getElementById('hrkTip').value, search: document.getElementById('hrkArama').value, basTarih: document.getElementById('hrkBas').value, bitTarih: document.getElementById('hrkBit').value, page: sayfa, pageSize: hrkBoy });
        const res = await fetch('/UrasUretimUretim/GetSiloHareketler?' + qs.toString()).then(r => r.json());
        if (!res.success) return;
        hrkToplam = res.data.toplam;
        const list = res.data.liste;
        document.getElementById('hrkTbody').innerHTML = list.map(h => `
            <tr><td class="text-nowrap">${h.Tarih}</td><td class="fw-semibold">${h.SiloAd}</td><td><span class="badge bg-secondary">${h.TipAd}</span></td>
                <td>${h.ItemName || h.ItemCode}<div class="text-muted small">${h.ItemCode}</div></td><td class="font-monospace">${h.Parti}</td>
                <td class="text-end fw-bold">${fmt(h.Miktar, 2)}</td><td class="text-end text-muted">${fmt(h.Onceki, 2)} → ${fmt(h.Sonraki, 2)}</td>
                <td>${h.OworEntry ? '#' + h.OworEntry : ''}</td><td>${h.Kullanici}</td><td class="small text-muted">${h.Aciklama || ''}</td></tr>`).join('') || '<tr><td colspan="10" class="text-center text-muted py-3">Kayıt yok.</td></tr>';
        document.getElementById('hrkSayfalama').style.display = hrkToplam > hrkBoy ? '' : 'none';
        document.getElementById('hrkBilgi').textContent = `Toplam ${hrkToplam} kayıt • Sayfa ${hrkSayfa}`;
        document.getElementById('hrkOnceki').disabled = hrkSayfa <= 1;
        document.getElementById('hrkSonraki').disabled = hrkSayfa * hrkBoy >= hrkToplam;
    }
    function hrkSayfaDegis(d) { hrkYukle(hrkSayfa + d); }

    tumunuYukle();
</script>
