@{
    ViewData["Title"] = "Kalem Ana Verileri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0 text-gray-800 fw-bold"><i class="fas fa-box me-2 text-primary"></i> Kalem Ana Verileri</h2>
    <button class="btn btn-success btn-sm" onclick="kalemFormAc(null)"><i class="fas fa-plus me-1"></i>Yeni Kalem</button>
</div>

<div class="row g-2 mb-3" id="statSatiri"></div>

<div class="card dash-card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-3"><label class="form-label small fw-bold">Ara</label><input type="text" class="form-control form-control-sm" id="fSearch" placeholder="Kod veya ad..." oninput="aramaGecikmeli()"></div>
            <div class="col-6 col-md-2"><label class="form-label small fw-bold">Grup</label><select class="form-select form-select-sm" id="fGrup" onchange="sayfa=1; yukle();"><option value="">Tümü</option></select></div>
            <div class="col-6 col-md-2"><label class="form-label small fw-bold">Durum</label><select class="form-select form-select-sm" id="fFrozen" onchange="sayfa=1; yukle();"><option value="">Tümü</option><option value="N">Etkin</option><option value="Y">Etkin Değil</option></select></div>
            <div class="col-6 col-md-2"><label class="form-label small fw-bold">Parti Yön.</label><select class="form-select form-select-sm" id="fParti" onchange="sayfa=1; yukle();"><option value="">Tümü</option><option value="Y">Evet</option><option value="N">Hayır</option></select></div>
            <div class="col-6 col-md-2"><label class="form-label small fw-bold">Stok</label><select class="form-select form-select-sm" id="fStok" onchange="sayfa=1; yukle();"><option value="">Tümü</option><option value="var">Var</option><option value="yok">Yok</option></select></div>
            <div class="col-6 col-md-2"><label class="form-label small fw-bold">Birim</label><select class="form-select form-select-sm" id="fBirim" onchange="sayfa=1; yukle();"><option value="">Tüm Birimler</option></select></div>
            <div class="col-6 col-md-1 d-grid"><button class="btn btn-outline-secondary btn-sm" onclick="sayfa=1; yukle();"><i class="fas fa-rotate"></i></button></div>
            <div class="col-6 col-md-2 d-grid"><button class="btn btn-outline-secondary btn-sm" id="btnFiltreTemizle" onclick="filtreleriTemizle()" style="display:none;"><i class="fas fa-filter-circle-xmark me-1"></i>Temizle</button></div>
        </div>
    </div>
</div>

<div class="table-responsive shadow-sm rounded-3 border">
    <table class="table table-hover table-custom mb-0">
        <thead><tr><th>Kalem Kodu</th><th>Kalem Adı</th><th>Grup</th><th class="text-center">Birim</th><th class="text-center">Parti</th><th class="text-center">Durum</th><th class="text-end">Stok</th><th></th></tr></thead>
        <tbody id="tbodyKalemler"></tbody>
    </table>
</div>
<div class="d-flex justify-content-between align-items-center mt-2">
    <small class="text-muted" id="sayfaBilgi"></small>
    <div class="btn-group btn-group-sm">
        <button class="btn btn-outline-secondary" id="btnOnceki" onclick="sayfaDegis(-1)"><i class="fas fa-chevron-left"></i></button>
        <button class="btn btn-outline-secondary" id="btnSonraki" onclick="sayfaDegis(1)"><i class="fas fa-chevron-right"></i></button>
    </div>
</div>

<!-- Ekle/Güncelle Modal -->
<div class="modal fade" id="kalemModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="kalemModalBaslik">Yeni Kalem</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-6"><label class="form-label small fw-bold">Kalem Kodu</label><input type="text" class="form-control" id="kItemCode" maxlength="50"></div>
                    <div class="col-6"><label class="form-label small fw-bold">Kalem Grubu</label><select class="form-select" id="kGrup"></select></div>
                    <div class="col-12"><label class="form-label small fw-bold">Kalem Adı</label><input type="text" class="form-control" id="kItemName" maxlength="200"></div>
                    <div class="col-12"><label class="form-label small fw-bold">Yabancı Ad</label><input type="text" class="form-control" id="kForeignName" maxlength="200"></div>
                    <div class="col-6"><label class="form-label small fw-bold">Envanter Birimi</label><select class="form-select" id="kUom"></select></div>
                    <div class="col-6"><label class="form-label small fw-bold">Satış Birimi</label><select class="form-select" id="kSecondUom"><option value="">—</option></select></div>
                    <div class="col-6"><div class="form-check form-switch mt-4"><input class="form-check-input" type="checkbox" id="kManBtchNum"><label class="form-check-label" for="kManBtchNum">Parti yönetimli</label></div></div>
                    <div class="col-6"><div class="form-check form-switch mt-4"><input class="form-check-input" type="checkbox" id="kFrozen"><label class="form-check-label" for="kFrozen">Etkin değil (donuk)</label></div></div>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-primary" onclick="kalemKaydet()">Kaydet</button></div>
        </div>
    </div>
</div>

<style>
    .dash-card { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
    .table-custom th { background-color: #f8f9fc; text-transform: uppercase; font-size: 11px; color: #858796; border-bottom: 2px solid #e3e6f0; }
    .table-custom td { vertical-align: middle; font-size: 13px; color: #5a5c69; }
    .kpi-card { border-radius: 10px; border: 1px solid #e3e6f0; padding: 10px 14px; background: #fff; }
    .kpi-card .l { font-size: .64rem; font-weight: 800; letter-spacing: .5px; text-transform: uppercase; color: #858796; }
    .kpi-card .v { font-size: 1.2rem; font-weight: 800; color: #1e293b; }
</style>

<script>
    let sayfa = 1, pageSize = 50, toplamSayfa = 0, gruplar = [], uomListe = [];
    function fmt(n, d) { return (Number(n) || 0).toLocaleString('tr-TR', { minimumFractionDigits: d, maximumFractionDigits: d }); }

    let aramaZamanlayici = null;
    function aramaGecikmeli() { clearTimeout(aramaZamanlayici); aramaZamanlayici = setTimeout(() => { sayfa = 1; yukle(); }, 350); }

    async function ilkYukle() {
        const [rGrup, rUom, rStat] = await Promise.all([
            fetch('/UrasUretimUretim/GetItemGroups').then(r => r.json()),
            fetch('/UrasUretimUretim/GetUomList').then(r => r.json()),
            fetch('/UrasUretimUretim/GetKalemStats').then(r => r.json())
        ]);
        if (rGrup.success) {
            gruplar = rGrup.data;
            document.getElementById('fGrup').innerHTML = '<option value="">Tümü</option>' + gruplar.map(g => `<option value="${g.ItmsGrpCod}">${g.ItmsGrpNam}</option>`).join('');
            document.getElementById('kGrup').innerHTML = gruplar.map(g => `<option value="${g.ItmsGrpCod}">${g.ItmsGrpNam}</option>`).join('');
        }
        if (rUom.success) {
            uomListe = rUom.data;
            document.getElementById('kUom').innerHTML = uomListe.map(u => `<option value="${u.UomCode}">${u.UomName}</option>`).join('');
            document.getElementById('kSecondUom').innerHTML = '<option value="">—</option>' + uomListe.map(u => `<option value="${u.UomCode}">${u.UomName}</option>`).join('');
            document.getElementById('fBirim').innerHTML = '<option value="">Tüm Birimler</option>' + uomListe.map(u => `<option value="${u.UomCode}">${u.UomCode}${u.UomName ? ' - ' + u.UomName : ''}</option>`).join('');
        }
        if (rStat.success && rStat.data) {
            const s = rStat.data;
            document.getElementById('statSatiri').innerHTML = `
                <div class="col-6 col-md-3"><div class="kpi-card" style="border-left:3px solid #2a78d6"><div class="l">Toplam Kalem</div><div class="v">${fmt(s.Toplam, 0)}</div></div></div>
                <div class="col-6 col-md-3"><div class="kpi-card" style="border-left:3px solid #1baf7a"><div class="l">Etkin</div><div class="v">${fmt(s.Etkin, 0)}</div></div></div>
                <div class="col-6 col-md-3"><div class="kpi-card" style="border-left:3px solid #e34948"><div class="l">Etkin Değil</div><div class="v">${fmt(s.EtkinDegil, 0)}</div></div></div>
                <div class="col-6 col-md-3"><div class="kpi-card" style="border-left:3px solid #eda100"><div class="l">Parti Yönetimli</div><div class="v">${fmt(s.Partili, 0)}</div></div></div>`;
        }
        yukle();
    }

    function aktifFiltreSayisi() {
        return ['fFrozen', 'fGrup', 'fParti', 'fStok', 'fBirim'].filter(id => document.getElementById(id).value).length;
    }
    function filtreDugmesiniGuncelle() {
        const n = aktifFiltreSayisi();
        const varMi = n > 0 || document.getElementById('fSearch').value;
        const btn = document.getElementById('btnFiltreTemizle');
        btn.style.display = varMi ? '' : 'none';
        btn.innerHTML = `<i class="fas fa-filter-circle-xmark me-1"></i>Temizle${n > 0 ? ` <span class="badge bg-secondary">${n}</span>` : ''}`;
    }
    function filtreleriTemizle() {
        document.getElementById('fSearch').value = '';
        ['fFrozen', 'fGrup', 'fParti', 'fStok', 'fBirim'].forEach(id => document.getElementById(id).value = '');
        sayfa = 1;
        yukle();
    }

    async function yukle() {
        filtreDugmesiniGuncelle();
        const qs = new URLSearchParams({ search: document.getElementById('fSearch').value, frozenfor: document.getElementById('fFrozen').value, grup: document.getElementById('fGrup').value, parti: document.getElementById('fParti').value, stok: document.getElementById('fStok').value, birim: document.getElementById('fBirim').value, page: sayfa, pageSize });
        const res = await fetch('/UrasUretimUretim/GetKalemler?' + qs.toString()).then(r => r.json());
        if (!res.success) { alert(res.message); return; }
        const veri = res.data;
        toplamSayfa = Math.max(1, Math.ceil(veri.toplam / pageSize));
        document.getElementById('tbodyKalemler').innerHTML = veri.liste.map(k => `
            <tr><td class="fw-bold text-primary">${k.ItemCode}</td><td>${k.ItemName}<div class="text-muted small">${k.ForeignName || ''}</div></td><td>${k.ItemGroupName}</td>
                <td class="text-center">${k.UomCode}</td><td class="text-center">${k.ManBtchNum === 'Y' ? '<span class="badge bg-info">Evet</span>' : 'Hayır'}</td>
                <td class="text-center">${k.Frozenfor === 'Y' ? '<span class="badge bg-secondary">Etkin Değil</span>' : '<span class="badge bg-success">Etkin</span>'}</td>
                <td class="text-end">${fmt(k.OnHand, 2)}</td>
                <td class="text-nowrap">
                    <button class="btn btn-sm btn-outline-primary" onclick='kalemFormAc(${JSON.stringify(k)})' title="Düzenle"><i class="fas fa-pen"></i></button>
                    <button class="btn btn-sm btn-outline-${k.Frozenfor === 'Y' ? 'success' : 'secondary'}" onclick="durumDegistir('${k.ItemCode}', ${k.Frozenfor === 'Y'})" title="${k.Frozenfor === 'Y' ? 'Etkinleştir' : 'Etkin değil yap'}"><i class="fas fa-power-off"></i></button>
                    <button class="btn btn-sm btn-outline-danger" onclick="kalemSil('${k.ItemCode}')" title="Sil"><i class="fas fa-trash"></i></button>
                </td></tr>`).join('') || '<tr><td colspan="8" class="text-center text-muted py-4">Kayıt yok.</td></tr>';
        document.getElementById('sayfaBilgi').textContent = `Toplam ${veri.toplam} kalem • Sayfa ${sayfa}/${toplamSayfa}`;
        document.getElementById('btnOnceki').disabled = sayfa <= 1;
        document.getElementById('btnSonraki').disabled = sayfa >= toplamSayfa;
    }
    function sayfaDegis(d) { sayfa += d; yukle(); }

    function kalemFormAc(k) {
        document.getElementById('kalemModalBaslik').textContent = k ? 'Kalem Güncelle' : 'Yeni Kalem';
        document.getElementById('kItemCode').value = k ? k.ItemCode : '';
        document.getElementById('kItemCode').disabled = !!k;
        document.getElementById('kItemName').value = k ? k.ItemName : '';
        document.getElementById('kForeignName').value = k ? (k.ForeignName || '') : '';
        document.getElementById('kGrup').value = k ? k.ItmsGrpCod : (gruplar[0]?.ItmsGrpCod || '');
        document.getElementById('kUom').value = k ? k.UomCode : (uomListe[0]?.UomCode || '');
        document.getElementById('kSecondUom').value = k ? (k.SecondUomCode || '') : '';
        document.getElementById('kManBtchNum').checked = k ? k.ManBtchNum === 'Y' : false;
        document.getElementById('kFrozen').checked = k ? k.Frozenfor === 'Y' : false;
        new bootstrap.Modal('#kalemModal').show();
    }

    async function kalemKaydet() {
        const yeni = !document.getElementById('kItemCode').disabled;
        const body = {
            itemCode: document.getElementById('kItemCode').value, itemName: document.getElementById('kItemName').value, foreignName: document.getElementById('kForeignName').value,
            itmsGrpCod: Number(document.getElementById('kGrup').value), uomCode: document.getElementById('kUom').value, secondUomCode: document.getElementById('kSecondUom').value,
            manBtchNum: document.getElementById('kManBtchNum').checked ? 'Y' : 'N', frozenfor: document.getElementById('kFrozen').checked ? 'Y' : 'N'
        };
        if (!body.itemCode || !body.itemName) { alert('Kalem kodu ve adı zorunludur.'); return; }
        const res = await fetch('/UrasUretimUretim/' + (yeni ? 'AddKalem' : 'UpdateKalem'), { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        alert(res.message);
        if (res.success) { bootstrap.Modal.getInstance(document.getElementById('kalemModal')).hide(); yukle(); }
    }

    async function durumDegistir(itemCode, etkinYap) {
        const res = await fetch(`/UrasUretimUretim/UpdateKalemDurum?itemCode=${encodeURIComponent(itemCode)}&etkin=${etkinYap}`, { method: 'POST' }).then(r => r.json());
        alert(res.message);
        if (res.success) yukle();
    }

    async function kalemSil(itemCode) {
        if (!confirm(`${itemCode} silinsin mi? Bu işlem geri alınamaz.`)) return;
        const res = await fetch(`/UrasUretimUretim/DeleteKalem?itemCode=${encodeURIComponent(itemCode)}`, { method: 'POST' }).then(r => r.json());
        alert(res.message);
        if (res.success) yukle();
    }

    ilkYukle();
</script>
