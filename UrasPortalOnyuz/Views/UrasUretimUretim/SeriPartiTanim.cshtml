@{
    ViewData["Title"] = "Seri/Parti Tanımları";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0 text-gray-800 fw-bold"><i class="fas fa-barcode me-2 text-primary"></i> Seri/Parti Tanımları</h2>
</div>
<p class="text-muted mb-3">Lot/parti numara biçimi, sayaç yönetimi ve düzeltme geçmişi.</p>

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link active" href="javascript:void(0)" id="tabBicim" onclick="sekmeSec('bicim')">Numara Biçimi</a></li>
    <li class="nav-item"><a class="nav-link" href="javascript:void(0)" id="tabSayac" onclick="sekmeSec('sayac')">Lot Sayaçları</a></li>
    <li class="nav-item"><a class="nav-link" href="javascript:void(0)" id="tabLog" onclick="sekmeSec('log')">Düzeltme Geçmişi</a></li>
</ul>

<div id="panelBicim">
    <div class="card dash-card">
        <div class="card-body">
            <p class="text-muted small"><i class="fas fa-circle-info me-1"></i>Parti (P) ve Seri (S) numaralarının önek/orta kısım/basamak sayısı ve devir limiti burada tanımlanır.</p>
            <div class="table-responsive">
                <table class="table table-hover table-custom mb-0">
                    <thead><tr><th>Tip</th><th>Önek</th><th>Orta Kısım Kaynağı</th><th>Değer</th><th class="text-end">Basamak</th><th class="text-end">Devir Limiti</th><th class="text-center">Aktif</th><th></th></tr></thead>
                    <tbody id="tbodyBicim"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="panelSayac" style="display:none;">
    <div class="card dash-card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-4"><label class="form-label small fw-bold">Kalem Kodu</label><input type="text" class="form-control form-control-sm" id="sayacKalemAra" placeholder="örn. YM02.A1"></div>
                <div class="col-6 col-md-3"><label class="form-label small fw-bold">Yeni değer (sıfırla=0)</label><input type="number" class="form-control form-control-sm" id="sayacYeniNo"></div>
                <div class="col-12 col-md-5"><label class="form-label small fw-bold">Açıklama (zorunlu)</label><input type="text" class="form-control form-control-sm" id="sayacAciklama" maxlength="200"></div>
            </div>
            <div class="d-flex gap-2 mt-2">
                <button class="btn btn-warning btn-sm" onclick="sayacSifirla()"><i class="fas fa-rotate-left me-1"></i>Sıfırla</button>
                <button class="btn btn-primary btn-sm" onclick="sayacDuzelt()"><i class="fas fa-sliders me-1"></i>Belirtilen Değere Ayarla</button>
            </div>
        </div>
    </div>
    <div class="card dash-card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-custom mb-0">
                    <thead><tr><th>Kalem</th><th class="text-end">Sayaç (Son No)</th><th>Son Lot</th><th>SAP'taki Son Verilen Lot</th><th>Son Sıfırlama</th><th>Kullanıcı</th></tr></thead>
                    <tbody id="tbodySayaclar"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="panelLog" style="display:none;">
    <div class="card dash-card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-custom mb-0">
                    <thead><tr><th>Kod</th><th>Kalem</th><th class="text-end">Önceki Sayaç</th><th>Kullanıcı</th><th>Tarih</th><th>Açıklama</th></tr></thead>
                    <tbody id="tbodyLog"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- İş Emri Lot Düzeltme -->
<div class="card dash-card mt-3">
    <div class="card-body">
        <div class="fw-bold mb-2"><i class="fas fa-screwdriver-wrench me-1"></i>İş Emri Lot Düzeltme</div>
        <p class="text-muted small">Bir iş emrinin kazandığı lot numarasını elle düzeltir (hatalı okutma vb.). Stok partisi zaten oluşmuş lotlar değiştirilemez.</p>
        <div class="row g-2">
            <div class="col-6 col-md-2"><label class="form-label small fw-bold">İş Emri No (DocEntry)</label><input type="number" class="form-control form-control-sm" id="owDocEntry"></div>
            <div class="col-6 col-md-3"><label class="form-label small fw-bold">Yeni Lot</label><input type="text" class="form-control form-control-sm" id="owYeniLot" maxlength="30"></div>
            <div class="col-12 col-md-5"><label class="form-label small fw-bold">Açıklama (zorunlu)</label><input type="text" class="form-control form-control-sm" id="owAciklama" maxlength="150"></div>
            <div class="col-12 col-md-2 d-grid"><button class="btn btn-danger btn-sm" onclick="oworLotDuzelt()">Düzelt</button></div>
        </div>
    </div>
</div>

<!-- Biçim düzenleme modalı -->
<div class="modal fade" id="bicimModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Numara Biçimi Düzenle</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="bDocEntry">
                <div class="row g-2">
                    <div class="col-6"><label class="form-label small fw-bold">Tip</label><select class="form-select" id="bSpType"><option value="P">Parti</option><option value="S">Seri</option></select></div>
                    <div class="col-6"><label class="form-label small fw-bold">Aktif</label><select class="form-select" id="bActive"><option value="Y">Evet</option><option value="N">Hayır</option></select></div>
                    <div class="col-6"><label class="form-label small fw-bold">Önek</label><input type="text" class="form-control" id="bPrefix" maxlength="10"></div>
                    <div class="col-6"><label class="form-label small fw-bold">Orta Kısım Kaynağı (SelType)</label><input type="text" class="form-control" id="bSelType" maxlength="20"></div>
                    <div class="col-12"><label class="form-label small fw-bold">Değer</label><input type="text" class="form-control" id="bValue" maxlength="50"></div>
                    <div class="col-6"><label class="form-label small fw-bold">Basamak Sayısı (1-6)</label><input type="number" min="1" max="6" class="form-control" id="bDigit"></div>
                    <div class="col-6"><label class="form-label small fw-bold">Devir Limiti</label><input type="number" min="1" class="form-control" id="bMaxNo"></div>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-primary" onclick="bicimKaydet()">Kaydet</button></div>
        </div>
    </div>
</div>

<style>
    .dash-card { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
    .table-custom th { background-color: #f8f9fc; text-transform: uppercase; font-size: 11px; color: #858796; border-bottom: 2px solid #e3e6f0; }
    .table-custom td { vertical-align: middle; font-size: 13px; color: #5a5c69; }
</style>

<script>
    let bicimler = [], sayaclar = [];
    function fmt(n) { return (Number(n) || 0).toLocaleString('tr-TR'); }

    function sekmeSec(s) {
        ['Bicim', 'Sayac', 'Log'].forEach(x => document.getElementById('tab' + x).classList.toggle('active', x.toLowerCase() === s));
        document.getElementById('panelBicim').style.display = s === 'bicim' ? '' : 'none';
        document.getElementById('panelSayac').style.display = s === 'sayac' ? '' : 'none';
        document.getElementById('panelLog').style.display = s === 'log' ? '' : 'none';
        if (s === 'log') logYukle();
    }

    async function bicimYukle() {
        const res = await fetch('/UrasUretimUretim/GetSeriPartiTanimlar').then(r => r.json());
        if (!res.success) { alert(res.message); return; }
        bicimler = res.data;
        document.getElementById('tbodyBicim').innerHTML = bicimler.map(b => `
            <tr><td><span class="badge ${b.SpType === 'P' ? 'bg-primary' : 'bg-info'}">${b.SpType === 'P' ? 'Parti' : 'Seri'}</span></td>
                <td class="font-monospace">${b.Prefix}</td><td>${b.SelType}</td><td>${b.Value}</td>
                <td class="text-end">${b.Digit}</td><td class="text-end">${fmt(b.MaxNo)}</td>
                <td class="text-center">${b.Active === 'Y' ? '<span class="badge bg-success">Evet</span>' : '<span class="badge bg-secondary">Hayır</span>'}</td>
                <td><button class="btn btn-sm btn-outline-primary" onclick='bicimAc(${JSON.stringify(b)})'><i class="fas fa-pen"></i></button></td></tr>`).join('') || '<tr><td colspan="8" class="text-center text-muted py-3">Tanım yok.</td></tr>';
    }

    function bicimAc(b) {
        document.getElementById('bDocEntry').value = b.DocEntry;
        document.getElementById('bSpType').value = b.SpType;
        document.getElementById('bActive').value = b.Active;
        document.getElementById('bPrefix').value = b.Prefix;
        document.getElementById('bSelType').value = b.SelType;
        document.getElementById('bValue').value = b.Value;
        document.getElementById('bDigit').value = b.Digit;
        document.getElementById('bMaxNo').value = b.MaxNo;
        new bootstrap.Modal('#bicimModal').show();
    }

    async function bicimKaydet() {
        const body = {
            docEntry: Number(document.getElementById('bDocEntry').value), spType: document.getElementById('bSpType').value, active: document.getElementById('bActive').value,
            prefix: document.getElementById('bPrefix').value, selType: document.getElementById('bSelType').value, value: document.getElementById('bValue').value,
            digit: Number(document.getElementById('bDigit').value), maxNo: Number(document.getElementById('bMaxNo').value)
        };
        const res = await fetch('/UrasUretimUretim/UpdateSeriPartiTanim', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        alert(res.message);
        if (res.success) { bootstrap.Modal.getInstance(document.getElementById('bicimModal')).hide(); bicimYukle(); }
    }

    async function sayacYukle() {
        const res = await fetch('/UrasUretimUretim/GetLotSayaclar').then(r => r.json());
        if (!res.success) return;
        sayaclar = res.data;
        document.getElementById('tbodySayaclar').innerHTML = sayaclar.map(s => `
            <tr><td class="fw-bold">${s.ItemName || s.ItemCode}<div class="text-muted small">${s.ItemCode}</div></td>
                <td class="text-end">${s.SonNo !== null ? s.SonNo : '<span class="text-muted">kayıt yok</span>'}</td>
                <td class="font-monospace">${s.SonLot || '—'}</td><td class="font-monospace">${s.OworSonLot || '—'}</td>
                <td>${s.SonResetTarih || '—'}</td><td>${s.SonResetUser || ''}</td></tr>`).join('') || '<tr><td colspan="6" class="text-center text-muted py-3">Kayıt yok.</td></tr>';
    }

    async function sayacSifirla() {
        const itemCode = document.getElementById('sayacKalemAra').value.trim();
        const aciklama = document.getElementById('sayacAciklama').value.trim();
        if (!itemCode || !aciklama) { alert('Kalem kodu ve açıklama zorunludur.'); return; }
        if (!confirm(`${itemCode} lot sayacı sıfırlansın mı?`)) return;
        const res = await fetch('/UrasUretimUretim/ResetLotSayac', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ itemCode, aciklama }) }).then(r => r.json());
        alert(res.message);
        if (res.success) { sayacYukle(); logYukle(); }
    }

    async function sayacDuzelt() {
        const itemCode = document.getElementById('sayacKalemAra').value.trim();
        const yeniNo = document.getElementById('sayacYeniNo').value;
        const aciklama = document.getElementById('sayacAciklama').value.trim();
        if (!itemCode || yeniNo === '' || !aciklama) { alert('Kalem kodu, yeni değer ve açıklama zorunludur.'); return; }
        const res = await fetch('/UrasUretimUretim/SetLotSayac', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ itemCode, yeniNo: Number(yeniNo), aciklama }) }).then(r => r.json());
        alert(res.message);
        if (res.success) { sayacYukle(); logYukle(); }
    }

    async function logYukle() {
        const res = await fetch('/UrasUretimUretim/GetLotResetLog').then(r => r.json());
        if (!res.success) return;
        document.getElementById('tbodyLog').innerHTML = res.data.map(l => `
            <tr><td>#${l.Code}</td><td class="font-monospace">${l.ItemCode}</td><td class="text-end">${l.EskiNo}</td><td>${l.Kullanici}</td><td>${l.Tarih}</td><td class="small">${l.Aciklama}</td></tr>`).join('') || '<tr><td colspan="6" class="text-center text-muted py-3">Kayıt yok.</td></tr>';
    }

    async function oworLotDuzelt() {
        const docEntry = Number(document.getElementById('owDocEntry').value);
        const yeniLot = document.getElementById('owYeniLot').value.trim();
        const aciklama = document.getElementById('owAciklama').value.trim();
        if (!docEntry || !yeniLot || !aciklama) { alert('İş emri no, yeni lot ve açıklama zorunludur.'); return; }
        if (!confirm(`İş emri #${docEntry} lotu '${yeniLot}' olarak değiştirilsin mi?`)) return;
        const res = await fetch('/UrasUretimUretim/SetOworLotNo', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ docEntry, yeniLot, aciklama }) }).then(r => r.json());
        alert(res.message);
        if (res.success) logYukle();
    }

    bicimYukle();
    sayacYukle();
</script>
