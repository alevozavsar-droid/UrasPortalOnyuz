@{
    ViewData["Title"] = "Numune";
}

<style>
    .uras-card { background: #fff; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.03); margin-bottom: 24px; }
    .uras-card-header { padding: 16px 20px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .uras-card-header h5, .uras-card-header h6 { margin: 0; font-weight: 700; display: flex; align-items: center; gap: 10px; }
    .uras-card-body { padding: 20px; }
    .search-box { position: relative; width: 100%; }
    .search-box input { border-radius: 20px; padding-left: 36px; background: #f1f5f9; border: none; }
    .search-box i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #64748b; }
    .empty-state { text-align: center; padding: 32px 20px; color: #94a3b8; }
    .empty-state i { font-size: 2.2rem; margin-bottom: 10px; color: #cbd5e1; display: block; }
    .siparis-item { cursor: pointer; padding: 10px 14px; border-bottom: 1px solid #e2e8f0; }
    .siparis-item:hover { background: #eff6ff; }
    .siparis-item:last-child { border-bottom: none; }
    .siparis-liste { border: 1px solid #e2e8f0; border-radius: 12px; max-height: 280px; overflow-y: auto; }
    .uras-label { font-weight: 600; font-size: .85rem; color: #475569; margin-bottom: 8px; display: flex; align-items: center; gap: 8px; }
    .step-num { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; background: #3b82f6; color: #fff; font-size: .72rem; font-weight: 700; flex-shrink: 0; }
    .secili-box { background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .kaynak-toggle { display: flex; gap: 8px; background: #f1f5f9; border-radius: 12px; padding: 4px; }
    .kaynak-btn { flex: 1; border: none; background: transparent; border-radius: 9px; padding: 10px 12px; font-size: .85rem; font-weight: 600; color: #64748b; }
    .kaynak-btn.active { background: #fff; color: #3b82f6; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
    .badge-demontaj { background: #fef3c7; color: #92400e; }
    .select-btn { width: 100%; text-align: left; border: 1.5px dashed #cbd5e1; border-radius: 12px; padding: .65rem 1rem; background: #fafafa; }
    .select-btn:hover { border-color: #3b82f6; }
    .table-custom th { background-color: #f8f9fc; text-transform: uppercase; font-size: 11px; color: #858796; border-bottom: 2px solid #e3e6f0; }
    .table-custom td { vertical-align: middle; font-size: 13px; }
</style>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h2 class="h4 mb-0 text-gray-800 fw-bold"><i class="fas fa-vial me-2 text-primary"></i> Numune</h2>
</div>

<!-- Numune kalemi seçim modalı -->
<div class="modal fade" id="numuneKalemModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title"><i class="fas fa-eyedropper text-primary me-2"></i>Numune Kalemini Seçin</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="text" class="form-control form-control-sm mb-2" id="kalemAramaKutusu" placeholder="Kalem kodu veya adı..." oninput="kalemAramaCiz()">
                <div class="table-responsive" style="max-height:400px;">
                    <table class="table table-sm table-hover mb-0">
                        <thead><tr><th>Kod</th><th>Ad</th></tr></thead>
                        <tbody id="tbodyKalemSonuc"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Onay modalı -->
<div class="modal fade" id="onayModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0" style="border-radius:16px;">
            <div class="modal-header bg-light border-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-shield-check text-primary me-2"></i>Numune Onayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="p-3 rounded-3 mb-3 bg-light border"><table class="table table-sm table-borderless mb-0" id="onayTablo"></table></div>
                <div class="alert alert-info border-0 d-flex gap-2 align-items-start mb-0" id="onayNotu" style="font-size:.85rem;"></div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" id="btnOnayla" onclick="onaylaVeGonder()">
                    <span id="onaylaMetin"><i class="fas fa-check-double me-1"></i>Onayla</span>
                    <span id="onaylaYukleniyor" style="display:none"><span class="spinner-border spinner-border-sm me-1"></span>İşleniyor...</span>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-5 col-lg-6 mb-4 mb-lg-0">
        <div class="uras-card">
            <div class="uras-card-header"><h5><i class="fas fa-vial"></i> Numune Alma</h5></div>
            <div class="uras-card-body">

                <label class="uras-label"><span class="step-num">1</span> Numune Kaynağı</label>
                <div class="kaynak-toggle mb-3" id="kaynakToggle">
                    <button type="button" class="kaynak-btn active" onclick="setKaynakTip('SIPARIS')" id="btnKaynakSiparis"><i class="fas fa-clipboard-check me-1"></i>Kapalı Üretim Siparişi</button>
                    <button type="button" class="kaynak-btn" onclick="setKaynakTip('YM')" id="btnKaynakYm"><i class="fas fa-flask me-1"></i>Stoktaki Yarı Mamul Lotu</button>
                </div>

                <div id="blokSiparisListe">
                    <div class="search-box mb-2"><i class="fas fa-search"></i><input type="text" class="form-control" id="fSiparis" placeholder="Sipariş no, ürün kodu veya adı ile arayın..." oninput="siparisListesiCiz()"></div>
                    <div class="siparis-liste" id="siparisListe"></div>
                </div>

                <div id="blokYmListe" style="display:none">
                    <div class="search-box mb-2"><i class="fas fa-search"></i><input type="text" class="form-control" id="fYm" placeholder="Kalem kodu, adı, depo veya lot ile arayın..." oninput="ymListesiCiz()"></div>
                    <div class="siparis-liste" id="ymListe"></div>
                </div>

                <div id="seciliSiparisBox" class="secili-box mb-3" style="display:none">
                    <div>
                        <div><span class="fw-bold text-primary" id="ssDocEntry"></span> <span class="ms-2 font-monospace fw-bold" id="ssItemCode" style="font-size:.85rem"></span></div>
                        <div class="text-muted" style="font-size:.8rem" id="ssItemName"></div>
                        <div class="mt-1" style="font-size:.8rem" id="ssBadges"></div>
                    </div>
                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="secimiTemizle()"><i class="fas fa-right-left me-1"></i>Değiştir</button>
                </div>

                <div id="seciliYmBox" class="secili-box mb-3" style="display:none">
                    <div>
                        <div><span class="fw-bold font-monospace text-primary" id="ymItemCode" style="font-size:.85rem"></span></div>
                        <div class="text-muted" style="font-size:.8rem" id="ymItemName"></div>
                        <div class="mt-1" style="font-size:.8rem" id="ymBadges"></div>
                    </div>
                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="secimiTemizle()"><i class="fas fa-right-left me-1"></i>Değiştir</button>
                </div>

                <div id="blokDevam" style="display:none">
                    <label class="uras-label"><span class="step-num">2</span> Numune Kalemi</label>
                    <button type="button" class="select-btn mb-3" data-bs-toggle="modal" data-bs-target="#numuneKalemModal" onclick="kalemModalAcildi()">
                        <span id="numuneKalemBos" class="text-muted"><i class="fas fa-circle-plus me-1"></i> Numune kalemini seçin...</span>
                        <span id="numuneKalemDolu" style="display:none"><span class="text-primary font-monospace" id="nkKod"></span> - <span id="nkAd"></span></span>
                    </button>

                    <label class="uras-label"><span class="step-num">3</span> Numune Miktarı (<span id="birimEtiket"></span>)</label>
                    <div class="row g-2 align-items-center mb-3">
                        <div class="col"><input type="number" min="0.01" step="0.01" class="form-control fw-bold" id="numuneMiktar" oninput="miktarDegisti()"></div>
                        <div class="col-auto" id="tamamiWrap">
                            <button class="btn btn-outline-secondary" onclick="tamaminiSec()" title="Kalan stoğun tamamı"><i class="fas fa-rotate-left"></i> Tamamı</button>
                        </div>
                    </div>

                    <div class="alert alert-info border-0 d-flex gap-2 align-items-center mb-3" id="bilgiKutusu" style="font-size:.82rem;"></div>

                    <button class="btn btn-primary w-100 py-3" onclick="numuneAlBaslat()"><i class="fas fa-vial me-2"></i>Numune Al</button>
                </div>

            </div>
        </div>
    </div>

    <div class="col-xl-7 col-lg-6">
        <div class="uras-card">
            <div class="uras-card-header">
                <h6><i class="fas fa-clock-rotate-left"></i> Numune Geçmişi <span class="badge bg-light text-secondary border ms-2" id="gecmisSayisi" style="display:none"></span></h6>
                <div class="search-box" style="width:240px"><i class="fas fa-search"></i><input type="text" class="form-control" id="fGecmis" placeholder="Belge no, ürün veya depo ara..." oninput="gecmisCiz()"></div>
            </div>
            <div class="uras-card-body p-0">
                <div class="table-responsive" style="max-height:calc(100vh - 210px); overflow-y:auto;">
                    <table class="table table-custom mb-0">
                        <thead class="sticky-top" style="z-index:1"><tr><th>#</th><th>Kalem</th><th class="text-end">Miktar</th><th>Depo</th><th>Tarih</th><th>Durum</th><th>Operatör</th></tr></thead>
                        <tbody id="gecmisGovde"></tbody>
                    </table>
                    <div id="gecmisBos" class="empty-state" style="display:none"><i class="fas fa-inbox"></i>Henüz numune kaydı yok.</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let kaynakTip = 'SIPARIS';
    let kapaliSiparisler = [], ymList = [], oittKalemleri = [];
    let selectedSiparis = null, selectedYm = null, numuneKalem = null;
    let numuneList = [];

    function fmt(n, d) { return (Number(n) || 0).toLocaleString('tr-TR', { minimumFractionDigits: d, maximumFractionDigits: d }); }

    // Kaynaktaki $scope.maxMiktar: yalnızca SIPARIS akışında üst sınır uygulanır (PlannedQty, KalanMiktar biliniyorsa ve küçükse o).
    // YM akışında üst sınır yok — stok/reçete yeterliliği backend'de doğrulanır (kaynakta da öyle).
    function maxMiktar() {
        if (kaynakTip !== 'SIPARIS' || !selectedSiparis) return null;
        let max = Number(selectedSiparis.PlannedQty);
        if (selectedSiparis.KalanMiktar != null && Number(selectedSiparis.KalanMiktar) < max) max = Number(selectedSiparis.KalanMiktar);
        return max;
    }
    function kaynakBirim() {
        return (kaynakTip === 'YM' ? (selectedYm && selectedYm.Birim) : (selectedSiparis && selectedSiparis.Birim)) || 'KG';
    }
    function numuneBirim() {
        if (numuneKalem && numuneKalem.InvntryUom) return numuneKalem.InvntryUom;
        return kaynakBirim();
    }

    function setKaynakTip(t) {
        kaynakTip = t;
        document.getElementById('btnKaynakSiparis').classList.toggle('active', t === 'SIPARIS');
        document.getElementById('btnKaynakYm').classList.toggle('active', t === 'YM');
        document.getElementById('tamamiWrap').style.display = t === 'SIPARIS' ? '' : 'none';
        if (t === 'YM' && !ymList.length) ymVerileriniYukle();
        secimiTemizle();
    }

    function gorunumuGuncelle() {
        const secimVar = !!(selectedSiparis || selectedYm);
        document.getElementById('kaynakToggle').style.display = secimVar ? 'none' : '';
        document.getElementById('blokSiparisListe').style.display = (kaynakTip === 'SIPARIS' && !selectedSiparis) ? '' : 'none';
        document.getElementById('blokYmListe').style.display = (kaynakTip === 'YM' && !selectedYm) ? '' : 'none';
        document.getElementById('seciliSiparisBox').style.display = (kaynakTip === 'SIPARIS' && selectedSiparis) ? '' : 'none';
        document.getElementById('seciliYmBox').style.display = (kaynakTip === 'YM' && selectedYm) ? '' : 'none';
        document.getElementById('blokDevam').style.display = secimVar ? '' : 'none';
        document.getElementById('birimEtiket').textContent = numuneBirim();
        bilgiKutusunuGuncelle();
    }

    function bilgiKutusunuGuncelle() {
        const el = document.getElementById('bilgiKutusu');
        el.innerHTML = kaynakTip === 'SIPARIS'
            ? '<i class="fas fa-circle-info"></i> Kaynak mamülden demontaj yapılarak numune ayrılır; kaynak kalem stoktan düşer.'
            : '<i class="fas fa-circle-info"></i> Demontaj yapılmaz: numune kaleminin kendi reçetesi kullanılır, bu lottan öncelikli olarak tüketim yapılır.';
    }

    function secimiTemizle() {
        selectedSiparis = null; selectedYm = null; numuneKalem = null;
        document.getElementById('numuneMiktar').value = '';
        document.getElementById('numuneKalemBos').style.display = '';
        document.getElementById('numuneKalemDolu').style.display = 'none';
        gorunumuGuncelle();
    }

    // ---- Sipariş kaynağı ----
    async function siparisleriYukle() {
        // Kaynaktaki $scope.GetKapaliSiparisler ile birebir: girisFisliDahil=true (henüz kapanmamış ama giriş fişi kesilmiş siparişler de listelenir).
        const res = await fetch('/UrasUretimUretim/GetKapaliUretimSiparisleri?girisFisliDahil=true').then(r => r.json());
        if (res.success) { kapaliSiparisler = res.data || []; siparisListesiCiz(); }
    }
    function siparisListesiCiz() {
        const q = (document.getElementById('fSiparis').value || '').toLowerCase();
        const list = kapaliSiparisler.filter(s => !q || String(s.DocEntry).includes(q) || (s.ItemCode || '').toLowerCase().includes(q) || (s.ItemName || '').toLowerCase().includes(q));
        const el = document.getElementById('siparisListe');
        if (!list.length) { el.innerHTML = '<div class="empty-state"><i class="fas fa-inbox"></i>Numune alınabilecek kapalı üretim siparişi yok.</div>'; return; }
        el.innerHTML = list.map((it, i) => `
            <div class="siparis-item" onclick="siparisSec(${i})">
                <div class="d-flex justify-content-between align-items-center">
                    <div><span class="fw-bold text-primary">#${it.DocEntry}</span> <span class="ms-2 font-monospace" style="font-size:.85rem">${it.ItemCode}</span></div>
                    <span>
                        <span class="badge bg-light text-dark border">${fmt(it.PlannedQty, 2)} ${it.Birim || ''}</span>
                        ${it.KalanMiktar != null ? `<span class="badge bg-light text-success border">Kalan: ${fmt(it.KalanMiktar, 2)}</span>` : ''}
                    </span>
                </div>
                <div class="d-flex justify-content-between mt-1" style="font-size:.8rem">
                    <span class="text-muted">${it.ItemName || ''}</span>
                    <span class="text-muted">${it.U_BE1_KAZANLOTNO ? `<span class="text-primary fw-bold me-2">Lot: ${it.U_BE1_KAZANLOTNO}</span>` : ''}${(it.PostDate || '').substring(0, 10)}</span>
                </div>
            </div>`).join('');
        el._list = list;
    }
    function siparisSec(i) {
        selectedSiparis = document.getElementById('siparisListe')._list[i];
        gorunumuGuncelle();
        document.getElementById('ssDocEntry').textContent = '#' + selectedSiparis.DocEntry;
        document.getElementById('ssItemCode').textContent = selectedSiparis.ItemCode;
        document.getElementById('ssItemName').textContent = selectedSiparis.ItemName || '';
        document.getElementById('ssBadges').innerHTML =
            `<span class="badge bg-white text-dark border me-1">${fmt(selectedSiparis.PlannedQty, 2)} ${selectedSiparis.Birim || ''}</span>` +
            (selectedSiparis.KalanMiktar != null ? `<span class="badge bg-white text-success border me-1">Kalan: ${fmt(selectedSiparis.KalanMiktar, 2)}</span>` : '') +
            (selectedSiparis.U_BE1_KAZANLOTNO ? `<span class="badge bg-white text-primary border me-1">Lot: ${selectedSiparis.U_BE1_KAZANLOTNO}</span>` : '');
        const max = maxMiktar();
        document.getElementById('numuneMiktar').setAttribute('max', max);
        document.getElementById('numuneMiktar').setAttribute('placeholder', 'En fazla ' + fmt(max, 2) + ' ' + (selectedSiparis.Birim || ''));
        gorunumuGuncelle();
    }

    // ---- Yarı mamul lot kaynağı ----
    async function ymVerileriniYukle() {
        const res = await fetch('/UrasUretimUretim/GetYariMamulLotlari').then(r => r.json());
        ymList = res.success ? (res.data || []) : [];
        ymListesiCiz();
    }
    function ymListesiCiz() {
        const q = (document.getElementById('fYm').value || '').toLowerCase();
        const list = ymList.filter(s => !q || (s.ItemCode || '').toLowerCase().includes(q) || (s.ItemName || '').toLowerCase().includes(q) || (s.WhsCode || '').toLowerCase().includes(q) || (s.BatchNum || '').toLowerCase().includes(q));
        const el = document.getElementById('ymListe');
        if (!list.length) { el.innerHTML = '<div class="empty-state"><i class="fas fa-inbox"></i>Numune alınabilecek yarı mamul lotu yok.</div>'; return; }
        el.innerHTML = list.map((it, i) => `
            <div class="siparis-item" onclick="ymSec(${i})">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold font-monospace text-primary" style="font-size:.85rem">${it.ItemCode}</span>
                        <span class="text-primary fw-bold ms-2" style="font-size:.85rem">Lot: ${it.BatchNum}</span>
                        <span class="badge bg-light text-dark border ms-2"><i class="fas fa-building"></i> ${it.WhsCode}</span>
                        ${it.Ayristirilmis === 'Y' ? '<span class="badge badge-demontaj ms-2">Ayrıştırılmış</span>' : ''}
                    </div>
                    <span class="badge bg-light text-success border">${fmt(it.Quantity, 2)} ${it.Birim || ''}</span>
                </div>
                <div class="text-muted mt-1" style="font-size:.8rem">${it.ItemName || ''}</div>
            </div>`).join('');
        el._list = list;
    }
    function ymSec(i) {
        selectedYm = document.getElementById('ymListe')._list[i];
        gorunumuGuncelle();
        document.getElementById('ymItemCode').textContent = selectedYm.ItemCode;
        document.getElementById('ymItemName').textContent = selectedYm.ItemName || '';
        document.getElementById('ymBadges').innerHTML =
            `<span class="badge bg-white text-primary border me-1">Lot: ${selectedYm.BatchNum}</span>` +
            `<span class="badge bg-white text-success border me-1">Kalan: ${fmt(selectedYm.Quantity, 2)} ${selectedYm.Birim || ''}</span>` +
            `<span class="badge bg-white text-dark border"><i class="fas fa-building me-1"></i>${selectedYm.WhsCode}</span>` +
            (selectedYm.Ayristirilmis === 'Y' ? '<span class="badge badge-demontaj ms-1">Ayrıştırılmış</span>' : '');
        document.getElementById('numuneMiktar').removeAttribute('max');
        document.getElementById('numuneMiktar').setAttribute('placeholder', 'Numune miktarı');
        gorunumuGuncelle();
    }

    function tamaminiSec() { const max = maxMiktar(); if (max != null) { document.getElementById('numuneMiktar').value = max; miktarDegisti(); } }
    function miktarDegisti() { /* şimdilik ek bir hesap gerekmiyor; ileride oran gösterimi eklenebilir */ }

    // ---- Numune kalemi seçimi (kaynaktaki OITTList — reçetesi olan YM/UR/HA kalemler) ----
    async function kalemModalAcildi() {
        if (!oittKalemleri.length) {
            const res = await fetch('/UrasUretimUretim/GetOITT').then(r => r.json());
            oittKalemleri = res.success ? (res.data || []) : [];
        }
        document.getElementById('kalemAramaKutusu').value = '';
        kalemAramaCiz();
    }
    function kalemAramaCiz() {
        const q = (document.getElementById('kalemAramaKutusu').value || '').toLowerCase();
        const list = oittKalemleri.filter(k => !q || (k.Code || '').toLowerCase().includes(q) || (k.Name || '').toLowerCase().includes(q));
        document.getElementById('tbodyKalemSonuc').innerHTML = list.map((k, i) => `
            <tr style="cursor:pointer" onclick="numuneKalemSec(${i})"><td class="fw-bold text-primary" style="width:150px">${k.Code}</td><td>${k.Name || ''}</td><td class="text-end"><i class="fas fa-chevron-right text-muted"></i></td></tr>`).join('');
        document.getElementById('tbodyKalemSonuc')._list = list;
    }
    function numuneKalemSec(i) {
        numuneKalem = document.getElementById('tbodyKalemSonuc')._list[i];
        document.getElementById('numuneKalemBos').style.display = 'none';
        document.getElementById('numuneKalemDolu').style.display = '';
        document.getElementById('nkKod').textContent = numuneKalem.Code;
        document.getElementById('nkAd').textContent = numuneKalem.Name || '';
        bootstrap.Modal.getInstance(document.getElementById('numuneKalemModal')).hide();
        gorunumuGuncelle();
    }

    // ---- Onay + gönderim ----
    function numuneAlBaslat() {
        const kaynakSecili = kaynakTip === 'SIPARIS' ? selectedSiparis : selectedYm;
        if (!kaynakSecili) { alert(kaynakTip === 'SIPARIS' ? 'Lütfen bir üretim siparişi seçin.' : 'Lütfen bir yarı mamul lotu seçin.'); return; }
        if (!numuneKalem) { alert('Lütfen numune kalemini seçin.'); return; }
        const kaynakKod = kaynakTip === 'SIPARIS' ? selectedSiparis.ItemCode : selectedYm.ItemCode;
        if (numuneKalem.Code === kaynakKod) { alert(kaynakTip === 'SIPARIS' ? 'Numune kalemi kaynak mamül ile aynı olamaz.' : 'Numune kalemi kaynak yarı mamul ile aynı olamaz.'); return; }
        const miktar = Number(document.getElementById('numuneMiktar').value) || 0;
        if (!miktar || miktar <= 0) { alert('Geçerli bir miktar girin.'); return; }
        const max = maxMiktar();
        if (max != null && miktar > max) { alert('Numune miktarı kalan stoktan (' + fmt(max, 2) + ' ' + kaynakBirim() + ') büyük olamaz.'); return; }

        const satirlar = [];
        if (kaynakTip === 'SIPARIS') {
            satirlar.push(['Sipariş No', '#' + selectedSiparis.DocEntry]);
            satirlar.push(['Kaynak Mamül', selectedSiparis.ItemCode]);
        } else {
            satirlar.push(['Kaynak Yarı Mamül', selectedYm.ItemCode]);
            satirlar.push(['Kaynak Lot', selectedYm.BatchNum]);
            satirlar.push(['Kaynak Depo', selectedYm.WhsCode]);
        }
        satirlar.push(['Numune Kalemi', numuneKalem.Code + ' - ' + (numuneKalem.Name || '')]);
        satirlar.push(['Numune Miktarı', fmt(miktar, 2) + ' ' + numuneBirim()]);
        document.getElementById('onayTablo').innerHTML = satirlar.map(s => `<tr><td class="text-muted fw-bold w-50">${s[0]}</td><td class="fw-bold">${s[1]}</td></tr>`).join('');
        document.getElementById('onayNotu').innerHTML = kaynakTip === 'SIPARIS'
            ? '<i class="fas fa-circle-info fs-6"></i><span>Kaynak mamülden demontaj yapılacak; kaynak kalem stoktan düşecektir.</span>'
            : '<i class="fas fa-circle-info fs-6"></i><span>Demontaj yapılmayacak; numune kalemi kendi reçetesi üzerinden üretilecek, bu lot öncelikli tüketilecektir.</span>';

        new bootstrap.Modal(document.getElementById('onayModal')).show();
    }

    async function onaylaVeGonder() {
        const miktar = Number(document.getElementById('numuneMiktar').value) || 0;
        document.getElementById('btnOnayla').disabled = true;
        document.getElementById('onaylaMetin').style.display = 'none';
        document.getElementById('onaylaYukleniyor').style.display = '';

        const body = kaynakTip === 'YM'
            ? { KaynakTip: 'YM', KaynakItemCode: selectedYm.ItemCode, KaynakLot: selectedYm.BatchNum, KaynakWhs: selectedYm.WhsCode, NumuneItemCode: numuneKalem.Code, NumuneQty: miktar }
            : { DocEntry: selectedSiparis.DocEntry, NumuneItemCode: numuneKalem.Code, NumuneQty: miktar };

        let res;
        try {
            res = await fetch('/UrasUretimUretim/AddNumune', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        } catch (e) {
            res = { success: false, message: 'Beklenmeyen hata: ' + e.message };
        }

        document.getElementById('btnOnayla').disabled = false;
        document.getElementById('onaylaMetin').style.display = '';
        document.getElementById('onaylaYukleniyor').style.display = 'none';
        bootstrap.Modal.getInstance(document.getElementById('onayModal')).hide();

        alert(res.message);
        if (res.success) {
            secimiTemizle();
            siparisleriYukle();
            if (ymList.length) ymVerileriniYukle();
            gecmisiYukle();
        }
    }

    // ---- Geçmiş ----
    async function gecmisiYukle() {
        const res = await fetch('/UrasUretimUretim/GetNumuneList').then(r => r.json());
        numuneList = res.success ? (res.data || []) : [];
        gecmisCiz();
    }
    function gecmisCiz() {
        const q = (document.getElementById('fGecmis').value || '').toLowerCase();
        const list = numuneList.filter(it => !q || String(it.DocEntry).includes(q) || (it.ItemCode || '').toLowerCase().includes(q) || (it.Warehouse || '').toLowerCase().includes(q));
        const sayiEl = document.getElementById('gecmisSayisi');
        sayiEl.style.display = numuneList.length ? '' : 'none';
        sayiEl.textContent = numuneList.length;
        document.getElementById('gecmisBos').style.display = list.length ? 'none' : '';
        document.getElementById('gecmisGovde').innerHTML = list.map(d => `
            <tr><td>#${d.DocEntry}</td><td>${d.ItemCode}<div class="text-muted small">${d.ProdName || ''}</div></td>
                <td class="text-end">${fmt(d.PlannedQty, 2)} ${d.Birim || ''}</td><td>${d.Warehouse || ''}</td><td>${(d.PostDate || '').substring(0, 10)}</td>
                <td>${d.Status === 'L' ? '<span class="badge bg-success">Kapalı</span>' : '<span class="badge bg-secondary">' + (d.Status || '') + '</span>'}</td>
                <td>${d.U_BE1_OPERATOR || ''}</td></tr>`).join('');
    }

    setKaynakTip('SIPARIS');
    siparisleriYukle();
    gecmisiYukle();
</script>
