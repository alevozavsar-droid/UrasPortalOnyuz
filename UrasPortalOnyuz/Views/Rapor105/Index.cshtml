                  </div>
                  <div class="col-12 mt-2">
                      <div class="preview-label">Açıklama</div>
                      <div class="preview-val" id="lblAciklama" style="font-size:0.8rem; font-weight:normal;">-</div>
                  </div>
              </div>
          </div>

          <!-- DÖVİZ KURU SEÇİM ALANI -->
          <div class="row mt-3 mb-4" id="divDovizKuruAlani" style="display:none; background: #f1f5f9; padding: 15px; border-radius: 8px; border: 1px dashed #94a3b8;">
              <div class="col-md-6 mb-3 mb-md-0">
                  <label class="form-label fw-bold text-muted small"><i class="fas fa-sync-alt me-1"></i> Döviz Kuru Kaynağı</label>
