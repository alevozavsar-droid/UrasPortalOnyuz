     function iptalEtSecilenleri() {
            let requests = [];
            $('.chk-hatali:checked').each(function() {
                requests.push({
                    // parseInt eklenerek string yerine int olarak gönderilmesi sağlandı
                    TransId: parseInt($(this).attr('data-transid'), 10),
                    BelgeNo: $(this).attr('data-belgeno').toString(),
                    BelgeTuru: $(this).attr('data-belgeturu').toString()
                });
            });

            if(requests.length === 0) {
                alert("Lütfen iptal edilecek en az bir belge seçiniz.");
                return;
            }

            if(confirm(requests.length + " adet belgeyi Service Layer üzerinden iptal etmek istediğinize emin misiniz? (Bu işlem geri alınamaz!)")) {
                sendCancelRequestToApi(requests, function() {
                    bootstrap.Modal.getInstance(document.getElementById('hataliVadeliModal')).hide();
                    location.reload(); 
                });
            }
        }

        function iptalEtSingle(transId, belgeNo, belgeTuru, elementId) {
            if(confirm("SAP Yevmiye/Belge No: " + belgeNo + " kalıcı olarak iptal edilecek. Emin misiniz?")) {
                let requests = [{
                    // parseInt eklenerek string yerine int olarak gönderilmesi sağlandı
                    TransId: parseInt(transId, 10),
                    BelgeNo: belgeNo.toString(),
                    BelgeTuru: belgeTuru.toString()
                }];
                
                sendCancelRequestToApi(requests, function() {
                    location.reload(); 
                });
            }
        }
       
        function sendCancelRequestToApi(requestsArray, successCallback) {
            fetch('/Rapor105/IptalEtSap', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify(requestsArray)
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    alert("İptal İşlemi Başarılı:\n\n" + data.message);
                    if(successCallback) successCallback();
                } else {
                    alert("İptal İşlemi Sırasında Hata:\n\n" + data.message);
                }
            })
            .catch(err => {
                alert("Sunucuya ulaşılamadı veya kritik bir hata oluştu.");
                console.error(err);
            });
        }

        // ==========================================
        // BUTON KONTROLÜ (ZORUNLU ALANLAR DOLDURULMADAN BUTON AKTİF OLMAZ)
        // ==========================================
        function formValidationCheck() {
            var belgeTuru = document.getElementById('selBelgeTuru').value;
            var isYevmiye = (belgeTuru === "30");
            var bankaHesabi = $('#selBankaHesabi').val();
            var btnGonder = document.getElementById('btnAktarOnayla');

            let isValid = false;

            if (!bankaHesabi) {
                isValid = false;
            } else {
                if (isYevmiye) {
                    let isKkeg = document.getElementById('chkKkeg').checked;
                    if (isKkeg) {
                        isValid = true; 
                    } else {
                        isValid = (yevmiyeSatirlariArray.length > 0);
                    }
                } else {
                    let cariKodu = $('#inpCariKodu').val();
                    isValid = (cariKodu && cariKodu.trim() !== "");
                }
            }

            btnGonder.disabled = !isValid;
        }

        // ==========================================
        // EKRAN VE GÖRÜNÜM KONTROLLERİ
