@model List<WebApplication3.Controllers.BankaHareketiViewModel>
@using System.Globalization

@{
    ViewData["Title"] = "Günlük Banka Hareketleri (Finekra)";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var modelData = Model ?? new List<WebApplication3.Controllers.BankaHareketiViewModel>();

    // Talep 45: Finekra hareket servisinin "balance" alani doluysa satir bazinda
    // bakiye gosterilir. Tum satirlarda 0 geliyorsa servis bu bilgiyi gondermemis
    // demektir; yaniltici "0,00" yerine "-" basilir ve tablo basliginda not dusulur.
    bool satirBakiyesiVar = modelData.Any(m => m.Bakiye != 0);
    var bankAccounts = ViewBag.SapBankAccounts as List<WebApplication3.Controllers.BankAccountModel>;
    var allAccounts = ViewBag.AllSapAccounts as List<WebApplication3.Controllers.BankAccountModel>;

    // Finekra hesabi -> SAP 102 hesabi eslestirmeleri (IBAN anahtarli). Kartlardaki
    // secimle kaydedilir; hareket satirlarinda SAP banka hesabi buradan gelir.
    var eslesmeler = ViewBag.HesapEslesmeleri as Dictionary<string, WebApplication3.Controllers.FinekraHesapEslesme>
                     ?? new Dictionary<string, WebApplication3.Controllers.FinekraHesapEslesme>(StringComparer.OrdinalIgnoreCase);
    var sapBankaHesaplari = bankAccounts ?? new List<WebApplication3.Controllers.BankAccountModel>();

    int eslesenSatir = modelData.Count(m => !string.IsNullOrEmpty(m.OnerilenBankaKodu));
    int eslestirmedenSatir = modelData.Count(m => m.OnerilenBankaKaynagi == "Eşleştirme");
    int eslesmeyenSatir = modelData.Count - eslesenSatir;
}

@functions {
    string IbanAnahtari(string s) =>
        string.IsNullOrWhiteSpace(s) ? null : new string(s.Where(c => !char.IsWhiteSpace(c)).ToArray()).ToUpperInvariant();

    WebApplication3.Controllers.FinekraHesapEslesme EslesmeBul(
        WebApplication3.Controllers.FinekraHesapBakiyeModel h,
        Dictionary<string, WebApplication3.Controllers.FinekraHesapEslesme> eslesmeler)
    {
        if (h == null) return null;
        WebApplication3.Controllers.FinekraHesapEslesme es;
        // Once IBAN, yoksa Finekra hesap kimligi ("ID:...") ile aranir.
        var k = IbanAnahtari(h.Iban);
        if (k != null && eslesmeler.TryGetValue(k, out es)) return es;
        if (!string.IsNullOrWhiteSpace(h.Id) && eslesmeler.TryGetValue("ID:" + h.Id.Trim(), out es)) return es;
        return null;
    }

    // Karttaki "Sistemdeki hesap karsiligi" secim kutusu. HTML burada uretilir ki
    // dolu ve sifir bakiyeli kartlar ayni bileseni kullansin.
    Microsoft.AspNetCore.Html.HtmlString EslesmeSecimi(
        WebApplication3.Controllers.FinekraHesapBakiyeModel h,
        Dictionary<string, WebApplication3.Controllers.FinekraHesapEslesme> eslesmeler,
        List<WebApplication3.Controllers.BankAccountModel> hesaplar,
        bool kompakt)
    {
        Func<string, string> E = s => System.Net.WebUtility.HtmlEncode(s ?? "");
        var es = EslesmeBul(h, eslesmeler);
        // IBAN yoksa hesap kimligiyle eslesir; yalnizca ikisi de yoksa engellenir.
        bool ibanYok = IbanAnahtari(h.Iban) == null && string.IsNullOrWhiteSpace(h.Id);

        var sb = new System.Text.StringBuilder();
        sb.Append("<div class=\"eslesme-alani " + (kompakt ? "" : "mt-2 pt-2 border-top") + "\"")
          .Append(" data-hesap-id=\"" + E(h.Id) + "\" data-iban=\"" + E(h.Iban) + "\"")
          .Append(" data-banka=\"" + E(h.BankaAdi) + "\" data-hesap-ad=\"" + E(h.HesapAdi) + "\">");

        if (!kompakt)
            sb.Append("<div class=\"text-muted fw-bold mb-1\" style=\"font-size:.66rem;letter-spacing:.02em;\">SİSTEMDEKİ HESAP KARŞILIĞI (102)</div>");

        if (ibanYok)
        {
            sb.Append("<span class=\"badge bg-secondary\">Hesap kimliği yok, eşleştirilemez</span>");
        }
        else
        {
            sb.Append("<select class=\"form-select form-select-sm eslesme-select2\" style=\"width:100%\">")
              .Append("<option value=\"\">Seçilmedi</option>");
            foreach (var a in hesaplar)
            {
                bool secili = es != null && es.SapHesapKodu == a.AcctCode;
                sb.Append("<option value=\"" + E(a.AcctCode) + "\"" + (secili ? " selected" : "") + ">")
                  .Append(E(a.AcctCode) + " - " + E(a.AcctName) + " (" + E(a.Currency) + ")")
                  .Append("</option>");
            }
            sb.Append("</select>");
            sb.Append("<div class=\"eslesme-durum small mt-1\">")
              .Append(es != null
                  ? "<span class=\"badge bg-success\"><i class=\"fas fa-link me-1\"></i>Eşleştirildi</span>"
                  : "<span class=\"badge bg-warning text-dark\"><i class=\"fas fa-unlink me-1\"></i>Eşleştirilmedi</span>")
              .Append("</div>");
        }
        sb.Append("</div>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        :root {
            --primary-color: #11998e;
            --secondary-color: #38ef7d;
            --surface-color: #ffffff;
            --bg-color: #f8f9fa;
            --text-color: #2b2d42;
            --border-radius: 12px;
            --transition-speed: 0.3s;
        }

        body { 
            font-family: 'Inter', 'Segoe UI', Tahoma, sans-serif; 
            background-color: var(--bg-color);
            color: var(--text-color);
        }

        .page-header {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: white; 
            padding: 2.5rem 1.5rem; 
            border-radius: var(--border-radius); 
            margin-bottom: 2rem;
            box-shadow: 0 10px 20px rgba(17, 153, 142, 0.15);
        }

        .modern-card {
            background: var(--surface-color);
            border-radius: var(--border-radius);
            border: none;
            box-shadow: 0 4px 15px rgba(0,0,0,0.04);
            margin-bottom: 2rem;
            transition: box-shadow var(--transition-speed);
        }

        .modern-input {
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            padding: 0.75rem 1rem;
            transition: all var(--transition-speed);
        }

        .btn-modern {
            border-radius: 8px;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            border: none;
            transition: all var(--transition-speed);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }
        .btn-primary-modern {
            background-color: var(--primary-color);
            color: white;
        }

        .table-container { 
            padding: 0; 
            overflow-x: auto; 
            border-radius: var(--border-radius);
        }
        .modern-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            margin-bottom: 0;
        }
        .modern-table thead th { 
            background-color: #f8fafc; 
            color: #64748b; 
            font-size: 0.75rem; 
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 1rem 1.25rem; 
            border-bottom: 2px solid #e2e8f0; 
            position: sticky; 
            top: 0; 
            z-index: 10;
            white-space: nowrap;
        }
        .modern-table tbody tr {
            transition: background-color var(--transition-speed);
        }
        .modern-table tbody tr:hover {
            background-color: #f1f5f9;
        }
        .modern-table td { 
            padding: 1rem 1.25rem; 
            border-bottom: 1px solid #e2e8f0; 
            vertical-align: middle; 
            font-size: 0.875rem; 
        }

        .text-borc { color: #ef4444; font-weight: 600; }
        .text-alacak { color: #10b981; font-weight: 600; }
        
        .badge-modern {
            padding: 0.5em 0.85em;
            border-radius: 50rem;
            font-weight: 500;
            font-size: 0.75rem;
        }

        .preview-box {
            background: #f8fafc;
            border: 1px dashed #cbd5e1;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1rem;
        }
        .preview-label { font-size: 0.75rem; color: #64748b; text-transform: uppercase; font-weight:bold; }
        .preview-val { font-size: 0.9rem; color: #0f172a; margin-bottom: 0.5rem; font-weight: 600;}

        .select2-container--default .select2-selection--single {
            height: 38px;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }

        .kkeg-table th, .kkeg-table td {
            padding: 0.5rem;
            vertical-align: middle;
            font-size: 0.85rem;
        }
    </style>
}

<div class="container-fluid py-4">
    
    <div class="page-header text-center">
        <h2 class="fw-bold mb-2">FİNEKRA GÜNLÜK BANKA HAREKETLERİ</h2>
        <p class="mb-0 opacity-75">Açık Bankacılık API Entegrasyonu</p>
    </div>

    @if (ViewBag.ApiStatus != null && ViewBag.ApiStatus != "Başarılı")
    {
        <div class="alert alert-danger shadow-sm border-0 rounded-3 mb-4">
            <h5 class="alert-heading fw-bold"><i class="fas fa-exclamation-triangle me-2"></i> BAĞLANTI HATASI</h5>
            <hr>
            <p class="mb-0">@ViewBag.ApiStatus</p>
        </div>
    }

    <!-- BANKA BAKİYELERİ KARTLARI + SAP 102 EŞLEŞTİRME -->
    @if (ViewBag.HesapBakiyeleri != null)
    {
        var bakiyeler = ViewBag.HesapBakiyeleri as List<WebApplication3.Controllers.FinekraHesapBakiyeModel>
                        ?? new List<WebApplication3.Controllers.FinekraHesapBakiyeModel>();
        var doluHesaplar = bakiyeler.Where(x => x.Bakiye != 0).OrderByDescending(x => x.Bakiye).ToList();
        var sifirHesaplar = bakiyeler.Where(x => x.Bakiye == 0).OrderBy(x => x.BankaAdi).ThenBy(x => x.HesapAdi).ToList();
        int eslesenHesap = bakiyeler.Count(h => EslesmeBul(h, eslesmeler) != null);

        if (bakiyeler.Any())
        {
            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                <div class="small text-muted">
                    <i class="fas fa-university me-1"></i><b>@bakiyeler.Count</b> Finekra hesabının <b>@eslesenHesap</b> tanesi SAP 102 hesabıyla eşleştirildi.
                    @if (eslesenHesap < bakiyeler.Count)
                    {
                        <span class="text-warning fw-semibold ms-1"><i class="fas fa-exclamation-triangle me-1"></i>@(bakiyeler.Count - eslesenHesap) hesap eşleştirilmedi.</span>
                    }
                </div>
                <div class="small text-muted">Eşleştirme bir kez yapılır; hareketlerde SAP banka hesabı otomatik gelir.</div>
            </div>

            <div class="row g-3 mb-3">
                @foreach (var hesap in doluHesaplar)
                {
                    var eslesti = EslesmeBul(hesap, eslesmeler) != null;
                    <div class="col-12 col-md-6 col-lg-4 col-xxl-3">
                        <div class="modern-card p-3 border-start border-4 @(eslesti ? "border-success" : "border-warning") h-100 mb-0 d-flex flex-column">
                            <div class="text-muted small fw-bold text-uppercase mb-1">@hesap.BankaAdi</div>
                            <div class="text-dark fw-bold mb-1" style="font-size: 0.9rem;" title="@hesap.HesapAdi">
                                @(hesap.HesapAdi.Length > 26 ? hesap.HesapAdi.Substring(0, 26) + "..." : hesap.HesapAdi)
                            </div>
                            <div class="text-muted small mb-2 font-monospace">@hesap.Iban</div>
                            <div>
                                <span class="fs-4 fw-bolder @(hesap.Bakiye < 0 ? "text-danger" : "text-success")">@hesap.Bakiye.ToString("N2", new CultureInfo("tr-TR"))</span>
                                <span class="fs-6 text-muted fw-bold ms-1">@hesap.ParaBirimi</span>
                            </div>
                            <div class="mt-auto">
                                @EslesmeSecimi(hesap, eslesmeler, sapBankaHesaplari, false)
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (sifirHesaplar.Any())
            {
                <div class="mb-4">
                    <a class="small text-decoration-none fw-semibold" data-bs-toggle="collapse" href="#sifirHesaplar" role="button" aria-expanded="false">
                        <i class="fas fa-chevron-down me-1"></i>Bakiyesi sıfır olan @sifirHesaplar.Count hesap (eşleştirme için göster)
                    </a>
                    <div class="collapse mt-2" id="sifirHesaplar">
                        <div class="row g-2">
                            @foreach (var hesap in sifirHesaplar)
                            {
                                var eslesti = EslesmeBul(hesap, eslesmeler) != null;
                                <div class="col-12 col-md-6 col-lg-4">
                                    <div class="modern-card p-2 border-start border-4 @(eslesti ? "border-success" : "border-warning") mb-0">
                                        <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                                            <span class="small fw-bold text-dark" title="@hesap.HesapAdi">@hesap.BankaAdi <span class="text-muted fw-normal">· @hesap.ParaBirimi</span></span>
                                            <span class="small text-muted font-monospace">@hesap.Iban</span>
                                        </div>
                                        @EslesmeSecimi(hesap, eslesmeler, sapBankaHesaplari, true)
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    }

    <div class="modern-card p-4">
        <form asp-controller="Rapor105" asp-action="Index" method="get">
            <div class="row g-4 align-items-end">
                <div class="col-12 col-md-3">
                    <label for="startDate" class="form-label text-muted fw-semibold small mb-2">BAŞLANGIÇ TARİHİ</label>
                    <input type="date" class="form-control modern-input" id="startDate" name="startDate" value="@ViewBag.StartDate">
                </div>
                <div class="col-12 col-md-3">
                    <label for="endDate" class="form-label text-muted fw-semibold small mb-2">BİTİŞ TARİHİ</label>
                    <input type="date" class="form-control modern-input" id="endDate" name="endDate" value="@ViewBag.EndDate">
                </div>
                <div class="col-12 col-md-3">
                    <label for="bankaFiltresi" class="form-label text-muted fw-semibold small mb-2">BANKA</label>
                    @{
                        var bankaListesi = modelData.Select(m => m.BankaAdi)
                            .Where(b => !string.IsNullOrEmpty(b)).Distinct().OrderBy(b => b).ToList();
                    }
                    <select id="bankaFiltresi" class="form-select modern-input" title="Bankaya göre filtrele">
                        <option value="">Tüm bankalar</option>
                        @foreach (var bnk in bankaListesi)
                        {
                            <option value="@bnk">@bnk</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <button type="submit" class="btn-modern btn-primary-modern w-100">
                        <i class="fas fa-sync-alt"></i> Hareketleri Çek
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- HAREKETLER TABLOSU -->
    <div class="modern-card table-container">
        
        <!-- YENİ EKLENEN ÜST ARAÇ ÇUBUĞU (HATALI VADELİLER İÇİN) -->
        <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
            <h5 class="m-0 fw-bold text-dark"><i class="fas fa-list me-2"></i>İşlem Listesi
                @if (modelData.Any() && !satirBakiyesiVar)
                {
                    <small class="text-muted fw-normal ms-2" style="font-size: .78rem;"><i class="fas fa-info-circle me-1"></i>Finekra bu dönem için satır bakiyesi göndermedi.</small>
                }
            </h5>
            @if (modelData.Any())
            {
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-success" title="SAP banka hesabı bulunan hareket"><i class="fas fa-check me-1"></i>@eslesenSatir eşleşti</span>
                    <span class="badge bg-primary" title="Kayıtlı eşleştirmeden gelen"><i class="fas fa-link me-1"></i>@eslestirmedenSatir eşleştirmeden</span>
                    <span class="badge @(eslesmeyenSatir > 0 ? "bg-danger" : "bg-secondary")" title="SAP banka hesabı bulunamayan hareket"><i class="fas fa-unlink me-1"></i>@eslesmeyenSatir eşleşmedi</span>
                    @if (eslesmeyenSatir > 0)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger" id="btnSadeceEslesmeyen">
                            <i class="fas fa-filter me-1"></i><span class="metin">Sadece eşleşmeyenler</span>
                        </button>
                    }
                </div>
            }
            <button class="btn btn-warning shadow-sm fw-bold text-dark" onclick="openHataliVadeliModal()">
                <i class="fas fa-exclamation-triangle me-1"></i> Hatalı Vadeli İşlemleri Temizle
            </button>
        </div>

        @if (modelData.Any())
        {
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Banka Adı</th>
                        <th>IBAN / Hesap</th>
                        <th>Açıklama</th>
                        <th>VKN / TCKN</th>
                        <th>Finekra Karşı Taraf</th>
                        <th style="min-width: 250px;">SAP Cari Bilgisi</th>
                        <th>SAP Banka Hesabı</th>
                        <th>İşlem Yönü</th>
                        <th>İşlem Türü</th>
                        <th class="text-end">Orijinal Tutar</th>
                        <th class="text-end">Tutar (TRY)</th>
                        @* Talep 45: satir bazinda banka bakiyesi. Finekra'nin hareket
                           servisi her harekette o hesabin ISLEM SONRASI bakiyesini gonderir. *@
                        <th class="text-end" title="İşlem sonrası hesap bakiyesi (Finekra)">Bakiye (Finekra)</th>
                        <th class="text-center">SAP Durumu</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in modelData)
                    {
                        <tr data-banka-eslesme="@(string.IsNullOrEmpty(item.OnerilenBankaKodu) ? "yok" : "var")" data-banka="@item.BankaAdi">
                            <td class="text-muted">@(item.IslemTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                            <td><strong class="text-dark">@item.BankaAdi</strong></td>
                            <td class="text-muted">@item.Iban</td>
                            <td>
                                <div style="min-width: 200px; max-width: 300px; white-space: normal; word-break: break-word;">
                                    @item.Aciklama
                                </div>
                            </td>
                            
                            <td>
                                <span class="fw-semibold text-dark">@item.EkrandaGorunenVkn</span>
                                @if (!string.IsNullOrEmpty(item.EkrandaGorunenVknKaynagi))
                                {
                                    <small class="text-muted d-block fw-normal mt-1" style="font-size: 0.70rem;">(@item.EkrandaGorunenVknKaynagi)</small>
                                }
                            </td>

                            <td>
                                @if (item.FinekraCariIsmi == "Açıklamada Belirtilmiş")
                                {
                                    <span class="text-muted small fst-italic">Açıklamada Belirtilmiş</span>
                                }
                                else
                                {
                                    <div style="min-width: 120px; max-width: 200px; white-space: normal; word-break: break-word;" class="fw-medium text-dark">
                                        @item.FinekraCariIsmi
                                    </div>
                                }
                            </td>
                            
                            <!-- SAP CARİ SEÇİM VEYA METİN ALANI -->
                            <td id="cari-td-@item.Id">
                                @if (item.SapAktarildiMi)
                                {
                                    @if (!string.IsNullOrEmpty(item.SapCariKodu))
                                    {
                                        <span class="fw-bold text-primary d-block">@item.SapCariKodu</span>
                                        <div style="max-width: 200px; white-space: normal; word-break: break-word;" class="text-muted small mt-1">@item.SapCariAdi</div>
                                    }
                                    else if(item.SapCariAdi == "Dahili İşlem (Banka Masrafı / Virman vb.)")
                                    {
                                        <span class="badge bg-info text-dark badge-modern"><i class="fas fa-building me-1"></i> Dahili İşlem</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><em>Bilinmiyor</em></span>
                                    }
                                }
                                else
                                {
                                    <select class="form-select grid-cari-select2" id="gridCari-@item.Id" style="width: 100%; min-width: 220px;" 
                                            data-id="@item.Id" 
                                            data-date="@item.IslemTarihi?.ToString("yyyy-MM-dd")" 
                                            data-amount="@item.Tutar.ToString(CultureInfo.InvariantCulture)" 
                                            data-isgiris="@item.IsGiris.ToString().ToLower()">
                                        @if (!string.IsNullOrEmpty(item.SapCariKodu))
                                        {
                                            <option value="@item.SapCariKodu" selected="selected">@item.SapCariKodu - @item.SapCariAdi</option>
                                        }
                                        else if (item.SapCariAdi == "Dahili İşlem (Banka Masrafı / Virman vb.)")
                                        {
                                            <option value="DAHILI" selected="selected">DAHILI - Dahili İşlem (Banka Masrafı / Virman vb.)</option>
                                        }
                                        else
                                        {
                                            <option value="">-- Cari Seçiniz --</option>
                                        }
                                    </select>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.OnerilenBankaKodu))
                                {
                                    <span class="fw-bold text-success d-block">@item.OnerilenBankaKodu</span>
                                    <div class="text-muted small mt-1" style="max-width:180px; white-space:normal; word-break:break-word;">
                                        @item.OnerilenBankaAdi
                                    </div>
                                    @if (item.OnerilenBankaKaynagi == "Eşleştirme")
                                    {
                                        <span class="badge bg-primary mt-1" style="font-size:.62rem;" title="Kartlardaki kayıtlı eşleştirmeden geldi"><i class="fas fa-link me-1"></i>Eşleştirme</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border mt-1" style="font-size:.62rem;" title="Banka adı / açıklamadan tahmin edildi. Kesinleştirmek için üstteki kartta eşleştirin."><i class="fas fa-magic me-1"></i>Tahmin</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-danger small"><i class="fas fa-exclamation-circle"></i> Eşleşmedi</span>
                                    <small class="d-block text-muted mt-1" style="font-size:.66rem;">Üstteki kartta hesabı eşleştirin</small>
                                }
                            </td>

                            <td>
                                @if (!item.IsGiris)
                                {
                                    <span class="badge bg-danger badge-modern bg-opacity-10 text-danger border border-danger border-opacity-25">Çıkış</span>
                                }
                                else
                                {
                                    <span class="badge bg-success badge-modern bg-opacity-10 text-success border border-success border-opacity-25">Giriş</span>
                                }
                            </td>
                            <td>
                                <span class="fw-semibold text-secondary">@item.IslemTuru</span>
                                @if (!string.IsNullOrWhiteSpace(item.IslemKodu))
                                {
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">(@item.IslemKodu)</small>
                                }
                            </td>
                            <td class="text-end @(!item.IsGiris ? "text-borc" : "text-alacak")">
                                @item.Tutar.ToString("N2", new CultureInfo("tr-TR"))
                                <small class="text-muted d-block fw-normal mt-1" style="font-size: 0.70rem;">@item.ParaBirimi</small>
                            </td>
                            <td class="text-end fw-bold text-dark">
                                @item.TutarTRY.ToString("N2", new CultureInfo("tr-TR"))
                                <small class="text-muted d-block fw-normal mt-1" style="font-size: 0.70rem;">TRY</small>
                            </td>

                            @* Talep 45: bu hesabin, bu islemden sonraki bakiyesi (Finekra). *@
                            <td class="text-end fw-semibold @(item.Bakiye < 0 ? "text-danger" : "text-dark")" style="white-space: nowrap;"
                                title="@item.BankaAdi - @item.Iban hesabının @(item.IslemTarihi?.ToString("dd.MM.yyyy HH:mm")) itibarıyla bakiyesi (Finekra)">
                                @if (satirBakiyesiVar)
                                {
                                    @item.Bakiye.ToString("N2", new CultureInfo("tr-TR"))
                                    <small class="text-muted d-block fw-normal mt-1" style="font-size: 0.70rem;">@item.ParaBirimi</small>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>

                            <td class="text-center" id="status-@item.Id">
                                @if (item.SapAktarildiMi)
                                {
                                    <span class="badge bg-success badge-modern mb-1"><i class="fas fa-check-circle me-1"></i> İşlendi</span>
                                    @if (!string.IsNullOrEmpty(item.SapBelgeNo))
                                    {
                                        <small class="text-muted d-block" style="font-size: 0.70rem;">@item.SapBelgeTuru: @item.SapBelgeNo</small>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark badge-modern"><i class="fas fa-clock me-1"></i> Bekliyor</span>
                                }
                            </td>
                            
                            <!-- İŞLEMLER BUTONLARI -->
                            <td class="text-center">
                                <div class="d-flex flex-column gap-2 align-items-center">
                                    @if (!string.IsNullOrEmpty(item.Id))
                                    {
                                        <a href="@Url.Action("DekontIndir", "Rapor105", new { id = item.Id })" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-sm w-100" title="PDF Dekont">
                                            <i class="fas fa-file-pdf"></i> PDF
                                        </a>
                                    }

                                    @if (!item.SapAktarildiMi)
                                    {
                                        <!-- SAP'YE AKTAR BUTONU -->
                                        <button id="btnAktar-@item.Id" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm w-100" 
                                                onclick="openSapModal('@item.Id', '@item.Tutar.ToString("F2", CultureInfo.InvariantCulture)', '@item.TutarTRY.ToString("F2", CultureInfo.InvariantCulture)', '@(item.IsGiris.ToString().ToLower())', '@item.IslemTarihi?.ToString("yyyy-MM-dd")', '@(item.Aciklama?.Replace("'","\\'") ?? "")', '@item.OnerilenBankaKodu', '@(item.IslemTuru?.Replace("'","\\'") ?? "")', '@item.ParaBirimi', '@(item.AciklamadanGelenKur?.ToString("F4", CultureInfo.InvariantCulture) ?? "")', '@item.SapSistemKuru.ToString("F4", CultureInfo.InvariantCulture)', '@(item.EkrandaGorunenVkn ?? "")')">
                                            <i class="fas fa-cloud-upload-alt"></i> SAP'ye Aktar
                                        </button>
                                    }
                                    else
                                    {
                                        <!-- YENİ EKLENEN İPTAL BUTONU (SADECE İŞLENDİYSE) -->
                                        @if (item.SapTransId.HasValue && item.SapTransId.Value > 0)
                                        {
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm w-100" 
                                                    onclick="iptalEtSingle(@item.SapTransId.Value, '@(item.SapBelgeNo ?? "")', '@(item.SapBelgeTuru ?? "")', '@item.Id')">
                                                <i class="fas fa-trash-alt"></i> İptal Et
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (ViewBag.ApiStatus == "Başarılı")
        {
            <div class="text-center py-5">
                <i class="fas fa-box-open fa-3x text-muted mb-3 opacity-50"></i>
                <h5 class="text-muted">Kayıt Bulunamadı</h5>
                <p class="text-muted small">Seçilen tarih aralığında herhangi bir banka hareketi bulunmuyor.</p>
            </div>
        }
    </div>
</div>

