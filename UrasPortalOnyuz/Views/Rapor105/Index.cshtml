            var belgeTuru = document.getElementById('selBelgeTuru').value;
            var isYevmiye = (belgeTuru === "30");
            var isKkeg = document.getElementById('chkKkeg').checked;
            
            if(isYevmiye) {
                document.getElementById('divKkegWrapper').style.display = "block";
                
                if(isKkeg) {
                    document.getElementById('divStandartKarsiTaraf').style.display = "none";
                    document.getElementById('divCokluYevmiye').style.display = "none";
                    document.getElementById('divKkegDetails').style.display = "block";
