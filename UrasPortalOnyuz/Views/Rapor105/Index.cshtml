        function toggleYevmiyeTipi() {
            if ($('#selYevmiyeTipi').val() === 'Cari') {
                $('#divYevmiyeCari').show();
                $('#divYevmiyeHesap').hide();
            } else {
                $('#divYevmiyeCari').hide();
                $('#divYevmiyeHesap').show();
