        // ==========================================
        // ÇOKLU YEVMİYE SATIRI YÖNETİMİ
        // ==========================================
        function addYevmiyeSatir() {
            let tipi = $('#selYevmiyeTipi').val();
            let kod = '';
            let isim = '';

            if (tipi === 'Cari') {
                let data = $('#inpYevmiyeCari').select2('data');
                if(data && data.length > 0) {
                    kod = data[0].id;
                    isim = data[0].text;
                }
            } else {
                let el = $('#inpYevmiyeHesap');
                kod = el.val();
                isim = el.find("option:selected").text();
            }

            let tutar = parseFloat($('#inpYevmiyeTutar').val());

            if (!kod) { alert("Lütfen Cari/Hesap seçiniz!"); return false; }
            if (isNaN(tutar) || tutar <= 0) { alert("Lütfen 0'dan büyük geçerli bir tutar giriniz!"); return false; }

            yevmiyeSatirlariArray.push({
                Tipi: tipi,
                Kod: kod,
                Isim: isim,
                Tutar: tutar
            });

            renderYevmiyeSatirlari();
            formValidationCheck();
            
            $('#inpYevmiyeCari').val(null).trigger('change');
            $('#inpYevmiyeHesap').val(null).trigger('change');
            return true;
        }

        function removeYevmiyeSatir(index) {
            yevmiyeSatirlariArray.splice(index, 1);
            renderYevmiyeSatirlari();
            formValidationCheck();
        }

        function renderYevmiyeSatirlari() {
            let html = '';
            let total = 0;
            yevmiyeSatirlariArray.forEach((s, index) => {
                let badgeClass = s.Tipi === 'Cari' ? 'bg-primary' : 'bg-info text-dark';
                html += `<tr>
                    <td><span class="badge ${badgeClass} badge-modern">${s.Tipi}</span></td>
                    <td class="fw-medium"><small>${s.Isim}</small></td>
                    <td class="text-end fw-bold">${s.Tutar.toLocaleString('tr-TR', {minimumFractionDigits:2, maximumFractionDigits:2})}</td>
                    <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeYevmiyeSatir(${index})"><i class="fas fa-times"></i></button></td>
                </tr>`;
                total += s.Tutar;
            });
            
            if (yevmiyeSatirlariArray.length === 0) {
                html = `<tr><td colspan="4" class="text-center text-muted small py-3">Henüz satır eklenmedi. Lütfen yukarıdan satır ekleyiniz.</td></tr>`;
            }
            
            $('#tbYevmiyeSatirlari').html(html);
            $('#thYevmiyeToplam').text(total.toLocaleString('tr-TR', {minimumFractionDigits:2, maximumFractionDigits:2}));

            let targetTutarFC = Math.abs(parseFloat($('#modalTutar').val()) || 0);
            let uygulananKur = parseFloat($('#inpUygulanacakKur').val()) || 1;
            let targetTotal = targetTutarFC * uygulananKur; 
            
            let remaining = targetTotal - total;
            if (remaining > 0.01) {
                $('#inpYevmiyeTutar').val(remaining.toFixed(2));
            } else {
                $('#inpYevmiyeTutar').val('');
            }
        }

        // ==========================================
        // DÖVİZ KURU HESAPLAMA (FRONTEND)
        // ==========================================
        function kurTipiDegisti() {
            let tip = document.getElementById('selKurTipi').value;
            let kurInput = document.getElementById('inpUygulanacakKur');
            
            if (tip === "aciklama") {
                let aciklamaKuru = document.getElementById('hdnAciklamaKuru').value;
                kurInput.value = (parseFloat(aciklamaKuru) > 0) ? parseFloat(aciklamaKuru).toFixed(4) : "1.0000";
                kurInput.disabled = true;
            } else if (tip === "sap") {
                let sapKuru = document.getElementById('hdnSapKuru').value;
                kurInput.value = (parseFloat(sapKuru) > 0) ? parseFloat(sapKuru).toFixed(4) : "1.0000";
                kurInput.disabled = true;
            } else {
                kurInput.disabled = false;
                kurInput.focus();
            }
            manuelKurHesapla();
        }

        function manuelKurHesapla() {
            let kur = parseFloat(document.getElementById('inpUygulanacakKur').value) || 1;
            let orijinalTutar = parseFloat(document.getElementById('modalTutar').value) || 0;
            let pBirim = document.getElementById('modalParaBirimi').value || "TRY";
            
            let yeniTlTutar = Math.abs(orijinalTutar) * kur;
            
            if (pBirim === "TRY" || pBirim === "TL") {
                document.getElementById('lblTutar').innerText = Math.abs(orijinalTutar).toLocaleString('tr-TR') + " ₺";
            } else {
                document.getElementById('lblTutar').innerText = yeniTlTutar.toLocaleString('tr-TR') + " ₺ (Döviz Tutar: " + Math.abs(orijinalTutar).toLocaleString('tr-TR') + " " + pBirim + ")";
            }

            calculateKkegPreview();
            
            if(yevmiyeSatirlariArray.length === 0) {
                document.getElementById('inpYevmiyeTutar').value = yeniTlTutar.toFixed(2);
            } else if (yevmiyeSatirlariArray.length === 1 && document.getElementById('inpCariKodu').value !== "") {
                yevmiyeSatirlariArray[0].Tutar = yeniTlTutar;
                renderYevmiyeSatirlari();
            }
        }

        // ==========================================
        // MODAL AÇILIŞ
        // ==========================================
        function openSapModal(id, tutarOrijinal, tutarTRY, isGiris, tarih, aciklama, onerilenBankaKodu, islemTuru, paraBirimi, aciklamaKuru, sapKuru, finekraVkn) {
            
            document.getElementById('btnAktarOnayla').disabled = true;

            document.getElementById('modalId').value = id;
            document.getElementById('modalTutar').value = tutarOrijinal; 
            document.getElementById('modalParaBirimi').value = paraBirimi || "TRY";
            document.getElementById('modalIsGiris').value = isGiris; 
            document.getElementById('modalTarih').value = tarih;
            document.getElementById('modalAciklama').value = aciklama;
            document.getElementById('modalIslemTuru').value = islemTuru || ""; 

            // VKN Bilgisi
            document.getElementById('modalFinekraVkn').value = finekraVkn || "";
            var divVknGuncelle = document.getElementById('divVknGuncelleme');
            var chkUpdateVkn = document.getElementById('chkUpdateVkn');
            
            chkUpdateVkn.checked = false; 
            if (finekraVkn && finekraVkn.length >= 10) {
                divVknGuncelle.style.display = "block";
                document.getElementById('lblVknUpdateText').innerText = "Seçilen Carinin VKN/TCKN Bilgisini Güncelle (Dekont VKN/TCKN: " + finekraVkn + ")";
            } else {
                divVknGuncelle.style.display = "none";
            }

            document.getElementById('hdnAciklamaKuru').value = aciklamaKuru || "";
            document.getElementById('hdnSapKuru').value = sapKuru || "";

            let pBirim = paraBirimi || "TRY";

            if (pBirim !== "TRY" && pBirim !== "TL") {
                document.getElementById('divDovizKuruAlani').style.display = "flex";
                
                if (aciklamaKuru && parseFloat(aciklamaKuru) > 0) {
                    document.getElementById('selKurTipi').value = "aciklama";
                    document.getElementById('inpUygulanacakKur').value = parseFloat(aciklamaKuru).toFixed(4);
                    document.getElementById('inpUygulanacakKur').disabled = true;
                } else {
                    document.getElementById('selKurTipi').value = "sap";
                    document.getElementById('inpUygulanacakKur').value = parseFloat(sapKuru).toFixed(4);
                    document.getElementById('inpUygulanacakKur').disabled = true;
                }
            } else {
                document.getElementById('divDovizKuruAlani').style.display = "none";
                document.getElementById('inpUygulanacakKur').value = "1";
            }

            document.getElementById('selIslemTipi').value = "R";

            var selBanka = $('#selBankaHesabi');
            if (onerilenBankaKodu) {
                selBanka.val(onerilenBankaKodu).trigger('change');
            } else {
                selBanka.val('').trigger('change');
            }

            // ANA TABLODAKİ (GRID) SEÇİLİ CARİYİ OKU (YENİ MANTIK)
            var gridSelect = $('#gridCari-' + id);
            var cariKodu = "";
            var cariAdi = "";
            if (gridSelect.length && gridSelect.val()) {
                var val = gridSelect.val();
                if (val === "DAHILI") {
                    cariKodu = "";
                    cariAdi = "Dahili İşlem (Banka Masrafı / Virman vb.)";
                } else {
                    var dataObj = gridSelect.select2('data')[0];
                    cariKodu = val;
                    if (dataObj && dataObj.text) {
                        cariAdi = dataObj.text.includes(' - ') ? dataObj.text.split(' - ').slice(1).join(' - ') : dataObj.text;
                    }
                }
            }

            var cariSelect = $('#inpCariKodu');
            cariSelect.empty();
            if (cariKodu && cariKodu !== "") {
                var optionText = cariKodu + (cariAdi ? " - " + cariAdi : "");
                var newOption = new Option(optionText, cariKodu, true, true);
                cariSelect.append(newOption).trigger('change');
            } else {
                cariSelect.val(null).trigger('change');
            }
            
            var lblCariAdi = document.getElementById('lblCariAdi');
            if(cariKodu) {
                lblCariAdi.innerText = cariAdi;
                lblCariAdi.classList.remove("text-danger");
            } else {
                if (cariAdi && cariAdi.includes("Dahili İşlem")) {
                    lblCariAdi.innerText = cariAdi;
                    lblCariAdi.classList.remove("text-danger");
                } else {
                    lblCariAdi.innerText = "Sistem eşleşme bulamadı, lütfen arama yapınız.";
                    lblCariAdi.classList.add("text-danger");
                }
            }
            
            document.getElementById('chkKkeg').checked = false;

            yevmiyeSatirlariArray = [];
            let aktifKur = parseFloat(document.getElementById('inpUygulanacakKur').value) || 1;
            let tryKarsiligi = Math.abs(parseFloat(tutarOrijinal)) * aktifKur;

            $('#inpYevmiyeTutar').val(tryKarsiligi.toFixed(2));
            
            if (cariKodu && cariKodu !== "") {
                yevmiyeSatirlariArray.push({
                    Tipi: 'Cari',
                    Kod: cariKodu,
                    Isim: cariKodu + (cariAdi ? " - " + cariAdi : ""),
                    Tutar: tryKarsiligi
                });
            }
            renderYevmiyeSatirlari();
            toggleYevmiyeTipi(); 

            document.getElementById('lblTarih').innerText = tarih;
            document.getElementById('lblAciklama').innerText = aciklama;

            manuelKurHesapla();

            if(isGiris === "false") { 
                document.getElementById('selBelgeTuru').value = "46"; 
            } else { 
                document.getElementById('selBelgeTuru').value = "24"; 
            }
            
            if(cariAdi && cariAdi.includes("Dahili İşlem")) {
                document.getElementById('selBelgeTuru').value = "30"; 
            }
            
            toggleBelgeTuru();
            formValidationCheck(); 
            aktarModal.show();
        }

        // ==========================================
        // AKILLI HESAP SEÇİMİ (AUTO-SELECT) KKEG
        // ==========================================
        function autoSelectKkegAccounts() {
            let islemTuru = document.getElementById('modalIslemTuru').value.toUpperCase();
            let aciklama = document.getElementById('modalAciklama').value.toUpperCase();
            let kdvRate = document.getElementById('selKdvRate').value; 
            
            let combinedText = islemTuru + " " + aciklama;
            
            const findBest = (selectId, keywords) => {
                let options = $(selectId + ' option');
                for(let i=0; i<options.length; i++) {
                    if(!options[i].value) continue;
                    let txt = options[i].text.toUpperCase();
                    let match = keywords.every(k => txt.includes(k.toUpperCase()));
                    if(match) return options[i].value;
                }
                return null;
            };

            let val70 = null;
            if(combinedText.includes("HGS") || combinedText.includes("OGS")) {
                val70 = findBest('#selGider70', ['770', 'HGS']) || findBest('#selGider70', ['770', 'OGS']);
            }
            if(!val70) val70 = findBest('#selGider70', ['770', 'BİNEK']); 
            if(val70) $('#selGider70').val(val70).trigger('change');

            let val30 = findBest('#selKkeg30', ['689', 'KKEG', 'BİNEK']) || findBest('#selKkeg30', ['689', 'KKEG']);
            if(val30) $('#selKkeg30').val(val30).trigger('change');

            let valKdv70 = findBest('#selKdv70', ['191', '%' + kdvRate]) || findBest('#selKdv70', ['191', kdvRate + ' ORANLI']);
            if(valKdv70) $('#selKdv70').val(valKdv70).trigger('change');

            let valKdv30 = findBest('#selKdv30', ['689', 'YAPILMAYAN', 'KDV']) || findBest('#selKdv30', ['689', 'KDV']);
            if(valKdv30) $('#selKdv30').val(valKdv30).trigger('change');
        }

        // ==========================================
        // KKEG CANLI HESAPLAMA VE ÖNİZLEME 
        // ==========================================
        function getAccountName(selectId, fallbackText) {
            var el = $(selectId);
            if (!el.val()) return fallbackText;
            var fullText = el.find("option:selected").text();
            var parts = fullText.split('-');
            if(parts.length > 1) {
                return parts.slice(1).join('-').trim(); 
            }
            return fullText;
        }

        function calculateKkegPreview() {
            if(!document.getElementById('chkKkeg').checked) return;

            var orijinalTutar = parseFloat(document.getElementById('modalTutar').value);
            var aktifKur = parseFloat(document.getElementById('inpUygulanacakKur').value) || 1;
            var isGider = (document.getElementById('modalIsGiris').value === "false");
            
            var tutar = Math.abs(orijinalTutar) * aktifKur;

            var kdvRate = parseFloat(document.getElementById('selKdvRate').value);
            
            var matrah = tutar / (1 + (kdvRate / 100));
            var kdv = tutar - matrah;

            var matrah70 = parseFloat((matrah * 0.70).toFixed(2));
            var matrah30 = parseFloat((matrah - matrah70).toFixed(2));

            var kdv70 = parseFloat((kdv * 0.70).toFixed(2));
            var kdv30 = parseFloat((kdv - kdv70).toFixed(2));

            var bBorc = !isGider ? tutar.toFixed(2) : "-";
            var bAlacak = isGider ? tutar.toFixed(2) : "-";

            var g70Borc = isGider ? matrah70.toFixed(2) : "-";
            var g70Alacak = !isGider ? matrah70.toFixed(2) : "-";

            var g30Borc = isGider ? matrah30.toFixed(2) : "-";
            var g30Alacak = !isGider ? matrah30.toFixed(2) : "-";

            var k70Borc = (isGider && kdv70 > 0) ? kdv70.toFixed(2) : "-";
            var k70Alacak = (!isGider && kdv70 > 0) ? kdv70.toFixed(2) : "-";

            var k30Borc = (isGider && kdv30 > 0) ? kdv30.toFixed(2) : "-";
            var k30Alacak = (!isGider && kdv30 > 0) ? kdv30.toFixed(2) : "-";

            var bankaHesabi = $('#selBankaHesabi').val() || "SEÇİLMEDİ";
            var g70Hsp = $('#selGider70').val() || "SEÇİLMEDİ";
            var g30Hsp = $('#selKkeg30').val() || "SEÇİLMEDİ";
            var k70Hsp = $('#selKdv70').val() || "SEÇİLMEDİ";
            var k30Hsp = $('#selKdv30').val() || "SEÇİLMEDİ";

            var bankaAd = getAccountName('#selBankaHesabi', 'Banka Çıkışı/Girişi');
            var g70Ad = getAccountName('#selGider70', '%70 Kabul Edilen Gider');
            var g30Ad = getAccountName('#selKkeg30', '%30 KKEG Gideri');
            var k70Ad = getAccountName('#selKdv70', '%70 İndirilecek KDV');
            var k30Ad = getAccountName('#selKdv30', '%30 İndirim Konusu Yapılmayan KDV (KKEG)');

            var tbody = document.getElementById('kkegPreviewBody');
            var html = "";

            html += `<tr><td class="fw-bold">${bankaHesabi}</td><td class="text-start">${bankaAd}</td><td class="text-primary fw-bold">${bBorc}</td><td class="text-danger fw-bold">${bAlacak}</td></tr>`;
            html += `<tr><td>${g70Hsp}</td><td class="text-start">${g70Ad}</td><td class="text-primary">${g70Borc}</td><td class="text-danger">${g70Alacak}</td></tr>`;
            html += `<tr><td>${g30Hsp}</td><td class="text-start">${g30Ad}</td><td class="text-primary">${g30Borc}</td><td class="text-danger">${g30Alacak}</td></tr>`;
            
            if(kdv > 0) {
                html += `<tr><td>${k70Hsp}</td><td class="text-start">${k70Ad}</td><td class="text-primary">${k70Borc}</td><td class="text-danger">${k70Alacak}</td></tr>`;
                html += `<tr><td>${k30Hsp}</td><td class="text-start">${k30Ad}</td><td class="text-primary">${k30Borc}</td><td class="text-danger">${k30Alacak}</td></tr>`;
            }

            tbody.innerHTML = html;
        }

        // ==========================================
        // SAP AKTARIMI API İSTEĞİ
        // ==========================================
        function submitSapAktarim() {
            
            formValidationCheck();
            var btn = document.getElementById('btnAktarOnayla');
            if (btn.disabled) return; 

            var originalText = btn.innerHTML;
            
            var belgeTuru = document.getElementById('selBelgeTuru').value;
            var isYevmiye = (belgeTuru === "30");
            var isKkeg = document.getElementById('chkKkeg').checked;
            
            var selBelgeDropdown = document.getElementById('selBelgeTuru');
            var belgeTuruText = selBelgeDropdown.options[selBelgeDropdown.selectedIndex].text.split('(')[0].trim();
            
            var bankaHesabi = $('#selBankaHesabi').val();
            var islemId = document.getElementById('modalId').value;
            
            var isGider = (document.getElementById('modalIsGiris').value === "false");
            var islemYonuMultiplier = isGider ? -1 : 1;
            
            var tutarFC = Math.abs(parseFloat(document.getElementById('modalTutar').value));
            var secilenKur = parseFloat(document.getElementById('inpUygulanacakKur').value) || 1;
            var tutarTRY = tutarFC * secilenKur;

            var payloadTutar = isYevmiye ? (tutarTRY * islemYonuMultiplier) : (tutarFC * islemYonuMultiplier);

            var payload = {
                Id: islemId,
                BelgeTuru: belgeTuru,
                IslemTipi: document.getElementById('selIslemTipi').value,
                
                UygulanacakKur: secilenKur, 

                VknGuncelle: document.getElementById('chkUpdateVkn') ? document.getElementById('chkUpdateVkn').checked : false,
                FinekraVkn: document.getElementById('modalFinekraVkn').value,

                KarsiTarafTipi: document.getElementById('selKarsiTipi').value,
                CariKodu: $('#inpCariKodu').val() || "", 
                
                Tutar: payloadTutar, 
                ParaBirimi: document.getElementById('modalParaBirimi').value, 
                IslemTarihi: document.getElementById('modalTarih').value,
                Aciklama: document.getElementById('modalAciklama').value,
                BankaHesapKodu: bankaHesabi,
                
                IsKkeg: isKkeg,
                KdvRate: parseInt(document.getElementById('selKdvRate').value),
                Gider70Hesap: $('#selGider70').val(),
                Kkeg30Hesap: $('#selKkeg30').val(),
                Kdv70Hesap: $('#selKdv70').val(),
                KkegKdv30Hesap: $('#selKdv30').val(),
                
                YevmiyeSatirlari: []
            };

            if(isYevmiye && isKkeg) {
                if(!$('#selGider70').val() || !$('#selKkeg30').val()) {
                    alert("KKEG işlemi için %70 ve %30 Gider Hesapları seçilmelidir!");
                    return;
                }
            } 
            else if (isYevmiye && !isKkeg) {
                
                let pendingTutar = parseFloat($('#inpYevmiyeTutar').val());
                let pendingTipi = $('#selYevmiyeTipi').val();
                let pendingKod = '';
                if (pendingTipi === 'Cari') {
                    let data = $('#inpYevmiyeCari').select2('data');
                    if(data && data.length > 0) pendingKod = data[0].id;
                } else {
                    pendingKod = $('#inpYevmiyeHesap').val();
                }

                if (yevmiyeSatirlariArray.length === 0 && pendingKod && !isNaN(pendingTutar) && pendingTutar > 0) {
                    addYevmiyeSatir();
                }

                if (yevmiyeSatirlariArray.length === 0) {
                    alert("Yevmiye kaydı için en az bir karşı hesap/cari satırı eklemelisiniz! Lütfen hesap seçip '+ Ekle' butonuna basınız.");
                    return;
                }
                
                let totalLines = yevmiyeSatirlariArray.reduce((acc, curr) => acc + curr.Tutar, 0);
                if (Math.abs(totalLines - Math.abs(tutarTRY)) > 0.01) {
                    alert(`Eklenen satırların toplamı (${totalLines.toLocaleString('tr-TR', {minimumFractionDigits:2})}) ile banka işleminin TRY tutarı (${Math.abs(tutarTRY).toLocaleString('tr-TR', {minimumFractionDigits:2})}) eşit olmalıdır! Lütfen tutarları eşitleyin.`);
                    return;
                }
                
                payload.YevmiyeSatirlari = yevmiyeSatirlariArray.map(s => {
                    return { Tipi: s.Tipi, Kod: s.Kod, Tutar: s.Tutar };
                });
            } 

            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Aktarılıyor...';
            btn.disabled = true;

            fetch('/Rapor105/AktarSap', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    aktarModal.hide();
                    
                    var statusCell = document.getElementById('status-' + islemId);
                    if(statusCell) {
                        var docStr = data.docNum ? data.docNum : "Yeni Kayıt";
                        if (isYevmiye) {
                            belgeTuruText = isKkeg ? "Yevmiye (KKEG)" : "Yevmiye Fişi";
                        }
                        
                        statusCell.innerHTML = '<span class="badge bg-success badge-modern mb-1"><i class="fas fa-check-circle me-1"></i> İşlendi</span>' + 
                                               '<small class="text-muted d-block" style="font-size: 0.70rem;">' + belgeTuruText + ': ' + docStr + '</small>';
                    }

                    // Butonu Kaldırıp İptal Butonu Ekleyelim Veya Direkt Sayfayı Yenileyelim (Daha Temiz Olur)
                    alert("Kayıt Başarıyla Aktarıldı! Belge No: " + (data.docNum ? data.docNum : ""));
                    location.reload(); 

                } else {
                    alert("HATA:\n" + data.message);
                }
            })
            .catch(error => {
                alert("Kritik Hata: İstek gönderilemedi.");
                console.error(error);
            })
            .finally(() => {
                btn.innerHTML = originalText;
                btn.disabled = false;
            });
        }
    </script>
}