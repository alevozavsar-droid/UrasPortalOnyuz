                      <option value="aciklama">Açıklama Kuru (Önerilen)</option>
                      <option value="sap">SAP Güncel Kuru</option>
                      <option value="manuel">Manuel Kur Gir</option>
                  </select>
              </div>
              <div class="col-md-6">
                  <label class="form-label fw-bold text-muted small">Uygulanacak Kur Çarpanı</label>
                  <input type="number" class="form-control modern-input fw-bold text-primary" id="inpUygulanacakKur" step="0.0001" onchange="manuelKurHesapla()" onkeyup="manuelKurHesapla()">
              </div>
              <input type="hidden" id="hdnAciklamaKuru">
              <input type="hidden" id="hdnSapKuru">
          </div>

          <div class="row">
              <div class="col-md-6 mb-3">
                  <label class="form-label fw-bold text-muted small">Belge Türü (SAP)</label>
                  <select class="form-select modern-input" id="selBelgeTuru" onchange="toggleBelgeTuru()">
                      <option value="24">Tahsilat (Gelen Ödeme)</option>
                      <option value="46">Yapılan Ödeme (Giden Ödeme)</option>
                      <option value="30">Yevmiye Kaydı</option>
                  </select>
              </div>
              <div class="col-md-6 mb-3">
                  <label class="form-label fw-bold text-muted small">SAP Banka Hesabı <span class="text-danger">*</span></label>
                  <select class="form-select modern-select2" id="selBankaHesabi" style="width: 100%;" onchange="calculateKkegPreview(); formValidationCheck();">
                      <option value="">-- Lütfen Hesap Seçiniz --</option>
                      @if (bankAccounts != null)
                      {
                          foreach (var acc in bankAccounts)
                          {
                              <option value="@acc.AcctCode">@acc.AcctCode - @acc.AcctName</option>
                          }
                      }
                  </select>
              </div>
          </div>

          <div id="divKkegWrapper" style="display:none;" class="mb-3">
              <div class="form-check form-switch p-3 bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded d-flex align-items-center gap-2">
                  <input class="form-check-input fs-4 m-0" type="checkbox" id="chkKkeg" onchange="toggleKkeg()">
                  <label class="form-check-label fw-bold text-danger m-0 pt-1" for="chkKkeg">Binek Araç Gider Kısıtlaması (%70 - %30 KKEG) Uygula</label>
              </div>
          </div>

          <!-- YALNIZCA TAHSİLAT (24) ve ÖDEME (46) İÇİN TEKLİ CARİ SEÇİMİ -->
          <div id="divStandartKarsiTaraf">
              <div class="mb-3 p-3 bg-light border rounded" id="divCariKodu">
                  <label class="form-label fw-bold text-muted small">Cari Kodu <span class="text-danger">*</span></label>
                  <select class="form-select modal-cari-select2" id="inpCariKodu" style="width: 100%;" onchange="formValidationCheck()"></select>
                  <div id="lblCariAdi" class="text-muted small mt-1"></div>
                  
                  <!-- VKN GÜNCELLEME CHECKBOX ALANI -->
                  <div id="divVknGuncelleme" class="mt-2 pt-2 border-top" style="display:none;">
                      <div class="form-check">
                          <input class="form-check-input" type="checkbox" id="chkUpdateVkn">
                          <label class="form-check-label small text-primary fw-bold" for="chkUpdateVkn" id="lblVknUpdateText">
                              Seçilen Carinin VKN/TCKN Bilgisini Güncelle
                          </label>
                      </div>
                      <small class="text-muted d-block" style="font-size:0.75rem;">
                          (Seçilirse; Cari kartında 10 haneli VKN 'Vergi Dairesi/No' alanına, 11 haneli TCKN ise 'TC Kimlik No' alanına güncellenir.)
                      </small>
                  </div>

              </div>
              <input type="hidden" id="selKarsiTipi" value="Cari" />
          </div>

          <!-- ÇOKLU YEVMİYE SATIRLARI (SADECE BELGE TÜRÜ 30 OLDUĞUNDA) -->
          <div id="divCokluYevmiye" style="display:none;" class="mb-3">
              <div class="p-3 bg-light border border-primary rounded">
                  <h6 class="fw-bold text-primary mb-3"><i class="fas fa-list-ol me-1"></i> Yevmiye Karşı Hesap/Cari Satırları (Tutar TRY Olarak Girilmelidir)</h6>
                  
                  <div class="row g-2 align-items-end mb-3">
                      <div class="col-md-3">
                          <label class="form-label small fw-bold text-muted">Tipi</label>
                          <select class="form-select modern-input py-1" id="selYevmiyeTipi" onchange="toggleYevmiyeTipi()" style="height: 38px;">
                              <option value="Cari">Cari Hesap</option>
                              <option value="Hesap">G/L Hesap</option>
                          </select>
                      </div>
                      <div class="col-md-5" id="divYevmiyeCari">
                          <label class="form-label small fw-bold text-muted">Cari Kodu</label>
                          <select class="form-select yevmiye-cari-select2" id="inpYevmiyeCari" style="width: 100%;"></select>
                      </div>
                      <div class="col-md-5" id="divYevmiyeHesap" style="display:none;">
                          <label class="form-label small fw-bold text-muted">G/L Hesap</label>
                          <select class="form-select modern-select2" id="inpYevmiyeHesap" style="width: 100%;">
                              <option value="">-- Lütfen Hesap Seçiniz --</option>
                              @if (allAccounts != null) { foreach (var acc in allAccounts) { <option value="@acc.AcctCode">@acc.AcctCode - @acc.AcctName</option> } }
                          </select>
                      </div>
                      <div class="col-md-2">
                          <label class="form-label small fw-bold text-muted">Tutar (TRY)</label>
                          <input type="number" class="form-control modern-input py-1" id="inpYevmiyeTutar" step="0.01" style="height: 38px;">
                      </div>
                      <div class="col-md-2">
                          <button type="button" class="btn btn-primary w-100" style="height: 38px;" onclick="addYevmiyeSatir()"><i class="fas fa-plus"></i> Ekle</button>
                      </div>
                  </div>
                  
                  <div class="table-responsive">
                      <table class="table table-sm table-bordered bg-white mb-0">
                          <thead class="table-secondary">
                              <tr>
                                  <th>Tip</th>
                                  <th>Hesap / Cari İsim</th>
                                  <th class="text-end">Tutar (TRY)</th>
                                  <th class="text-center" style="width: 50px;">Sil</th>
                              </tr>
                          </thead>
                          <tbody id="tbYevmiyeSatirlari">
                          </tbody>
                          <tfoot class="table-light">
                              <tr>
                                  <th colspan="2" class="text-end text-danger">Eklenen Toplam (TRY):</th>
                                  <th class="text-end text-danger fs-6" id="thYevmiyeToplam">0,00</th>
                                  <th></th>
                              </tr>
                          </tfoot>
                      </table>
                  </div>
              </div>
          </div>

          <div id="divKkegDetails" style="display:none;">
              <div class="p-3 bg-light border border-secondary rounded">
                  <div class="row g-2 mb-3">
                      <div class="col-md-12">
                          <label class="form-label small fw-bold text-primary">KDV Oranı</label>
                          <select id="selKdvRate" class="form-select modern-input" style="height: 38px; padding: 0.3rem 0.75rem;" onchange="kdvRateChanged()">
                              <option value="10">%10 (HGS / OGS / Konaklama vb.)</option>
                              <option value="20">%20 (Yakıt / Tamir / Bakım vb.)</option>
                              <option value="0">%0 (KDV'siz İşlemler)</option>
                          </select>
                      </div>
                      <div class="col-md-6 mb-2">
                          <label class="form-label small fw-bold text-muted">%70 Kabul Edilen Gider Hsp.</label>
                          <select id="selGider70" class="form-select modern-select2" style="width: 100%;" onchange="calculateKkegPreview()">
                              <option value="">Kod veya Ad ile arama yapın...</option>
                              @if (allAccounts != null) {
                                  foreach (var acc in allAccounts) {
                                      <option value="@acc.AcctCode">@acc.AcctCode - @acc.AcctName</option>
                                  }
                              }
                          </select>
                      </div>
                      <div class="col-md-6 mb-2">
                          <label class="form-label small fw-bold text-muted">%30 KKEG Gider Hsp.</label>
                          <select id="selKkeg30" class="form-select modern-select2" style="width: 100%;" onchange="calculateKkegPreview()">
                              <option value="">Kod veya Ad ile arama yapın...</option>
                              @if (allAccounts != null) {
                                  foreach (var acc in allAccounts) {
                                      <option value="@acc.AcctCode">@acc.AcctCode - @acc.AcctName</option>
                                  }
                              }
                          </select>
                      </div>
                      <div class="col-md-6">
                          <label class="form-label small fw-bold text-muted">%70 İndirilecek KDV Hsp.</label>
                          <select id="selKdv70" class="form-select modern-select2" style="width: 100%;" onchange="calculateKkegPreview()">
                              <option value="">Kod veya Ad ile arama yapın...</option>
                              @if (allAccounts != null) {
                                  foreach (var acc in allAccounts) {
                                      <option value="@acc.AcctCode">@acc.AcctCode - @acc.AcctName</option>
                                  }
                              }
                          </select>
                      </div>
                      <div class="col-md-6">
                          <label class="form-label small fw-bold text-muted">%30 KKEG KDV Hsp.</label>
                          <select id="selKdv30" class="form-select modern-select2" style="width: 100%;" onchange="calculateKkegPreview()">
                              <option value="">Kod veya Ad ile arama yapın...</option>
                              @if (allAccounts != null) {
                                  foreach (var acc in allAccounts) {
                                      <option value="@acc.AcctCode">@acc.AcctCode - @acc.AcctName</option>
                                  }
                              }
                          </select>
                      </div>
                  </div>

                  <hr class="my-3 text-secondary">
                  <h6 class="fw-bold text-dark mb-2"><i class="fas fa-eye me-1"></i> Yevmiye Fişi Önizlemesi (TRY)</h6>
                  <div class="table-responsive">
                      <table class="table table-sm table-bordered bg-white kkeg-table">
                          <thead class="table-secondary">
                              <tr class="text-center">
                                  <th style="width:25%">Hesap Kodu</th>
                                  <th style="width:45%">Açıklama (Hesap Adı)</th>
                                  <th style="width:15%">Borç (TRY)</th>
                                  <th style="width:15%">Alacak (TRY)</th>
                              </tr>
                          </thead>
                          <tbody id="kkegPreviewBody">
                              </tbody>
                      </table>
                  </div>
              </div>
          </div>

          <div class="mb-3 mt-3">
              <label class="form-label fw-bold text-muted small">İşlem Tipi (U_BE1_AKTAR)</label>
              <select class="form-select modern-input" id="selIslemTipi">
                  <option value="R" selected>R (Özel İşlem)</option>
                  <option value="X">X (Standart Aktarım)</option>
              </select>
          </div>

      </div>
      <div class="modal-footer bg-light border-0">
        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
        <button type="button" class="btn btn-success rounded-pill px-4" id="btnAktarOnayla" onclick="submitSapAktarim()" disabled>
            <i class="fas fa-check me-2"></i> SAP'ye Gönder
        </button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        var aktarModal;
        let yevmiyeSatirlariArray = []; 

        $(document).ready(function() {
            $('.modern-select2').select2({
                dropdownParent: $('#sapAktarModal'),
                placeholder: "Kod veya Ad ile arama yapın...",
                allowClear: true
            });

            // ---- Finekra hesabi -> SAP 102 hesabi eslestirme (kartlar) ----
            // Secim degisir degismez sunucuya yazilir (Z_FinekraHesapEslesme).
            // Hareket satirlarinda gecerli olmasi icin sayfa yenilenir.
            $('.eslesme-select2').select2({
                placeholder: "SAP 102 hesabı seçin...",
                allowClear: true,
                width: '100%'
            });

            $(document).on('change', '.eslesme-select2', function () {
                var sel = $(this);
                var alan = sel.closest('.eslesme-alani');
                var veri = new FormData();
                veri.append('finekraHesapId', alan.data('hesapId') || '');
                veri.append('iban', alan.data('iban') || '');
                veri.append('bankaAdi', alan.data('banka') || '');
                veri.append('hesapAdi', alan.data('hesapAd') || '');
                veri.append('sapHesapKodu', sel.val() || '');

                sel.prop('disabled', true);
                fetch('/Rapor105/HesapEslesmeKaydet', { method: 'POST', body: veri })
                    .then(function (r) { return r.json(); })
                    .then(function (c) {
                        sel.prop('disabled', false);
                        if (!c || !c.success) { toastr.error((c && c.message) || 'Eşleştirme kaydedilemedi.'); return; }
                        var durum = alan.find('.eslesme-durum');
                        var kart = alan.closest('.modern-card');
                        if (c.sapHesapKodu) {
                            durum.html('<span class="badge bg-success"><i class="fas fa-link me-1"></i>Eşleştirildi</span>');
                            kart.removeClass('border-warning').addClass('border-success');
                            toastr.success('Eşleştirme kaydedildi: ' + c.sapHesapKodu + '<br><small>Hareket satırlarına yansıması için sayfayı yenileyin.</small>');
                        } else {
                            durum.html('<span class="badge bg-warning text-dark"><i class="fas fa-unlink me-1"></i>Eşleştirilmedi</span>');
                            kart.removeClass('border-success').addClass('border-warning');
                            toastr.info('Eşleştirme kaldırıldı.');
                        }
                    })
                    .catch(function () { sel.prop('disabled', false); toastr.error('Sunucuya ulaşılamadı.'); });
            });

            // ---- Kombine filtre: banka + sadece eslesmeyen ----
            function finekraFiltreUygula() {
                var sadeceEslesmeyen = $('#btnSadeceEslesmeyen').hasClass('active');
                var secilenBanka = $('#bankaFiltresi').val() || '';
                $('table.modern-table tbody tr[data-banka-eslesme]').each(function () {
                    var $r = $(this);
                    var bankaUyar = !secilenBanka || String($r.data('banka')) === secilenBanka;
                    var eslesmeUyar = !sadeceEslesmeyen || $r.data('bankaEslesme') === 'yok';
                    $r.toggle(bankaUyar && eslesmeUyar);
                });
            }

            // ---- Sadece eslesmeyen hareketleri goster ----
            $('#btnSadeceEslesmeyen').on('click', function () {
                var aktif = $(this).toggleClass('active').hasClass('active');
                $(this).find('.metin').text(aktif ? 'Tümünü göster' : 'Sadece eşleşmeyenler');
                finekraFiltreUygula();
            });

            // ---- Banka filtresi ----
            $('#bankaFiltresi').on('change', finekraFiltreUygula);

            // Grid (Ana Tablo) Üzerindeki Cari Seçimi - Mükerrer Kontrolü İçin
            $('.grid-cari-select2').select2({
                placeholder: "Cari Seç / Değiştir...",
                allowClear: true,
                ajax: {
                    url: '/Rapor105/AraCari',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) { return { q: params.term }; },
                    processResults: function (data) { 
                        data.results.unshift({ id: 'DAHILI', text: 'DAHILI - Dahili İşlem (Banka Masrafı / Virman vb.)' });
                        return { results: data.results }; 
                    },
                    cache: true
                }
            }).on('change', function(e) {
                var selectEl = $(this);
                var cariKodu = selectEl.val();
                
                if(!cariKodu || cariKodu === "DAHILI") return; 

                var id = selectEl.data('id');
                var date = selectEl.data('date');
                var amount = selectEl.data('amount');
                var isGiris = selectEl.data('isgiris');
                
                var badgeContainer = $('#status-' + id);
                var originalHtml = badgeContainer.html();
                badgeContainer.html('<i class="fas fa-spinner fa-spin text-primary"></i> <small>Kontrol...</small>');

                $.get('/Rapor105/CheckDuplicate', {
                    finekraId: id,
                    cariKodu: cariKodu,
                    dateStr: date,
                    amount: amount,
                    isGiris: isGiris
                }).done(function(res) {
                    if(res.isProcessed) {
                        badgeContainer.html('<span class="badge bg-success badge-modern mb-1"><i class="fas fa-check-circle me-1"></i> İşlendi</span><small class="text-muted d-block" style="font-size: 0.70rem;">' + res.belgeTuru + ': ' + res.belgeNo + '</small>');
                        var btn = $('#btnAktar-' + id);
                        if(btn.length) btn.remove();
                        selectEl.prop('disabled', true);
                    } else {
                        badgeContainer.html(originalHtml);
                    }
                }).fail(function() {
                    badgeContainer.html(originalHtml);
                });
            });

            // Modal İçi Cari Seçimi
            $('.modal-cari-select2').select2({
                dropdownParent: $('#sapAktarModal'),
                placeholder: "Cari Kod veya Unvan ile arama yapın...",
                allowClear: true,
                ajax: {
                    url: '/Rapor105/AraCari',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) { return { q: params.term }; },
                    processResults: function (data) { return { results: data.results }; },
                    cache: true
                }
            });

            // Yevmiye içi Çoklu Cari Seçimi
            $('.yevmiye-cari-select2').select2({
                dropdownParent: $('#sapAktarModal'),
                placeholder: "Cari Kod / Unvan arayın...",
                allowClear: true,
                ajax: {
                    url: '/Rapor105/AraCari',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) { return { q: params.term }; },
                    processResults: function (data) { return { results: data.results }; },
                    cache: true
                }
            });

            aktarModal = new bootstrap.Modal(document.getElementById('sapAktarModal'), {
                keyboard: false
            });
        });

