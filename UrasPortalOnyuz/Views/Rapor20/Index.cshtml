                                title: isEnglishJS ? 'Attention! Open Transactions Found' : 'Dikkat! Açık İşlemler Var',
                                html: res.message,
                                icon: 'warning',
                                confirmButtonColor: '#dc3545',
                                confirmButtonText: `<i class="fas fa-times"></i> ${isEnglishJS ? 'I Understand' : 'Anladım'}`
                            });
                        } else {
                            Swal.close();
