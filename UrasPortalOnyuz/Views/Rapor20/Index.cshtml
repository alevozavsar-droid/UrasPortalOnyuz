        // "15.450,50" → "15450.50", "25,26" → "25.26", "1234.5" → "1234.5" (binlik nokta yalnızca virgülle birlikteyse silinir)
        function trSayiNormalle(s) {
            s = String(s || '').trim().replace(/\s/g, '');
            if (s.indexOf(',') >= 0 && s.indexOf('.') >= 0) s = s.replace(/\./g, '').replace(',', '.');
            else s = s.replace(',', '.');
            var n = parseFloat(s);
            return isNaN(n) ? '' : String(n);
        }

        function saveManualMutabakat() {
            var mDate = $('#txtMutabakatTarih').val();
            var mBakiye = $('#txtMutabakatBakiye').val();
            if (mBakiye !== "" && trSayiNormalle(mBakiye) === "") {
                Swal.fire(isEnglishJS ? 'Invalid amount' : 'Geçersiz tutar', isEnglishJS ? 'Enter a number like 15450,50.' : 'Tutarı 15.450,50 veya 15450,50 gibi yazın.', 'warning');
                return;
            }

            if (!mDate || mBakiye === "") {
                Swal.fire(isEnglishJS ? 'Missing Info' : 'Eksik Bilgi', isEnglishJS ? 'Date and Balance are required.' : 'Tarih ve Bakiye alanları zorunludur.', 'warning');
                return;
            }

            Swal.fire({ title: isEnglishJS ? 'Saving...' : 'Kaydediliyor...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

            $.ajax({
                url: '/Rapor20/SaveManualMutabakat' + dbQueryString,
                type: 'POST',
                headers: { 'RequestVerificationToken': antiForgeryToken },
                // Tutar Türkçe yazılır ("15.450,50" / "15450,50" / "25,26"), sunucuya kültürden bağımsız "15450.50" gider; sunucu InvariantCulture ile okur.
                data: { cardCode: currentBpCode, mutabakatTarihi: mDate, bakiye: trSayiNormalle(mBakiye), isConsolidated: isConsolidatedJS },
                success: function (res) {
                    if (res.success) {
                        Swal.fire(isEnglishJS ? 'Success' : 'Başarılı', res.message, 'success').then(() => {
                            location.reload(); 
                        });
                    } else {
                        Swal.fire(isEnglishJS ? 'Error' : 'Hata', res.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire(isEnglishJS ? 'Error' : 'Hata', isEnglishJS ? 'Server error while saving.' : 'Kaydetme işlemi sırasında sunucu hatası oluştu.', 'error');
                }
            });
        }

        /* MUTABAKAT YAP (RECONCILIATION) JS METOTLARI */
        function openReconModal() {
            if (!currentBpCode) {
                Swal.fire(isEnglishJS ? 'Warning' : 'Uyarı', isEnglishJS ? 'Please select a BP first.' : 'Lütfen önce bir cari hesap seçip raporlayın.', 'warning');
                return;
            }
            $('#divTransactions').hide();
            $('#divTransactions').empty();
            $('#currencyFilterContainer').empty().hide();
            calculateTotals();
            var reconModal = new bootstrap.Modal(document.getElementById('reconModal'));
            reconModal.show();

            loadOpenTransactions(); 
        }

        function formatMoney(amount) {
            return amount.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function filterByCurrency(currency, btnElement) {
            $('.currency-filter-btn').removeClass('btn-primary').addClass('btn-outline-primary');
            $(btnElement).removeClass('btn-outline-primary').addClass('btn-primary');

            if (currency === 'ALL') {
                $('.recon-row').show();
            } else {
                $('.recon-row').hide();
                $('.recon-row').filter(function() {
                    var mainCurr = $(this).data('currency');
                    var kfCurr = $(this).data('kfcurrency');
                    return mainCurr === currency || kfCurr === currency;
                }).show();
            }

            $('.recon-row:hidden .chk-row:checked').each(function() {
                $(this).prop('checked', false);
                var rawMaxAmount = parseFloat($(this).data('maxamount'));
                handleRowCheck(this, rawMaxAmount, true);
            });

            $('.chk-all-row').prop('checked', false);
            calculateTotals();
        }

        function loadOpenTransactions() {
            Swal.fire({ title: isEnglishJS ? 'Fetching Open Transactions...' : 'Açık İşlemler Çekiliyor...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
            
            let useBpDueDateVal = $('#useBpDueDate').is(':checked');
            var urlParams = dbQueryString ? dbQueryString + '&isConsolidated=' + isConsolidatedJS : '?isConsolidated=' + isConsolidatedJS;
            urlParams += '&useBpDueDate=' + useBpDueDateVal;

            $.ajax({
                url: '/Rapor20/GetOpenTransactions' + urlParams,
                type: 'GET',
                data: { cardCode: currentBpCode },
                success: function (res) {
                    Swal.close();
                    if (res.success) {
                        renderReconTable(res.data);
                    } else { Swal.fire(isEnglishJS ? 'Error' : 'Hata', res.message, 'error'); }
                },
                error: function () { Swal.fire(isEnglishJS ? 'Error' : 'Hata', isEnglishJS ? 'Connection Error.' : 'Bağlantı hatası.', 'error'); }
            });
        }

        function renderReconTable(data) {
            var container = $('#divTransactions');
            container.empty();
            $('#currencyFilterContainer').empty().hide();

            if (data.length === 0) {
                container.html('<div class="alert alert-success text-center py-4 fw-bold"><i class="fas fa-check-circle fa-2x d-block mb-2"></i> ' + (isEnglishJS ? 'Balance is perfectly clear! No open transactions to reconcile.' : 'Bakiye tamamen temiz! Kapatılacak açık işlem yok.') + '</div>');
                container.fadeIn();
                calculateTotals(); 
                return;
            }

            var uniqueCurrencies = new Set();
            data.forEach(function(item) {
                if (item.paraBirimi) uniqueCurrencies.add(item.paraBirimi);
                if (item.kurFarkiParaBirimi) uniqueCurrencies.add(item.kurFarkiParaBirimi);
            });

            var currencyList = Array.from(uniqueCurrencies).filter(c => c && c.trim() !== '');

            if (currencyList.length > 0) {
                var filterHtml = `<button class="btn btn-sm btn-primary currency-filter-btn" data-currency="ALL" onclick="filterByCurrency('ALL', this)"><i class="fas fa-filter"></i> ${isEnglishJS ? 'All' : 'Tümü'}</button>`;
                currencyList.forEach(function(curr) {
                    filterHtml += `<button class="btn btn-sm btn-outline-primary currency-filter-btn" data-currency="${curr}" onclick="filterByCurrency('${curr}', this)">${curr}</button>`;
                });
                $('#currencyFilterContainer').html(filterHtml).show();
            }

            var groupedData = {};
            data.forEach(function(item) {
                var db = item.dbName || '@currentDb';
                if (!groupedData[db]) {
                    groupedData[db] = { companyName: item.companyName || db, items: [] };
                }
                groupedData[db].items.push(item);
            });

            var tabsHtml = '<ul class="nav nav-pills mb-3 mt-2" id="companyReconTabs" role="tablist">';
            var contentHtml = '<div class="tab-content" id="companyReconTabsContent">';

            var isFirst = true;
            for (var db in groupedData) {
                var comp = groupedData[db];
                var activeClass = isFirst ? 'active' : '';
                
                tabsHtml += `
                    <li class="nav-item" role="presentation">
                        <button class="nav-link ${activeClass} fw-bold shadow-sm" id="tab-${db}" data-bs-toggle="pill" data-bs-target="#pane-${db}" type="button" role="tab" data-dbname="${db}">
                            <i class="fas fa-building me-1"></i> ${comp.companyName}
                            <span class="badge bg-danger ms-2">${comp.items.length}</span>
                        </button>
                    </li>
                `;

                contentHtml += `
                    <div class="tab-pane fade ${isFirst ? 'show active' : ''}" id="pane-${db}" role="tabpanel">
                        <div class="table-responsive bg-white border rounded shadow-sm" style="max-height: 500px; overflow-y: auto;">
                            <table class="table table-hover rapor-tablo" id="tbl-${db}">
                                <thead>
                                    <tr>
                                        <th class="text-center" style="width: 50px;">
                                            <div class="form-check d-flex justify-content-center mb-0">
                                                <input class="form-check-input chk-all-row bg-warning border-0" type="checkbox" onchange="toggleSelectAll(this, '${db}')" title="${isEnglishJS ? 'Select All' : 'Tümünü Seç'}">
                                            </div>
                                        </th>
                                        <th>${isEnglishJS ? 'Post Date' : 'Kayıt T.'}</th>
                                        <th>${isEnglishJS ? 'Due Date' : 'Vade T.'}</th>
                                        <th>${isEnglishJS ? 'Doc/Line' : 'Yevm/Satır'}</th>
                                        <th>${isEnglishJS ? 'Type' : 'İşlem Tipi'}</th>
                                        <th>${isEnglishJS ? 'Currency' : 'Para Birimi'}</th>
                                        <th>${isEnglishJS ? 'Diff. Curr' : 'Kur Farkı Para Birimi'}</th>
                                        <th class="text-right">${isEnglishJS ? 'FC Debit' : 'Dövizli Borç'}</th>
                                        <th class="text-right">${isEnglishJS ? 'FC Credit' : 'Dövizli Alacak'}</th>
                                        <th class="text-right">${isEnglishJS ? 'Open Debit (TL)' : 'Açık Borç (TL)'}</th>
                                        <th class="text-right">${isEnglishJS ? 'Open Credit (TL)' : 'Açık Alacak (TL)'}</th>
                                        <th>${isEnglishJS ? 'Remarks' : 'Açıklama'}</th>
                                        <th class="text-end pe-3">${isEnglishJS ? 'Amount to Recon' : 'Kapatılacak Tutar'}</th>
                                    </tr>
                                </thead>
                                <tbody id="tbody-${db}">
                `;

                comp.items.forEach(function(item) {
                    var isDebit = item.openDebit > 0;
                    var maxAmount = isDebit ? item.openDebit : item.openCredit;
                    var rawMaxAmount = parseFloat(maxAmount).toFixed(2);
                    
                    var formattedDebit = isDebit ? formatMoney(item.openDebit) : '-';
                    var formattedCredit = !isDebit ? formatMoney(item.openCredit) : '-';
                    var fcDebit = isDebit && item.dovizliBorc > 0 ? formatMoney(item.dovizliBorc) : '-';
                    var fcCredit = !isDebit && item.dovizliAlacak > 0 ? formatMoney(item.dovizliAlacak) : '-';
                    
                    var pBirim = item.paraBirimi || 'TRY';
                    var kfBirim = item.kurFarkiParaBirimi || '';

                    var isEnglishVal = isEnglishJS;
                    var kfTitle = isEnglishVal ? 'Diff Currency' : 'Kur Farkı Cinsi';

                    var kfBadge = (kfBirim && kfBirim !== '') 
                        ? `<span class="badge bg-success" title="${kfTitle}"><i class="fas fa-coins me-1"></i>KF: ${kfBirim}</span>` 
                        : '<span class="text-muted">-</span>';

                    contentHtml += `
                        <tr class="recon-row" data-transid="${item.transId}" data-lineid="${item.lineId}" data-isdebit="${isDebit}" data-currency="${pBirim}" data-kfcurrency="${kfBirim}">
                            <td class="text-center">
                                <input type="checkbox" class="chk-row" data-maxamount="${rawMaxAmount}" onchange="handleRowCheck(this, ${rawMaxAmount})">
                            </td>
                            <td>${item.docDate}</td>
                            <td>${item.dueDate}</td>
                            <td><span class="fw-bold text-primary">${item.transId}</span><span class="text-muted small">/${item.lineId}</span></td>
                            <td><span class="badge border border-primary text-primary">${item.islemTipi || '-'}</span></td>
                            <td><span class="badge bg-dark">${pBirim}</span></td>
                            <td class="text-center">${kfBadge}</td>
                            <td class="text-right text-primary">${fcDebit}</td>
                            <td class="text-right text-primary">${fcCredit}</td>
                            <td class="text-right text-danger fw-bold">${formattedDebit}</td>
                            <td class="text-right text-success fw-bold">${formattedCredit}</td>
                            <td title="${item.memo}" class="text-truncate" style="max-width:200px;">${item.memo}</td>
                            <td class="text-end pe-3">
                                <input type="number" class="amount-input ms-auto" value="0.00" max="${rawMaxAmount}" min="0" step="0.01" disabled onkeyup="validateInput(this); calculateTotals()" onchange="validateInput(this); calculateTotals()">
                            </td>
                        </tr>
                    `;
                });

                contentHtml += `</tbody></table></div></div>`;
                if (isFirst) { currentTargetDb = db; isFirst = false; }
            }

            tabsHtml += '</ul>';
            contentHtml += '</div>';

            container.html(tabsHtml + contentHtml);

            $('button[data-bs-toggle="pill"]').on('shown.bs.tab', function (e) {
                currentTargetDb = $(e.target).data('dbname');
                $('#currencyFilterContainer button[data-currency="ALL"]').click();
                calculateTotals();
            });

            container.fadeIn();
            calculateTotals();
        }

        function toggleSelectAll(chkAllElem, dbName) {
            var isChecked = $(chkAllElem).is(':checked');
            $(`#tbody-${dbName} .recon-row:visible .chk-row`).each(function() {
                if ($(this).is(':checked') !== isChecked) {
                    $(this).prop('checked', isChecked);
                    var rawMaxAmount = parseFloat($(this).data('maxamount'));
                    handleRowCheck(this, rawMaxAmount, true);
                }
            });
            calculateTotals(); 
        }

        function validateInput(input) {
            var val = parseFloat($(input).val()) || 0;
            var max = parseFloat($(input).attr('max')) || 0;
            if (val > max) { $(input).val(max.toFixed(2)); } 
            else if (val < 0) { $(input).val("0.00"); }
        }

        function handleRowCheck(checkbox, maxAmount, skipCalc = false) {
            var row = $(checkbox).closest('tr');
            var input = row.find('.amount-input');
            if ($(checkbox).is(':checked')) {
                row.addClass('table-primary');
                input.prop('disabled', false).val(parseFloat(maxAmount).toFixed(2));
            } else {
                row.removeClass('table-primary');
                input.prop('disabled', true).val("0.00");
            }
            if(!skipCalc) calculateTotals();
        }

        function calculateTotals() {
            var totalDebit = 0.0, totalCredit = 0.0;
            $(`#tbody-${currentTargetDb} .chk-row:checked`).each(function () {
                var row = $(this).closest('tr');
                var isDebit = row.data('isdebit');
                var val = parseFloat(row.find('.amount-input').val()) || 0;
                if (isDebit) totalDebit += val; else totalCredit += val;
            });

            var diff = Math.round(Math.abs(totalDebit - totalCredit) * 100) / 100; 
            $('#lblTotalDebit').text(formatMoney(totalDebit) + ' ₺');
            $('#lblTotalCredit').text(formatMoney(totalCredit) + ' ₺');
            $('#lblDifference').text(formatMoney(diff) + ' ₺');

            if (totalDebit > 0 && totalCredit > 0 && diff === 0) {
                $('#lblDifference').removeClass('text-danger').addClass('text-success');
                $('#btnReconcile').prop('disabled', false).removeClass('btn-secondary').addClass('btn-success').css('background-color', '#198754');
            } else {
                $('#lblDifference').removeClass('text-success').addClass('text-danger');
                $('#btnReconcile').prop('disabled', true).removeClass('btn-success').addClass('btn-secondary').css('background-color', '');
            }
        }

        function startRobotPolling(matchedCardCode, dbName) {
            Swal.fire({
                title: isEnglishJS ? 'SAP UI Robot in Progress' : 'SAP UI Robot İşlemde',
                html: `
                    <p class="text-muted small">${isEnglishJS ? 'Running reconciliations in background. Please do not close the tab...' : 'Arka planda kapanışlar yapılıyor. Lütfen sekmeyi kapatmayın...'}</p>
                    <div id="robotStatusText" class="alert alert-warning fw-bold mt-2 border-warning">${isEnglishJS ? 'Waiting in queue...' : 'Robot sırası bekleniyor...'}</div>
                `,
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => { Swal.showLoading(); }
            });

            if(robotInterval) clearInterval(robotInterval);
            
            robotInterval = setInterval(() => {
                $.ajax({
                    url: '/Rapor20/GetRobotCheckStatus',
                    type: 'GET',
                    data: { matchedCardCode: matchedCardCode, dbName: dbName },
                    success: function(res) {
                        if (res.success) {
                            $('#robotStatusText').html(res.statusMessage);
                            
                            if (res.isFinished) {
                                clearInterval(robotInterval);
                                Swal.fire(isEnglishJS ? 'Completed' : 'İşlem Tamamlandı', res.statusMessage, 'success').then(() => {
                                    loadOpenTransactions();
                                });
                            }
                        }
                    }
                });
            }, 3000);
        }

        function performManualReconciliation() {
            var lines = [];
            $(`#tbody-${currentTargetDb} .chk-row:checked`).each(function () {
                var row = $(this).closest('tr');
                var amt = parseFloat(row.find('.amount-input').val()) || 0;
                if (amt > 0) { lines.push({ TransId: parseInt(row.data('transid')), LineId: parseInt(row.data('lineid')), ReconcileAmount: amt }); }
            });

            let useBpDueDateVal = $('#useBpDueDate').is(':checked');

            Swal.fire({
                title: isEnglishJS ? 'Reconciliation Confirm' : 'Mutabakat Onayı', 
                html: isEnglishJS ? `Selected transactions will be reconciled in <b class='text-danger'>${currentTargetDb}</b> company. Confirm?` : `Seçilen işlemler <b class='text-danger'>${currentTargetDb}</b> şirketinde kapatılacaktır. Onaylıyor musunuz?`, 
                icon: 'warning', showCancelButton: true, confirmButtonColor: '#198754', 
                confirmButtonText: isEnglishJS ? 'Yes, Reconcile' : 'Evet, Kapat',
                cancelButtonText: isEnglishJS ? 'Cancel' : 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: isEnglishJS ? 'Processing...' : 'İşleniyor...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                    
                    $.ajax({
                        url: '/Rapor20/PerformReconciliation' + dbQueryString, 
                        type: 'POST', contentType: 'application/json', headers: { 'RequestVerificationToken': antiForgeryToken },
                        data: JSON.stringify({ CardCode: currentBpCode, TargetDbName: currentTargetDb, Lines: lines, UseBpDueDate: useBpDueDateVal }),
                        success: function (res) {
                            if (res.success) { 
                                if(res.isRobotPending) {
                                    startRobotPolling(res.matchedCardCode, currentTargetDb);
                                } else {
                                    Swal.fire(isEnglishJS ? 'Success' : 'Başarılı', res.message, 'success').then(() => { loadOpenTransactions(); }); 
                                }
                            } 
                            else { Swal.fire({ title: isEnglishJS ? 'Error' : 'Hata', html: res.message, icon: 'error' }); }
                        },
                        error: function (xhr) { 
                            let errMsg = isEnglishJS ? "Unknown Error" : "Bilinmeyen Hata";
                            if(xhr.status === 400) errMsg = isEnglishJS ? "Bad Request (400)." : "Parametre eşleşmedi (400 Bad Request).";
                            if(xhr.status === 404) errMsg = isEnglishJS ? "Not Found (404)." : "Metod bulunamadı (404 Not Found).";
                            if(xhr.status === 500) errMsg = isEnglishJS ? "Internal Server Error (500)." : "C# tarafında kod çöktü (500 Internal Error).";
                            Swal.fire((isEnglishJS ? 'Server Error (Code: ' : 'Sunucu Hatası (Kod: ') + xhr.status + ')', errMsg + '<br><br><span style="font-size:12px;color:red;">Detay: ' + (xhr.responseText ? xhr.responseText.substring(0, 150) : '') + '</span>', 'error'); 
                        }
                    });
                }
            });
        }
        
        function triggerAutoReconciliation() {
            let useBpDueDateVal = $('#useBpDueDate').is(':checked');

            Swal.fire({
                title: isEnglishJS ? 'Auto Reconcile' : 'Otomatik Kapatma',
                html: isEnglishJS ? `All open transactions in <b>(${currentTargetDb})</b> will be analyzed and matching balances will be reconciled.<br><br>Do you confirm?` : `Seçili carideki <b>(${currentTargetDb})</b> tüm açık işlemler analiz edilecek ve eşleşen bakiyeler kapatılacaktır.<br><br>Onaylıyor musunuz?`,
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: '#2575fc',
                cancelButtonColor: '#d33',
                confirmButtonText: isEnglishJS ? '<i class="fas fa-play"></i> Yes, Start' : '<i class="fas fa-play"></i> Evet, Başlat',
                cancelButtonText: isEnglishJS ? 'Cancel' : 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    let progressInterval;
                    
                    Swal.fire({ 
                        title: isEnglishJS ? 'Reconciling Transactions' : 'İşlemler Kapatılıyor', 
                        html: `
                            <div id="autoReconProgressContainer" class="p-3 text-start bg-light border rounded shadow-sm" style="min-height: 100px;">
                                <div class="text-center text-muted"><i class="fas fa-spinner fa-spin fa-2x mb-2"></i><br>${isEnglishJS ? 'System preparing...' : 'Sistem hazırlanıyor...'}</div>
                            </div>
                        `,
                        allowOutsideClick: false, 
                        showConfirmButton: false,
                        didOpen: () => { 
                            progressInterval = setInterval(() => {
                                $.get('/Rapor20/GetAutoReconcileProgress' + dbQueryString + '&cardCode=' + currentBpCode + '&targetDbName=' + currentTargetDb, function(res) {
                                    if(res && res.success && res.message) {
                                        $('#autoReconProgressContainer').html(res.message);
                                    }
                                });
                            }, 800);
                        },
                        willClose: () => { clearInterval(progressInterval); }
                    });

                    $.ajax({
                        url: '/Rapor20/AutoReconcile' + dbQueryString,
                        type: 'POST',
                        headers: { 'RequestVerificationToken': antiForgeryToken },
                        data: { cardCode: currentBpCode, targetDbName: currentTargetDb, useBpDueDate: useBpDueDateVal },
                        success: function (res) {
                            if (res.success) {
                                if(res.isRobotPending) {
                                    startRobotPolling(res.matchedCardCode, currentTargetDb);
                                } else {
                                    Swal.fire(isEnglishJS ? 'Successfully Completed' : 'İşlem Kusursuz Tamamlandı', res.message, 'success').then(() => { loadOpenTransactions(); });
                                }
                            } else {
                                Swal.fire({ title: isEnglishJS ? 'Result Report' : 'İşlem Sonucu Raporu', html: res.message, icon: 'warning', width: 700 }).then(() => { loadOpenTransactions(); });
                            }
                        },
                        error: function (xhr) {
                            let errMsg = isEnglishJS ? "Unknown Error" : "Bilinmeyen Hata";
                            if(xhr.status === 400) errMsg = isEnglishJS ? "Parameter Error." : "Parametre hatası.";
                            if(xhr.status === 500) errMsg = isEnglishJS ? "Internal Server Error." : "C# tarafında kod çöktü.";
                            Swal.fire((isEnglishJS ? 'Server Error (Code: ' : 'Sunucu Hatası (Kod: ') + xhr.status + ')', errMsg + '<br><br><span style="font-size:12px;color:red;">Detay: ' + (xhr.responseText ? xhr.responseText.substring(0, 150) : '') + '</span>', 'error');
                        }
                    });
                }
            });
        }
        
        function triggerCancelAllReconciliations() {
            Swal.fire({
                title: isEnglishJS ? 'Bulk Cancel Confirm' : 'Toplu İptal Onayı',
                html: isEnglishJS ? `All internal reconciliations for BP <b>(${currentBpCode})</b> in <b class="text-danger">${currentTargetDb}</b> will be canceled via Service Layer.<br><br>This action cannot be undone. Confirm?` : `Seçili cariye <b>(${currentBpCode})</b> ait <b class="text-danger">${currentTargetDb}</b> şirketindeki tüm açık ve geçerli iç mutabakatlar Service Layer üzerinden iptal edilecektir.<br><br>Bu işlemi geri alamazsınız. Onaylıyor musunuz?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: isEnglishJS ? '<i class="fas fa-undo"></i> Yes, Cancel All' : '<i class="fas fa-undo"></i> Evet, Tümünü İptal Et',
                cancelButtonText: isEnglishJS ? 'Cancel' : 'Vazgeç'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: isEnglishJS ? 'Canceling...' : 'İptal İşlemi Sürüyor...',
                        text: isEnglishJS ? 'Communicating with Service Layer, this might take a moment...' : 'Service Layer ile iletişim kuruluyor, bu işlem mutabakat sayısına göre biraz sürebilir...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    $.ajax({
                        url: '/Rapor20/CancelReconciliations' + dbQueryString,
                        type: 'POST',
                        headers: { 'RequestVerificationToken': antiForgeryToken },
                        data: { cardCode: currentBpCode, targetDbName: currentTargetDb },
                        success: function (res) {
                            if (res.success) {
                                if(res.hasError) {
                                    Swal.fire({ title: isEnglishJS ? 'Partial Success / Errors' : 'Kısmi Başarı / İptal Edilemeyenler', html: res.message, icon: 'warning', width: 700 }).then(() => { loadOpenTransactions(); });
                                } else {
                                    Swal.fire(isEnglishJS ? 'Completely Canceled' : 'Tamamen İptal Edildi', res.message, 'success').then(() => { loadOpenTransactions(); });
                                }
                            } else {
                                Swal.fire(isEnglishJS ? 'Error' : 'Hata', res.message, 'error');
                            }
                        },
                        error: function (xhr) {
                            let errMsg = isEnglishJS ? "Unknown Error" : "Bilinmeyen Hata";
                            if(xhr.status === 400) errMsg = isEnglishJS ? "Parameter Error." : "Parametre hatası (400).";
                            if(xhr.status === 500) errMsg = isEnglishJS ? "Internal Server Error." : "C# tarafında kod çöktü (500).";
                            Swal.fire((isEnglishJS ? 'Server Error (Code: ' : 'Sunucu Hatası (Kod: ') + xhr.status + ')', errMsg + '<br><br><span style="font-size:12px;color:red;">Detay: ' + (xhr.responseText ? xhr.responseText.substring(0, 150) : '') + '</span>', 'error');
                        }
                    });
                }
            });
        }
    </script>
}