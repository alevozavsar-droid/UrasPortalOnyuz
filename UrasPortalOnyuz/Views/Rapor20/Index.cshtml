        tr { background-color: white; }
        tr:hover { background-color: #e9ecef; }
        .text-right { text-align: right !important; }
        .text-center { text-align: center !important; }
        .borc { color: #dc3545; font-weight: bold; }
        .alacak { color: #198754; font-weight: bold; }
        .btn-action-custom { border: none; padding: 8px 15px; border-radius: 50px; font-weight: bold; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); transition: all 0.3s; }
        .btn-action-custom:hover { transform: translateY(-2px); box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15); }
        .btn-download { background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%); color: white; }
        .btn-download-landscape { background-image: linear-gradient(135deg, #ffc107 0%, #ff9800 100%); color: #343a40; }
        .btn-download-excel { background-image: linear-gradient(135deg, #28a745 0%, #218838 100%); color: white; }
        .btn-download-form { background-image: linear-gradient(135deg, #e53935 0%, #b71c1c 100%); color: white; border: none; }
        .btn-recon { background-image: linear-gradient(135deg, #17a2b8 0%, #117a8b 100%); color: white; }
        .btn-save-recon { background-image: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%); color: white; }
        .cari-bilgi { background-color: #f8f9fa; padding: 15px; border-radius: 5px; border-left: 4px solid #6a11cb; width: 100%; }
        .logo { font-size: 24px; font-weight: bold; color: #6a11cb; }
        .at-row td { background-color: #e0f7fa !important; font-weight: bold !important; }
        .db-row td { background-color: #e9ecef !important; font-weight: bold !important; }
        .order-row td { background-color: #fff8e1 !important; color: #5c3a21; font-style: italic; border-left: 3px solid #ffc107; }
        .bp-group-header { background-color: #6a11cb; color: white; padding: 10px; border-radius: 5px 5px 0 0; margin: 20px 0 0 0; font-size: 1.1rem; }
        .bp-contact-info { background-color: #f1f3f5; border: 1px solid #dee2e6; border-top: none; border-radius: 0 0 5px 5px; padding: 10px 15px; margin-bottom: 10px; font-size: 0.9rem; color: #495057; }
        .selectable-text { user-select: all; cursor: pointer; padding: 2px 4px; border-radius: 3px; transition: background-color 0.2s; }
        .selectable-text:hover { background-color: #e2e6ea; }
        .btn-copy { border: 1px solid #ced4da; background-color: white; color: #6c757d; padding: 2px 8px; border-radius: 4px; font-size: 0.8rem; transition: all 0.2s; }
        .btn-copy:hover { background-color: #6a11cb; color: white; border-color: #6a11cb; }
        .account-balance-table th { background-color: #dc3545; color: white; }
        .modal-xxl { max-width: 95vw; }
        .amount-input { width: 120px; font-weight: bold; text-align: right; border-radius: 6px; border: 1px solid #ced4da; padding: 5px 10px; }
        .amount-input:disabled { background-color: #e9ecef; color: #6c757d; }
        .amount-input:focus { border-color: #6a11cb; box-shadow: 0 0 0 0.2rem rgba(106, 17, 203, 0.25); outline: none; }
        .chk-row { transform: scale(1.4); cursor: pointer; accent-color: #6a11cb; }
        .summary-box { background-color: #f8f9fa; border: 1px solid #dee2e6; padding: 10px 15px; border-radius: 8px; min-width: 160px; }
        .note-bubble { background-color: #e3f2fd; border-radius: 12px; padding: 15px; margin-bottom: 12px; position: relative; border-left: 5px solid #0dcaf0; }
        .note-bubble.task-pending { background-color: #fff3cd; border-left-color: #ffc107; }
        .note-bubble.task-done { background-color: #d1e7dd; border-left-color: #198754; opacity: 0.85; }
        .note-meta { font-size: 0.85rem; color: #6c757d; margin-bottom: 8px; border-bottom: 1px solid #dee2e6; padding-bottom: 6px; }
        .nav-pills .nav-link.active { background-color: #6a11cb; color: white; border-radius: 6px; }
        .nav-pills .nav-link { color: #495057; border-radius: 6px; margin-right: 5px; background-color: #e9ecef; }

        /* ==================================================================
           MODERN GÖRÜNÜM KATMANI
           Portalın yeni tasarım diline uyum + tam sayfa sığdırma.
           ================================================================== */
        body { font-family: 'Inter', 'Segoe UI', Tahoma, sans-serif; background-color: var(--bg-main, #f4f6fb); }

        .container-fluid { padding-left: 0 !important; padding-right: 0 !important; }

        .header {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 55%, #0f172a 100%);
            border-radius: 18px; padding: 18px 22px; margin-bottom: 16px;
            box-shadow: var(--shadow-md, 0 10px 30px rgba(15,23,42,.10));
            position: relative; overflow: hidden;
        }
        .header::after {
            content: ""; position: absolute; inset: 0; pointer-events: none;
            background: radial-gradient(520px 240px at 6% -30%, rgba(0,158,247,.42), transparent 62%),
                        radial-gradient(420px 240px at 98% 130%, rgba(99,102,241,.36), transparent 60%);
        }
        .header > * { position: relative; z-index: 1; }
        .logo { color: #fff; }

        .database-info {
            background: var(--bg-card, #fff); border: 1px solid var(--border-color, #e8ecf4);
            border-left: 4px solid var(--metro-primary, #009ef7);
            border-radius: 12px; padding: 10px 14px; margin-bottom: 14px;
            box-shadow: var(--shadow-sm);
        }

        .card { border-radius: 18px !important; border: 1px solid var(--border-color, #e8ecf4) !important; }

        .secim-ipucu { font-size: .72rem; color: var(--text-secondary, #64748b); margin-top: 5px; font-weight: 600; }
        .badge-secim {
            background: linear-gradient(135deg,#009ef7,#6366f1); color: #fff;
            padding: .2rem .6rem; border-radius: 999px; font-size: .7rem; font-weight: 700;
        }

        /* ---------- Tabloyu tam sayfaya sığdır ----------
           Not: .table-container sınıfı layout'ta gövdeyi saran dış kutuda da
           kullanılıyor. Yükseklik sınırı yalnızca rapor tablosunun kendi kutusuna
           uygulanmalı, yoksa tüm sayfa iki kez kaydırılabilir hâle geliyor. */
        .main-content > .table-container {
            max-height: none !important;
            overflow: visible !important;
        }

        .table-container {
            padding: 0; border-radius: 16px; margin-top: 12px;
            border: 1px solid var(--border-color, #e8ecf4);
            box-shadow: var(--shadow-sm);
            overflow: visible;          /* kendi scroll'u yok; sayfa ile birlikte kayar */
        }

        table.rapor-tablo { font-size: 0.655rem; }

        table.rapor-tablo th,
        table.rapor-tablo td { padding: 3px 5px !important; border-color: #eef2f7 !important; }

        /* Başlık satırı sayfa kaydıkça üst barın altına yapışır */
        table.rapor-tablo th {
            background: #0f172a !important;
            color: #fff !important;
            font-size: .58rem; font-weight: 700;
            letter-spacing: .03em; text-transform: uppercase;
            line-height: 1.25;
            white-space: normal;          /* başlık iki satıra inebilsin */
            overflow-wrap: anywhere;
            vertical-align: bottom;
            position: sticky; top: var(--header-height, 72px); z-index: 12;
            border-color: #1e293b !important;
        }

        table.rapor-tablo tbody tr:nth-child(even) td { background-color: #fbfcfe; }
        table.rapor-tablo tbody tr:hover td { background-color: #eef7ff !important; }


        .bp-group-header {
            background: linear-gradient(135deg,#009ef7,#6366f1);
            border-radius: 12px 12px 0 0; font-size: .92rem; font-weight: 700;
            padding: 9px 14px; margin: 14px 0 0 0;
        }
        .bp-contact-info { border-radius: 0 0 12px 12px; font-size: .78rem; padding: 8px 14px; }

        .account-balance-table th { background-color: #0f172a !important; }

        .btn-action-custom { padding: .5rem 1rem; font-size: .82rem; border-radius: 10px; }
        .btn-download { background: linear-gradient(135deg,#009ef7,#6366f1); }

        .summary-box { border-radius: 12px; border-color: var(--border-color, #e8ecf4); }

        @@media (min-width: 1600px) {
            table.rapor-tablo { font-size: 0.70rem; }
            table.rapor-tablo th { font-size: .61rem; }
        }
        @@media (max-width: 1440px) {
            table.rapor-tablo { font-size: 0.62rem; }
            table.rapor-tablo th,
            table.rapor-tablo td { padding: 2px 4px !important; }
        }

        /* ==================================================================
           FİLTRE ALANI - hizalı ve modern
           Bootstrap kolon genişlikleri yerine eşit paylaşan bir ızgara
           kullanılıyor; böylece bütün alanlar aynı yükseklik ve hizada.
           ================================================================== */
        form .row.g-3.align-items-end {
            display: grid !important;
            grid-template-columns: repeat(auto-fit, minmax(215px, 1fr));
            gap: 12px !important;
            align-items: end;
            margin: 0 !important;
        }
        form .row.g-3.align-items-end > [class*="col-"] {
            width: auto !important; max-width: none !important;
            flex: none !important; padding: 0 !important;
            display: flex; flex-direction: column;
        }
        form .row.g-3.align-items-end .form-label {
            font-size: .68rem !important; font-weight: 800 !important;
            letter-spacing: .06em; text-transform: uppercase;
            color: var(--text-secondary, #64748b) !important; margin-bottom: 5px;
        }

        /* Tüm giriş alanları aynı yükseklikte */
        form .form-control,
        form .select2-container--bootstrap-5 .select2-selection {
            min-height: 40px !important; height: 40px !important;
            border-radius: 10px !important;
            border: 1px solid var(--border-color, #e8ecf4) !important;
            font-size: .85rem;
        }
        form .select2-container--bootstrap-5 .select2-selection--multiple {
            padding: 0 10px !important; display: flex !important; align-items: center !important;
            overflow: hidden;
        }
        form .form-control:focus,
        form .select2-container--bootstrap-5.select2-container--focus .select2-selection {
            border-color: var(--metro-primary, #009ef7) !important;
            box-shadow: 0 0 0 3px rgba(0,158,247,.18) !important;
        }

        /* Seçilenler tek tek listelenmesin; yerine "N seçildi" özeti */
        .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__rendered {
            display: flex !important; align-items: center; flex-wrap: nowrap !important;
            padding: 0 !important; margin: 0 !important; overflow: hidden;
        }
        .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice {
            display: none !important;
        }
        .select2-container--bootstrap-5 .select2-selection--multiple .select2-search--inline {
            flex: 1; min-width: 40px;
        }
        .secim-ozet-li { list-style: none; margin: 0 6px 0 0; display: flex; align-items: center; }
        .secim-ozet {
            background: linear-gradient(135deg,#009ef7,#6366f1); color: #fff;
            font-size: .72rem; font-weight: 700; white-space: nowrap;
            padding: .22rem .65rem; border-radius: 999px;
        }

        /* Yukaridaki "tek tek listeleme" gizlemesi SADECE filtre alanlari
           icindir. Cari Notlari penceresindeki mail alanlarinda kullanicinin
           kimi sectigini gormesi gerekir; orada etiketler geri acilir. */
        #notesModal .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__rendered {
            display: flex !important;
            flex-wrap: wrap !important;
            overflow: visible;
            padding: .2rem .3rem !important;
            gap: 4px;
        }
        #notesModal .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice {
            display: inline-flex !important;
            align-items: center;
            background: #eef2ff;
            border: 1px solid #c7d2fe;
            color: #3730a3;
            border-radius: 999px;
            padding: .12rem .5rem;
            font-size: .74rem;
            font-weight: 600;
            max-width: 100%;
        }
        #notesModal .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice__remove {
            color: #4338ca;
            margin-right: 4px;
            font-weight: 700;
            border: none;
            background: transparent;
        }
        #notesModal .select2-container--bootstrap-5 .select2-selection--multiple {
            min-height: 38px;
            height: auto !important;
        }

        /* Onay kutuları eşit yükseklikte kart görünümünde */
        form .row.g-3.mt-2 > .col-12.d-flex {
            gap: 10px !important; flex-wrap: wrap;
        }
        form .form-check.custom-checkbox {
            display: flex !important; align-items: center; gap: .5rem;
            min-height: 40px; margin: 0 !important;
            padding: .35rem .8rem !important;
            border: 1px solid var(--border-color, #e8ecf4);
            border-radius: 10px; background: var(--bg-card, #fff);
            transition: border-color .18s ease, background .18s ease;
        }
        form .form-check.custom-checkbox:hover { border-color: var(--metro-primary, #009ef7); }
        form .form-check.custom-checkbox .form-check-input { margin: 0 !important; float: none !important; flex-shrink: 0; }
        form .form-check.custom-checkbox .form-check-label { margin: 0 !important; font-size: .8rem; white-space: nowrap; }

        form button[type="submit"] { border-radius: 12px; height: 44px; }

        /* ==================================================================
           TABLOYU EKRANA SIĞDIR
           Eski kural bütün sütunlara nowrap + width:1% veriyordu; bu yüzden
           tablo sağa taşıyordu. Artık yalnızca tutar sütunları tek satır.
           ================================================================== */
        table.rapor-tablo { width: 100% !important; table-layout: auto; }

        table.rapor-tablo th:not(.text-right),
        table.rapor-tablo td:not(.text-right) {
            width: auto !important;
            max-width: none !important;
            white-space: normal !important;
            overflow-wrap: anywhere;
            word-break: break-word;
            line-height: 1.28;
        }

        /* Metin sütunlarına alt sınır verilmiyor: ekrana sığmak için daralabilmeliler */
        table.rapor-tablo th:not(.text-right),
        table.rapor-tablo td:not(.text-right) { min-width: 0 !important; }

        /* Tutar ve tarih sütunları bölünmesin */
        table.rapor-tablo td.text-right { white-space: nowrap !important; text-align: right !important; font-variant-numeric: tabular-nums; }
        table.rapor-tablo th.text-right { text-align: right !important; }
        table.rapor-tablo td:nth-child(1),
        table.rapor-tablo td:nth-child(2),
        table.rapor-tablo td:nth-child(3) { white-space: nowrap !important; }

        /* Rozetler ve satır içi etiketler de küçülsün */
        table.rapor-tablo .badge { font-size: .55rem; padding: .15rem .3rem; }

        table.rapor-tablo .badge { font-size: .6rem; padding: .2rem .4rem; }

        /* Dar ekranda yatay kaydırmaya izin ver (bu durumda başlık kutuya yapışır) */
        @@media (max-width: 1200px) {
            .table-container { overflow-x: auto; }
            table.rapor-tablo th { top: 0; }
        }
    </style>
    <link rel="stylesheet" href="~/css/ekstre-tema.css" asp-append-version="true" />
}

<div class="container-fluid">
    @Html.AntiForgeryToken()

    <div class="header text-center">
        <h1 class="logo"></h1>
        <h2>@(isEnglish ? "ACCOUNT STATEMENT REPORT" : "CARİ EKSTRE RAPORU")</h2>
        <p class="mb-0">@(isEnglish ? "Track your financial transaction details" : "Finansal işlem detaylarınızı takip edin")</p>
    </div>

    <div class="database-info d-flex justify-content-between align-items-center">
        <div>
            <i class="fas fa-database me-2"></i> @(isEnglish ? "Active database:" : "Aktif veritabanı:") <strong>@currentSelectedDbDisplay</strong>
            @if(isConsolidated)
            {
                <span class="badge bg-success ms-3"><i class="fas fa-globe"></i> @(isEnglish ? "Consolidated (All Companies) Report" : "Konsolide (Tüm Şirketler) Rapor")</span>
            }
        </div>
        <div>
            <button type="button" class="btn btn-sm btn-outline-primary shadow-sm fw-bold" onclick="setupRapor20Udfs()">
                <i class="fas fa-cogs me-1"></i> @(isEnglish ? "Setup UDFs" : "Sistemi Kur (UDF'leri Aç)")
            </button>
        </div>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title fw-bold text-dark mb-3"><i class="fas fa-filter text-primary me-2"></i>@(isEnglish ? "Report Filters" : "Rapor Filtreleri")</h5>
            <form asp-controller="Rapor20" asp-action="Index" method="get">
                
                @if (!string.IsNullOrEmpty(currentDb))
                {
                    <input type="hidden" name="db" value="@currentDb" />
                }

                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-6 col-lg-3 col-xl-3">
                        <label for="bpCode" class="form-label fw-bold text-muted small">@(isEnglish ? "Select BP" : "Cari Seçimi")</label>
                        <select class="form-control" id="bpCode" name="bpCode" multiple="multiple">
                            @if (cariList.Any())
                            {
                                foreach (var cari in cariList)
                                {
                                    <option value="@cari.CardCode" selected="@(selectedBpCodes.Contains(cari.CardCode))">@cari.CardCode - @cari.CardName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3 col-xl-2">
                        <label for="aktarimTipi" class="form-label fw-bold text-muted small">@(isEnglish ? "Transfer Type" : "Aktarım Tipi")</label>
                        <select class="form-control" id="aktarimTipi" name="aktarimTipi" multiple="multiple">
                            @if (aktarimTipiList.Any())
                            {
                                foreach (var tip in aktarimTipiList)
                                {
                                    <option value="@tip" selected="@(selectedAktarimTipi.Contains(tip))">@tip</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4 col-lg-2 col-xl-3">
                        <label for="bakiyeDurumu" class="form-label fw-bold text-muted small">@(isEnglish ? "Balance Status" : "Bakiye Durumu (Kapanma)")</label>
                        <select class="form-control" id="bakiyeDurumu" name="bakiyeDurumu" multiple="multiple">
                            <option value="Açık" selected="@(selectedBakiyeDurumu.Contains("Açık") || selectedBakiyeDurumu.Contains("Open"))">@(isEnglish ? "Open (Unreconciled)" : "Açık (Kapanmamış)")</option>
                            <option value="Kısmi" selected="@(selectedBakiyeDurumu.Contains("Kısmi") || selectedBakiyeDurumu.Contains("Partial"))">@(isEnglish ? "Partial" : "Kısmi (Eksik Kapanmış)")</option>
                            <option value="Kapalı" selected="@(selectedBakiyeDurumu.Contains("Kapalı") || selectedBakiyeDurumu.Contains("Closed"))">@(isEnglish ? "Closed (Reconciled)" : "Kapalı (Tam Kapanmış)")</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4 col-lg-2 col-xl-2">
                        <label for="startDate" class="form-label fw-bold text-muted small">@(isEnglish ? "Start Date" : "Başlangıç Tarihi")</label>
                        <input type="date" class="form-control" id="startDate" name="startDate" value="@ViewBag.StartDate">
                    </div>
                    <div class="col-12 col-md-4 col-lg-2 col-xl-2">
                        <label for="endDate" class="form-label fw-bold text-muted small">@(isEnglish ? "End Date" : "Bitiş Tarihi")</label>
                        <input type="date" class="form-control" id="endDate" name="endDate" value="@ViewBag.EndDate">
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-12 d-flex flex-wrap gap-4 align-items-center">
                        <div class="form-check custom-checkbox">
                            <input type="checkbox" class="form-check-input" id="includeInitialBalance" name="includeInitialBalance" value="true" @(includeInitialBalance ? "checked" : "")>
                            <label class="form-check-label" style="cursor:pointer;" for="includeInitialBalance">@(isEnglish ? "Include Opening Balance" : "Devir Bakiyesini Dahil Et")</label>
                        </div>
                        <div class="form-check custom-checkbox">
                            <input type="checkbox" class="form-check-input" id="includeConnectedBp" name="includeConnectedBp" value="true" @(includeConnectedBp ? "checked" : "")>
                            <label class="form-check-label" style="cursor:pointer;" for="includeConnectedBp">@(isEnglish ? "Include Connected BP" : "Bağlı Cariyi Dahil Et")</label>
                        </div>
                        <div class="form-check custom-checkbox">
                            <input type="checkbox" class="form-check-input" id="tlEkstre" name="tlEkstre" value="true" @(tlEkstre ? "checked" : "")>
                            <label class="form-check-label text-primary fw-bold" style="cursor:pointer;" for="tlEkstre">@(isEnglish ? "Only TRY Statement (Hide FC)" : "Sadece TL Ekstre (YPB Gizle)")</label>
                        </div>
                        <div class="form-check custom-checkbox">
                            <input type="checkbox" class="form-check-input" id="includeOpenOrders" name="includeOpenOrders" value="true" @(includeOpenOrders ? "checked" : "")>
                            <label class="form-check-label text-dark fw-bold" style="cursor:pointer;" for="includeOpenOrders"><i class="fas fa-shopping-cart me-1"></i> @(isEnglish ? "Include Open Orders" : "Açık Siparişleri Dahil Et")</label>
                        </div>
                        
                        <div class="form-check ms-md-3 p-2 rounded bg-success-subtle border border-success custom-checkbox">
                            <input type="checkbox" class="form-check-input ms-1" id="isConsolidated" name="isConsolidated" value="true" @(isConsolidated ? "checked" : "")>
                            <label class="form-check-label text-success fw-bold ms-2 pe-2" style="cursor:pointer;" for="isConsolidated"><i class="fas fa-globe me-1"></i> @(isEnglish ? "Consolidated Statement (All Comps)" : "Konsolide Ekstre (Tüm Şirketler)")</label>
                        </div>
                        
                        <div class="form-check ms-md-3 p-2 rounded bg-warning-subtle border border-warning custom-checkbox">
                            <input type="checkbox" class="form-check-input ms-1" id="useBpDueDate" name="useBpDueDate" value="true" @(useBpDueDate ? "checked" : "")>
                            <label class="form-check-label text-dark fw-bold ms-2 pe-2" style="cursor:pointer;" for="useBpDueDate"><i class="fas fa-calendar-alt me-1"></i> @(isEnglish ? "Due Date by Payment Terms" : "Ödeme Koşuluna Göre Vade")</label>
                        </div>

                        <div class="form-check ms-md-3 p-2 rounded bg-info-subtle border border-info custom-checkbox">
                            <input type="checkbox" class="form-check-input ms-1" id="isEnglish" name="isEnglish" value="true" @(isEnglish ? "checked" : "")>
                            <label class="form-check-label text-info-emphasis fw-bold ms-2 pe-2" style="cursor:pointer;" for="isEnglish"><i class="fas fa-language me-1"></i> İngilizce (English)</label>
                        </div>
                    </div>
                    <div class="col-12 mt-3">
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold fs-6"><i class="fas fa-chart-line me-2"></i>@(isEnglish ? "Generate Report" : "Raporla")</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(selectedBpCode))
    {
        @if (ViewBag.MutabakatUyariTipi != null && ViewBag.MutabakatUyariTipi != "none")
        {
            <div class="alert alert-@(ViewBag.MutabakatUyariTipi == "warning" ? "warning" : "success") d-flex align-items-center shadow-sm mb-4" role="alert">
                <i class="fas @(ViewBag.MutabakatUyariTipi == "warning" ? "fa-exclamation-triangle" : "fa-check-circle") fa-2x me-3"></i>
                <div>@Html.Raw(ViewBag.MutabakatUyariMesaji)</div>
            </div>
        }

        @if (mutabakatUyarilari.Any())
        {
            <div class="alert alert-danger shadow-sm mb-4 border-0 border-start border-danger border-5">
                <h5 class="alert-heading fw-bold text-danger"><i class="fas fa-exclamation-triangle me-2"></i>@(isEnglish ? "Unreconciled Records Warning Analysis" : "Kapanmayan Kayıtlar Uyarı Analizi")</h5>
                <p class="mb-2 text-muted small">@(isEnglish ? "The following transactions cannot be reconciled due to the discrepancies specified below:" : "Aşağıdaki işlemler, belirtilen uyuşmazlıklar sebebiyle mutabakat ekranında eşleşememektedir:")</p>
                <hr>
                <ul class="mb-0">
                    @foreach (var uyari in mutabakatUyarilari)
                    {
                        <li class="mb-1">
                            <strong class="text-dark">@uyari.UyariTipi:</strong> 
                            <span class="text-danger">@uyari.AnalizSonucu</span>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="row align-items-center mb-4">
            <div class="col-md-5">
                <div class="cari-bilgi d-flex justify-content-between align-items-center">
                    <div class="cari-header-content">
                        <h4 class="mb-0">
                            @(isEnglish ? "Main BP:" : "Ana Cari:") <strong>@selectedBpCode - @bpName</strong>
                        </h4>
                        @if (includeConnectedBp && !string.IsNullOrEmpty(connectedBpCode))
                        {
                            <div class="connected-bp-info mt-2">
                                <i class="fas fa-link me-2"></i> @(isEnglish ? "Connected BP Included:" : "Bağlı Cari de Dahil Edildi:") <strong>@connectedBpCode - @connectedBpName</strong>
                            </div>
                        }
                    </div>
                    <div>
                        <button type="button" class="btn btn-sm btn-action-custom @(hasNotes ? "btn-warning text-dark" : "btn-outline-secondary") position-relative" onclick="openNotesModal()">
                            <i class="fas fa-cloud"></i> @(isEnglish ? "BP Notes" : "Cari Notları")
                            @if (hasNotes) { <span class="position-absolute top-0 start-100 translate-middle p-2 bg-danger border border-light rounded-circle"><span class="visually-hidden">New notes</span></span> }
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-7 text-end mt-3 mt-md-0 d-flex flex-wrap justify-content-md-end gap-2">
                <button type="button" class="btn btn-action-custom btn-save-recon" onclick="checkAndOpenMutabakatModal()">
                    <i class="fas fa-save me-2"></i>@(isEnglish ? "Save Reconciliation" : "Mutabakat Kaydet")
                </button>
                <button type="button" class="btn btn-action-custom btn-recon" onclick="openReconModal()">
                    <i class="fas fa-handshake me-2"></i>@(isEnglish ? "Reconcile" : "Mutabakat Yap")
                </button>
                <a href="@Url.Action("DownloadExcel", "Rapor20", routeValues)" class="btn btn-action-custom btn-download-excel">
                    <i class="fas fa-file-excel me-1"></i>Excel
                </a>
                <a href="@Url.Action("DownloadMutabakatFormuPdf", "Rapor20", mutabakatRouteValues)" class="btn btn-action-custom btn-download-form">
                    <i class="fas fa-file-signature me-1"></i>@(isEnglish ? "Statement Form" : "Mutabakat Formu")
                </a>
                <a href="@Url.Action("DownloadPdf", "Rapor20", portraitRouteValues)" class="btn btn-action-custom btn-download">
                    <i class="fas fa-file-pdf me-1"></i>@(isEnglish ? "Portrait PDF" : "Dikey PDF")
                </a>
                <a href="@Url.Action("DownloadPdf", "Rapor20", landscapeRouteValues)" class="btn btn-action-custom btn-download-landscape">
                    <i class="fas fa-file-pdf me-1"></i>@(isEnglish ? "Landscape PDF" : "Yatay PDF")
                </a>
            </div>
        </div>

        <div class="table-container">
            <div class="alert alert-info d-flex align-items-center mb-3 py-2 shadow-sm border-0 border-start border-info border-4">
                <i class="fas fa-info-circle fa-2x me-3 text-info"></i>
                <div>
                    <strong class="text-dark">@(isEnglish ? "Statement Balance Coloring Info:" : "Ekstre Bakiye Renklendirme Bilgisi:")</strong><br/>
                    <span class="badge bg-success me-2 mt-1">@(isEnglish ? "Closed" : "Kapalı")</span> @(isEnglish ? "Fully reconciled and closed transactions." : "Tamamen mutabakatı yapılmış (kapanmış) belgeler.")<br/>
                    <span class="badge bg-warning text-dark me-2 mt-1">@(isEnglish ? "Partial" : "Kısmi")</span> @(isEnglish ? "Partially paid/closed transactions." : "Kısmi ödemesi/kapanışı yapılmış belgeler.")<br/>
                    <span class="badge bg-danger me-2 mt-1">@(isEnglish ? "Open" : "Açık")</span> @(isEnglish ? "Open transactions with no reconciliation." : "Henüz hiçbir işlem görmemiş açık belgeler.")
                </div>
            </div>

            @if (groupedByBp.Any())
            {
                foreach (var bpGroup in groupedByBp)
                {
                    var currentBpCode = bpGroup.Key;
                    var currentBpName = bpGroup.First()?.MuhatapAdi ?? (isEnglish ? "Unknown" : "Bilinmiyor");

                    var firstRecord = bpGroup.FirstOrDefault();
                    var phone = firstRecord?.Phone1;
                    var fullAddress = string.Join(" ",
                    new[] { firstRecord?.Street, firstRecord?.County, firstRecord?.State, firstRecord?.Country }
                    .Where(s => !string.IsNullOrWhiteSpace(s)));

                    var safeBpCode = currentBpCode.Replace(".", "").Replace(" ", "");

                    <div class="bp-group-header">
                        <i class="fas fa-user-tie me-2"></i>
                        @if (currentBpCode == selectedBpCode)
                        {
                            <strong>@(isEnglish ? "MAIN BP STATEMENT:" : "ANA CARİ EKSTRESİ:")</strong>
                        }
                        else
                        {
                            <strong>@(isEnglish ? "CONNECTED BP STATEMENT:" : "BAĞLI CARİ EKSTRESİ:")</strong>
                        }
                        @currentBpCode - @currentBpName
                    </div>

                    <div class="bp-contact-info">
                        <div class="row gy-2 align-items-center">
                            @if (!string.IsNullOrEmpty(phone))
                            {
                                <div class="col-md-4 d-flex align-items-center">
                                    <i class="fas fa-phone-alt me-2 text-secondary"></i>
                                    <span class="fw-bold me-2">Tel:</span>
                                    <span id="phone-@safeBpCode" class="selectable-text me-2" title="Tıklayarak seç">@phone</span>
                                    <button class="btn btn-copy" onclick="copyToClipboard('phone-@safeBpCode', this)" title="Kopyala">
                                        <i class="far fa-copy"></i>
                                    </button>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(fullAddress))
                            {
                                <div class="col-md-8 d-flex align-items-center">
                                    <i class="fas fa-map-marker-alt me-2 text-secondary"></i>
                                    <span class="fw-bold me-2">@(isEnglish ? "Address:" : "Adres:")</span>
                                    <span id="addr-@safeBpCode" class="selectable-text me-2 text-truncate" style="max-width: 70%;" title="@fullAddress">@fullAddress</span>
                                    <button class="btn btn-copy" onclick="copyToClipboard('addr-@safeBpCode', this)" title="Kopyala">
                                        <i class="far fa-copy"></i>
                                    </button>
                                </div>
                            }
                            @if (string.IsNullOrEmpty(phone) && string.IsNullOrEmpty(fullAddress))
                            {
                                <div class="col-12 text-muted fst-italic">@(isEnglish ? "Contact info not found." : "İletişim bilgisi bulunamadı.")</div>
                            }
                        </div>
                    </div>

                    var groupedByCurrency = bpGroup.GroupBy(d => d.IslemPB).ToList();

                    foreach (var group in groupedByCurrency)
                    {
                        <h5 class="mt-4 ms-2 fw-bold"><i class="fas fa-money-bill-wave me-2 text-success"></i>@(isEnglish ? "Currency:" : "Para Birimi:") @group.Key</h5>
                        <table class="table table-bordered table-hover rapor-tablo" id="cariEkstreTable-@currentBpCode-@group.Key">
                            <thead>
                                <tr>
                                    <th>@(isEnglish ? "Doc No" : "İşlem No")</th>
                                    <th>@(isEnglish ? "Posting Date" : "Kayıt Tarihi")</th>
                                    <th>@(isEnglish ? "Due Date" : "Vade Tarihi")</th>
                                    @if(isConsolidated) { <th>@(isEnglish ? "Company Name" : "Şirket Adı")</th> }
                                    <th>@(isEnglish ? "BP Code" : "Muhatap Kodu")</th>
                                    <th>@(isEnglish ? "BP Name" : "Muhatap Adı")</th>
                                    <th>@(isEnglish ? "Remarks" : "Ayrıntı")</th>
                                    <th>@(isEnglish ? "Status" : "Durum")</th>
                                    <th>@(isEnglish ? "Type" : "İşlem Tipi")</th>
                                    <th>@(isEnglish ? "Trans. Type" : "Aktarım")</th>
                                    <th class="text-right">@(isEnglish ? "Debit (TRY)" : "Borç (TL)")</th>
                                    <th class="text-right">@(isEnglish ? "Credit (TRY)" : "Alacak (TL)")</th>
                                    <th class="text-right">@(isEnglish ? "Cum. Bal. (TRY)" : "Kml. Bakiye (TL)")</th>
                                    @if (!tlEkstre)
                                    {
                                        <th class="text-right">@(isEnglish ? "Debit (FC)" : "Borç (PB)")</th>
                                        <th class="text-right">@(isEnglish ? "Credit (FC)" : "Alacak (PB)")</th>
                                        <th class="text-right">@(isEnglish ? "Cum. Bal. (FC)" : "Kml. Bakiye (PB)")</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group.ToList().OrderBy(i => i.KayitTarihi).ThenBy(i => i.IslemNo))
                                {
                                    string rowClass = "";
                                    if (item.IslemTipi == "AT") { rowClass = "at-row"; }
                                    else if (item.IslemTipi == "DB" || item.IslemTipi == "OB") { rowClass = "db-row"; }
                                    else if (item.IslemTipi == "S.SİP" || item.IslemTipi == "A.SİP" || item.IslemTipi == "S.ORD" || item.IslemTipi == "P.ORD") { rowClass = "order-row"; }

                                    <tr class="@(rowClass)">
                                        <td>@(item.IslemNo == -1 ? (isEnglish ? "Opening" : "Devir") : (item.IslemTipi == "AT" ? "-" : item.IslemNo.ToString()))</td>
                                        <td>@(item.KayitTarihi?.ToString("dd.MM.yyyy") ?? "-")</td>
                                        <td>@(item.VadeTarihi?.ToString("dd.MM.yyyy") ?? "-")</td>
                                        @if(isConsolidated) { <td><span class="badge bg-secondary">@(item.Sirket ?? "-")</span></td> }
                                        <td>@Html.DisplayFor(modelItem => item.MuhatapKodu)</td>
                                        <td>@Html.DisplayFor(modelItem => item.MuhatapAdi)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Aciklama)</td>
                                        <td class="text-center">
                                            @if(item.IslemTipi != "AT" && item.IslemTipi != "DB" && item.IslemTipi != "OB")
                                            {
                                                if(item.BakiyeDurumu == "Kapalı" || item.BakiyeDurumu == "Closed") { <span class="badge bg-success">@(isEnglish ? "Closed" : "Kapalı")</span> }
                                                else if(item.BakiyeDurumu == "Kısmi" || item.BakiyeDurumu == "Partial") { <span class="badge bg-warning text-dark">@(isEnglish ? "Partial" : "Kısmi")</span> }
                                                else { <span class="badge bg-danger">@(isEnglish ? "Open" : "Açık")</span> }
                                            }
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.IslemTipi)</td>
                                        <td>@Html.DisplayFor(modelItem => item.AktarimTipi)</td>
                                        <td class="text-right @(item.TRYB.HasValue && item.TRYB.Value > 0 ? "borc" : "")">@item.TRYB?.ToString("N2", new CultureInfo("tr-TR"))</td>
                                        <td class="text-right @(item.TRYA.HasValue && item.TRYA.Value > 0 ? "alacak" : "")">@item.TRYA?.ToString("N2", new CultureInfo("tr-TR"))</td>
                                        <td class="text-right">@item.TRY_KmlBky?.ToString("N2", new CultureInfo("tr-TR"))</td>
                                        @if (!tlEkstre)
                                        {
                                            <td class="text-right @(item.IslemB.HasValue && item.IslemB.Value > 0 ? "borc" : "")">@item.IslemB?.ToString("N2", new CultureInfo("tr-TR"))</td>
                                            <td class="text-right @(item.IslemA.HasValue && item.IslemA.Value > 0 ? "alacak" : "")">@item.IslemA?.ToString("N2", new CultureInfo("tr-TR"))</td>
                                            <td class="text-right">@item.Islem_KmlBky?.ToString("N2", new CultureInfo("tr-TR"))</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-info">
                                    <td colspan="@baseColSpan" class="text-right text-dark"><strong>@(isEnglish ? "BP Subtotal" : "Cari Alt Toplam") (@group.Key)</strong></td>
                                    
                                    <td class="text-right borc" style="font-size:1.05em;"><strong>@group.Where(d => d.IslemTipi != "AT" && d.IslemTipi != "DB" && d.IslemTipi != "OB").Sum(d => d.TRYB ?? 0).ToString("N2", new CultureInfo("tr-TR"))</strong></td>
                                    <td class="text-right alacak" style="font-size:1.05em;"><strong>@group.Where(d => d.IslemTipi != "AT" && d.IslemTipi != "DB" && d.IslemTipi != "OB").Sum(d => d.TRYA ?? 0).ToString("N2", new CultureInfo("tr-TR"))</strong></td>
                                    <td class="text-right text-dark" style="font-size:1.05em;"><strong>@group.LastOrDefault()?.TRY_KmlBky?.ToString("N2", new CultureInfo("tr-TR"))</strong></td>
                                    
                                    @if (!tlEkstre)
                                    {
                                        <td class="text-right borc" style="font-size:1.05em;"><strong>@group.Where(d => d.IslemTipi != "AT" && d.IslemTipi != "DB" && d.IslemTipi != "OB").Sum(d => d.IslemB ?? 0).ToString("N2", new CultureInfo("tr-TR"))</strong></td>
                                        <td class="text-right alacak" style="font-size:1.05em;"><strong>@group.Where(d => d.IslemTipi != "AT" && d.IslemTipi != "DB" && d.IslemTipi != "OB").Sum(d => d.IslemA ?? 0).ToString("N2", new CultureInfo("tr-TR"))</strong></td>
                                        <td class="text-right text-dark" style="font-size:1.05em;"><strong>@group.LastOrDefault()?.Islem_KmlBky?.ToString("N2", new CultureInfo("tr-TR"))</strong></td>
                                    }
                                </tr>
                            </tfoot>
                        </table>
                    }
                }

                <br /><hr class="my-4 border-2" />

                <h5 class="mt-4 fw-bold text-dark"><i class="fas fa-building me-2"></i>@(isEnglish ? "Company Based Balance Summary (TRY)" : "Şirket Bazlı Bakiye Özeti (TRY)")</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-5">
                        <thead>
                            <tr class="thead-marka">
                                <th class="align-middle">@(isEnglish ? "Company Name" : "Şirket Adı")</th>
                                <th class="align-middle text-right">@(isEnglish ? "Total Debit (TL)" : "Toplam Borç (TL)")</th>
                                <th class="align-middle text-right">@(isEnglish ? "Total Credit (TL)" : "Toplam Alacak (TL)")</th>
                                <th class="align-middle text-right">@(isEnglish ? "Net Balance (TL)" : "Net Bakiye (TL)")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cGroup in companyGroupsForTotal)
                            {
                                var cMovements = cGroup.Where(d => d.IslemTipi != "DB" && d.IslemTipi != "OB").ToList();
                                var cDevir = cGroup.Where(d => d.IslemTipi == "DB" || d.IslemTipi == "OB").ToList();

                                decimal cTotalBorc = cMovements.Sum(d => d.TRYB ?? 0) + cDevir.Where(d => (d.TRY_KmlBky ?? 0) > 0).Sum(d => d.TRY_KmlBky ?? 0);
                                decimal cTotalAlacak = cMovements.Sum(d => d.TRYA ?? 0) + cDevir.Where(d => (d.TRY_KmlBky ?? 0) < 0).Sum(d => Math.Abs(d.TRY_KmlBky ?? 0));
                                decimal cNet = cTotalBorc - cTotalAlacak;

                                <tr>
                                    <td class="align-middle fw-bold">@cGroup.Key</td>
                                    <td class="text-right align-middle borc">@cTotalBorc.ToString("N2", new CultureInfo("tr-TR"))</td>
                                    <td class="text-right align-middle alacak">@cTotalAlacak.ToString("N2", new CultureInfo("tr-TR"))</td>
                                    <td class="text-right align-middle fw-bold text-dark">@cNet.ToString("N2", new CultureInfo("tr-TR"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <h5 class="mt-4 fw-bold text-dark"><i class="fas fa-chart-pie me-2"></i>@(isEnglish ? "All BPs General Cumulative Summary" : "Tüm Cariler Genel Toplam Kümülatif Özeti")</h5>
                <div class="table-responsive">
                    <table class="table table-bordered total-summary-row" style="width: 100%;">
                        <thead>
                            <tr class="table-dark text-white text-center">
                                <th style="width: 25%;" class="align-middle">@(isEnglish ? "Balance Summary (Currency)" : "Bakiye Özeti (Para Birimi)")</th>
                                <th style="width: 12.5%;" class="align-middle text-right">@(isEnglish ? "Total Debit (FC)" : "Toplam Borç (PB)")</th>
                                <th style="width: 12.5%;" class="align-middle text-right">@(isEnglish ? "Total Credit (FC)" : "Toplam Alacak (PB)")</th>
                                <th style="width: 12.5%;" class="align-middle text-right">@(isEnglish ? "Net Balance (FC)" : "Net Bakiye (PB)")</th>
                                <th style="width: 12.5%;" class="align-middle text-right">@(isEnglish ? "Total Debit (TL)" : "Toplam Borç (TL)")</th>
                                <th style="width: 12.5%;" class="align-middle text-right">@(isEnglish ? "Total Credit (TL)" : "Toplam Alacak (TL)")</th>
                                <th style="width: 12.5%;" class="align-middle text-right">@(isEnglish ? "Net Balance (TL)" : "Net Bakiye (TL)")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pbGroup in currencyGroupsForTotal)
                            {
                                var pbMovements = pbGroup.Where(d => d.IslemTipi != "DB" && d.IslemTipi != "OB").ToList();
                                var pbDevir = pbGroup.Where(d => d.IslemTipi == "DB" || d.IslemTipi == "OB").ToList();

                                decimal pbTotalBorc = pbGroup.Key == "TRY" 
                                    ? pbMovements.Sum(d => d.TRYB ?? 0) + pbDevir.Where(d => (d.TRY_KmlBky ?? 0) > 0).Sum(d => d.TRY_KmlBky ?? 0)
                                    : pbMovements.Sum(d => d.IslemB ?? 0) + pbDevir.Where(d => (d.Islem_KmlBky ?? 0) > 0).Sum(d => d.Islem_KmlBky ?? 0);
                                
                                decimal pbTotalAlacak = pbGroup.Key == "TRY"
                                    ? pbMovements.Sum(d => d.TRYA ?? 0) + pbDevir.Where(d => (d.TRY_KmlBky ?? 0) < 0).Sum(d => Math.Abs(d.TRY_KmlBky ?? 0))
                                    : pbMovements.Sum(d => d.IslemA ?? 0) + pbDevir.Where(d => (d.Islem_KmlBky ?? 0) < 0).Sum(d => Math.Abs(d.Islem_KmlBky ?? 0));
                                
                                decimal pbNetBakiye = pbTotalBorc - pbTotalAlacak;

                                decimal groupTotalBorcTRY = pbMovements.Sum(d => d.TRYB ?? 0) + pbDevir.Where(d => (d.TRY_KmlBky ?? 0) > 0).Sum(d => d.TRY_KmlBky ?? 0);
                                decimal groupTotalAlacakTRY = pbMovements.Sum(d => d.TRYA ?? 0) + pbDevir.Where(d => (d.TRY_KmlBky ?? 0) < 0).Sum(d => Math.Abs(d.TRY_KmlBky ?? 0));
                                decimal groupNetBakiyeTRY = groupTotalBorcTRY - groupTotalAlacakTRY;

                                <tr class="satir-pb">
                                    <td class="align-middle text-dark"><strong>@pbGroup.Key @(isEnglish ? "Currency Cumulative Summary" : "Para Birimi Kümülatif Özeti")</strong></td>
                                    
                                    <td class="text-right align-middle borc" style="font-size: 1.05em;"><strong>@pbTotalBorc.ToString("N2", new CultureInfo("tr-TR"))</strong></td>
                                    <td class="text-right align-middle alacak" style="font-size: 1.05em;"><strong>@pbTotalAlacak.ToString("N2", new CultureInfo("tr-TR"))</strong></td>
                                    <td class="text-right align-middle text-dark" style="font-size: 1.05em;"><strong>@pbNetBakiye.ToString("N2", new CultureInfo("tr-TR"))</strong></td>
                                    
                                    <td class="text-right align-middle borc" style="font-size: 1.05em;"><strong>@groupTotalBorcTRY.ToString("N2", new CultureInfo("tr-TR"))</strong></td>
                                    <td class="text-right align-middle alacak" style="font-size: 1.05em;"><strong>@groupTotalAlacakTRY.ToString("N2", new CultureInfo("tr-TR"))</strong></td>
                                    <td class="text-right align-middle text-dark" style="font-size: 1.05em;"><strong>@groupNetBakiyeTRY.ToString("N2", new CultureInfo("tr-TR"))</strong></td>
                                </tr>
                            }

                            <tr class="satir-genel">
                                <td colspan="4" class="align-middle text-right"><strong>@(isEnglish ? "ALL BPs GENERAL CUMULATIVE BALANCE SUMMARY (TRY)" : "TÜM CARİLER GENEL KÜMÜLATİF BAKİYE ÖZETİ (TRY)")</strong></td>
                                <td class="text-right align-middle borc-acik"><strong>@finalTotalBorcTRY.ToString("N2", new CultureInfo("tr-TR"))</strong></td>
                                <td class="text-right align-middle alacak-acik"><strong>@finalTotalAlacakTRY.ToString("N2", new CultureInfo("tr-TR"))</strong></td>
                                <td class="text-right align-middle" style="font-size: 1.1em;"><strong>@finalNetBalanceTRY.ToString("N2", new CultureInfo("tr-TR"))</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                @if (bpRelatedAccountBalances.Any())
                {
                    <h5 class="mt-4 text-danger"><i class="fas fa-balance-scale-left me-2"></i> @(isEnglish ? "Accounting Balances Summary (Accounts 159,340,420,440)" : "Muhasebe Hesap Bakiyeleri Özeti (420'li Hesaplar)")</h5>
                    <div class="card bg-danger-subtle border-danger shadow-sm mb-5">
                        <div class="card-body p-2">
                            <p class="mb-2 fw-bold text-danger">@(isEnglish ? $"Exact match account balances for BP '{bpName}':" : $"\"{bpName}\" cari unvanı ile birebir eşleşen hesapların bakiye dökümü:")</p>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered account-balance-table mb-0">
                                    <thead>
                                        <tr>
                                            @if(isConsolidated) { <th>@(isEnglish ? "Company" : "Şirket")</th> }
                                            <th>@(isEnglish ? "Acc Code" : "Hesap Kodu")</th>
                                            <th>@(isEnglish ? "Acc Name" : "Hesap Adı")</th>
                                            <th class="text-right">@(isEnglish ? "Currency" : "Döviz Tipi")</th>
                                            <th class="text-right">@(isEnglish ? "FC Balance" : "Döviz Bakiyesi")</th>
                                            <th class="text-right">@(isEnglish ? "TL Equivalent" : "TL Karşılığı")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var bal in bpRelatedAccountBalances.OrderBy(b => b.CompanyName).ThenByDescending(b => b.TLBalance))
                                        {
                                            <tr class="@(bal.TLBalance < 0 ? "table-success" : "table-danger")">
                                                @if(isConsolidated) { <td class="fw-bold">@bal.CompanyName</td> }
                                                <td>@bal.AccountCode</td>
                                                <td>@bal.AccountName</td>
                                                <td class="text-right">@bal.Currency</td>
                                                <td class="text-right">@(bal.Currency != "TRY" ? bal.CurrencyBalance.ToString("N2", new CultureInfo("tr-TR")) : "-")</td>
                                                <td class="text-right fw-bold">@bal.TLBalance.ToString("N2", new CultureInfo("tr-TR"))</td>
                                            </tr>
                                        }
                                        <tr class="bg-danger text-white">
                                            <td colspan="@(isConsolidated ? 5 : 4)" class="text-right"><strong>@(isEnglish ? "GENERAL TL TOTAL BALANCE:" : "GENEL TL TOPLAM BAKİYESİ:")</strong></td>
                                            <td class="text-right fw-bold"><strong>@totalBpRelatedAccountBalance.ToString("N2", new CultureInfo("tr-TR")) TRY</strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                @if (!string.IsNullOrEmpty((string)ViewBag.SorguHatasi))
                {
                    <div class="alert alert-danger mt-4"><i class="fas fa-triangle-exclamation me-2"></i><b>@(isEnglish ? "Query error:" : "Sorgu hatası:")</b> @ViewBag.SorguHatasi</div>
                }
                else
                {
                    <div class="alert alert-info text-center mt-4">
                        @(isEnglish ? "No records found. Please check your filter options." : "Kayıt bulunamadı. Lütfen filtreleme seçeneklerini kontrol edin.")
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center mt-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @(isEnglish ? "Please select a BP and click 'Generate Report' to view the statement." : "Lütfen bir cari seçimi yapın ve raporu görüntülemek için 'Raporla' butonuna tıklayın.")
        </div>
    }
</div>

