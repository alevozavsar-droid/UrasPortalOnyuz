@model List<WebApplication3.Controllers.Rapor20CariEkstreViewModel>
@using WebApplication3.Models
@using WebApplication3.Controllers
@using System.Globalization
@using Microsoft.AspNetCore.Routing

@{
    ViewData["Title"] = (bool)(ViewBag.IsEnglish ?? false) ? "Account Statement Report" : "Cari Ekstre Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Aktif Veritabanını (Şirketi) URL veya Cookie'den merkezi olarak alıyoruz
    var currentDb = Context.Request.Query["db"].ToString();
    if (string.IsNullOrEmpty(currentDb))
    {
        currentDb = Context.Request.Cookies["SelectedDatabase"];
    }

    var currentSelectedDbDisplay = (string)ViewBag.CurrentDbDisplay ?? "URASKIMYA";
    var selectedBpCode = (string)ViewBag.SelectedBpCode;
    var selectedBpCodes = ViewBag.SelectedBpCodes as List<string> ?? new List<string>();
    if (!selectedBpCodes.Any() && !string.IsNullOrEmpty(selectedBpCode)) { selectedBpCodes = new List<string> { selectedBpCode }; }
    var selectedAktarimTipi = ViewBag.SelectedAktarimTipi as List<string> ?? new List<string>();
    var selectedBakiyeDurumu = ViewBag.SelectedBakiyeDurumu as List<string> ?? new List<string>();
    
    // Yeni eklenen ve mevcut filtreler
    var includeInitialBalance = (bool)(ViewBag.IncludeInitialBalance ?? false);
    var includeConnectedBp = (bool)(ViewBag.IncludeConnectedBp ?? false);
    var tlEkstre = (bool)(ViewBag.TlEkstre ?? false);
    var isConsolidated = (bool)(ViewBag.IsConsolidated ?? false);
    var useBpDueDate = (bool)(ViewBag.UseBpDueDate ?? false);
    var includeOpenOrders = (bool)(ViewBag.IncludeOpenOrders ?? false);
    var isEnglish = (bool)(ViewBag.IsEnglish ?? false);
    var hasNotes = (bool)(ViewBag.HasNotes ?? false);

    var connectedBpCode = (string)ViewBag.ConnectedBpCode;
    var connectedBpName = (string)ViewBag.ConnectedBpName;

    var bpRelatedAccountBalances = ViewBag.BpRelatedAccountBalances as List<AccountBalanceViewModel> ?? new List<AccountBalanceViewModel>();
    var totalBpRelatedAccountBalance = bpRelatedAccountBalances.Sum(b => b.TLBalance);

    var mutabakatUyarilari = ViewBag.MutabakatUyarilari as List<UyariViewModel> ?? new List<UyariViewModel>();

    var bpName = ViewBag.SelectedBpName ?? (isEnglish ? "BP Name Not Found" : "Muhatap Adı Bulunamadı");
    var cariList = ViewBag.CariList as List<CariViewModel> ?? new List<CariViewModel>();
    var aktarimTipiList = ViewBag.AktarimTipiList as List<string> ?? new List<string>();
    var modelData = Model ?? new List<Rapor20CariEkstreViewModel>();

    // 1. Önce Cari Koda göre gruplama
    var groupedByBp = modelData.GroupBy(d => d.MuhatapKodu).ToList();
    int baseColSpan = isConsolidated ? 10 : 9;

    // Excel/PDF İndirme Butonları için Route Değerleri
    var routeValues = new RouteValueDictionary();
    if (!string.IsNullOrEmpty(currentDb)) { routeValues.Add("db", currentDb); }
    for (int i = 0; i < selectedBpCodes.Count; i++)
    {
        routeValues.Add($"bpCode[{i}]", selectedBpCodes[i]);
    }
    routeValues.Add("startDate", ViewBag.StartDate);
    routeValues.Add("endDate", ViewBag.EndDate);
    routeValues.Add("includeInitialBalance", includeInitialBalance);
    routeValues.Add("includeConnectedBp", includeConnectedBp);
    routeValues.Add("tlEkstre", tlEkstre);
    routeValues.Add("isConsolidated", isConsolidated);
    routeValues.Add("useBpDueDate", useBpDueDate);
    routeValues.Add("includeOpenOrders", includeOpenOrders);
    routeValues.Add("isEnglish", isEnglish);
    
    for (int i = 0; i < selectedAktarimTipi.Count; i++)
    {
        routeValues.Add($"aktarimTipi[{i}]", selectedAktarimTipi[i]);
    }
    for (int i = 0; i < selectedBakiyeDurumu.Count; i++)
    {
        routeValues.Add($"bakiyeDurumu[{i}]", selectedBakiyeDurumu[i]);
    }
    // Mutabakat formu tek cariye hitaben üretildiği için ilk seçili cariyi
    // düz "bpCode" anahtarıyla da geçiyoruz.
    var mutabakatRouteValues = new RouteValueDictionary(routeValues);
    foreach (var anahtar in mutabakatRouteValues.Keys.Where(k => k.StartsWith("bpCode[")).ToList())
    {
        mutabakatRouteValues.Remove(anahtar);
    }
    if (selectedBpCodes.Any()) { mutabakatRouteValues["bpCode"] = selectedBpCodes.First(); }

    var portraitRouteValues = new RouteValueDictionary(routeValues) { { "orientation", "Portrait" } };
    var landscapeRouteValues = new RouteValueDictionary(routeValues) { { "orientation", "Landscape" } };

    // Şirket ve Genel Kümülatif Özet Tabloları İçin Değişkenler
    var allRowsForTotal = modelData.Where(d => d.IslemTipi != "AT").ToList();
    var companyGroupsForTotal = allRowsForTotal.GroupBy(d => d.Sirket).ToList();
    var currencyGroupsForTotal = allRowsForTotal.GroupBy(d => d.IslemPB).ToList();

    decimal finalTotalBorcTRY = allRowsForTotal.Where(d => d.IslemTipi != "DB" && d.IslemTipi != "OB").Sum(d => d.TRYB ?? 0) + allRowsForTotal.Where(d => (d.IslemTipi == "DB" || d.IslemTipi == "OB") && (d.TRY_KmlBky ?? 0) > 0).Sum(d => d.TRY_KmlBky ?? 0);
    decimal finalTotalAlacakTRY = allRowsForTotal.Where(d => d.IslemTipi != "DB" && d.IslemTipi != "OB").Sum(d => d.TRYA ?? 0) + allRowsForTotal.Where(d => (d.IslemTipi == "DB" || d.IslemTipi == "OB") && (d.TRY_KmlBky ?? 0) < 0).Sum(d => Math.Abs(d.TRY_KmlBky ?? 0));
    decimal finalNetBalanceTRY = finalTotalBorcTRY - finalTotalAlacakTRY;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* Yalnız mutabakat / not pencereleri (modallar) için kalan kurallar; sayfa tasarımı wwwroot/css/ekstre-rapor.css */
        .modal-xxl { max-width: 95vw; }
        .amount-input { width: 120px; font-weight: bold; text-align: right; border-radius: 6px; border: 1px solid #ced4da; padding: 5px 10px; }
        .amount-input:disabled { background-color: #e9ecef; color: #6c757d; }
        .amount-input:focus { border-color: #0369a1; box-shadow: 0 0 0 0.2rem rgba(3, 105, 161, 0.2); outline: none; }
        .chk-row { transform: scale(1.3); cursor: pointer; accent-color: #0369a1; }
        .summary-box { background-color: #f8fafc; border: 1px solid #e2e8f0; padding: 8px 12px; border-radius: 10px; min-width: 150px; }
        .note-bubble { background-color: #f0f9ff; border-radius: 12px; padding: 12px; margin-bottom: 10px; position: relative; border-left: 4px solid #0ea5e9; }
        .note-bubble.task-pending { background-color: #fffbeb; border-left-color: #f59e0b; }
        .note-bubble.task-done { background-color: #f0fdf4; border-left-color: #16a34a; opacity: 0.85; }
        .note-meta { font-size: 0.8rem; color: #64748b; margin-bottom: 6px; border-bottom: 1px solid #e2e8f0; padding-bottom: 4px; }
        .nav-pills .nav-link.active { background-color: #0369a1; color: white; border-radius: 6px; }
        .nav-pills .nav-link { color: #475569; border-radius: 6px; margin-right: 5px; background-color: #f1f5f9; }
        .modal .rapor-tablo { font-size: .74rem; } .modal .rapor-tablo th { background: #0f172a; color: #fff; font-size: .62rem; text-transform: uppercase; position: sticky; top: 0; }
        .modal .borc { color: #b91c1c; font-weight: 700; } .modal .alacak { color: #15803d; font-weight: 700; }
        #notesModal .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__rendered { display: flex !important; flex-wrap: wrap !important; overflow: visible; padding: .2rem .3rem !important; gap: 4px; }
        #notesModal .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice { display: inline-flex !important; align-items: center; background: #eef2ff; border: 1px solid #c7d2fe; color: #3730a3; border-radius: 999px; padding: .12rem .5rem; font-size: .74rem; font-weight: 600; max-width: 100%; }
        #notesModal .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice__remove { color: #4338ca; margin-right: 4px; font-weight: 700; border: none; background: transparent; }
        #notesModal .select2-container--bootstrap-5 .select2-selection--multiple { min-height: 38px; height: auto !important; }
    </style>
    <link rel="stylesheet" href="~/css/ekstre-rapor.css" asp-append-version="true" />
}

@*
    CARİ EKSTRE RAPORU — yeni tasarım (wwwroot/css/ekstre-rapor.css, #rapor20)
    Üst şerit → süzgeç kartı (alanlar + seçenek çipleri, Raporla başlıkta) → uyarılar → cari başlığı + işlem düğmeleri + özet KPI'lar →
    cari / para birimi bazında ekstre blokları (okunur durum etiketleri) → şirket ve para birimi özetleri → muhasebe hesap bakiyeleri.
    Betik bağımlılıkları korunur: #bpCode / #aktarimTipi / #bakiyeDurumu (select2), #useBpDueDate, cariEkstreTable-* kimlikleri, .rapor-tablo, modallar.
*@
<div class="container-fluid" id="rapor20">
    @Html.AntiForgeryToken()

    <div class="ek-ust">
        <span class="ek-ikon"><i class="fas fa-file-invoice"></i></span>
        <div>
            <h2>@(isEnglish ? "Account Statement Report" : "Cari Ekstre Raporu")</h2>
            <div class="ek-alt">@(isEnglish ? "BP transactions, balances and reconciliation by date range and currency" : "Cari hareketleri, bakiye ve mutabakat · tarih aralığı ve para birimi bazında")</div>
        </div>
        <span class="ek-db"><i class="fas fa-database"></i> @(isEnglish ? "Active database:" : "Aktif veritabanı:") @currentSelectedDbDisplay
            @if (isConsolidated) { <span class="badge bg-success ms-1"><i class="fas fa-globe"></i> @(isEnglish ? "Consolidated" : "Konsolide")</span> }
        </span>
        <button type="button" class="btn-k" onclick="setupRapor20Udfs()"><i class="fas fa-cogs"></i> @(isEnglish ? "Setup UDFs" : "Sistemi Kur (UDF'leri Aç)")</button>
    </div>

    <div class="ek-kart ek-filtre">
        <div class="ek-kart-g">
            <form asp-controller="Rapor20" asp-action="Index" method="get">
                @if (!string.IsNullOrEmpty(currentDb)) { <input type="hidden" name="db" value="@currentDb" /> }
                <div class="ek-filtre-ust">
                    <span class="ek-baslik"><i class="fas fa-filter"></i>@(isEnglish ? "Report Filters" : "Rapor Filtreleri")</span>
                    @if (selectedBpCodes.Any()) { <span class="ek-secili">· @(selectedBpCodes.Count == 1 ? selectedBpCode + " " + bpName : selectedBpCodes.Count + (isEnglish ? " BPs selected" : " cari seçildi")) · @ViewBag.StartDate – @ViewBag.EndDate</span> }
                    <button type="submit" class="btn-k ana"><i class="fas fa-chart-line"></i> @(isEnglish ? "Generate Report" : "Raporla")</button>
                </div>
                <div class="ek-alanlar">
                    <div>
                        <label for="bpCode">@(isEnglish ? "Select BP" : "Cari Seçimi")</label>
                        <select class="form-control" id="bpCode" name="bpCode" multiple="multiple">
                            @foreach (var cari in cariList) { <option value="@cari.CardCode" selected="@(selectedBpCodes.Contains(cari.CardCode))">@cari.CardCode - @cari.CardName</option> }
                        </select>
                    </div>
                    <div>
                        <label for="aktarimTipi">@(isEnglish ? "Transfer Type" : "Aktarım Tipi")</label>
                        <select class="form-control" id="aktarimTipi" name="aktarimTipi" multiple="multiple">
                            @foreach (var tip in aktarimTipiList) { <option value="@tip" selected="@(selectedAktarimTipi.Contains(tip))">@tip</option> }
                        </select>
                    </div>
                    <div>
                        <label for="bakiyeDurumu">@(isEnglish ? "Balance Status" : "Bakiye Durumu")</label>
                        <select class="form-control" id="bakiyeDurumu" name="bakiyeDurumu" multiple="multiple">
                            <option value="Açık" selected="@(selectedBakiyeDurumu.Contains("Açık") || selectedBakiyeDurumu.Contains("Open"))">@(isEnglish ? "Open (Unreconciled)" : "Açık (Kapanmamış)")</option>
                            <option value="Kısmi" selected="@(selectedBakiyeDurumu.Contains("Kısmi") || selectedBakiyeDurumu.Contains("Partial"))">@(isEnglish ? "Partial" : "Kısmi (Eksik Kapanmış)")</option>
                            <option value="Kapalı" selected="@(selectedBakiyeDurumu.Contains("Kapalı") || selectedBakiyeDurumu.Contains("Closed"))">@(isEnglish ? "Closed (Reconciled)" : "Kapalı (Tam Kapanmış)")</option>
                        </select>
                    </div>
                    <div><label for="startDate">@(isEnglish ? "Start Date" : "Başlangıç Tarihi")</label><input type="date" class="form-control" id="startDate" name="startDate" value="@ViewBag.StartDate"></div>
                    <div><label for="endDate">@(isEnglish ? "End Date" : "Bitiş Tarihi")</label><input type="date" class="form-control" id="endDate" name="endDate" value="@ViewBag.EndDate"></div>
                </div>
                <div class="ek-secenekler">
                    <label><input type="checkbox" id="includeInitialBalance" name="includeInitialBalance" value="true" @(includeInitialBalance ? "checked" : "")> @(isEnglish ? "Include Opening Balance" : "Devir Bakiyesini Dahil Et")</label>
                    <label><input type="checkbox" id="includeConnectedBp" name="includeConnectedBp" value="true" @(includeConnectedBp ? "checked" : "")> @(isEnglish ? "Include Connected BP" : "Bağlı Cariyi Dahil Et")</label>
                    <label><input type="checkbox" id="tlEkstre" name="tlEkstre" value="true" @(tlEkstre ? "checked" : "")> @(isEnglish ? "Only TRY Statement (Hide FC)" : "Sadece TL Ekstre (YPB Gizle)")</label>
                    <label><input type="checkbox" id="includeOpenOrders" name="includeOpenOrders" value="true" @(includeOpenOrders ? "checked" : "")> <i class="fas fa-shopping-cart"></i>@(isEnglish ? "Include Open Orders" : "Açık Siparişleri Dahil Et")</label>
                    <label class="vurgu"><input type="checkbox" id="isConsolidated" name="isConsolidated" value="true" @(isConsolidated ? "checked" : "")> <i class="fas fa-globe"></i>@(isEnglish ? "Consolidated (All Companies)" : "Konsolide Ekstre (Tüm Şirketler)")</label>
                    <label class="vurgu"><input type="checkbox" id="useBpDueDate" name="useBpDueDate" value="true" @(useBpDueDate ? "checked" : "")> <i class="fas fa-calendar-alt"></i>@(isEnglish ? "Due Date by Payment Terms" : "Ödeme Koşuluna Göre Vade")</label>
                    <label><input type="checkbox" id="isEnglish" name="isEnglish" value="true" @(isEnglish ? "checked" : "")> <i class="fas fa-language"></i>İngilizce (English)</label>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(selectedBpCode))
    {
        @if (ViewBag.MutabakatUyariTipi != null && ViewBag.MutabakatUyariTipi != "none")
        {
            <div class="ek-uyari @(ViewBag.MutabakatUyariTipi == "warning" ? "dikkat" : "ok")"><i class="fas @(ViewBag.MutabakatUyariTipi == "warning" ? "fa-exclamation-triangle" : "fa-check-circle")"></i><div>@Html.Raw(ViewBag.MutabakatUyariMesaji)</div></div>
        }
        @if (mutabakatUyarilari.Any())
        {
            <div class="ek-uyari hata"><i class="fas fa-exclamation-triangle"></i><div><b>@(isEnglish ? "Unreconciled Records Warning Analysis" : "Kapanmayan Kayıtlar Uyarı Analizi")</b> · @(isEnglish ? "The following transactions cannot be reconciled:" : "Aşağıdaki işlemler mutabakat ekranında eşleşememektedir:")<ul>@foreach (var uyari in mutabakatUyarilari) { <li><b>@uyari.UyariTipi:</b> @uyari.AnalizSonucu</li> }</ul></div></div>
        }

        var acikSayi = allRowsForTotal.Count(d => d.IslemTipi != "DB" && d.IslemTipi != "OB" && (d.BakiyeDurumu == "Açık" || d.BakiyeDurumu == "Open"));
        var kismiSayi = allRowsForTotal.Count(d => d.IslemTipi != "DB" && d.IslemTipi != "OB" && (d.BakiyeDurumu == "Kısmi" || d.BakiyeDurumu == "Partial"));
        var hareketSayi = allRowsForTotal.Count(d => d.IslemTipi != "DB" && d.IslemTipi != "OB");
        var tr = new CultureInfo("tr-TR");

        <div class="ek-kart">
            <div class="ek-kart-g">
                <div class="ek-cari">
                    <span class="ad"><i class="fas fa-user-tie me-1" style="color:#0369a1"></i>@selectedBpCode<small>@bpName</small></span>
                    @if (includeConnectedBp && !string.IsNullOrEmpty(connectedBpCode)) { <span class="bagli"><i class="fas fa-link me-1"></i>@(isEnglish ? "Connected BP:" : "Bağlı cari:") <b>@connectedBpCode - @connectedBpName</b></span> }
                    <span class="islemler">
                        <button type="button" class="btn-k @(hasNotes ? "uyari" : "")" onclick="openNotesModal()"><i class="fas fa-cloud"></i> @(isEnglish ? "BP Notes" : "Cari Notları")</button>
                        <button type="button" class="btn-k" onclick="checkAndOpenMutabakatModal()"><i class="fas fa-save"></i> @(isEnglish ? "Save Reconciliation" : "Mutabakat Kaydet")</button>
                        <button type="button" class="btn-k ana" onclick="openReconModal()"><i class="fas fa-handshake"></i> @(isEnglish ? "Reconcile" : "Mutabakat Yap")</button>
                        <a href="@Url.Action("DownloadExcel", "Rapor20", routeValues)" class="btn-k"><i class="fas fa-file-excel"></i> Excel</a>
                        <a href="@Url.Action("DownloadMutabakatFormuPdf", "Rapor20", mutabakatRouteValues)" class="btn-k"><i class="fas fa-file-signature"></i> @(isEnglish ? "Statement Form" : "Mutabakat Formu")</a>
                        <a href="@Url.Action("DownloadPdf", "Rapor20", portraitRouteValues)" class="btn-k"><i class="fas fa-file-pdf"></i> @(isEnglish ? "Portrait PDF" : "Dikey PDF")</a>
                        <a href="@Url.Action("DownloadPdf", "Rapor20", landscapeRouteValues)" class="btn-k"><i class="fas fa-file-pdf"></i> @(isEnglish ? "Landscape PDF" : "Yatay PDF")</a>
                    </span>
                </div>
                @if (groupedByBp.Any())
                {
                    <div class="ek-kpi">
                        <div style="--k:#b91c1c"><div class="l">@(isEnglish ? "Total Debit (TRY)" : "Toplam Borç (TL)")</div><div class="v" style="color:#b91c1c">@finalTotalBorcTRY.ToString("N2", tr)</div></div>
                        <div style="--k:#15803d"><div class="l">@(isEnglish ? "Total Credit (TRY)" : "Toplam Alacak (TL)")</div><div class="v" style="color:#15803d">@finalTotalAlacakTRY.ToString("N2", tr)</div></div>
                        <div style="--k:#0f172a"><div class="l">@(isEnglish ? "Net Balance (TRY)" : "Net Bakiye (TL)")</div><div class="v">@finalNetBalanceTRY.ToString("N2", tr)</div><div class="s">@(finalNetBalanceTRY >= 0 ? (isEnglish ? "receivable" : "alacağımız (borç bakiyesi)") : (isEnglish ? "payable" : "borcumuz (alacak bakiyesi)"))</div></div>
                        <div style="--k:#0369a1"><div class="l">@(isEnglish ? "Transactions" : "Hareket")</div><div class="v">@hareketSayi</div><div class="s">@ViewBag.StartDate – @ViewBag.EndDate</div></div>
                        <div style="--k:#dc2626"><div class="l">@(isEnglish ? "Open Docs" : "Açık Belge")</div><div class="v">@acikSayi</div><div class="s">@(isEnglish ? "unreconciled" : "kapanmamış")</div></div>
                        <div style="--k:#f59e0b"><div class="l">@(isEnglish ? "Partial" : "Kısmi Kapanmış")</div><div class="v">@kismiSayi</div><div class="s">@(isEnglish ? "partially paid" : "eksik kapanmış")</div></div>
                    </div>
                }
            </div>
        </div>

        @if (groupedByBp.Any())
        {
            foreach (var bpGroup in groupedByBp)
            {
                var currentBpCode = bpGroup.Key;
                var currentBpName = bpGroup.First()?.MuhatapAdi ?? (isEnglish ? "Unknown" : "Bilinmiyor");
                var firstRecord = bpGroup.FirstOrDefault();
                var phone = firstRecord?.Phone1;
                var fullAddress = string.Join(" ", new[] { firstRecord?.Street, firstRecord?.County, firstRecord?.State, firstRecord?.Country }.Where(s => !string.IsNullOrWhiteSpace(s)));
                var safeBpCode = currentBpCode.Replace(".", "").Replace(" ", "");
                var groupedByCurrency = bpGroup.GroupBy(d => d.IslemPB).ToList();
                int altColSpan = isConsolidated ? 9 : 8;

                foreach (var group in groupedByCurrency)
                {
                    var hareketler = group.Where(d => d.IslemTipi != "AT" && d.IslemTipi != "DB" && d.IslemTipi != "OB").ToList();
                    <div class="ek-blok">
                        <div class="ek-blok-b">
                            <span class="etiket">@(currentBpCode == selectedBpCode ? (isEnglish ? "Main BP Statement" : "Ana Cari Ekstresi") : (isEnglish ? "Connected BP Statement" : "Bağlı Cari Ekstresi"))</span>
                            <b>@currentBpCode</b> · @currentBpName
                            <span class="pb"><i class="fas fa-coins me-1"></i>@group.Key</span>
                        </div>
                        @if (!string.IsNullOrEmpty(phone) || !string.IsNullOrEmpty(fullAddress))
                        {
                            <div class="ek-iletisim">
                                @if (!string.IsNullOrEmpty(phone)) { <span><i class="fas fa-phone-alt"></i>Tel: <span id="phone-@safeBpCode-@group.Key" class="selectable-text" title="Tıklayarak seç">@phone</span><button class="btn-copy" type="button" onclick="copyToClipboard('phone-@safeBpCode-@group.Key', this)" title="Kopyala"><i class="far fa-copy"></i></button></span> }
                                @if (!string.IsNullOrEmpty(fullAddress)) { <span><i class="fas fa-map-marker-alt"></i>@(isEnglish ? "Address:" : "Adres:") <span id="addr-@safeBpCode-@group.Key" class="selectable-text" title="@fullAddress">@fullAddress</span><button class="btn-copy" type="button" onclick="copyToClipboard('addr-@safeBpCode-@group.Key', this)" title="Kopyala"><i class="far fa-copy"></i></button></span> }
                            </div>
                        }
                        <div class="ek-tablo-kap">
                            <table class="table rapor-tablo" id="cariEkstreTable-@currentBpCode-@group.Key">
                                <thead>
                                    <tr>
                                        <th>@(isEnglish ? "Doc No" : "İşlem No")</th>
                                        <th>@(isEnglish ? "Posting" : "Kayıt")</th>
                                        <th>@(isEnglish ? "Due" : "Vade")</th>
                                        @if (isConsolidated) { <th>@(isEnglish ? "Company" : "Şirket")</th> }
                                        <th>@(isEnglish ? "BP" : "Muhatap")</th>
                                        <th>@(isEnglish ? "Remarks" : "Ayrıntı")</th>
                                        <th>@(isEnglish ? "Status" : "Durum")</th>
                                        <th>@(isEnglish ? "Type" : "Tip")</th>
                                        <th>@(isEnglish ? "Trans." : "Akt.")</th>
                                        <th class="text-right">@(isEnglish ? "Debit (TRY)" : "Borç (TL)")</th>
                                        <th class="text-right">@(isEnglish ? "Credit (TRY)" : "Alacak (TL)")</th>
                                        <th class="text-right">@(isEnglish ? "Balance (TRY)" : "Bakiye (TL)")</th>
                                        @if (!tlEkstre)
                                        {
                                            <th class="text-right">@(isEnglish ? "Debit (FC)" : "Borç (PB)")</th>
                                            <th class="text-right">@(isEnglish ? "Credit (FC)" : "Alacak (PB)")</th>
                                            <th class="text-right">@(isEnglish ? "Balance (FC)" : "Bakiye (PB)")</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in group.ToList().OrderBy(i => i.KayitTarihi).ThenBy(i => i.IslemNo))
                                    {
                                        string rowClass = item.IslemTipi == "AT" ? "at-row" : (item.IslemTipi == "DB" || item.IslemTipi == "OB") ? "db-row" : (item.IslemTipi == "S.SİP" || item.IslemTipi == "A.SİP" || item.IslemTipi == "S.ORD" || item.IslemTipi == "P.ORD") ? "order-row" : "";
                                        bool devir = item.IslemTipi == "AT" || item.IslemTipi == "DB" || item.IslemTipi == "OB" || item.IslemNo == 0 || item.IslemNo == -1;
                                        <tr class="@rowClass">
                                            <td class="no">@(item.IslemNo == -1 || item.IslemNo == 0 ? (isEnglish ? "Opening" : "Devir") : (item.IslemTipi == "AT" ? "-" : item.IslemNo.ToString()))</td>
                                            <td class="tarih">@(item.KayitTarihi?.ToString("dd.MM.yyyy") ?? "-")</td>
                                            <td class="tarih">@(item.VadeTarihi?.ToString("dd.MM.yyyy") ?? "-")</td>
                                            @if (isConsolidated) { <td><span class="ek-sirket">@(item.Sirket ?? "-")</span></td> }
                                            <td class="muhatap">@item.MuhatapKodu<small title="@item.MuhatapAdi">@item.MuhatapAdi</small></td>
                                            <td class="ayrinti">@item.Aciklama</td>
                                            <td>
                                                @if (!devir)
                                                {
                                                    if (item.BakiyeDurumu == "Kapalı" || item.BakiyeDurumu == "Closed") { <span class="ek-d kapali">@(isEnglish ? "Closed" : "Kapalı")</span> }
                                                    else if (item.BakiyeDurumu == "Kısmi" || item.BakiyeDurumu == "Partial") { <span class="ek-d kismi">@(isEnglish ? "Partial" : "Kısmi")</span> }
                                                    else { <span class="ek-d acik">@(isEnglish ? "Open" : "Açık")</span> }
                                                }
                                            </td>
                                            <td class="kod">@item.IslemTipi</td>
                                            <td class="kod">@item.AktarimTipi</td>
                                            <td class="text-right @(item.TRYB.HasValue && item.TRYB.Value > 0 ? "borc" : "")">@item.TRYB?.ToString("N2", tr)</td>
                                            <td class="text-right @(item.TRYA.HasValue && item.TRYA.Value > 0 ? "alacak" : "")">@item.TRYA?.ToString("N2", tr)</td>
                                            <td class="text-right bakiye">@item.TRY_KmlBky?.ToString("N2", tr)</td>
                                            @if (!tlEkstre)
                                            {
                                                <td class="text-right @(item.IslemB.HasValue && item.IslemB.Value > 0 ? "borc" : "")">@item.IslemB?.ToString("N2", tr)</td>
                                                <td class="text-right @(item.IslemA.HasValue && item.IslemA.Value > 0 ? "alacak" : "")">@item.IslemA?.ToString("N2", tr)</td>
                                                <td class="text-right bakiye">@item.Islem_KmlBky?.ToString("N2", tr)</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="@altColSpan" class="text-right">@(isEnglish ? "BP Subtotal" : "Cari Alt Toplam") (@group.Key) · @hareketler.Count @(isEnglish ? "transactions" : "hareket")</td>
                                        <td class="text-right borc">@hareketler.Sum(d => d.TRYB ?? 0).ToString("N2", tr)</td>
                                        <td class="text-right alacak">@hareketler.Sum(d => d.TRYA ?? 0).ToString("N2", tr)</td>
                                        <td class="text-right">@group.LastOrDefault()?.TRY_KmlBky?.ToString("N2", tr)</td>
                                        @if (!tlEkstre)
                                        {
                                            <td class="text-right borc">@hareketler.Sum(d => d.IslemB ?? 0).ToString("N2", tr)</td>
                                            <td class="text-right alacak">@hareketler.Sum(d => d.IslemA ?? 0).ToString("N2", tr)</td>
                                            <td class="text-right">@group.LastOrDefault()?.Islem_KmlBky?.ToString("N2", tr)</td>
                                        }
                                    </tr>
                                </tfoot>
                            </table>
                            <div class="ek-lejant"><span class="ek-d kapali">@(isEnglish ? "Closed" : "Kapalı")</span> @(isEnglish ? "fully reconciled" : "tamamen kapanmış") <span class="ek-d kismi">@(isEnglish ? "Partial" : "Kısmi")</span> @(isEnglish ? "partially paid" : "kısmi ödenmiş") <span class="ek-d acik">@(isEnglish ? "Open" : "Açık")</span> @(isEnglish ? "no reconciliation yet" : "henüz işlem görmemiş") · <span><i class="fas fa-square" style="color:#f8fafc;border:1px solid #cbd5e1"></i> @(isEnglish ? "opening" : "devir")</span> <span><i class="fas fa-square" style="color:#fffbeb;border:1px solid #fde68a"></i> @(isEnglish ? "open order" : "açık sipariş")</span></div>
                        </div>
                    </div>
                }
            }

            <div class="ek-ozet-izgara">
                <div class="ek-kart">
                    <div class="ek-kart-b"><i class="fas fa-building"></i>@(isEnglish ? "Company Based Balance Summary (TRY)" : "Şirket Bazlı Bakiye Özeti (TL)")</div>
                    <div class="ek-kart-g p0">
                        <table class="ek-ozet">
                            <thead><tr><th>@(isEnglish ? "Company" : "Şirket")</th><th class="text-right">@(isEnglish ? "Total Debit" : "Toplam Borç")</th><th class="text-right">@(isEnglish ? "Total Credit" : "Toplam Alacak")</th><th class="text-right">@(isEnglish ? "Net Balance" : "Net Bakiye")</th></tr></thead>
                            <tbody>
                                @foreach (var cGroup in companyGroupsForTotal)
                                {
                                    var cMovements = cGroup.Where(d => d.IslemTipi != "DB" && d.IslemTipi != "OB").ToList();
                                    var cDevir = cGroup.Where(d => d.IslemTipi == "DB" || d.IslemTipi == "OB").ToList();
                                    decimal cTotalBorc = cMovements.Sum(d => d.TRYB ?? 0) + cDevir.Where(d => (d.TRY_KmlBky ?? 0) > 0).Sum(d => d.TRY_KmlBky ?? 0);
                                    decimal cTotalAlacak = cMovements.Sum(d => d.TRYA ?? 0) + cDevir.Where(d => (d.TRY_KmlBky ?? 0) < 0).Sum(d => Math.Abs(d.TRY_KmlBky ?? 0));
                                    <tr><td><b>@cGroup.Key</b></td><td class="text-right borc">@cTotalBorc.ToString("N2", tr)</td><td class="text-right alacak">@cTotalAlacak.ToString("N2", tr)</td><td class="text-right net">@((cTotalBorc - cTotalAlacak).ToString("N2", tr))</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="ek-kart">
                    <div class="ek-kart-b"><i class="fas fa-chart-pie"></i>@(isEnglish ? "Cumulative Summary by Currency" : "Para Birimi Bazında Kümülatif Özet")</div>
                    <div class="ek-kart-g p0">
                        <table class="ek-ozet">
                            <thead><tr><th>@(isEnglish ? "Currency" : "Para Birimi")</th><th class="text-right">@(isEnglish ? "Debit (FC)" : "Borç (PB)")</th><th class="text-right">@(isEnglish ? "Credit (FC)" : "Alacak (PB)")</th><th class="text-right">@(isEnglish ? "Net (FC)" : "Net (PB)")</th><th class="text-right">@(isEnglish ? "Debit (TRY)" : "Borç (TL)")</th><th class="text-right">@(isEnglish ? "Credit (TRY)" : "Alacak (TL)")</th><th class="text-right">@(isEnglish ? "Net (TRY)" : "Net (TL)")</th></tr></thead>
                            <tbody>
                                @foreach (var pbGroup in currencyGroupsForTotal)
                                {
                                    var pbMovements = pbGroup.Where(d => d.IslemTipi != "DB" && d.IslemTipi != "OB").ToList();
                                    var pbDevir = pbGroup.Where(d => d.IslemTipi == "DB" || d.IslemTipi == "OB").ToList();
                                    decimal pbTotalBorc = pbGroup.Key == "TRY" ? pbMovements.Sum(d => d.TRYB ?? 0) + pbDevir.Where(d => (d.TRY_KmlBky ?? 0) > 0).Sum(d => d.TRY_KmlBky ?? 0) : pbMovements.Sum(d => d.IslemB ?? 0) + pbDevir.Where(d => (d.Islem_KmlBky ?? 0) > 0).Sum(d => d.Islem_KmlBky ?? 0);
                                    decimal pbTotalAlacak = pbGroup.Key == "TRY" ? pbMovements.Sum(d => d.TRYA ?? 0) + pbDevir.Where(d => (d.TRY_KmlBky ?? 0) < 0).Sum(d => Math.Abs(d.TRY_KmlBky ?? 0)) : pbMovements.Sum(d => d.IslemA ?? 0) + pbDevir.Where(d => (d.Islem_KmlBky ?? 0) < 0).Sum(d => Math.Abs(d.Islem_KmlBky ?? 0));
                                    decimal groupTotalBorcTRY = pbMovements.Sum(d => d.TRYB ?? 0) + pbDevir.Where(d => (d.TRY_KmlBky ?? 0) > 0).Sum(d => d.TRY_KmlBky ?? 0);
                                    decimal groupTotalAlacakTRY = pbMovements.Sum(d => d.TRYA ?? 0) + pbDevir.Where(d => (d.TRY_KmlBky ?? 0) < 0).Sum(d => Math.Abs(d.TRY_KmlBky ?? 0));
                                    <tr><td><b>@pbGroup.Key</b></td><td class="text-right borc">@pbTotalBorc.ToString("N2", tr)</td><td class="text-right alacak">@pbTotalAlacak.ToString("N2", tr)</td><td class="text-right net">@((pbTotalBorc - pbTotalAlacak).ToString("N2", tr))</td><td class="text-right borc">@groupTotalBorcTRY.ToString("N2", tr)</td><td class="text-right alacak">@groupTotalAlacakTRY.ToString("N2", tr)</td><td class="text-right net">@((groupTotalBorcTRY - groupTotalAlacakTRY).ToString("N2", tr))</td></tr>
                                }
                                <tr class="genel"><td colspan="4" class="text-right">@(isEnglish ? "ALL BPs GENERAL CUMULATIVE BALANCE (TRY)" : "TÜM CARİLER GENEL KÜMÜLATİF BAKİYE (TL)")</td><td class="text-right borc">@finalTotalBorcTRY.ToString("N2", tr)</td><td class="text-right alacak">@finalTotalAlacakTRY.ToString("N2", tr)</td><td class="text-right">@finalNetBalanceTRY.ToString("N2", tr)</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @if (bpRelatedAccountBalances.Any())
            {
                <div class="ek-kart">
                    <div class="ek-kart-b"><i class="fas fa-balance-scale-left"></i>@(isEnglish ? "Accounting Balances Summary (Accounts 159,340,420,440)" : "Muhasebe Hesap Bakiyeleri Özeti (120 / 320 / 159 / 340 / 420 / 440)")<span class="not">@(isEnglish ? $"Accounts matching BP '{bpName}'" : $"\"{bpName}\" ünvanıyla birebir eşleşen hesaplar")</span></div>
                    <div class="ek-kart-g p0">
                        <table class="ek-ozet">
                            <thead><tr>@if (isConsolidated) { <th>@(isEnglish ? "Company" : "Şirket")</th> }<th>@(isEnglish ? "Acc Code" : "Hesap Kodu")</th><th>@(isEnglish ? "Acc Name" : "Hesap Adı")</th><th class="text-right">@(isEnglish ? "Currency" : "Döviz")</th><th class="text-right">@(isEnglish ? "FC Balance" : "Döviz Bakiyesi")</th><th class="text-right">@(isEnglish ? "TL Equivalent" : "TL Karşılığı")</th></tr></thead>
                            <tbody>
                                @foreach (var bal in bpRelatedAccountBalances.OrderBy(b => b.CompanyName).ThenByDescending(b => b.TLBalance))
                                {
                                    <tr>@if (isConsolidated) { <td><b>@bal.CompanyName</b></td> }<td>@bal.AccountCode</td><td>@bal.AccountName</td><td class="text-right">@bal.Currency</td><td class="text-right">@(bal.Currency != "TRY" ? bal.CurrencyBalance.ToString("N2", tr) : "-")</td><td class="text-right @(bal.TLBalance < 0 ? "alacak" : "borc")">@bal.TLBalance.ToString("N2", tr)</td></tr>
                                }
                                <tr class="genel"><td colspan="@(isConsolidated ? 5 : 4)" class="text-right">@(isEnglish ? "GENERAL TL TOTAL BALANCE" : "GENEL TL TOPLAM BAKİYESİ")</td><td class="text-right">@totalBpRelatedAccountBalance.ToString("N2", tr) TRY</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
        else
        {
            @if (!string.IsNullOrEmpty((string)ViewBag.SorguHatasi))
            {
                <div class="ek-uyari hata"><i class="fas fa-triangle-exclamation"></i><div><b>@(isEnglish ? "Query error:" : "Sorgu hatası:")</b> @ViewBag.SorguHatasi</div></div>
            }
            else
            {
                <div class="ek-kart"><div class="ek-bos"><i class="fas fa-inbox"></i>@(isEnglish ? "No records found. Please check your filter options." : "Kayıt bulunamadı. Süzgeç seçeneklerini kontrol edin.")</div></div>
            }
        }
    }
    else
    {
        <div class="ek-kart"><div class="ek-bos"><i class="fas fa-hand-pointer"></i>@(isEnglish ? "Select a BP and click 'Generate Report' to view the statement." : "Bir cari seçip \"Raporla\" düğmesine basın; ekstre burada listelenir.")</div></div>
    }
</div>

<!-- Mutabakat (Kapama) Modal -->
<div class="modal fade" id="reconModal" tabindex="-1" aria-labelledby="reconModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xxl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="reconModalLabel"><i class="fas fa-handshake me-2"></i> @(isEnglish ? "Reconciliation Center" : "Mutabakat / Kapama Merkezi") (@selectedBpCode)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="d-flex flex-wrap justify-content-between mb-3">
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-dark fw-bold" onclick="triggerAutoReconciliation()">
                            <i class="fas fa-robot text-warning me-1"></i> @(isEnglish ? "Auto Reconcile" : "Otomatik Kapat")
                        </button>
                        <div id="currencyFilterContainer" class="d-flex flex-wrap gap-2 ms-2" style="display: none;"></div>
                    </div>
                    <button class="btn btn-danger fw-bold" onclick="triggerCancelAllReconciliations()">
                        <i class="fas fa-undo me-1"></i> @(isEnglish ? "Cancel All" : "Tümünü İptal Et")
                    </button>
                </div>
                
                <div id="divTransactions" style="display: none;"></div>

                <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 p-3 bg-white border rounded shadow-sm">
                    <div class="d-flex flex-wrap gap-3 mb-2 mb-md-0">
                        <div class="summary-box border-danger border-opacity-50 border-start border-4">
                            <span class="text-muted d-block small fw-bold text-uppercase"><i class="fas fa-arrow-down text-danger me-1"></i> @(isEnglish ? "Selected Debit" : "Seçilen Borç")</span>
                            <span class="h5 mb-0 fw-bold text-danger" id="lblTotalDebit">0,00 ₺</span>
                        </div>
                        <div class="summary-box border-success border-opacity-50 border-start border-4">
                            <span class="text-muted d-block small fw-bold text-uppercase"><i class="fas fa-arrow-up text-success me-1"></i> @(isEnglish ? "Selected Credit" : "Seçilen Alacak")</span>
                            <span class="h5 mb-0 fw-bold text-success" id="lblTotalCredit">0,00 ₺</span>
                        </div>
                        <div class="summary-box ms-md-3 bg-light border border-secondary">
                            <span class="text-muted d-block small fw-bold text-uppercase">@(isEnglish ? "Balance Difference" : "Kalan Bakiye Farkı")</span>
                            <span class="h4 mb-0 fw-bold text-dark" id="lblDifference">0,00 ₺</span>
                        </div>
                    </div>
                    <button class="btn btn-secondary btn-lg fw-bold shadow" id="btnReconcile" onclick="performManualReconciliation()" disabled>
                        <i class="fas fa-check-double me-2"></i> @(isEnglish ? "Reconcile Selected" : "Seçilenleri Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mutabakatı Veritabanına Kaydet Modal -->
<div class="modal fade" id="mutabakatKayitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-save me-2"></i> @(isEnglish ? "Save Reconciliation" : "Mutabakatı Kaydet")</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold text-dark">@(isEnglish ? "Reconciliation Date" : "Mutabakat Tarihi")</label>
                    <input type="date" class="form-control border-secondary" id="txtMutabakatTarih" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-dark">@(isEnglish ? "Agreed Balance (TRY)" : "Mutabık Kalınan Bakiye (TRY)")</label>
                    <div class="input-group">
                        @* type="number" tarayıcı dilinde (en-US) virgülü reddediyordu; metin kutusu + sayısal klavye: "15.450,50" ya da "15450,50" yazılabilir *@
                        <input type="text" inputmode="decimal" autocomplete="off" class="form-control border-secondary" id="txtMutabakatBakiye" placeholder="Örn: 15.450,50" pattern="^-?[0-9.,]+$" title="Örn: 15.450,50 veya 15450,50">
                        <span class="input-group-text bg-light border-secondary fw-bold">₺</span>
                    </div>
                    <small class="text-muted mt-1 d-block"><i class="fas fa-info-circle text-info"></i> @(isEnglish ? "Enter positive for debit, negative (-) for credit." : "Borç bakiyesi için pozitif, alacak bakiyesi için negatif (-) değer girebilirsiniz.")</small>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> @(isEnglish ? "Cancel" : "İptal")</button>
                <button type="button" class="btn btn-success fw-bold" onclick="saveManualMutabakat()"><i class="fas fa-check me-1"></i> @(isEnglish ? "Save & Close" : "Kaydet ve Kapat")</button>
            </div>
        </div>
    </div>
</div>

<!-- Cari Notlar Modal -->
