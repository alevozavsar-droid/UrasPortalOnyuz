@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();
        const currentBpCode = '@selectedBpCode';
        const dbParam = '@currentDb';
        const dbQueryString = dbParam ? '?db=' + dbParam : '';
        const isConsolidatedJS = @(isConsolidated.ToString().ToLower());
        const isEnglishJS = @(isEnglish.ToString().ToLower());
        
        let currentTargetDb = dbParam;
        let robotInterval = null;

        (function () {
            var fixGlobalFunction = function (functionName) {
                if (window[functionName]) {
                    var originalFunction = window[functionName];
                    window[functionName] = function () {
                        var table = document.querySelector('.rapor-tablo');
                        if (table) { originalFunction.apply(this, arguments); }
                    };
                }
            };
            fixGlobalFunction('applyColumnConfig');
            fixGlobalFunction('loadAndApplyColumnConfig');
        })();

        function copyToClipboard(elementId, btnElement) {
            var textElement = document.getElementById(elementId);
            if (!textElement) return;

            var tempInput = document.createElement("textarea");
            tempInput.value = textElement.innerText || textElement.textContent;
            document.body.appendChild(tempInput);
            tempInput.select();

            try {
                document.execCommand("copy");
                var originalHtml = btnElement.innerHTML;
                btnElement.innerHTML = '<i class="fas fa-check text-success"></i>';
                btnElement.classList.add('border-success');
                setTimeout(function() {
                    btnElement.innerHTML = originalHtml;
                    btnElement.classList.remove('border-success');
                }, 1500);
            } catch (err) {
                alert(isEnglishJS ? "Could not copy." : "Kopyalama yapılamadı.");
            }
            document.body.removeChild(tempInput);
        }

        $(document).ready(function () {
            // Modaller sayfa gövdesinin (.main-content > .table-container) içinde kalırsa,
            // Bootstrap backdrop'u body'ye eklediği için modalin üstüne biniyor:
            // ekran bulanık ve tıklanamaz görünüyor. Hepsini doğrudan body'ye taşıyoruz.
            $('.modal').each(function () {
                var $m = $(this);
                if (!$m.parent().is('body')) $m.appendTo('body');
            });

            $('#bpCode').select2({
                theme: "bootstrap-5",
                width: '100%',
                closeOnSelect: false,
                allowClear: true,
                placeholder: isEnglishJS ? "-- Select one or more BPs --" : "-- Cari seçiniz (birden fazla seçebilirsiniz) --"
            });
            $('#aktarimTipi').select2({ theme: "bootstrap-5", width: '100%', placeholder: isEnglishJS ? "Select Transfer Type" : "Aktarım Tipi Seçiniz", closeOnSelect: false, allowClear: true });
            $('#bakiyeDurumu').select2({ theme: "bootstrap-5", width: '100%', placeholder: isEnglishJS ? "Select Status" : "Durum Seçiniz", closeOnSelect: false, allowClear: true });

            // Seçilenleri tek tek göstermek yerine "N seçildi" özeti bas.
            function secimOzetiGuncelle(secici, birim) {
                var $s = $(secici);
                if (!$s.length) return;

                var adet = ($s.val() || []).length;
                var $kutu = $s.next('.select2-container').find('.select2-selection__rendered');

                $kutu.find('.secim-ozet-li').remove();
                if (adet > 0) {
                    var metin = isEnglishJS ? (adet + ' selected') : (adet + ' ' + birim + ' seçildi');
                    $kutu.prepend('<li class="secim-ozet-li"><span class="secim-ozet">' + metin + '</span></li>');
                }
            }

            var ozetAlanlari = [
                { sec: '#bpCode', birim: 'cari' },
                { sec: '#aktarimTipi', birim: 'tip' },
                { sec: '#bakiyeDurumu', birim: 'durum' }
            ];

            ozetAlanlari.forEach(function (a) {
                secimOzetiGuncelle(a.sec, a.birim);
                $(a.sec).on('change select2:select select2:unselect select2:clear', function () {
                    secimOzetiGuncelle(a.sec, a.birim);
                });
            });

            $('.select2-email').select2({
                theme: "bootstrap-5",
                allowClear: true,
                dropdownParent: $('#notesModal'),
                tags: true,
                tokenSeparators: [',', ';', ' '],
                width: '100%'
            });

            $('#chkIsTask').change(function() {
                var isTask = $(this).is(':checked');
                if (isTask) {
                    $('#taskEmailSection').slideDown(300);
                } else {
                    $('#taskEmailSection').slideUp(300);
                    $('#txtAssigneeEmail').val(null).trigger('change');
                }
            });
        });

        // Arayüzdeki Sisteme UDF Kur Butonu Tıklanma Eventi
        function setupRapor20Udfs() {
            Swal.fire({ title: isEnglishJS ? 'Setting up UDFs...' : 'UDF\'ler Kuruluyor...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
            
            $.post('/Rapor20/SetupRapor20UDFs', { __RequestVerificationToken: antiForgeryToken }, function (response) {
                if (response.success) {
                    Swal.fire(isEnglishJS ? 'Success' : 'Başarılı', response.message, 'success');
                } else {
                    Swal.fire(isEnglishJS ? 'Error' : 'Hata', response.message, 'error');
                }
            }).fail(function() {
                Swal.fire(isEnglishJS ? 'Error' : 'Hata', 'Sunucu ile iletişim kurulamadı.', 'error');
            });
        }

        /* CRM NOTLARI VE İŞLEM JS METOTLARI */
        function openNotesModal() {
            if (!currentBpCode) return;
            var notesModal = new bootstrap.Modal(document.getElementById('notesModal'));
            notesModal.show();
            loadNotes();
        }

        function loadNotes() {
            $('#notesHistoryList').html('<div class="text-center text-muted fst-italic my-4">' + (isEnglishJS ? 'Loading...' : 'Yükleniyor...') + '</div>');
            $.ajax({
                url: '/Rapor20/GetCariNotlar' + dbQueryString,
                type: 'GET',
                data: { cardCode: currentBpCode },
                success: function(res) {
                    if (res.success && res.data.length > 0) {
                        var html = '';
                        res.data.forEach(function(note) {
                            var isTask = note.durum !== 'Bilgi';
                            var isPending = note.durum === 'Bekliyor';
                            var bubbleClass = isTask ? (isPending ? 'task-pending' : 'task-done') : '';
                            var icon = isTask ? (isPending ? '<i class="fas fa-hourglass-half text-warning"></i>' : '<i class="fas fa-check-circle text-success"></i>') : '<i class="fas fa-info-circle text-info"></i>';
                            
                            var assignInfo = note.atananMail ? `<span class="badge bg-secondary ms-2"><i class="fas fa-arrow-right"></i> ${note.atananMail}</span>` : '';
                            
                            var actionBtn = isPending ? `<button class="btn btn-sm btn-success float-end mt-2" onclick="markTaskDone(${note.id})"><i class="fas fa-check"></i> ${isEnglishJS ? 'Mark as Done' : 'Tamamlandı İşaretle'}</button>` : '';
                            var doneDate = note.tamamlanmaTarihi ? `<div class="mt-2 small text-success fw-bold"><i class="fas fa-check-double"></i> ${isEnglishJS ? 'Task Completed' : 'İşlem Tamamlandı'} (${note.tamamlanmaTarihi})</div>` : '';
                            
                            var safeText = encodeURIComponent(note.notIcerigi);
                            var editBtn = `<button class="btn btn-sm btn-outline-primary float-end mt-2 me-2" onclick="editNotePrompt(${note.id}, decodeURIComponent('${safeText}'))"><i class="fas fa-edit"></i> ${isEnglishJS ? 'Edit' : 'Düzenle'}</button>`;

                            html += `
                            <div class="note-bubble shadow-sm ${bubbleClass}">
                                <div class="note-meta d-flex justify-content-between align-items-center">
                                    <div>
                                        ${icon} <strong>${note.kullanici}</strong> (${note.sirket}) ${assignInfo}
                                    </div>
                                    <span><i class="far fa-clock"></i> ${note.tarih}</span>
                                </div>
                                <div class="mt-2 text-dark" style="white-space: pre-wrap;">${note.notIcerigi}</div>
                                ${doneDate}
                                ${actionBtn}
                                ${editBtn}
                                <div class="clearfix"></div>
                            </div>`;
                        });
                        $('#notesHistoryList').html(html);
                    } else {
                        $('#notesHistoryList').html('<div class="text-center text-muted fst-italic my-4">' + (isEnglishJS ? 'No records yet for this BP.' : 'Henüz bu cari için bir kayıt yok.') + '</div>');
                    }
                },
                error: function() { $('#notesHistoryList').html('<div class="text-danger text-center my-4">' + (isEnglishJS ? 'An error occurred while loading notes.' : 'Notlar yüklenirken bir hata oluştu.') + '</div>'); }
            });
        }

        function editNotePrompt(id, currentText) {
            Swal.fire({
                title: isEnglishJS ? 'Edit Note' : 'Notu Düzenle',
                input: 'textarea',
                inputValue: currentText,
                showCancelButton: true,
                confirmButtonText: `<i class="fas fa-save"></i> ${isEnglishJS ? 'Update' : 'Güncelle'}`,
                cancelButtonText: isEnglishJS ? 'Cancel' : 'İptal',
                confirmButtonColor: '#0d6efd'
            }).then((result) => {
                if (result.isConfirmed && result.value) {
                    $.ajax({
                        url: '/Rapor20/UpdateCariNot' + dbQueryString,
                        type: 'POST',
                        headers: { 'RequestVerificationToken': antiForgeryToken },
                        data: { noteId: id, noteContent: result.value },
                        success: function(res) {
                            if(res.success) {
                                Swal.fire(isEnglishJS ? 'Success' : 'Başarılı', res.message, 'success');
                                loadNotes();
                            } else {
                                Swal.fire(isEnglishJS ? 'Error' : 'Hata', res.message, 'error');
                            }
                        }
                    });
                }
            });
        }

        function saveNewNote() {
            var note = $('#txtNewNote').val().trim();
            var assignerVals = $('#txtAssignerEmail').val();
            var assigneeVals = $('#txtAssigneeEmail').val();
            
            var assignerEmail = assignerVals ? (Array.isArray(assignerVals) ? assignerVals.join(',') : assignerVals) : '';
            var assigneeEmail = assigneeVals ? (Array.isArray(assigneeVals) ? assigneeVals.join(',') : assigneeVals) : '';

            var isTask = $('#chkIsTask').is(':checked');
            var files = $('#fileAttachments')[0].files;

            if (!note) {
                Swal.fire(isEnglishJS ? 'Missing Info' : 'Eksik Bilgi', isEnglishJS ? 'Please write note or task content.' : 'Lütfen işlem / not içeriğini yazınız.', 'warning');
                return;
            }

            if (isTask && !assigneeEmail) {
                Swal.fire(isEnglishJS ? 'Missing Info' : 'Eksik Bilgi', isEnglishJS ? 'You must select assignee email for a task.' : 'İşlem ataması için atanan kişinin mail adresini seçmelisiniz.', 'warning');
                return;
            }

            var btn = event.currentTarget;
            var originalText = btn.innerHTML;
            $(btn).prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> ' + (isEnglishJS ? 'Saving...' : 'Kaydediliyor...'));

            var formData = new FormData();
            formData.append('cardCode', currentBpCode);
            formData.append('note', note);
            formData.append('assignerEmail', assignerEmail);
            formData.append('assigneeEmail', assigneeEmail);
            formData.append('isTask', isTask);

            for (var i = 0; i < files.length; i++) {
                formData.append('attachments', files[i]);
            }

            $.ajax({
                url: '/Rapor20/AddCariNot' + dbQueryString,
                type: 'POST',
                headers: { 'RequestVerificationToken': antiForgeryToken },
                data: formData,
                contentType: false,
                processData: false,
                success: function(res) {
                    if(res.success) {
                        $('#txtNewNote').val('');
                        $('#chkIsTask').prop('checked', false).trigger('change'); 
                        $('#txtAssigneeEmail').val(null).trigger('change');
                        $('#fileAttachments').val(''); 
                        loadNotes();
                        Swal.fire({ title: isEnglishJS ? 'Success' : 'Başarılı', text: res.message, icon: 'success', timer: 2000, showConfirmButton: false });
                        $('.fa-cloud').parent().removeClass('btn-outline-secondary').addClass('btn-warning text-dark');
                    } else {
                        Swal.fire(isEnglishJS ? 'Error' : 'Hata', res.message, 'error');
                    }
                },
                error: function() { Swal.fire(isEnglishJS ? 'Error' : 'Hata', isEnglishJS ? 'Could not communicate with server.' : 'Sunucu ile iletişim kurulamadı.', 'error'); },
                complete: function() { $(btn).prop('disabled', false).html(originalText); }
            });
        }

        function markTaskDone(noteId) {
            Swal.fire({
                title: isEnglishJS ? 'Complete Task' : 'İşlemi Tamamla', 
                text: isEnglishJS ? "Mark this task as completed? (Email will be sent to the assigner.)" : "Bu işlem tamamlandı olarak işaretlensin mi? (İşlemi atayan kişiye mail gidecektir.)", 
                icon: 'question', 
                showCancelButton: true, 
                confirmButtonColor: '#198754', 
                confirmButtonText: isEnglishJS ? 'Yes, Completed' : 'Evet, Tamamlandı',
                cancelButtonText: isEnglishJS ? 'Cancel' : 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Rapor20/MarkCariNotAsDone', type: 'POST', data: { noteId: noteId },
                        success: function (res) {
                            if (res.success) { 
                                Swal.fire(isEnglishJS ? 'Success' : 'Başarılı', res.message, 'success'); 
                                loadNotes(); 
                            } 
                            else { Swal.fire(isEnglishJS ? 'Error' : 'Hata', res.message, 'error'); }
                        }
                    });
                }
            });
        }

        /* MANUEL MUTABAKAT KAYDET JS METOTLARI */
        function checkAndOpenMutabakatModal() {
            if (!currentBpCode) return;
            Swal.fire({ title: isEnglishJS ? 'Checking Open Transactions' : 'Açık İşlem Kontrolü', text: isEnglishJS ? 'Checking open documents in system...' : 'Sistemdeki açık belgeler kontrol ediliyor...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

            $.ajax({
