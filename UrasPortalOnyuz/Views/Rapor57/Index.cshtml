@section Scripts {
    <script>
        const fmt = (n) => new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
        
        // 1. KURAL JS DEĞİŞKENİ
        const activeDbCode = '@currentDb';

        // --- GELİŞTİRİLMİŞ TABLO VE FİLTRELEME SİSTEMİ ---

        document.addEventListener("DOMContentLoaded", function() {
            // Tabloyu başlat
            document.querySelectorAll('.table-container table').forEach(table => {
                initExcelTable(table);
            });

            // İlk açılışta numaralandır
            renumberAllTables();

            // Filtre dışına tıklayınca kapat
            document.addEventListener('click', function(e) {
                if (!e.target.closest('.filter-dropdown') && !e.target.closest('.filter-btn')) {
                    closeAllDropdowns();
                }
            });

            // Enter ile kaydet
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && e.target.classList.contains('editable-cell')) {
                    e.preventDefault(); e.target.blur();
                }
            });
        });

        // --- HESAPLAMA & SEÇİM ---
        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('row-select') || e.target.classList.contains('select-all-btn')) {
                calculateSelection();
            }
        });

        function toggleSelectAll(masterCheckbox) {
            const table = masterCheckbox.closest('table');
            const checkboxes = table.querySelectorAll('.row-select');
            checkboxes.forEach(cb => {
                if (cb.closest('tr').style.display !== 'none') {
                    cb.checked = masterCheckbox.checked;
                }
            });
            calculateSelection();
        }

        function calculateSelection() {
            const activeTabPane = document.querySelector('.tab-pane.active');
            if (!activeTabPane) return;

            const checkboxes = activeTabPane.querySelectorAll('.row-select:checked');
            const summaryBar = document.getElementById('selectionSummary');

            if (checkboxes.length === 0) {
                summaryBar.style.display = 'none';
                return;
            }

            summaryBar.style.display = 'flex';

            let tNet25 = 0, tCost25 = 0;
            let tNet26 = 0, tCost26 = 0;
            let count = 0;

            checkboxes.forEach(cb => {
                const row = cb.closest('tr');
                if (row.style.display === 'none') return;

                let net25 = 0, cost25 = 0;
                // Özet tablosunda
                if(row.querySelector('.calc25-topnet')) {
                    net25 = parseMoney(row.querySelector('.calc25-topnet').innerText);
                    cost25 = parseMoney(row.querySelector('.calc25-maliyet').innerText);
                } else {
                    // Diğer tablolarda
                    if(row.querySelector('.calc25-topnet')) net25 = parseMoney(row.querySelector('.calc25-topnet').innerText);
                    if(row.querySelector('.calc25-maliyet')) cost25 = parseMoney(row.querySelector('.calc25-maliyet').innerText);
                }

                let net26 = 0, cost26 = 0;
                if(row.querySelector('.calc26-topnet')) net26 = parseMoney(row.querySelector('.calc26-topnet').innerText);
                if(row.querySelector('.calc26-maliyet')) cost26 = parseMoney(row.querySelector('.calc26-maliyet').innerText);

                if(net25 > 0 || cost25 > 0 || net26 > 0 || cost26 > 0) {
                    count++;
                    tNet25 += net25;
                    tCost25 += cost25;
                    tNet26 += net26;
                    tCost26 += cost26;
                }
            });

            let diffCost = tCost26 - tCost25;
            let percCost = tCost25 > 0 ? (diffCost / tCost25) * 100 : 0;

            document.getElementById('sum-count').innerText = count;
            document.getElementById('sum-net-25').innerText = fmt(tNet25);
            document.getElementById('sum-cost-25').innerText = fmt(tCost25);
            document.getElementById('sum-net-26').innerText = fmt(tNet26);
            document.getElementById('sum-cost-26').innerText = fmt(tCost26);
            document.getElementById('sum-diff').innerText = fmt(diffCost);
            document.getElementById('sum-perc').innerText = "%" + fmt(percCost);
        }

        function parseMoney(text) {
            if (!text) return 0;
            let clean = text.trim();
            const lastDot = clean.lastIndexOf('.');
            const lastComma = clean.lastIndexOf(',');
            if (lastDot > lastComma) {
                clean = clean.replace(/,/g, '');
            } else {
                clean = clean.replace(/\./g, '').replace(',', '.');
            }
            return parseFloat(clean.replace(/[^0-9.-]/g, '')) || 0;
        }

        // --- DİNAMİK SIRA NO ---
        function renumberAllTables() {
            document.querySelectorAll('.table-container table').forEach(table => {
                renumberRows(table);
            });
        }

        function renumberRows(table) {
            const rows = table.querySelectorAll('tbody tr');
            let counter = 1;
            rows.forEach(row => {
                if (row.style.display !== 'none') {
                    const indexCell = row.querySelector('.row-index');
                    if (indexCell) {
                        indexCell.innerText = counter++;
                    }
                }
            });
        }

        // --- TABLO BAŞLATMA (Excel Benzeri Yapı) ---
        function initExcelTable(table) {
            table.activeFilters = {};

            const rows = table.querySelectorAll('thead tr');
            if (!rows.length) return;   // başlıksız tablo (kabuğun .table-container kabı içindeki yardımcı tablolar) atlanır
            const matrix = [];
            for(let r=0; r<rows.length; r++) matrix[r] = [];

            rows.forEach((tr, rowIndex) => {
                let colCounter = 0;
                Array.from(tr.children).forEach(th => {
                    while(matrix[rowIndex][colCounter]) colCounter++;
                    const rowspan = parseInt(th.getAttribute('rowspan') || 1);
                    const colspan = parseInt(th.getAttribute('colspan') || 1);
                    for(let r=0; r<rowspan; r++) {
                        for(let c=0; c<colspan; c++) {
                            if (matrix[rowIndex + r]) matrix[rowIndex + r][colCounter + c] = th;
                        }
                    }
                });
            });

            const colCount = matrix[0].length;
            const leafHeaders = [];
            for(let c=0; c<colCount; c++) {
                for(let r=rows.length-1; r>=0; r--) {
                    if(matrix[r][c]) {
                        const existing = leafHeaders.find(x => x.th === matrix[r][c]);
                        if(!existing) leafHeaders.push({ th: matrix[r][c], colIndex: c });
                        break;
                    }
                }
            }

            leafHeaders.forEach(item => {
                const th = item.th;
                const colIndex = item.colIndex;
                const originalText = th.innerText.trim();

                if (th.querySelector('input') || originalText === "Sıra" || originalText === "Detay") return;

                if (!th.querySelector('.th-content')) {
                    th.innerHTML = '';
                    const container = document.createElement('div');
                    container.className = 'th-content';

                    const textSpan = document.createElement('span');
                    textSpan.innerText = originalText;
                    textSpan.style.flexGrow = "1";

                    const iconDiv = document.createElement('div');
                    iconDiv.innerHTML = '<i class="fas fa-sort sort-icon"></i>';

                    const filterIcon = document.createElement('i');
                    filterIcon.className = "fas fa-filter filter-btn ms-2 text-muted";
                    filterIcon.onclick = (e) => {
                        e.stopPropagation();
                        openFilter(filterIcon, colIndex);
                    };

                    container.appendChild(textSpan);
                    container.appendChild(iconDiv);
                    container.appendChild(filterIcon);

                    container.onclick = () => runSort(table, th, colIndex);
                    th.appendChild(container);
                }
            });
        }

        function runSort(table, th, colIndex) {
            const tbody = table.querySelector('tbody');
            const rows = Array.from(tbody.querySelectorAll('tr'));
            let asc = !th.classList.contains('sort-asc');

            table.querySelectorAll('thead th').forEach(h => {
                h.classList.remove('sort-asc', 'sort-desc');
                const icon = h.querySelector('.sort-icon');
                if(icon) icon.className = 'fas fa-sort sort-icon';
            });

            th.classList.add(asc ? 'sort-asc' : 'sort-desc');
            const currentIcon = th.querySelector('.sort-icon');
            if(currentIcon) currentIcon.className = asc ? 'fas fa-sort-up sort-icon' : 'fas fa-sort-down sort-icon';

            rows.sort((rowA, rowB) => {
                const cellA = rowA.children[colIndex] ? rowA.children[colIndex].innerText.trim() : "";
                const cellB = rowB.children[colIndex] ? rowB.children[colIndex].innerText.trim() : "";

                const numA = parseMoney(cellA);
                const numB = parseMoney(cellB);

                const isNumA = !isNaN(parseFloat(cellA.replace(/[^0-9,-]/g, ''))) && cellA !== "";
                const isNumB = !isNaN(parseFloat(cellB.replace(/[^0-9,-]/g, ''))) && cellB !== "";

                if (isNumA && isNumB) {
                    return asc ? numA - numB : numB - numA;
                } else {
                    return asc ? cellA.localeCompare(cellB, 'tr') : cellB.localeCompare(cellA, 'tr');
                }
            });

            rows.forEach(row => tbody.appendChild(row));
            renumberRows(table);
        }

        // --- KÜMÜLATİF FİLTRELEME ---

        function openFilter(btn, colIndex) {
            closeAllDropdowns();
            const th = btn.closest('th');
            const table = th.closest('table');
            const rows = Array.from(table.querySelectorAll('tbody tr'));

            const uniqueValues = new Set();
            rows.forEach(row => {
                const cell = row.children[colIndex];
                const val = cell ? cell.innerText.trim() : "";
                uniqueValues.add(val);
            });
            const sortedValues = Array.from(uniqueValues).sort();

            const dropdown = document.createElement('div');
            dropdown.className = 'filter-dropdown';

            let html = `
                <input type="text" class="filter-search-box" placeholder="Ara..." onkeyup="filterSearch(this)">
                <div class="filter-actions">
                    <a onclick="toggleFilterSelectAll(this, true)">Tümünü Seç</a>
                    <a onclick="toggleFilterSelectAll(this, false)">Temizle</a>
                    <a class="text-danger" onclick="closeAllDropdowns()" style="margin-left:auto">Kapat X</a>
                </div>
                <div class="filter-options-container">
            `;

            const currentFilters = table.activeFilters[colIndex];

            sortedValues.forEach(val => {
                let isChecked = true;
                if (currentFilters && !currentFilters.includes(val)) {
                    isChecked = false;
                }

                let displayVal = val === "" ? "(Boş)" : val;
                html += `<label class="filter-option">
                            <input type="checkbox" value="${val}" ${isChecked ? 'checked' : ''} onchange="applyMultiFilter(this, ${colIndex})">
                            <span>${displayVal}</span>
                         </label>`;
            });
            html += `</div>`;

            dropdown.innerHTML = html;
            document.body.appendChild(dropdown);

            const rect = btn.getBoundingClientRect();
            dropdown.style.left = rect.left + 'px';
            dropdown.style.top = (rect.bottom + 5) + 'px';
            dropdown.style.display = 'block';

            dropdown.currentTable = table;
        }

        function applyMultiFilter(checkbox, colIndex) {
            const dropdown = checkbox.closest('.filter-dropdown');
            const table = dropdown.currentTable;

            const checkedBoxes = dropdown.querySelectorAll('.filter-options-container input[type="checkbox"]:checked');
            const allowedValues = Array.from(checkedBoxes).map(cb => cb.value);
            const allBoxes = dropdown.querySelectorAll('.filter-options-container input[type="checkbox"]');

            if (checkedBoxes.length === allBoxes.length) {
                delete table.activeFilters[colIndex];
            } else {
                table.activeFilters[colIndex] = allowedValues;
            }

            runTableFiltering(table);
        }

        function runTableFiltering(table) {
            const rows = table.querySelectorAll('tbody tr');
            const filterKeys = Object.keys(table.activeFilters);

            rows.forEach(row => {
                let isVisible = true;

                for (const colIdx of filterKeys) {
                    const allowedVals = table.activeFilters[colIdx];
                    const cellText = row.children[colIdx] ? row.children[colIdx].innerText.trim() : "";

                    if (!allowedVals.includes(cellText)) {
                        isVisible = false;
                        break;
                    }
                }

                row.style.display = isVisible ? '' : 'none';
            });

            calculateSelection();
            renumberRows(table);
        }

        window.filterSearch = function(input) {
            const filterText = input.value.toLowerCase();
            const options = input.parentElement.querySelectorAll('.filter-option');
            options.forEach(opt => {
                const txt = opt.querySelector('span').innerText.toLowerCase();
                opt.style.display = txt.includes(filterText) ? 'block' : 'none';
            });
        }

        window.toggleFilterSelectAll = function(btn, selectAll) {
            const dropdown = btn.closest('.filter-dropdown');
            const checkboxes = dropdown.querySelectorAll('.filter-options-container input[type="checkbox"]');

            checkboxes.forEach(cb => {
                if(cb.parentElement.style.display !== 'none') {
                    cb.checked = selectAll;
                }
            });

            if(checkboxes.length > 0) {
                const onchangeAttr = checkboxes[0].getAttribute('onchange');
                const match = onchangeAttr.match(/applyMultiFilter\(this, (\d+)\)/);
                if(match && match[1]) {
                    applyMultiFilter(checkboxes[0], parseInt(match[1]));
                }
            }
        }

        function closeAllDropdowns() {
            document.querySelectorAll('.filter-dropdown').forEach(el => el.remove());
        }

        // --- VERİ KAYIT ---
        async function saveCell(el) {
            const docEntry = el.getAttribute('data-id') || el.closest('tr').getAttribute('data-id');
            const field = el.getAttribute('data-field');
            const value = el.innerText.trim();
            el.style.backgroundColor = "#fff9c4";

            let formData = new FormData();
            formData.append('docEntry', docEntry);
            formData.append('field', field);
            formData.append('value', value);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            try {
                // 1. KURAL: Fetch isteklerine merkezi ?db= parametresi eklendi
                await fetch('/Rapor57/UpdateCell?db=' + activeDbCode, { method: 'POST', body: formData });
                el.style.backgroundColor = "#d4edda";
                setTimeout(() => el.style.backgroundColor = "", 500);

                if (field.includes("Zam") || field.includes("Ucret")) {
                    await updateRow(docEntry);
                }
                calculateSelection();
            } catch (err) {
                el.style.backgroundColor = "#f8d7da";
            }
        }

        async function updateRow(id) {
            try {
                // 1. KURAL: Fetch isteklerine merkezi ?db= parametresi eklendi
                const r = await fetch('/Rapor57/GetBordroDetay?docEntry=' + id + '&db=' + activeDbCode);
                const d = await r.json();
                updateVal('cell-xnet-26-' + id, d.valXNet26);
                updateVal('cell-topnet-26-' + id, d.valTopNet26);
                updateVal('cell-rnet-26-' + id, d.valRNet26);
                updateVal('cell-brut-26-' + id, d.valBrut26);
                updateVal('cell-maliyet-26-' + id, d.valMaliyet26);
                updateVal('cell-netartis-' + id, d.valNetArtis);
                updateVal('cell-malartis-' + id, d.valMalArtis);
                updateVal('detay-maliyet-26-' + id, d.valMaliyet26);
            } catch(e) { console.error(e); }
        }

        function updateVal(elId, val) {
            const el = document.getElementById(elId);
            if (el) {
                el.innerText = fmt(val);
                el.classList.remove("flash-anim");
                void el.offsetWidth;
                el.classList.add("flash-anim");
            }
        }

        function openBordroModal(id) {
            var modal = new bootstrap.Modal(document.getElementById('bordroModal'));
            modal.show();
            // 1. KURAL: Fetch isteklerine merkezi ?db= parametresi eklendi
            fetch('/Rapor57/GetBordroDetay?docEntry=' + id + '&db=' + activeDbCode).then(r=>r.json()).then(d=>{
                document.getElementById('mAdSoyad').innerText = d.adSoyad;
                document.getElementById('mEskiRNet').innerText = fmt(d.modalEskiRNet);
                document.getElementById('mZam').innerText = "%" + fmt(d.modalZam);
                document.getElementById('mYeniRNet').innerText = fmt(d.valRNet26);
                document.getElementById('mXNet').innerText = fmt(d.modalXNet);
                document.getElementById('mTopNet').innerText = fmt(d.valTopNet26);
                document.getElementById('mBrut').innerText = fmt(d.valBrut26);
                document.getElementById('mSgkIsci').innerText = fmt(d.modalSgkIsci);
                document.getElementById('mGv').innerText = fmt(d.modalGv);
                document.getElementById('mIsvSgk').innerText = fmt(d.modalSgkIsv);
                document.getElementById('mMaliyet').innerText = fmt(d.valMaliyet26);
            });
        }
    </script>
}