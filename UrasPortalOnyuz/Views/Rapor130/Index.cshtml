@section Scripts {
    <script>
        // Bulanık/tıklanamaz pencere düzeltmesi.
        // Layout @@RenderBody()'yi .table-container içinde render ediyor; bu
        // sayfadaki .table-container kuralı oraya da uyduğu için oluşan
        // stacking context modali backdrop'un altında bırakıyordu.
        (function modalleriBodyeTasi() {
            var idler = ['odenenlerModal', 'sistemLoglariModal', 'logModal', 'detayModal', 'pdfPreviewModal'];
            idler.forEach(function (id) {
                var el = document.getElementById(id);
                if (el && el.parentElement !== document.body) {
                    document.body.appendChild(el);
                }
            });
        })();
    </script>

    <!-- SweetAlert2 (Şık Uyarı Mesajları İçin) -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        // Uyarı Fonksiyonu
        function ShowMutabakatAlert() {
            Swal.fire({
                icon: 'warning',
                title: 'İşlem Engellendi',
                text: 'Cari ekstreden mutabakatı kaydet işlemi yapmalısınız.',
                confirmButtonText: 'Tamam'
            });
        }

        $(document).ready(function () {
            
            const csrfToken = $('input[name="__RequestVerificationToken"]').val();

            // Mutabakat ve Notlar için AJAX Güncelleme
            $(document).on('change', '.mutabakat-select', function() {
                var btn = $(this);
                var val = btn.val();
                var docEntry = btn.data('docentry');
                var dbName = btn.data('dbname');

                btn.prop('disabled', true);

                $.ajax({
                    url: '/Rapor130/UpdateMutabakatVeNot',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': csrfToken },
                    data: JSON.stringify({
                        DbName: dbName,
                        DocEntry: docEntry,
                        MutabakatDurumu: val,
                        YeniNot: null
                    }),
                    success: function(res) {
                        btn.prop('disabled', false);
                        if(res.success) {
                            toastr.success('Mutabakat durumu güncellendi.');
                            if(val === 'Mutabık') btn.css('color', 'green');
                            else if(val === 'Mutabık Değil') btn.css('color', 'red');
                            else btn.css('color', '');
                        } else {
                            toastr.error(res.message || 'Güncellenemedi.');
                        }
                    },
                    error: function() {
                        btn.prop('disabled', false);
                        toastr.error('Ağ hatası oluştu.');
                    }
                });
            });

            // YENİ: Serbest Düzenlenen Tam Notu Kaydetme AJAX'ı
            $(document).on('click', '.btn-save-note', function() {
                var btn = $(this);
                var container = btn.closest('td');
                var textarea = container.find('.current-notes');
                var val = textarea.val(); 
                var docEntry = btn.data('docentry');
                var dbName = btn.data('dbname');

                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                $.ajax({
                    url: '/Rapor130/UpdateMutabakatVeNot',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': csrfToken },
                    data: JSON.stringify({
                        DbName: dbName,
                        DocEntry: docEntry,
                        TamNot: val 
                    }),
                    success: function(res) {
                        btn.prop('disabled', false).html('<i class="fas fa-save"></i> Kaydet');
                        if(res.success) {
                            toastr.success('Notlar başarıyla kaydedildi.');
                            textarea.attr('title', val); 
                        } else {
                            toastr.error(res.message || 'Not kaydedilemedi.');
                        }
                    },
                    error: function() {
                        btn.prop('disabled', false).html('<i class="fas fa-save"></i> Kaydet');
                        toastr.error('Ağ hatası oluştu.');
                    }
                });
            });

            $(document).on('click', '.btn-add-note', function() {
                var btn = $(this);
                var container = btn.closest('td');
                var input = container.find('.new-note-input');
                var textarea = container.find('.current-notes');
                var val = input.val().trim();
                var docEntry = btn.data('docentry');
                var dbName = btn.data('dbname');

                if(!val) return;

                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                $.ajax({
                    url: '/Rapor130/UpdateMutabakatVeNot',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': csrfToken },
                    data: JSON.stringify({
                        DbName: dbName,
                        DocEntry: docEntry,
                        MutabakatDurumu: null,
                        YeniNot: val
                    }),
                    success: function(res) {
                        btn.prop('disabled', false).html('<i class="fas fa-plus"></i>');
                        if(res.success) {
                            toastr.success('Not başarıyla eklendi.');
                            input.val('');
                            var mevcutNot = textarea.val();
                            var eklenecekMetin = res.eklenenNot;
                            textarea.val(mevcutNot ? mevcutNot + ' | ' + eklenecekMetin : eklenecekMetin);
                            
                            textarea.scrollTop(textarea[0].scrollHeight);
                        } else {
                            toastr.error(res.message || 'Not eklenemedi.');
                        }
                    },
                    error: function() {
                        btn.prop('disabled', false).html('<i class="fas fa-plus"></i>');
                        toastr.error('Ağ hatası oluştu.');
                    }
                });
            });

            $(document).on('keyup', '.new-note-input', function(e) {
                if(e.key === 'Enter') {
                    $(this).siblings('.btn-add-note').click();
                }
            });


            // Hesaplamalar
            function calculateAllTotals() {
                $('.company-section').each(function() {
                    var $section = $(this);
                    var sumTutarTL = 0;
                    var sumOdenen = 0;

                    $section.find('.main-payment-table tbody tr.data-row:visible').each(function() {
                        var ttl = $(this).find('.tutartl-val').val();
                        var oden = $(this).find('.odenen-val').val();
                        
                        if(ttl) sumTutarTL += parseFloat(ttl.replace(/\./g, '').replace(',', '.')) || 0;
                        if(oden) sumOdenen += parseFloat(oden.replace(/\./g, '').replace(',', '.')) || 0;
                    });

                    $section.find('.toplam-tutar-tl-label').text('₺' + formatMoneyStr(sumTutarTL));
                    $section.find('.toplam-odenen-column-label').text('₺' + formatMoneyStr(sumOdenen));

                    $section.find('.summary-total-to-pay').text('₺' + formatMoneyStr(sumTutarTL));
                    $section.find('.summary-total-paid').text('₺' + formatMoneyStr(sumOdenen));
                    
                    var balance = sumTutarTL - sumOdenen;
                    $section.find('.summary-balance').text('₺' + formatMoneyStr(balance));
                });
            }

            function formatMoneyStr(val) {
                if (!val && val !== 0) return '0,00';
                return parseFloat(val).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            calculateAllTotals();

            $('.odeme-filter-btn').click(function (e) {
                e.preventDefault();
                var method = $(this).data('method');
                var text = $(this).text();
                var dbName = $(this).data('dbname');
                
                $(this).closest('.dropdown').find('.dropdown-toggle').html('<i class="fas fa-filter"></i> Ödeme Yöntemi: ' + text);
                
                $('.main-payment-table[data-dbname="' + dbName + '"] tbody.sortable-body tr.data-row').each(function () {
                    var rowMethod = $(this).find('.odeme-yontemi-val').val() || "";
                    if (method === 'Tümü' || rowMethod === method) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
                
                calculateAllTotals();
            });

            $(document).on('click', '.hizli-git-btn', function(e) {
                e.preventDefault();
                $('#welcomeMessage').hide();
                $('.company-section').hide();
                var targetDiv = $($(this).data('target'));
                if (targetDiv.length) {
                    targetDiv.fadeIn(300);
                    $('html, body').animate({ scrollTop: targetDiv.offset().top - 90 }, 300);
                }
            });

            $('.sortable-header').click(function() {
                const table = $(this).closest('table');
                const tbody = table.find('tbody.sortable-body');
                const rows = tbody.find('tr.data-row').toArray();
                const index = $(this).index();
                const type = $(this).data('type') || 'string';
                let asc = $(this).data('asc') || false;

                table.find('.sortable-header i').attr('class', 'fas fa-sort ms-1 text-muted');
                asc = !asc;
                $(this).data('asc', asc);
                $(this).find('i').attr('class', asc ? 'fas fa-sort-up ms-1 text-primary' : 'fas fa-sort-down ms-1 text-primary');

                function parseMoneyToFloatLocal(str) {
                    if (!str && str !== 0) return 0;
                    var safeStr = str.toString().replace(/\./g, '').replace(',', '.');
                    return parseFloat(safeStr) || 0;
                }

                rows.sort((a, b) => {
                    let valA = $(a).children('td').eq(index).find('input[type="text"], select, textarea, input[type="hidden"]:not(.odeme-yontemi-val, .durum-val)').val() || $(a).children('td').eq(index).text();
                    let valB = $(b).children('td').eq(index).find('input[type="text"], select, textarea, input[type="hidden"]:not(.odeme-yontemi-val, .durum-val)').val() || $(b).children('td').eq(index).text();
                    
                    valA = valA.trim(); valB = valB.trim();

                    if (type === 'number') {
                        valA = parseMoneyToFloatLocal(valA); valB = parseMoneyToFloatLocal(valB);
                        return asc ? valA - valB : valB - valA;
                    } else if (type === 'date') {
                        valA = new Date(valA).getTime() || 0; valB = new Date(valB).getTime() || 0;
                        return asc ? valA - valB : valB - valA;
                    } else {
                        return asc ? valA.localeCompare(valB) : valB.localeCompare(valA);
                    }
                });

                tbody.find('tr.sub-detail-row').remove();
                $('.belge-detay-btn i').removeClass('fa-chevron-circle-up').addClass('fa-chevron-circle-down');

                $.each(rows, function(i, row) { 
                    var newIndex = i + 1;
                    $(row).find('.row-number').text(newIndex);
                    tbody.append(row); 
                });
                
                tbody.append(table.find('.total-row')); 
            });

            // BELGE DETAYI ÇEKME
            $(document).on('click', '.belge-detay-btn', function () {
                var btn = $(this);
                var tr = btn.closest('tr');
                var kaynakDbName = btn.data('kaynakdb'); 
                var docEntry = btn.data('docentry');
                var belgeTipi = btn.data('belgetipi');

                if (tr.next().hasClass('sub-detail-row')) {
                    tr.next().fadeOut(200, function() { $(this).remove(); });
                    btn.find('i').removeClass('fa-chevron-circle-up').addClass('fa-chevron-circle-down');
                    return;
                }

                btn.find('i').removeClass('fa-chevron-circle-down').addClass('fa-spinner fa-spin');

                $.get('/Rapor130/GetBelgeAltDetay', { kaynakDbName: kaynakDbName, belgeTipi: belgeTipi, docEntry: docEntry }, function (res) {
                    btn.find('i').removeClass('fa-spinner fa-spin').addClass('fa-chevron-circle-up');

                    if (res.success && res.data && res.data.length > 0) {
                        var firstRow = res.data[0];
                        var faturaNo = firstRow.FaturaNo || firstRow.faturaNo || '';
                        var pb = firstRow.ParaBirimi || firstRow.paraBirimi || 'TRY';

                        var toplamKdvsiz = 0;
                        var toplamKdv = 0;
                        var genelToplam = 0;

                        var kalemlerTable = 
                            '<table class="table table-bordered table-striped table-hover mt-2 mb-2" style="font-size:11px; background-color: var(--bg-card); color: var(--text-primary);">' +
                                '<thead style="background-color: var(--bg-main); border-bottom: 2px solid var(--border-color);">' +
                                    '<tr>' +
                                        '<th style="font-weight: bold;">Ürün/Hizmet Kodu</th>' +
                                        '<th style="font-weight: bold;">Açıklama</th>' +
                                        '<th class="text-center" style="font-weight: bold;">Miktar</th>' +
                                        '<th class="text-end" style="font-weight: bold;">KDV\'siz Tutar</th>' +
                                        '<th class="text-end" style="font-weight: bold;">KDV Tutarı</th>' +
                                        '<th class="text-end" style="font-weight: bold;">KDV\'li Toplam</th>' +
                                    '</tr>' +
                                '</thead>' +
                                '<tbody>';

                        res.data.forEach(function(k) {
                            var miktar = k.Miktar || k.miktar || 0;
                            var kdvsiz = k.KdvsizTutar || k.kdvsizTutar || 0;
                            var kdv = k.KdvTutari || k.kdvTutari || 0;
                            var kdvli = k.KdvliTutar || k.kdvliTutar || 0;

                            toplamKdvsiz += kdvsiz;
                            toplamKdv += kdv;
                            genelToplam += kdvli;

                            kalemlerTable += 
                                '<tr>' +
                                    '<td>' + (k.ItemCode || k.itemCode || '') + '</td>' +
                                    '<td>' + (k.KalemAdi || k.kalemAdi || '') + '</td>' +
                                    '<td class="text-center">' + miktar.toFixed(2) + '</td>' +
                                    '<td class="text-end">' + formatMoneyStr(kdvsiz) + ' ' + pb + '</td>' +
                                    '<td class="text-end text-danger">' + formatMoneyStr(kdv) + ' ' + pb + '</td>' +
                                    '<td class="text-end fw-bold text-success">' + formatMoneyStr(kdvli) + ' ' + pb + '</td>' +
                                '</tr>';
                        });

                        kalemlerTable += 
                                '</tbody>' +
                                '<tfoot>' +
                                    '<tr style="background-color: var(--bg-main); font-weight: bold; border-top: 2px solid var(--border-color);">' +
                                        '<td colspan="3" class="text-end">BELGE TOPLAMLARI:</td>' +
                                        '<td class="text-end">' + formatMoneyStr(toplamKdvsiz) + ' ' + pb + '</td>' +
                                        '<td class="text-end text-danger">' + formatMoneyStr(toplamKdv) + ' ' + pb + '</td>' +
                                        '<td class="text-end text-success">' + formatMoneyStr(genelToplam) + ' ' + pb + '</td>' +
                                    '</tr>' +
                                '</tfoot>' +
                            '</table>';

                        var faturaText = faturaNo ? '(' + faturaNo + ')' : '';
                        var subRow = 
                            '<tr class="sub-detail-row" style="display:none; background-color: var(--bg-main);">' +
                                '<td colspan="4"></td>' + 
                                '<td colspan="14">' +
                                    '<div class="p-3 border border-primary rounded shadow-sm" style="background-color: var(--bg-card);">' +
                                        '<h6 class="text-primary fw-bold mb-3 border-bottom border-primary pb-2">' +
                                            '<i class="fas fa-list"></i> ' + belgeTipi + ' Detayları ' + faturaText +
                                        '</h6>' +
                                        kalemlerTable +
                                    '</div>' +
                                '</td>' +
                            '</tr>';

                        tr.after(subRow);
                        tr.next().fadeIn(300);
                    } else {
                        btn.find('i').removeClass('fa-spinner fa-spin').addClass('fa-chevron-circle-down');
                    }
                }).fail(function() {
                    btn.find('i').removeClass('fa-spinner fa-spin').addClass('fa-chevron-circle-down');
                });
            });

            $(document).on('click', '.pdf-preview-btn', function(e) {
                e.preventDefault();
                var rawUrl = $(this).data('url');
                
                if (rawUrl) {
                    var cleanUrl = String(rawUrl).trim().replace(/\\/g, '/');
                    var fileName = cleanUrl.substring(cleanUrl.lastIndexOf('/') + 1);
                    var finalUrl = '';
                    var title = $(this).attr('title') || '';
                    
                    if (fileName.toLowerCase().includes('talimat') || title.toLowerCase().includes('talimat')) {
                        finalUrl = '/Talimatlar/' + fileName;
                    } else {
                        finalUrl = '/Dekontlar/' + fileName;
                    }
                    
                    $('#pdfPreviewIframe').attr('src', finalUrl);
                    $('#modalDownloadBtn').attr('href', finalUrl);
                    $('#pdfPreviewModal').modal('show');
                }
            });

            $('#pdfPreviewModal').on('hidden.bs.modal', function () { $('#pdfPreviewIframe').attr('src', ''); });

            var activeContextRow = null;
            $(document).on('contextmenu', '.sortable-body tr.data-row', function(e) {
                e.preventDefault();
                activeContextRow = $(this);
                $('#rowContextMenu').css({ display: 'block', left: e.pageX + 'px', top: e.pageY + 'px' });
            });
            $(document).click(function() { $('#rowContextMenu').hide(); });

            $('#btnShowLogs').click(function(e) {
                e.preventDefault();
                $('#rowContextMenu').hide(); 

                if (activeContextRow) {
                    var dbName = activeContextRow.closest('tbody').data('dbname');
                    var docEntry = activeContextRow.data('docentry');

                    if (!docEntry || docEntry == 0) return;

                    $('#logTabloBody').html('<tr><td colspan="4" class="text-center text-muted"><i class="fas fa-spinner fa-spin"></i> Yükleniyor...</td></tr>');
                    $('#logModal').modal('show');

                    $.ajax({
                        url: '/Rapor130/GetRowLogs',
                        type: 'GET',
                        data: { dbName: dbName, docEntry: docEntry },
                        success: function (res) {
                            if (res.success) {
                                let html = '';
                                if(res.data.length === 0) {
                                    html = '<tr><td colspan="4" class="text-center text-danger">Bu belgeye ait geçmiş kaydı bulunamadı.</td></tr>';
                                } else {
                                    res.data.forEach(x => {
                                        let islemTarihi = x.IslemTarihi || x.islemTarihi;
                                        let kullanici = x.Kullanici || x.kullanici || '-';
                                        let islemTipi = x.IslemTipi || x.islemTipi || '';
                                        let aciklama = x.Aciklama || x.aciklama || '';

                                        let dateObj = new Date(islemTarihi);
                                        let formatliTarih = dateObj.toLocaleDateString('tr-TR') + ' ' + dateObj.toLocaleTimeString('tr-TR');
                                        
                                        let islemTipiBadge = 'bg-secondary';
                                        if(islemTipi.includes('GÜNCEL')) islemTipiBadge = 'bg-info text-dark';
                                        if(islemTipi.includes('EKLEME')) islemTipiBadge = 'bg-success';
                                        if(islemTipi.includes('SİL')) islemTipiBadge = 'bg-danger';
                                        if(islemTipi.includes('DEKONT') || islemTipi.includes('TALİMAT')) islemTipiBadge = 'bg-primary';

                                        html += `<tr>
                                                    <td>${formatliTarih}</td>
                                                    <td class="fw-bold text-primary">${kullanici}</td>
                                                    <td><span class="badge ${islemTipiBadge}">${islemTipi}</span></td>
                                                    <td>${aciklama}</td>
                                                 </tr>`;
                                    });
                                }
                                $('#logTabloBody').html(html);
                            } else {
                                $('#logTabloBody').html(`<tr><td colspan="4" class="text-center text-danger">${res.message}</td></tr>`);
                            }
                        },
                        error: function() {
                            $('#logTabloBody').html('<tr><td colspan="4" class="text-center text-danger">Bağlantı hatası oluştu.</td></tr>');
                        }
                    });
                }
            });

            $('#btnLogGetir').click(function() {
                var dbName = $('#logFirmaSelect').val();
                var startDate = $('#logStartDate').val();
                var endDate = $('#logEndDate').val();
                var sadeceSilinenler = $('#chkSadeceSilinenler').is(':checked');

                $('#sistemLoglariBody').html('<tr><td colspan="5" class="text-center"><i class="fas fa-spinner fa-spin"></i> Yükleniyor...</td></tr>');
                
                $.get('/Rapor130/GetSistemLoglari', { 
                    dbName: dbName,
                    startDate: startDate,
                    endDate: endDate,
                    sadeceSilinenler: sadeceSilinenler
                }, function(res) {
                    if (res.success) {
                        let html = '';
                        if(res.data.length === 0) {
                            html = '<tr><td colspan="5" class="text-center text-warning">Kayıt bulunamadı.</td></tr>';
                        } else {
                            res.data.forEach(x => {
                                let islemTarihi = x.IslemTarihi || x.islemTarihi;
                                let kullanici = x.Kullanici || x.kullanici || '-';
                                let islemTipi = x.IslemTipi || x.islemTipi || '';
                                let aciklama = x.Aciklama || x.aciklama || '';
                                let docEntry = x.DocEntry || x.docEntry || '-';

                                let dateObj = new Date(islemTarihi);
                                let formatliTarih = dateObj.toLocaleDateString('tr-TR') + ' ' + dateObj.toLocaleTimeString('tr-TR');
                                
                                let islemTipiBadge = 'bg-secondary';
                                if(islemTipi.includes('GÜNCEL')) islemTipiBadge = 'bg-info text-dark';
                                if(islemTipi.includes('EKLEME')) islemTipiBadge = 'bg-success';
                                if(islemTipi.includes('SİL')) islemTipiBadge = 'bg-danger';
                                if(islemTipi.includes('DEKONT') || islemTipi.includes('TALİMAT')) islemTipiBadge = 'bg-primary';

                                let trClass = islemTipi.includes('SİL') ? 'table-danger' : '';

                                html += `<tr class="${trClass}">
                                            <td>${formatliTarih}</td>
                                            <td class="fw-bold text-primary">${kullanici}</td>
                                            <td><span class="badge ${islemTipiBadge}">${islemTipi}</span></td>
                                            <td class="fw-bold text-muted">${docEntry}</td>
                                            <td>${aciklama}</td>
                                         </tr>`;
                            });
                        }
                        $('#sistemLoglariBody').html(html);
                    } else {
                        $('#sistemLoglariBody').html(`<tr><td colspan="5" class="text-center text-danger">${res.message}</td></tr>`);
                    }
                }).fail(function() {
                    $('#sistemLoglariBody').html('<tr><td colspan="5" class="text-center text-danger">Bağlantı hatası oluştu.</td></tr>');
                });
            });

            $('#sistemLoglariModal').on('show.bs.modal', function () {
                if(!$('#logStartDate').val()) {
                    var date = new Date();
                    $('#logStartDate').val(new Date(date.getFullYear(), date.getMonth(), 1).toISOString().split('T')[0]);
                    $('#logEndDate').val(new Date(date.getFullYear(), date.getMonth() + 1, 0).toISOString().split('T')[0]);
                }
                $('#btnLogGetir').trigger('click');
            });

            function loadOdenenler() {
                var s = $('#odenenlerStart').val();
                var e = $('#odenenlerEnd').val();
                var q = $('#odenenlerSearch').val();
                var vr = $('select[name="viewRole"]').val() || $('input[name="viewRole"]').val();
                $('#odenenlerBody').html('<tr><td colspan="10" class="text-center py-4">Sorgulanıyor...</td></tr>');
                
                $.get('/Rapor130/GetOdenenler', { start: s, end: e, search: q, viewRole: vr }, function(res) {
                    var html = '';
                    var total = 0;
                    res.forEach(function(item) {
                        total += item.tutarTL || 0;
                        var dt = item.odenmeTarihi ? new Date(item.odenmeTarihi).toLocaleDateString('tr-TR') : '-';
                        
                        var dekontBtn = item.dekontLink ? '<button type="button" class="btn btn-sm btn-outline-primary p-1 pdf-preview-btn interactive-cell" data-url="'+item.dekontLink+'"><i class="fas fa-receipt"></i> Görüntüle</button>' : '<span class="text-muted">-</span>';
                        var talimatBtn = item.talimatLink ? '<button type="button" class="btn btn-sm btn-outline-danger p-1 pdf-preview-btn interactive-cell" data-url="'+item.talimatLink+'"><i class="fas fa-file-invoice"></i> Görüntüle</button>' : '<span class="text-muted">-</span>';

                        html += '<tr>' +
                                '<td><span class="badge bg-secondary">' + item.firma + '</span></td>' +
                                '<td>' + dt + '</td>' +
                                '<td>' + (item.kurum || '-') + '</td>' +
                                '<td>' + (item.urunHizmet || '-') + '</td>' +
                                '<td>' + (item.odemeYontemi || '-') + '</td>' +
                                '<td><span class="fw-bold">' + (item.faturaSiparisNo || '-') + '</span></td>' +
                                '<td class="text-center">' + dekontBtn + '</td>' +
                                '<td class="text-center">' + talimatBtn + '</td>' +
                                '<td class="text-end">' + formatMoneyStr(item.tutar) + ' ' + (item.paraBirimi || 'TL') + '</td>' +
                                '<td class="text-end fw-bold text-success">' + formatMoneyStr(item.tutarTL) + ' ₺</td>' +
                            '</tr>';
                    });
                    if(res.length === 0) { html = '<tr><td colspan="10" class="text-center text-danger">Kayıt bulunamadı.</td></tr>'; } 
                    else { html += '<tr class="table-success"><td colspan="9" class="text-end fw-bold text-dark">KONSOLİDE TOPLAM:</td><td class="text-end fw-bold text-danger">' + formatMoneyStr(total) + ' ₺</td></tr>'; }
                    $('#odenenlerBody').html(html);
                });
            }
            $('#btnOdenenlerGetir').click(loadOdenenler);
            $('#odenenlerSearch').on('keyup', function(e) { if(e.key === 'Enter') loadOdenenler(); });
            $('#odenenlerModal').on('show.bs.modal', function() {
                if(!$('#odenenlerStart').val()) {
                    var date = new Date();
                    $('#odenenlerStart').val(new Date(date.getFullYear(), date.getMonth(), 1).toISOString().split('T')[0]);
                    $('#odenenlerEnd').val(new Date(date.getFullYear(), date.getMonth() + 1, 0).toISOString().split('T')[0]);
                    loadOdenenler();
                }
            });
            
            $('select[name="viewRole"]').change(function(){ $(this).closest('form').submit(); });
        }); 
    </script>
}