@{
    ViewData["Title"] = "Kasa Nakit Akışı Görünüm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string onKisi = (string)ViewBag.Kisi ?? "";
    string ben = (string)ViewBag.Ben ?? "";
}
@*
    KASA NAKİT AKIŞI GÖRÜNÜM — "Ödeme Takibim" (Mali İşler › Finans › Nakit Akışı ve Likidite). Kasa Nakit Akışı'nı herkes görmez: satın almacılar ve ödeme talebi açan
    kişiler YALNIZ kendi ödemelerinin sürecini izler — talep → onay → nakit akışa planlandı → banka talimatı / çek · senet / nakit onayı → ödendi → dekont · makbuz.
    Kasa / banka bakiyeleri, başkalarının ödemeleri ve şirket toplamları görünmez. Veri: /Rapor130/Veri?kisi= · satır: /Rapor130/Satir (Uretilen/Controllers/Rapor130Controller.cs) · betik: wwwroot/js/odeme-takibim.js
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<style>
    .na.ot { --na-k: #0f766e; }
    .ot-pill { font-size: .66rem; font-weight: 700; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 3px 10px; } a.ot-pill { text-decoration: none; }
    .ot-gizli { font-size: .68rem; color: #0c4a6e; background: #e0f2fe; border: 1px solid #bae6fd; border-radius: 8px; padding: 5px 10px; }
    .ot-filtre { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: end; } .ot-filtre label { display: block; font-size: .58rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 2px; } .ot-filtre .form-control, .ot-filtre .form-select { font-size: .72rem; padding: 3px 7px; height: 28px; }
    #ot .ot-tablo { font-size: .7rem; } #ot .ot-tablo td { vertical-align: middle; padding: 5px 6px; border-bottom: 1px solid #e2e8f0; } #ot .ot-tablo td small { display: block; font-size: .58rem; color: #64748b; } #ot .ot-tablo tr.tik { cursor: pointer; } #ot .ot-tablo tr.tik:hover td { background: #f0fdfa; }
    #ot .ot-tablo tr.gec td { background: #fef2f2; } #ot .ot-tablo tr.odendi td { background: #f0fdf4; } #ot .ot-tablo td.para { text-align: right !important; font-variant-numeric: tabular-nums; font-weight: 700; white-space: nowrap; }
    /* süreç şeridi: adımlar (yeşil tamam, mavi sırada, gri bekliyor, kırmızı gecikti) */
    .ot-surec { display: flex; gap: 3px; align-items: center; flex-wrap: nowrap; } .ot-surec span { font-size: .56rem; font-weight: 700; border-radius: 999px; padding: 1px 7px; background: #f1f5f9; color: #94a3b8; border: 1px solid #e2e8f0; white-space: nowrap; }
    .ot-surec span.ok { background: #dcfce7; color: #166534; border-color: #bbf7d0; } .ot-surec span.simdi { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; } .ot-surec span.gec { background: #fee2e2; color: #991b1b; border-color: #fecaca; } .ot-surec i { font-size: .5rem; color: #cbd5e1; }
    .ot-rozet { display: inline-block; font-size: .58rem; font-weight: 800; border-radius: 4px; padding: 1px 6px; white-space: nowrap; } .ot-rozet.ok { background: #dcfce7; color: #166534; } .ot-rozet.bekle { background: #fef3c7; color: #92400e; } .ot-rozet.bilgi { background: #dbeafe; color: #1e40af; } .ot-rozet.hata { background: #fee2e2; color: #991b1b; } .ot-rozet.notr { background: #f1f5f9; color: #475569; }
    .ot-drawer { position: fixed; top: 0; right: -760px; width: 720px; max-width: 96vw; height: 100vh; background: #fff; box-shadow: -8px 0 24px rgba(15,23,42,.18); z-index: 1060; transition: right .25s; overflow: auto; padding: 12px 14px; } .ot-drawer.acik { right: 0; }
    .main-content #otDrawer { height: 100vh !important; max-height: 100vh !important; overflow: auto !important; }
    .ot-drawer-ust { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; position: sticky; top: 0; background: #fff; padding-bottom: 6px; border-bottom: 1px solid #e2e8f0; z-index: 2; flex-wrap: wrap; }
    .ot-perde { position: fixed; inset: 0; background: rgba(15,23,42,.35); z-index: 1055; display: none; } .ot-perde.acik { display: block; }
    .ot-adimlar { list-style: none; margin: 0; padding: 0 0 0 16px; border-left: 2px solid #e2e8f0; } .ot-adimlar li { position: relative; padding: 2px 0 8px 10px; font-size: .72rem; } .ot-adimlar li::before { content: ""; position: absolute; left: -21px; top: 6px; width: 10px; height: 10px; border-radius: 50%; background: #cbd5e1; border: 2px solid #fff; }
    .ot-adimlar li.ok::before { background: #16a34a; } .ot-adimlar li.simdi::before { background: #2563eb; box-shadow: 0 0 0 3px #dbeafe; } .ot-adimlar li.gec::before { background: #dc2626; } .ot-adimlar li .t { color: #94a3b8; font-size: .62rem; margin-left: 6px; } .ot-adimlar li small { display: block; color: #64748b; font-size: .64rem; }
</style>
}

<div class="container-fluid py-3 na ot" id="ot" data-kisi="@onKisi" data-ben="@ben">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-user-check"></i></span>Ödeme Takibim · Kasa Nakit Akışı Görünüm</h4>
        <span class="ot-pill" id="otKim"><i class="fas fa-user me-1"></i>…</span>
        <a class="ot-pill" href="/OdemeTalebi" target="_blank" rel="noopener"><i class="fas fa-money-bill me-1"></i>Yeni Ödeme Talebi</a>
        <span class="ot-gizli"><i class="fas fa-eye-slash me-1"></i>Kasa Nakit Akışı'nın tamamı bu ekranda görünmez: yalnız <b>sizin talep ettiğiniz</b> ya da <b>satınalmacısı olduğunuz</b> ödemeler; kasa / banka bakiyeleri ve başkalarının ödemeleri gösterilmez.</span>
        <span class="sub w-100">Satın alma ve talebi geçen birimler için: her ödemenin <b>nerede olduğu</b> adım adım izlenir — <b>Talep → Onay → Nakit Akışa Planlandı → Banka Talimatı / Çek · Senet / Nakit Onayı → Ödendi → Dekont · Makbuz</b>. Planlanan tarih, ödeme yöntemi, talimat / çek numarası, ödenme tarihi ve dekont burada; satıra tıklayınca süreç zaman çizelgesi, günlük, ekler (dekont, makbuz, ciro bordrosu) ve çek / senet akıbeti açılır. Ödeme talepleri ayrı sekmede: onay bekleyen, onaylanan, nakit akışa alınan.</span>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>

    <div class="na-kart">
        <div class="na-kart-b"><span><i class="fas fa-filter me-1"></i>Görünüm</span><span class="not" id="otNot"></span></div>
        <div class="na-kart-g">
            <div class="ot-filtre">
                <div><label>Görünüm Kişisi (örnek: başka kişi seçilebilir)</label><select class="form-select" id="otKisi" style="min-width:260px"></select></div>
                <div><label>Durum</label><select class="form-select" id="otDurum"><option value="">Tümü</option><option value="acik">Bekleyen</option><option value="gec">Geciken</option><option value="onay">Onay Bekleyen</option><option value="odendi">Ödendi</option></select></div>
                <div><label>Şirket</label><select class="form-select" id="otSirket"><option value="">Tümü</option></select></div>
                <div><label>Yöntem</label><select class="form-select" id="otYontem"><option value="">Tümü</option></select></div>
                <div style="flex:1;min-width:220px"><label>Ara</label><input class="form-control" id="otAra" placeholder="Cari, belge no, açıklama, talimat / çek no…" autocomplete="off"></div>
                <div><button type="button" class="btn btn-light border btn-sm py-0" id="otExcel" style="font-size:.66rem;height:28px"><i class="fas fa-file-excel me-1"></i>Excel</button></div>
            </div>
            <div class="na-kpi mt-2" id="otKpi" data-dinamik="kapali" style="grid-template-columns:repeat(6,1fr)"></div>
        </div>
    </div>

    <div class="na-sekme" id="otSekmeler" data-dinamik="kapali">
        <button type="button" data-p="acik" class="aktif"><i class="fas fa-hourglass-half me-1"></i>Bekleyen Ödemelerim <span class="n" id="otN-acik">0</span></button>
        <button type="button" data-p="odendi"><i class="fas fa-circle-check me-1"></i>Ödenenler <span class="n" id="otN-odendi">0</span></button>
        <button type="button" data-p="talep"><i class="fas fa-file-signature me-1"></i>Ödeme Taleplerim <span class="n" id="otN-talep">0</span></button>
    </div>

    <div class="na-panel aktif" data-p="acik">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-list me-1"></i>Bekleyen Ödemelerim · Süreç Durumu</span><span class="not">satıra tıklayınca süreç zaman çizelgesi, günlük ve ekler · yeşil tamam · mavi sırada · kırmızı gecikti</span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ot-tablo" id="otTablo-acik" data-dinamik="kapali"><thead><tr><th>Şirket</th><th>Cari · Konu</th><th>Belge</th><th class="s">Tutar</th><th>Planlanan</th><th>Yöntem</th><th>Süreç</th><th>Sıradaki Adım</th><th>Durum</th><th>Rolüm</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div></div>
    </div>
    <div class="na-panel" data-p="odendi">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-circle-check me-1"></i>Ödenen Ödemelerim</span><span class="not">ödenme tarihi, dekont / makbuz, talimat / çek</span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ot-tablo" id="otTablo-odendi" data-dinamik="kapali"><thead><tr><th>Şirket</th><th>Cari · Konu</th><th>Belge</th><th class="s">Tutar</th><th>Ödenme</th><th>Yöntem</th><th>Talimat / Çek</th><th>Dekont · Makbuz</th><th>Ekler</th><th>Rolüm</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div></div>
    </div>
    <div class="na-panel" data-p="talep">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-file-signature me-1"></i>Ödeme Taleplerim</span><span class="not">Ödeme Talebi modülü · onay durumu · nakit akışa alındı mı</span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ot-tablo" id="otTablo-talep" data-dinamik="kapali"><thead><tr><th>Talep No</th><th>Tarih</th><th>Şirket</th><th>Kurum</th><th>Belge</th><th class="s">Tutar</th><th>Son Ödeme</th><th>Yöntem</th><th>Durum</th><th>Nakit Akış</th><th></th></tr></thead><tbody></tbody></table></div></div></div>
    </div>

    <div class="ot-perde" id="otPerde"></div>
    <div class="ot-drawer" id="otDrawer">
        <div class="ot-drawer-ust"><b id="otDBaslik" style="font-size:.88rem"></b><span class="ms-auto"></span><button type="button" class="btn btn-light btn-sm py-0" id="otDKapat" style="font-size:.66rem"><i class="fas fa-xmark"></i></button></div>
        <div id="otDIc"></div>
    </div>
</div>
@section Scripts {
<script src="/js/odeme-takibim.js?v=1"></script>
}
