@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sirketler = (string[])ViewBag.Sirketler;
    int yil = (int)ViewBag.Yil;
    string sekme = (string)ViewBag.Sekme ?? "vc";
    string cari = (string)ViewBag.Cari ?? "";
    string varsayilanSirket = (string)ViewBag.VarsayilanSirket ?? "";
    string q = Context.Request.Query.ContainsKey("_sekme") ? "?_sekme=1" : "";
    var verilenPaneller = new[] { ("vc", "Çek", "Çekler", "fa-file-invoice-dollar"), ("vs", "Senet", "Senetler", "fa-file-signature") };
    var tahsilPaneller = new[] { ("tc", "Çek", "Çekleri", "fa-building-columns"), ("ts", "Senet", "Senetleri", "fa-landmark") };
}
@*
    VADE TARİHİNE GÖRE ÇEK VE SENET ÖZETİ — Mali İşler › Finans › Finansal Araçlar (Yönetim › Özel Raporlar'da aynı ekran).
    "2026 Vade Tarihine Göre Tedarikçi Aylık Çek Özeti" tablosunun uyarlaması. Sekmeler:
      Verilen Çekler / Verilen Senetler           : verilen belgeler vade ayına göre cari bazında — Ocak…Aralık, 12 Aylık Toplam, Aylık Ortalama, % pay; ödeme türü ara
                                                    toplamları (Tedarikçi, Maaş, Kira), verilen toplam ve adet; altında tahsile gönderilen (Ziraat Bankası / Halk Bankası) ve NET
      Tahsile Gönderilen Çekler / Senetler        : bankaya ibraz edilen müşteri belgeleri banka bazında (tahsil edildi / tahsilde / karşılıksız); durum ve banka filtresi, KPI
      Aylık Nakit Görünümü                        : çek ve senet ORTAK — ay ay verilen (çek / senet, tür bazında) ↔ tahsile gönderilen (çek / senet, banka bazında), net, kümülatif
    12 ay tek ekranda: dar cari sütunu (üç nokta ile kısaltma, tam ad ipucunda), sıkı hücreler; özet sütunları sağa sabit.
    Veri: /CekOzet/Veri (Data/CekOrnek.cs + Data/ButceOrnek.cs › Cekler / Senetler). Betik: wwwroot/js/cek-ozet.js · Ortak stil: nakit-avans.css
    Derin bağlantı: /CekOzet?sekme=vc|vs|tc|ts|nakit, ?cari=Öztürk Plastik (detay)
    Açılışta Şirket filtresi kullanıcının şirketi (ViewBag.VarsayilanSirket = Uras Kimya): 2026 verilen tedarikçi çekleri "2026 Bütçe Analizi" tablosuyla birebir (Data/CekOrnek.cs › Gercek2026).
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<style>
    .na.co { --na-k: #0369a1; }
    .co-pill { font-size: .68rem; font-weight: 700; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 3px 10px; }
    .co-filtre { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px 8px; align-items: end; }
    .co-filtre label { display: block; font-size: .6rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 2px; }
    .co-filtre .form-control, .co-filtre .form-select { font-size: .72rem; padding: 3px 7px; height: 28px; }
    .co-filtre .ara { grid-column: span 2; }
    @@media (max-width: 1200px) { .co-filtre { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    .co-tur { display: inline-block; font-size: .6rem; font-weight: 800; border-radius: 4px; padding: 1px 6px; color: #fff; white-space: nowrap; }
    .co-tur.tedarikci { background: #1d4ed8; } .co-tur.maas { background: #0f766e; } .co-tur.kira { background: #b45309; } .co-tur.diger { background: #6b7280; }
    /* --- Excel şablonu görünümü (vade matrisi): 12 ay tek ekranda — sıkı hücre, dar cari sütunu --- */
    .co-rapor-ust { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; background: linear-gradient(90deg, #0c4a6e, #0369a1); color: #fff; border-radius: 10px; padding: 8px 14px; margin-bottom: 8px; }
    .co-rapor-ust h5 { margin: 0; font-weight: 800; letter-spacing: .05em; font-size: .9rem; text-transform: uppercase; }
    .co-rapor-ust .alt { font-size: .62rem; letter-spacing: .14em; opacity: .85; text-transform: uppercase; }
    .co-rapor-ust .ayar { margin-left: auto; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; } .co-rapor-ust .ayar .btn { font-size: .66rem; }
    /* #co öneki: nakit-avans.css (table.na-tablo td: .72rem, 5px 7px) ve rapor-tema.css (thead th: .68rem) kurallarını kesin olarak ezer — aksi hâlde 12 ay sığmaz */
    #co .co-excel { font-size: .6rem; border-collapse: separate; border-spacing: 0; width: 100%; }
    #co .co-excel th, #co .co-excel td { white-space: nowrap; padding: 2px 4px; border-bottom: 1px solid #e2e8f0; line-height: 1.25; }
    #co .co-excel thead th { position: sticky; top: 0; background: #1e293b; color: #fff; text-transform: uppercase; font-size: .54rem; letter-spacing: .02em; z-index: 3; padding: 4px 4px; }
    #co .co-excel td.s { font-variant-numeric: tabular-nums; }
    #co .co-excel th.ad, #co .co-excel td.ad { position: sticky; left: 0; background: #fff; width: 170px; min-width: 170px; max-width: 170px; overflow: hidden; text-overflow: ellipsis; z-index: 2; font-weight: 600; font-size: .62rem; box-shadow: 1px 0 0 #e2e8f0; }
    #co .co-excel td.ad b, #co .co-excel td.ad small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    #co .co-excel thead th.ad { z-index: 4; background: #1e293b; }
    #co .co-excel tr.grp td { background: #cbd5e1; color: #0f172a; font-weight: 800; text-transform: uppercase; letter-spacing: .02em; }
    #co .co-excel tr.tik { cursor: pointer; } #co .co-excel tr.tik:hover td { background: #f0f9ff; } #co .co-excel tr.tik:hover td.ad { background: #f0f9ff; }
    #co .co-excel td.hucre { cursor: pointer; } #co .co-excel td.hucre:hover { outline: 2px solid #38bdf8; outline-offset: -2px; }
    #co .co-excel td.bugun-ay, #co .co-excel th.bugun-ay { background: #fffbeb !important; }
    #co .co-excel tr.toplam td { font-weight: 800; background: #e0f2fe; border-top: 2px solid #0369a1; } #co .co-excel tr.toplam td.ad { background: #e0f2fe; }
    #co .co-excel tr.genel td { font-weight: 800; background: #dbeafe; border-top: 2px solid #1e40af; } #co .co-excel tr.genel td.ad { background: #dbeafe; }
    #co .co-excel tr.adet td { font-style: italic; color: #475569; background: #f8fafc; } #co .co-excel tr.adet td.ad { background: #f8fafc; }
    #co .co-excel tr.banka td { background: #f0f9ff; font-weight: 600; color: #0c4a6e; } #co .co-excel tr.banka td.ad { background: #f0f9ff; padding-left: 14px; }
    #co .co-excel td.yil { font-weight: 700; background: #f8fafc; } #co .co-excel td.ort { color: #475569; }
    #co .co-excel td small { color: #64748b; display: block; font-size: .52rem; line-height: 1.1; }
    #co .co-excel tr.ara td { height: 6px; padding: 0; background: #fff; border: 0; }
    /* Özet sütunları (12 Aylık Toplam · Aylık Ortalama · %) sağ kenara sabit */
    #co .co-excel th.sag, #co .co-excel td.sag { position: sticky; background: #f8fafc; z-index: 2; box-shadow: -1px 0 0 #e2e8f0; box-sizing: border-box; }
    #co .co-excel thead th.sag { z-index: 4; background: #1e293b; }
    #co .co-excel .sag1 { right: 0; width: 50px; min-width: 50px; } #co .co-excel .sag2 { right: 50px; width: 80px; min-width: 80px; } #co .co-excel .sag3 { right: 130px; width: 92px; min-width: 92px; }
    #co .co-excel .sag1.genis { width: 96px; min-width: 96px; }
    #co .co-excel tr.tik:hover td.sag { background: #f0f9ff; }
    .co-drawer { position: fixed; top: 0; right: -860px; width: 820px; max-width: 96vw; height: 100vh; background: #fff; box-shadow: -8px 0 24px rgba(15,23,42,.18); z-index: 1060; transition: right .25s; overflow: auto; padding: 12px 14px; } .co-drawer.acik { right: 0; }
    .co-drawer-ust { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; position: sticky; top: 0; background: #fff; padding-bottom: 6px; border-bottom: 1px solid #e2e8f0; z-index: 2; flex-wrap: wrap; }
    .co-perde { position: fixed; inset: 0; background: rgba(15,23,42,.35); z-index: 1055; display: none; } .co-perde.acik { display: block; }
    .co-ozet { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px 12px; font-size: .72rem; }
    .co-ozet .l { font-size: .58rem; font-weight: 800; text-transform: uppercase; color: #94a3b8; letter-spacing: .04em; } .co-ozet .v { font-weight: 700; color: #0f172a; }
    #coDCekler td, #coDCekler th { white-space: nowrap; } #coDCekler tr.vurgu td { background: #fffbeb; }
    #co .co-drawer .co-excel th.ad, #co .co-drawer .co-excel td.ad { position: static; width: auto; min-width: 0; max-width: none; }
    .co-net.pozitif { color: #15803d; font-weight: 800; } .co-net.negatif { color: #b91c1c; font-weight: 800; }
</style>
}

<div class="container-fluid py-3 na co" id="co" data-sekme="@(q != "" ? "1" : "")" data-baslangic="@sekme" data-cari="@cari" data-yil="@yil" data-sirket="@varsayilanSirket">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-money-check-dollar"></i></span>Vade Tarihine Göre Çek ve Senet Özeti</h4>
        @* Rozetler tıklanabilir (rapor-tema.js) *@
        <span class="co-pill" data-git="vc|#coTur" title="Verilen Çekler › ödeme türü filtresi"><i class="fas fa-file-invoice-dollar me-1"></i>Tedarikçi · Maaş · Kira</span>
        <span class="co-pill" data-git="vs|#coVerilenTablo-vs" title="Verilen Senetler sekmesi"><i class="fas fa-file-signature me-1"></i>Senetler</span>
        <span class="co-pill" data-git="tc|#coTahsilTablo-tc" title="Tahsile Gönderilen Çekler sekmesi"><i class="fas fa-building-columns me-1"></i>Tahsile Gönderilen · Ziraat · Halk Bankası</span>
        <span class="co-pill" data-git="nakit|#coNakitTablo" title="Aylık Nakit Görünümü (çek + senet)"><i class="fas fa-scale-balanced me-1"></i>Verilen ↔ Tahsil · Net</span>
        <span class="co-pill" data-git="vc|#coYil" title="Yıl filtresi"><i class="fas fa-calendar-days me-1"></i>Vade Ayına Göre · @yil</span>
        <span class="sub w-100">Şirketin <b>verdiği çekler</b> ve <b>verdiği senetler</b> ayrı sekmelerde, vade tarihinin düştüğü aya göre <b>cari bazında</b> izlenir: tedarikçi ödemeleri, <b>maaş</b> ve <b>kira</b>. Her satırda Ocak–Aralık tutarları, 12 aylık toplam, aylık ortalama ve pay; altta verilen toplam ve adet, ardından aynı tabloda bankaya nakit dönüşü için <b>tahsile gönderilen</b> belgeler (yalnız <b>Ziraat Bankası</b> ve <b>Halk Bankası</b>) ve <b>NET</b>. Tahsile gönderilen çekler ve senetler ayrı sekmelerde banka bazında, durum filtresiyle; <b>Aylık Nakit Görünümü</b> çek ve senetleri birlikte ay ay karşılaştırır. Satır ya da hücreye tıklayınca belge listesi (no, banka, keşide, vade, tutar, durum) açılır. Açılışta <b>kullanıcının şirketi</b> seçilidir; Şirket filtresinden Tümü (Konsolide) seçilebilir. Tutarlar TL, matris kuruşsuz (tam tutar hücre ipucunda ve Excel'de); % payı cari satırında ödeme türü içi, tür satırında genel.</span>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>

    <div class="na-kart">
        <div class="na-kart-b"><span><i class="fas fa-filter me-1"></i>Filtreler</span><span class="d-flex gap-2 align-items-center"><button type="button" class="btn btn-light btn-sm py-0" id="coTemizle" style="font-size:.66rem">Temizle</button><button type="button" class="btn btn-light btn-sm py-0" id="coExcel" style="font-size:.66rem"><i class="fas fa-file-excel me-1"></i>Excel</button></span></div>
        <div class="na-kart-g">
            <div class="co-filtre">
                <div><label>Şirket</label><select class="form-select" id="coSirket"><option value="">Tümü (Konsolide)</option>@foreach (var s in sirketler) { <option selected="@(s == varsayilanSirket)">@s</option> }</select></div>
                <div><label>Vade Yılı</label><select class="form-select" id="coYil"></select></div>
                <div><label>Ödeme Türü</label><select class="form-select" id="coTur"><option value="">Tümü</option></select></div>
                <div><label>Durum</label><select class="form-select" id="coDurum"><option value="">Tümü</option></select></div>
                <div><label>Tahsil Bankası</label><select class="form-select" id="coBanka"><option value="">Tümü</option></select></div>
                <div class="ara"><label>Ara</label><input class="form-control" id="coAra" placeholder="Cari adı, cari kodu, belge no, banka…"></div>
            </div>
        </div>
    </div>

    <div class="na-sekme" id="coSekmeler" data-dinamik="kapali">
        <button type="button" data-p="vc"><i class="fas fa-file-invoice-dollar me-1"></i>Verilen Çekler <span class="n" id="coN-vc">0</span></button>
        <button type="button" data-p="vs"><i class="fas fa-file-signature me-1"></i>Verilen Senetler <span class="n" id="coN-vs">0</span></button>
        <button type="button" data-p="tc"><i class="fas fa-building-columns me-1"></i>Tahsile Gönderilen Çekler <span class="n" id="coN-tc">0</span></button>
        <button type="button" data-p="ts"><i class="fas fa-landmark me-1"></i>Tahsile Gönderilen Senetler <span class="n" id="coN-ts">0</span></button>
        <button type="button" data-p="nakit"><i class="fas fa-scale-balanced me-1"></i>Aylık Nakit Görünümü · Çek + Senet</button>
    </div>

    @* ============================ VERİLEN ÇEKLER / VERİLEN SENETLER ============================ *@
    @foreach (var p in verilenPaneller)
    {
    <div class="na-panel" data-p="@p.Item1">
        <div class="na-kpi" id="coKpi-@p.Item1" data-dinamik="kapali" style="grid-template-columns:repeat(8,1fr)"></div>
        <div class="co-rapor-ust">
            <div><h5><span class="co-yil">@yil</span> Vade Tarihine Göre Verilen @p.Item2 Özeti</h5><div class="alt">Tedarikçi • Maaş • Kira • Verilen Toplam • Tahsile Gönderilen (Ziraat · Halk Bankası) • Net</div></div>
            <div class="ayar"><span class="co-pill co-kapsam" style="background:rgba(255,255,255,.15);color:#fff;border-color:rgba(255,255,255,.3)"></span><button type="button" class="btn btn-light btn-sm py-0" id="coVExcel-@p.Item1"><i class="fas fa-file-excel me-1"></i>Excel</button></div>
        </div>
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas @p.Item4 me-1"></i>Cari Bazında Aylık Verilen @p.Item2 · Tahsile Gönderilen @p.Item2</span><span class="not" id="coVNot-@p.Item1">vade ayına göre · tutarlar TL · satır ya da hücreye tıklayınca belge listesi</span></div><div class="na-kart-g p-0"><div class="table-responsive" style="max-height:72vh"><table class="na-tablo co-excel" id="coVerilenTablo-@p.Item1" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div></div>
    </div>
    }

    @* ============================ TAHSİLE GÖNDERİLEN ÇEKLER / SENETLER ============================ *@
    @foreach (var p in tahsilPaneller)
    {
    <div class="na-panel" data-p="@p.Item1">
        <div class="na-kpi" id="coTKpi-@p.Item1" data-dinamik="kapali" style="grid-template-columns:repeat(9,1fr)"></div>
        <div class="co-rapor-ust">
            <div><h5><span class="co-yil">@yil</span> Tahsile Gönderilen Müşteri @p.Item3</h5><div class="alt">Vade Ayına Göre • Ziraat Bankası • Halk Bankası • Tahsil Edildi • Tahsilde • Karşılıksız</div></div>
            <div class="ayar"><span class="co-pill co-kapsam" style="background:rgba(255,255,255,.15);color:#fff;border-color:rgba(255,255,255,.3)"></span><button type="button" class="btn btn-light btn-sm py-0" id="coTExcel-@p.Item1"><i class="fas fa-file-excel me-1"></i>Excel</button></div>
        </div>
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas @p.Item4 me-1"></i>Banka Bazında Aylık Tahsile Gönderilen @p.Item2</span><span class="not" id="coTNot-@p.Item1">bankaya ibraz edilen belgeler (tahsil edildi + tahsilde + karşılıksız) · portföyde bekleyen ve ciro edilenler sayılmaz</span></div><div class="na-kart-g p-0"><div class="table-responsive" style="max-height:72vh"><table class="na-tablo co-excel" id="coTahsilTablo-@p.Item1" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div></div>
    </div>
    }

    @* ============================ AYLIK NAKİT GÖRÜNÜMÜ (ÇEK + SENET ORTAK) ============================ *@
    <div class="na-panel" data-p="nakit">
        <div class="co-rapor-ust">
            <div><h5><span class="co-yil">@yil</span> Aylık Nakit Görünümü · Çek ve Senet Ortak</h5><div class="alt">Verilen Çek • Verilen Senet • Tahsile Gönderilen Çek • Tahsile Gönderilen Senet • Portföy • Net • Kümülatif</div></div>
            <div class="ayar"><span class="co-pill co-kapsam" style="background:rgba(255,255,255,.15);color:#fff;border-color:rgba(255,255,255,.3)"></span><button type="button" class="btn btn-light btn-sm py-0" id="coNExcel"><i class="fas fa-file-excel me-1"></i>Excel</button></div>
        </div>
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-scale-balanced me-1"></i>Ay Ay Verilen ve Tahsile Gönderilen · Çek + Senet</span><span class="not">net = tahsile gönderilen − verilen · kümülatif yıl başından · tutarlar TL</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo co-excel" id="coNakitTablo" data-dinamik="kapali"><thead></thead><tbody></tbody></table></div></div></div>
        <div class="na-mini rt-aciklama">Verilen çek ve senetler vade ayına göre ödenecek tutarı, tahsile gönderilen çek ve senetler aynı ayda bankadan (Ziraat Bankası, Halk Bankası) beklenen girişi gösterir. Portföyde bekleyen (henüz bankaya verilmemiş) ve ciro edilen müşteri belgeleri bilgi amaçlı ayrı satırlardadır. Karşılıksız belgeler tahsile gönderilmiş sayılır ancak giriş sağlamaz.</div>
    </div>

    <div class="co-perde" id="coPerde"></div>
    <div class="co-drawer" id="coDrawer">
        <div class="co-drawer-ust"><b id="coDrawerBaslik" style="font-size:.9rem"></b><span class="ms-auto d-flex gap-1 flex-wrap" id="coDrawerAksiyon"></span><button type="button" class="btn btn-light btn-sm py-0" id="coDrawerKapat" style="font-size:.66rem"><i class="fas fa-xmark"></i></button></div>
        <div id="coDrawerIc"></div>
    </div>
</div>

@section Scripts {
<script src="/js/cek-ozet.js?v=8"></script>
}
