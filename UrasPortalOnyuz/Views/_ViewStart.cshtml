@{
    // ?portal=1 ile açılan sayfa (Uras Üretim portalı menüsünden gelen ana portal raporu, ör. Parti Yaşlandırma)
    // ana kabuk yerine üretim kabuğunda çizilir. UrasUretim* klasörlerinin kendi _ViewStart'ı bunu zaten sabitler.
    Layout = string.Equals(Context.Request.Query["portal"], "1") ? "_UretimLayout" : "_Layout";
}
