@model List<WebApplication3.Models.Rapor2ViewModel>
@using WebApplication3.Models
@using System.Globalization;
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Xsrf

@{
    ViewData["Title"] = "Çek Akıbeti Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 1. KURAL: URL'den veya Cookie'den aktif şirketi okuyan değişken
    var currentDb = Context.Request.Query["db"].ToString();
    if (string.IsNullOrEmpty(currentDb))
    {
        currentDb = Context.Request.Cookies["SelectedDatabase"] ?? "";
    }

    var checkTransactionTypes = (List<CheckTransactionType>)ViewBag.CheckTransactionTypes ?? new List<CheckTransactionType>();

    // Kullanım Durumu için sabit seçenekler
    var kullanumDurumuOptions = new List<string> {
        "Portföyde", "Planlandı", "Çıkışı Yapıldı", "Tahsil Edildi",
        "Karşılıksız (Resmi)", "Protestolu (Resmi)", "Riskli (Konkordato)", "Kapandı (İade/İptal)"
    };

    var reportDataJson = Model != null ? JsonConvert.SerializeObject(Model, new JsonSerializerSettings { DateFormatString = "yyyy-MM-dd" }) : "[]";
    var checkTransactionTypesJson = JsonConvert.SerializeObject(checkTransactionTypes);

    var distinctCekNumarasiList = Model?.Where(m => !string.IsNullOrEmpty(m.CekNumarasi)).Select(m => m.CekNumarasi).Distinct().OrderBy(s => s).ToList();
    var distinctBankaAdiList = Model?.Where(m => !string.IsNullOrEmpty(m.BankaAdi)).Select(m => m.BankaAdi).Distinct().OrderBy(s => s).ToList();
    var distinctSubeList = Model?.Where(m => !string.IsNullOrEmpty(m.Sube)).Select(m => m.Sube).Distinct().OrderBy(s => s).ToList();
    var distinctCekKimdenGeldiList = Model?.Where(m => !string.IsNullOrEmpty(m.CekKimdenGeldi)).Select(m => m.CekKimdenGeldi).Distinct().OrderBy(s => s).ToList();
    var distinctAsilBorcluList = Model?.Where(m => !string.IsNullOrEmpty(m.AsilBorclu)).Select(m => m.AsilBorclu).Distinct().OrderBy(s => s).ToList();
    var distinctTutarList = Model?.Where(m => m.Tutar.HasValue).Select(m => m.Tutar.Value).Distinct().OrderBy(v => v).Select(v => v.ToString("N2", new CultureInfo("tr-TR"))).ToList();
    var distinctParaBirimiList = Model?.Where(m => !string.IsNullOrEmpty(m.ParaBirimi)).Select(m => m.ParaBirimi).Distinct().OrderBy(s => s).ToList();
    var distinctVadeTarihiList = Model?.Where(m => m.VadeTarihi.HasValue).Select(m => m.VadeTarihi.Value.ToString("dd.MM.yyyy")).Distinct().OrderBy(s => DateTime.Parse(s, new CultureInfo("tr-TR"))).ToList();
    var distinctVadeAyiVeYiliList = Model?.Where(m => !string.IsNullOrEmpty(m.VadeAyiVeYili)).Select(m => m.VadeAyiVeYili).Distinct().OrderBy(s => s).ToList();
    var distinctPortfoyVadeAyiYiliList = Model?.Where(m => !string.IsNullOrEmpty(m.PortfoyVadeAyiYili)).Select(m => m.PortfoyVadeAyiYili).Distinct().OrderBy(s => s).ToList();
    var distinctPortfoyeGirisTarihiList = Model?.Where(m => m.PortfoyeGirisTarihi.HasValue).Select(m => m.PortfoyeGirisTarihi.Value.ToString("dd.MM.yyyy")).Distinct().OrderBy(s => DateTime.Parse(s, new CultureInfo("tr-TR"))).ToList();
    var distinctIbrazTarihiList = Model?.Where(m => m.IbrazTarihi.HasValue).Select(m => m.IbrazTarihi.Value.ToString("dd.MM.yyyy")).Distinct().OrderBy(s => DateTime.Parse(s, new CultureInfo("tr-TR"))).ToList();
    var distinctTahsilatBelgeNoList = Model?.Where(m => !string.IsNullOrEmpty(m.TahsilatBelgeNo)).Select(m => m.TahsilatBelgeNo).Distinct().OrderBy(s => s).ToList();
    var distinctIbrazBelgeNoList = Model?.Where(m => !string.IsNullOrEmpty(m.IbrazBelgeNo)).Select(m => m.IbrazBelgeNo).Distinct().OrderBy(s => s).ToList();
    var distinctHareketDurumuList = Model?.Where(m => !string.IsNullOrEmpty(m.HareketDurumu)).Select(m => m.HareketDurumu).Distinct().OrderBy(s => s).ToList();
    var distinctBelgeTipiList = Model?.Where(m => !string.IsNullOrEmpty(m.BelgeTipi)).Select(m => m.BelgeTipi).Distinct().OrderBy(s => s).ToList();
    var distinctCekIslemTuruList = Model?.Where(m => !string.IsNullOrEmpty(m.CekIslemTuru)).Select(m => m.CekIslemTuru).Distinct().OrderBy(s => s).ToList();
    var distinctIslemTipiAdiList = Model?.Where(m => !string.IsNullOrEmpty(m.IslemTipiAdi)).Select(m => m.IslemTipiAdi).Distinct().OrderBy(s => s).ToList();
    var distinctPlanlananTedarikciList = Model?.Where(m => !string.IsNullOrEmpty(m.PlanlananTedarikci)).Select(m => m.PlanlananTedarikci).Distinct().OrderBy(s => s).ToList();
    var distinctCekKimeVerildiList = Model?.Where(m => !string.IsNullOrEmpty(m.CekKimeVerildi)).Select(m => m.CekKimeVerildi).Distinct().OrderBy(s => s).ToList();
    var distinctTlKarsiligiList = Model?.Where(m => m.TlKarsiligi.HasValue).Select(m => m.TlKarsiligi.Value).Distinct().OrderBy(v => v).Select(v => v.ToString("N2", new CultureInfo("tr-TR"))).ToList();
    var distinctSirketAdiList = Model?.Where(m => !string.IsNullOrEmpty(m.SirketAdi)).Select(m => m.SirketAdi).Distinct().OrderBy(s => s).ToList();
    var distinctCekBankaAdiList = Model?.Where(m => !string.IsNullOrEmpty(m.CekBankaAdi)).Select(m => m.CekBankaAdi).Distinct().OrderBy(s => s).ToList();

    var checkTransactionTypesForFilter = checkTransactionTypes.OrderBy(t => t.Description).ToList();
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #007bff;
            --secondary-color: #6c757d;
            --success-color: #28a745;
            --danger-color: #dc3545;
            --info-color: #17a2b8;
            --light-bg: #f8f9fa;
            --white-bg: #ffffff;
            --border-color: #e0e0e0;
            --text-color: #333;
            --header-bg: #e9ecef;
            --shadow-light: 0 2px 8px rgba(0,0,0,0.05);
            --shadow-medium: 0 4px 15px rgba(0,0,0,0.1);
        }

        body {
            background-color: var(--light-bg);
            font-family: 'Poppins', sans-serif;
            line-height: 1.5;
            font-size: 0.8rem;
            margin: 0;
            padding: 0;
        }

        .container.mt-4 {
            max-width: 100%;
            padding: 0 15px;
            margin-top: 0 !important;
        }

        h1, h2, h3, h4, h5, h6 {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 0.4rem;
            font-size: 1.2rem;
        }

        .form-group.row {
            display: none;
        }

        .form-group label {
            font-weight: 500;
            color: #555;
            margin-bottom: 0;
            padding-right: 8px;
            font-size: 0.8rem;
        }

        .form-group .col-sm-4 {
            flex-grow: 1;
            min-width: 150px;
        }

        select,
        .filter-input,
        .check-transaction-select,
        .multi-select-button,
        .planned-supplier-input {
            width: 100%;
            height: 30px;
            padding: 4px 8px;
            font-size: 0.8rem;
            line-height: 1.5;
            box-sizing: border-box;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            background-color: var(--white-bg);
            transition: all 0.2s ease-in-out;
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%236c757d' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 0.5rem center;
            background-size: 12px 9px;
        }

            select:focus,
            .filter-input:focus,
            .check-transaction-select:focus,
            .multi-select-button:focus,
            .planned-supplier-input:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
                outline: none;
            }

            select#dbSelection.form-control {
                max-width: 300px;
                min-width: 150px;
            }

        .database-info {
            background-color: #e6f7ff;
            border-color: #b3e0ff;
            color: #0056b3;
            padding: 0.8rem 1rem;
            margin-bottom: 1rem;
            border-radius: 6px;
            align-items: center;
            font-size: 0.9rem;
            box-shadow: var(--shadow-light);
            display: none;
        }

            .database-info i {
                margin-right: 0.6rem;
                font-size: 1.1rem;
                color: var(--info-color);
            }

        .table-container {
            overflow: auto;
            max-height: 72vh; /* Dengesiz div kapanış hatasını ve taşmaları önlemek için yükseklik güvenli sınıra çekildi */
            border-radius: 8px;
            box-shadow: var(--shadow-medium);
            background-color: var(--white-bg);
            margin-top: 0.5rem;
            border: 1px solid var(--border-color);
        }

        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            table-layout: fixed;
            min-width: 1200px;
        }

        th {
            background-color: var(--header-bg);
            color: #495057;
            position: sticky;
            top: 0;
            z-index: 10;
            padding: 8px 5px;
            text-align: left;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-weight: 600;
            border-bottom: 1px solid var(--border-color);
            line-height: 1.2;
            vertical-align: middle;
            font-size: 0.85rem;
        }

            th .column-title {
                cursor: pointer;
                user-select: none;
                display: inline-block;
                vertical-align: middle;
                max-width: calc(100% - 30px);
                overflow: hidden;
                text-overflow: ellipsis;
            }

            th .multi-select-dropdown {
                margin-top: 4px;
            }

            th.expanded {
                white-space: normal;
                overflow: visible;
                text-overflow: initial;
            }

            th .sort-icon {
                margin-left: 5px;
                font-size: 0.8em;
                vertical-align: middle;
                display: inline-block;
                opacity: 0.6;
                transition: opacity 0.2s ease-in-out;
            }

            th:hover .sort-icon {
                opacity: 1;
            }

            th:first-child {
                border-top-left-radius: 8px;
            }

            th:last-child {
                border-top-right-radius: 8px;
            }

        td {
            padding: 6px 5px;
            vertical-align: top;
            border-bottom: 1px solid #f2f2f2;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 0.8rem;
            line-height: 1.4;
            transition: background-color 0.2s ease-in-out;
        }

            td.expanded {
                white-space: normal;
                overflow: visible;
                text-overflow: initial;
                height: auto;
            }

        tr:last-child td {
            border-bottom: none;
        }

        .table-hover tbody tr:hover {
            background-color: #f0f8ff;
            cursor: pointer;
        }

        .table-hover tbody tr.selected {
            background-color: #e0f2f7;
            border-left: 2px solid var(--primary-color);
            transition: background-color 0.2s ease-in-out, border-left 0.2s ease-in-out;
        }

        th:nth-child(1),
        td:nth-child(1) {
            min-width: 50px;
            width: 50px;
            text-align: center;
        }

            td:nth-child(1) input[type="checkbox"] {
                transform: scale(1.2);
            }

        td:nth-child(4),
        td:nth-child(5),
        td:nth-child(6),
        td:nth-child(7),
        td:nth-child(8),
        td:nth-child(9),
        td:nth-child(10),
        td:nth-child(11),
        td:nth-child(12),
        td:nth-child(13) {
            text-align: right;
            font-weight: 500;
        }

        th:nth-child(2), td:nth-child(2) { min-width: 150px; max-width: 200px; }
        th:nth-child(3), td:nth-child(3) { min-width: 250px; max-width: 350px; }
        th:nth-child(4), td:nth-child(4) { min-width: 150px; }
        th:nth-child(5), td:nth-child(5) { min-width: 180px; }
        th:nth-child(6), td:nth-child(6) { min-width: 180px; }
        th:nth-child(7), td:nth-child(7) { min-width: 180px; }
        th:nth-child(8), td:nth-child(8) { min-width: 180px; }
        th:nth-child(9), td:nth-child(9) { min-width: 180px; }
        th:nth-child(10), td:nth-child(10) { min-width: 180px; }
        th:nth-child(11), td:nth-child(11) { min-width: 180px; }
        th:nth-child(12), td:nth-child(12) { min-width: 180px; }
        th:nth-child(13), td:nth-child(13) { min-width: 180px; }

        .alert-success, .alert-danger {
            margin-top: 1.5rem;
            padding: 1rem 1.5rem;
            border-radius: 8px;
            text-align: center;
            font-size: 1.05rem;
            font-weight: 500;
            opacity: 0;
            transform: translateY(-20px);
            transition: opacity 0.3s ease-out, transform 0.3s ease-out;
        }

            .alert-success.show, .alert-danger.show {
                opacity: 1;
                transform: translateY(0);
            }

        .multi-select-options {
            display: none;
            position: absolute;
            background-color: var(--white-bg);
            min-width: fit-content;
            max-width: 350px;
            box-shadow: var(--shadow-medium);
            z-index: 9999;
            border-radius: 8px;
            padding: 10px;
            max-height: 350px;
            overflow-y: auto;
            left: 0;
            top: 100%;
            border: 1px solid var(--border-color);
            transform: translateY(10px);
            opacity: 0;
            transition: transform 0.3s ease-out, opacity 0.3s ease-out;
        }

        .multi-select-button {
            width: 100%;
            height: 28px;
            padding: 4px 8px;
            font-size: 0.8rem;
            line-height: 1.5;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            background-color: var(--white-bg);
            cursor: pointer;
            text-align: left;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s ease-in-out;
        }

            .multi-select-button:hover {
                border-color: var(--primary-color);
                box-shadow: 0 2px 8px rgba(0, 123, 255, 0.1);
            }

            .multi-select-button::after {
                display: inline-block;
                margin-left: 0.5em;
                vertical-align: middle;
                content: "";
                border-top: 0.3em solid var(--secondary-color);
                border-right: 0.3em solid transparent;
                border-bottom: 0;
                border-left: 0.3em solid transparent;
                transition: transform 0.2s ease-in-out;
            }

            .multi-select-button[aria-expanded="true"]::after {
                transform: rotate(180deg);
            }

        .multi-select-options.show {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }

        .multi-select-option {
            padding: 6px 0;
            display: flex;
            align-items: center;
            transition: background-color 0.1s ease-in-out;
        }

            .multi-select-option:hover {
                background-color: #f8f8f8;
            }

            .multi-select-option label {
                margin-left: 8px;
                margin-bottom: 0;
                cursor: pointer;
                font-weight: 400;
                flex-grow: 1;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .multi-select-option input[type="checkbox"] {
                cursor: pointer;
                flex-shrink: 0;
                transform: scale(1.1);
            }

        .multi-select-header {
            padding-bottom: 8px;
            margin-bottom: 8px;
            border-bottom: 1px solid #e0e0e0;
            display: flex;
            align-items: center;
        }

            .multi-select-header label {
                font-weight: 600;
            }

        .multi-select-search-input {
            width: 100%;
            padding: 8px 12px;
            margin-bottom: 10px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            box-sizing: border-box;
        }

        .multi-select-actions {
            display: none;
        }

        .summary-and-export {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0 !important;
            padding-top: 0px !important;
        }

        .total-amount-display {
            font-weight: 600;
            color: var(--success-color);
            padding: 10px 15px;
            background-color: #e8f5e9;
            border: 1px solid #c8e6c9;
            border-radius: 6px;
            text-align: left;
            font-size: 1rem;
            box-shadow: var(--shadow-light);
            margin-bottom: 0;
        }

        .export-button-container {
            display: flex;
            gap: 10px;
            margin-bottom: 0;
        }

            .export-button-container .btn {
                height: 32px;
                padding: 0 15px;
                font-size: 0.9rem;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 5px;
            }

        .btn-warning, .btn-info, .btn-success {
            border-radius: 4px;
        }

        .multi-select-dropdown {
            position: relative;
            display: block;
            width: 100%;
        }

        .resizable-column-handle {
            position: absolute;
            right: -4px;
            top: 0;
            height: 100%;
            width: 8px;
            cursor: col-resize;
            background-color: rgba(0, 0, 0, 0);
            z-index: 1;
        }

        td a {
            color: var(--primary-color);
            text-decoration: none;
        }

            td a:hover {
                text-decoration: underline;
            }

        .sortable-list .list-group-item {
            cursor: grab;
            user-select: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            margin-bottom: 5px;
            border-radius: 4px;
            background-color: var(--light-bg);
            border: 1px solid var(--border-color);
            transition: background-color 0.2s ease;
        }

            .sortable-list .list-group-item:active {
                cursor: grabbing;
            }

            .sortable-list .list-group-item:hover {
                background-color: #f0f0f0;
            }

            .sortable-list .list-group-item i.fas {
                opacity: 0.5;
                margin-right: 10px;
            }
    </style>
}

@* 2. KURAL: Güvenlik (CSRF) - Yetkisiz istekleri engellemek amacıyla eklendi *@
@Html.AntiForgeryToken()

<div class="container mt-4">

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.ErrorMessage
        </div>
    }

    <div id="alertContainer" class="mt-3"></div>

    @if (Model != null && Model.Any())
    {
        <div class="mb-3">
            <button id="clearAllFiltersBtn" class="btn btn-warning">Tüm Filtreleri Temizle</button>
        </div>

        <div class="summary-and-export">
            <div class="total-amount-display">
                Seçilen Toplam TL Tutarı: <span id="totalSelectedTlAmount">0,00</span>
            </div>
            <div class="export-button-container">
                <button id="highlightTransactionsBtn" class="btn btn-primary me-2">
                    <i class="fas fa-hand-holding-dollar me-2"></i> Şirketler Arası İşlemleri Vurgula
                </button>
                <button id="clearFiltersBtn" class="btn btn-warning">
                    <i class="fas fa-filter-circle-xmark me-2"></i> Filtreleri Temizle
                </button>
                <button id="manageColumnsBtn" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#columnVisibilityModal">
                    <i class="fas fa-table-list me-2"></i> Sütunları Yönet
                </button>
                <button id="exportToExcelBtn" class="btn btn-success">
                    <i class="fas fa-file-excel me-2"></i> Excel'e Aktar
                </button>
            </div>
        </div>

        <div class="table-container">
            <table class="table table-bordered table-striped table-hover rapor-tablo" id="rapor2Table">
                <thead>
                    <tr class="main-header-row">
                        <th style="width: 20px;">
                            <input type="checkbox" id="selectAllCheckbox">
                        </th>
                        <th data-column="0" data-sort-type="text" style="width: 150px;">
                            <span class="column-title">Çek No</span> <i class="fas fa-sort sort-icon"></i>
                            <div class="multi-select-dropdown">
                                <button type="button" class="multi-select-button" data-column="0" aria-expanded="false">Tümü</button>
                                <div class="multi-select-options" id="multi-select-options-0">
                                    <input type="text" class="multi-select-search-input" placeholder="Ara...">
                                    <div class="multi-select-header">
                                        <input type="checkbox" class="select-all-options-in-filter">
                                        <label>(Tümünü Seç)</label>
                                    </div>
                                    @if (distinctCekNumarasiList != null)
                                    {
                                        foreach (var item in distinctCekNumarasiList)
                                        {
                                            <div class="multi-select-option">
                                                <input type="checkbox" value="@item">
                                                <label>@item</label>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="resizable-column-handle"></div>
                        </th>
                        <th data-column="1" data-sort-type="text" style="width: 150px;">
                            <span class="column-title">Çek Kimden Geldi</span> <i class="fas fa-sort sort-icon"></i>
                            <div class="multi-select-dropdown">
                                <button type="button" class="multi-select-button" data-column="1" aria-expanded="false">Tümü</button>
                                <div class="multi-select-options" id="multi-select-options-1">
                                    <input type="text" class="multi-select-search-input" placeholder="Ara...">
                                    <div class="multi-select-header">
                                        <input type="checkbox" class="select-all-options-in-filter">
                                        <label>(Tümünü Seç)</label>
                                    </div>
                                    @if (distinctCekKimdenGeldiList != null)
                                    {
                                        foreach (var item in distinctCekKimdenGeldiList)
                                        {
                                            <div class="multi-select-option">
                                                <input type="checkbox" value="@item">
                                                <label>@item</label>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="resizable-column-handle"></div>
                        </th>
                        <th data-column="2" data-sort-type="text" style="width: 150px;">
