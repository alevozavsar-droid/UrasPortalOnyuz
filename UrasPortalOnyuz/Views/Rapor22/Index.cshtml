                <tbody id="tableBody">
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr data-docentry="@item.DocEntry" data-ibraz-belge-no="@item.IbrazBelgeNo"
                                data-cek-numarasi="@item.CekNumarasi"
                                data-tutar="@(item.Tutar?.ToString(CultureInfo.InvariantCulture) ?? "0")"
                                data-cek-bankasi="@item.CekBankaAdi">
                                <td>
                                    <input type="checkbox" class="row-checkbox" data-tl-value="@(item.TlKarsiligi?.ToString(CultureInfo.InvariantCulture))">
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.CekNumarasi)</td>
                                <td>@Html.DisplayFor(modelItem => item.CekKimdenGeldi)</td>
                                <td>@Html.DisplayFor(modelItem => item.AsilBorclu)</td>
                                <td>@(item.Tutar?.ToString("N2"))</td>
                                <td>@Html.DisplayFor(modelItem => item.ParaBirimi)</td>
                                <td>@(item.VadeTarihi?.ToString("dd.MM.yyyy"))</td>
                                <td>@Html.DisplayFor(modelItem => item.VadeAyiVeYili)</td>
                                <td>@(item.PortfoyeGirisTarihi?.ToString("dd.MM.yyyy"))</td>
                                <td>@(item.IbrazTarihi?.ToString("dd.MM.yyyy"))</td>
                                <td>@Html.DisplayFor(modelItem => item.TahsilatBelgeNo)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.IbrazBelgeNo))
                                    {
                                        @* 1. KURAL: Ek indirme linkine db parametresi eklendi *@
                                        <a href="@Url.Action("DownloadAttachment", "Rapor2", new { ibrazBelgeNo = item.IbrazBelgeNo, db = currentDb })"
                                           title="Eki Görüntüle" target="_blank" onclick="event.stopPropagation();">
                                            @Html.DisplayFor(modelItem => item.IbrazBelgeNo)
                                        </a>
                                    }
                                    else
                                    {
                                        @Html.DisplayFor(modelItem => item.IbrazBelgeNo)
                                    }
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.HareketDurumu)</td>
                                <td>@Html.DisplayFor(modelItem => item.BelgeTipi)</td>
                                <td>
                                    <select class="form-control check-transaction-select" data-docentry="@item.DocEntry" data-previous-value="@item.CekIslemTuru" disabled>
                                        <option value=""></option>
                                        @foreach (var type in checkTransactionTypes)
                                        {
                                            <option value="@type.Code" selected="@(item.CekIslemTuru == type.Code)">
                                                @type.Description
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.IslemTipiAdi)</td>
                                <td>
                                    @{
                                        bool isDisabled = item.HareketDurumu != "Portföyde";
                                    }
                                    <input type="text" class="form-control planned-supplier-input"
                                           list="suppliersList_@item.DocEntry"
                                           value="@item.PlanlananTedarikci"
                                           data-docentry="@item.DocEntry"
                                           data-previous-value="@item.PlanlananTedarikci"
                                           disabled="@isDisabled" readonly />
                                    <datalist id="suppliersList_@item.DocEntry"></datalist>
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.CekKimeVerildi)</td>
                                <td>@(item.TlKarsiligi?.ToString("N2"))</td>
                                <td>@Html.DisplayFor(modelItem => item.SirketAdi)</td>
                                <td>@Html.DisplayFor(modelItem => item.CekBankaAdi)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="row g-0 mt-2 p-2 border-top bg-light rounded-bottom">
            <div class="col-md-4 d-flex align-items-center text-muted small fw-bold">
                Toplam Kayıt: <span id="totalRecords" class="text-primary ms-1">@(Model?.Count ?? 0)</span>
            </div>
            <div class="col-md-8 text-end">
            </div>
        </div>
    }
</div>

<div class="modal fade" id="columnVisibilityModal" tabindex="-1" aria-labelledby="columnVisibilityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content column-visibility-modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="columnVisibilityModalLabel">Sütun Görünürlüğünü Yönet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="columnVisibilityModalBody">
                <p class="mb-3 text-secondary"><i class="fas fa-info-circle me-1"></i> Sütunları sürükleyip bırakarak sıralarını değiştirebilirsiniz.</p>
                <div id="sortable-column-list" class="list-group">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="saveColumnVisibilityBtn">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@* 4. KURAL: UI/UX Standartlarına uygun şık, db parametreli Ana Sayfa Dönüş butonu *@
<div class="mt-4 text-center">
    <a asp-controller="Home" asp-action="Index" asp-route-db="@currentDb" class="btn btn-outline-secondary fw-bold shadow-sm mb-4">
        <i class="fas fa-home me-2"></i> Ana Sayfaya Dön
    </a>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            const currentDbParam = '@currentDb';
            const dbQueryString = currentDbParam ? `?db=${currentDbParam}` : '';
            const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            const table = document.getElementById('rapor2Table');
            if (!table) return;

            const tableBody = table.querySelector('tbody');
            let tableHeaders = Array.from(table.querySelectorAll('thead th'));
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            const totalSelectedTlAmountSpan = document.getElementById('totalSelectedTlAmount');
            const exportToExcelBtn = document.getElementById('exportToExcelBtn');
            const clearFiltersBtn = document.getElementById('clearFiltersBtn');
            const highlightTransactionsBtn = document.getElementById('highlightTransactionsBtn');

            let allOriginalRows = Array.from(tableBody.querySelectorAll('tr'));
            let currentlyFilteredRows = [...allOriginalRows];
            const multiSelectFilterStates = {};
            const checkTransactionTypesJs = @Html.Raw(checkTransactionTypesJson) || [];
            let currentSortColumn = -1;
            let currentSortDirection = 'none';

            // Sıralama simgeleri (diğer raporlardaki updateHeaderIcons ile aynı; bu görünümde tanımı eksikti)
            function updateHeaderIcons() {
                tableHeaders.forEach(th => {
                    const icon = th.querySelector('.sort-icon');
                    if (!icon) return;
                    icon.classList.remove('fa-sort-up', 'fa-sort-down', 'fa-sort');
                    const ayniKolon = th.dataset.column !== undefined && String(th.dataset.column) === String(currentSortColumn);
                    if (ayniKolon && currentSortDirection === 'asc') icon.classList.add('fa-sort-up');
                    else if (ayniKolon && currentSortDirection === 'desc') icon.classList.add('fa-sort-down');
                    else icon.classList.add('fa-sort');
                });
            }
            let isHighlighted = false;

            const columnVisibilityKey = 'rapor2_column_visibility';
            const savedVisibility = JSON.parse(localStorage.getItem(columnVisibilityKey)) || {};
            const columnOrderKey = 'rapor2_column_order';
            let savedOrder = JSON.parse(localStorage.getItem(columnOrderKey)) || [];

            function updateSelectAllInFilterCheckboxState(optionsContainerElement) {
                const visibleOptionCheckboxes = Array.from(optionsContainerElement.querySelectorAll('.multi-select-option input[type="checkbox"]'))
                    .filter(cb => cb.closest('.multi-select-option').style.display !== 'none');
                const selectAllCb = optionsContainerElement.querySelector('.select-all-options-in-filter');
                if (!selectAllCb) return;

                if (visibleOptionCheckboxes.length === 0) {
                    selectAllCb.checked = false;
                    selectAllCb.indeterminate = false;
                    return;
                }
                const allVisibleChecked = visibleOptionCheckboxes.every(cb => cb.checked);
                const anyVisibleChecked = visibleOptionCheckboxes.some(cb => cb.checked);
                if (allVisibleChecked) {
                    selectAllCb.checked = true;
                    selectAllCb.indeterminate = false;
                } else if (anyVisibleChecked) {
                    selectAllCb.checked = false;
                    selectAllCb.indeterminate = true;
                } else {
                    selectAllCb.checked = false;
                    selectAllCb.indeterminate = false;
                }
            }

            function updateButtonText(btn, selectedVals, allOpts, colIndex) {
                const totalOptionsCount = allOpts.length;
                if (selectedVals.length === 0 || selectedVals.length === totalOptionsCount) {
                    btn.textContent = 'Tümü';
                } else if (selectedVals.length === 1) {
                    if (colIndex === 13) {
                        const selectedCode = selectedVals[0];
                        const matchingType = checkTransactionTypesJs.find(t => t.code && t.code.toLowerCase() === selectedCode);
                        btn.textContent = matchingType ? matchingType.description : selectedCode;
                    } else {
                        const selectedLabelElement = Array.from(allOpts).find(opt => (opt.querySelector('input[type="checkbox"]')?.value || '').toLowerCase() === selectedVals[0]);
                        btn.textContent = selectedLabelElement ? (selectedLabelElement.querySelector('label')?.textContent || '') : selectedVals[0];
                    }
                } else {
                    btn.textContent = `${selectedVals.length} Seçili`;
                }
            }

            function showAlert(message, type) {
                const alertContainer = document.getElementById('alertContainer');
                const existingAlert = alertContainer.querySelector('.alert');
                if (existingAlert) {
                    new bootstrap.Alert(existingAlert).close();
                }
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type} fade show`;
                alertDiv.setAttribute('role', 'alert');
                alertDiv.innerHTML = `${message}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>`;
                alertContainer.appendChild(alertDiv);
                setTimeout(() => {
                    const bsAlert = bootstrap.Alert.getOrCreateInstance(alertDiv);
                    if (bsAlert) {
                        bsAlert.close();
                    }
                }, 3000);
            }

            function applyColumnVisibilityAndOrder() {
                const headerRow = table.querySelector('thead tr');
                const originalHeaders = Array.from(headerRow.querySelectorAll('th'));
                const originalBodyRows = Array.from(tableBody.querySelectorAll('tr'));
                const newHeadersOrder = [];

                if (savedOrder.length > 0) {
                    savedOrder.forEach(colIndex => {
                        const header = originalHeaders.find(h => parseInt(h.dataset.column) === colIndex);
                        if (header) {
                            newHeadersOrder.push(header);
                        }
                    });
                    const firstColumnHeader = originalHeaders.find(h => !h.dataset.column);
                    if (firstColumnHeader) newHeadersOrder.unshift(firstColumnHeader);
                } else {
                    newHeadersOrder.push(...originalHeaders);
                }

                while (headerRow.firstChild) {
                    headerRow.removeChild(headerRow.firstChild);
                }
                newHeadersOrder.forEach(th => {
                    const columnIndex = parseInt(th.dataset.column);
                    const isHiddenByDefault = th.dataset.defaultVisibility === 'hidden';
                    const isVisible = savedVisibility[columnIndex] !== undefined ? savedVisibility[columnIndex] : !isHiddenByDefault;

                    if (isVisible) {
                        headerRow.appendChild(th);
                    }
                });

                originalBodyRows.forEach(row => {
                    const originalCells = Array.from(row.cells);
                    const newRow = row.cloneNode(true);
                    while (newRow.firstChild) {
                        newRow.removeChild(newRow.firstChild);
                    }
                    newHeadersOrder.forEach(th => {
                        const columnIndex = parseInt(th.dataset.column);
                        const originalIndex = Array.from(originalHeaders).indexOf(th);
                        const isVisible = savedVisibility[columnIndex] !== undefined ? savedVisibility[columnIndex] : !(th.dataset.defaultVisibility === 'hidden');
                        if (isVisible) {
                            newRow.appendChild(originalCells[originalIndex].cloneNode(true));
                        }
                    });
                    row.parentNode.replaceChild(newRow, row);
                });
                tableHeaders = Array.from(headerRow.querySelectorAll('th'));
                allOriginalRows = Array.from(tableBody.querySelectorAll('tr'));
                currentlyFilteredRows = [...allOriginalRows];
                applyFiltersAndSort();
            }

            function createColumnVisibilityModal() {
                const modalBody = document.getElementById('sortable-column-list');
                if(!modalBody) return;
                modalBody.innerHTML = '';

                const headers = Array.from(document.querySelectorAll('#rapor2Table thead th')).filter(h => h.dataset.column);
                const orderedHeaders = (savedOrder.length > 0) ? savedOrder.map(colIndex => headers.find(h => parseInt(h.dataset.column) === colIndex)).filter(h => h) : headers;

                orderedHeaders.forEach(th => {
                    const columnIndex = parseInt(th.dataset.column);
                    const columnTitle = th.querySelector('.column-title')?.textContent || `Sütun ${columnIndex + 1}`;
                    const isHiddenByDefault = th.dataset.defaultVisibility === 'hidden';
                    const isVisible = savedVisibility[columnIndex] !== undefined ? savedVisibility[columnIndex] : !isHiddenByDefault;

                    const div = document.createElement('div');
                    div.className = 'list-group-item';
                    div.setAttribute('data-column-index', columnIndex);
                    div.innerHTML = `
                        <div>
                            <i class="fas fa-bars"></i>
                            <input class="form-check-input me-2" type="checkbox" value="${columnIndex}" id="column-visibility-${columnIndex}" ${isVisible ? 'checked' : ''}>
                            <label class="form-check-label" for="column-visibility-${columnIndex}">
                                ${columnTitle}
                            </label>
                        </div>
                    `;
                    modalBody.appendChild(div);
                });

                new Sortable(modalBody, {
                    animation: 150,
                    ghostClass: 'sortable-ghost'
                });
            }

            if (document.getElementById('manageColumnsBtn')) {
                document.getElementById('manageColumnsBtn').addEventListener('click', createColumnVisibilityModal);
            }

            if (document.getElementById('saveColumnVisibilityBtn')) {
                document.getElementById('saveColumnVisibilityBtn').addEventListener('click', () => {
                    const modalBody = document.getElementById('sortable-column-list');
                    const checkboxes = modalBody.querySelectorAll('.form-check-input');
                    const newVisibility = {};
                    const newOrder = [];

                    Array.from(modalBody.children).forEach(item => {
                        const columnIndex = parseInt(item.dataset.columnIndex);
                        const checkbox = item.querySelector('.form-check-input');
                        if (checkbox) {
                            newVisibility[columnIndex] = checkbox.checked;
                        }
                        newOrder.push(columnIndex);
                    });

                    localStorage.setItem(columnVisibilityKey, JSON.stringify(newVisibility));
                    localStorage.setItem(columnOrderKey, JSON.stringify(newOrder));
                    Object.assign(savedVisibility, newVisibility);
                    savedOrder = newOrder;

                    applyColumnVisibilityAndOrder();

                    const modal = bootstrap.Modal.getInstance(document.getElementById('columnVisibilityModal'));
                    modal.hide();
                    showAlert('Sütun ayarları kaydedildi.', 'success');
                });
            }

            function applyRowGroupingHighlight() {
                const groupedRows = {};
                allOriginalRows.forEach(row => {
                    const cekNumarasi = row.dataset.cekNumarasi;
                    const tutar = row.dataset.tutar;
                    const cekBankasi = row.dataset.cekBankasi;
                    const key = `${cekNumarasi}-${tutar}-${cekBankasi}`;
                    if (!groupedRows[key]) {
                        groupedRows[key] = [];
                    }
                    groupedRows[key].push(row);
                });

                allOriginalRows.forEach(row => {
                    row.classList.remove('row-group-0', 'row-group-1', 'row-group-2', 'row-group-3', 'row-group-4');
                    row.style.backgroundColor = '';
                });

                let colorIndex = 0;
                for (const key in groupedRows) {
                    if (groupedRows[key].length > 1) {
                        groupedRows[key].forEach(row => {
                            row.classList.add(`row-group-${colorIndex % 5}`);
                        });
                        colorIndex++;
                    }
                }
            }

            function updateTableDisplay() {
                while (tableBody.firstChild) {
                    tableBody.removeChild(tableBody.firstChild);
                }
                currentlyFilteredRows.forEach(row => {
                    tableBody.appendChild(row);
                });
                calculateSelectedTotal();
                updateSelectAllCheckboxState();
                updatePaginationInfo();
            }

            function calculateSelectedTotal() {
                let total = 0;
                currentlyFilteredRows.forEach(row => {
                    const checkbox = row.querySelector('.row-checkbox');
                    if (checkbox && checkbox.checked) {
                        const tlValueString = checkbox.dataset.tlValue;
                        let tlValue;
                        try {
                            tlValue = parseFloat(tlValueString);
                            if (!isNaN(tlValue)) {
                                total += tlValue;
                            }
                        } catch (e) {
                            console.error("TL değeri dönüştürülürken hata oluştu:", tlValueString, e);
                        }
                    }
                });
                totalSelectedTlAmountSpan.textContent = total.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function applyFiltersAndSort() {
                const filters = [];
                document.querySelectorAll('.multi-select-dropdown').forEach(dropdown => {
                    const button = dropdown.querySelector('.multi-select-button');
                    const columnIndex = parseInt(button.dataset.column);
                    const selectedValues = multiSelectFilterStates[columnIndex];
                    if (selectedValues && selectedValues.length > 0) {
                        filters.push({ column: columnIndex, values: selectedValues, type: 'multi-select' });
                    }
                });

                let filteredRows = allOriginalRows.filter(row => {
                    return filters.every(filter => {
                        let cellIndex = -1;
                        tableHeaders.forEach((th, index) => {
                            if (parseInt(th.dataset.column) === filter.column) {
                                cellIndex = index;
                            }
                        });
                        if (cellIndex === -1) return true;

                        const cell = row.cells[cellIndex];
                        if (!cell) return false;

                        let cellValue;
                        if (filter.column === 13) {
                            const selectElement = cell.querySelector('.check-transaction-select');
                            cellValue = selectElement ? selectElement.value : '';
                        } else if (filter.column === 15) {
                            const inputElement = cell.querySelector('.planned-supplier-input');
                            cellValue = inputElement ? inputElement.value : '';
                        } else {
                            cellValue = (cell.textContent || cell.innerText);
                        }
                        const selectedValuesLower = filter.values.map(v => (v || '').toLowerCase().trim());
                        const cellValueLower = (cellValue || '').toLowerCase().trim();

                        if (filter.column === 3 || filter.column === 17) {
                            const cellNumValue = parseFloat(cellValueLower.replace(/\./g, '').replace(',', '.'));
                            const filterNumValues = selectedValuesLower.map(v => parseFloat(v.replace(/\./g, '').replace(',', '.')));
                            return filterNumValues.includes(cellNumValue);
                        } else {
                            return selectedValuesLower.includes(cellValueLower);
                        }
                    });
                });

                if (isHighlighted) {
                    filteredRows = filteredRows.filter(row => {
                        const cekNumarasi = row.dataset.cekNumarasi;
                        const tutar = row.dataset.tutar;
                        const cekBankasi = row.dataset.cekBankasi;
                        const key = `${cekNumarasi}-${tutar}-${cekBankasi}`;
                        return allOriginalRows.filter(r => `${r.dataset.cekNumarasi}-${r.dataset.tutar}-${r.dataset.cekBankasi}` === key).length > 1;
                    });
                }

                if (currentSortColumn !== -1 && currentSortDirection !== 'none') {
                    filteredRows.sort((rowA, rowB) => {
                        let sortCellIndex = -1;
                        tableHeaders.forEach((th, index) => {
                            if (parseInt(th.dataset.column) === currentSortColumn) {
                                sortCellIndex = index;
                            }
                        });
                        if (sortCellIndex === -1) return 0;

                        const cellA = rowA.cells[sortCellIndex];
                        const cellB = rowB.cells[sortCellIndex];

                        let cellAValue, cellBValue;
                        if (currentSortColumn === 13) {
                            const selectA = cellA.querySelector('.check-transaction-select');
                            const selectB = cellB.querySelector('.check-transaction-select');
                            cellAValue = selectA ? selectA.value.trim() : '';
                            cellBValue = selectB ? selectB.value.trim() : '';
                        } else if (currentSortColumn === 15) {
                            const inputA = cellA.querySelector('.planned-supplier-input');
                            const inputB = cellB.querySelector('.planned-supplier-input');
                            cellAValue = inputA ? inputA.value.trim() : '';
                            cellBValue = inputB ? inputB.value.trim() : '';
                        } else {
                            cellAValue = cellA.textContent.trim();
                            cellBValue = cellB.textContent.trim();
                        }

                        const sortType = table.querySelector(`th[data-column="${currentSortColumn}"]`).dataset.sortType;
                        let comparison = 0;
                        if (sortType === 'number') {
                            const valA = parseFloat(cellAValue.replace(/\./g, '').replace(',', '.'));
                            const valB = parseFloat(cellBValue.replace(/\./g, '').replace(',', '.'));
                            comparison = (isNaN(valA) ? (isNaN(valB) ? 0 : 1) : (isNaN(valB) ? -1 : valA - valB));
                        } else if (sortType === 'date') {
                            const parseDate = (dateString) => {
                                if (!dateString) return null;
                                const parts = dateString.split('.');
                                if (parts.length === 3) {
                                    return new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));
                                }
                                return null;
                            };
                            const dateA = parseDate(cellAValue);
                            const dateB = parseDate(cellBValue);
                            if (dateA === null && dateB === null) comparison = 0;
                            else if (dateA === null) comparison = 1;
                            else if (dateB === null) comparison = -1;
                            else comparison = dateA.getTime() - dateB.getTime();
                        } else {
                            const lowerA = (cellAValue || '').toLowerCase();
                            const lowerB = (cellBValue || '').toLowerCase();
                            comparison = lowerA.localeCompare(lowerB, 'tr', { sensitivity: 'base' });
                        }
                        return currentSortDirection === 'asc' ? comparison : -comparison;
                    });
                }
                currentlyFilteredRows = filteredRows;
                updateTableDisplay();
            }

            function updatePaginationInfo() {
                const totalRecords = currentlyFilteredRows.length;
                const infoElement = document.getElementById('totalRecords');
                if (infoElement) {
                    infoElement.textContent = totalRecords;
                }
            }

            if (selectAllCheckbox) {
                selectAllCheckbox.addEventListener('change', function () {
                    currentlyFilteredRows.forEach(row => {
                        const checkbox = row.querySelector('.row-checkbox');
                        if (checkbox) {
                            checkbox.checked = this.checked;
                        }
                    });
                    calculateSelectedTotal();
                });
            }

            tableBody.addEventListener('change', function (event) {
                if (event.target.classList.contains('row-checkbox')) {
                    calculateSelectedTotal();
                    updateSelectAllCheckboxState();
                }
            });

            tableBody.addEventListener('click', function (event) {
                const targetLink = event.target.closest('a');
                if (targetLink) {
                    event.stopPropagation();
                }
            });

            function updateSelectAllCheckboxState() {
                const visibleCheckboxes = Array.from(tableBody.querySelectorAll('.row-checkbox'));
                const checkedVisible = visibleCheckboxes.filter(cb => cb && cb.checked);
                selectAllCheckbox.checked = checkedVisible.length > 0 && checkedVisible.length === visibleCheckboxes.length;
                selectAllCheckbox.indeterminate = checkedVisible.length > 0 && checkedVisible.length < visibleCheckboxes.length;
            }

            document.querySelectorAll('.multi-select-dropdown').forEach(dropdown => {
                const button = dropdown.querySelector('.multi-select-button');
                const optionsContainer = dropdown.querySelector('.multi-select-options');
                const searchInput = optionsContainer.querySelector('.multi-select-search-input');
                const selectAllInFilterCheckbox = optionsContainer.querySelector('.select-all-options-in-filter');
                const allOptionsInFilter = optionsContainer.querySelectorAll('.multi-select-option');
                const columnIndex = parseInt(button.dataset.column);
                multiSelectFilterStates[columnIndex] = [];

                const initialSelected = Array.from(optionsContainer.querySelectorAll('.multi-select-option input[type="checkbox"]')).filter(cb => cb.checked).map(cb => cb.value.toLowerCase());
                multiSelectFilterStates[columnIndex] = initialSelected;
                updateButtonText(button, initialSelected, allOptionsInFilter, columnIndex);
                updateSelectAllInFilterCheckboxState(optionsContainer);

                optionsContainer.addEventListener('click', (e) => { e.stopPropagation(); });

                button.addEventListener('click', (e) => {
                    e.stopPropagation();
                    document.querySelectorAll('.multi-select-dropdown').forEach(otherDropdown => {
                        const otherOptions = otherDropdown.querySelector('.multi-select-options');
                        if (otherOptions && otherOptions !== optionsContainer && otherOptions.classList.contains('show')) {
                            otherOptions.classList.remove('show');
                            otherDropdown.querySelector('.multi-select-button').setAttribute('aria-expanded', 'false');
                            dropdown.appendChild(otherOptions); 
                        }
                    });

                    const isShown = optionsContainer.classList.toggle('show');
                    button.setAttribute('aria-expanded', isShown);
                    if (isShown) {
                        document.body.appendChild(optionsContainer);
                        const rect = button.getBoundingClientRect();
                        const viewportWidth = window.innerWidth || document.documentElement.clientWidth;
                        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
                        let calculatedTop, calculatedLeft;

                        const spaceBelow = viewportHeight - rect.bottom;
                        const spaceAbove = rect.top;

                        if (spaceBelow >= optionsContainer.offsetHeight + 10) {
                            calculatedTop = rect.bottom + 5 + window.scrollY;
                        } else if (spaceAbove >= optionsContainer.offsetHeight + 10) {
                            calculatedTop = rect.top - optionsContainer.offsetHeight - 5 + window.scrollY;
                        } else {
                            calculatedTop = rect.bottom + 5 + window.scrollY;
                            optionsContainer.style.maxHeight = `${Math.max(100, spaceBelow - 15)}px`;
                        }

                        if (rect.left + optionsContainer.offsetWidth > viewportWidth - 10) {
                            calculatedLeft = rect.right - optionsContainer.offsetWidth + window.scrollX;
                        } else {
                            calculatedLeft = rect.left + window.scrollX;
                        }

                        optionsContainer.style.top = `${calculatedTop}px`;
                        optionsContainer.style.left = `${calculatedLeft}px`;
                    }
                });

                document.addEventListener('click', (e) => {
                    if (!dropdown.contains(e.target) && optionsContainer.classList.contains('show')) {
                        optionsContainer.classList.remove('show');
                        button.setAttribute('aria-expanded', 'false');
                        dropdown.appendChild(optionsContainer);
                        optionsContainer.style.top = ''; optionsContainer.style.left = ''; optionsContainer.style.right = '';
                        optionsContainer.style.maxHeight = '';
                    }
                });

                searchInput.addEventListener('keyup', (e) => {
                    const searchText = e.target.value.toLowerCase().trim();
                    allOptionsInFilter.forEach(option => {
                        const label = option.querySelector('label');
                        const labelText = (label?.textContent || '').toLowerCase();
                        const isMatch = labelText.includes(searchText);
                        option.style.display = isMatch ? 'flex' : 'none';
                    });
                    updateSelectAllInFilterCheckboxState(optionsContainer);
                });

                if (selectAllInFilterCheckbox) {
                    selectAllInFilterCheckbox.addEventListener('change', function () {
                        const isChecked = this.checked;
                        optionsContainer.querySelectorAll('.multi-select-option').forEach(option => {
                            if (option.style.display !== 'none') {
                                option.querySelector('input[type="checkbox"]').checked = isChecked;
                            }
                        });

                        const selectedValues = Array.from(optionsContainer.querySelectorAll('.multi-select-option input[type="checkbox"]'))
                            .filter(cb => cb.checked)
                            .map(cb => (cb.value || '').toLowerCase());
                        multiSelectFilterStates[columnIndex] = selectedValues;
                        updateButtonText(button, selectedValues, allOptionsInFilter, columnIndex);
                        applyFiltersAndSort();
                    });
                }

                optionsContainer.querySelectorAll('.multi-select-option input[type="checkbox"]').forEach(cb => {
                    cb.addEventListener('change', () => {
                        const selectedValues = Array.from(optionsContainer.querySelectorAll('.multi-select-option input[type="checkbox"]'))
                            .filter(cb => cb.checked)
                            .map(cb => (cb.value || '').toLowerCase());
                        multiSelectFilterStates[columnIndex] = selectedValues;
                        updateButtonText(button, selectedValues, allOptionsInFilter, columnIndex);
                        updateSelectAllInFilterCheckboxState(optionsContainer);
                        applyFiltersAndSort();
                    });
                });
            });

            tableHeaders.forEach(header => {
                const sortType = header.dataset.sortType;
                const columnIndex = parseInt(header.dataset.column);
                const columnTitle = header.querySelector('.column-title');

                if (sortType && columnTitle) {
                    columnTitle.style.cursor = 'pointer';
                    columnTitle.addEventListener('click', (e) => {
                        e.stopPropagation();
                        if (currentSortColumn === columnIndex) {
                            if (currentSortDirection === 'asc') {
                                currentSortDirection = 'desc';
                            } else if (currentSortDirection === 'desc') {
                                currentSortDirection = 'none';
                            } else {
                                currentSortDirection = 'asc';
                            }
                        } else {
                            currentSortColumn = columnIndex;
                            currentSortDirection = 'asc';
                        }
                        updateHeaderIcons();
                        applyFiltersAndSort();
                    });
                }
            });

            if (clearFiltersBtn) {
                clearFiltersBtn.addEventListener('click', () => {
                    document.querySelectorAll('.multi-select-dropdown').forEach(dropdown => {
                        const button = dropdown.querySelector('.multi-select-button');
                        const optionsContainer = dropdown.querySelector('.multi-select-options');
                        const allOptionsInFilter = optionsContainer?.querySelectorAll('.multi-select-option') || [];
                        const optionCheckboxes = optionsContainer?.querySelectorAll('.multi-select-option input[type="checkbox"]') || [];
                        const columnIndex = parseInt(button.dataset.column);

                        optionCheckboxes.forEach(cb => {
                            cb.checked = false;
                        });

                        multiSelectFilterStates[columnIndex] = [];
                        updateButtonText(button, [], allOptionsInFilter, columnIndex);
                        updateSelectAllInFilterCheckboxState(optionsContainer);
                    });

                    currentSortColumn = -1;
                    currentSortDirection = 'none';
                    updateHeaderIcons();
                    isHighlighted = false;
                    highlightTransactionsBtn.classList.remove('btn-dark');
                    highlightTransactionsBtn.classList.add('btn-primary');
                    highlightTransactionsBtn.innerHTML = '<i class="fas fa-hand-holding-dollar me-2"></i> Şirketler Arası İşlemleri Vurgula';

                    currentlyFilteredRows = [...allOriginalRows];
                    updateTableDisplay();

                    selectAllCheckbox.checked = false;
                    selectAllCheckbox.indeterminate = false;
                    calculateSelectedTotal();

                    showAlert('Tüm filtreler ve sıralama ayarları temizlendi.', 'success');
                });
            }

            if (highlightTransactionsBtn) {
                highlightTransactionsBtn.addEventListener('click', () => {
                    isHighlighted = !isHighlighted;
                    if (isHighlighted) {
                        highlightTransactionsBtn.classList.remove('btn-primary');
                        highlightTransactionsBtn.classList.add('btn-dark');
                        highlightTransactionsBtn.innerHTML = '<i class="fas fa-list me-2"></i> Tüm Kayıtları Göster';
                    } else {
                        highlightTransactionsBtn.classList.remove('btn-dark');
                        highlightTransactionsBtn.classList.add('btn-primary');
                        highlightTransactionsBtn.innerHTML = '<i class="fas fa-hand-holding-dollar me-2"></i> Şirketler Arası İşlemleri Vurgula';
                    }
                    applyFiltersAndSort();
                });
            }

            if (exportToExcelBtn) {
                exportToExcelBtn.addEventListener('click', async () => {
                    const exportFilters = [];
                    document.querySelectorAll('.multi-select-dropdown').forEach(dropdown => {
                        const button = dropdown.querySelector('.multi-select-button');
                        const columnIndex = parseInt(button.dataset.column);
                        const selectedValues = multiSelectFilterStates[columnIndex];
                        if (selectedValues && selectedValues.length > 0) {
                            let finalMappedValues = [];
                            if (columnIndex === 13) {
                                finalMappedValues = selectedValues.map(val => {
                                    const matchingType = checkTransactionTypesJs.find(t => t.code && t.code.toLowerCase() === val.toLowerCase() || t.description && t.description.toLowerCase() === val.toLowerCase());
                                    return matchingType ? matchingType.code : val;
                                }).filter(v => v && !['', 'seçiniz', '0'].includes((v || '').toLowerCase()));
                            } else if (columnIndex === 5 || columnIndex === 7 || columnIndex === 8) {
                                finalMappedValues = selectedValues.map(val => {
                                    if (!val) return null;
                                    const parts = val.split('.');
                                    if (parts.length === 3) {
                                        return `${parts[2]}-${parts[1]}-${parts[0]}`;
                                    }
                                    return val;
                                });
                            } else if (columnIndex === 3 || columnIndex === 17) {
                                finalMappedValues = selectedValues.map(val => {
                                    if (!val) return null;
                                    return val.replace(/\./g, '').replace(',', '.');
                                });
                            } else {
                                finalMappedValues = selectedValues;
                            }

                            if (finalMappedValues.length > 0) {
                                exportFilters.push({ ColumnIndex: columnIndex, Values: finalMappedValues, Type: 'multi-select' });
                            }
                        }
                    });
                    let exportSort = null;
                    if (currentSortColumn !== -1 && currentSortDirection !== 'none') {
                        exportSort = {
                            ColumnIndex: currentSortColumn,
                            SortType: table.querySelector(`th[data-column="${currentSortColumn}"]`)?.dataset.sortType,
                            Direction: currentSortDirection
                        };
                    }
                    const requestBody = {
                        Filters: exportFilters,
                        Sort: exportSort
                    };
                    try {
                        const response = await fetch('/Rapor22/ExportToExcel' + dbQueryString, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest',
                                'RequestVerificationToken': antiForgeryToken
                            },
                            body: JSON.stringify(requestBody)
                        });
                        if (response.ok) {
                            const blob = await response.blob();
                            const disposition = response.headers.get('Content-Disposition');
                            let filename = 'CekAkibetiRaporu.xlsx';
                            if (disposition && disposition.indexOf('attachment') !== -1) {
                                const filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                                const matches = filenameRegex.exec(disposition);
                                if (matches != null && matches[1]) {
                                    filename = decodeURIComponent(matches[1].replace(/['"]/g, ''));
                                }
                            }
                            const url = window.URL.createObjectURL(blob);
                            const a = document.createElement('a');
                            a.href = url;
                            a.download = filename;
                            document.body.appendChild(a);
                            a.click();
                            a.remove();
                            window.URL.revokeObjectURL(url);
                            showAlert('Excel raporu başarıyla oluşturuldu ve indiriliyor.', 'success');
                        } else {
                            let errorMessage = `Excel dışa aktarılırken hata oluştu: ${response.status} ${response.statusText}`;
                            try {
                                const errorText = await response.text();
                                errorMessage = `Excel dışa aktarılırken hata oluştu: ${response.status} - ${errorText || response.statusText}`;
                            } catch (e) { }
                            showAlert(errorMessage, 'danger');
                        }
                    } catch (error) {
                        console.error('Excel dışa aktarılırken bir ağ hatası oluştu:', error);
                        showAlert('Excel dışa aktarılırken bir ağ hatası oluştu: ' + error.message, 'danger');
                    }
                });
            }

            function makeColumnsResizable() {
                const headers = document.querySelectorAll('#rapor2Table thead th');
                headers.forEach((header, index) => {
                    const columnIndex = index;
                    let handle = header.querySelector('.resizable-column-handle');
                    if (!handle) {
                        handle = document.createElement('div');
                        handle.classList.add('resizable-column-handle');
                        header.appendChild(handle);
                    }

                    let isResizing = false;
                    let startX = 0;
                    let startWidth = 0;

                    const onMouseMove = function (e) {
                        if (!isResizing) return;
                        const deltaX = e.clientX - startX;
                        const newWidth = startWidth + deltaX;

                        if (newWidth > 30) {
                            header.style.width = `${newWidth}px`;
                            header.style.minWidth = `${newWidth}px`;
                            header.style.maxWidth = `${newWidth}px`;
                            const allCells = document.querySelectorAll(`#rapor2Table tbody tr td:nth-child(${columnIndex + 1})`);
                            allCells.forEach(cell => {
                                cell.style.width = `${newWidth}px`;
                                cell.style.minWidth = `${newWidth}px`;
                                cell.style.maxWidth = `${newWidth}px`;
                            });
                        }
                    };

                    const onMouseUp = function () {
                        if (!isResizing) return;
                        isResizing = false;
                        document.body.style.userSelect = '';
                        document.removeEventListener('mousemove', onMouseMove);
                        document.removeEventListener('mouseup', onMouseUp);
                    };

                    handle.addEventListener('mousedown', function (e) {
                        isResizing = true;
                        startX = e.clientX;
                        startWidth = header.offsetWidth;
                        e.preventDefault();
                        document.body.style.userSelect = 'none';
                        document.addEventListener('mousemove', onMouseMove);
                        document.addEventListener('mouseup', onMouseUp);
                    });
                });
            }

            if (clearAllFiltersBtn) {
                clearAllFiltersBtn.addEventListener('click', function () {
                    if (activeDbCode) {
                        window.location.href = window.location.pathname + '?db=' + encodeURIComponent(activeDbCode);
                    } else {
                        window.location.href = window.location.pathname;
                    }
                });
            }

            applyRowGroupingHighlight();
            applyColumnVisibilityAndOrder();
            updateHeaderIcons();
            makeColumnsResizable();

            currentlyFilteredRows = [...allOriginalRows];
            updateTableDisplay();
        });
    </script>
}