@model List<WebApplication3.Models.CompanySalesData>
@using System.Globalization;

@{
    ViewData["Title"] = "2025 Yılı Şirket Ciro Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Aktif Veritabanını (Şirketi) URL veya Cookie'den alıyoruz ki linklerde kaybolmasın
    var currentDb = Context.Request.Query["db"].ToString();
    if (string.IsNullOrEmpty(currentDb))
    {
        currentDb = Context.Request.Cookies["SelectedDatabase"];
    }
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
    :root {
        --primary-color: #007bff;
        --secondary-color: #6c757d;
        --success-color: #28a745;
        --danger-color: #dc3545;
        --info-color: #17a2b8;
        --light-bg: #f8f9fa;
        --white-bg: #ffffff;
        --border-color: #e0e0e0;
        --text-color: #333;
        --header-bg: #e9ecef;
        --shadow-light: 0 2px 8px rgba(0,0,0,0.05);
        --shadow-medium: 0 4px 15px rgba(0,0,0,0.1);
    }

    body {
        background-color: var(--light-bg);
        font-family: 'Poppins', sans-serif;
        color: var(--text-color);
        line-height: 1.4;
        font-size: 0.75rem;
    }

    .container.mt-4 {
        max-width: 100%;
        padding: 0 8px;
        margin-top: 1rem;
    }

    h1, h2, h3, h4, h5, h6 {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.8rem;
        font-size: 1.6rem;
    }

    .alert-success, .alert-danger {
        margin-top: 0.8rem;
        padding: 0.7rem 1rem;
        border-radius: 6px;
        font-size: 0.9rem;
    }

    .alert-success.show, .alert-danger.show {
        opacity: 1;
        transform: translateY(0);
    }

    .table-container {
        overflow-x: auto;
        border-radius: 8px;
        box-shadow: var(--shadow-light);
        background-color: var(--white-bg);
        margin-top: 1rem;
        border: 1px solid var(--border-color);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        border-spacing: 0;
        font-size: 0.8rem;
    }

    th {
        background-color: var(--header-bg);
        color: #495057;
        padding: 6px 8px;
        text-align: left;
        white-space: nowrap;
        font-weight: 600;
        border-bottom: 2px solid var(--border-color);
        position: sticky;
        top: 0;
        z-index: 10;
    }

    th:first-child {
        border-top-left-radius: 8px;
    }

    th:last-child {
        border-top-right-radius: 8px;
    }

    td {
        padding: 5px 8px;
        vertical-align: middle;
        border-bottom: 1px solid #f2f2f2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 0.75rem;
    }

    .positive-value {
        color: #28a745;
        font-weight: 500;
    }

    .negative-value {
        color: #dc3545;
        font-weight: 500;
    }

    tr:last-child td {
        border-bottom: none;
    }

    .table-hover tbody tr:hover {
        background-color: #f0f8ff;
    }

    .total-row {
        font-weight: 700;
        background-color: #e9f5ff;
        border-top: 2px solid var(--primary-color);
    }

    .total-row td {
        font-weight: 700;
        font-size: 0.8rem;
        border-bottom: none;
    }

    tbody tr:nth-child(4),
    tbody tr:nth-child(8),
    tbody tr:nth-child(12),
    tbody tr:nth-child(16),
    tbody tr:nth-child(20),
    tbody tr:nth-child(24) {
        background-color: #FFF3CD;
    }

    tbody tr:nth-child(25) {
        background-color: #D4EDDA;
    }
    </style>
}

<div class="container mt-4 mb-5">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger show" role="alert">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">@ViewData["Title"]</h1>
        
        <a asp-action="Index" asp-controller="Home" asp-route-db="@currentDb" class="btn btn-outline-secondary fw-bold shadow-sm">
            <i class="fas fa-arrow-left me-2"></i> Ana Sayfaya Dön
        </a>
    </div>

    <div id="alertContainer" class="mt-3"></div>

    @if (Model != null && Model.Any())
    {
        <div class="table-container">
            <table class="table table-bordered table-striped table-hover rapor-tablo" id="companySalesTable">
                <thead>
                    <tr>
                        <th>Açıklama</th>
                        <th>Ocak</th>
                        <th>Şubat</th>
                        <th>Mart</th>
                        <th>Nisan</th>
                        <th>Mayıs</th>
                        <th>Haziran</th>
                        <th>Temmuz</th>
                        <th>Ağustos</th>
                        <th>Eylül</th>
                        <th>Ekim</th>
                        <th>Kasım</th>
                        <th>Aralık</th>
                        <th>Toplam</th>
                        <th>2025 Aylık Ortalama</th>
                        <th>Toplam Dikey Analiz</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rowIndex = 0; 
                    }
                    @foreach (var item in Model)
                    {
                        rowIndex++; 
                        string rowClass = "";
                        if (item.Aciklama.Contains("TOPLAM CİRO") || item.Aciklama.Contains("GENEL TOPLAM"))
                        {
                            rowClass = "total-row";
                        }
                        else if (rowIndex == 4 || rowIndex == 8 || rowIndex == 12 || rowIndex == 16 || rowIndex == 20 || rowIndex == 24)
                        {
                            rowClass = "yellow-highlight"; 
                        }
                        else if (rowIndex == 25)
                        {
                            rowClass = "green-highlight"; 
                        }

                        <tr class="@rowClass">
                            <td>
                                @if (item.Aciklama.Contains("TOPLAM CİRO") || item.Aciklama.Contains("GENEL TOPLAM"))
                                {
                                    <strong>@item.Aciklama</strong>
                                }
                                else
                                {
                                    @item.Aciklama
                                }
                            </td>
                            <td class="@(item.Ocak < 0 ? "negative-value" : "positive-value")">@item.Ocak.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.Subat < 0 ? "negative-value" : "positive-value")">@item.Subat.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.Mart < 0 ? "negative-value" : "positive-value")">@item.Mart.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.Nisan < 0 ? "negative-value" : "positive-value")">@item.Nisan.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.Mayis < 0 ? "negative-value" : "positive-value")">@item.Mayis.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.Haziran < 0 ? "negative-value" : "positive-value")">@item.Haziran.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.Temmuz < 0 ? "negative-value" : "positive-value")">@item.Temmuz.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.Agustos < 0 ? "negative-value" : "positive-value")">@item.Agustos.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.Eylul < 0 ? "negative-value" : "positive-value")">@item.Eylul.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.Ekim < 0 ? "negative-value" : "positive-value")">@item.Ekim.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.Kasim < 0 ? "negative-value" : "positive-value")">@item.Kasim.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.Aralik < 0 ? "negative-value" : "positive-value")">@item.Aralik.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td><strong>@item.Toplam.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                            <td>@item.YillikOrtalama.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td>@item.ToplamDikeyAnaliz</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-center mt-3 text-muted" id="total-records-info">
            <i class="fas fa-list me-1"></i> Toplam Kayıt: <strong>@Model.Count()</strong>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-4">
            <i class="fas fa-info-circle me-2"></i> Gösterilecek veri bulunamadı.
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Function to show alerts (kept for consistency)
            function showAlert(message, type) {
                const alertContainer = document.getElementById('alertContainer');
                if (!alertContainer) return;

                const alertDiv = document.createElement('div');
                alertDiv.classList.add('alert', `alert-${type}`, 'alert-dismissible', 'fade');
                alertDiv.setAttribute('role', 'alert');
                alertDiv.innerHTML = `
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                `;
                alertContainer.innerHTML = '';
                alertContainer.appendChild(alertDiv);

                setTimeout(() => {
                    alertDiv.classList.add('show');
                }, 10);

                setTimeout(() => {
                    const bootstrapAlert = bootstrap.Alert.getInstance(alertDiv);
                    if (bootstrapAlert) {
                        bootstrapAlert.dispose();
                    } else {
                        alertDiv.remove();
                    }
                }, 5000);
            }
        });
    </script>
}