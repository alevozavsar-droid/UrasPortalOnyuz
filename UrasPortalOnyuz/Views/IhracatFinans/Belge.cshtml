@model WebApplication3.Data.IbkbBelge
@{
    Layout = null;
    var dosya = (WebApplication3.Data.IbkbDosya)ViewBag.Dosya;
    var sirket = (WebApplication3.Data.SsSirket)ViewBag.Sirket;
    var kart = (WebApplication3.Data.CariKart)ViewBag.Kart;
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    string P(decimal v) => v.ToString("N2", tr);
    string T(DateTime? d) => d?.ToString("dd.MM.yyyy") ?? "—";
    string S(string s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    @* İBKB BAŞVURU FORMU (11 Kas 2026): banka tahsilatı ↔ ihracat dosyası eşleşmesinden üretilir; bankaya verilecek biçimde basılır (tarayıcı Yazdır → PDF). Veri Data/IbkbOrnek.cs (IbkbBelge). *@
    <style>
        body { font-family: Arial, "Segoe UI", sans-serif; font-size: 11pt; color: #0f172a; margin: 0; background: #e2e8f0; }
        .sayfa { width: 210mm; min-height: 297mm; margin: 10mm auto; background: #fff; padding: 16mm 18mm; box-sizing: border-box; box-shadow: 0 2px 12px rgba(0,0,0,.15); }
        .ust { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #0f766e; padding-bottom: 8px; margin-bottom: 14px; }
        .ust h1 { font-size: 15pt; margin: 0 0 4px; color: #134e4a; letter-spacing: .04em; } .ust .alt { font-size: 9pt; color: #475569; }
        .ust .no { text-align: right; font-size: 9.5pt; } .ust .no b { font-size: 12pt; color: #0f766e; display: block; }
        h2 { font-size: 10pt; text-transform: uppercase; letter-spacing: .06em; color: #0f766e; border-bottom: 1px solid #99f6e4; margin: 14px 0 6px; padding-bottom: 2px; }
        table.b { width: 100%; border-collapse: collapse; font-size: 10pt; } table.b td { padding: 4px 6px; border: 1px solid #cbd5e1; vertical-align: top; } table.b td.l { width: 34%; background: #f8fafc; font-weight: 700; color: #334155; }
        .tutar { font-size: 13pt; font-weight: 800; color: #134e4a; }
        .metin { font-size: 9.5pt; line-height: 1.45; text-align: justify; margin: 8px 0; }
        .imza { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 28px; font-size: 9.5pt; } .imza > div { border-top: 1px solid #334155; padding-top: 6px; min-height: 70px; } .imza b { display: block; }
        .not { font-size: 8.5pt; color: #64748b; margin-top: 18px; border-top: 1px dashed #cbd5e1; padding-top: 6px; }
        .araclar { position: fixed; top: 8px; right: 8px; display: flex; gap: 6px; } .araclar button, .araclar a { font: 600 10pt Arial, sans-serif; padding: 6px 12px; border-radius: 6px; border: 1px solid #0f766e; background: #0f766e; color: #fff; cursor: pointer; text-decoration: none; } .araclar a { background: #fff; color: #0f766e; }
        .rz { display: inline-block; font-size: 8pt; font-weight: 800; border-radius: 4px; padding: 1px 6px; background: #fef3c7; color: #92400e; } .rz.ok { background: #dcfce7; color: #166534; } .rz.iptal { background: #fee2e2; color: #991b1b; }
        @@media print { body { background: #fff; } .sayfa { margin: 0; box-shadow: none; width: auto; min-height: auto; padding: 12mm 14mm; } .araclar { display: none; } }
    </style>
</head>
<body>
    <div class="araclar"><button type="button" onclick="window.print()">Yazdır / PDF</button><a href="/IhracatFinans?sekme=belgeler">Rapora Dön</a></div>
    <div class="sayfa">
        <div class="ust">
            <div><h1>İHRACAT BEDELİ KABUL BELGESİ (İBKB) BAŞVURU FORMU</h1><div class="alt">@S(sirket?.Unvan ?? Model.Sirket) · @S(sirket?.Adres) · Vergi No @S(sirket?.VergiNo)</div></div>
            <div class="no"><b>@Model.No</b>Tarih: @T(Model.Tarih)<br />Durum: <span class="rz @(Model.Durum == "Banka Onayladı" ? "ok" : Model.Durum == "İptal" ? "iptal" : "")">@Model.Durum</span></div>
        </div>
        <div class="metin"><b>@S(Model.Banka)</b> Genel Müdürlüğü / Şubesi'ne,<br />Türk Parası Kıymetini Koruma Hakkında 32 Sayılı Karara İlişkin 2018-32/48 sayılı Tebliğ (İhracat Bedelleri Hakkında) ve TCMB İhracat Genelgesi uyarınca, aşağıda bilgileri yazılı ihracat işlemimize ait bedelin bankanız nezdindeki hesabımıza gelen tahsilatla kabulü ve <b>İhracat Bedeli Kabul Belgesi</b> düzenlenmesini arz ederiz.</div>

        <h2>1. İhracatçı</h2>
        <table class="b"><tr><td class="l">Ünvan</td><td>@S(sirket?.Unvan ?? Model.Sirket)</td></tr><tr><td class="l">Vergi No</td><td>@S(sirket?.VergiNo)</td></tr><tr><td class="l">Adres</td><td>@S(sirket?.Adres)</td></tr></table>

        <h2>2. İhracat İşlemi</h2>
        <table class="b">
            <tr><td class="l">İhracat Dosya No</td><td>@S(Model.DosyaNo)</td></tr>
            <tr><td class="l">Gümrük Çıkış Beyannamesi (GÇB) No</td><td>@S(Model.BeyannameNo)</td></tr>
            <tr><td class="l">Fiili İhraç / Dosya Başlangıç Tarihi</td><td>@T(Model.FiiliIhrac)</td></tr>
            <tr><td class="l">Fatura No</td><td>@S(Model.FaturaNo)</td></tr>
            <tr><td class="l">Beyanname Tutarı</td><td><span class="tutar">@P(Model.BeyannameTutar) @S(Model.BeyannameDoviz)</span>@if (dosya != null && dosya.UlkeOran > 0 && dosya.UlkeOran < 100) { <span> · ülke gerekliliği % @dosya.UlkeOran</span> }</td></tr>
            @if (dosya != null && dosya.GercekBedel > 0) { <tr><td class="l">Gerçek İhracat Bedeli (Proforma / Fatura)</td><td>@P(dosya.GercekBedel) @S(dosya.Doviz) · beyanname farkı @P(dosya.Tutar - dosya.GercekBedel) @S(dosya.Doviz)@if (!string.IsNullOrEmpty(dosya.FarkNedeni)) { <span> · @dosya.FarkNedeni</span> }</td></tr> }
            <tr><td class="l">Alıcı (İthalatçı)</td><td>@S(Model.Musteri)@if (!string.IsNullOrEmpty(Model.MusteriKodu)) { <span> · cari @Model.MusteriKodu</span> }</td></tr>
            <tr><td class="l">Ülke</td><td>@S(string.IsNullOrEmpty(Model.Ulke) ? kart?.Ulke : Model.Ulke)</td></tr>
        </table>

        <h2>3. Gelen Bedel (Banka Tahsilatı)</h2>
        <table class="b">
            <tr><td class="l">Tahsilat Tutarı</td><td><span class="tutar">@P(Model.Tutar) @S(Model.Doviz)</span>@if (Model.Doviz != Model.BeyannameDoviz) { <span> · beyanname dövizinden farklı</span> }</td></tr>
            <tr><td class="l">Tahsilat Tarihi (Valör)</td><td>@T(Model.TahsilatTarihi)</td></tr>
            <tr><td class="l">Banka Referansı / Dekont No</td><td>@S(Model.TahsilatRef)</td></tr>
            <tr><td class="l">Gönderen</td><td>@S(Model.Musteri)</td></tr>
            @if (dosya != null) {
                var ger = WebApplication3.Data.IbkbOrnek.Gereken(dosya); var get = WebApplication3.Data.IbkbOrnek.Getirilen(dosya); var kal = WebApplication3.Data.IbkbOrnek.Kalan(dosya);
                <tr><td class="l">Dosya Durumu (Bu Belge Dahil)</td><td>gereken @P(ger) @dosya.Doviz · getirilen @P(get) @dosya.Doviz · kalan @P(kal) @dosya.Doviz · DAB / İBKB durumu: @dosya.DabDurumu</td></tr>
            }
        </table>

        <h2>4. Banka Kaydı</h2>
        <table class="b"><tr><td class="l">Banka İBKB No</td><td>@S(Model.BankaIbkbNo)</td></tr><tr><td class="l">Banka İşlem Tarihi</td><td>@T(Model.BankaTarihi)</td></tr><tr><td class="l">Açıklama</td><td>@S(Model.Not)</td></tr></table>

        <div class="imza"><div><b>İhracatçı Firma</b>Kaşe · Yetkili İmza<br /><br />@S(sirket?.Unvan ?? Model.Sirket)</div><div><b>Banka</b>Kabul Eden Şube · Kaşe · İmza</div></div>
        <div class="not">Bu form İhracat Finansal Takibi raporundan (Uras Portal) üretilmiştir: @Model.No · hazırlayan @S(Model.Olusturan) · @Model.Olusturma.ToString("dd.MM.yyyy HH:mm"). İhracat bedeli, fiili ihraç tarihinden itibaren 180 gün içinde yurda getirilir; eşik ve ülke istisnaları için TCMB İhracat Genelgesi esastır.</div>
    </div>
</body>
</html>
