@{
    ViewData["Title"] = "Grup İçi Çek/Senet Devir ve Takip Paneli";
    var companies = ViewBag.GroupCompanies as List<WebApplication3.Controllers.Rapor129Controller.DatabaseConfig>;
}

<style>
    /* Genel Dashboard Stilleri */
    body { background-color: #f4f7fc; font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #2b3445; }
    
    /* Kart ve Yükselme (Hover) Efektleri */
    .dashboard-card { background: #ffffff; border-radius: 12px; border: 1px solid #eef2f7; box-shadow: 0 2px 6px rgba(0,0,0,0.03); padding: 20px; height: 100%; transition: all 0.3s ease; position: relative; overflow: hidden; }
    .hover-elevate:hover { transform: translateY(-4px); box-shadow: 0 8px 15px rgba(0,0,0,0.08); }
    
    .card-title { font-size: 14px; font-weight: 800; color: #1e293b; margin-bottom: 15px; text-transform: uppercase; letter-spacing: 0.5px; }
    
    /* Filtre ve Label Stilleri */
    .filter-label { font-size: 11px; color: #64748b; font-weight: 700; margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.5px;}
    .form-control-sm, .form-select-sm { border-radius: 6px; border: 1px solid #cbd5e1; font-size: 13px; padding: 6px 10px; transition: border-color 0.2s;}
    .form-control-sm:focus, .form-select-sm:focus { border-color: #3b82f6; box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.15); }
    
    /* KPI Kartları Özel Stiller */
    .kpi-title { font-size: 12px; color: #64748b; font-weight: 700; text-transform: uppercase; margin-bottom: 8px; z-index: 2; position: relative; }
    .kpi-value { font-size: 26px; font-weight: 900; color: #0f172a; margin-bottom: 2px; z-index: 2; position: relative; }
    .kpi-desc { font-size: 11px; color: #94a3b8; z-index: 2; position: relative; }
    .kpi-icon-bg { position: absolute; right: -10px; bottom: -10px; font-size: 5rem; color: #e2e8f0; opacity: 0.4; z-index: 1; transform: rotate(-10deg); }
    
    /* KPI Üst Renk Çizgileri */
    .border-top-primary { border-top: 4px solid #3b82f6 !important; }
    .border-top-warning { border-top: 4px solid #f59e0b !important; }
    .border-top-purple { border-top: 4px solid #8b5cf6 !important; }
    .border-top-success { border-top: 4px solid #10b981 !important; }
    .border-top-info { border-top: 4px solid #0ea5e9 !important; }

    /* Tablo Stilleri */
    .table > thead { background-color: #f8fafc; font-size: 12px; color: #475569; font-weight: 700; border-bottom: 2px solid #e2e8f0; }
    .table > thead > tr > th { text-transform: uppercase; letter-spacing: 0.5px; padding: 12px; border-bottom: none; }
    .table > tbody > tr > td { font-size: 13px; color: #334155; vertical-align: middle; padding: 12px; border-bottom: 1px solid #f1f5f9; }
    .table-hover tbody tr:hover { background-color: #f8fafc; cursor: pointer; transform: scale(1.001); transition: all 0.2s; box-shadow: inset 2px 0 0 #3b82f6; }
    
    /* Durum Rozetleri (Badges) */
    .badge-soft-success { background-color: #d1fae5; color: #065f46; border-radius: 6px; padding: 5px 10px; font-weight: 700; font-size: 11px;}
    .badge-soft-primary { background-color: #dbeafe; color: #1e40af; border-radius: 6px; padding: 5px 10px; font-weight: 700; font-size: 11px;}
    .badge-soft-warning { background-color: #fef3c7; color: #92400e; border-radius: 6px; padding: 5px 10px; font-weight: 700; font-size: 11px;}
    .badge-soft-danger { background-color: #fee2e2; color: #991b1b; border-radius: 6px; padding: 5px 10px; font-weight: 700; font-size: 11px;}

    /* Seçilen Evrak Detayları */
    .detail-row { display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 13px; border-bottom: 1px dashed #e2e8f0; padding-bottom: 6px; }
    .detail-label { color: #64748b; font-weight: 500; }
    .detail-val { font-weight: 700; color: #0f172a; text-align: right; }
    
    /* Sihirbaz (Wizard) Kart Stilleri */
    .wizard-step-card { background: #ffffff; border: 1px solid #e2e8f0; border-left: 5px solid #3b82f6; border-radius: 8px; padding: 18px; position: relative; margin-bottom: 15px; transition: all 0.3s ease; }
    .wizard-step-card:hover { box-shadow: 0 6px 15px rgba(0,0,0,0.06); transform: translateX(4px); }
    
    /* Select2 UI Uyumluluğu */
    .select2-container .select2-selection--multiple, .select2-container .select2-selection--single { min-height: 38px; border-color: #cbd5e1; border-radius: 6px; }
    .select2-container--default .select2-selection--multiple .select2-selection__choice { background-color: #f1f5f9; border: 1px solid #cbd5e1; color: #0f172a; font-size: 13px; font-weight: 600; margin-top: 6px; padding: 2px 8px; border-radius: 4px;}
    .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 36px; font-size: 14px; font-weight: 600;}
    .select2-container--default .select2-selection--single .select2-selection__arrow { height: 36px; }

    /* Akıllı Yönlendirme (Dynamic Label) Stili */
    .dynamic-label-source { color: #dc3545; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;}
    .dynamic-label-target { color: #10b981; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;}

    /* Modal Gradient Header */
    .modal-header-gradient { background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%); border-bottom: none; }

        /* =====================================================================
           MODERN GÖRÜNÜM KATMANI (IT talebi #19)
           Önceki kurallardan sonra geldiği için gerekli yerlerde onları ezer.
           ===================================================================== */

        .card, .dash-card, .panel-card {
            border-radius: 14px !important;
            border-color: #e9eef5 !important;
            box-shadow: 0 1px 2px rgba(15,23,42,.04), 0 8px 24px -12px rgba(15,23,42,.12) !important;
        }
        .card-header {
            background: linear-gradient(180deg, #fbfdff 0%, #f4f7fb 100%) !important;
            border-bottom: 1px solid #e9eef5 !important;
            border-radius: 14px 14px 0 0 !important;
            font-size: .82rem;
            letter-spacing: .5px;
            color: #475569;
        }

        table thead th {
            background: linear-gradient(180deg, #fbfdff, #f4f7fb) !important;
            color: #64748b !important;
            font-size: .68rem !important;
            font-weight: 700;
            letter-spacing: .5px;
            border-bottom: 1px solid #e6ecf4 !important;
        }
        table tbody td { border-bottom: 1px solid #f2f5f9; vertical-align: middle; }
        table tbody tr { transition: background-color .12s ease, box-shadow .12s ease; }
        table tbody tr:hover { box-shadow: inset 3px 0 0 #3b82f6; }

        /* Tutar/sayı hizası */
        .text-end, .tutar, td[data-tutar] { font-variant-numeric: tabular-nums; }

        /* Form ve düğmeler */
        .form-control, .form-select, .select2-selection { border-radius: 8px !important; border-color: #e2e8f0 !important; }
        .form-control:focus, .form-select:focus { box-shadow: 0 0 0 3px rgba(59,130,246,.12); }
        .btn { border-radius: 8px; }
        .btn-lg { border-radius: 10px; }

        /* Zincir adımları */
        .wizard-step, .step-card {
            border-radius: 12px !important;
            border: 1px solid #e9eef5 !important;
            background: #fbfdff;
        }

        /* Rozetler */
        .badge { border-radius: 999px; font-weight: 700; letter-spacing: .2px; }
</style>

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-dark" style="letter-spacing: -0.5px;">Grup İçi Çek ve Senet Devir Takip Paneli</h4>
            <span class="text-muted" style="font-size: 14px;">Çek/Senet giriş-çıkışları, cari uygunluk kontroller ve otomatik muhasebe fişleri tek ekranda izlenir.</span>
        </div>
        <div class="d-flex gap-3 align-items-center">
            <select class="form-select border-primary text-primary fw-bold bg-white shadow-sm" id="dashboardCompany" onchange="refreshDashboard()" style="min-width: 250px;">
                <option value="">-- İzlenecek Şirketi Seçin --</option>
                @if (companies != null)
                {
                    foreach (var comp in companies) { <option value="@comp.Key">@comp.Display</option> }
                }
            </select>
            <button class="btn btn-primary rounded-pill px-4 shadow hover-elevate fw-bold" data-bs-toggle="modal" data-bs-target="#transferModal">
                <i class="fas fa-bolt me-2"></i> Zincirleme İşlem Başlat
            </button>
        </div>
    </div>

    <!-- Filtreler -->
    <div class="dashboard-card mb-4 p-3 border-0 hover-elevate">
        <h6 class="fw-bold mb-3" style="font-size: 14px;"><i class="fas fa-filter text-muted me-2"></i>Filtreler</h6>
        <div class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="filter-label">Belge No</label>
                <input type="text" class="form-control form-control-sm" id="fltCheckNo" placeholder="Örn: 1004025">
            </div>
            <div class="col-md-2">
                <label class="filter-label">Veren Şirket</label>
                <input type="text" class="form-control form-control-sm" placeholder="Tümü...">
            </div>
            <div class="col-md-2">
                <label class="filter-label">Alan Şirket</label>
                <input type="text" class="form-control form-control-sm" placeholder="Tümü...">
            </div>
            <div class="col-md-2">
                <label class="filter-label">Cari Hesap</label>
                <input type="text" class="form-control form-control-sm" placeholder="Tümü...">
            </div>
            <div class="col-md-2">
                <label class="filter-label">Tarih Aralığı</label>
                <input type="date" class="form-control form-control-sm">
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-sm btn-light w-50 border fw-bold text-secondary" onclick="$('#fltCheckNo').val(''); refreshDashboard();">Temizle</button>
                <button class="btn btn-sm btn-primary w-50 fw-bold" onclick="refreshDashboard()">Filtrele</button>
            </div>
        </div>
    </div>

    <!-- KPI'lar -->
    <div class="row mb-4 g-3">
        <div class="col-md-2">
            <div class="dashboard-card p-3 border-0 border-top-primary hover-elevate">
                <i class="fas fa-wallet kpi-icon-bg"></i>
                <div class="kpi-title">Toplam Portföy Tutarı</div>
                <div class="kpi-value" id="kpiTotalAmount">0,00 ₺</div>
                <div class="kpi-desc">Açık portföy toplamı</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="dashboard-card p-3 border-0 border-top-warning hover-elevate">
                <i class="fas fa-money-check-alt kpi-icon-bg"></i>
                <div class="kpi-title">Dolaşımdaki Evrak</div>
                <div class="kpi-value" id="kpiActiveCount">0 Adet</div>
                <div class="kpi-desc">Grup içi hareketli evraklar</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="dashboard-card p-3 border-0 border-top-purple hover-elevate">
                <i class="fas fa-exchange-alt kpi-icon-bg"></i>
                <div class="kpi-title">Bugün Giriş / Çıkış</div>
                <div class="kpi-value" id="kpiInOut">0 / 0</div>
                <div class="kpi-desc">Günlük hareket özeti</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="dashboard-card p-3 border-0 border-top-success hover-elevate position-relative">
                <span class="badge bg-success position-absolute top-0 end-0 mt-3 me-3 rounded-pill shadow-sm">Onaylı</span>
                <i class="fas fa-shield-check kpi-icon-bg"></i>
                <div class="kpi-title">Cari Uygunluk</div>
                <div class="kpi-value text-success">Uygun</div>
                <div class="kpi-desc">İşlem limiti uygun</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="dashboard-card p-3 border-0 border-top-info hover-elevate position-relative">
                <span class="badge bg-info text-white position-absolute top-0 end-0 mt-3 me-3 rounded-pill shadow-sm">Aktif</span>
                <i class="fas fa-robot kpi-icon-bg"></i>
                <div class="kpi-title">Otomatik Fiş</div>
                <div class="kpi-value" id="kpiVoucher">0 Kayıt</div>
                <div class="kpi-desc">Son 30 günde oluşturuldu</div>
            </div>
        </div>
    </div>

    <!-- Listeler -->
    <div class="row mb-4 g-3">
        <div class="col-md-8">
            <div class="dashboard-card border-0 hover-elevate">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="card-title mb-0"><i class="fas fa-list-ul text-primary me-2"></i>Evrak Hareketleri <span class="text-muted fw-normal ms-2" style="font-size:12px; text-transform:none;">Tüm giriş, çıkış ve devir adımları</span></div>
                    <button class="btn btn-sm btn-light border text-primary fw-bold" onclick="refreshDashboard()"><i class="fas fa-sync-alt me-1"></i>Yenile</button>
                </div>
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-hover table-borderless align-middle mb-0">
                        <thead class="sticky-top">
                            <tr>
                                <th>Tip</th>
                                <th>Belge No</th>
                                <th>Hareket</th>
                                <th>İşlem Tipi (Aktar)</th>
                                <th>Veren</th>
                                <th>Alan / Banka</th>
                                <th>Tutar</th>
                                <th>Vade</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody id="tblMovements">
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <div class="text-muted mb-2"><i class="fas fa-hand-pointer fa-3x opacity-25"></i></div>
                                    <h6 class="fw-bold text-secondary">Lütfen izlenecek şirketi seçin</h6>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="dashboard-card border-0 hover-elevate">
                <div class="card-title"><i class="fas fa-clipboard-check text-success me-2"></i>İşlem Uygunluk Özeti <span class="text-muted fw-normal ms-2" style="font-size:11px; text-transform:none;">Seçilen evrak için</span></div>
                
                <div class="p-3 rounded-3 mb-3 border border-light" style="background-color: #f8fafc;">
                    <div class="detail-row">
                        <span class="detail-label">Seçilen Evrak</span>
                        <span class="detail-val text-primary" id="lblSelectedCheck">-</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">İşlem Şirketi</span>
                        <span class="detail-val" id="lblSelectedCompany">-</span>
                    </div>
                    <div class="detail-row border-0 pb-0">
                        <span class="detail-label">Cari Hesap Bakiyesi</span>
                        <span class="detail-val text-success fs-6"><i class="fas fa-check-circle me-1"></i>Uygun</span>
                    </div>
                    
                    <div class="alert alert-success mt-3 mb-0 p-2 text-center shadow-sm" style="font-size:12px; font-weight:700;">
                        Limit aşımı yok. Devir işlemi yapılabilir.
                    </div>
                </div>

                <div class="row g-2 mt-auto">
                    <div class="col-6">
                        <div class="border border-light shadow-sm rounded-3 p-3 text-center bg-white transition-all">
                            <span class="d-block text-muted fw-bold mb-1" style="font-size:11px; text-transform:uppercase;">Bugünkü Hareket</span>
                            <strong class="fs-4 text-primary" id="lblTodayOp">0</strong> <span class="text-muted" style="font-size:12px;">İşlem</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border border-light shadow-sm rounded-3 p-3 text-center bg-white transition-all">
                            <span class="d-block text-muted fw-bold mb-1" style="font-size:11px; text-transform:uppercase;">Risk Durumu</span>
                            <strong class="fs-4 text-success"><i class="fas fa-shield-alt me-1"></i>Normal</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- WIZARD MODAL -->
<div class="modal fade" id="transferModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 95%;">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px; overflow:hidden;">
            <div class="modal-header modal-header-gradient text-white py-3 px-4">
                <h5 class="modal-title fw-bold" style="letter-spacing: 0.5px;">
                    <i class="fas fa-bolt text-warning me-2 fs-4"></i> Zincirleme Çek / Senet İbraz ve Tahsilat Sihirbazı
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light p-4">
                
                <div class="row h-100">
                    <div class="col-md-4 border-end border-2 pe-4 d-flex flex-column">
                        <div class="mb-4 bg-white p-3 rounded-3 shadow-sm border border-light">
                            <span class="badge bg-dark mb-3 px-3 py-2 rounded-pill shadow-sm"><i class="fas fa-flag-checkered me-1"></i> Başlangıç (Kaynak Şirket)</span>
                            <label class="form-label fw-bold text-secondary" style="font-size:12px;">ÇIKIŞ YAPACAK ŞİRKET</label>
                            <select class="form-select shadow-sm fw-bold" id="sourceCompany" onchange="onSourceCompanyChange()" style="width: 100%;">
                                <option value="">Şirket Seçin...</option>
                                @if (companies != null)
                                {
                                    foreach (var comp in companies)
                                    {
                                        <option value="@comp.Key" data-dbname="@comp.DbName">@comp.Display</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="bg-white p-3 rounded-3 shadow-sm border border-light">
                            <label class="form-label fw-bold text-secondary" style="font-size:12px;">İŞLEM GÖRECEK ÇEK / SENET(LER)</label>
                            <select class="form-select shadow-sm" id="portfolioCheck" multiple="multiple" style="width: 100%;">
                            </select>
                            <div class="alert alert-primary mt-3 mb-0 p-2 border-0 bg-primary bg-opacity-10 text-primary" style="font-size: 11px; font-weight:500;">
                                <i class="fas fa-info-circle me-1"></i> Sadece seçilen şirketin portföyündeki <strong>müsait</strong> evraklar listelenir.
                            </div>
                        </div>

                        <div class="bg-white p-3 rounded-3 shadow-sm border border-light flex-grow-1 mt-3" id="selectedChecksPanel" style="display:none; max-height: 250px; overflow-y:auto;">
                            <label class="form-label fw-bold text-secondary" style="font-size:12px;">SEÇİLEN EVRAK DETAYI</label>
                            <table class="table table-sm table-hover align-middle mb-0" style="font-size:11px;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Belge No</th>
                                        <th>Banka / Veren</th>
                                        <th class="text-end">Tutar</th>
                                    </tr>
                                </thead>
                                <tbody id="selectedChecksBody">
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-md-8 ps-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-3 rounded-3 shadow-sm border border-light">
                            <span class="badge bg-primary px-3 py-2 rounded-pill shadow-sm fs-6"><i class="fas fa-route me-2"></i>Transfer Rotası (Zincir)</span>
                            <button type="button" class="btn btn-outline-primary fw-bold rounded-pill px-4 shadow-sm" id="btnAddStep" onclick="addNewWizardStep()">
                                <i class="fas fa-plus me-2"></i> Yeni Adım Ekle
                            </button>
                        </div>
                        
                        <div id="routeContainer" class="d-flex flex-column gap-3 overflow-auto pe-2" style="max-height: 55vh;">
                            <!-- Adımlar buraya eklenecek -->
                        </div>
                        
                        <div class="alert border-warning border-start border-4 mt-auto mb-0 shadow-sm bg-white d-flex align-items-center p-3" style="border-radius: 8px;">
                            <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3">
                                <i class="fas fa-lightbulb fa-2x text-warning"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-1">Akıllı Giriş & Çıkış Seçimi Aktif</h6>
                                <span class="text-muted" style="font-size: 13px;">Seçtiğiniz her şirket için sistem ODPS(İbraz) ve ORCT(Tahsilat) tablolarına göre <b>"İşlem Türü"</b> alanlarını ayrı ayrı veritabanından çeker. Kafa karışıklığı olmadan doğru işlemleri seçebilirsiniz.</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer bg-white border-top p-4 d-flex justify-content-between" style="border-radius: 0 0 16px 16px;">
                <button type="button" class="btn btn-light btn-lg border fw-bold text-secondary" data-bs-dismiss="modal">İptal ve Kapat</button>
                <button type="button" class="btn btn-success btn-lg px-5 fw-bold shadow hover-elevate" id="btnExecute" onclick="executeChainTransfer()">
                    <i class="fas fa-paper-plane me-2"></i> Zinciri Başlat (Tüm Fişleri SAP'ye Gönder)
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    const exactCariMappings = {
        'URASKIMYA': { 'ALVFILO': { M: 'M1160', T: 'T1653' }, 'ALV_KIMYA': { M: 'M0143', T: 'T0332' }, 'ASIA_KIMYA': { M: 'M0018', T: 'T0054' }, 'AVRASYA': { M: 'M0029', T: 'T0078' }, 'AVRUPA_PAPER': { M: 'M0014', T: 'T0023' }, 'DAF_KIMYA': { M: 'M0453', T: 'T0646' }, 'SELVI': { M: 'M1408', T: 'T2027' }, 'URAS_HOLDING': { M: '', T: 'T2295' }, 'URSMAKINE': { M: 'M1604', T: 'T2296' } },
        'URSMAKINE': { 'ALVFILO': { M: '', T: 'T0078' }, 'ALV_KIMYA': { M: 'M0006', T: 'T0537' }, 'ASIA_KIMYA': { M: 'M0007', T: 'T0271' }, 'AVRASYA': { M: 'M0004', T: '' }, 'AVRUPA_PAPER': { M: 'M0008', T: 'T0535' }, 'DAF_KIMYA': { M: '', T: 'T0885' }, 'SELVI': { M: 'M0029', T: '' }, 'URAS_HOLDING': { M: 'M0046', T: 'T0836' }, 'URASKIMYA': { M: 'M0031', T: 'T0144' } },
        'ALV_KIMYA': { 'ALVFILO': { M: 'M0264', T: 'T0113' }, 'ASIA_KIMYA': { M: 'M0008', T: 'T0159' }, 'AVRASYA': { M: 'M0015', T: 'T0199' }, 'AVRUPA_PAPER': { M: 'M0006', T: 'T0202' }, 'DAF_KIMYA': { M: 'M0044', T: 'T0433' }, 'SELVI': { M: 'M0136', T: 'T1398' }, 'URAS_HOLDING': { M: 'M0165', T: 'T1871' }, 'URASKIMYA': { M: 'M0001', T: 'T1606' }, 'URSMAKINE': { M: 'M0071', T: 'T1862' } },
        'SELVI': { 'ALVFILO': { M: 'M0009', T: '' }, 'ALV_KIMYA': { M: 'M0001', T: 'T0008' }, 'ASIA_KIMYA': { M: 'M0005', T: 'T0020' }, 'AVRASYA': { M: 'MU0494', T: 'T0041' }, 'AVRUPA_PAPER': { M: 'M0065', T: 'T0018' }, 'DAF_KIMYA': { M: 'M0013', T: 'T0070' }, 'URASKIMYA': { M: 'M0029', T: 'T0223' }, 'URAS_HOLDING': { M: 'M1167', T: 'T0228' }, 'URSMAKINE': { M: 'M0068', T: 'T0229' } },
        'URAS_HOLDING': { 'ALVFILO': { M: 'M0016', T: 'T0001' }, 'ALV_KIMYA': { M: '', T: 'T0046' }, 'ASIA_KIMYA': { M: 'M0012', T: '' }, 'AVRASYA': { M: 'M0011', T: '' }, 'AVRUPA_PAPER': { M: 'M0003', T: 'T0009' }, 'DAF_KIMYA': { M: 'M0013', T: 'T0026' }, 'SELVI': { M: 'M0017', T: 'T0054' }, 'URSMAKINE': { M: 'M0006', T: 'T0010' }, 'URASKIMYA': { M: 'M0009', T: 'T0006' } },
        'AVRUPA_PAPER': { 'ALVFILO': { M: 'M0311', T: 'T0352' }, 'ALV_KIMYA': { M: 'M0002', T: 'T0010' }, 'ASIA_KIMYA': { M: 'M0016', T: 'T0061' }, 'AVRASYA': { M: 'M0018', T: 'T0065' }, 'DAF_KIMYA': { M: 'M0056', T: 'T0141' }, 'SELVI': { M: 'M0216', T: 'T0423' }, 'URAS_HOLDING': { M: 'M0312', T: 'T0569' }, 'URSMAKINE': { M: 'M0104', T: 'T0226' }, 'URASKIMYA': { M: 'M0253', T: 'T0487' } },
        'DAF_KIMYA': { 'ALVFILO': { M: 'M0114', T: 'T0095' }, 'ALV_KIMYA': { M: 'M0001', T: 'T0001' }, 'ASIA_KIMYA': { M: 'M0004', T: 'T0014' }, 'AVRASYA': { M: 'M0007', T: 'T0016' }, 'AVRUPA_PAPER': { M: 'M0003', T: 'T0005' }, 'SELVI': { M: 'M0029', T: 'T0116' }, 'URAS_HOLDING': { M: 'M0110', T: 'T01187' }, 'URSMAKINE': { M: 'M0034', T: '' }, 'URASKIMYA': { M: 'M0105', T: 'T0151' } },
        'ALVFILO': { 'ALV_KIMYA': { M: 'M0003', T: 'T0071' }, 'ASIA_KIMYA': { M: 'M0004', T: 'T0073' }, 'AVRASYA': { M: 'M0007', T: '' }, 'AVRUPA_PAPER': { M: 'M0001', T: 'T0003' }, 'DAF_KIMYA': { M: 'M0011', T: 'T0072' }, 'SELVI': { M: '', T: 'T0045' }, 'URAS_HOLDING': { M: '', T: 'T0039' }, 'URSMAKINE': { M: 'M0013', T: '' }, 'URASKIMYA': { M: 'M0024', T: 'T0038' } }
    };

    let wizardStepCount = 0;
    let consolidatedGroupBPs = [];
    let currentPortfolioData = []; 

    const formatCurrency = (val) => new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY' }).format(val);

    const companyKeywords = {
        'URASKIMYA': ['URAS KİMYA', 'URAS KIMYA', 'URAS SAN', 'URAS K'],
        'URSMAKINE': ['URS MAK'],
        'AVRUPA_PAPER': ['AVRUPA P'],
        'ALV_KIMYA': ['ALV K'],
        'DAF_KIMYA': ['DAF'],
        'SELVI': ['SELVİ', 'SELVI'],
        'ALVFILO': ['ALV F'],
        'AVRASYA': ['AVRASYA'],
        'ASIA_KIMYA': ['ASİA', 'ASIA'],
        'URAS_HOLDING': ['HOLDİNG', 'HOLDING']
    };

    function matchCompany(dbName, cardName) {
        if(!dbName || !cardName) return false;
        cardName = cardName.toUpperCase();
        let keywords = companyKeywords[dbName] || [dbName];
        for(let kw of keywords) {
            if(cardName.includes(kw)) return true;
        }
        return false;
    }

    $(document).ready(function() {
        $('#sourceCompany').select2({ dropdownParent: $('#transferModal') });
        $('#portfolioCheck').select2({ 
            placeholder: "🔍 Belge No, Banka, Cari Adı veya Tutar arayın...", 
            allowClear: true,
            dropdownParent: $('#transferModal') 
        });
        
        $.ajax({
            url: '/Rapor129/GetConsolidatedGroupBPs',
            type: 'GET',
            cache: false,
            success: function(data) {
                consolidatedGroupBPs = data;
            }
        });

        $('#portfolioCheck').on('change', function() {
            let selectedKeys = $(this).val();
            let tbody = $('#selectedChecksBody');
            tbody.empty();

            if(!selectedKeys || selectedKeys.length === 0) {
                $('#selectedChecksPanel').hide();
                return;
            }

            $('#selectedChecksPanel').show();
            
            selectedKeys.forEach(key => {
                let c = currentPortfolioData.find(x => x.checkKey == key);
                if(c) {
                    let bankaVeren = `${c.bankName || c.bankCode || '-'}<br><span class="text-muted">${c.cardName || '-'}</span>`;
                    tbody.append(`
                        <tr>
                            <td class="fw-bold">${c.checkNum} <br><span class="badge bg-secondary p-1" style="font-size:9px;">${c.belgeTipi || 'Çek'}</span></td>
                            <td>${bankaVeren}</td>
                            <td class="text-success fw-bold text-end">${formatCurrency(c.checkSum)}<br><span class="text-muted" style="font-size:10px;">${c.dueDate || '-'}</span></td>
                        </tr>
                    `);
                }
            });
        });
    });

    function refreshDashboard() {
        let dbKey = $('#dashboardCompany').val();
        if(!dbKey) {
            $('#tblMovements').html('<tr><td colspan="9" class="text-center text-muted py-5"><i class="fas fa-folder-open fa-3x mb-3 opacity-25"></i><br>Lütfen izlenecek şirketi seçin...</td></tr>');
            return;
        }

        $('#lblSelectedCompany').text($("#dashboardCompany option:selected").text());
        $('#tblMovements').html('<tr><td colspan="9" class="text-center text-primary py-5"><i class="fas fa-circle-notch fa-spin fa-3x mb-3"></i><br><strong>Veriler Yükleniyor...</strong></td></tr>');

        $.get('/Rapor129/GetDashboardSummary', { dbKey: dbKey }, function(data) {
            $('#kpiTotalAmount').text(formatCurrency(data.totalCheckAmount));
            $('#kpiActiveCount').text(data.activeCheckCount + " Adet");
            $('#kpiInOut').text(data.todayInCount + " / " + data.todayOutCount);
            $('#kpiVoucher').text(data.autoVoucherCount + " Kayıt");
            $('#lblTodayOp').text(data.todayInCount + data.todayOutCount);
        });

        let checkNoFilter = $('#fltCheckNo').val();
        $.get('/Rapor129/GetCheckMovements', { dbKey: dbKey, checkNo: checkNoFilter }, function(data) {
            let tbody = '';
            if(data.length === 0) {
                tbody = '<tr><td colspan="9" class="text-center text-muted py-5"><i class="fas fa-search fa-2x mb-2 opacity-25"></i><br>Kayıt bulunamadı.</td></tr>';
            } else {
                data.forEach(function(row) {
                    let badgeClass = row.status === "Portföyde" ? "badge-soft-success" : (row.status === "İade Edildi" ? "badge-soft-danger" : "badge-soft-primary");
                    let icon = row.status === "Portföyde" ? '<i class="fas fa-check-circle me-1"></i>' : '';
                    let belgeTipiStr = row.belgeTipi ? row.belgeTipi : "Çek";
                    let tipRenk = belgeTipiStr === "Senet" ? "bg-warning text-dark" : "bg-info text-dark";
                    let islemTipiStr = row.islemTipi ? row.islemTipi : "-";

                    tbody += `
                        <tr onclick="$('#lblSelectedCheck').text('${row.checkNo}')">
                            <td><span class="badge ${tipRenk} px-2 py-1">${belgeTipiStr}</span></td>
                            <td class="fw-bold text-primary">${row.checkNo}</td>
                            <td><span class="bg-light px-2 py-1 rounded text-secondary fw-bold" style="font-size:11px;">${row.actionType}</span></td>
                            <td><span class="badge bg-secondary px-2 py-1">${islemTipiStr}</span></td>
                            <td>${row.source}</td>
                            <td>${row.target}</td>
                            <td class="fw-bold text-dark">${formatCurrency(row.amount)}</td>
                            <td>${row.dueDate}</td>
                            <td><span class="${badgeClass}">${icon}${row.status}</span></td>
                        </tr>
                    `;
                });
            }
            $('#tblMovements').html(tbody);
        });
    }

    function onSourceCompanyChange() {
        loadPortfolioChecks();
        $('#routeContainer').empty();
        wizardStepCount = 0;
        $('#btnAddStep').prop('disabled', false);
        addNewWizardStep(); 
    }

    function loadPortfolioChecks() {
        var dbKey = $('#sourceCompany').val();
        $('#portfolioCheck').empty().trigger('change');
        currentPortfolioData = [];
        if(!dbKey) return;

        $.get('/Rapor129/GetPortfolioChecks', { dbKey: dbKey }, function(data) {
            currentPortfolioData = data; 
            data.forEach(function(c) {
                let bTipi = c.belgeTipi ? c.belgeTipi : "Çek";
                let bankaStr = c.bankName ? c.bankName : (c.bankCode ? c.bankCode : "Banka Yok");
                let text = `[${bTipi}] - No: ${c.checkNum} | Banka: ${bankaStr} | Veren: ${c.cardName} | Tutar: ${formatCurrency(c.checkSum)}`;
                $('#portfolioCheck').append(new Option(text, c.checkKey, false, false));
            });
            $('#portfolioCheck').trigger('change');
        });
    }

    function loadStepUdfs(stepId, sourceDb, targetDb, targetType) {
        function fillSelect(selector, data) {
            let sel = $(selector);
            sel.empty().append('<option value="">-- Seçiniz --</option>');
            data.forEach(item => {
                sel.append(new Option(item.text, item.id));
            });
        }

        if (sourceDb) {
            $(`#outAktar-${stepId}`).empty().append('<option value="">Yükleniyor...</option>');
            $(`#outIslem-${stepId}`).empty().append('<option value="">Yükleniyor...</option>');

            $.get('/Rapor129/GetUdfValidValues', { dbKey: sourceDb, tableId: 'ODPS', aliasId: 'BE1_AKTAR' }, function(data) {
                fillSelect(`#outAktar-${stepId}`, data);
            });
            $.get('/Rapor129/GetUdfValidValues', { dbKey: sourceDb, tableId: 'ODPS', aliasId: 'BE1_CEKISLEMTUR' }, function(data) {
                fillSelect(`#outIslem-${stepId}`, data);
            });
        }

        if (targetType === "GroupCompany" && targetDb) {
            $(`#inAktar-${stepId}`).empty().append('<option value="">Yükleniyor...</option>');
            $(`#inIslem-${stepId}`).empty().append('<option value="">Yükleniyor...</option>');

            $.get('/Rapor129/GetUdfValidValues', { dbKey: targetDb, tableId: 'ORCT', aliasId: 'BE1_AKTAR' }, function(data) {
                fillSelect(`#inAktar-${stepId}`, data);
            });
            $.get('/Rapor129/GetUdfValidValues', { dbKey: targetDb, tableId: 'ORCT', aliasId: 'BE1_CEKISLEMTUR' }, function(data) {
                fillSelect(`#inIslem-${stepId}`, data);
            });
        }
    }

    function addNewWizardStep() {
        if(wizardStepCount > 0) {
            let lastType = $(`#step-${wizardStepCount} .step-type`).val();
            if(lastType !== "GroupCompany") {
                Swal.fire({ icon: 'warning', title: 'Uyarı', text: 'Mevcut işlem zinciri bankada/dış caride son bulmuştur. Yeni adım ekleyemezsiniz.' });
                return;
            }
        }

        wizardStepCount++;
        let today = new Date().toISOString().split('T')[0];
        let companiesOptions = $('#sourceCompany').html();

        let sourceSelect = (wizardStepCount === 1) ? $('#sourceCompany option:selected') : $(`#step-${wizardStepCount-1} .step-target-db option:selected`);
        let sourceDbKey = sourceSelect.val();
        let sourceDisplay = sourceSelect.text();

        if(!sourceDisplay || sourceDisplay.includes("Şirket Seçin")) {
            Swal.fire({ icon: 'warning', title: 'Uyarı', text: 'Lütfen bir önceki adımda kaynak/hedef şirketi seçtiğinizden emin olunuz.' });
            wizardStepCount--;
            return;
        }

        let stepHeaderText = `<i class="fas fa-route me-2"></i>Adım ${wizardStepCount} : <span class="text-dark bg-light px-3 py-1 rounded shadow-sm border border-light mx-1">${sourceDisplay}</span> Şirketinden Çıkış Yapılıyor.`;

        let html = `
        <div class="wizard-step-card" id="step-${wizardStepCount}">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                <span class="fw-bold text-primary" style="font-size: 15px;" id="stepHeader-${wizardStepCount}">
                    ${stepHeaderText}
                </span>
                ${wizardStepCount > 1 ? `<button type="button" class="btn btn-sm btn-outline-danger py-1 px-3 rounded-pill fw-bold" onclick="removeWizardStep(${wizardStepCount})"><i class="fas fa-trash-alt me-1"></i> Adımı Sil</button>` : ''}
            </div>
            
            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary">HEDEF TÜRÜ</label>
                    <select class="form-select form-select-sm step-type fw-bold shadow-sm" onchange="onTargetTypeChange(${wizardStepCount})">
                        <option value="GroupCompany">Grup İçi Şirket</option>
                        <option value="ExternalCari">Dış Cari Hesap (Ciro)</option>
                        <option value="Bank">Banka Hesabı (İbraz)</option>
                    </select>
                </div>

                <div class="col-md-3" id="divGroupDb-${wizardStepCount}">
                    <label class="form-label small fw-bold text-secondary">HEDEF ŞİRKET</label>
                    <select class="form-select form-select-sm step-target-db fw-bold text-primary shadow-sm" onchange="bindGroupCariDropdowns(${wizardStepCount})">
                        ${companiesOptions}
                    </select>
                </div>
                
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">İŞLEM TARİHİ</label>
                    <input type="date" class="form-control form-control-sm step-date text-center fw-bold" value="${today}">
                </div>

                <div class="col-md-3 d-none" id="divChkType-${wizardStepCount}">
                    <label class="form-label small fw-bold text-secondary mb-1">İBRAZ TÜRÜ</label>
                    <div class="d-flex gap-3 border rounded px-2 shadow-sm bg-white" style="height:31px;align-items:center;" title="İbraz ekranındakiyle aynı: Nakit = SAP'de hemen tahsil (ChkType C), Vadeli = tahsile verilen çek (ChkType S), vadesinde Vadeli Çek İbrazı ekranından bankadan tahsil edilir">
                        <div class="form-check form-check-inline m-0 small">
                            <input class="form-check-input step-chk-type" type="radio" name="chkType-${wizardStepCount}" id="rbNakit-${wizardStepCount}" value="Cash" checked>
                            <label class="form-check-label fw-bold" for="rbNakit-${wizardStepCount}">Nakit Çek</label>
                        </div>
                        <div class="form-check form-check-inline m-0 small">
                            <input class="form-check-input step-chk-type" type="radio" name="chkType-${wizardStepCount}" id="rbVadeli-${wizardStepCount}" value="PostDated">
                            <label class="form-check-label fw-bold" for="rbVadeli-${wizardStepCount}">Vadeli Çek</label>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="row g-3 mb-3">
                <div class="col-md-6 div-group-cari-${wizardStepCount}">
                    <label class="dynamic-label-source mb-1 d-block" id="lbl-curr-bp-${wizardStepCount}"><i class="fas fa-sign-out-alt me-1"></i>... Sistemindeki ... Carisi</label>
                    <select class="form-select form-select-sm step-curr-bp" data-placeholder="Seçiniz..."><option value=""></option></select>
                </div>
                <div class="col-md-6 div-group-cari-${wizardStepCount}">
                    <label class="dynamic-label-target mb-1 d-block" id="lbl-next-bp-${wizardStepCount}"><i class="fas fa-sign-in-alt me-1"></i>... Sistemindeki ... Carisi</label>
                    <select class="form-select form-select-sm step-next-bp" data-placeholder="Seçiniz..."><option value=""></option></select>
                </div>

                <div class="col-md-9 d-none" id="divExternalTarget-${wizardStepCount}">
                    <label class="dynamic-label-source mb-1 d-block" id="lblExternalTitle-${wizardStepCount}">KİME ÇIKIŞ YAPILACAK?</label>
                    <select class="form-select form-select-sm step-target-code fw-bold shadow-sm" style="width: 100%;"></select>
                </div>
            </div>

            <hr class="text-muted opacity-25">

            <div class="row g-3">
                <div class="col-md-6 border-end">
                    <h6 class="text-danger mb-3 fw-bold" style="font-size:12px;"><i class="fas fa-sign-out-alt me-1"></i> ÇIKIŞ BİLGİLERİ (İBRAZ - ODPS)</h6>
                    <div class="mb-2">
                        <label class="form-label small fw-bold text-secondary mb-1">U_BE1_AKTAR</label>
                        <select class="form-select form-select-sm fw-bold border-danger border-opacity-50" id="outAktar-${wizardStepCount}" required>
                            <option value="">-- Seçiniz --</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label small fw-bold text-secondary mb-1">İŞLEM TİPİ</label>
                        <select class="form-select form-select-sm fw-bold border-danger border-opacity-50" id="outIslem-${wizardStepCount}" required>
                            <option value="">-- Seçiniz --</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-6" id="divInFields-${wizardStepCount}">
                    <h6 class="text-success mb-3 fw-bold" style="font-size:12px;"><i class="fas fa-sign-in-alt me-1"></i> GİRİŞ BİLGİLERİ (TAHSİLAT - ORCT)</h6>
                    <div class="mb-2">
                        <label class="form-label small fw-bold text-secondary mb-1">U_BE1_AKTAR</label>
                        <select class="form-select form-select-sm fw-bold border-success border-opacity-50" id="inAktar-${wizardStepCount}" required>
                            <option value="">Hedef Şirket Seçiniz</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label small fw-bold text-secondary mb-1">İŞLEM TİPİ</label>
                        <select class="form-select form-select-sm fw-bold border-success border-opacity-50" id="inIslem-${wizardStepCount}" required>
                            <option value="">Hedef Şirket Seçiniz</option>
                        </select>
                    </div>
                </div>
            </div>

        </div>`;

        $('#routeContainer').append(html);
        $(`#step-${wizardStepCount} .step-target-db option[value='']`).remove();
        
        $(`#step-${wizardStepCount} .step-curr-bp, #step-${wizardStepCount} .step-next-bp`).select2({ dropdownParent: $('#transferModal') });
        bindGroupCariDropdowns(wizardStepCount);
        
        loadStepUdfs(wizardStepCount, sourceDbKey, null, null);

        var rc = document.getElementById("routeContainer");
        rc.scrollTop = rc.scrollHeight;
    }

    function onTargetTypeChange(id) {
        let type = $(`#step-${id} .step-type`).val();
        let sourceSelect = (id === 1) ? $('#sourceCompany option:selected') : $(`#step-${id-1} .step-target-db option:selected`);
        let sourceDisplay = sourceSelect.text();
        let sourceDb = sourceSelect.val();
        
        if(type === "GroupCompany") {
            $(`#divGroupDb-${id}`).removeClass('d-none');
            $(`.div-group-cari-${id}`).removeClass('d-none');
            $(`#divExternalTarget-${id}`).addClass('d-none');
            $(`#divInFields-${id}`).removeClass('d-none');
            $(`#divChkType-${id}`).addClass('d-none');
            $('#btnAddStep').prop('disabled', false);
            bindGroupCariDropdowns(id);
        } else {
            $(`#divGroupDb-${id}`).addClass('d-none');
            $(`.div-group-cari-${id}`).addClass('d-none');
            $(`#divExternalTarget-${id}`).removeClass('d-none');
            $(`#divInFields-${id}`).addClass('d-none');
            // Banka ibrazında Nakit/Vadeli seçimi (İbraz ekranı Rapor119 ile aynı mantık)
            $(`#divChkType-${id}`).toggleClass('d-none', type !== "Bank");
            
            let title = type === "Bank" ? "<i class='fas fa-university me-1'></i> HANGİ BANKAYA İBRAZ EDİLECEK?" : "<i class='fas fa-user-tie me-1'></i> HANGİ DIŞ CARİYE CİRO EDİLECEK?";
            $(`#lblExternalTitle-${id}`).html(title);
            
            let stepHeaderText = `<i class="fas fa-route me-2"></i>Adım ${id} : <span class="text-dark bg-light px-3 py-1 rounded shadow-sm border border-light mx-1">${sourceDisplay}</span> Şirketinden ${type === "Bank" ? 'Bankaya İbraz' : 'Dış Cariye Ciro'}.`;
            $(`#stepHeader-${id}`).html(stepHeaderText);

            $('#btnAddStep').prop('disabled', true);
            for(let i = id + 1; i <= wizardStepCount; i++) { $(`#step-${i}`).remove(); }
            wizardStepCount = id;

            loadStepUdfs(id, sourceDb, null, type);

            let sel = $(`#step-${id} .step-target-code`);
            sel.empty();
            sel.select2({
                dropdownParent: $('#transferModal'),
                placeholder: type === "Bank" ? "Banka adı veya kodu ile arayın..." : "Cari adı veya kodu ile arayın...",
                ajax: {
                    url: '/Rapor129/SearchTarget',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { dbKey: sourceDb, targetType: type, q: params.term || '' };
                    },
                    processResults: function (data) { return { results: data.results }; },
                    cache: true
                },
                minimumInputLength: 2
            });
        }
    }

    function removeWizardStep(id) {
        $(`#step-${id}`).remove();
        wizardStepCount--;
        if(wizardStepCount > 0) { onTargetTypeChange(wizardStepCount); } 
        else { $('#btnAddStep').prop('disabled', false); }
    }

    function bindGroupCariDropdowns(id) {
        let sourceSelect = (id === 1) ? $('#sourceCompany option:selected') : $(`#step-${id-1} .step-target-db option:selected`);
        let targetSelect = $(`#step-${id} .step-target-db option:selected`);

        let sourceDbName = sourceSelect.data('dbname');
        let sourceDbKey = sourceSelect.val();
        let sourceDisplayName = sourceSelect.text();
        
        let targetDbName = targetSelect.data('dbname');
        let targetDbKey = targetSelect.val();
        let targetDisplayName = targetSelect.text();

        let stepHeaderText = `<i class="fas fa-route me-2"></i>Adım ${id} : <span class="text-dark bg-light px-3 py-1 rounded shadow-sm border border-light mx-1">${sourceDisplayName}</span> firmasından çıkıp, <strong class="text-success">${targetDisplayName}</strong> şirketine giriş yapıyoruz.`;
        $(`#stepHeader-${id}`).html(stepHeaderText);

        $(`#lbl-curr-bp-${id}`).html(`<i class="fas fa-sign-out-alt me-1"></i> <span class="text-dark bg-white px-1 border rounded">${sourceDisplayName}</span> DEKİ <strong>"${targetDisplayName}"</strong> CARİSİ (ÇIKIŞ)`);
        $(`#lbl-next-bp-${id}`).html(`<i class="fas fa-sign-in-alt me-1"></i> <span class="text-dark bg-white px-1 border rounded">${targetDisplayName}</span> DEKİ <strong>"${sourceDisplayName}"</strong> CARİSİ (GİRİŞ)`);

        let currSelect = $(`#step-${id} .step-curr-bp`).empty().append('<option value=""></option>');
        let nextSelect = $(`#step-${id} .step-next-bp`).empty().append('<option value=""></option>');

        let bestCurrBp = "";
        let bestNextBp = "";

        if(targetDbKey) {
            loadStepUdfs(id, sourceDbKey, targetDbKey, "GroupCompany");
        } else {
            $(`#inAktar-${id}`).empty().append('<option value="">Hedef Seçiniz</option>');
            $(`#inIslem-${id}`).empty().append('<option value="">Hedef Seçiniz</option>');
        }

        if (exactCariMappings[sourceDbName] && exactCariMappings[sourceDbName][targetDbName]) {
            bestCurrBp = exactCariMappings[sourceDbName][targetDbName].T;
        }

        consolidatedGroupBPs.filter(x => x.sirketDB === sourceDbName).forEach(bp => {
            let safeKodu = bp.cariKodu ? bp.cariKodu.trim() : ""; 
            let opt = new Option(`[${safeKodu}] - ${bp.cariAdi}`, safeKodu);
            currSelect.append(opt);
            if(!bestCurrBp && matchCompany(targetDbName, bp.cariAdi) && safeKodu.startsWith('T')) {
                bestCurrBp = safeKodu; 
            }
        });

        if (exactCariMappings[targetDbName] && exactCariMappings[targetDbName][sourceDbName]) {
            bestNextBp = exactCariMappings[targetDbName][sourceDbName].M;
        }

        consolidatedGroupBPs.filter(x => x.sirketDB === targetDbName).forEach(bp => {
            let safeKodu = bp.cariKodu ? bp.cariKodu.trim() : ""; 
            let opt = new Option(`[${safeKodu}] - ${bp.cariAdi}`, safeKodu);
            nextSelect.append(opt);
            if(!bestNextBp && matchCompany(sourceDbName, bp.cariAdi) && safeKodu.startsWith('M')) {
                bestNextBp = safeKodu; 
            }
        });

        if(bestCurrBp) {
            if (currSelect.find(`option[value="${bestCurrBp}"]`).length === 0) {
                currSelect.append(new Option(`[${bestCurrBp}] - (Otomatik Eşleşme)`, bestCurrBp));
            }
            currSelect.val(bestCurrBp).trigger('change');
        }

        if(bestNextBp) {
            if (nextSelect.find(`option[value="${bestNextBp}"]`).length === 0) {
                nextSelect.append(new Option(`[${bestNextBp}] - (Otomatik Eşleşme)`, bestNextBp));
            }
            nextSelect.val(bestNextBp).trigger('change');
        }
    }

    function executeChainTransfer() {
        let selectedChecks = $('#portfolioCheck').val();
        var request = {
            SourceDbKey: $('#sourceCompany').val(),
            CheckKeys: selectedChecks ? selectedChecks.map(Number) : [],
            Steps: []
        };

        if(!request.SourceDbKey || request.CheckKeys.length === 0) {
            Swal.fire({ icon: 'error', title: 'Eksik Seçim', text: 'Lütfen ana kaynak şirketi ve işleme sokulacak evrakları seçiniz.' });
            return;
        }

        let isValidationFailed = false;

        $('.wizard-step-card').each(function(index) {
            let id = $(this).attr('id').split('-')[1];
            let type = $(this).find('.step-type').val();
            
            let stepObj = {
                StepOrder: index + 1,
                TargetType: type,
                StepDate: $(this).find('.step-date').val(),
                SourceOutAktar: $(`#outAktar-${id}`).val(),
                SourceOutIslemTipi: $(`#outIslem-${id}`).val(),
                TargetInAktar: type === "GroupCompany" ? $(`#inAktar-${id}`).val() : null,
                TargetInIslemTipi: type === "GroupCompany" ? $(`#inIslem-${id}`).val() : null,
                // Banka ibrazı: "Cash" (nakit çek) | "PostDated" (vadeli çek) — SAP CheckDepositType
                CheckDepositType: type === "Bank" ? ($(this).find('.step-chk-type:checked').val() || 'Cash') : null
            };

            if(!stepObj.SourceOutAktar || !stepObj.SourceOutIslemTipi) {
                Swal.fire({ icon: 'warning', title: 'Eksik Veri', text: `Adım ${index+1} için 'ÇIKIŞ BİLGİLERİ' alanlarını eksiksiz seçmelisiniz.` });
                isValidationFailed = true; return false;
            }

            if(type === "GroupCompany") {
                if(!stepObj.TargetInAktar || !stepObj.TargetInIslemTipi) {
                    Swal.fire({ icon: 'warning', title: 'Eksik Veri', text: `Adım ${index+1} için 'GİRİŞ BİLGİLERİ' alanlarını eksiksiz seçmelisiniz.` });
                    isValidationFailed = true; return false;
                }

                stepObj.TargetDbKey = $(this).find('.step-target-db').val();
                stepObj.CurrentDbTargetBpCode = $(this).find('.step-curr-bp').val();
                stepObj.NextDbSourceBpCode = $(this).find('.step-next-bp').val();
                
                if(!stepObj.CurrentDbTargetBpCode || !stepObj.NextDbSourceBpCode) {
                    Swal.fire({ icon: 'warning', title: 'Eksik Veri', text: `Adım ${index+1} için Grup Şirketi Cari kodlarını (Çıkan/Giren) eksiksiz seçmelisiniz.` });
                    isValidationFailed = true; return false;
                }
            } else {
                stepObj.ExternalTargetCode = $(this).find('.step-target-code').val();
                if(!stepObj.ExternalTargetCode) {
                    Swal.fire({ icon: 'warning', title: 'Eksik Veri', text: `Adım ${index+1} için evrakın kime/hangi hesaba çıkılacağını seçmelisiniz.` });
                    isValidationFailed = true; return false;
                }
            }
            request.Steps.push(stepObj);
        });

        if(isValidationFailed) return;

        // Vadeli banka ibrazı: İbraz ekranındaki (Rapor119) uyarının aynısı
        let vadeliAdim = request.Steps.find(s => s.TargetType === "Bank" && s.CheckDepositType === "PostDated");
        if (vadeliAdim && !confirm(`Adım ${vadeliAdim.StepOrder}: çekler VADELİ ÇEK olarak ibraz edilecek.\n\nÇekler SAP'de vadeli (tahsile verilen) duruma geçer ve vadesi gelince Vadeli Çek İbrazı ekranında görünür. Devam edilsin mi?`)) return;

        let lastStep = request.Steps[request.Steps.length - 1];
        if(lastStep && lastStep.TargetType === "GroupCompany") {
            Swal.fire({
                title: 'Uyarı',
                text: "İşlem zinciri şu an bir 'Grup Şirketi'nde son buluyor. Dışarı (Piyasaya veya Bankaya) çıkışı yapılmayacak. Fişleri oluşturmaya devam edilsin mi?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Evet, Devam Et',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    processTransferAjax(request);
                }
            });
        } else {
            processTransferAjax(request);
        }
    }

    function processTransferAjax(request) {
        let saveBtn = $('#btnExecute');
        saveBtn.html('<i class="fas fa-spinner fa-spin me-2"></i> Ön Kontroller ve SAP Aktarımı Yapılıyor...').prop('disabled', true);

        $.ajax({
            url: '/Rapor129/ExecuteChainTransfer',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(request),
            success: function(res) {
                if(res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'İşlem Başarılı',
                        html: `Fişler başarıyla oluşturuldu.<br><br><div style="text-align:left; font-size:12px; background:#f8f9fa; padding:10px; border-radius:5px; max-height:150px; overflow-y:auto;">${res.logs.join("<br>")}</div>`
                    }).then(() => {
                        // PDF İndirme İşlemi Tetikleniyor
                        if(res.printDocs && res.printDocs.length > 0) {
                            fetch('/Rapor129/CreateChainBordro', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(res.printDocs)
                            })
                            .then(response => {
                                if (response.ok) return response.blob();
                                throw new Error("Bordro oluşturulamadı.");
                            })
                            .then(blob => {
                                var url = window.URL.createObjectURL(blob);
                                var a = document.createElement('a');
                                a.href = url;
                                a.download = `Zincir-Transfer-Bordrosu-${new Date().getTime()}.pdf`;
                                document.body.appendChild(a);
                                a.click();
                                a.remove();
                                
                                setTimeout(() => {
                                    $('#transferModal').modal('hide');
                                    if($('#dashboardCompany').val() === request.SourceDbKey) refreshDashboard();
                                    else window.location.reload();
                                }, 1500); 
                            })
                            .catch(err => {
                                toastr.warning("Transfer başarılı ancak PDF indirilemedi.");
                                $('#transferModal').modal('hide');
                                if($('#dashboardCompany').val() === request.SourceDbKey) refreshDashboard();
                            });
                        } else {
                            $('#transferModal').modal('hide');
                            if($('#dashboardCompany').val() === request.SourceDbKey) refreshDashboard();
                        }
                    });
                } else {
                    // IT talebi #19: başarısız denemeden sonra portföy listesi
                    // tazelenir. Aksi halde kullanıcı artık portföyde olmayan
                    // çekleri eski listeden yeniden seçip aynı hatayı alıyordu.
                    if (res.listeyiYenile) { loadPortfolioChecks(); }

                    var kritik = (res.message || '').indexOf('GERİ ALINAMADI') >= 0;

                    Swal.fire({
                        icon: kritik ? 'warning' : 'error',
                        title: kritik ? 'DİKKAT: Çek İbrazda Kaldı' : 'İşlem Tamamlanamadı',
                        html: `<div style="text-align:left; white-space: pre-wrap; font-size:13px; color:${kritik ? '#b45309' : '#b91c1c'};">${res.message}</div>`
                            + (res.logs && res.logs.length
                                ? `<div style="text-align:left; margin-top:12px; padding-top:10px; border-top:1px solid #e2e8f0; font-size:11.5px; color:#64748b; white-space:pre-wrap;">${res.logs.join('\n')}</div>`
                                : ''),
                        width: 680
                    });
                }
            },
            error: function(xhr) { 
                let errorMessage = "SAP Service Layer bağlantı hatası veya zaman aşımı oluştu.";
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    errorMessage = xhr.responseJSON.message;
                } else if (xhr.responseText) {
                    errorMessage = "Sunucu Hatası: " + xhr.status + " " + xhr.statusText;
                }
                // Durum degismis olabilir; liste tazelensin.
                loadPortfolioChecks();

                Swal.fire({
                    icon: 'error',
                    title: 'İşlem Tamamlanamadı',
                    html: `<div style="text-align:left; white-space: pre-wrap; font-size:13px; color:#b91c1c;">${errorMessage}</div>`,
                    width: 640
                });
            },
            complete: function() { 
                saveBtn.html('<i class="fas fa-paper-plane me-2"></i> Zinciri Başlat (Tüm Fişleri SAP\'ye Gönder)').prop('disabled', false); 
            }
        });
    }
</script>
}