@{
    ViewData["Title"] = "Gider / Gelir Kod Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string seciliDb = (string)ViewBag.SeciliDb ?? "";
    string sirketKodu = (string)ViewBag.SirketKodu ?? "";
    bool onaylayici = (bool)(ViewBag.Onaylayici ?? false);
}

<link href="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    .gg-wrap { padding: 0 14px 40px; }
    .gg-hero { background: linear-gradient(120deg, #1e3a8a 0%, #2563eb 55%, #60a5fa 100%); color: #fff; border-radius: 16px; padding: 18px 24px; margin: 14px 0 16px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; box-shadow: 0 10px 30px -12px rgba(37,99,235,.55); }
    .gg-hero h1 { font-size: 1.3rem; font-weight: 700; margin: 0; }
    .gg-hero p { margin: 4px 0 0; opacity: .92; font-size: .84rem; }
    .gg-hero .gg-db { background: rgba(255,255,255,.18); padding: 8px 14px; border-radius: 10px; font-weight: 600; font-size: .88rem; }
    .gg-tabs { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
    .gg-tab { display: flex; align-items: center; gap: 8px; border: 1px solid #d7dce5; background: #fff; color: #475569; font-weight: 700; font-size: .9rem; padding: 10px 18px; border-radius: 11px 11px 0 0; cursor: pointer; }
    .gg-tab .cnt { font-size: .72rem; background: #e2e8f0; color: #475569; border-radius: 20px; padding: 1px 9px; }
    .gg-tab.active { background: #eff6ff; border-color: #93c5fd; color: #1d4ed8; border-bottom-color: #eff6ff; }
    .gg-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 0 12px 12px 12px; box-shadow: 0 4px 14px -8px rgba(15,23,42,.15); }
    .gg-toolbar { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid #eef2f7; flex-wrap: wrap; }
    .gg-search { position: relative; flex: 1; min-width: 220px; }
    .gg-search input { width: 100%; padding: 8px 12px 8px 32px; border: 1px solid #d7dce5; border-radius: 8px; font-size: .86rem; }
    .gg-search i { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: #94a3b8; }
    .gg-btn { border: none; border-radius: 9px; padding: 9px 16px; font-weight: 600; font-size: .84rem; cursor: pointer; }
    .gg-btn.p { background: #2563eb; color: #fff; } .gg-btn.p:hover { background: #1d4ed8; }
    .gg-btn.s { background: #fff; color: #334155; border: 1px solid #d7dce5; } .gg-btn.s:hover { background: #f8fafc; }
    .gg-tablewrap { overflow-x: auto; max-height: 68vh; overflow-y: auto; }
    table.gg { width: 100%; border-collapse: collapse; font-size: .82rem; white-space: nowrap; }
    table.gg thead th { position: sticky; top: 0; background: #f8fafc; color: #334155; font-weight: 700; font-size: .72rem; text-transform: uppercase; letter-spacing: .3px; padding: 9px 10px; border-bottom: 2px solid #e2e8f0; text-align: left; z-index: 2; }
    table.gg tbody td { padding: 7px 10px; border-bottom: 1px solid #f1f5f9; color: #1e293b; }
    table.gg tbody tr:hover td { background: #f6f9ff; }
    table.gg tbody tr.pasif td { color: #94a3b8; text-decoration: line-through; }
    .kod { font-weight: 700; color: #1d4ed8; font-family: Consolas, monospace; }
    .rz { display: inline-block; font-size: .68rem; font-weight: 700; padding: 2px 8px; border-radius: 20px; }
    .rz.uygun { background: #dcfce7; color: #166534; } .rz.hata { background: #fee2e2; color: #991b1b; } .rz.kapsam { background: #f1f5f9; color: #475569; } .rz.degisken { background: #fef3c7; color: #92400e; }
    .gg-mini { border: none; background: #eef2ff; color: #4f46e5; border-radius: 7px; padding: 4px 9px; font-size: .74rem; font-weight: 600; cursor: pointer; margin-right: 3px; }
    .gg-mini.r { background: #fee2e2; color: #b91c1c; }
    .gg-empty { text-align: center; color: #94a3b8; padding: 40px 0; }
    .gg-note { font-size: .78rem; color: #92400e; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 8px 12px; margin: 12px 16px; }
    .gg-modal-bg { position: fixed; inset: 0; background: rgba(15,23,42,.45); display: none; align-items: center; justify-content: center; z-index: 1070; }
    .gg-modal-bg.on { display: flex; }
    .gg-modal { background: #fff; color: #0f172a; border-radius: 14px; width: min(760px, 95vw); max-height: 90vh !important; overflow-y: auto; box-shadow: 0 20px 60px -15px rgba(0,0,0,.4); }
    .gg-modal-head { padding: 14px 20px; border-bottom: 1px solid #eef2f7; display: flex; justify-content: space-between; align-items: center; }
    .gg-modal-head h3 { margin: 0; font-size: 1.02rem; }
    .gg-modal-head .x { border: none; background: #f1f5f9; border-radius: 8px; width: 32px; height: 32px; cursor: pointer; }
    .gg-modal-body { padding: 16px 20px; }
    .gg-form { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; }
    .gg-form label { display: block; font-size: .7rem; font-weight: 700; color: #475569; margin-bottom: 3px; text-transform: uppercase; }
    .gg-form input, .gg-form select, .gg-form textarea { width: 100%; border: 1px solid #d7dce5; border-radius: 8px; padding: 7px 9px; font-size: .84rem; }
    .c1 { grid-column: span 1; } .c2 { grid-column: span 2; } .c3 { grid-column: span 3; } .c4 { grid-column: span 4; } .c6 { grid-column: span 6; }
    .kodon { font-family: Consolas, monospace; font-weight: 700; color: #1d4ed8; background: #eff6ff; padding: 6px 10px; border-radius: 8px; display: inline-block; }
    @@media (max-width: 800px) { .gg-form { grid-template-columns: repeat(2, 1fr); } .c1,.c2,.c3,.c4,.c6 { grid-column: span 2; } }
</style>

<div class="gg-wrap">
    <div class="gg-hero">
        <div>
            <h1><i class="fa-solid fa-sitemap"></i> Gider / Gelir Kod Yönetimi</h1>
            <p>Excel kataloğunun portaldaki karşılığı: gider, gelir, teşvik/istisna kalemleri ve şirket kodları. Fatura, yevmiye ve seçim ekranları kodları buradan alır.</p>
        </div>
        <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
            <a href="/Rapor165" class="gg-db" style="color:#fff; text-decoration:none;" title="Fatura / yevmiye ekranlarından gelen yeni kod talepleri"><i class="fa-solid fa-clipboard-check"></i> Kod Talepleri <span id="talepSayi" class="cnt" style="background:#fbbf24; color:#78350f; border-radius:20px; padding:1px 8px; font-size:.72rem; display:none;"></span></a>
            <div class="gg-db"><i class="fa-solid fa-database"></i> @seciliDb @(string.IsNullOrEmpty(sirketKodu) ? "· şirket kodu EŞLENMEMİŞ" : "· şirket kodu " + sirketKodu)</div>
        </div>
    </div>

    <div class="gg-tabs">
        <div class="gg-tab active" data-tab="GIDER"><i class="fa-solid fa-arrow-trend-down"></i> Gider <span class="cnt" id="cntGIDER">0</span></div>
        <div class="gg-tab" data-tab="GELIR"><i class="fa-solid fa-arrow-trend-up"></i> Gelir <span class="cnt" id="cntGELIR">0</span></div>
        <div class="gg-tab" data-tab="TIS"><i class="fa-solid fa-hand-holding-dollar"></i> Teşvik / İstisna <span class="cnt" id="cntTIS">0</span></div>
        <div class="gg-tab" data-tab="MAHSUP"><i class="fa-solid fa-right-left"></i> Mahsup Eşleştirme <span class="cnt" id="cntMAHSUP">0</span></div>
        <div class="gg-tab" data-tab="GECIS"><i class="fa-solid fa-arrow-right-arrow-left"></i> Kod Geçişi <span class="cnt" id="cntGECIS">0</span></div>
        <div class="gg-tab" data-tab="SIRKET"><i class="fa-solid fa-building"></i> Şirketler</div>
        <div class="gg-tab" data-tab="ICE"><i class="fa-solid fa-file-import"></i> Excel İçe Aktar</div>
        <div class="gg-tab" data-tab="PASIF" title="Pasife çekilmiş kalemler: kullanım kontrolü ve tamamen silme"><i class="fa-solid fa-ban"></i> Pasife Çekilenler <span class="cnt" id="cntPASIF">0</span></div>
    </div>

    <div class="gg-card" id="panePasif" hidden>
        <div class="gg-note">Pasife çekilen kalemler seçim ekranlarında görünmez ama katalogda durur. <b>Sil</b> kalemi tamamen kaldırır; silmeden önce tüm şirketler (kopyalar dâhil) taranır. Kod herhangi bir yevmiye satırında, fatura kaleminde ya da sabit cari tanımında seçiliyse silme engellenir ve o kayıtlar listelenir; kayda gidip seçimi değiştirdikten sonra tekrar deneyin. @(onaylayici ? "" : "Silme yetkisi YKB / IT02 / sistem yöneticisindedir.")</div>
        <div class="gg-toolbar" style="padding:0 16px 10px;">
            <div class="gg-search"><i class="fa-solid fa-magnifying-glass"></i><input type="text" id="pasifAra" placeholder="Kod, grup, kalem ara..."></div>
            <span id="pasifOzet" style="font-size:.8rem; color:#475569;"></span>
        </div>
        <div class="gg-tablewrap">
            <table class="gg"><thead><tr><th>Tip</th><th>Kök Kod</th><th>Ana Grup</th><th>Alt Grup</th><th>Kalem</th><th>Açıklama</th><th>Pasife Alan</th><th></th></tr></thead><tbody id="tbPasif"><tr><td colspan="8" class="gg-empty">Yükleniyor...</td></tr></tbody></table>
        </div>
    </div>

    <div class="gg-modal-bg" id="kullanimModal">
        <div class="gg-modal" style="width:min(1400px,97vw); max-height:94vh !important;">
            <div class="gg-modal-head"><h3 id="kmBaslik">Kod kullanımı</h3><button class="x" onclick="document.getElementById('kullanimModal').classList.remove('on')">✕</button></div>
            <div class="gg-modal-body" id="kmBody"></div>
        </div>
    </div>

    <div class="gg-card" id="paneKalem">
        <div class="gg-toolbar">
            <div class="gg-search"><i class="fa-solid fa-magnifying-glass"></i><input type="text" id="ara" placeholder="Kod, ana grup, alt grup, kalem ara..."></div>
            <select id="anaGrupFiltre" style="border:1px solid #d7dce5; border-radius:8px; padding:8px 10px; font-size:.84rem; max-width:320px;"><option value="">Tüm ana gruplar</option></select>
            <label style="font-size:.8rem; color:#475569;"><input type="checkbox" id="pasifGoster"> Pasifleri göster</label>
            <span id="ozet" style="font-size:.8rem; color:#475569;"></span>
            <button class="gg-btn" id="btnExcel" title="Açık sekmedeki kalemleri Excel'e indir (pasifler işaretli)" style="background:#16a34a; color:#fff;" onclick="window.location.href = '/Rapor164/Excel?tip=' + encodeURIComponent(['GIDER','GELIR','TIS'].includes(aktifTab) ? aktifTab : '')"><i class="fa-solid fa-file-excel"></i> Excel</button>
            <button class="gg-btn p" id="btnYeni"><i class="fa-solid fa-plus"></i> Yeni Kalem</button>
        </div>
        <div class="gg-tablewrap">
            <table class="gg"><thead id="thead"></thead><tbody id="tbody"><tr><td class="gg-empty">Yükleniyor...</td></tr></tbody></table>
        </div>
    </div>

    <div class="gg-card" id="paneSirket" hidden>
        <div class="gg-note">Her SAP veritabanı bir şirket koduna bağlanır; aynı şirketin _AS / _2026 / TEST kopyaları aynı koda bağlanır. Belge satırına yazılan kodun sonundaki 2 hane bu koddur (ör. GDR.03.02.11.<b>07</b>).</div>
        <div style="display:grid; grid-template-columns: 1fr 1.4fr; gap: 16px; padding: 0 16px 16px;">
            <div>
                <div style="font-weight:700; margin:8px 0;">Şirket Kodları <button class="gg-btn s" style="padding:4px 10px; font-size:.76rem;" onclick="sirketEkle()"><i class="fa-solid fa-plus"></i> Ekle</button></div>
                <table class="gg"><thead><tr><th>Kod</th><th>Ad</th><th>Aktif</th><th></th></tr></thead><tbody id="tbSirket"></tbody></table>
            </div>
            <div>
                <div style="font-weight:700; margin:8px 0;">SAP Veritabanı → Şirket Eşlemesi</div>
                <table class="gg"><thead><tr><th>Bağlantı</th><th>Veritabanı</th><th>Şirket Kodu</th></tr></thead><tbody id="tbDb"></tbody></table>
            </div>
        </div>
    </div>

    <div class="gg-card" id="paneGecis" hidden>
        <div class="gg-note">Excel'deki <b>KOD GEÇİŞİ</b> sayfası: yeniden yapılandırılan kalemlerin eski kök kodu → yeni kök kodu. Şirket eki (son 2 hane) korunur. Belgelerde eski kod görülürse buradan yenisine bakılır.</div>
        <div class="gg-tablewrap">
            <table class="gg"><thead><tr><th>Eski Kök Kod</th><th>Yeni Kök Kod</th><th>Eski Ana Grup</th><th>Eski Alt Grup</th><th>Alt Kalem</th><th>Yeni Ana Grup</th><th>Yeni Alt Grup</th><th>Şirket Eki</th></tr></thead><tbody id="tbGecis"><tr><td colspan="8" class="gg-empty">Yükleniyor...</td></tr></tbody></table>
        </div>
    </div>

    <div class="gg-card" id="paneIce" hidden>
        <div class="gg-note">Excel (xlsx/xlsm) yüklendiğinde GİDER LİSTESİ, GELİR LİSTESİ, TEŞVİK &amp; İSTİSNA LİSTESİ, ŞİRKET KODLARI ve KOD GEÇİŞİ sayfaları okunur. Kök kodu (GDR/GLR/TIS + no'lar) aynı olan kalemler güncellenir, yeniler eklenir. <b>"Önce mevcut kalemleri sil"</b> işaretlenirse katalog tamamen boşaltılıp Excel'deki haliyle yeniden kurulur (şirket ve veritabanı eşlemeleri korunur). Mahsup eşleştirme sayfaları gelir listesindeki mahsup sütunlarından yeniden hesaplanır.</div>
        <div style="padding: 0 16px 20px; display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
            <input type="file" id="dosya" accept=".xlsx,.xlsm" style="font-size:.84rem;">
            <label style="font-size:.84rem; color:#b91c1c; font-weight:600;"><input type="checkbox" id="temizle"> Önce mevcut kalemleri sil (temizle ve yeniden yükle)</label>
            <button class="gg-btn p" onclick="iceAktar()"><i class="fa-solid fa-file-import"></i> Yükle ve Aktar</button>
            <span id="iceSonuc" style="font-size:.82rem; color:#475569;"></span>
        </div>
    </div>
</div>

<div class="gg-modal-bg" id="kalemModal">
    <div class="gg-modal">
        <div class="gg-modal-head"><h3 id="mBaslik">Kalem</h3><button class="x" onclick="kapat()">✕</button></div>
        <div class="gg-modal-body">
            <input type="hidden" id="fId">
            <div class="gg-form">
                <div class="c2"><label>Tip</label><select id="fTip" onchange="tipAlanlari(); kodOnizle()"><option value="GIDER">Gider</option><option value="GELIR">Gelir</option><option value="TIS">Teşvik / İstisna</option></select></div>
                <div class="c4" style="display:flex; align-items:flex-end;"><span class="kodon" id="kodOn">GDR.00.00.00</span></div>
                <div class="c1"><label>Ana Grup No</label><input type="number" id="fA" min="1" onchange="kodOnizle()"></div>
                <div class="c5 c3" style="grid-column: span 5;"><label>Ana Grup <span style="font-weight:400; text-transform:none; color:#94a3b8;">(var olan ad seçilirse numarası otomatik gelir, yeni ad için sıradaki numara)</span></label><input type="text" id="fAnaGrup" list="lstAna" oninput="otomatikNo('ana')"><datalist id="lstAna"></datalist></div>
                <div class="c1"><label>Alt Grup No</label><input type="number" id="fB" min="1" onchange="kodOnizle()"></div>
                <div style="grid-column: span 5;"><label>Alt Grup</label><input type="text" id="fAltGrup" list="lstAlt" oninput="otomatikNo('alt')"><datalist id="lstAlt"></datalist></div>
                <div class="c1"><label>Kalem No</label><input type="number" id="fK" min="1" onchange="kodOnizle()"></div>
                <div style="grid-column: span 5;"><label>Alt Kalem</label><input type="text" id="fKalem"></div>

                <div class="c6 gelirAlan" style="border-top:1px dashed #e2e8f0; padding-top:8px; font-weight:700; font-size:.8rem; color:#475569;">Mahsup bilgisi (gelir)</div>
                <div class="c2 gelirAlan"><label>Mahsup Durumu</label><select id="fMahsupDurumu"><option value="">-</option><option>MAHSUP EDİLEBİLİR</option><option>MAHSUP DEĞİL</option><option>DEĞİŞKEN</option></select></div>
                <div class="c2 gelirAlan"><label>Mahsup Türü</label><input type="text" id="fMahsupTuru"></div>
                <div class="c2 gelirAlan"><label>Mahsup Ana Grup</label><input type="text" id="fMahsupAna" list="lstGiderAna"><datalist id="lstGiderAna"></datalist></div>
                <div class="c3 gelirAlan"><label>Mahsup Alt Grup</label><input type="text" id="fMahsupAlt" list="lstGiderAlt"><datalist id="lstGiderAlt"></datalist></div>
                <div class="c3 gelirAlan"><label>Mahsup Alt Kalem</label><input type="text" id="fMahsupKalem" list="lstGiderKalem"><datalist id="lstGiderKalem"></datalist></div>
                <div class="c6 gelirAlan"><label>Mahsup Notu</label><textarea id="fMahsupNotu" rows="2"></textarea></div>

                <div class="c6 tisAlan" style="border-top:1px dashed #e2e8f0; padding-top:8px; font-weight:700; font-size:.8rem; color:#475569;">Teşvik / istisna bilgisi</div>
                <div class="c2 tisAlan"><label>Sınıf</label><select id="fSinif"><option value="">-</option><option>TEŞVİK</option><option>İSTİSNA</option><option>DESTEK</option><option>İNDİRİM</option><option>MUAFİYET</option></select></div>
                <div class="c2 tisAlan"><label>Etki Alanı</label><input type="text" id="fEtki"></div>
                <div class="c2 tisAlan"><label>Uygulama Türü</label><input type="text" id="fUygulama"></div>
                <div class="c6 tisAlan"><label>Raporlama</label><input type="text" id="fRaporlama" placeholder="ANA GELİR/GİDER TOPLAMINA DAHİL DEĞİL"></div>
                <div class="c6"><label>Açıklama</label><textarea id="fAciklama" rows="2"></textarea></div>
                <div class="c2"><label>Durum</label><select id="fAktif"><option value="true">Aktif</option><option value="false">Pasif</option></select></div>
            </div>
            <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:14px;">
                <button class="gg-btn s" onclick="kapat()">Vazgeç</button>
                <button class="gg-btn p" onclick="kaydet()"><i class="fa-solid fa-floppy-disk"></i> Kaydet</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.js"></script>
<script>
    // Layout, .table-container'a backdrop-filter uyguladığından fixed modal viewport'a göre konumlanmaz; body'ye taşınır.
    ['kalemModal'].forEach(id => { const m = document.getElementById(id); if (m && m.parentElement !== document.body) document.body.appendChild(m); });
    toastr.options = { positionClass: "toast-bottom-right", timeOut: 4000, progressBar: true };
    const DB_QS = new URLSearchParams(location.search).get('db');
    const qs1 = DB_QS ? ('?db=' + encodeURIComponent(DB_QS)) : '';
    const qsAnd = DB_QS ? ('&db=' + encodeURIComponent(DB_QS)) : '';
    let TUM = [], aktifTab = 'GIDER';
    const ONEK = { GIDER: 'GDR', GELIR: 'GLR', TIS: 'TIS' };
    function esc(s) { return (s == null ? "" : String(s)).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])); }
    function pad(n) { return String(parseInt(n) || 0).padStart(2, '0'); }
    function rozet(d) { if (!d) return ''; const k = d === 'UYGUN' ? 'uygun' : d === 'HATA' ? 'hata' : d === 'DEĞİŞKEN' ? 'degisken' : 'kapsam'; return `<span class="rz ${k}">${esc(d)}</span>`; }

    function yukle() {
        fetch('/Rapor164/Liste' + qs1).then(r => r.json()).then(res => {
            if (!res.success) { toastr.error(res.message); return; }
            TUM = res.data || [];
            ['GIDER', 'GELIR', 'TIS'].forEach(t => document.getElementById('cnt' + t).textContent = TUM.filter(x => x.tip === t && x.aktif).length);
            document.getElementById('cntPASIF').textContent = TUM.filter(x => !x.aktif).length;
            if (aktifTab === 'PASIF') pasifRender();
            document.getElementById('cntMAHSUP').textContent = TUM.filter(x => x.tip === 'GELIR' && x.aktif && x.mahsupDurumu && x.mahsupDurumu !== 'MAHSUP DEĞİL').length;
            datalistDoldur(); render();
        }).catch(e => toastr.error('Yüklenemedi: ' + e));
    }
    function datalistDoldur() {
        const g = TUM.filter(x => x.tip === 'GIDER');
        const u = (arr, f) => [...new Set(arr.map(f).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'tr'));
        document.getElementById('lstGiderAna').innerHTML = u(g, x => x.anaGrup).map(v => `<option value="${esc(v)}">`).join('');
        document.getElementById('lstGiderAlt').innerHTML = u(g, x => x.altGrup).map(v => `<option value="${esc(v)}">`).join('');
        document.getElementById('lstGiderKalem').innerHTML = u(g, x => x.kalem_).map(v => `<option value="${esc(v)}">`).join('');
    }
    function listeVerisi() {
        const q = document.getElementById('ara').value.trim().toLowerCase();
        const ana = document.getElementById('anaGrupFiltre').value;
        const pasif = document.getElementById('pasifGoster').checked;
        let arr = aktifTab === 'MAHSUP' ? TUM.filter(x => x.tip === 'GELIR' && x.mahsupDurumu && x.mahsupDurumu !== 'MAHSUP DEĞİL') : TUM.filter(x => x.tip === aktifTab);
        if (!pasif) arr = arr.filter(x => x.aktif);
        if (ana) arr = arr.filter(x => x.anaGrup === ana);
        if (q) arr = arr.filter(x => [x.kokKod, x.anaGrup, x.altGrup, x.kalem_, x.mahsupKalem, x.mahsupHedefKokKod, x.sinif, x.etkiAlani, x.aciklama].join(' ').toLowerCase().includes(q));
        return arr;
    }
    function render() {
        const kalemMi = aktifTab !== 'SIRKET' && aktifTab !== 'ICE' && aktifTab !== 'GECIS' && aktifTab !== 'PASIF';
        document.getElementById('paneKalem').hidden = !kalemMi; document.getElementById('paneSirket').hidden = aktifTab !== 'SIRKET'; document.getElementById('paneIce').hidden = aktifTab !== 'ICE'; document.getElementById('paneGecis').hidden = aktifTab !== 'GECIS';
        document.getElementById('panePasif').hidden = aktifTab !== 'PASIF';
        if (!kalemMi) { if (aktifTab === 'SIRKET') sirketleriYukle(); if (aktifTab === 'GECIS') gecisYukle(); if (aktifTab === 'PASIF') pasifRender(); return; }
        const kaynakTip = aktifTab === 'MAHSUP' ? 'GELIR' : aktifTab;
        const anaSel = document.getElementById('anaGrupFiltre'); const eski = anaSel.value;
        const analar = [...new Set(TUM.filter(x => x.tip === kaynakTip).map(x => x.anaGrup))].sort();
        anaSel.innerHTML = '<option value="">Tüm ana gruplar</option>' + analar.map(a => `<option ${a === eski ? 'selected' : ''}>${esc(a)}</option>`).join('');
        const arr = listeVerisi();
        document.getElementById('ozet').textContent = arr.length + ' kayıt';
        let th, rows;
        if (aktifTab === 'MAHSUP') {
            th = '<tr><th>Gelir Kök Kodu</th><th>Gelir Ana Grup</th><th>Alt Grup</th><th>Alt Kalem</th><th>Mahsup Durumu</th><th>Mahsup Hedefi (gider)</th><th>Hedef Kök Kodu</th><th>Mahsup Türü</th><th>Kontrol</th><th>Not</th><th></th></tr>';
            rows = arr.map(x => `<tr class="${x.aktif ? '' : 'pasif'}"><td class="kod">${esc(x.kokKod)}</td><td>${esc(x.anaGrup)}</td><td>${esc(x.altGrup)}</td><td>${esc(x.kalem_)}</td><td>${esc(x.mahsupDurumu)}</td><td>${esc([x.mahsupAnaGrup, x.mahsupAltGrup, x.mahsupKalem].filter(Boolean).join(' › '))}</td><td class="kod">${esc(x.mahsupHedefKokKod)}</td><td>${esc(x.mahsupTuru)}</td><td>${rozet(x.kontrolDurumu)}</td><td style="white-space:normal; max-width:360px; font-size:.76rem; color:#64748b;">${esc(x.mahsupNotu)}</td><td><button class="gg-mini" onclick="duzenle(${x.id})"><i class="fa-solid fa-pen"></i></button></td></tr>`);
        } else if (aktifTab === 'TIS') {
            th = '<tr><th>Kök Kod</th><th>Ana Grup</th><th>Alt Grup</th><th>Alt Kalem</th><th>Sınıf</th><th>Etki Alanı</th><th>Uygulama Türü</th><th>Raporlama</th><th>Açıklama</th><th>İşlem</th></tr>';
            rows = arr.map(x => `<tr class="${x.aktif ? '' : 'pasif'}"><td class="kod">${esc(x.kokKod)}</td><td>${esc(x.anaGrup)}</td><td>${esc(x.altGrup)}</td><td>${esc(x.kalem_)}</td><td>${esc(x.sinif)}</td><td>${esc(x.etkiAlani)}</td><td>${esc(x.uygulamaTuru)}</td><td style="font-size:.74rem;">${esc(x.raporlama)}</td><td style="white-space:normal; max-width:340px; font-size:.76rem; color:#64748b;">${esc(x.aciklama)}</td><td>${islemler(x)}</td></tr>`);
        } else {
            th = '<tr><th>Kök Kod</th><th>No</th><th>Ana Grup</th><th>No</th><th>Alt Grup</th><th>No</th><th>Alt Kalem</th>' + (aktifTab === 'GELIR' ? '<th>Mahsup</th><th>Kontrol</th>' : '') + '<th>İşlem</th></tr>';
            rows = arr.map(x => `<tr class="${x.aktif ? '' : 'pasif'}"><td class="kod">${esc(x.kokKod)}</td><td>${x.anaGrupNo}</td><td>${esc(x.anaGrup)}</td><td>${x.altGrupNo}</td><td>${esc(x.altGrup)}</td><td>${x.kalemNo}</td><td>${esc(x.kalem_)}</td>` + (aktifTab === 'GELIR' ? `<td>${esc(x.mahsupDurumu)}</td><td>${rozet(x.kontrolDurumu)}</td>` : '') + `<td>${islemler(x)}</td></tr>`);
        }
        document.getElementById('thead').innerHTML = th;
        document.getElementById('tbody').innerHTML = rows.length ? rows.join('') : '<tr><td colspan="12" class="gg-empty">Kayıt yok.</td></tr>';
    }
    function islemler(x) { return `<button class="gg-mini" onclick="duzenle(${x.id})"><i class="fa-solid fa-pen"></i> Düzenle</button>` + (x.aktif ? `<button class="gg-mini r" onclick="aktif(${x.id}, false)"><i class="fa-solid fa-ban"></i> Pasif</button>` : `<button class="gg-mini" onclick="aktif(${x.id}, true)"><i class="fa-solid fa-rotate-left"></i> Aktif</button>`); }

    // ---- kalem formu ----
    // Ana grup / alt grup adına göre numaralar otomatik: var olan ad → onun numarası; yeni ad → sıradaki numara. Kalem no = alt grubun sonu + 1.
    function nrm(s) { return (s || '').trim().toLocaleLowerCase('tr-TR').replace(/\s+/g, ' '); }
    function otomatikNo(alan) {
        if (parseInt(fId.value) > 0) return;   // düzenlemede numaralar korunur
        const t = fTip.value, K = TUM.filter(x => x.tip === t);
        const anaAd = nrm(fAnaGrup.value);
        if (alan === 'ana' || alan === 'alt') {
            const ana = K.find(x => nrm(x.anaGrup) === anaAd);
            if (anaAd) fA.value = ana ? ana.anaGrupNo : ((K.length ? Math.max(...K.map(x => x.anaGrupNo)) : 0) + 1);
            const anaK = K.filter(x => x.anaGrupNo === parseInt(fA.value));
            document.getElementById('lstAlt').innerHTML = [...new Set(anaK.map(x => x.altGrup))].map(v => `<option value="${esc(v)}">`).join('');
            const altAd = nrm(fAltGrup.value);
            const alt = anaK.find(x => nrm(x.altGrup) === altAd);
            if (altAd) fB.value = alt ? alt.altGrupNo : ((anaK.length ? Math.max(...anaK.map(x => x.altGrupNo)) : 0) + 1);
            const altK = anaK.filter(x => x.altGrupNo === parseInt(fB.value));
            if (altAd) fK.value = (altK.length ? Math.max(...altK.map(x => x.kalemNo)) : 0) + 1;
        }
        kodOnizle();
    }
    function tipAlanlari() { const t = document.getElementById('fTip').value; document.querySelectorAll('.gelirAlan').forEach(e => e.style.display = t === 'GELIR' ? '' : 'none'); document.querySelectorAll('.tisAlan').forEach(e => e.style.display = t === 'TIS' ? '' : 'none'); anaDatalist(); }
    function anaDatalist() { const t = document.getElementById('fTip').value; const u = (f) => [...new Set(TUM.filter(x => x.tip === t).map(f).filter(Boolean))]; document.getElementById('lstAna').innerHTML = u(x => x.anaGrup).map(v => `<option value="${esc(v)}">`).join(''); document.getElementById('lstAlt').innerHTML = u(x => x.altGrup).map(v => `<option value="${esc(v)}">`).join(''); }
    function kodOnizle() { document.getElementById('kodOn').textContent = ONEK[document.getElementById('fTip').value] + '.' + pad(fA.value) + '.' + pad(fB.value) + '.' + pad(fK.value) + (SIRKET_KODU ? '.' + SIRKET_KODU : ''); }
    const SIRKET_KODU = '@sirketKodu';
    document.getElementById('btnYeni').addEventListener('click', () => {
        const t = aktifTab === 'MAHSUP' ? 'GELIR' : aktifTab;
        doldur({ id: 0, tip: t, anaGrupNo: '', altGrupNo: '', kalemNo: '', aktif: true });
        // aynı tipte bir sonraki ana grup / kalem no önerisi
        const tipK = TUM.filter(x => x.tip === t); if (tipK.length) { const maxA = Math.max(...tipK.map(x => x.anaGrupNo)); fA.value = maxA; const grup = tipK.filter(x => x.anaGrupNo === maxA); fAnaGrup.value = grup[0].anaGrup; const maxB = Math.max(...grup.map(x => x.altGrupNo)); fB.value = maxB; const alt = grup.filter(x => x.altGrupNo === maxB); fAltGrup.value = alt[0].altGrup; fK.value = Math.max(...alt.map(x => x.kalemNo)) + 1; kodOnizle(); }
    });
    function duzenle(id) { const x = TUM.find(k => k.id === id); if (x) doldur(x); }
    function doldur(x) {
        document.getElementById('mBaslik').textContent = x.id ? 'Kalemi Düzenle' : 'Yeni Kalem';
        fId.value = x.id || 0; fTip.value = x.tip; fA.value = x.anaGrupNo; fAnaGrup.value = x.anaGrup || ''; fB.value = x.altGrupNo; fAltGrup.value = x.altGrup || ''; fK.value = x.kalemNo; fKalem.value = x.kalem_ || '';
        fMahsupDurumu.value = x.mahsupDurumu || ''; fMahsupTuru.value = x.mahsupTuru || ''; fMahsupAna.value = x.mahsupAnaGrup || ''; fMahsupAlt.value = x.mahsupAltGrup || ''; fMahsupKalem.value = x.mahsupKalem || ''; fMahsupNotu.value = x.mahsupNotu || '';
        fSinif.value = x.sinif || ''; fEtki.value = x.etkiAlani || ''; fUygulama.value = x.uygulamaTuru || ''; fRaporlama.value = x.raporlama || ''; fAciklama.value = x.aciklama || ''; fAktif.value = String(x.aktif !== false);
        tipAlanlari(); kodOnizle(); document.getElementById('kalemModal').classList.add('on');
    }
    function kapat() { document.getElementById('kalemModal').classList.remove('on'); }
    document.getElementById('kalemModal').addEventListener('click', e => { if (e.target.id === 'kalemModal') kapat(); });
    function kaydet() {
        const k = { id: parseInt(fId.value) || 0, tip: fTip.value, anaGrupNo: parseInt(fA.value) || 0, anaGrup: fAnaGrup.value.trim(), altGrupNo: parseInt(fB.value) || 0, altGrup: fAltGrup.value.trim(), kalemNo: parseInt(fK.value) || 0, kalem_: fKalem.value.trim(),
            mahsupDurumu: fMahsupDurumu.value, mahsupTuru: fMahsupTuru.value.trim(), mahsupAnaGrup: fMahsupAna.value.trim(), mahsupAltGrup: fMahsupAlt.value.trim(), mahsupKalem: fMahsupKalem.value.trim(), mahsupNotu: fMahsupNotu.value.trim(),
            sinif: fSinif.value, etkiAlani: fEtki.value.trim(), uygulamaTuru: fUygulama.value.trim(), raporlama: fRaporlama.value.trim(), aciklama: fAciklama.value.trim(), aktif: fAktif.value === 'true' };
        if (!k.anaGrup || !k.altGrup || !k.kalem_) { toastr.warning('Ana grup, alt grup ve kalem adı zorunlu.'); return; }
        fetch('/Rapor164/Kaydet' + qs1, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(k) }).then(r => r.json()).then(res => {
            if (!res.success) { toastr.error(res.message); return; }
            toastr.success(res.message); kapat(); yukle();
        }).catch(e => toastr.error('Hata: ' + e));
    }
    function aktif(id, a) {
        fetch('/Rapor164/AktifDegistir' + qs1, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'id=' + id + '&aktif=' + a }).then(r => r.json()).then(res => { if (!res.success) toastr.error(res.message); else { toastr.success(res.message); yukle(); } });
    }

    // ---- şirketler ----
    let SIRKETLER = [];
    function sirketleriYukle() {
        fetch('/Rapor164/Sirketler' + qs1).then(r => r.json()).then(res => {
            if (!res.success) { toastr.error(res.message); return; }
            SIRKETLER = res.sirketler || [];
            document.getElementById('tbSirket').innerHTML = SIRKETLER.map(s => `<tr class="${s.aktif ? '' : 'pasif'}"><td class="kod">${esc(s.sirketKodu)}</td><td>${esc(s.ad)}</td><td>${s.aktif ? 'Evet' : 'Hayır'}</td><td><button class="gg-mini" onclick="sirketDuzenle('${esc(s.sirketKodu)}')"><i class="fa-solid fa-pen"></i></button></td></tr>`).join('');
            const opts = '<option value="">- eşlenmedi -</option>' + SIRKETLER.map(s => `<option value="${esc(s.sirketKodu)}">${esc(s.sirketKodu)} ${esc(s.ad)}</option>`).join('');
            document.getElementById('tbDb').innerHTML = (res.dbler || []).map(d => `<tr><td class="small text-muted">${esc(d.dbKey)}</td><td class="fw-bold">${esc(d.dbName)}</td><td><select style="border:1px solid #d7dce5; border-radius:8px; padding:5px 8px; font-size:.82rem;" onchange="dbEsle('${esc(d.dbName)}', this.value)">${opts.replace(`value="${esc(d.sirketKodu)}"`, `value="${esc(d.sirketKodu)}" selected`)}</select></td></tr>`).join('');
        });
    }
    function dbEsle(dbName, kod) {
        fetch('/Rapor164/SirketDbKaydet' + qs1, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'dbName=' + encodeURIComponent(dbName) + '&sirketKodu=' + encodeURIComponent(kod) }).then(r => r.json()).then(res => { if (!res.success) toastr.error(res.message); else toastr.success(res.message); });
    }
    function sirketEkle() { sirketKaydetSor('', '', true); }
    function sirketDuzenle(kod) { const s = SIRKETLER.find(x => x.sirketKodu === kod); if (s) sirketKaydetSor(s.sirketKodu, s.ad, s.aktif); }
    function sirketKaydetSor(kod, ad, aktif) {
        const k = prompt('Şirket kodu (2 hane):', kod); if (k == null) return;
        const a = prompt('Şirket adı:', ad); if (a == null) return;
        const ak = confirm('Şirket aktif olsun mu? (Tamam = aktif)');
        fetch('/Rapor164/SirketKaydet' + qs1, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'sirketKodu=' + encodeURIComponent(k) + '&ad=' + encodeURIComponent(a) + '&aktif=' + ak }).then(r => r.json()).then(res => { if (!res.success) toastr.error(res.message); else { toastr.success(res.message); sirketleriYukle(); } });
    }

    // ---- pasife çekilenler (K05) + kullanım (K06) ----
    const ONAYLAYICI = @(onaylayici ? "true" : "false");
    const TIP_AD = { GIDER: 'Gider', GELIR: 'Gelir', TIS: 'Teşvik / İstisna' };
    function pasifRender() {
        const q = (document.getElementById('pasifAra').value || '').trim().toLowerCase();
        let arr = TUM.filter(x => !x.aktif);
        if (q) arr = arr.filter(x => [x.kokKod, x.anaGrup, x.altGrup, x.kalem_, x.aciklama].join(' ').toLowerCase().includes(q));
        document.getElementById('pasifOzet').textContent = arr.length + ' pasif kalem';
        const tb = document.getElementById('tbPasif');
        tb.innerHTML = arr.length ? arr.map(x => `<tr class="pasif"><td>${esc(TIP_AD[x.tip] || x.tip)}</td><td class="kod">${esc(x.kokKod)}</td><td>${esc(x.anaGrup)}</td><td>${esc(x.altGrup)}</td><td style="text-decoration:none; color:#0f172a;">${esc(x.kalem_)}</td><td style="white-space:normal; max-width:280px; font-size:.76rem;">${esc(x.aciklama)}</td><td style="font-size:.76rem; color:#64748b;">${esc(x.guncelleyen || '')} ${x.guncellemeTarihi ? new Date(x.guncellemeTarihi).toLocaleDateString('tr-TR') : ''}</td>
            <td style="white-space:nowrap;"><button class="gg-mini" onclick="kullanimGoster('${esc(x.kokKod)}', ${x.id})" title="Bu kodun tüm şirketlerde nerede seçildiğini tara"><i class="fa-solid fa-magnifying-glass-location"></i> Kullanımı Gör</button><button class="gg-mini" onclick="aktif(${x.id}, true)"><i class="fa-solid fa-rotate-left"></i> Aktife Al</button>${ONAYLAYICI ? `<button class="gg-mini r" onclick="kalemSil(${x.id}, '${esc(x.kokKod)}', '${esc(x.kalem_)}')"><i class="fa-solid fa-trash"></i> Sil</button>` : ''}</td></tr>`).join('')
            : '<tr><td colspan="8" class="gg-empty">Pasife çekilmiş kalem yok.</td></tr>';
    }
    function kullanimHtml(res, baslikNotu) {
        const kopya = res.data.filter(x => x.kopyaMi).length, ana = res.data.length - kopya;
        let h = `<div class="gg-note" style="margin:0 0 10px;">${esc(baslikNotu || '')} ${res.taranan} veritabanı tarandı (${res.sure} sn). <b>${ana}</b> satır ana şirketlerde, <b>${kopya}</b> satır kopya / test veritabanlarında.${res.hatalar && res.hatalar.length ? '<br><span style="color:#b91c1c;">Taranamayan: ' + res.hatalar.map(esc).join(' | ') + '</span>' : ''}</div>`;
        if (res.ozet && res.ozet.length) h += `<div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:10px;">${res.ozet.map(o => `<span class="rz ${o.kopyaMi ? 'kapsam' : 'hata'}" title="${esc(o.dbName)}"><b>${esc(o.sirketKodu)}</b> ${esc(o.dbName)}: ${o.adet} satır · ${(Number(o.tutar) || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2 })}</span>`).join('')}</div>`;
        if (res.sabitler && res.sabitler.length) h += `<div style="font-size:.78rem; font-weight:700; color:#475569; margin:6px 0;">Sabit cari tanımları (${res.sabitler.length})</div><table class="gg" style="margin-bottom:10px;"><thead><tr><th>Şirket</th><th>Cari</th><th>Tip</th><th>Durum</th></tr></thead><tbody>${res.sabitler.map(s => `<tr><td>${esc(s.sirketKodu)} ${esc(s.sirketDb || '')}</td><td><b>${esc(s.cardCode)}</b> ${esc(s.cardName || '')}</td><td>${esc(s.tip)}</td><td>${esc(s.durum)}</td></tr>`).join('')}</tbody></table>`;
        if (!res.data.length) h += '<div class="gg-empty">Hiçbir belge satırında seçili değil.</div>';
        else h += `<table class="gg"><thead><tr><th>Şirket</th><th>Kaynak</th><th>Belge</th><th>Tarih</th><th>Cari</th><th>Hesap</th><th style="text-align:right;">Tutar</th><th>Seçili Kod</th><th></th></tr></thead><tbody>`
            + res.data.map(x => `<tr class="${x.kopyaMi ? 'pasif' : ''}"><td><b>${esc(x.sirketKodu)}</b> ${esc(x.dbName)}${x.kopyaMi ? ' <span class="rz kapsam">kopya</span>' : ''}</td><td style="font-size:.76rem;">${esc(x.kaynak)}</td><td>${esc(x.belgeTuru)} <b>${esc(x.belgeNo)}</b></td><td>${esc(x.tarih)}</td><td style="white-space:normal; max-width:220px;">${esc(x.cari)}</td><td><span class="kod" style="color:#0f766e;">${esc(x.hesapKodu)}</span> <span style="font-size:.74rem; color:#64748b;">${esc(x.hesapAdi)}</span></td><td style="text-align:right;">${(Number(x.tutar) || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2 })}</td><td class="kod">${esc(x.kod)}</td>
                <td style="white-space:nowrap;">${x.transId > 0 ? `<a class="gg-mini" style="text-decoration:none;" target="_blank" href="/Rapor163?db=${encodeURIComponent(x.dbKey)}&yil=${x.yil}&ay=${x.ay}&vurgu=${x.transId}-${x.lineId >= 0 ? x.lineId : 0}&ara=${encodeURIComponent(x.belgeNo)}" title="Gider Seçim ekranında bu kaydı aç ve vurgula"><i class="fa-solid fa-arrow-up-right-from-square"></i> Kayda Git</a>` : ''}${x.docEntry > 0 && x.kaynak === 'Fatura kalemi' ? ` <a class="gg-mini" style="text-decoration:none;" target="_blank" href="/Rapor166?db=${encodeURIComponent(x.dbKey)}&ara=${encodeURIComponent(x.belgeNo)}" title="Fatura İnceleme'de aç"><i class="fa-solid fa-file-invoice"></i></a>` : ''}</td></tr>`).join('')
            + '</tbody></table>';
        return h;
    }
    function kullanimGoster(kokKod, id) {
        const m = document.getElementById('kullanimModal'); m.classList.add('on');
        document.getElementById('kmBaslik').innerHTML = `<i class="fa-solid fa-magnifying-glass-location"></i> ${esc(kokKod)} kullanımı`;
        document.getElementById('kmBody').innerHTML = '<div class="gg-empty"><i class="fa-solid fa-spinner fa-spin"></i> Tüm şirketler taranıyor, birkaç saniye sürebilir...</div>';
        fetch('/Rapor164/KodKullanim?kokKod=' + encodeURIComponent(kokKod)).then(r => r.json()).then(res => {
            if (!res.success) { document.getElementById('kmBody').innerHTML = `<div class="gg-empty" style="color:#b91c1c;">${esc(res.message)}</div>`; return; }
            document.getElementById('kmBody').innerHTML = kullanimHtml(res, res.toplam ? `Bu kod ${res.toplam} belge satırında seçili.` : 'Bu kod hiçbir belge satırında seçili değil.');
        }).catch(e => { document.getElementById('kmBody').innerHTML = `<div class="gg-empty" style="color:#b91c1c;">Hata: ${esc(e)}</div>`; });
    }
    function kalemSil(id, kokKod, ad) {
        if (!confirm(`${kokKod} ${ad} kalemi TAMAMEN silinecek.\nÖnce tüm şirketlerde kullanım taranır; kullanım varsa silinmez ve kayıtlar gösterilir.\nDevam edilsin mi?`)) return;
        const m = document.getElementById('kullanimModal'); m.classList.add('on');
        document.getElementById('kmBaslik').innerHTML = `<i class="fa-solid fa-trash"></i> ${esc(kokKod)} silme kontrolü`;
        document.getElementById('kmBody').innerHTML = '<div class="gg-empty"><i class="fa-solid fa-spinner fa-spin"></i> Tüm şirketlerde kullanım taranıyor...</div>';
        fetch('/Rapor164/KalemSil', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'id=' + id }).then(r => r.json()).then(res => {
            if (res.success) { toastr.success(res.message, '', { timeOut: 9000 }); m.classList.remove('on'); yukle(); return; }
            if (res.engellendi) {
                toastr.warning(res.message, 'Silme engellendi', { timeOut: 12000 });
                document.getElementById('kmBody').innerHTML = `<div class="gg-note" style="margin:0 0 10px; background:#fef2f2; border-color:#fecaca; color:#991b1b;"><b><i class="fa-solid fa-triangle-exclamation"></i> ${esc(res.message)}</b><br>Aşağıdaki kayıtlarda "Kayda Git" ile seçimi değiştirin ya da boşaltın; sonra tekrar Sil deyin.</div>` + kullanimHtml({ data: res.data || [], sabitler: res.sabitler || [], ozet: [], hatalar: res.hatalar || [], taranan: '-', sure: '-' }, '');
            } else { toastr.error(res.message, '', { timeOut: 9000 }); m.classList.remove('on'); }
        }).catch(e => { toastr.error('Hata: ' + e); m.classList.remove('on'); });
    }
    document.getElementById('pasifAra').addEventListener('input', () => pasifRender());
    document.getElementById('kullanimModal').addEventListener('click', e => { if (e.target.id === 'kullanimModal') e.currentTarget.classList.remove('on'); });

    // ---- kod geçişi ----
    function gecisYukle() {
        fetch('/Rapor164/KodGecis' + qs1).then(r => r.json()).then(res => {
            const tb = document.getElementById('tbGecis');
            if (!res.success) { tb.innerHTML = `<tr><td colspan="8" class="gg-empty">${esc(res.message)}</td></tr>`; return; }
            document.getElementById('cntGECIS').textContent = (res.data || []).length;
            tb.innerHTML = (res.data || []).length ? res.data.map(g => `<tr><td class="kod" style="color:#b45309;">${esc(g.eskiKokKod)}</td><td class="kod">${esc(g.yeniKokKod)}</td><td>${esc(g.eskiAnaGrup)}</td><td>${esc(g.eskiAltGrup)}</td><td>${esc(g.kalem)}</td><td>${esc(g.yeniAnaGrup)}</td><td>${esc(g.yeniAltGrup)}</td><td style="font-size:.76rem; color:#64748b;">${esc(g.sirketEki)}</td></tr>`).join('') : '<tr><td colspan="8" class="gg-empty">Kod geçişi kaydı yok.</td></tr>';
        }).catch(e => toastr.error('Hata: ' + e));
    }

    // ---- excel ----
    function iceAktar() {
        const f = document.getElementById('dosya').files[0]; if (!f) { toastr.warning('Dosya seçin.'); return; }
        const temizle = document.getElementById('temizle').checked;
        if (temizle && !confirm('Mevcut TÜM gider/gelir/teşvik kalemleri silinip Excel\'deki haliyle yeniden yüklenecek. Devam edilsin mi?')) return;
        const fd = new FormData(); fd.append('dosya', f); fd.append('temizle', temizle ? 'true' : 'false');
        document.getElementById('iceSonuc').textContent = 'Yükleniyor...';
        fetch('/Rapor164/IceAktar' + qs1, { method: 'POST', body: fd }).then(r => r.json()).then(res => {
            document.getElementById('iceSonuc').innerHTML = res.success ? ('<b style="color:#166534">' + esc(res.message) + '</b>' + ((res.uyarilar || []).length ? '<br>' + res.uyarilar.map(esc).join('<br>') : '')) : ('<b style="color:#b91c1c">' + esc(res.message) + '</b>');
            if (res.success) { toastr.success('İçe aktarma tamamlandı.'); yukle(); }
        }).catch(e => { document.getElementById('iceSonuc').textContent = 'Hata: ' + e; });
    }

    document.querySelectorAll('.gg-tab').forEach(t => t.addEventListener('click', function () { document.querySelectorAll('.gg-tab').forEach(x => x.classList.remove('active')); this.classList.add('active'); aktifTab = this.dataset.tab; document.getElementById('anaGrupFiltre').value = ''; render(); }));
    let st; document.getElementById('ara').addEventListener('input', () => { clearTimeout(st); st = setTimeout(render, 200); });
    document.getElementById('anaGrupFiltre').addEventListener('change', render);
    document.getElementById('pasifGoster').addEventListener('change', render);
    yukle();
    gecisYukle();
    fetch('/Rapor164/BekleyenTalepSayisi').then(r => r.json()).then(res => { if (res && res.success && res.adet > 0) { const s = document.getElementById('talepSayi'); s.textContent = res.adet + ' bekliyor'; s.style.display = 'inline-block'; } }).catch(() => { });
</script>

