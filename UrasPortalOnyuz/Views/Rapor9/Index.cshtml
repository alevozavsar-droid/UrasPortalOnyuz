@model List<WebApplication3.Models.GroupedFinancialData>
@using System.Globalization;

@{
    ViewData["Title"] = "Ülke Bazında Finansal Rapor";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Her kolon için toplamları tutacak değişkenler
    decimal totalUrsMakineX = 0;
    decimal totalUrsMakineR = 0;
    decimal totalAvrupaPaperX = 0;
    decimal totalAvrupaPaperR = 0;
    decimal totalAlvKimyaX = 0;
    decimal totalAlvKimyaR = 0;
    decimal totalAlvFiloX = 0;
    decimal totalAlvFiloR = 0;
    decimal totalRgbTekstilX = 0;
    decimal totalRgbTekstilR = 0;
    decimal totalUrasKimyaX = 0;
    decimal totalUrasKimyaR = 0;
    decimal totalSelviX = 0;
    decimal totalSelviR = 0;
    decimal totalAsiaDMX = 0;
    decimal totalAsiaDMR = 0;
    decimal totalAvrasyaX = 0;
    decimal totalAvrasyaR = 0;
    decimal totalDafKimyaX = 0;
    decimal totalDafKimyaR = 0;
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #007bff; /* Bootstrap primary */
            --secondary-color: #6c757d; /* Bootstrap secondary */
            --success-color: #28a745; /* Bootstrap success */
            --danger-color: #dc3545; /* Bootstrap danger */
            --info-color: #17a2b8; /* Bootstrap info */
            --light-bg: #f8f9fa; /* Açık gri arka plan */
            --white-bg: #ffffff; /* Beyaz kart arka planı */
            --border-color: #e0e0e0; /* Yumuşak kenarlık */
            --text-color: #333;
            --header-bg: #e9ecef; /* Başlıklar için hafif gri */
            --shadow-light: 0 2px 8px rgba(0,0,0,0.05);
            --shadow-medium: 0 4px 15px rgba(0,0,0,0.1);
        }

        body {
            background-color: var(--light-bg);
            font-family: 'Poppins', sans-serif;
            color: var(--text-color);
            line-height: 1.6;
        }

        .container.mt-4 {
            max-width: 100%;
            padding: 0 10px;
            margin-top: 2.5rem;
        }

        h1, h2, h3, h4, h5, h6 {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 1.5rem;
        }

        .alert-success, .alert-danger {
            margin-top: 1.5rem;
            padding: 1rem 1.5rem;
            border-radius: 8px;
            text-align: center;
            font-size: 1.05rem;
            font-weight: 500;
            opacity: 0;
            transform: translateY(-20px);
            transition: opacity 0.3s ease-out, transform 0.3s ease-out;
        }

            .alert-success.show, .alert-danger.show {
                opacity: 1;
                transform: translateY(0);
            }

        .table-container {
            overflow-x: auto;
            border-radius: 10px;
            box-shadow: var(--shadow-medium);
            background-color: var(--white-bg);
            margin-top: 2rem;
            border: 1px solid var(--border-color);
        }

        table {
            width: 100%;
            border-collapse: collapse; /* Collapsing borders for a cleaner look */
            border-spacing: 0;
        }

        th {
            background-color: var(--header-bg);
            color: #495057;
            padding: 10px 12px; /* Adjusted padding */
            text-align: left;
            white-space: nowrap;
            font-weight: 600;
            border-bottom: 2px solid var(--border-color);
            position: sticky; /* Sticky headers for scrollable tables */
            top: 0;
            z-index: 10;
        }

            th:first-child {
                border-top-left-radius: 10px;
            }

            th:last-child {
                border-top-right-radius: 10px;
            }

        td {
            padding: 8px 12px; /* Adjusted padding */
            vertical-align: middle;
            border-bottom: 1px solid #f2f2f2;
            white-space: nowrap; /* Keep content on a single line */
            overflow: hidden; /* Hide overflow */
            text-overflow: ellipsis; /* Show ellipsis for overflowed text */
            font-size: 0.85rem;
        }

        /* Renklendirme için yeni sınıflar */
        .positive-value {
            color: #28a745; /* Yeşil */
            font-weight: 500;
        }

        .negative-value {
            color: #dc3545; /* Kırmızı */
            font-weight: 500;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .table-hover tbody tr:hover {
            background-color: #f0f8ff;
        }

  

        /* Specific column widths for better readability, adjust as needed */
        th:nth-child(1), td:nth-child(1) {
            min-width: 120px;
        }
        /* Ülke */
        th:nth-child(2), td:nth-child(2) {
            min-width: 120px;
            text-align: right;
        }
        /* URS MAKİNE X */
        th:nth-child(3), td:nth-child(3) {
            min-width: 120px;
            text-align: right;
        }
        /* URS MAKİNE R */
        th:nth-child(4), td:nth-child(4) {
            min-width: 150px;
            text-align: right;
        }
        /* AVRUPA PAPER X */
        th:nth-child(5), td:nth-child(5) {
            min-width: 150px;
            text-align: right;
        }
        /* AVRUPA PAPER R */
        th:nth-child(6), td:nth-child(6) {
            min-width: 120px;
            text-align: right;
        }
        /* ALV KİMYA X */
        th:nth-child(7), td:nth-child(7) {
            min-width: 120px;
            text-align: right;
        }
        /* ALV KİMYA R */
        th:nth-child(8), td:nth-child(8) {
            min-width: 120px;
            text-align: right;
        }
        /* ALV FİLO X */
        th:nth-child(9), td:nth-child(9) {
            min-width: 120px;
            text-align: right;
        }
        /* ALV FİLO R */
        th:nth-child(10), td:nth-child(10) {
            min-width: 130px;
            text-align: right;
        }
        /* RGB TEKSTİL X */
        th:nth-child(11), td:nth-child(11) {
            min-width: 130px;
            text-align: right;
        }
        /* RGB TEKSTİL R */
        th:nth-child(12), td:nth-child(12) {
            min-width: 120px;
            text-align: right;
        }
        /* URAS KİMYA X */
        th:nth-child(13), td:nth-child(13) {
            min-width: 120px;
            text-align: right;
        }
        /* URAS KİMYA R */
        th:nth-child(14), td:nth-child(14) {
            min-width: 100px;
            text-align: right;
        }
        /* SELVİ X */
        th:nth-child(15), td:nth-child(15) {
            min-width: 100px;
            text-align: right;
        }
        /* SELVİ R */
        th:nth-child(16), td:nth-child(16) {
            min-width: 100px;
            text-align: right;
        }
        /* ASIA DM X */
        th:nth-child(17), td:nth-child(17) {
            min-width: 100px;
            text-align: right;
        }
        /* ASIA DM R */
        th:nth-child(18), td:nth-child(18) {
            min-width: 100px;
            text-align: right;
        }
        /* AVRASYA X */
        th:nth-child(19), td:nth-child(19) {
            min-width: 100px;
            text-align: right;
        }
        /* AVRASYA R */
        th:nth-child(20), td:nth-child(20) {
            min-width: 110px;
            text-align: right;
        }
        /* DAF KİMYA X */
        th:nth-child(21), td:nth-child(21) {
            min-width: 110px;
            text-align: right;
        }
        /* DAF KİMYA R */
        /* Yeni Toplam Sütunu için Stil */
        th:last-child, td:last-child {
            min-width: 120px;
            font-weight: 600;
            background-color: #f0f0f0;
            border-left: 2px solid var(--border-color);
        }
        /* Yeni Toplam Satırı için Stil */
        .total-row {
            font-weight: 700;
            background-color: #e9f5ff; /* Daha açık mavi arka plan */
            border-top: 2px solid var(--primary-color);
        }

            .total-row td {
                font-weight: 700;
                font-size: 0.9rem;
                border-bottom: none;
            }
    </style>
}

<div class="container mt-4">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="filter-form">
        <h3 class="mb-3">Tarih Aralığına Göre Filtrele</h3>
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label for="startDate" class="form-label">Başlangıç Tarihi:</label>
                    <input type="date" class="form-control" id="startDate" name="startDate" value="@(ViewBag.StartDate)">
                </div>
                <div class="col-md-5">
                    <label for="endDate" class="form-label">Bitiş Tarihi:</label>
                    <input type="date" class="form-control" id="endDate" name="endDate" value="@(ViewBag.EndDate)">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter me-2"></i> Filtrele
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div id="alertContainer" class="mt-3"></div>

    @if (Model != null && Model.Any())
    {
        <div class="table-container">
            <table class="table table-bordered table-striped table-hover" id="groupedFinancialTable">
                <thead>
                    <tr>
                        <th>Ülke</th>
                        <th>URS MAKİNE X</th>
                        <th>URS MAKİNE R</th>
                        <th>AVRUPA PAPER X</th>
                        <th>AVRUPA PAPER R</th>
                        <th>ALV KİMYA X</th>
                        <th>ALV KİMYA R</th>
                        <th>ALV FİLO X</th>
                        <th>ALV FİLO R</th>
                        <th>RGB TEKSTİL X</th>
                        <th>RGB TEKSTİL R</th>
                        <th>URAS KİMYA X</th>
                        <th>URAS KİMYA R</th>
                        <th>SELVİ X</th>
                        <th>SELVİ R</th>
                        <th>ASIA DM X</th>
                        <th>ASIA DM R</th>
                        <th>AVRASYA X</th>
                        <th>AVRASYA R</th>
                        <th>DAF KİMYA X</th>
                        <th>DAF KİMYA R</th>
                        <th>Satır Toplamı</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        // Her satırın toplamını hesapla
                        var rowTotal = item.UrsMakineX + item.UrsMakineR + item.AvrupaPaperX + item.AvrupaPaperR + item.AlvKimyaX + item.AlvKimyaR + item.AlvFiloX + item.AlvFiloR + item.RgbTekstilX + item.RgbTekstilR + item.UrasKimyaX + item.UrasKimyaR + item.SelviX + item.SelviR + item.AsiaDMX + item.AsiaDMR + item.AvrasyaX + item.AvrasyaR + item.DafKimyaX + item.DafKimyaR;

                        // Kolon toplamlarına ekle
                        totalUrsMakineX += item.UrsMakineX;
                        totalUrsMakineR += item.UrsMakineR;
                        totalAvrupaPaperX += item.AvrupaPaperX;
                        totalAvrupaPaperR += item.AvrupaPaperR;
                        totalAlvKimyaX += item.AlvKimyaX;
                        totalAlvKimyaR += item.AlvKimyaR;
                        totalAlvFiloX += item.AlvFiloX;
                        totalAlvFiloR += item.AlvFiloR;
                        totalRgbTekstilX += item.RgbTekstilX;
                        totalRgbTekstilR += item.RgbTekstilR;
                        totalUrasKimyaX += item.UrasKimyaX;
                        totalUrasKimyaR += item.UrasKimyaR;
                        totalSelviX += item.SelviX;
                        totalSelviR += item.SelviR;
                        totalAsiaDMX += item.AsiaDMX;
                        totalAsiaDMR += item.AsiaDMR;
                        totalAvrasyaX += item.AvrasyaX;
                        totalAvrasyaR += item.AvrasyaR;
                        totalDafKimyaX += item.DafKimyaX;
                        totalDafKimyaR += item.DafKimyaR;

                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Grup)</td>
                            <td class="@(item.UrsMakineX < 0 ? "negative-value" : "positive-value")">@item.UrsMakineX.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.UrsMakineR < 0 ? "negative-value" : "positive-value")">@item.UrsMakineR.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.AvrupaPaperX < 0 ? "negative-value" : "positive-value")">@item.AvrupaPaperX.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.AvrupaPaperR < 0 ? "negative-value" : "positive-value")">@item.AvrupaPaperR.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.AlvKimyaX < 0 ? "negative-value" : "positive-value")">@item.AlvKimyaX.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.AlvKimyaR < 0 ? "negative-value" : "positive-value")">@item.AlvKimyaR.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.AlvFiloX < 0 ? "negative-value" : "positive-value")">@item.AlvFiloX.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.AlvFiloR < 0 ? "negative-value" : "positive-value")">@item.AlvFiloR.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.RgbTekstilX < 0 ? "negative-value" : "positive-value")">@item.RgbTekstilX.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.RgbTekstilR < 0 ? "negative-value" : "positive-value")">@item.RgbTekstilR.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.UrasKimyaX < 0 ? "negative-value" : "positive-value")">@item.UrasKimyaX.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.UrasKimyaR < 0 ? "negative-value" : "positive-value")">@item.UrasKimyaR.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.SelviX < 0 ? "negative-value" : "positive-value")">@item.SelviX.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.SelviR < 0 ? "negative-value" : "positive-value")">@item.SelviR.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.AsiaDMX < 0 ? "negative-value" : "positive-value")">@item.AsiaDMX.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.AsiaDMR < 0 ? "negative-value" : "positive-value")">@item.AsiaDMR.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.AvrasyaX < 0 ? "negative-value" : "positive-value")">@item.AvrasyaX.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.AvrasyaR < 0 ? "negative-value" : "positive-value")">@item.AvrasyaR.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.DafKimyaX < 0 ? "negative-value" : "positive-value")">@item.DafKimyaX.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td class="@(item.DafKimyaR < 0 ? "negative-value" : "positive-value")">@item.DafKimyaR.ToString("N2", CultureInfo.CurrentCulture)</td>
                            <td>@rowTotal.ToString("N2", CultureInfo.CurrentCulture)</td>
                        </tr>
                    }
                    <tr class="total-row">
                        <td><strong>Toplam</strong></td>
                        <td class="@(totalUrsMakineX < 0 ? "negative-value" : "positive-value")"><strong>@totalUrsMakineX.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalUrsMakineR < 0 ? "negative-value" : "positive-value")"><strong>@totalUrsMakineR.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalAvrupaPaperX < 0 ? "negative-value" : "positive-value")"><strong>@totalAvrupaPaperX.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalAvrupaPaperR < 0 ? "negative-value" : "positive-value")"><strong>@totalAvrupaPaperR.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalAlvKimyaX < 0 ? "negative-value" : "positive-value")"><strong>@totalAlvKimyaX.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalAlvKimyaR < 0 ? "negative-value" : "positive-value")"><strong>@totalAlvKimyaR.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalAlvFiloX < 0 ? "negative-value" : "positive-value")"><strong>@totalAlvFiloX.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalAlvFiloR < 0 ? "negative-value" : "positive-value")"><strong>@totalAlvFiloR.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalRgbTekstilX < 0 ? "negative-value" : "positive-value")"><strong>@totalRgbTekstilX.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalRgbTekstilR < 0 ? "negative-value" : "positive-value")"><strong>@totalRgbTekstilR.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalUrasKimyaX < 0 ? "negative-value" : "positive-value")"><strong>@totalUrasKimyaX.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalUrasKimyaR < 0 ? "negative-value" : "positive-value")"><strong>@totalUrasKimyaR.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalSelviX < 0 ? "negative-value" : "positive-value")"><strong>@totalSelviX.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalSelviR < 0 ? "negative-value" : "positive-value")"><strong>@totalSelviR.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalAsiaDMX < 0 ? "negative-value" : "positive-value")"><strong>@totalAsiaDMX.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalAsiaDMR < 0 ? "negative-value" : "positive-value")"><strong>@totalAsiaDMR.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalAvrasyaX < 0 ? "negative-value" : "positive-value")"><strong>@totalAvrasyaX.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalAvrasyaR < 0 ? "negative-value" : "positive-value")"><strong>@totalAvrasyaR.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalDafKimyaX < 0 ? "negative-value" : "positive-value")"><strong>@totalDafKimyaX.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td class="@(totalDafKimyaR < 0 ? "negative-value" : "positive-value")"><strong>@totalDafKimyaR.ToString("N2", CultureInfo.CurrentCulture)</strong></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="text-center mt-2" id="total-records-info">
            Toplam Kayıt: <strong>@ViewBag.TotalRecords</strong>
        </div>
    }
    else
    {
        <p>Gösterilecek veri bulunamadı.</p>
    }
</div>

<div>
    <a asp-action="Index" asp-controller="Home">Ana Sayfaya Dön</a>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Function to show alerts (kept for consistency, though currently not used in this specific view)
            function showAlert(message, type) {
                const alertContainer = document.getElementById('alertContainer');
                if (!alertContainer) return;

                const alertDiv = document.createElement('div');
                alertDiv.classList.add('alert', `alert-${type}`, 'alert-dismissible', 'fade');
                alertDiv.setAttribute('role', 'alert');
                alertDiv.innerHTML = `
                                             ${message}
                                             <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                                         `;
                alertContainer.innerHTML = '';
                alertContainer.appendChild(alertDiv);

                setTimeout(() => {
                    alertDiv.classList.add('show');
                }, 10);

                setTimeout(() => {
                    const bootstrapAlert = bootstrap.Alert.getInstance(alertDiv);
                    if (bootstrapAlert) {
                        bootstrapAlert.dispose();
                    } else {
                        alertDiv.remove();
                    }
                }, 5000);
            }
        });
    </script>
}