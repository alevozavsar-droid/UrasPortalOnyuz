@model WebApplication3.Controllers.R123_DekontViewModel
@{
    Layout = null; 
    int transId = ViewBag.TransId;
    string pBirimiVal = Model.ParaBirimi;
    string pBirimiGosterim = pBirimiVal == "TRY" ? "₺" : (pBirimiVal == "USD" ? "$" : (pBirimiVal == "EUR" ? "€" : pBirimiVal));
}

<style>
    /* Modern ve daha kompakt PDF stili */
    .pdf-dekont-wrapper {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #334155;
        background-color: #fff;
        font-size: 12px;
        width: 700px; /* Daha kompakt genişlik */
        margin: 0 auto;
        padding: 25px 20px;
        box-sizing: border-box;
    }
    
    .pdf-table-layout {
        width: 100%;
        border-collapse: collapse;
    }

    .header-section {
        margin-bottom: 25px;
        border-bottom: 2px solid #cbd5e1;
        padding-bottom: 12px;
    }

    .title-text {
        margin: 0;
        font-size: 20px;
        color: #0f172a;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .info-text {
        text-align: right;
        color: #64748b;
        font-size: 11px;
        line-height: 1.5;
    }

    .details-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 30px;
    }

    .details-table td {
        padding: 12px;
        border: 1px solid #e2e8f0;
        vertical-align: middle;
    }

    .details-table .label {
        background-color: #f8fafc;
        font-weight: 600;
        color: #475569;
        width: 130px;
    }

    .details-table .tutar-value {
        font-size: 16px;
        font-weight: bold;
        color: #0f172a;
    }

    .signature-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
    }

    .signature-table td {
        width: 33.33%;
        border: 1px solid #e2e8f0;
        text-align: center;
    }

    .signature-table .sig-header {
        background-color: #f8fafc;
        padding: 8px;
        font-size: 11px;
        font-weight: 600;
        color: #475569;
        text-transform: uppercase;
        border-bottom: 1px solid #e2e8f0;
    }

    .signature-table .sig-box {
        height: 75px; /* İmza alanı küçültüldü */
    }

    .footer-text {
        text-align: center;
        font-size: 10px;
        color: #94a3b8;
        margin-top: 15px;
    }
</style>

<div class="pdf-dekont-wrapper">
    <table class="pdf-table-layout header-section">
        <tr>
            <td style="vertical-align: middle;">
                <h2 class="title-text">ÖDEME DEKONTU</h2>
            </td>
            <td class="info-text">
                <strong>İşlem No:</strong> #@transId<br/>
                <strong>Tarih:</strong> @Model.IslemTarihi.ToString("dd.MM.yyyy")
            </td>
        </tr>
    </table>

    <table class="details-table">
        <tr>
            <td class="label">Tutar</td>
            <td class="tutar-value">@Model.Tutar.ToString("N2") @pBirimiGosterim</td>
        </tr>
        <tr>
            <td class="label">Açıklama</td>
            <td style="color: #334155;">@Model.Aciklama</td>
        </tr>
        <tr>
            <td class="label">İlgili Cari / Hesap</td>
            <td style="color: #334155;">
                <strong>@Model.KarsiHesapKodu</strong> - @Model.KarsiHesapAdi
            </td>
        </tr>
    </table>

    <table class="signature-table">
        <tr>
            <td class="sig-header">TESLİM ALAN</td>
            <td class="sig-header">ÖN ONAY</td>
            <td class="sig-header">ONAY</td>
        </tr>
        <tr>
            <td class="sig-box"></td>
            <td class="sig-box"></td>
            <td class="sig-box"></td>
        </tr>
    </table>

    <div class="footer-text">
        Bu dekont, SAP sisteminden otomatik olarak oluşturulmuştur. İşlem No: #@transId | Yazdırılma Tarihi: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")
    </div>
</div>