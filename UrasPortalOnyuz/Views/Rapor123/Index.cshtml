@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    
    <script>
        // TOPLU MADDE LİSTESİ ARRAY'İ
        var eklenecekMaddeler = [];

        $(document).ready(function () {
            
            // DataTables Entegrasyonu
            $('.datatable').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json' },
                pageLength: 50,
                order: [], 
                responsive: true,
                dom: "<'row mb-3'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row mt-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });

            // ---- Firma ve hesap/banka süzmesi (IT talebi #13) ---------------
            // Eşleştirme satırdaki data- alanlarıyla TAM yapılır. Kolon metninde
            // arama yapılsaydı bir hesap kodu bir başkasının başlangıcı olduğunda
            // (102.01.1 / 102.01.10) fazladan satır gelirdi. Hesap seçeneğinin
            // değeri "ŞİRKET|KOD" çiftidir: aynı hesap kodu birden fazla şirkette
            // bulunabiliyor.
            (function () {
                var tabloEl = document.getElementById('anaHareketTablosu');
                if (!tabloEl) return;

                var firmaSecim = document.getElementById('firmaFiltre');
                var bankaSecim = document.getElementById('bankaFiltre');
                if (!firmaSecim && !bankaSecim) return;

                var tablo = $(tabloEl).DataTable();
                var ozet = document.getElementById('filtreOzeti');

                $.fn.dataTable.ext.search.push(function (ayarlar, veri, indeks) {
                    if (!ayarlar.nTable || ayarlar.nTable.id !== 'anaHareketTablosu') return true;

                    var satir = ayarlar.aoData[indeks] ? ayarlar.aoData[indeks].nTr : null;
                    if (!satir) return true;

                    var firma = firmaSecim ? (firmaSecim.value || '') : '';
                    if (firma && satir.getAttribute('data-sirket') !== firma) return false;

                    var hesap = bankaSecim ? (bankaSecim.value || '') : '';
                    if (hesap) {
                        var satirAnahtar = satir.getAttribute('data-sirket') + '|' + satir.getAttribute('data-banka');
                        if (satirAnahtar !== hesap) return false;
                    }
                    return true;
                });

                // Firma seçilince hesap listesi o firmanınkilere iner.
                function hesapListesiniDuzenle() {
                    if (!bankaSecim) return;
                    var firma = firmaSecim ? (firmaSecim.value || '') : '';

                    Array.prototype.forEach.call(bankaSecim.options, function (o) {
                        if (!o.value) { o.hidden = false; return; }
                        var uygun = !firma || o.dataset.sirket === firma;
                        o.hidden = !uygun;
                        // Bazi tarayicilar option[hidden] kuralini uygulamiyor;
                        // secilemez yapmak garanti olsun.
                        o.disabled = !uygun;
                    });

                    // Seçili hesap artık firmaya uymuyorsa seçimi bırak.
                    var seciliSecenek = bankaSecim.selectedOptions[0];
                    if (seciliSecenek && seciliSecenek.hidden) bankaSecim.value = '';
                }

                function uygula() {
                    hesapListesiniDuzenle();
                    tablo.draw();

                    var suzuluyor = (firmaSecim && firmaSecim.value) || (bankaSecim && bankaSecim.value);
                    if (suzuluyor) { tabloEl.classList.add('banka-suzuldu'); }
                    else { tabloEl.classList.remove('banka-suzuldu'); }

                    if (ozet) {
                        if (!suzuluyor) { ozet.textContent = ''; }
                        else {
                            var gorunen = tablo.rows({ search: 'applied' }).count();
                            var toplam = tablo.rows().count();
                            ozet.textContent = gorunen + ' / ' + toplam + ' işlem gösteriliyor';
                        }
                    }
                }

                if (firmaSecim) firmaSecim.addEventListener('change', uygula);
                if (bankaSecim) bankaSecim.addEventListener('change', uygula);

                var temizle = document.getElementById('bankaFiltreTemizle');
                if (temizle) {
                    temizle.addEventListener('click', function () {
                        if (firmaSecim) firmaSecim.value = '';
                        if (bankaSecim) bankaSecim.value = '';
                        uygula();
                    });
                }

                // Seçim sayfa yenilense de kaybolmasın (aynı hesap tipi/sekme için)
                var anahtar = 'r123_filtre_' + '@currentHesapTipi' + '_' + '@currentTab';
                try {
                    var kayitli = JSON.parse(sessionStorage.getItem(anahtar) || '{}');
                    if (firmaSecim && kayitli.firma && firmaSecim.querySelector('option[value="' + kayitli.firma + '"]')) {
                        firmaSecim.value = kayitli.firma;
                    }
                    hesapListesiniDuzenle();
                    if (bankaSecim && kayitli.hesap) {
                        var o = bankaSecim.querySelector('option[value="' + kayitli.hesap + '"]');
                        if (o && !o.hidden) bankaSecim.value = kayitli.hesap;
                    }
                    if ((firmaSecim && firmaSecim.value) || (bankaSecim && bankaSecim.value)) uygula();

                    function kaydet() {
                        sessionStorage.setItem(anahtar, JSON.stringify({
                            firma: firmaSecim ? firmaSecim.value : '',
                            hesap: bankaSecim ? bankaSecim.value : ''
                        }));
                    }
                    if (firmaSecim) firmaSecim.addEventListener('change', kaydet);
                    if (bankaSecim) bankaSecim.addEventListener('change', kaydet);
                } catch (e) { /* sessionStorage kapalıysa önemli değil */ }
            })();

            $('#pageDbSelect').change(function() {
                var dbKey = $(this).val();
                document.cookie = "SelectedDatabase_128=" + dbKey + "; path=/; max-age=" + (30 * 24 * 60 * 60);
                document.cookie = "SelectedDatabase=" + dbKey + "; path=/; max-age=" + (30 * 24 * 60 * 60); 
                $('#formDb').val(dbKey);
                $('#filterForm').submit();
            });

            $('.select2-modal').select2({ theme: "bootstrap-5", width: '100%', dropdownParent: $('#yevmiyeModal') });
            
            // Eksik Bildirim Email Multi-Select
            $('#eksikEmails').select2({
                theme: "bootstrap-5",
                width: '100%',
                dropdownParent: $('#eksikBildirModal'),
                placeholder: "Mail Adresi Seçiniz...",
                allowClear: true
            });

            // GÜNCELLEME: Enter tuşu ile veya toplu yapıştırma ile madde ekleme
            $('#yeniMaddeInput').on('keypress', function(e) {
                if(e.which === 13) {
                    e.preventDefault();
                    maddeEkle();
                }
            });

            onKarsiTurChanged();

            $('.modern-select2').select2({
                dropdownParent: $('#sapAktarModal'),
                placeholder: "Kod veya Ad ile arama yapın...",
                allowClear: true
            });

            $('.cari-select2').select2({
                dropdownParent: $('#sapAktarModal'),
                placeholder: "Cari Kod veya Unvan ile arama yapın...",
                allowClear: true,
                ajax: {
                    url: function() { return '/Rapor123/AraCari?db=' + $('#modalDbKey').val(); },
                    dataType: 'json',
                    delay: 250,
                    data: function (params) { return { q: params.term }; },
                    processResults: function (data) { return { results: data.results }; },
                    cache: true
                }
            });

            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
              return new bootstrap.Tooltip(tooltipTriggerEl)
            });

            $('#kasaSelect').on('change', function() {
                var curr = $(this).find(':selected').data('currency');
                if (!curr || curr === '##') curr = 'TRY';
                $('#hiddenCurrency').val(curr); 

                var symbol = '₺';
                if (curr === 'USD') symbol = '$'; else if (curr === 'EUR') symbol = '€'; else if (curr === 'GBP') symbol = '£'; else if (curr !== 'TRY') symbol = curr;
                $('#currencySymbol').text(symbol);
            });

            @if (ViewBag.PrintDekontId != null)
            {
                var activeDbKey = Context.Request.Query["db"].ToString();
                if (string.IsNullOrEmpty(activeDbKey)) {
                    activeDbKey = Context.Request.Cookies["SelectedDatabase"] ?? "DefaultConnection";
                }

                <text>
                setTimeout(function() {
                    downloadPDF('@activeDbKey', '@ViewBag.PrintDekontId', '@ViewBag.PrintDekontType');
                }, 500); 
                </text>
            }
        });

        function setDate(type) {
            let start = new Date();
            let end = new Date();

            if (type === 'week') {
                let day = start.getDay() || 7; 
                start.setDate(start.getDate() - day + 1);
            } else if (type === 'month') {
                start.setDate(1);
            }

            document.getElementById('startDate').value = start.toISOString().split('T')[0];
            document.getElementById('endDate').value = end.toISOString().split('T')[0];
            document.getElementById('filterForm').submit();
        }

        function switchReport(hesapTipi, tabName) {
            document.getElementById('hesapInput').value = hesapTipi;
            document.getElementById('tabInput').value = tabName;
            document.getElementById('filterForm').submit();
        }

        function switchCompany(dbKey) {
            document.getElementById('dbFilterInput').value = dbKey;
            document.getElementById('filterForm').submit();
        }

        // OTOMATİK SAYFA YENİLEME VE ONAY GÜNCELLEMESİ
        function submitOnayDurumu(dbKey, islemNo, hesapTipi, durum, baslik, icerik, emailArr = null, autoReload = true) {
            var tabTipi = document.getElementById('tabInput').value;
            var data = { 
                DbKey: dbKey, 
                IslemNo: islemNo, 
                HesapTipi: hesapTipi, 
                TabTipi: tabTipi,
                Durum: durum, 
                NotBasligi: baslik, 
                NotIcerigi: icerik, 
                GonderilecekEmails: emailArr 
            };

            fetch('/Rapor123/SetOnayDurumu', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            }).then(async response => {
                if (!response.ok) { const errText = await response.text(); throw new Error("HTTP " + response.status + " - " + errText); }
                return response.json();
            }).then(result => {
                if (result.success) { 
                    if(autoReload) {
                        toastr.success(result.message); 
                        setTimeout(() => location.reload(), 1000); 
                    }
                } 
                else alert("İşlem Başarısız!\n\nNeden: " + result.message);
            }).catch(error => {
                console.error('Fetch Error:', error);
                alert("Teknik bir sorun oluştu ve işlem tamamlanamadı.\n\nDetay: " + error.message);
            });
        }

        // ==========================================
        // EKSİK / MANUEL İŞLEM (TOPLU MADDE EKLEME)
        // ==========================================
        var eksikModalElement;

        function openEksikModal(dbKey, islemNo, hesapTipi) {
            if(dbKey === 'TUMU') {
                toastr.warning("Lütfen işlem yapmak için sol üstteki filtreden ilgili şirketi seçiniz!");
                return;
            }

            document.getElementById('eksikDbKey').value = dbKey;
            document.getElementById('eksikIslemNo').value = islemNo;
            document.getElementById('eksikHesapTipi').value = hesapTipi;
            
            $('#eksikEmails').val(null).trigger('change');
            document.getElementById('eksikNotBasligi').value = "";
            document.getElementById('eksikNotIcerigi').value = "";
            
            // Maddeleri sıfırla
            eklenecekMaddeler = [];
            document.getElementById('yeniMaddeInput').value = "";
            renderMaddeler();

            if (!eksikModalElement) eksikModalElement = new bootstrap.Modal(document.getElementById('eksikBildirModal'));
            eksikModalElement.show();
        }

        // GÜNCELLEME: Maddelerin tek kelime değil, listeye çoklu veya satır satır girmesi için ayarlandı
        function maddeEkle() {
            var input = document.getElementById('yeniMaddeInput');
            var val = input.value.trim();
            if (val !== "") {
                // Eğer kullanıcı kopyala yapıştır yaparsa satırlara bölüp ekle
                var lines = val.split('\n');
                lines.forEach(function(line) {
                    var cleanLine = line.trim();
                    if(cleanLine !== "") eklenecekMaddeler.push(cleanLine);
                });
                input.value = "";
                renderMaddeler();
            }
        }

        function maddeSil(index) {
            eklenecekMaddeler.splice(index, 1);
            renderMaddeler();
        }

        function renderMaddeler() {
            var ul = document.getElementById('maddeListesi');
            if (eklenecekMaddeler.length === 0) {
                ul.style.display = "none";
                ul.innerHTML = "";
            } else {
                ul.style.display = "block";
                var html = "";
                for (var i = 0; i < eklenecekMaddeler.length; i++) {
                    html += `<li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3" style="font-size: 0.85rem;">
                                <span><i class="fas fa-check-circle text-success me-2"></i>${eklenecekMaddeler[i]}</span>
                                <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="maddeSil(${i})"><i class="fas fa-times"></i></button>
                             </li>`;
                }
                ul.innerHTML = html;
            }
        }

        function kaydetEksik() {
            var btn = document.getElementById("btnBildirGonder");
            var originalText = btn.innerHTML;

            var dbKey = document.getElementById('eksikDbKey').value;
            var islemNo = parseInt(document.getElementById('eksikIslemNo').value);
            var hesapTipi = document.getElementById('eksikHesapTipi').value;
            var tabTipi = document.getElementById('tabInput').value;
            var emailsArray = $('#eksikEmails').val() || [];
            var emails = emailsArray.join(',');
            var baslik = document.getElementById('eksikNotBasligi').value;
            var icerik = document.getElementById('eksikNotIcerigi').value;

            if (!baslik || baslik.trim() === "") { toastr.warning("Lütfen kısa bir eksik başlığı giriniz."); return; }
            if (islemNo <= 0 && (!emailsArray || emailsArray.length === 0)) { toastr.warning("Sistemde olmayan (Manuel) kayıtlar için en az bir Mail Adresi seçilmesi zorunludur!"); return; }

            btn.innerHTML = 'Gönderiliyor...';
            btn.disabled = true;

            // Yeni Tabloya JSON ve Mail atılması için gönder
            var payloadEksik = {
                Bolum: hesapTipi,
                SirketDb: dbKey,
                IslemNo: islemNo,
                TabTipi: tabTipi,
                AliciMailler: emails,
                Baslik: baslik,
                Aciklama: icerik,
                Maddeler: eklenecekMaddeler
            };

            fetch('/Rapor123/EksikBildirimKaydet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payloadEksik)
            }).then(r => r.json()).then(res => {
                if(res.success) {
                    toastr.success("Bildirimler başarıyla iletildi.");
                    setTimeout(() => location.reload(), 1000); 
                } else {
                    toastr.error(res.message);
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            }).catch(e => {
                toastr.error("Sunucuya bağlanılamadı.");
                btn.innerHTML = originalText;
                btn.disabled = false;
            });
        }

        // ==========================================
        // BEKLEYEN TALEPLER (TAMAMLA) EKRANI
        // ==========================================
        function eksikListesiGoster() {
            var sirketDb = document.getElementById('dbFilterInput').value;
            if(sirketDb === 'TUMU') {
                toastr.warning("Lütfen bekleyen talepleri görmek için sol üstteki filtreden ilgili şirketi seçiniz!");
                return;
            }

            var modal = new bootstrap.Modal(document.getElementById('eksikListesiModal'));
            modal.show();
            
            var container = document.getElementById('eksikListesiContainer');
            container.innerHTML = '<div class="text-center py-5 text-muted"><i class="fas fa-spinner fa-spin fa-2x mb-3"></i><br/>Veriler Yükleniyor...</div>';
            
            var bolum = document.getElementById('hesapInput').value;
            
            fetch('/Rapor123/EksikBildirimleriGetir?bolum=' + bolum + '&sirketDb=' + sirketDb)
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    if(data.data.length === 0) {
                        container.innerHTML = '<div class="alert alert-info text-center m-3 p-4"><i class="fas fa-check-circle fa-2x mb-2 text-success"></i><br/>Bu bölüme ait bekleyen talebiniz bulunmamaktadır.</div>';
                        return;
                    }
                    var html = '<div class="row g-3">';
                    data.data.forEach(item => {
                        var isCompleted = item.durum === 'Tamamlandi';
                        var bgClass = isCompleted ? 'bg-success bg-opacity-10 border-success border-opacity-25' : 'bg-white border-warning border-opacity-50';
                        var iconClass = isCompleted ? 'fa-check-circle text-success' : 'fa-clock text-warning';
                        var shadowClass = isCompleted ? '' : 'shadow-sm';
                        
                        var maddelerHtml = '';
                        if(item.maddeler && item.maddeler.length > 0) {
                            maddelerHtml = '<hr class="my-2 text-secondary"><ul class="mb-2 ps-3 small text-secondary" style="list-style-type:circle;">';
                            item.maddeler.forEach(m => { maddelerHtml += `<li>${m}</li>`; });
                            maddelerHtml += '</ul>';
                        }
                        
                        html += `
                        <div class="col-md-6 col-lg-4">
                            <div class="card ${bgClass} ${shadowClass} h-100 border rounded">
                                <div class="card-body p-3 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="card-title mb-0 fw-bold text-dark" style="font-size:0.95rem;">${item.baslik}</h6>
                                    </div>
                                    <div class="mb-2"><span class="badge ${isCompleted ? 'bg-success' : 'bg-warning text-dark'}"><i class="fas ${iconClass} me-1"></i>${item.durum}</span></div>
                                    
                                    <div class="small text-muted mb-2">
                                        <i class="fas fa-user me-1"></i>${item.gonderenKullanici} <br/>
                                        <i class="fas fa-calendar-alt me-1"></i>Oluşturma: ${item.kayitTarihi}
                                        ${isCompleted ? `<br/><i class="fas fa-check-double me-1 text-success"></i>Tamamlanma: ${item.tamamlanmaTarihi}` : ''}
                                    </div>
                                    
                                    <p class="card-text small mb-2 text-dark flex-grow-1">${item.aciklama}</p>
                                    ${maddelerHtml}
                                </div>
                                ${!isCompleted && @(isAuthorized.ToString().ToLower()) ? `
                                <div class="card-footer bg-transparent border-top-0 pt-0 text-end">
                                    <button class="btn btn-sm btn-success fw-bold w-100" onclick="talepTamamla(${item.id})"><i class="fas fa-check me-1"></i>Yapıldı İşaretle</button>
                                </div>` : ''}
                            </div>
                        </div>`;
                    });
                    html += '</div>';
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<div class="alert alert-danger m-3">' + data.message + '</div>';
                }
            }).catch(e => {
                container.innerHTML = '<div class="alert alert-danger m-3">Veriler yüklenemedi. ' + e.message + '</div>';
            });
        }

        function talepTamamla(id) {
            if(!confirm('Bu talebi tamamlandı olarak işaretlemek istediğinize emin misiniz?')) return;
            fetch('/Rapor123/EksikBildirimTamamla/' + id, { method: 'POST' })
