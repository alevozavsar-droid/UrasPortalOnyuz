@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sirketler = (List<KeyValuePair<string, string>>)ViewBag.Sirketler;
    string varsayilan = (string)ViewBag.VarsayilanSirket ?? "";
    string bas = (string)ViewBag.Bas, bit = (string)ViewBag.Bit, sekme = (string)ViewBag.Sekme ?? "ozet";
    var sekmeler = new[] { ("ozet", "Durum Özeti", "fa-gauge-high"), ("finekra", "Finekra · Banka Hareketleri", "fa-building-columns"), ("kasa", "Kasa", "fa-cash-register"), ("cek", "Çek · Senet", "fa-money-check-alt"), ("eslesme", "Nakit Akış Eşleşme", "fa-link"), ("duzenli", "Düzenli Ödemeler", "fa-calendar-check"), ("gunsonu", "Gün Sonu Mutabakatı", "fa-clipboard-check"), ("bakiye", "Bakiyeler", "fa-scale-balanced"), ("gunluk", "Günlük", "fa-clock-rotate-left") };
}
@*
    KONSOLİDE FİNANSAL TAKİP PANELİ (Rapor123) — Kasa Nakit Akışı tasarım dili (na-* ortak stil, kn/tp düzeni). Veri /Rapor123/Veri; betik wwwroot/js/takip-paneli.js.
    Durum Özeti sekmesi (varsayılan): üst kartlar yerine tablo düzeninde durum göstergeleri (satıra tıklayınca ilgili sekme süzülür), şirket bazında durum, bugün ödenecek / gecikmiş ödemeler
    (banka hareketi var mı, SAP'ye işlendi mi; "Ödeme Ekle" ile eksik gün içi ödeme nakit akışa yazılır), vadesi gelen planlı çek / senetler ("Tedarikçiye Çık"), senkron bilgisi.
    Finekra sekmesi: bankadan otomatik akan hareketler (Data/FinekraOrnek.cs) — Kasa Nakit Akışı talimatı bankaya iletilince hareket otomatik düşer → "SAP'ye İşle" (cari / hesap / fatura seç; öneri otomatik) → muhasebe fişi;
    her hareket Kasa Nakit Akışı ile eşlenir (otomatik / elle); nakit akışta karşılığı olmayan çıkış "Nakit Akışa Gönder" ile ÖDENDİ satır olur. Kasa hareketleri nakit akış ödemelerinden (+ elden ödenmiş, nakit akışta olmayan masraflar), Çek hareketleri Çek Akıbeti kaydından
    (plan ↔ ibraz kontrolü). Kasa ve Çek sekmelerinde "Satır Kaynağı · İşlem" sütunu: satır nereden geldi (Kasa Nakit Akışı / Kasa Fişi elden ödeme · tahsilat / Çek Akıbeti portföy girişi · ciro · ibraz / Dolaşım Planı adımı)
    ve kaynağa göre yapılacak iş: elden ödenmiş kasa çıkışı ya da planlanmamış portföy belgesi → "Nakit Akışa Ekle" (kasa çıkışı ÖDENDİ nakit satırı olur ve hareketle eşlenir; belge tedarikçiye planlanır), planlı belge → "İbraz Et · Tedarikçiye Çık"
    (plan satırı üzerinden ciro / bankaya ibraz; plansız belgede "İbraz Et" GMY onayına düşer). "Kasa Nakit Akışı Eşleşmesi" sütunu: Var (#satır) / Yok.
    Süzgeç: Onay Durumu › Nakit Akışta Yok / Var. Eski görünüm: /Rapor123/Eski. Derin bağlantı: /Rapor123?sirket=URASKIMYA&bas=&bit=&sekme=kasa
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<style>
    .na.tp { --na-k: #1d4ed8; }
    .tp-pill { font-size: .66rem; font-weight: 700; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 3px 10px; } a.tp-pill { text-decoration: none; } a.tp-pill:hover { background: #e0f2fe; color: #0c4a6e; border-color: #bae6fd; }
    #tp .na-panel .table-responsive { overflow: visible !important; } .table-container:has(#tp) { overflow: visible !important; }
    /* ortak başlık düzenli geniş tablolar (Banka / Kasa / Çek · Senet): tablo en az sütun toplamı kadar geniş, kart içinde yatay kayar */
    #tp .na-panel[data-p="finekra"] .table-responsive, #tp .na-panel[data-p="kasa"] .table-responsive, #tp .na-panel[data-p="cek"] .table-responsive { overflow-x: auto !important; overflow-y: visible; }
    /* yatay kayan kapta yapışkan başlık kabın içine takılır (satırların üstüne biner) → bu üç tabloda başlık normal akışta */
    #tp .na-panel[data-p="finekra"] .tp-tablo thead th, #tp .na-panel[data-p="kasa"] .tp-tablo thead th, #tp .na-panel[data-p="cek"] .tp-tablo thead th { position: static !important; }
    .tp-dol { white-space: nowrap; } .tp-dol i { font-size: .5rem; color: #94a3b8; margin: 0 1px; } .tp-dol .ok { color: #15803d; font-weight: 700; } .tp-dol .plan { color: #64748b; }
    #tp .na-panel > .na-kart > .na-kart-b { position: sticky; top: var(--tp-sabit-ust, 0px); z-index: 7; }
    #tp .na-panel .tp-tablo thead th { position: sticky; top: calc(var(--tp-sabit-ust, 0px) + var(--tp-kartb, 31px)); z-index: 6; background: #f8fafc; box-shadow: 0 1px 0 #e2e8f0; }
    .tp-filtre { display: grid; grid-template-columns: 1.2fr .9fr .9fr .9fr 1.8fr auto; gap: 6px 8px; align-items: end; }
    .tp-filtre label { display: block; font-size: .58rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 2px; }
    .tp-filtre .form-control, .tp-filtre .form-select { font-size: .72rem; padding: 3px 7px; height: 28px; }
    .tp-hizli { display: flex; gap: 4px; } .tp-hizli button { font-size: .62rem; padding: 2px 7px; }
    @@media (max-width: 1200px) { .tp-filtre { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    #tp .na-sekme { flex-wrap: nowrap; gap: 0; } #tp .na-sekme button { flex: 1 1 auto; white-space: nowrap; padding: 7px 6px; font-size: .74rem; text-align: center; min-width: 0; overflow: hidden; } #tp .na-sekme button .n { font-size: .6rem; padding: 0 5px; margin-left: 4px; }
    @@media (max-width: 1400px) { #tp .na-sekme button { font-size: .66rem; padding: 6px 4px; } #tp .na-sekme button i { display: none; } }
    /* Durum Özeti: kutucuk yerine tablo düzeni — gösterge satırları (tıklanınca sekme süzülür), şirket matrisi, ödeme ve çek iş listeleri */
    .tp-ozet-iki { display: grid; grid-template-columns: 1.05fr 1.6fr; gap: 8px; align-items: start; } @@media (max-width: 1400px) { .tp-ozet-iki { grid-template-columns: 1fr; } }
    #tp .tp-ozet { table-layout: fixed; } #tp .tp-ozet td { white-space: normal; line-height: 1.25; vertical-align: middle; } #tp .tp-ozet tr.tik td { cursor: pointer; } #tp .tp-ozet tr.aktif td { background: #eff6ff; box-shadow: inset 2px 0 0 var(--k, #1d4ed8); }
    #tp .tp-ozet td.gost { font-weight: 700; color: #0f172a; border-left: 3px solid var(--k, #cbd5e1); } #tp .tp-ozet td.gost small { font-weight: 500; } #tp .tp-ozet td.adet { font-size: .9rem; font-weight: 800; text-align: right; font-variant-numeric: tabular-nums; } #tp .tp-ozet td.adet.sifir { color: #94a3b8; font-weight: 600; }
    #tp .tp-ozet tr.grup td { background: #f1f5f9; font-size: .56rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: #475569; padding: 2px 6px; }
    #tp .tp-ozet-sirket td, #tp .tp-ozet-sirket th { text-align: center; } #tp .tp-ozet-sirket td:first-child, #tp .tp-ozet-sirket th:first-child { text-align: left; } #tp .tp-ozet-sirket td.u { color: #b45309; font-weight: 800; } #tp .tp-ozet-sirket td.h { color: #b91c1c; font-weight: 800; } #tp .tp-ozet-sirket td.o { color: #15803d; }
    .tp-senk { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: .64rem; color: #475569; align-items: center; } .tp-senk b { color: #0f172a; } .tp-senk a { font-weight: 700; }
    .tp-fat { font-size: .68rem; } .tp-fat td, .tp-fat th { padding: 3px 6px; white-space: nowrap; } .tp-fat tr.oneri td { background: #f0fdf4; } .tp-fat tr.tik { cursor: pointer; }
    #tp .tp-tablo { font-size: .68rem; table-layout: fixed; width: 100%; }
    /* hiza: her sütunun başlığı ve hücreleri aynı yönde (sol metin · sağ tutar · orta sıra / tarih / rozet) — tabloKur sütun başına üretilen stille sabitler; satırlar ince çizgiyle ayrılır, hücre içi iki satır (ana + küçük) */
    #tp .tp-tablo th { font-size: .56rem; padding: 5px 6px; white-space: normal; line-height: 1.15; vertical-align: middle; overflow: hidden; }
    #tp .tp-tablo td { padding: 4px 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; vertical-align: middle; line-height: 1.2; border-bottom: 1px solid #e2e8f0; }
    #tp .tp-tablo td.sol { text-align: left !important; } #tp .tp-tablo td.wrap { white-space: normal; line-height: 1.25; } #tp .tp-tablo td.para { font-variant-numeric: tabular-nums; font-weight: 700; text-align: right !important; } #tp .tp-tablo td.kurum { font-weight: 700; color: #0f172a; }
    #tp .tp-tablo td small { display: block; font-size: .58rem; color: #64748b; font-weight: 500; line-height: 1.15; margin-top: 1px; overflow: hidden; text-overflow: ellipsis; }
    #tp .tp-tablo td b { font-weight: 700; }
    #tp .tp-tablo tr.tik { cursor: pointer; } #tp .tp-tablo tr.tik:hover td { background: #eff6ff; }
    #tp .tp-tablo tr.giris td.para.g { color: #15803d; } #tp .tp-tablo tr.cikis td.para.c { color: #b91c1c; }
    #tp .tp-tablo tr.onayli td { background: #f0fdf4; } #tp .tp-tablo tr.eksik td { background: #fef2f2; } #tp .tp-tablo tr.bekliyor td { background: #fffbeb; }
    #tp .tp-tablo tr.toplam td { font-weight: 800; background: #f8fafc; border-top: 2px solid #1d4ed8; }
    #tp #tpBakiyeBanka, #tp #tpBildirimler, #tp #tpGunluk { table-layout: auto; } #tp #tpBakiyeKasa { table-layout: fixed; } #tp #tpBakiyeKasa td small { white-space: nowrap; }
    /* bakiyeler: özet kartları, alt toplam / grup satırları, X · R renkleri */
    .tp-bozet { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 6px; } .tp-bozet > div { background: #fff; border: 1px solid #e2e8f0; border-left: 3px solid var(--k, #94a3b8); border-radius: 8px; padding: 6px 9px; min-width: 0; }
    .tp-bozet .l { font-size: .56rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .tp-bozet .v { font-size: .86rem; font-weight: 800; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .tp-bozet .s { font-size: .58rem; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    @@media (max-width: 1500px) { .tp-bozet { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    #tp .tp-tablo tr.ara td { background: #f1f5f9; font-weight: 800; border-top: 1px solid #cbd5e1; } #tp .tp-tablo td.x { color: #1d4ed8; } #tp .tp-tablo td.r { color: #7c3aed; } #tp #tpBakiyeKasa td { white-space: nowrap; }
    /* paneldeki tüm durum rozetleri (ÖDENDİ / Planlandı / Gecikti …) küçük: ortak temanın .rt-durum (pill, .7rem) yerine .tp-onay boyutu */
    #tp .rt-durum { font-size: .56rem; font-weight: 800; padding: 1px 5px; border-radius: 4px; line-height: 1.3; gap: 3px; } #tp .rt-durum i { font-size: .5rem; }
    .tp-onay { display: inline-block; font-size: .56rem; font-weight: 800; border-radius: 4px; padding: 1px 5px; white-space: nowrap; } .tp-onay.bekliyor { background: #fef3c7; color: #92400e; } .tp-onay.onayli { background: #dcfce7; color: #166534; } .tp-onay.eksik { background: #fee2e2; color: #991b1b; }
    /* satır kaynağı rozeti (Kasa / Çek sekmeleri "Satır Kaynağı · İşlem"): kaynağa göre renk; altındaki işlem düğmesi */
    .tp-kyn { display: inline-block; font-size: .56rem; font-weight: 800; border-radius: 4px; padding: 1px 5px; white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis; } .tp-kyn.na { background: #dbeafe; color: #1e40af; } .tp-kyn.fis { background: #fef3c7; color: #92400e; } .tp-kyn.akibet { background: #ede9fe; color: #5b21b6; } .tp-kyn.dolasim { background: #ccfbf1; color: #115e59; } .tp-kyn.banka { background: #f1f5f9; color: #475569; } .tp-kyn.diger { background: #f1f5f9; color: #475569; }
    .tp-kyn-is { margin-top: 3px; white-space: nowrap; } .tp-kyn-is .btn-xs { font-size: .58rem; padding: 0 5px; }
    .tp-es { display: inline-block; font-size: .56rem; font-weight: 800; border-radius: 4px; padding: 1px 5px; white-space: nowrap; } .tp-es.var { background: #dbeafe; color: #1e40af; } .tp-es.yok { background: #fee2e2; color: #991b1b; } .tp-es.disi { background: #f1f5f9; color: #475569; } .tp-es.gonder { background: #ede9fe; color: #5b21b6; }
    .tp-tur { display: inline-block; font-size: .56rem; font-weight: 800; border-radius: 4px; padding: 1px 6px; color: #fff; white-space: nowrap; background: #64748b; }
    .tp-tur.havale { background: #1d4ed8; } .tp-tur.musteri, .tp-tur.pos { background: #15803d; } .tp-tur.cek { background: #0369a1; } .tp-tur.oto, .tp-tur.kira { background: #b45309; } .tp-tur.vergi { background: #9d174d; } .tp-tur.masraf, .tp-tur.kredi, .tp-tur.kart { background: #7c3aed; } .tp-tur.virman { background: #0f766e; }
    .tp-kontrol { display: inline-block; font-size: .56rem; font-weight: 800; border-radius: 999px; padding: 1px 6px; white-space: nowrap; } .tp-kontrol.uyumlu { background: #dcfce7; color: #166534; } .tp-kontrol.farkli { background: #fee2e2; color: #991b1b; } .tp-kontrol.bekliyor { background: #fef9c3; color: #854d0e; } .tp-kontrol.plansiz { background: #e0f2fe; color: #0c4a6e; }
    .tp-link { font-weight: 700; font-size: .63rem; color: #1d4ed8; cursor: pointer; text-decoration: none; } .tp-link:hover { text-decoration: underline; }
    .tp-akis { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; } .tp-akis > div { background: #fff; border: 1px solid #e2e8f0; border-left: 3px solid var(--k, #94a3b8); border-radius: 8px; padding: 6px 9px; } .tp-akis .l { font-size: .58rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: #64748b; } .tp-akis .v { font-size: .92rem; font-weight: 800; color: #0f172a; } .tp-akis .s { font-size: .62rem; color: #64748b; }
    #tp .tp-tablo .btn-xs { font-size: .6rem; padding: 1px 6px; line-height: 1.3; }
    .tp-drawer { position: fixed; top: 0; right: -760px; width: 720px; max-width: 96vw; height: 100vh; background: #fff; box-shadow: -8px 0 24px rgba(15,23,42,.18); z-index: 1060; transition: right .25s; overflow: auto; padding: 12px 14px; } .tp-drawer.acik { right: 0; }
    .main-content #tpDrawer { height: 100vh !important; max-height: 100vh !important; overflow: auto !important; }
    .tp-drawer-ust { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; position: sticky; top: 0; background: #fff; padding-bottom: 6px; border-bottom: 1px solid #e2e8f0; z-index: 2; flex-wrap: wrap; }
    .tp-perde { position: fixed; inset: 0; background: rgba(15,23,42,.35); z-index: 1055; display: none; } .tp-perde.acik { display: block; }
    .tp-aksiyon { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 8px; } .tp-aksiyon .btn { font-size: .64rem; padding: 2px 8px; }
    .tp-kalem td { font-size: .7rem; } .tp-modal .table { font-size: .7rem; } .tp-modal .table td, .tp-modal .table th { padding: 4px 6px; white-space: nowrap; }
    .tp-fis { font-size: .7rem; } .tp-fis td, .tp-fis th { padding: 3px 6px; }
    /* gün sonu mutabakatı: adımlar, şirket blokları, sayım */
    .tp-adimlar { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 8px; }
    .tp-adim { display: flex; gap: 8px; align-items: flex-start; background: #fff; border: 1px solid #e2e8f0; border-left: 3px solid #94a3b8; border-radius: 8px; padding: 6px 9px; } .tp-adim.ok { border-left-color: #16a34a; } .tp-adim.hata { border-left-color: #dc2626; }
    .tp-adim .n { width: 22px; height: 22px; border-radius: 50%; background: #e2e8f0; color: #334155; font-weight: 800; font-size: .7rem; display: flex; align-items: center; justify-content: center; flex: none; margin-top: 2px; } .tp-adim.ok .n { background: #16a34a; color: #fff; } .tp-adim.hata .n { background: #dc2626; color: #fff; }
    .tp-adim .l { font-size: .58rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; color: #64748b; } .tp-adim .k { font-size: .66rem; font-weight: 700; color: #0f172a; } .tp-adim .v { font-size: .84rem; font-weight: 800; color: #0f172a; } .tp-adim .s { font-size: .6rem; color: #64748b; }
    .tp-gs-blok { border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 8px; overflow: hidden; background: #fff; }
    .tp-gs-baslik { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; padding: 5px 8px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; font-size: .7rem; } .tp-gs-baslik small { color: #64748b; font-size: .6rem; font-weight: 500; } .tp-gs-baslik .adim { white-space: nowrap; } .tp-gs-baslik .btn-xs, .tp-gs-blok .na-uyari .btn-xs { font-size: .62rem; padding: 2px 8px; line-height: 1.3; }
    #tp .tp-gs { table-layout: fixed; margin: 0; } #tp .tp-gs td.kalan { background: #f0f9ff; } #tp .tp-gs tr.bilgi td { color: #64748b; } #tp .na-panel .tp-gs thead th { position: static !important; }
    .tp-sayim input { font-size: .7rem; padding: 2px 6px; height: 26px; } .tp-sayim td { vertical-align: middle; }
    @@media (max-width: 1200px) { .tp-adimlar { grid-template-columns: 1fr; } }
</style>
}

<div class="container-fluid py-3 na tp" id="tp" data-sirket="@varsayilan" data-bas="@bas" data-bit="@bit" data-sekme="@sekme">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-clipboard-check"></i></span>Konsolide Finansal Takip Paneli</h4>
        <span class="tp-pill" title="Kasa, banka ve çek hareketleri: nakit akış ödemeleri, çek akıbeti kayıtları"><i class="fas fa-layer-group me-1"></i>Kasa · Banka · Çek Hareketleri</span>
        <span class="tp-pill" title="Finekra: banka hareketleri otomatik akar; onaylanıp cari seçilince muhasebe kaydı oluşur; her hareket Kasa Nakit Akışı ile eşlenir"><i class="fas fa-sync-alt me-1"></i>Finekra → Banka Hareketleri · Onay → Muhasebe Fişi</span>
        <a class="tp-pill" href="/Rapor79" title="Kasa Nakit Akışı: ödeme planı; banka hareketleri buradaki satırlarla eşlenir"><i class="fas fa-money-bill-transfer me-1"></i>Kasa Nakit Akışı ↔ Eşleşme <i class="fas fa-arrow-up-right-from-square ms-1" style="font-size:.56rem"></i></a>
        <a class="tp-pill" href="/CekAkibeti" title="Çek Akıbeti Raporu"><i class="fas fa-money-check-alt me-1"></i>Çek Akıbeti <i class="fas fa-arrow-up-right-from-square ms-1" style="font-size:.56rem"></i></a>
        <div class="sag">
            <button type="button" class="btn btn-primary btn-sm" id="tpOdemeEkle" style="font-size:.7rem" title="Gün içinde yapılmış ama nakit akışta olmayan ödemeyi ya da yeni planı Kasa Nakit Akışı'na yaz"><i class="fas fa-plus me-1"></i>Ödeme Ekle</button>
            <button type="button" class="btn btn-light btn-sm border" id="tpYenile" style="font-size:.7rem" title="Finekra akışını ve listeleri yeniden oku"><i class="fas fa-rotate me-1"></i>Akışı Yenile</button>
            <button type="button" class="btn btn-light btn-sm border" id="tpExcel" style="font-size:.7rem"><i class="fas fa-file-excel me-1"></i>Excel</button>
            <a class="btn btn-light btn-sm border" href="/Rapor123/Eski" style="font-size:.7rem" title="Ana projedeki görünüm"><i class="fas fa-table me-1"></i>Eski Görünüm</a>
        </div>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>

    <div class="na-kart">
        <div class="na-kart-b"><span><i class="fas fa-filter me-1"></i>Filtreler</span><span class="d-flex gap-2 align-items-center"><span class="not" id="tpKapsam"></span><button type="button" class="btn btn-light btn-sm py-0" id="tpTemizle" style="font-size:.64rem">Temizle</button></span></div>
        <div class="na-kart-g">
            <div class="tp-filtre">
                <div><label>Şirket</label><select class="form-select" id="tpSirket"><option value="">Tümü (Konsolide)</option>@foreach (var s in sirketler) { <option value="@s.Key" selected="@(s.Key == varsayilan)">@s.Value</option> }</select></div>
                <div><label>Başlangıç</label><input type="date" class="form-control" id="tpBas" value="@bas" /></div>
                <div><label>Bitiş</label><input type="date" class="form-control" id="tpBit" value="@bit" /></div>
                <div><label>Onay Durumu</label><select class="form-select" id="tpDurum"><option value="">Tümü</option><option value="bekliyor">Onay Bekliyor</option><option value="onayli">Onaylandı</option><option value="eksik">Eksik / Kontrol</option><option value="sapYok">SAP'ye İşlenmemiş</option><option value="sapVar">SAP'ye İşlenmiş</option><option value="naYok">Nakit Akışta Yok</option><option value="naVar">Nakit Akışta Var</option></select></div>
                <div><label>Ara</label><input class="form-control" id="tpAra" placeholder="Karşı taraf, açıklama, referans, hareket no, çek no, fiş no…" /></div>
