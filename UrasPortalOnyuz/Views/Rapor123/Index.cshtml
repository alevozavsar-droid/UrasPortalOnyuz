        function downloadPDF(dbKey, transId, type) {
            var url = '/Rapor123/GenerateDekont/' + dbKey + '/' + transId + '?type=' + type;

            var tempDiv = document.createElement('div');
            tempDiv.style.position = 'fixed'; tempDiv.style.left = '0'; tempDiv.style.top = '0'; tempDiv.style.zIndex = '-1000';
            tempDiv.style.width = '800px'; tempDiv.style.background = '#ffffff';
            document.body.appendChild(tempDiv);

            fetch(url).then(response => response.text()).then(html => {
                tempDiv.innerHTML = html;
                var opt = {
                    margin: 10, filename: 'Dekont_' + transId + '.pdf', image: { type: 'jpeg', quality: 1 },
                    html2canvas: { scale: 2, useCORS: true, logging: false }, jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
                };
                var contentToPrint = tempDiv.querySelector('.pdf-dekont-wrapper') || tempDiv;
                html2pdf().set(opt).from(contentToPrint).save().then(() => document.body.removeChild(tempDiv));
            }).catch(err => { alert("Dekont indirilirken hata oluştu."); document.body.removeChild(tempDiv); });
        }

