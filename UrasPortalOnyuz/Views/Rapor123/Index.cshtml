        // ==========================================
        // YENİ FİNEKRA SAP AKTARIM SCRİPTLERİ
        // ==========================================
        var aktarModal;

        function filterSelectsByDb(modalId, dbKey) {
            $('#' + modalId + ' .filtered-db-select').each(function() {
                var selectElement = $(this);
                if (!selectElement.data('original-html')) { selectElement.data('original-html', selectElement.html()); }
                selectElement.html(selectElement.data('original-html'));
                selectElement.find('option').each(function() {
                    var optDb = $(this).attr('data-dbkey');
                    if (optDb && optDb !== dbKey) { $(this).remove(); }
                });
            });
            
            if(modalId === 'virmanModal') {
                var $virmanSelects = $('#virmanModal .select2-account');
                $virmanSelects.each(function() { if ($(this).hasClass("select2-hidden-accessible")) { $(this).select2('destroy'); } });
                $virmanSelects.select2({ dropdownParent: $('#virmanModal'), placeholder: 'Kod veya İsim ile Arayın...', allowClear: true, width: '100%' });
            }
            if(modalId === 'sapAktarModal') {
                var $sapSelects = $('#sapAktarModal .modern-select2');
                $sapSelects.each(function() { if ($(this).hasClass("select2-hidden-accessible")) { $(this).select2('destroy'); } });
                $sapSelects.select2({ dropdownParent: $('#sapAktarModal'), placeholder: "Kod veya Ad ile arama yapın...", allowClear: true, width: '100%' });
            }
        }

