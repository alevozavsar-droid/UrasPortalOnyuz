        function autoSelectKkegAccounts() {
            let islemTuru = document.getElementById('modalIslemTuru').value.toUpperCase();
            let aciklama = document.getElementById('modalAciklama').value.toUpperCase();
            let kdvRate = document.getElementById('selKdvRate').value; 
            
            let combinedText = islemTuru + " " + aciklama;
            
            const findBest = (selectId, keywords) => {
                let options = $(selectId + ' option');
                for(let i=0; i<options.length; i++) {
                    if(!options[i].value) continue;
                    let txt = options[i].text.toUpperCase();
                    if(keywords.every(k => txt.includes(k.toUpperCase()))) return options[i].value;
                }
                return null;
            };

            let val70 = null;
            if(combinedText.includes("HGS") || combinedText.includes("OGS")) {
                val70 = findBest('#selGider70', ['770', 'HGS']) || findBest('#selGider70', ['770', 'OGS']);
            }
            if(!val70) val70 = findBest('#selGider70', ['770', 'BİNEK']); 
            if(val70) $('#selGider70').val(val70).trigger('change');

            let val30 = findBest('#selKkeg30', ['689', 'KKEG', 'BİNEK']) || findBest('#selKkeg30', ['689', 'KKEG']);
            if(val30) $('#selKkeg30').val(val30).trigger('change');

            let valKdv70 = findBest('#selKdv70', ['191', '%' + kdvRate]) || findBest('#selKdv70', ['191', kdvRate + ' ORANLI']);
            if(valKdv70) $('#selKdv70').val(valKdv70).trigger('change');

            let valKdv30 = findBest('#selKdv30', ['689', 'YAPILMAYAN', 'KDV']) || findBest('#selKdv30', ['689', 'KDV']);
            if(valKdv30) $('#selKdv30').val(valKdv30).trigger('change');
        }

        function getAccountName(selectId, fallbackText) {
            var el = $(selectId);
            if (!el.val()) return fallbackText;
            var fullText = el.find("option:selected").text();
            var parts = fullText.split('-');
            if(parts.length > 1) { return parts.slice(1).join('-').trim(); }
            return fullText;
        }

        function calculateKkegPreview() {
            if(!document.getElementById('chkKkeg').checked) return;

            var tutar = parseFloat(document.getElementById('modalTutar').value);
            var isGider = (document.getElementById('modalIsGiris').value === "false");
            var kdvRate = parseFloat(document.getElementById('selKdvRate').value);
            
            var matrah = tutar / (1 + (kdvRate / 100));
            var kdv = tutar - matrah;

            var matrah70 = parseFloat((matrah * 0.70).toFixed(2));
            var matrah30 = parseFloat((matrah - matrah70).toFixed(2));

            var kdv70 = parseFloat((kdv * 0.70).toFixed(2));
            var kdv30 = parseFloat((kdv - kdv70).toFixed(2));

            var bBorc = !isGider ? tutar.toFixed(2) : "-";
            var bAlacak = isGider ? tutar.toFixed(2) : "-";

            var g70Borc = isGider ? matrah70.toFixed(2) : "-";
            var g70Alacak = !isGider ? matrah70.toFixed(2) : "-";

            var g30Borc = isGider ? matrah30.toFixed(2) : "-";
            var g30Alacak = !isGider ? matrah30.toFixed(2) : "-";

            var k70Borc = (isGider && kdv70 > 0) ? kdv70.toFixed(2) : "-";
            var k70Alacak = (!isGider && kdv70 > 0) ? kdv70.toFixed(2) : "-";

            var k30Borc = (isGider && kdv30 > 0) ? kdv30.toFixed(2) : "-";
            var k30Alacak = (!isGider && kdv30 > 0) ? kdv30.toFixed(2) : "-";

            var bankaHesabi = $('#selBankaHesabi').val() || "SEÇİLMEDİ";
            var g70Hsp = $('#selGider70').val() || "SEÇİLMEDİ";
            var g30Hsp = $('#selKkeg30').val() || "SEÇİLMEDİ";
            var k70Hsp = $('#selKdv70').val() || "SEÇİLMEDİ";
            var k30Hsp = $('#selKdv30').val() || "SEÇİLMEDİ";

            var bankaAd = getAccountName('#selBankaHesabi', 'Banka Çıkışı/Girişi');
            var g70Ad = getAccountName('#selGider70', '%70 Kabul Edilen Gider');
            var g30Ad = getAccountName('#selKkeg30', '%30 KKEG Gideri');
            var k70Ad = getAccountName('#selKdv70', '%70 İndirilecek KDV');
            var k30Ad = getAccountName('#selKdv30', '%30 İndirim Konusu Yapılmayan KDV (KKEG)');

            var tbody = document.getElementById('kkegPreviewBody');
            var html = "";

            html += `<tr><td class="fw-bold">${bankaHesabi}</td><td class="text-start">${bankaAd}</td><td class="text-primary fw-bold">${bBorc}</td><td class="text-danger fw-bold">${bAlacak}</td></tr>`;
            html += `<tr><td>${g70Hsp}</td><td class="text-start">${g70Ad}</td><td class="text-primary">${g70Borc}</td><td class="text-danger">${g70Alacak}</td></tr>`;
            html += `<tr><td>${g30Hsp}</td><td class="text-start">${g30Ad}</td><td class="text-primary">${g30Borc}</td><td class="text-danger">${g30Alacak}</td></tr>`;
            
            if(kdv > 0) {
                html += `<tr><td>${k70Hsp}</td><td class="text-start">${k70Ad}</td><td class="text-primary">${k70Borc}</td><td class="text-danger">${k70Alacak}</td></tr>`;
                html += `<tr><td>${k30Hsp}</td><td class="text-start">${k30Ad}</td><td class="text-primary">${k30Borc}</td><td class="text-danger">${k30Alacak}</td></tr>`;
            }

            tbody.innerHTML = html;
        }

        function submitSapAktarim() {
            var btn = document.getElementById('btnSapAktarOnayla');
            var originalText = btn.innerHTML;
            
            var islemTipi = document.getElementById('selSapIslemTipi').value;
            if(!islemTipi) {
                toastr.warning("Lütfen zorunlu olan 'İşlem Tipi' alanını seçiniz!");
                $('#selSapIslemTipi').focus(); return;
            }

            var belgeTuru = document.getElementById('selBelgeTuru').value;
            var isKkeg = document.getElementById('chkKkeg').checked;
            var karsiTipi = document.getElementById('selKarsiTipi').value;
            var bankaHesabi = $('#selBankaHesabi').val();
            var islemId = document.getElementById('modalId').value;
            var islemDbKey = document.getElementById('modalDbKey').value; 
            var tutarCikisGiris = (document.getElementById('modalIsGiris').value === "false") ? -Math.abs(parseFloat(document.getElementById('modalTutar').value)) : Math.abs(parseFloat(document.getElementById('modalTutar').value));

            if (!bankaHesabi) { alert("Lütfen listeden SAP Banka Hesap Kodunu seçiniz!"); $('#selBankaHesabi').select2('open'); return; }

            if(belgeTuru === "30" && isKkeg) {
                if(!$('#selGider70').val() || !$('#selKkeg30').val()) { alert("KKEG işlemi için %70 ve %30 Gider Hesapları seçilmelidir!"); return; }
            } else {
                if (karsiTipi === "Cari" && (!$('#inpCariKodu').val() || $('#inpCariKodu').val().trim() === "")) { alert("Lütfen Cari Kodunu giriniz!"); $('#inpCariKodu').select2('open'); return; }
                if (karsiTipi === "Hesap" && !$('#selKarsiHesapKodu').val()) { alert("Lütfen arama kutusundan Karşı G/L Hesap Kodunu seçiniz!"); $('#selKarsiHesapKodu').select2('open'); return; }
            }

            var payload = {
                Id: islemId, BelgeTuru: belgeTuru, IslemTipi: islemTipi, KarsiTarafTipi: karsiTipi,
                CariKodu: $('#inpCariKodu').val() || "", KarsiHesapKodu: $('#selKarsiHesapKodu').val(),
                Tutar: tutarCikisGiris, IslemTarihi: document.getElementById('modalTarih').value,
                Aciklama: document.getElementById('modalAciklama').value, BankaHesapKodu: bankaHesabi,
                IsKkeg: isKkeg, KdvRate: parseInt(document.getElementById('selKdvRate').value),
                Gider70Hesap: $('#selGider70').val(), Kkeg30Hesap: $('#selKkeg30').val(),
                Kdv70Hesap: $('#selKdv70').val(), KkegKdv30Hesap: $('#selKdv30').val()
            };

            btn.innerHTML = 'Aktarılıyor...';
            btn.disabled = true;

            fetch('/Rapor123/AktarSap?db=' + islemDbKey, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value },
                body: JSON.stringify(payload)
            }).then(response => response.json()).then(data => {
                if (data.success) {
                    if (aktarModal) aktarModal.hide();
                    var statusCell = document.getElementById('status-' + document.getElementById('modalId').value);
                    if(statusCell) {
                        var docStr = data.docNum ? data.docNum : "Yeni Kayıt";
                        var selBelgeDropdown = document.getElementById('selBelgeTuru');
                        var belgeTuruText = selBelgeDropdown.options[selBelgeDropdown.selectedIndex].text.split('(')[0].trim();
                        if (document.getElementById('selBelgeTuru').value === "30") {
                            belgeTuruText = document.getElementById('chkKkeg').checked ? "Yevmiye (KKEG)" : "Yevmiye Fişi";
                        }
                        statusCell.innerHTML = '<span class="badge bg-success badge-status mb-1"><i class="fas fa-check me-1"></i>İşlendi</span><br/><span style="font-size:0.65rem; color:#64748b;">' + belgeTuruText + ': #' + docStr + '</span>';
                    }
                    var btnAktar = document.getElementById('btnAktar-' + document.getElementById('modalId').value);
                    if(btnAktar) { btnAktar.remove(); }
                    toastr.success("Belge SAP'ye başarıyla aktarıldı!");
                } else { alert("HATA:\n" + data.message); }
            }).catch(error => { alert("Kritik Hata: İstek gönderilemedi."); console.error(error); })
            .finally(() => { btn.innerHTML = originalText; btn.disabled = false; });
        }

        // ==========================================
        // YENİ VİRMAN (NAKİT AKIŞ) SCRİPTLERİ
        // ==========================================
        let currentDocEntry = 0; let currentBelgePB = "TRY"; let currentOdenenPB = "TRY"; let currentFinekraId = ""; let currentDbKey = "";

        $('.btn-virman').click(function () {
            var btn = $(this);
            currentDocEntry = btn.data('docentry'); currentFinekraId = btn.data('finekraid') || "";  currentDbKey = btn.data('dbkey');
            filterSelectsByDb('virmanModal', currentDbKey); 

            var kurum = btn.data('kurum'); var cardCode = btn.data('cardcode'); var belgeNo = btn.data('belgeno');
            var belgeTipi = btn.data('belgetipi') || 'Manuel'; var tutarOrijinal = parseFloat(btn.data('tutar')) || 0;
            var tutarTL = parseFloat(btn.data('tutartl')) || 0; var kur = parseFloat(btn.data('kur')) || 1;
            var odenmeTarihi = btn.data('odenmetarihi'); 

            currentBelgePB = btn.data('pb'); currentOdenenPB = btn.data('odenenpb');
            if(currentBelgePB === 'TL') currentBelgePB = 'TRY'; if(currentBelgePB === 'EURO') currentBelgePB = 'EUR';
            if(currentOdenenPB === 'TL') currentOdenenPB = 'TRY'; if(currentOdenenPB === 'EURO') currentOdenenPB = 'EUR';

            $('#vCardCode').text(cardCode ? '[' + cardCode + ']' : '[CARİ KODU YOK]');
            $('#vKurum').text(kurum); $('#vBelgeTipiNo').text(belgeTipi + ' - ' + (belgeNo || 'Belirtilmemiş'));
            $('#vBelgeTutar').text(tutarOrijinal.toLocaleString('tr-TR', { minimumFractionDigits: 2 })); $('#vBelgePB').text(currentBelgePB);
            $('#vKur').text(kur.toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
            $('#vTutarTL').text(tutarTL.toLocaleString('tr-TR', { minimumFractionDigits: 2 })); $('#vOdenenPB').text(currentOdenenPB);
            $('#vrmJeMemo').val('TL Döviz Virman - ' + kurum); $('#vrmJeIslemTipi').val(''); 

            var defaultDate = odenmeTarihi ? odenmeTarihi : new Date().toISOString().split('T')[0];
            $('#vrmJeRefDate').val(defaultDate); $('#vrmJeDueDate').val(defaultDate); $('#vrmJeTaxDate').val(defaultDate);

            const rows = $('#virmanJeLinesTable tbody tr.je-row');
            
            const r1 = $(rows[0]);
            r1.find('.line-memo').val($('#vrmJeMemo').val()); r1.find('.line-debit').val(tutarTL.toFixed(2)); r1.find('.line-credit').val('0.00');
            if(cardCode) { r1.find('.account-select').val(cardCode).trigger('change'); } else { r1.find('.account-select').val('').trigger('change'); }

            r1.find('.pb-orj-span').text(currentBelgePB !== 'TRY' ? currentBelgePB : '');
            if (currentBelgePB !== 'TRY') {
                r1.find('.line-fc-debit').val(tutarOrijinal.toFixed(2)).prop('readonly', false).removeClass('text-muted').addClass('text-primary fw-bold');
                r1.find('.line-fc-credit').val('0.00');
            } else {
                r1.find('.line-fc-debit').val('0.00').prop('readonly', true).removeClass('text-primary fw-bold').addClass('text-muted');
                r1.find('.line-fc-credit').val('0.00');
            }

            const r2 = $(rows[1]);
            r2.find('.line-memo').val($('#vrmJeMemo').val()); r2.find('.line-debit').val('0.00'); r2.find('.line-credit').val(tutarTL.toFixed(2));
            if(cardCode) { r2.find('.account-select').val(cardCode).trigger('change'); } else { r2.find('.account-select').val('').trigger('change'); }
            
            r2.find('.pb-ode-span').text(currentOdenenPB !== 'TRY' ? currentOdenenPB : '');
            if (currentOdenenPB !== 'TRY') {
                let bankFC = (tutarTL / kur);
                if (currentBelgePB === currentOdenenPB) bankFC = tutarOrijinal;
                r2.find('.line-fc-debit').val('0.00');
                r2.find('.line-fc-credit').val(bankFC.toFixed(2)).prop('readonly', false).removeClass('text-muted').addClass('text-danger fw-bold');
            } else {
                r2.find('.line-fc-debit').val('0.00');
                r2.find('.line-fc-credit').val('0.00').prop('readonly', true).removeClass('text-danger fw-bold').addClass('text-muted');
            }

            calculateVirmanTotals();
            $('#virmanModal').modal('show');
        });

        $(document).on('input', '#virmanJeLinesTable .line-debit, #virmanJeLinesTable .line-credit', function() { calculateVirmanTotals(); });

        function calculateVirmanTotals() {
            let totalDeb = 0; let totalCred = 0;
            $('#virmanJeLinesTable tbody tr.je-row').each(function() {
                totalDeb += parseFloat($(this).find('.line-debit').val()) || 0;
                totalCred += parseFloat($(this).find('.line-credit').val()) || 0;
            });
            
            $('#vrmTotalDebit').text(totalDeb.toLocaleString('tr-TR', { minimumFractionDigits: 2 }));
            $('#vrmTotalCredit').text(totalCred.toLocaleString('tr-TR', { minimumFractionDigits: 2 }));

            if(Math.abs(totalDeb - totalCred) > 0.01) {
                $('#vrmTotalDebit, #vrmTotalCredit').removeClass('text-info text-warning').addClass('text-danger');
                $('#vrmBalanceWarning').removeClass('d-none');
                $('#btnKaydetYevmiye').prop('disabled', true);
            } else {
                $('#vrmTotalDebit').removeClass('text-danger').addClass('text-info');
                $('#vrmTotalCredit').removeClass('text-danger').addClass('text-warning');
                $('#vrmBalanceWarning').addClass('d-none');
                $('#btnKaydetYevmiye').prop('disabled', false);
            }
        }

        $('#btnKaydetYevmiye').click(function () {
            var btn = $(this);
            let lines = []; let hasError = false;

            let islemTipi = $('#vrmJeIslemTipi').val();
            if(!islemTipi) { toastr.warning("Lütfen zorunlu olan 'İşlem Tipi' alanını seçiniz!"); $('#vrmJeIslemTipi').focus(); return; }

            $('#virmanJeLinesTable tbody tr.je-row').each(function(index) {
                const row = $(this);
                const accCode = row.find('.account-select').val();
                const isBp = row.find('.account-select option:selected').data('isbp') === true;
                const deb = parseFloat(row.find('.line-debit').val()) || 0;
                const cred = parseFloat(row.find('.line-credit').val()) || 0;
                const fcDeb = parseFloat(row.find('.line-fc-debit').val()) || 0;
                const fcCred = parseFloat(row.find('.line-fc-credit').val()) || 0;
                const memo = row.find('.line-memo').val();

                if (!accCode) { toastr.warning((index + 1) + '. Satır için lütfen Hesap veya Cari seçiniz!'); hasError = true; return false; }
                if (deb === 0 && cred === 0) return; 

                let rowCurrency = "TRY";
                if (index === 0 && currentBelgePB !== "TRY" && (fcDeb > 0 || fcCred > 0)) rowCurrency = currentBelgePB;
                if (index === 1 && currentOdenenPB !== "TRY" && (fcDeb > 0 || fcCred > 0)) rowCurrency = currentOdenenPB;

                lines.push({ AccountCode: accCode, IsBP: isBp, Debit: deb, Credit: cred, FCDebit: fcDeb, FCCredit: fcCred, FCCurrency: rowCurrency, LineMemo: memo });
            });

            if(hasError) return;
            if(lines.length < 2) { toastr.warning("Geçerli bir yevmiye kaydı için en az 1 Borç ve 1 Alacak satırı dolu olmalıdır."); return; }

            const payload = {
                DbKey: currentDbKey, NakitAkisDocEntry: currentDocEntry,
                RefDate: $('#vrmJeRefDate').val(), DueDate: $('#vrmJeDueDate').val(), TaxDate: $('#vrmJeTaxDate').val(),
                Memo: $('#vrmJeMemo').val(), Ref1: $('#vBelgeTipiNo').text().split('-')[1]?.trim() || "", 
                FinekraId: currentFinekraId, IslemTipi: islemTipi, JournalEntryLines: lines
            };

            btn.prop('disabled', true).html('SAP\'ye Gönderiliyor...');

            $.ajax({
                url: '/Rapor123/CreateVirmanJournalEntry',
                type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        toastr.success(res.message); $('#virmanModal').modal('hide'); setTimeout(() => location.reload(), 1500); 
                    } else {
                        toastr.error(res.message); btn.prop('disabled', false).html('SAP\'ye Kaydet');
                    }
                },
                error: function (err) {
                    let msg = err.responseJSON && err.responseJSON.message ? err.responseJSON.message : "Sunucuya bağlanılamadı veya yetkisiz erişim.";
                    toastr.error(msg); btn.prop('disabled', false).html('SAP\'ye Kaydet');
                }
            });
        });
    </script>
}