@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sirketler = (List<KeyValuePair<string, string>>)ViewBag.Sirketler;
    string varsayilan = (string)ViewBag.VarsayilanSirket ?? "";
    string bas = (string)ViewBag.Bas, bit = (string)ViewBag.Bit, sekme = (string)ViewBag.Sekme ?? "finekra";
    var sekmeler = new[] { ("finekra", "Finekra · Banka Hareketleri", "fa-building-columns"), ("kasa", "Kasa", "fa-cash-register"), ("cek", "Çek · Senet", "fa-money-check-alt"), ("eslesme", "Nakit Akış Eşleşme", "fa-link"), ("duzenli", "Düzenli Ödemeler", "fa-calendar-check"), ("gunsonu", "Gün Sonu Mutabakatı", "fa-clipboard-check"), ("bakiye", "Bakiyeler", "fa-scale-balanced"), ("gunluk", "Günlük", "fa-clock-rotate-left") };
}
@*
    KONSOLİDE FİNANSAL TAKİP PANELİ (Rapor123) — Kasa Nakit Akışı tasarım dili (na-* ortak stil, kn/tp düzeni). Veri /Rapor123/Veri; betik wwwroot/js/takip-paneli.js.
    Finekra sekmesi: bankadan otomatik akan hareketler (Data/FinekraOrnek.cs) → Onayla (cari / hesap seç) → muhasebe fişi; her hareket Kasa Nakit Akışı ile eşlenir (otomatik / elle);
    nakit akışta karşılığı olmayan çıkış "Nakit Akışa Gönder" ile ÖDENDİ satır olur. Kasa / Banka hareketleri nakit akış ödemelerinden, Çek hareketleri Çek Akıbeti kaydından (plan ↔ ibraz kontrolü).
    Eski görünüm: /Rapor123/Eski. Derin bağlantı: /Rapor123?sirket=URASKIMYA&bas=&bit=&sekme=finekra (eski: ?hesapTipi=CEK, ?tab=FINEKRA)
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<style>
    .na.tp { --na-k: #1d4ed8; }
    .tp-pill { font-size: .66rem; font-weight: 700; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 3px 10px; } a.tp-pill { text-decoration: none; } a.tp-pill:hover { background: #e0f2fe; color: #0c4a6e; border-color: #bae6fd; }
    #tp .na-panel .table-responsive { overflow: visible !important; } .table-container:has(#tp) { overflow: visible !important; }
    #tp .na-panel > .na-kart > .na-kart-b { position: sticky; top: var(--tp-sabit-ust, 0px); z-index: 7; }
    #tp .na-panel .tp-tablo thead th { position: sticky; top: calc(var(--tp-sabit-ust, 0px) + var(--tp-kartb, 31px)); z-index: 6; background: #f8fafc; box-shadow: 0 1px 0 #e2e8f0; }
    .tp-filtre { display: grid; grid-template-columns: 1.2fr .9fr .9fr .9fr 1.8fr auto; gap: 6px 8px; align-items: end; }
    .tp-filtre label { display: block; font-size: .58rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 2px; }
    .tp-filtre .form-control, .tp-filtre .form-select { font-size: .72rem; padding: 3px 7px; height: 28px; }
    .tp-hizli { display: flex; gap: 4px; } .tp-hizli button { font-size: .62rem; padding: 2px 7px; }
    @@media (max-width: 1200px) { .tp-filtre { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    #tp .na-sekme { flex-wrap: nowrap; gap: 0; } #tp .na-sekme button { flex: 1 1 auto; white-space: nowrap; padding: 7px 6px; font-size: .74rem; text-align: center; min-width: 0; overflow: hidden; } #tp .na-sekme button .n { font-size: .6rem; padding: 0 5px; margin-left: 4px; }
    @@media (max-width: 1400px) { #tp .na-sekme button { font-size: .66rem; padding: 6px 4px; } #tp .na-sekme button i { display: none; } }
    #tp .na-kpi { grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 5px; } #tp .na-kpi > div { padding: 5px 8px; min-width: 0; overflow: hidden; } #tp .na-kpi .v { font-size: .9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } #tp .na-kpi .l { font-size: .54rem; } #tp .na-kpi > div.aktif { background: #eff6ff; box-shadow: inset 0 0 0 1.5px var(--k, #1d4ed8); }
    @@media (max-width: 1500px) { #tp .na-kpi { grid-template-columns: repeat(5, 1fr); } }
    #tp .tp-tablo { font-size: .68rem; table-layout: fixed; width: 100%; }
    #tp .tp-tablo th { font-size: .56rem; padding: 4px 5px; white-space: normal; line-height: 1.15; vertical-align: bottom; overflow: hidden; }
    #tp .tp-tablo td { padding: 3px 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; vertical-align: middle; }
    #tp .tp-tablo td.sol { text-align: left !important; } #tp .tp-tablo td.wrap { white-space: normal; line-height: 1.25; } #tp .tp-tablo td.para { font-variant-numeric: tabular-nums; font-weight: 700; } #tp .tp-tablo td.kurum { font-weight: 700; color: #0f172a; }
    #tp .tp-tablo td small { display: block; font-size: .58rem; color: #64748b; font-weight: 500; line-height: 1.1; overflow: hidden; text-overflow: ellipsis; }
    #tp .tp-tablo tr.tik { cursor: pointer; } #tp .tp-tablo tr.tik:hover td { background: #eff6ff; }
    #tp .tp-tablo tr.giris td.para.g { color: #15803d; } #tp .tp-tablo tr.cikis td.para.c { color: #b91c1c; }
    #tp .tp-tablo tr.onayli td { background: #f0fdf4; } #tp .tp-tablo tr.eksik td { background: #fef2f2; } #tp .tp-tablo tr.bekliyor td { background: #fffbeb; }
    #tp .tp-tablo tr.toplam td { font-weight: 800; background: #f8fafc; border-top: 2px solid #1d4ed8; }
    #tp #tpBakiyeBanka, #tp #tpBildirimler, #tp #tpGunluk { table-layout: auto; } #tp #tpBakiyeKasa { table-layout: fixed; } #tp #tpBakiyeKasa td small { white-space: nowrap; }
    /* bakiyeler: özet kartları, alt toplam / grup satırları, X · R renkleri */
    .tp-bozet { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 6px; } .tp-bozet > div { background: #fff; border: 1px solid #e2e8f0; border-left: 3px solid var(--k, #94a3b8); border-radius: 8px; padding: 6px 9px; min-width: 0; }
    .tp-bozet .l { font-size: .56rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .tp-bozet .v { font-size: .86rem; font-weight: 800; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .tp-bozet .s { font-size: .58rem; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    @@media (max-width: 1500px) { .tp-bozet { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    #tp .tp-tablo tr.ara td { background: #f1f5f9; font-weight: 800; border-top: 1px solid #cbd5e1; } #tp .tp-tablo td.x { color: #1d4ed8; } #tp .tp-tablo td.r { color: #7c3aed; } #tp #tpBakiyeKasa td { white-space: nowrap; }
    .tp-onay { display: inline-block; font-size: .56rem; font-weight: 800; border-radius: 4px; padding: 1px 5px; white-space: nowrap; } .tp-onay.bekliyor { background: #fef3c7; color: #92400e; } .tp-onay.onayli { background: #dcfce7; color: #166534; } .tp-onay.eksik { background: #fee2e2; color: #991b1b; }
    .tp-es { display: inline-block; font-size: .56rem; font-weight: 800; border-radius: 4px; padding: 1px 5px; white-space: nowrap; } .tp-es.var { background: #dbeafe; color: #1e40af; } .tp-es.yok { background: #fee2e2; color: #991b1b; } .tp-es.disi { background: #f1f5f9; color: #475569; } .tp-es.gonder { background: #ede9fe; color: #5b21b6; }
    .tp-tur { display: inline-block; font-size: .56rem; font-weight: 800; border-radius: 4px; padding: 1px 6px; color: #fff; white-space: nowrap; background: #64748b; }
    .tp-tur.havale { background: #1d4ed8; } .tp-tur.musteri, .tp-tur.pos { background: #15803d; } .tp-tur.cek { background: #0369a1; } .tp-tur.oto, .tp-tur.kira { background: #b45309; } .tp-tur.vergi { background: #9d174d; } .tp-tur.masraf, .tp-tur.kredi, .tp-tur.kart { background: #7c3aed; } .tp-tur.virman { background: #0f766e; }
    .tp-kontrol { display: inline-block; font-size: .56rem; font-weight: 800; border-radius: 999px; padding: 1px 6px; white-space: nowrap; } .tp-kontrol.uyumlu { background: #dcfce7; color: #166534; } .tp-kontrol.farkli { background: #fee2e2; color: #991b1b; } .tp-kontrol.bekliyor { background: #fef9c3; color: #854d0e; } .tp-kontrol.plansiz { background: #e0f2fe; color: #0c4a6e; }
    .tp-link { font-weight: 700; font-size: .63rem; color: #1d4ed8; cursor: pointer; text-decoration: none; } .tp-link:hover { text-decoration: underline; }
    .tp-akis { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; } .tp-akis > div { background: #fff; border: 1px solid #e2e8f0; border-left: 3px solid var(--k, #94a3b8); border-radius: 8px; padding: 6px 9px; } .tp-akis .l { font-size: .58rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: #64748b; } .tp-akis .v { font-size: .92rem; font-weight: 800; color: #0f172a; } .tp-akis .s { font-size: .62rem; color: #64748b; }
    #tp .tp-tablo .btn-xs { font-size: .6rem; padding: 1px 6px; line-height: 1.3; }
    .tp-drawer { position: fixed; top: 0; right: -760px; width: 720px; max-width: 96vw; height: 100vh; background: #fff; box-shadow: -8px 0 24px rgba(15,23,42,.18); z-index: 1060; transition: right .25s; overflow: auto; padding: 12px 14px; } .tp-drawer.acik { right: 0; }
    .main-content #tpDrawer { height: 100vh !important; max-height: 100vh !important; overflow: auto !important; }
    .tp-drawer-ust { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; position: sticky; top: 0; background: #fff; padding-bottom: 6px; border-bottom: 1px solid #e2e8f0; z-index: 2; flex-wrap: wrap; }
    .tp-perde { position: fixed; inset: 0; background: rgba(15,23,42,.35); z-index: 1055; display: none; } .tp-perde.acik { display: block; }
    .tp-aksiyon { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 8px; } .tp-aksiyon .btn { font-size: .64rem; padding: 2px 8px; }
    .tp-kalem td { font-size: .7rem; } .tp-modal .table { font-size: .7rem; } .tp-modal .table td, .tp-modal .table th { padding: 4px 6px; white-space: nowrap; }
    .tp-fis { font-size: .7rem; } .tp-fis td, .tp-fis th { padding: 3px 6px; }
    /* gün sonu mutabakatı: adımlar, şirket blokları, sayım */
    .tp-adimlar { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 8px; }
    .tp-adim { display: flex; gap: 8px; align-items: flex-start; background: #fff; border: 1px solid #e2e8f0; border-left: 3px solid #94a3b8; border-radius: 8px; padding: 6px 9px; } .tp-adim.ok { border-left-color: #16a34a; } .tp-adim.hata { border-left-color: #dc2626; }
    .tp-adim .n { width: 22px; height: 22px; border-radius: 50%; background: #e2e8f0; color: #334155; font-weight: 800; font-size: .7rem; display: flex; align-items: center; justify-content: center; flex: none; margin-top: 2px; } .tp-adim.ok .n { background: #16a34a; color: #fff; } .tp-adim.hata .n { background: #dc2626; color: #fff; }
    .tp-adim .l { font-size: .58rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; color: #64748b; } .tp-adim .k { font-size: .66rem; font-weight: 700; color: #0f172a; } .tp-adim .v { font-size: .84rem; font-weight: 800; color: #0f172a; } .tp-adim .s { font-size: .6rem; color: #64748b; }
    .tp-gs-blok { border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 8px; overflow: hidden; background: #fff; }
    .tp-gs-baslik { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; padding: 5px 8px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; font-size: .7rem; } .tp-gs-baslik small { color: #64748b; font-size: .6rem; font-weight: 500; } .tp-gs-baslik .adim { white-space: nowrap; } .tp-gs-baslik .btn-xs, .tp-gs-blok .na-uyari .btn-xs { font-size: .62rem; padding: 2px 8px; line-height: 1.3; }
    #tp .tp-gs { table-layout: fixed; margin: 0; } #tp .tp-gs td.kalan { background: #f0f9ff; } #tp .tp-gs tr.bilgi td { color: #64748b; } #tp .na-panel .tp-gs thead th { position: static !important; }
    .tp-sayim input { font-size: .7rem; padding: 2px 6px; height: 26px; } .tp-sayim td { vertical-align: middle; }
    @@media (max-width: 1200px) { .tp-adimlar { grid-template-columns: 1fr; } }
</style>
}

<div class="container-fluid py-3 na tp" id="tp" data-sirket="@varsayilan" data-bas="@bas" data-bit="@bit" data-sekme="@sekme">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-clipboard-check"></i></span>Konsolide Finansal Takip Paneli</h4>
        <span class="tp-pill" title="Kasa, banka ve çek hareketleri: nakit akış ödemeleri, çek akıbeti kayıtları"><i class="fas fa-layer-group me-1"></i>Kasa · Banka · Çek Hareketleri</span>
        <span class="tp-pill" title="Finekra: banka hareketleri otomatik akar; onaylanıp cari seçilince muhasebe kaydı oluşur; her hareket Kasa Nakit Akışı ile eşlenir"><i class="fas fa-sync-alt me-1"></i>Finekra → Banka Hareketleri · Onay → Muhasebe Fişi</span>
        <a class="tp-pill" href="/Rapor79" title="Kasa Nakit Akışı: ödeme planı; banka hareketleri buradaki satırlarla eşlenir"><i class="fas fa-money-bill-transfer me-1"></i>Kasa Nakit Akışı ↔ Eşleşme <i class="fas fa-arrow-up-right-from-square ms-1" style="font-size:.56rem"></i></a>
        <a class="tp-pill" href="/CekAkibeti" title="Çek Akıbeti Raporu"><i class="fas fa-money-check-alt me-1"></i>Çek Akıbeti <i class="fas fa-arrow-up-right-from-square ms-1" style="font-size:.56rem"></i></a>
        <div class="sag">
            <button type="button" class="btn btn-light btn-sm border" id="tpYenile" style="font-size:.7rem" title="Finekra akışını ve listeleri yeniden oku"><i class="fas fa-rotate me-1"></i>Akışı Yenile</button>
            <button type="button" class="btn btn-light btn-sm border" id="tpExcel" style="font-size:.7rem"><i class="fas fa-file-excel me-1"></i>Excel</button>
            <a class="btn btn-light btn-sm border" href="/Rapor123/Eski" style="font-size:.7rem" title="Ana projedeki görünüm"><i class="fas fa-table me-1"></i>Eski Görünüm</a>
        </div>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>

    <div class="na-kart">
        <div class="na-kart-b"><span><i class="fas fa-filter me-1"></i>Filtreler</span><span class="d-flex gap-2 align-items-center"><span class="not" id="tpKapsam"></span><button type="button" class="btn btn-light btn-sm py-0" id="tpTemizle" style="font-size:.64rem">Temizle</button></span></div>
        <div class="na-kart-g">
            <div class="tp-filtre">
                <div><label>Şirket</label><select class="form-select" id="tpSirket"><option value="">Tümü (Konsolide)</option>@foreach (var s in sirketler) { <option value="@s.Key" selected="@(s.Key == varsayilan)">@s.Value</option> }</select></div>
                <div><label>Başlangıç</label><input type="date" class="form-control" id="tpBas" value="@bas" /></div>
                <div><label>Bitiş</label><input type="date" class="form-control" id="tpBit" value="@bit" /></div>
                <div><label>Onay Durumu</label><select class="form-select" id="tpDurum"><option value="">Tümü</option><option value="bekliyor">Onay Bekliyor</option><option value="onayli">Onaylandı</option><option value="eksik">Eksik / Kontrol</option><option value="sapYok">SAP'ye İşlenmemiş</option><option value="sapVar">SAP'ye İşlenmiş</option></select></div>
                <div><label>Ara</label><input class="form-control" id="tpAra" placeholder="Karşı taraf, açıklama, referans, hareket no, çek no, fiş no…" /></div>
                <div><label>Hızlı Dönem</label><div class="tp-hizli"><button type="button" class="btn btn-light border" data-gun="7">7 Gün</button><button type="button" class="btn btn-light border" data-gun="30">30 Gün</button><button type="button" class="btn btn-light border" data-gun="90">90 Gün</button></div></div>
            </div>
        </div>
    </div>

    <div class="na-kpi" id="tpKpi"></div>

    <div class="na-sekme" id="tpSekmeler">
        @foreach (var s in sekmeler) { <button type="button" class="@(s.Item1 == sekme ? "aktif" : "")" data-p="@s.Item1"><i class="fas @s.Item3 me-1"></i>@s.Item2 <span class="n" id="tpN-@s.Item1">0</span></button> }
    </div>

    @* ===== Finekra: bankadan otomatik akan hareketler ===== *@
    <div class="na-panel @(sekme == "finekra" ? "aktif" : "")" data-p="finekra">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-sync-alt me-1"></i>Finekra Akışı · Banka Hareketleri Otomatik Akar</span><span class="not" id="tpAkisNot"></span></div><div class="na-kart-g"><div class="tp-akis" id="tpAkis"></div></div></div>
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-building-columns me-1"></i>Banka Hareketleri · Onay → Cari / Hesap → Muhasebe Fişi · Nakit Akış Eşleşmesi</span><span class="d-flex gap-2 align-items-center"><span class="not" id="tpNot-finekra"></span><button type="button" class="btn btn-success btn-sm py-0" id="tpTopluOnay" style="font-size:.64rem" title="Eşleşmiş ve bekleyen hareketleri önerilen cari / hesapla onayla"><i class="fas fa-check-double me-1"></i>Eşleşenleri Toplu Onayla</button></span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpTablo-finekra" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>
    @* ===== Kasa / Banka / Çek hareketleri ===== *@
    @* banka hareketleri yalnız Finekra sekmesinde (üretilmiş BANKA satırları eski görünümde kaldı) *@
    @foreach (var p in new[] { ("kasa", "Kasa Hareketleri · Nakit Ödeme · Nakit Tahsilat", "fa-cash-register"), ("cek", "Çek · Senet Hareketleri · Plan ↔ İbraz Kontrolü", "fa-money-check-alt") })
    {
        <div class="na-panel @(sekme == p.Item1 ? "aktif" : "")" data-p="@p.Item1">
            <div class="na-kart">
                <div class="na-kart-b"><span><i class="fas @p.Item3 me-1"></i>@p.Item2</span><span class="not" id="tpNot-@p.Item1"></span></div>
                <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpTablo-@p.Item1" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
            </div>
        </div>
    }
    @* ===== Nakit akış ↔ banka eşleşmesi ===== *@
    <div class="na-panel @(sekme == "eslesme" ? "aktif" : "")" data-p="eslesme">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-link me-1"></i>Kasa Nakit Akışı Havale Satırları ↔ Banka Hareketi Eşleşmesi</span><span class="not" id="tpNot-eslesme"></span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpTablo-eslesme" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>
    @* ===== planlı düzenli ödemeler (Data/DuzenliOdemeOrnek.cs): aylık ödeme takvim listesi (Serkan Genç) — her ay otomatik Kasa Nakit Akışı satırı; bu ayı / gelecek ayı akıt, yeni kayıt, düzenle, pasife al ===== *@
    <div class="na-panel @(sekme == "duzenli" ? "aktif" : "")" data-p="duzenli">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-calendar-check me-1"></i>Planlı Düzenli Ödemeler · Her Ay Otomatik Nakit Akışa Akar</span><span class="d-flex gap-1 align-items-center flex-wrap"><span class="not" id="tpDzNot"></span><button type="button" class="btn btn-success btn-sm py-0" id="tpDzAkit" style="font-size:.64rem" title="Bu ay için nakit akışa akmamış aktif düzenli ödemeleri Kasa Nakit Akışı'na akıt"><i class="fas fa-play me-1"></i>Bu Ayı Akıt</button><button type="button" class="btn btn-primary btn-sm py-0" id="tpDzSonraki" style="font-size:.64rem" title="Gelecek ayın düzenli ödemelerini şimdiden Kasa Nakit Akışı'na planla"><i class="fas fa-forward me-1"></i>Gelecek Ayı Planla</button><button type="button" class="btn btn-light border btn-sm py-0" id="tpDzYeni" style="font-size:.64rem"><i class="fas fa-plus me-1"></i>Yeni Düzenli Ödeme</button></span></div>
            <div class="na-kart-g"><div class="tp-bozet" id="tpDzOzet"></div></div>
        </div>
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-list me-1"></i>Düzenli Ödeme Listesi · Şirket Bazında Alt Toplamlar · Sorumlu: <span id="tpDzSorumlu"></span></span><span class="not" id="tpNot-duzenli"></span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpTablo-duzenli" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>
    @* ===== gün sonu mutabakatı: 1) gün içi işlemler onayı (Ahmet Özkan) → 2) kalan bakiyeler otomatik (kasa, banka, çek / senet X · R) → 3) fiziksel sayım ve bakiye onayı ya da eksik / fazla bildirimi (Berk Berberoğlu) ===== *@
    <div class="na-panel @(sekme == "gunsonu" ? "aktif" : "")" data-p="gunsonu">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-clipboard-check me-1"></i>Gün Sonu Mutabakatı · Gün İçi Onay → Kalan Bakiyeler → Fiziksel Sayım</span><span class="d-flex gap-2 align-items-center"><span class="not">Gün</span><input type="date" class="form-control form-control-sm" id="tpGun" style="font-size:.68rem;height:24px;padding:1px 6px;width:132px" title="Mutabakat günü" /><span class="not" id="tpNot-gunsonu"></span></span></div>
            <div class="na-kart-g">
                <div class="tp-adimlar" id="tpAdimlar"></div>
                <div id="tpGunSonu"></div>
            </div>
        </div>
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-triangle-exclamation me-1"></i>Eksik / Fazla Bildirimleri · Fiziksel Sayım</span><span class="not" id="tpNot-bildirim"></span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpBildirimler" data-dinamik="kapali"><thead><tr><th>Bildirim</th><th>Şirket · Gün</th><th>Tür</th><th>Eksik / Fazla</th><th class="s">Adet · Tutar (₺)</th><th>Belgeler · Not</th><th>Durum</th><th></th></tr></thead><tbody></tbody></table></div></div></div>
    </div>
    @* ===== bakiyeler (ayrıntılı): özet kartları; kasa bakiyeleri şirket bazında nakit kasa · çek X / R · senet X / R · alt toplamlar (X kasa = nakit + çek X + senet X, R kasa = çek R + senet R); banka SAP ↔ Finekra şirket bazında kullanılabilir banka bakiyesi alt toplamı ===== *@
    <div class="na-panel @(sekme == "bakiye" ? "aktif" : "")" data-p="bakiye">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-scale-balanced me-1"></i>Bakiye Özeti · Kullanılabilir Banka · Nakit Kasa · Çek / Senet (X · R)</span><span class="not" id="tpNot-bakiye"></span></div><div class="na-kart-g"><div class="tp-bozet" id="tpBakiyeOzet"></div></div></div>
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-vault me-1"></i>Kasa Bakiyeleri · Nakit Kasa · Çekler · Senetler (X / R) · Şirket Bazında Alt Toplamlar</span><span class="not" id="tpNot-kasa-bakiye"></span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpBakiyeKasa" data-dinamik="kapali"><colgroup><col style="width:10%"><col style="width:6.5%"><col style="width:9.8%"><col style="width:9.8%"><col style="width:7.8%"><col style="width:9.8%"><col style="width:9.8%"><col style="width:7.8%"><col style="width:8%"><col style="width:7%"><col style="width:6.8%"><col style="width:6.9%"></colgroup><thead><tr><th>Şirket</th><th class="s">Nakit Kasa (₺)</th><th class="s">Çek X</th><th class="s">Çek R</th><th class="s">Çek Toplam (₺)</th><th class="s">Senet X</th><th class="s">Senet R</th><th class="s">Senet Toplam (₺)</th><th class="s">Çek + Senet Toplam (₺)</th><th class="s" title="Nakit kasa + Çek X + Senet X">X Kasa Toplamı (₺)</th><th class="s" title="Çek R + Senet R">R Kasa Toplamı (₺)</th><th class="s">Kasa Genel Toplamı (₺)</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-landmark me-1"></i>Banka Bakiyeleri · SAP ↔ Finekra · Şirket Bazında Kullanılabilir Banka Bakiyesi</span><span class="not" id="tpNot-banka-bakiye"></span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpBakiyeBanka" data-dinamik="kapali"><thead><tr><th>Şirket</th><th>Hesap</th><th>Banka Hesabı</th><th>PB</th><th class="s">SAP (₺)</th><th class="s">Finekra (₺)</th><th class="s">Fark (₺)</th><th>Güncelleme</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>
    @* ===== günlük ===== *@
    <div class="na-panel @(sekme == "gunluk" ? "aktif" : "")" data-p="gunluk">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-clock-rotate-left me-1"></i>Finekra İşlem Günlüğü</span><span class="not" id="tpNot-gunluk"></span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpGunluk" data-dinamik="kapali"><thead><tr><th>Zaman</th><th>Kullanıcı</th><th>Şirket</th><th>Hareket</th><th>İşlem</th><th>Açıklama</th></tr></thead><tbody></tbody></table></div></div></div>
    </div>

    @* ===== çekmece: hareket detayı ===== *@
    <div class="tp-perde" id="tpPerde"></div>
    <div class="tp-drawer" id="tpDrawer">
        <div class="tp-drawer-ust"><b id="tpDBaslik" style="font-size:.88rem"></b><span class="ms-auto"></span><button type="button" class="btn btn-light btn-sm py-0" id="tpDKapat" style="font-size:.66rem"><i class="fas fa-xmark"></i></button></div>
        <div id="tpDIc"></div>
    </div>

    @* ===== onay: cari / hesap seçimi → muhasebe fişi ===== *@
    <div class="modal fade tp-modal" id="tpOnayModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.84rem"><i class="fas fa-user-check me-2 text-primary"></i>Banka Hareketini Onayla · Muhasebe Kaydı <span class="tp-pill ms-2" id="toNo"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="na-ustbilgi mb-2" id="toBilgi"></div>
            <div class="na-uyari mavi" id="toOneri"></div>
            <div class="row g-2 mt-1" style="font-size:.72rem">
                <div class="col-md-5"><label class="form-label mb-0">Cari (Müşteri / Tedarikçi / Kurum)</label><input id="toCari" class="form-control form-control-sm" list="toCariler" style="font-size:.72rem" placeholder="cari adı yazın ya da seçin" /><datalist id="toCariler"></datalist><div class="na-mini" id="toCariKod"></div></div>
                <div class="col-md-4"><label class="form-label mb-0">Muhasebe Hesabı (Karşı)</label><select id="toHesap" class="form-select form-select-sm" style="font-size:.72rem"></select></div>
                <div class="col-md-3"><label class="form-label mb-0">Not</label><input id="toNot" class="form-control form-control-sm" style="font-size:.72rem" placeholder="isteğe bağlı" /></div>
            </div>
            <div class="na-kart mt-2 mb-0"><div class="na-kart-b"><span><i class="fas fa-book me-1"></i>Muhasebe Fişi Önizleme</span><span class="not" id="toFisNot"></span></div><div class="na-kart-g p-0"><table class="na-tablo tp-fis" id="toFis" data-dinamik="kapali"><thead><tr><th>Hesap</th><th>Hesap Adı · Açıklama</th><th class="s">Borç (₺)</th><th class="s">Alacak (₺)</th></tr></thead><tbody></tbody></table></div></div>
            <div class="na-mini mt-2" id="toSenkron"></div>
        </div>
        <div class="modal-footer py-2"><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-success btn-sm" id="toOnayla"><i class="fas fa-check me-1"></i>Onayla ve Fişi At</button></div>
    </div></div></div>

    @* ===== elle eşleştirme: nakit akış adayları ===== *@
    <div class="modal fade tp-modal" id="tpEsModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.84rem"><i class="fas fa-link me-2 text-primary"></i>Nakit Akış Satırıyla Eşleştir <span class="tp-pill ms-2" id="teNo"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="na-ustbilgi mb-2" id="teBilgi"></div>
            <div class="table-responsive" style="max-height:48vh"><table class="table table-sm table-hover align-middle mb-0"><thead class="table-light"><tr><th style="width:28px"></th><th>Kayıt</th><th>Ödenecek Cari</th><th>Belge</th><th>Planlanan</th><th>Ödenme</th><th>Durum</th><th class="text-end">Tutar (₺)</th><th class="text-end">Fark (₺)</th><th class="text-end">Gün</th><th>Alıcı IBAN</th><th>Fiş</th></tr></thead><tbody id="teGovde"></tbody></table></div>
            <div class="na-mini mt-2">Aynı şirketteki bağlanmamış Havale / EFT satırları tutar yakınlığına göre listelenir. Hareket onaylıysa eşleşen satır ÖDENDİ olur; dekont no satıra yazılır.</div>
        </div>
        <div class="modal-footer py-2"><span class="me-auto text-muted" style="font-size:.68rem" id="teOzet"></span><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-primary btn-sm" id="teEslestir"><i class="fas fa-link me-1"></i>Eşleştir</button></div>
    </div></div></div>

    @* ===== gün sonu 1) gün içi işlemler onayı — Ahmet Özkan (Finans Sorumlusu) ===== *@
    <div class="modal fade tp-modal" id="tpGunIciModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.84rem"><i class="fas fa-check-double me-2 text-success"></i>Gün İçi İşlemleri Onayla <span class="tp-pill ms-2" id="tgNo"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="na-ustbilgi mb-2" id="tgBilgi"></div>
            <div class="na-uyari mavi" id="tgUyari"></div>
            <div class="na-kart mt-2 mb-2"><div class="na-kart-b"><span><i class="fas fa-scale-balanced me-1"></i>Kesinleşecek Kalan Bakiyeler</span><span class="not">açılış − gün içi giriş + gün içi çıkış · çek / senet X · R</span></div><div class="na-kart-g p-0"><table class="na-tablo tp-fis" id="tgBakiye" data-dinamik="kapali"><thead><tr><th>Tür · Hesap</th><th class="s">Açılış</th><th class="s">Gün İçi Giriş</th><th class="s">Gün İçi Çıkış</th><th class="s">Kalan (Gün Sonu)</th></tr></thead><tbody></tbody></table></div></div>
            <div class="row g-2" style="font-size:.72rem"><div class="col-md-5"><label class="form-label mb-0">Onaylayan</label><input id="tgOnaylayan" class="form-control form-control-sm" style="font-size:.72rem" readonly /></div><div class="col-md-7"><label class="form-label mb-0">Not</label><input id="tgNot" class="form-control form-control-sm" style="font-size:.72rem" placeholder="isteğe bağlı" /></div></div>
        </div>
        <div class="modal-footer py-2"><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-success btn-sm" id="tgOnayla"><i class="fas fa-check-double me-1"></i>Gün İçi İşlemleri Onayla</button></div>
    </div></div></div>

    @* ===== gün sonu 3) fiziksel sayım — Berk Berberoğlu (Kasa Sorumlusu): eşleşirse bakiyeleri onaylar, değilse eksik / fazla bildirir ===== *@
    <div class="modal fade tp-modal" id="tpSayimModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.84rem"><i class="fas fa-list-check me-2 text-primary"></i>Fiziksel Sayım · Kalan Bakiye Onayı <span class="tp-pill ms-2" id="tsNo"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="na-uyari mavi mb-2"><i class="fas fa-info-circle me-1"></i>Gün sonunda fiziksel çek / senetler sayılır; sayılan adet ve tutar sistemdeki kalan bakiyeyle birebir eşleşiyorsa bakiyeler onaylanır, eksik ya da fazla belge varsa bildirim kaydedilir (finans çözer, sonra yeniden sayılır). Kasa (nakit) sayımı isteğe bağlıdır. Liste simgesi o türün portföy belgelerini gösterir.</div>
            <div class="table-responsive"><table class="na-tablo tp-fis tp-sayim" id="tsTablo" data-dinamik="kapali"><thead><tr><th>Tür</th><th class="s">Sistem Adet</th><th class="s">Sistem Tutar (₺)</th><th style="width:110px">Sayılan Adet</th><th style="width:160px">Sayılan Tutar (₺)</th><th class="s">Fark</th><th style="width:40px"></th></tr></thead><tbody id="tsGovde"></tbody></table></div>
            <div class="row g-2 mt-2" style="font-size:.72rem"><div class="col-md-4"><label class="form-label mb-0">Sayımı Yapan</label><input id="tsYapan" class="form-control form-control-sm" style="font-size:.72rem" readonly /></div><div class="col-md-4"><label class="form-label mb-0">Eksik / Fazla Belge No'ları</label><input id="tsBelge" class="form-control form-control-sm" style="font-size:.72rem" placeholder="ÇK-2610-…, SN-2610-…" /></div><div class="col-md-4"><label class="form-label mb-0">Not</label><input id="tsNot" class="form-control form-control-sm" style="font-size:.72rem" placeholder="isteğe bağlı" /></div></div>
        </div>
        <div class="modal-footer py-2"><span class="me-auto text-muted" style="font-size:.68rem" id="tsOzet"></span><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-danger btn-sm" id="tsBildir" disabled><i class="fas fa-triangle-exclamation me-1"></i>Eksik / Fazla Bildir</button><button type="button" class="btn btn-success btn-sm" id="tsOnayla" disabled><i class="fas fa-check me-1"></i>Eşleşti → Bakiyeleri Onayla</button></div>
    </div></div></div>
</div>

@section Scripts {
<script src="/js/takip-paneli.js?v=3"></script>
}
