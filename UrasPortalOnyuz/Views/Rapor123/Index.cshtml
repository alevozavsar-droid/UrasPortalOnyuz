        <div class="tp-ozet-iki">
            <div class="na-kart mb-0"><div class="na-kart-b"><span><i class="fas fa-list-check me-1"></i>Durum Özeti · İş Listesi</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo tp-ozet" id="tpOzetDurum" data-dinamik="kapali"><colgroup><col style="width:38%"><col style="width:11%"><col style="width:19%"><col style="width:32%"></colgroup><thead><tr><th>Gösterge</th><th class="s">Adet</th><th class="s">Tutar (₺)</th><th>Açıklama · İşlem</th></tr></thead><tbody></tbody></table></div></div></div>
            <div class="na-kart mb-0"><div class="na-kart-b"><span><i class="fas fa-building me-1"></i>Şirket Bazında Durum</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo tp-ozet-sirket" id="tpOzetSirket" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div></div>
        </div>
        <div class="na-kart mt-2"><div class="na-kart-b"><span><i class="fas fa-money-bill-transfer me-1"></i>Bugün Ödenecek · Gecikmiş Ödemeler · Banka Hareketi Kontrolü</span><span class="d-flex gap-2 align-items-center"><button type="button" class="btn btn-primary btn-sm py-0 tp-odeme-ekle" style="font-size:.64rem" title="Gün içinde yapılmış ama nakit akışta olmayan ödemeyi ekle"><i class="fas fa-plus me-1"></i>Eksik Ödeme Ekle</button></span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpOzetOdemeler" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div></div>
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-money-check-alt me-1"></i>Planlı Çek · Senetler · Vadesi Gelenler Tedarikçiye Çıkar</span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpOzetCekler" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div></div>
    </div>

    @* ===== Finekra: bankadan otomatik akan hareketler ===== *@
    <div class="na-panel @(sekme == "finekra" ? "aktif" : "")" data-p="finekra">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-building-columns me-1"></i>Banka Hareketleri</span><span class="d-flex gap-2 align-items-center"><button type="button" class="btn btn-success btn-sm py-0" id="tpTopluOnay" style="font-size:.64rem" title="Eşleşmiş ve bekleyen hareketleri önerilen cari / hesap / belgeyle SAP'ye işle"><i class="fas fa-check-double me-1"></i>Eşleşenleri Toplu SAP'ye İşle</button></span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpTablo-finekra" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>
    @* ===== Kasa / Banka / Çek hareketleri ===== *@
    @* banka hareketleri yalnız Finekra sekmesinde (üretilmiş BANKA satırları eski görünümde kaldı) *@
    @* her satırda "Satır Kaynağı · İşlem" (kaynak rozeti + Nakit Akışa Ekle / İbraz Et) ve "Kasa Nakit Akışı Eşleşmesi" (Var: nakit akış satırı bağlantısı / Yok) sütunları *@
    @foreach (var p in new[] { ("kasa", "Kasa Hareketleri", "fa-cash-register"), ("cek", "Çek · Senet", "fa-money-check-alt") })
    {
        <div class="na-panel @(sekme == p.Item1 ? "aktif" : "")" data-p="@p.Item1">
            <div class="na-kart">
                <div class="na-kart-b"><span><i class="fas @p.Item3 me-1"></i>@p.Item2</span><span class="d-flex gap-2 align-items-center"><button type="button" class="btn btn-primary btn-sm py-0 tp-odeme-ekle" data-yontem="@(p.Item1 == "kasa" ? "Nakit" : "Çek")" style="font-size:.64rem" title="Nakit akışta olmayan ödemeyi ekle"><i class="fas fa-plus me-1"></i>Eksik Ödeme Ekle</button></span></div>
                <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpTablo-@p.Item1" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
            </div>
        </div>
    }
    @* ===== Nakit akış ↔ banka eşleşmesi ===== *@
    <div class="na-panel @(sekme == "eslesme" ? "aktif" : "")" data-p="eslesme">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-link me-1"></i>Kasa Nakit Akışı Havale Satırları ↔ Banka Hareketi Eşleşmesi</span><span class="d-flex gap-2 align-items-center"><button type="button" class="btn btn-primary btn-sm py-0 tp-odeme-ekle" style="font-size:.64rem" title="Bankadan yapılmış ama nakit akışta olmayan ödemeyi ekle"><i class="fas fa-plus me-1"></i>Eksik Ödeme Ekle</button></span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpTablo-eslesme" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>
    @* ===== planlı düzenli ödemeler (Data/DuzenliOdemeOrnek.cs): aylık ödeme takvim listesi (Serkan Genç) — her ay otomatik Kasa Nakit Akışı satırı; bu ayı / gelecek ayı akıt, yeni kayıt, düzenle, pasife al ===== *@
    <div class="na-panel @(sekme == "duzenli" ? "aktif" : "")" data-p="duzenli">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-calendar-check me-1"></i>Planlı Düzenli Ödemeler · Her Ay Otomatik Nakit Akışa Akar</span><span class="d-flex gap-1 align-items-center flex-wrap"><button type="button" class="btn btn-success btn-sm py-0" id="tpDzAkit" style="font-size:.64rem" title="Bu ay için nakit akışa akmamış aktif düzenli ödemeleri Kasa Nakit Akışı'na akıt"><i class="fas fa-play me-1"></i>Bu Ayı Akıt</button><button type="button" class="btn btn-primary btn-sm py-0" id="tpDzSonraki" style="font-size:.64rem" title="Gelecek ayın düzenli ödemelerini şimdiden Kasa Nakit Akışı'na planla"><i class="fas fa-forward me-1"></i>Gelecek Ayı Planla</button><button type="button" class="btn btn-light border btn-sm py-0" id="tpDzYeni" style="font-size:.64rem"><i class="fas fa-plus me-1"></i>Yeni Düzenli Ödeme</button></span></div>
            <div class="na-kart-g"><div class="tp-bozet" id="tpDzOzet"></div></div>
        </div>
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-list me-1"></i>Düzenli Ödeme Listesi · Şirket Bazında Alt Toplamlar · Sorumlu: <span id="tpDzSorumlu"></span></span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpTablo-duzenli" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>
    @* ===== gün sonu mutabakatı: 1) gün içi işlemler onayı (Ahmet Özkan) → 2) kalan bakiyeler otomatik (kasa, banka, çek / senet X · R) → 3) fiziksel sayım ve bakiye onayı ya da eksik / fazla bildirimi (Berk Berberoğlu) ===== *@
    <div class="na-panel @(sekme == "gunsonu" ? "aktif" : "")" data-p="gunsonu">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-clipboard-check me-1"></i>Gün Sonu Mutabakatı · Gün İçi Onay → Kalan Bakiyeler → Fiziksel Sayım</span><span class="d-flex gap-2 align-items-center"><span class="not">Gün</span><input type="date" class="form-control form-control-sm" id="tpGun" style="font-size:.68rem;height:24px;padding:1px 6px;width:132px" title="Mutabakat günü" /></span></div>
            <div class="na-kart-g">
                <div class="tp-adimlar" id="tpAdimlar"></div>
                <div id="tpGunSonu"></div>
            </div>
        </div>
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-triangle-exclamation me-1"></i>Eksik / Fazla Bildirimleri · Fiziksel Sayım</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpBildirimler" data-dinamik="kapali"><thead><tr><th>Bildirim</th><th>Şirket · Gün</th><th>Tür</th><th>Eksik / Fazla</th><th class="s">Adet · Tutar (₺)</th><th>Belgeler · Not</th><th>Durum</th><th></th></tr></thead><tbody></tbody></table></div></div></div>
    </div>
    @* ===== bakiyeler (ayrıntılı): özet kartları; kasa bakiyeleri şirket bazında nakit kasa · çek X / R · senet X / R · alt toplamlar (X kasa = nakit + çek X + senet X, R kasa = çek R + senet R); banka SAP ↔ Finekra şirket bazında kullanılabilir banka bakiyesi alt toplamı ===== *@
    <div class="na-panel @(sekme == "bakiye" ? "aktif" : "")" data-p="bakiye">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-scale-balanced me-1"></i>Bakiye Özeti · Kullanılabilir Banka · Nakit Kasa · Çek / Senet (X · R)</span></div><div class="na-kart-g"><div class="tp-bozet" id="tpBakiyeOzet"></div></div></div>
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-vault me-1"></i>Kasa Bakiyeleri · Nakit Kasa · Çekler · Senetler (X / R) · Şirket Bazında Alt Toplamlar</span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpBakiyeKasa" data-dinamik="kapali"><colgroup><col style="width:10%"><col style="width:6.5%"><col style="width:9.8%"><col style="width:9.8%"><col style="width:7.8%"><col style="width:9.8%"><col style="width:9.8%"><col style="width:7.8%"><col style="width:8%"><col style="width:7%"><col style="width:6.8%"><col style="width:6.9%"></colgroup><thead><tr><th>Şirket</th><th class="s">Nakit Kasa (₺)</th><th class="s">Çek X</th><th class="s">Çek R</th><th class="s">Çek Toplam (₺)</th><th class="s">Senet X</th><th class="s">Senet R</th><th class="s">Senet Toplam (₺)</th><th class="s">Çek + Senet Toplam (₺)</th><th class="s" title="Nakit kasa + Çek X + Senet X">X Kasa Toplamı (₺)</th><th class="s" title="Çek R + Senet R">R Kasa Toplamı (₺)</th><th class="s">Kasa Genel Toplamı (₺)</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-landmark me-1"></i>Banka Bakiyeleri · SAP ↔ Finekra · Şirket Bazında Kullanılabilir Banka Bakiyesi</span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpBakiyeBanka" data-dinamik="kapali"><thead><tr><th>Şirket</th><th>Hesap</th><th>Banka Hesabı</th><th>PB</th><th class="s">SAP (₺)</th><th class="s">Finekra (₺)</th><th class="s">Fark (₺)</th><th>Güncelleme</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>
    @* ===== günlük ===== *@
    <div class="na-panel @(sekme == "gunluk" ? "aktif" : "")" data-p="gunluk">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-clock-rotate-left me-1"></i>Finekra İşlem Günlüğü</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="tpGunluk" data-dinamik="kapali"><thead><tr><th>Zaman</th><th>Kullanıcı</th><th>Şirket</th><th>Hareket</th><th>İşlem</th><th>Açıklama</th></tr></thead><tbody></tbody></table></div></div></div>
    </div>

    @* ===== çekmece: hareket detayı ===== *@
    <div class="tp-perde" id="tpPerde"></div>
    <div class="tp-drawer" id="tpDrawer">
        <div class="tp-drawer-ust"><b id="tpDBaslik" style="font-size:.88rem"></b><span class="ms-auto"></span><button type="button" class="btn btn-light btn-sm py-0" id="tpDKapat" style="font-size:.66rem"><i class="fas fa-xmark"></i></button></div>
        <div id="tpDIc"></div>
    </div>

    @* ===== SAP kaydı (onay): cari / hesap / belge (fatura) seçimi → muhasebe fişi; belge adayları tutar eşleşmesiyle otomatik önerilir ===== *@
    <div class="modal fade tp-modal" id="tpOnayModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.84rem"><i class="fas fa-file-invoice me-2 text-primary"></i>SAP'ye İşle · Banka Hareketi Muhasebe Kaydı <span class="tp-pill ms-2" id="toNo"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="na-ustbilgi mb-2" id="toBilgi"></div>
            <div class="na-uyari mavi" id="toOneri"></div>
            <div class="row g-2 mt-1" style="font-size:.72rem">
                <div class="col-md-4"><label class="form-label mb-0">Cari (Müşteri / Tedarikçi / Kurum)</label><input id="toCari" class="form-control form-control-sm" list="toCariler" style="font-size:.72rem" placeholder="cari adı yazın ya da seçin" /><datalist id="toCariler"></datalist><div class="na-mini" id="toCariKod"></div></div>
                <div class="col-md-3"><label class="form-label mb-0">Muhasebe Hesabı (Karşı)</label><select id="toHesap" class="form-select form-select-sm" style="font-size:.72rem"></select></div>
                <div class="col-md-2"><label class="form-label mb-0">Belge Tipi</label><select id="toBelgeTipi" class="form-select form-select-sm" style="font-size:.72rem"></select></div>
                <div class="col-md-3"><label class="form-label mb-0">Belge No (Fatura / Sipariş)</label><input id="toBelgeNo" class="form-control form-control-sm" style="font-size:.72rem" placeholder="listeden seç ya da yaz" /></div>
                <div class="col-md-12"><label class="form-label mb-0">Not</label><input id="toNot" class="form-control form-control-sm" style="font-size:.72rem" placeholder="isteğe bağlı" /></div>
            </div>
            <div class="na-kart mt-2 mb-2"><div class="na-kart-b"><span><i class="fas fa-file-invoice-dollar me-1"></i>Hangi Faturaya İstinaden · Belge Adayları</span><span class="not" id="toFaturaNot">tutar yakınlığına göre · en iyi aday otomatik seçili</span></div><div class="na-kart-g p-0"><div class="table-responsive" style="max-height:26vh"><table class="na-tablo tp-fat" id="toFaturalar" data-dinamik="kapali"><thead><tr><th style="width:28px"></th><th>Tip</th><th>Belge No</th><th>Tarih</th><th>Son Ödeme</th><th class="s">Belge Tutarı</th><th class="s">Kalan (₺)</th><th class="s">Fark (₺)</th><th>Kaynak</th></tr></thead><tbody></tbody></table></div></div></div>
            <div class="na-kart mb-0"><div class="na-kart-b"><span><i class="fas fa-book me-1"></i>Muhasebe Fişi Önizleme (SAP)</span><span class="not" id="toFisNot"></span></div><div class="na-kart-g p-0"><table class="na-tablo tp-fis" id="toFis" data-dinamik="kapali"><thead><tr><th>Hesap</th><th>Hesap Adı · Açıklama</th><th class="s">Borç (₺)</th><th class="s">Alacak (₺)</th></tr></thead><tbody></tbody></table></div></div>
            <div class="na-mini mt-2" id="toSenkron"></div>
        </div>
        <div class="modal-footer py-2"><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-success btn-sm" id="toOnayla"><i class="fas fa-check me-1"></i>SAP'ye İşle · Fişi At</button></div>
    </div></div></div>

    @* ===== ödeme ekle: gün içinde yapılmış ama nakit akışta olmayan ödeme ya da yeni plan → Kasa Nakit Akışı satırı ===== *@
    <div class="modal fade tp-modal" id="tpOdemeModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.84rem"><i class="fas fa-plus me-2 text-primary"></i>Ödeme Ekle · Kasa Nakit Akışı'na Yaz <span class="tp-pill ms-2" id="odKaynak"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="na-uyari mavi mb-2" id="odUyari"><i class="fas fa-info-circle me-1"></i>Gün içinde yapılmış ama nakit akışta görünmeyen ödeme için "Ödendi" işaretleyin: satır ÖDENDİ açılır, fiş atılır; havale ise banka hareketi Finekra'dan gelince otomatik eşleşir. İşaretlemezseniz satır Planlandı olur (nakit: GMY nakit onayına düşer) ve talimatla ödenir.</div>
            <div class="row g-2" style="font-size:.72rem">
                <div class="col-md-3"><label class="form-label mb-0">Şirket</label><select id="odSirket" class="form-select form-select-sm" style="font-size:.72rem"></select></div>
                <div class="col-md-5"><label class="form-label mb-0">Ödenecek Cari (Tedarikçi / Kurum)</label><input id="odKurum" class="form-control form-control-sm" list="odCariler" style="font-size:.72rem" placeholder="cari adı" /><datalist id="odCariler"></datalist></div>
                <div class="col-md-4"><label class="form-label mb-0">Ödeme Yöntemi</label><select id="odYontem" class="form-select form-select-sm" style="font-size:.72rem"></select></div>
                <div class="col-md-3"><label class="form-label mb-0">Tutar</label><input id="odTutar" type="number" min="0" step="0.01" class="form-control form-control-sm" style="font-size:.72rem" /></div>
                <div class="col-md-2"><label class="form-label mb-0">PB</label><select id="odPB" class="form-select form-select-sm" style="font-size:.72rem"></select></div>
                <div class="col-md-3"><label class="form-label mb-0">Tarih (Planlanan / Ödeme)</label><input id="odTarih" type="date" class="form-control form-control-sm" style="font-size:.72rem" /></div>
                <div class="col-md-2"><label class="form-label mb-0">Belge Tipi</label><select id="odBelgeTipi" class="form-select form-select-sm" style="font-size:.72rem"></select></div>
                <div class="col-md-2"><label class="form-label mb-0">Belge No</label><input id="odBelgeNo" class="form-control form-control-sm" style="font-size:.72rem" placeholder="FT-…" /></div>
                <div class="col-md-6"><label class="form-label mb-0">Ürün / Hizmet · Açıklama</label><input id="odUrun" class="form-control form-control-sm" style="font-size:.72rem" /></div>
                <div class="col-md-3" id="odBankaKap"><label class="form-label mb-0">Banka Hesabı</label><select id="odBanka" class="form-select form-select-sm" style="font-size:.72rem"></select></div>
                <div class="col-md-3 d-none" id="odKasaKap"><label class="form-label mb-0">Kasa</label><select id="odKasa" class="form-select form-select-sm" style="font-size:.72rem"></select></div>
                <div class="col-md-3"><label class="form-label mb-0">Dekont / Makbuz No</label><input id="odDekont" class="form-control form-control-sm" style="font-size:.72rem" placeholder="ödendiyse" /></div>
                <div class="col-md-12 d-none" id="odCekKap"><label class="form-label mb-0">Portföyden Çek / Senet</label><select id="odCek" class="form-select form-select-sm" style="font-size:.72rem"></select><div class="na-mini">Belge seçilirse satır tutarı belge tutarı olur; belge Çek Akıbeti'nde "Planlandı" görünür.</div></div>
                <div class="col-md-12"><div class="form-check"><input class="form-check-input" type="checkbox" id="odOdendi" checked><label class="form-check-label" for="odOdendi">Ödendi (gün içinde yapıldı; nakit akışta eksikti)</label></div></div>
            </div>
        </div>
        <div class="modal-footer py-2"><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-primary btn-sm" id="odKaydet"><i class="fas fa-paper-plane me-1"></i>Kasa Nakit Akışı'na Yaz</button></div>
    </div></div></div>

    @* ===== çek → nakit akışa gönder: portföydeki belge için çek / senet ödeme satırı (Planlandı) ===== *@
    <div class="modal fade tp-modal" id="tpCekGonderModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.84rem"><i class="fas fa-paper-plane me-2 text-primary"></i>Çeki Nakit Akışa Gönder · Planla <span class="tp-pill ms-2" id="cgNo"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="na-ustbilgi mb-2" id="cgBilgi"></div>
            <div class="row g-2" style="font-size:.72rem">
                <div class="col-md-12"><label class="form-label mb-0">Ödenecek Tedarikçi (Planlanan)</label><input id="cgTedarikci" class="form-control form-control-sm" list="cgTedarikciler" style="font-size:.72rem" placeholder="tedarikçi adı" /><datalist id="cgTedarikciler"></datalist></div>
                <div class="col-md-5"><label class="form-label mb-0">Planlanan Tarih</label><input id="cgTarih" type="date" class="form-control form-control-sm" style="font-size:.72rem" /></div>
                <div class="col-md-3"><label class="form-label mb-0">Belge Tipi</label><select id="cgBelgeTipi" class="form-select form-select-sm" style="font-size:.72rem"></select></div>
                <div class="col-md-4"><label class="form-label mb-0">Belge No</label><input id="cgBelgeNo" class="form-control form-control-sm" style="font-size:.72rem" /></div>
                <div class="col-md-12"><label class="form-label mb-0">Ürün / Hizmet · Açıklama</label><input id="cgUrun" class="form-control form-control-sm" style="font-size:.72rem" placeholder="isteğe bağlı" /></div>
            </div>
            <div class="na-mini mt-2">Kasa Nakit Akışı'nda çek / senet satırı açılır, belge satıra bağlanır; Çek Akıbeti'nde işlem türü "Planlandı", planlanan tedarikçi bu cari olur. Çıkış talimatla ya da "Tedarikçiye Çık" ile yapılır.</div>
        </div>
        <div class="modal-footer py-2"><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-primary btn-sm" id="cgGonder"><i class="fas fa-paper-plane me-1"></i>Nakit Akışa Gönder</button></div>
    </div></div></div>

    @* ===== çek çıkış: planlı belgeyi tedarikçiye ciro et ya da bankaya tahsile ver (plansız belge GMY onayına düşer) ===== *@
    <div class="modal fade tp-modal" id="tpCekCikisModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.84rem"><i class="fas fa-share-from-square me-2 text-success"></i>Tedarikçiye Çık · Çek / Senet Çıkışı <span class="tp-pill ms-2" id="ccNo"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="na-ustbilgi mb-2" id="ccBilgi"></div>
            <div class="na-uyari mavi mb-2" id="ccUyari"></div>
            <div class="row g-2" style="font-size:.72rem">
                <div class="col-md-5"><label class="form-label mb-0">Çıkış Türü</label><select id="ccTur" class="form-select form-select-sm" style="font-size:.72rem"><option value="Tedarikçiye Ciro">Tedarikçiye Ciro</option><option value="Bankaya Tahsile Ver">Bankaya Tahsile Ver</option></select></div>
                <div class="col-md-7"><label class="form-label mb-0">Ciro Edilen Tedarikçi / Banka</label><input id="ccYer" class="form-control form-control-sm" list="ccYerler" style="font-size:.72rem" /><datalist id="ccYerler"></datalist></div>
                <div class="col-md-5"><label class="form-label mb-0">Ciro Bordrosu / İbraz Belge No</label><input id="ccBelge" class="form-control form-control-sm" style="font-size:.72rem" placeholder="boş: otomatik" /></div>
                <div class="col-md-7"><label class="form-label mb-0">Not</label><input id="ccNot" class="form-control form-control-sm" style="font-size:.72rem" placeholder="isteğe bağlı" /></div>
            </div>
        </div>
        <div class="modal-footer py-2"><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-success btn-sm" id="ccCik"><i class="fas fa-check me-1"></i>Çıkışı İşle</button></div>
    </div></div></div>

    @* ===== fiş penceresi: Kasa / Çek sekmesi "Fiş" sütunu — belge / ibraz detayı + yevmiye fişi (FisVeri) ===== *@
    <div class="modal fade tp-modal" id="tpFisModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.84rem"><i class="fas fa-file-invoice me-2 text-primary"></i>Muhasebe Fişi · Belge Detayı <span class="tp-pill ms-2" id="tfNo"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body" id="tfIc"></div>
        <div class="modal-footer py-2"><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Kapat</button></div>
    </div></div></div>

    @* ===== elle eşleştirme: nakit akış adayları ===== *@
    <div class="modal fade tp-modal" id="tpEsModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.84rem"><i class="fas fa-link me-2 text-primary"></i>Nakit Akış Satırıyla Eşleştir <span class="tp-pill ms-2" id="teNo"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="na-ustbilgi mb-2" id="teBilgi"></div>
            <div class="table-responsive" style="max-height:48vh"><table class="table table-sm table-hover align-middle mb-0"><thead class="table-light"><tr><th style="width:28px"></th><th>Kayıt</th><th>Ödenecek Cari</th><th>Belge</th><th>Planlanan</th><th>Ödenme</th><th>Durum</th><th class="text-end">Tutar (₺)</th><th class="text-end">Fark (₺)</th><th class="text-end">Gün</th><th>Alıcı IBAN</th><th>Fiş</th></tr></thead><tbody id="teGovde"></tbody></table></div>
            <div class="na-mini mt-2">Aynı şirketteki bağlanmamış Havale / EFT satırları tutar yakınlığına göre listelenir. Hareket onaylıysa eşleşen satır ÖDENDİ olur; dekont no satıra yazılır.</div>
        </div>
        <div class="modal-footer py-2"><span class="me-auto text-muted" style="font-size:.68rem" id="teOzet"></span><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-primary btn-sm" id="teEslestir"><i class="fas fa-link me-1"></i>Eşleştir</button></div>
    </div></div></div>

    @* ===== gün sonu 1) gün içi işlemler onayı — Ahmet Özkan (Finans Sorumlusu) ===== *@
    <div class="modal fade tp-modal" id="tpGunIciModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.84rem"><i class="fas fa-check-double me-2 text-success"></i>Gün İçi İşlemleri Onayla <span class="tp-pill ms-2" id="tgNo"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="na-ustbilgi mb-2" id="tgBilgi"></div>
            <div class="na-uyari mavi" id="tgUyari"></div>
            <div class="na-kart mt-2 mb-2"><div class="na-kart-b"><span><i class="fas fa-scale-balanced me-1"></i>Kesinleşecek Kalan Bakiyeler</span><span class="not">açılış − gün içi giriş + gün içi çıkış · çek / senet X · R</span></div><div class="na-kart-g p-0"><table class="na-tablo tp-fis" id="tgBakiye" data-dinamik="kapali"><thead><tr><th>Tür · Hesap</th><th class="s">Açılış</th><th class="s">Gün İçi Giriş</th><th class="s">Gün İçi Çıkış</th><th class="s">Kalan (Gün Sonu)</th></tr></thead><tbody></tbody></table></div></div>
            <div class="row g-2" style="font-size:.72rem"><div class="col-md-5"><label class="form-label mb-0">Onaylayan</label><input id="tgOnaylayan" class="form-control form-control-sm" style="font-size:.72rem" readonly /></div><div class="col-md-7"><label class="form-label mb-0">Not</label><input id="tgNot" class="form-control form-control-sm" style="font-size:.72rem" placeholder="isteğe bağlı" /></div></div>
        </div>
        <div class="modal-footer py-2"><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-success btn-sm" id="tgOnayla"><i class="fas fa-check-double me-1"></i>Gün İçi İşlemleri Onayla</button></div>
    </div></div></div>

    @* ===== gün sonu 3) fiziksel sayım — Berk Berberoğlu (Kasa Sorumlusu): eşleşirse bakiyeleri onaylar, değilse eksik / fazla bildirir ===== *@
    <div class="modal fade tp-modal" id="tpSayimModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.84rem"><i class="fas fa-list-check me-2 text-primary"></i>Fiziksel Sayım · Kalan Bakiye Onayı <span class="tp-pill ms-2" id="tsNo"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="na-uyari mavi mb-2"><i class="fas fa-info-circle me-1"></i>Gün sonunda fiziksel çek / senetler sayılır; sayılan adet ve tutar sistemdeki kalan bakiyeyle birebir eşleşiyorsa bakiyeler onaylanır, eksik ya da fazla belge varsa bildirim kaydedilir (finans çözer, sonra yeniden sayılır). Kasa (nakit) sayımı isteğe bağlıdır. Liste simgesi o türün portföy belgelerini gösterir.</div>
            <div class="table-responsive"><table class="na-tablo tp-fis tp-sayim" id="tsTablo" data-dinamik="kapali"><thead><tr><th>Tür</th><th class="s">Sistem Adet</th><th class="s">Sistem Tutar (₺)</th><th style="width:110px">Sayılan Adet</th><th style="width:160px">Sayılan Tutar (₺)</th><th class="s">Fark</th><th style="width:40px"></th></tr></thead><tbody id="tsGovde"></tbody></table></div>
            <div class="row g-2 mt-2" style="font-size:.72rem"><div class="col-md-4"><label class="form-label mb-0">Sayımı Yapan</label><input id="tsYapan" class="form-control form-control-sm" style="font-size:.72rem" readonly /></div><div class="col-md-4"><label class="form-label mb-0">Eksik / Fazla Belge No'ları</label><input id="tsBelge" class="form-control form-control-sm" style="font-size:.72rem" placeholder="ÇK-2610-…, SN-2610-…" /></div><div class="col-md-4"><label class="form-label mb-0">Not</label><input id="tsNot" class="form-control form-control-sm" style="font-size:.72rem" placeholder="isteğe bağlı" /></div></div>
        </div>
        <div class="modal-footer py-2"><span class="me-auto text-muted" style="font-size:.68rem" id="tsOzet"></span><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-danger btn-sm" id="tsBildir" disabled><i class="fas fa-triangle-exclamation me-1"></i>Eksik / Fazla Bildir</button><button type="button" class="btn btn-success btn-sm" id="tsOnayla" disabled><i class="fas fa-check me-1"></i>Eşleşti → Bakiyeleri Onayla</button></div>
    </div></div></div>
</div>

@section Scripts {
<script src="/js/takip-paneli.js?v=21"></script>
}
