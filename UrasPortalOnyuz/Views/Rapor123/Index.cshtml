        function silManuelKayit(islemNo) {
            if(!confirm("Bu manuel kaydı silmek istediğinize emin misiniz?")) return;

            fetch('/Rapor123/SilManuelKayit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
