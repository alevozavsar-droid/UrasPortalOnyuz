@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    <script>
        let isNewMode = false;

        $(document).ready(function() {
            toastr.options = { "closeButton": true, "positionClass": "toast-bottom-right" };
            $('.select2-init').select2({ theme: 'bootstrap-5', width: '100%' });

            // Razor üzerinden aldığımız aktif db parametresi ve Anti-Forgery token
            const dbParam = '@currentDb';
