@model dynamic
@{
    ViewData["Title"] = "Kalem Ana Verileri Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var items = ViewBag.Items as List<WebApplication3.Controllers.Rapor100Controller.LookupModel> ?? new List<WebApplication3.Controllers.Rapor100Controller.LookupModel>();
    var itemGroups = ViewBag.ItemGroups as List<WebApplication3.Controllers.Rapor100Controller.LookupModel> ?? new List<WebApplication3.Controllers.Rapor100Controller.LookupModel>();

    // Aktif Veritabanını (Şirketi) güvenli bir şekilde URL veya Cookie'den alıyoruz
    var currentDb = Context.Request.Query["db"].ToString();
    if (string.IsNullOrEmpty(currentDb))
    {
        currentDb = Context.Request.Cookies["SelectedDatabase"];
    }
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    
    <style>
        body { background-color: var(--bg-main, #f4f7f6); font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; font-size: 0.85rem; color: #2c3e50; }
        .bp-card { background: var(--bg-card, #ffffff); border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); margin-bottom: 25px; border: 1px solid var(--border-color, #e9ecef); }
        .header-bg { background: linear-gradient(90deg, #f39c12, #e67e22); height: 6px; width: 100%; border-radius: 12px 12px 0 0;}
        .form-label { font-weight: 600; color: var(--text-secondary, #5c6a77); margin-bottom: 4px; font-size: 0.8rem; }
        .form-control, .form-select { border-radius: 6px; padding: 6px 12px; font-size: 0.85rem; border: 1px solid var(--border-color, #cfd9e0); background-color: var(--bg-subtle, #fbfcfd); }
        .form-control:focus, .form-select:focus { border-color: #f39c12; box-shadow: 0 0 0 3px rgba(243, 156, 18, 0.15); background-color: var(--bg-card, #fff); }
        .nav-tabs { border-bottom: 2px solid var(--border-color, #edf2f7); background: var(--bg-card, #fff); }
        .nav-tabs .nav-link { color: #7f8c8d; font-weight: 600; padding: 10px 15px; border: none; border-bottom: 3px solid transparent; cursor: pointer;}
        .nav-tabs .nav-link:hover, .nav-tabs .nav-link.active { color: #f39c12; border-bottom: 3px solid #f39c12; background: transparent; }
        .udf-panel { background: var(--bg-subtle, #fafbfc); border-left: 1px solid var(--border-color, #edf2f7); padding: 15px; height: 100%; overflow-y: auto; max-height: 800px; }
        .udf-panel label { font-size: 0.75rem; margin-bottom: 2px; }
        .udf-panel .form-control-sm, .udf-panel .form-select-sm { padding: 4px 8px; font-size: 0.8rem; }
    </style>
}

<div class="container-fluid px-4 py-4">
    @if (!string.IsNullOrEmpty((string)ViewBag.AlanMesaji))
    {
        <div class="alert alert-info py-2 px-3 mb-2" style="font-size:13px;"><i class="fas fa-wand-magic-sparkles me-1"></i>@ViewBag.AlanMesaji</div>
    }
    @Html.AntiForgeryToken()

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="w-50 shadow-sm rounded-3">
            <select id="itemSelect" class="form-select select2-init">
                <option value="">-- Stok Kodu Ara ve Seç --</option>
                @foreach (var i in items) { <option value="@i.Code">@i.Code - @i.Name</option> }
            </select>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <button class="btn btn-success fw-bold px-4 rounded-pill shadow-sm" id="btnNew"><i class="fas fa-plus me-2"></i>Yeni Kalem</button>
            <button class="btn btn-primary fw-bold px-4 rounded-pill shadow-sm" id="btnUpdate"><i class="fas fa-cloud-upload-alt me-2"></i>SAP'ye Gönder / Güncelle</button>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-8 col-lg-7">
            <div class="bp-card">
                <div class="header-bg"></div>
                <div class="p-3 bg-light border-bottom">
                    <div class="row align-items-end">
                        <div class="col-md-3">
                            <label class="form-label text-primary">Kalem Numarası</label>
                            <input type="text" class="form-control fw-bold" id="form_ItemCode" placeholder="Oto. veya Manuel">
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Tanım</label>
                            <input type="text" class="form-control fw-bold" id="form_ItemName">
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex gap-3 mt-3">
                                <div class="form-check"><input class="form-check-input" type="checkbox" id="form_InvntItem" checked><label class="form-check-label">Stok</label></div>
                                <div class="form-check"><input class="form-check-input" type="checkbox" id="form_SellItem" checked><label class="form-check-label">Satış</label></div>
                                <div class="form-check"><input class="form-check-input" type="checkbox" id="form_PrchseItem" checked><label class="form-check-label">Satınalma</label></div>
                            </div>
                        </div>
                        <div class="col-md-3 mt-2">
                            <label class="form-label">Yabancı Ad</label>
                            <input type="text" class="form-control" id="form_FrgnName">
                        </div>
                        <div class="col-md-5 mt-2">
                            <label class="form-label">Kalem Grubu</label>
                            <select class="form-select select2-init" id="form_ItmsGrpCod">
                                @foreach(var g in itemGroups) { <option value="@g.Id">@g.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-4 mt-2">
                            <label class="form-label">Barkod</label>
                            <input type="text" class="form-control" id="form_CodeBars">
                        </div>
                    </div>
                </div>

                <ul class="nav nav-tabs" id="itemTab" role="tablist">
                    <li class="nav-item"><a class="nav-link active" data-bs-target="#tabGenel">Genel</a></li>
                    <li class="nav-item"><a class="nav-link" data-bs-target="#tabStok">Stok Verileri</a></li>
                </ul>

                <div class="tab-content p-4">
                    <div class="tab-pane fade show active" id="tabGenel">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" id="form_ValidFor" checked><label class="form-check-label text-success fw-bold">Etkin</label></div>
                                <div class="row align-items-center mb-2"><div class="col-4"><label class="form-label">Üretici</label></div><div class="col-8"><select class="form-select"><option>- Üretici Yok -</option></select></div></div>
                                <div class="row align-items-center mb-2"><div class="col-4"><label class="form-label">Ek tanımlayıcı</label></div><div class="col-8"><input type="text" class="form-control"></div></div>
                                <div class="row align-items-center mb-2"><div class="col-4"><label class="form-label">Sevkiyat türü</label></div><div class="col-8"><select class="form-select"><option>CIF</option></select></div></div>
                                <div class="row align-items-center mb-2"><div class="col-4"><label class="form-label">Kalem yönetme ölçütü</label></div><div class="col-8"><select class="form-select"><option value="N">Hiçbiri</option><option value="S">Seri Numaraları</option><option value="B">Partiler</option></select></div></div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="tabStok">
                        <div class="row">
                            <div class="col-md-4">
                                <label class="form-label text-success">Stokta (OnHand)</label>
                                <input type="text" class="form-control fw-bold" id="form_OnHand" readonly value="0.00">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-danger">Taahhüt Edilen (IsCommited)</label>
                                <input type="text" class="form-control fw-bold" id="form_IsCommited" readonly value="0.00">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-primary">Sipariş Edilen (OnOrder)</label>
                                <input type="text" class="form-control fw-bold" id="form_OnOrder" readonly value="0.00">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-5">
            <div class="bp-card udf-panel shadow-sm">
