                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-hover table-modern mb-0">
                        <thead class="sticky-top">
                            <tr>
                                <th>Belge No</th>
                                <th>Müşteri Kodu</th>
                                <th>Müşteri Adı</th>
                                <th>Kayıt Tarihi</th>
                                <th>Döviz</th>
                            </tr>
                        </thead>
                        <tbody id="searchResultsBody">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <span class="text-muted small me-auto"><i class="fas fa-info-circle me-1"></i>Görüntülemek istediğiniz kaydın üzerine tıklayın.</span>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- EKSİK STOK BİLDİRİMİ MODAL -->
<div class="modal fade" id="missingStockModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
