            + '              <div class="small mt-2" style="color:var(--metin-2);">İrsaliye oluşturulmaz. Fatura doğrudan siparişten türer.</div>'
            + '            </div>'
            + '          </div>'
            + '          <div class="col-md-4">'
            + '            <div class="akis-secenek" data-akis="IRSALIYE_FATURA">'
            + '              <div class="fw-bold mb-2"><i class="fas fa-layer-group text-primary me-1"></i>İrsaliye + Fatura</div>'
            + '              <div class="zincir">Sipariş ─► İrsaliye ─► Fatura</div>'
            + '              <div class="small mt-2" style="color:var(--metin-2);">Bugüne kadarki davranış. Üç belge de oluşur.</div>'
            + '            </div>'
