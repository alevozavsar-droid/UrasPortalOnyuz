@{
    string bolge = (string)ViewBag.Bolge ?? "Yurtiçi";
    bool ihracat = bolge == "Yurtdışı";
    ViewData["Title"] = ihracat ? "Yurtdışı Satış Siparişi" : "Yurtiçi Satış Siparişi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string onSekme = (string)ViewBag.Sekme ?? "siparisler";
    string onNo = (string)ViewBag.No ?? "";
    string ben = (string)ViewBag.Ben ?? "";
}
@*
    SATIŞ SİPARİŞİ — Yurtiçi (/Rapor94; Satış ve Operasyon › Yurtiçi Satış › Satış İşlemleri) ve Yurtdışı / İhracat (/Rapor94/Ihracat; Yurtdışı Satış › İhracat Satış İşlemleri). Aynı ekran, bölgeye göre ayrı liste.
      • Siparişler       : satıcı Selvi Kimya'nın siparişleri — müşteri, marka, temsilci, kalem / kg, tutar, ödeme / teslim, YÜKLEME TARİHİ ve SAATİ (kalan gün), süreç şeridi, belgeler. Satıra tıklayınca çekmece:
                           marka seçimi (Uras / Alv Kimya / Inknovators / Selvi; belgelerde o markanın adı, ünvanı, adresi çıkar), kalemler, yükleme planı (tarih, saat, yer, nakliye), durum adımları,
                           TEK TUŞLA belgeler (yurtdışı: Proforma Invoice · Commercial Invoice · Packing List ve hepsi tek PDF "İhracat Belge Seti"; yurtiçi: Sipariş Formu · Proforma Fatura), günlük.
      • Sipariş Talepleri: satışçılardan gelen talepler (Durum = Talep) buraya düşer; "Siparişe Dönüştür" ile yükleme tarihi / saati ve marka kesinleşir, numara verilir.
      • Yükleme Takvimi  : önümüzdeki günlerin yükleme planı (satışçı takibi için); gecikenler kırmızı.
      • Yeni Sipariş     : müşteri, marka, kalemler (fiyat Muhataplar İçin Özel Fiyatlar'dan otomatik), ödeme / teslim, yükleme tarihi-saati; "Sipariş Oluştur" ya da "Sipariş Talebi Gönder" (satışçı).
    Veri: /Rapor94/Veri?bolge= · Fiyat · Siparis · Kaydet · Donustur · Yukleme · Durum · Marka · Belge?no=&tur= · Excel (Controllers/Rapor94Controller.cs, Data/SatisSiparisOrnek.cs) · betik: wwwroot/js/satis-siparis.js
    Derin bağlantı: ?sekme=talepler|takvim|yeni&no=SS-2026-0003
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<style>
    .na.ss { --na-k: @(ihracat ? "#1d4ed8" : "#0f766e"); }
    .ss-pill { font-size: .66rem; font-weight: 700; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 3px 10px; } a.ss-pill { text-decoration: none; } a.ss-pill:hover { background: #e0f2fe; color: #0c4a6e; border-color: #bae6fd; }
    .ss-pill.bolge { background: var(--na-k); color: #fff; border-color: var(--na-k); }
    #ss .na-kpi { grid-template-columns: repeat(8, 1fr); } @@media (max-width: 1400px) { #ss .na-kpi { grid-template-columns: repeat(4, 1fr); } }
    #ss .na-kpi > div.aktif { outline: 2px solid var(--k, #0f766e); outline-offset: -1px; }
    .ss-filtre { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1.6fr auto auto; gap: 6px 8px; align-items: end; } @@media (max-width: 1300px) { .ss-filtre { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    .ss-filtre label, .ss-form label, .ss-yukleme label { display: block; font-size: .58rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 2px; }
    .ss-filtre .form-control, .ss-filtre .form-select, .ss-form .form-control, .ss-form .form-select, .ss-yukleme .form-control, .ss-yukleme .form-select { font-size: .72rem; padding: 3px 7px; height: 28px; }
    #ss .ss-tablo { font-size: .68rem; table-layout: fixed; width: 100%; }
    #ss .ss-tablo th { font-size: .56rem; padding: 5px 5px; white-space: normal; line-height: 1.15; vertical-align: middle; position: sticky; top: 0; z-index: 3; background: #f8fafc; box-shadow: 0 1px 0 #e2e8f0; }
    #ss .ss-tablo td { padding: 4px 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; vertical-align: middle; line-height: 1.2; border-bottom: 1px solid #e2e8f0; }
    #ss .ss-tablo td.sol { text-align: left !important; } #ss .ss-tablo td.para { font-variant-numeric: tabular-nums; text-align: right !important; font-weight: 700; }
    #ss .ss-tablo td small { display: block; font-size: .56rem; color: #64748b; font-weight: 500; line-height: 1.15; overflow: hidden; text-overflow: ellipsis; }
    #ss .ss-tablo tr.tik { cursor: pointer; } #ss .ss-tablo tr.tik:hover td { background: #f0fdfa; }
    #ss .ss-tablo tr.gec td { background: #fef2f2; } #ss .ss-tablo tr.talep td { background: #fffbeb; } #ss .ss-tablo tr.bitti td { background: #f8fafc; color: #64748b; }
    #ss .ss-tablo tr.toplam td { font-weight: 800; background: #f8fafc; border-top: 2px solid var(--na-k); }
    /* marka rozeti ve süreç şeridi */
    .ss-marka { display: inline-block; font-size: .58rem; font-weight: 800; color: #fff; border-radius: 4px; padding: 1px 6px; letter-spacing: .03em; white-space: nowrap; }
    .ss-surec { display: flex; gap: 2px; align-items: center; flex-wrap: nowrap; } .ss-surec span { font-size: .52rem; font-weight: 700; border-radius: 999px; padding: 1px 6px; background: #f1f5f9; color: #94a3b8; border: 1px solid #e2e8f0; white-space: nowrap; }
    .ss-surec span.ok { background: #dcfce7; color: #166534; border-color: #bbf7d0; } .ss-surec span.simdi { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; } .ss-surec span.gec { background: #fee2e2; color: #991b1b; border-color: #fecaca; } .ss-surec span.iptal { background: #fee2e2; color: #991b1b; }
    .ss-rozet { display: inline-block; font-size: .58rem; font-weight: 800; border-radius: 4px; padding: 1px 6px; white-space: nowrap; } .ss-rozet.ok { background: #dcfce7; color: #166534; } .ss-rozet.bekle { background: #fef3c7; color: #92400e; } .ss-rozet.bilgi { background: #dbeafe; color: #1e40af; } .ss-rozet.hata { background: #fee2e2; color: #991b1b; } .ss-rozet.notr { background: #f1f5f9; color: #475569; } .ss-rozet.mor { background: #ede9fe; color: #5b21b6; }
    .ss-belge { display: inline-block; font-size: .54rem; font-weight: 800; border-radius: 4px; padding: 0 4px; margin-right: 2px; background: #e2e8f0; color: #334155; } .ss-belge.var { background: #dcfce7; color: #166534; } .ss-belge.eski { background: #fef3c7; color: #92400e; }
    #ss .btn-xs { font-size: .58rem; padding: 1px 6px; line-height: 1.3; }
    /* çekmece */
    .ss-drawer { position: fixed; top: 0; right: -860px; width: 820px; max-width: 97vw; height: 100vh; background: #fff; box-shadow: -8px 0 24px rgba(15,23,42,.18); z-index: 1060; transition: right .25s; overflow: auto; padding: 12px 14px; } .ss-drawer.acik { right: 0; }
    .main-content #ssDrawer { height: 100vh !important; max-height: 100vh !important; overflow: auto !important; }
    .ss-drawer-ust { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; position: sticky; top: 0; background: #fff; padding-bottom: 6px; border-bottom: 1px solid #e2e8f0; z-index: 2; flex-wrap: wrap; }
    .ss-perde { position: fixed; inset: 0; background: rgba(15,23,42,.35); z-index: 1055; display: none; } .ss-perde.acik { display: block; }
    .ss-adimlar { display: flex; gap: 0; align-items: stretch; } .ss-adimlar > div { flex: 1; text-align: center; font-size: .62rem; font-weight: 700; padding: 6px 4px; background: #f1f5f9; color: #94a3b8; border-right: 2px solid #fff; position: relative; }
    .ss-adimlar > div.ok { background: #dcfce7; color: #166534; } .ss-adimlar > div.simdi { background: #1d4ed8; color: #fff; } .ss-adimlar > div.gec { background: #dc2626; color: #fff; } .ss-adimlar > div small { display: block; font-size: .54rem; font-weight: 500; }
    /* marka seçimi: basit kartlar */
    .ss-markalar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; } .ss-markalar > div { border: 2px solid #e2e8f0; border-radius: 10px; padding: 7px 9px; cursor: pointer; background: #fff; }
    .ss-markalar > div:hover { border-color: #94a3b8; } .ss-markalar > div.sec { border-color: var(--mr, #1d4ed8); background: #f8fafc; box-shadow: 0 0 0 2px rgba(29,78,216,.12); }
    .ss-markalar .ad { font-size: .78rem; font-weight: 900; color: var(--mr, #1d4ed8); letter-spacing: .03em; } .ss-markalar .u { font-size: .6rem; color: #0f172a; font-weight: 600; line-height: 1.2; margin-top: 2px; } .ss-markalar .a { font-size: .56rem; color: #64748b; line-height: 1.2; }
    .ss-belgeler { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; } .ss-belgeler .btn { font-size: .66rem; }
    .ss-yukleme { display: grid; grid-template-columns: 1.1fr .8fr 1.1fr 1fr 1.2fr auto; gap: 6px 8px; align-items: end; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 10px; padding: 8px 10px; } @@media (max-width: 1000px) { .ss-yukleme { grid-template-columns: repeat(3, 1fr); } }
    .ss-form { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 6px 8px; align-items: end; } @@media (max-width: 1200px) { .ss-form { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    .ss-form .g2 { grid-column: span 2; } .ss-form .g3 { grid-column: span 3; } .ss-form .g6 { grid-column: span 6; }
    .ss-kalem { width: 90px; text-align: right; font-size: .7rem; height: 26px; padding: 2px 5px; }
    .ss-takvim { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; } @@media (max-width: 1300px) { .ss-takvim { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    .ss-gun { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 6px 8px; min-width: 0; } .ss-gun.bugun { border-color: var(--na-k); box-shadow: 0 0 0 2px #dbeafe; } .ss-gun.gecti { background: #fef2f2; border-color: #fecaca; }
    .ss-gun .g { display: flex; align-items: baseline; gap: 6px; font-size: .62rem; color: #64748b; font-weight: 700; text-transform: uppercase; } .ss-gun .g b { font-size: .95rem; color: #0f172a; } .ss-gun .g .t { margin-left: auto; font-size: .62rem; color: #0f172a; }
    .ss-gun ul { list-style: none; margin: 4px 0 0; padding: 0; } .ss-gun li { font-size: .62rem; line-height: 1.2; padding: 3px 0; border-top: 1px dashed #e2e8f0; cursor: pointer; } .ss-gun li:hover { background: #f8fafc; } .ss-gun li .s { font-weight: 800; color: #0f172a; } .ss-gun li small { color: #64748b; display: block; font-size: .56rem; }
    .ss-uyari { font-size: .68rem; color: #991b1b; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 5px 10px; }
</style>
}

<div class="container-fluid py-3 na ss" id="ss" data-bolge="@bolge" data-sekme="@onSekme" data-no="@onNo">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas @(ihracat ? "fa-ship" : "fa-truck")"></i></span>@(ihracat ? "Yurtdışı Satış Siparişi · İhracat" : "Yurtiçi Satış Siparişi")</h4>
        <span class="ss-pill bolge"><i class="fas fa-store me-1"></i>Satıcı: Selvi Kimya</span>
        <a class="ss-pill" href="@(ihracat ? "/Rapor94" : "/Rapor94/Ihracat")" title="Diğer bölgenin sipariş ekranı"><i class="fas @(ihracat ? "fa-truck" : "fa-ship") me-1"></i>@(ihracat ? "Yurtiçi Satış Siparişi" : "Yurtdışı Satış Siparişi")</a>
        <a class="ss-pill" href="/Rapor95" target="_blank" rel="noopener" title="Kalem fiyatları buradan gelir"><i class="fas fa-tags me-1"></i>Muhataplar İçin Özel Fiyatlar</a>
        <a class="ss-pill" href="/MusteriTeklif" target="_blank" rel="noopener"><i class="fas fa-file-signature me-1"></i>Müşteri Teklifleri</a>
        @if (ihracat) { <a class="ss-pill" href="/IhracatBelge" target="_blank" rel="noopener"><i class="fas fa-paper-plane me-1"></i>İhracat Belge Gönderim Takibi</a> }
        <span class="ss-pill" id="ssKim"><i class="fas fa-user me-1"></i>@ben</span>
        <span class="sub w-100">Satış <b>Selvi Kimya</b>'dan yapılır; <b>marka basitçe seçilir</b> — <b>URAS</b>, <b>ALV KİMYA</b>, <b>INKNOVATORS</b> ya da <b>SELVİ</b> etiketi — ve belgeler o markanın adı, ünvanı ve adresiyle <b>tek tuşla</b> oluşur (@(ihracat ? "Proforma Invoice · Commercial Invoice · Packing List; hepsi tek PDF \"İhracat Belge Seti\"" : "Sipariş Formu · Proforma Fatura")). <b>Satışçılardan gelen sipariş talepleri</b> Sipariş Talepleri sekmesine düşer ve burada siparişe dönüştürülür. Her siparişte <b>yükleme tarihi ve saati</b> planlanır; satışçılar süreci (Talep → Sipariş → Hazırlanıyor → Yüklemeye Hazır → Yüklendi → Faturalandı) buradan ve Yükleme Takvimi'nden izler. Kalem fiyatları müşterinin özel fiyatından (yoksa liste fiyatı) otomatik gelir.</span>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>

    <div class="na-kpi" id="ssKpi" data-dinamik="kapali"></div>

    <div class="na-sekme" id="ssSekmeler" data-dinamik="kapali">
        <button type="button" data-p="siparisler" class="aktif"><i class="fas fa-list me-1"></i>Siparişler <span class="n" id="ssN-siparisler">0</span></button>
        <button type="button" data-p="talepler"><i class="fas fa-inbox me-1"></i>Sipariş Talepleri <span class="n" id="ssN-talepler">0</span></button>
        <button type="button" data-p="takvim"><i class="fas fa-calendar-days me-1"></i>Yükleme Takvimi <span class="n" id="ssN-takvim">0</span></button>
        <button type="button" data-p="yeni"><i class="fas fa-plus me-1"></i>Yeni Sipariş / Talep</button>
        <button type="button" data-p="ozet"><i class="fas fa-chart-pie me-1"></i>Marka · Temsilci Özeti</button>
    </div>

    <div class="na-panel aktif" data-p="siparisler">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-list me-1"></i>@(ihracat ? "İhracat Siparişleri" : "Yurtiçi Siparişler") · Yükleme Tarihi ve Süreç</span><span class="not" id="ssSayi"></span></div>
            <div class="na-kart-g">
                <div class="ss-filtre">
                    <div><label>Durum</label><select class="form-select" id="ssDurumF"><option value="">Tümü</option><option value="acik">Açık (Sipariş · Hazırlanıyor · Hazır)</option><option value="gec">Yüklemesi Geciken</option><option value="hafta">Bu Hafta Yüklenecek</option><option value="belgesiz">Belgesi Eksik</option><option value="Sipariş">Sipariş</option><option value="Hazırlanıyor">Hazırlanıyor</option><option value="Yüklemeye Hazır">Yüklemeye Hazır</option><option value="Yüklendi">Yüklendi</option><option value="Faturalandı">Faturalandı</option><option value="İptal">İptal</option></select></div>
                    <div><label>Marka</label><select class="form-select" id="ssMarkaF"><option value="">Tümü</option></select></div>
                    <div><label>Fatura Kesen / Gönderici</label><select class="form-select" id="ssSirketF"><option value="">Tümü</option></select></div>
                    <div><label>Temsilci</label><select class="form-select" id="ssTemsilciF"><option value="">Tümü</option></select></div>
                    <div><label>Müşteri</label><select class="form-select" id="ssMusteriF"><option value="">Tümü</option></select></div>
                    <div><label>Ara</label><input class="form-control" id="ssAra" placeholder="Sipariş no, müşteri, ürün, PO, fatura…" autocomplete="off"></div>
                    <div><label>&nbsp;</label><button type="button" class="btn btn-light border btn-sm py-0" id="ssExcel" style="font-size:.66rem;height:28px"><i class="fas fa-file-excel me-1"></i>Excel</button></div>
                    <div><label>&nbsp;</label><button type="button" class="btn btn-primary btn-sm py-0" id="ssYeniBtn" style="font-size:.66rem;height:28px"><i class="fas fa-plus me-1"></i>Yeni Sipariş</button></div>
                </div>
            </div>
            <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:64vh"><table class="na-tablo ss-tablo" id="ssTablo" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>

    <div class="na-panel" data-p="talepler">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-inbox me-1"></i>Satışçılardan Gelen Sipariş Talepleri</span><span class="not">satıra tıklayınca talep açılır; "Siparişe Dönüştür" ile yükleme tarihi / saati ve marka kesinleşir, sipariş numarası verilir</span></div>
            <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:64vh"><table class="na-tablo ss-tablo" id="ssTalepTablo" data-dinamik="kapali"><thead></thead><tbody></tbody></table></div></div>
        </div>
    </div>

    <div class="na-panel" data-p="takvim">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-calendar-days me-1"></i>Yükleme Takvimi · <span id="ssTakvimBaslik"></span></span><span class="d-flex gap-2 align-items-center"><span class="not">gün bazında · saat sırasıyla · kırmızı geciken · satıra tıklayınca sipariş açılır</span><select class="form-select" id="ssTakvimGun" style="font-size:.66rem;height:24px;width:auto;padding:2px 20px 2px 6px"><option value="7">7 Gün</option><option value="14" selected>14 Gün</option><option value="30">30 Gün</option></select></span></div>
            <div class="na-kart-g"><div class="ss-takvim" id="ssTakvim"></div></div>
        </div>
    </div>

    <div class="na-panel" data-p="yeni">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-plus me-1"></i>Yeni @(ihracat ? "İhracat" : "Yurtiçi") Siparişi / Sipariş Talebi</span><span class="not">satış operasyonu "Sipariş Oluştur"; satışçı "Sipariş Talebi Gönder" (talep sekmesine düşer, operasyon siparişe dönüştürür)</span></div>
            <div class="na-kart-g">
                <div class="ss-form">
                    <div class="g2"><label>Müşteri</label><select class="form-select" id="ynMusteri"></select></div>
                    <div><label>Satış Temsilcisi</label><input class="form-control" id="ynTemsilci" list="ynTemsilciler" placeholder="karttan gelir"><datalist id="ynTemsilciler"></datalist></div>
                    <div><label>Para Birimi</label><select class="form-select" id="ynPb"></select></div>
                    <div><label>Ödeme Şekli</label><select class="form-select" id="ynOdeme"></select></div>
                    <div><label>Teslim Şekli</label><select class="form-select" id="ynTeslim"></select></div>
                    <div class="g6"><label>Marka · Belgelerde Çıkacak Ad (Basit Seçim)</label><div class="ss-markalar" id="ynMarkalar"></div></div>
                    <div class="g2"><label>Fatura Kesen Şirket</label><select class="form-select" id="ynFaturaKesen"></select></div>
                    <div class="g2"><label>Gönderici Şirket (Sevk Eden Depo / Fabrika)</label><select class="form-select" id="ynGonderici"></select></div>
                    <div class="g2"><label>&nbsp;</label><span class="text-muted" style="font-size:.64rem;display:block;line-height:1.2">Fatura kesen belgelerde Seller, gönderici Shipper satırında çıkar; marka seçilince gönderici ve yükleme yeri markanın fabrikasına göre önerilir.</span></div>
                    <div><label>Yükleme Tarihi</label><input type="date" class="form-control" id="ynYuklemeTarihi"></div>
                    <div><label>Yükleme Saati</label><input type="time" class="form-control" id="ynYuklemeSaati" value="09:00"></div>
                    <div><label>Yükleme Yeri</label><select class="form-select" id="ynYuklemeYeri"></select></div>
                    <div><label>Nakliye</label><select class="form-select" id="ynNakliye"></select></div>
                    <div><label>Nakliye Firması</label><select class="form-select" id="ynNakliyeFirmasi"></select></div>
                    <div><label>Müşteri Sipariş (PO) No</label><input class="form-control" id="ynPo" placeholder="isteğe bağlı"></div>
                    <div class="g3"><label>Sevk Adresi</label><input class="form-control" id="ynSevk" placeholder="karttan: şehir / ülke"></div>
                    <div class="g3"><label>Not</label><input class="form-control" id="ynNot" placeholder="müşteri notu, özel talimat…"></div>
                </div>
                <div class="mt-2"><label style="font-size:.58rem;font-weight:700;color:#64748b;text-transform:uppercase">Kalemler · fiyat müşterinin özel fiyatından (Muhataplar İçin Özel Fiyatlar) otomatik gelir, elle değiştirilebilir</label>
