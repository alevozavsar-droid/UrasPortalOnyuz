            }

            $('#akisModal').remove();

            var html =
              '<div class="modal fade" id="akisModal" tabindex="-1" data-bs-backdrop="static">'
            + '  <div class="modal-dialog modal-lg modal-dialog-centered">'
            + '    <div class="modal-content">'
            + '      <div class="modal-header">'
            + '        <h5 class="modal-title fw-bold"><i class="fas fa-code-branch text-primary me-2"></i>Bu sipariş nasıl kapatılsın?</h5>'
            + '        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>'
            + '      </div>'
