                    $('#loadingOverlay').css('display', 'flex');
                    
                    $.post('/Rapor94/CancelOrder?docEntry=' + currentDocEntry, function(res) {
                        if (res.success) {
                            toastr.success(res.message);
                            setTimeout(() => { window.location.reload(); }, 2000);
                        } else {
                            toastr.error(res.message);
                        }
                    }).fail(function(xhr) {
                        const errMsg = xhr.responseJSON ? xhr.responseJSON.message : "İptal işlemi sırasında hata oluştu.";
                        toastr.error(errMsg);
                    }).always(function() {
                        $('#loadingOverlay').hide();
                    });
