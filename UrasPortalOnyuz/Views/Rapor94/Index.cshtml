@{
    ViewData["Title"] = "Yeni Satış Siparişi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var databases = (List<WebApplication3.Controllers.Rapor94Controller.DatabaseConfig>)ViewBag.Databases;
    var currentDbDisplay = (string)ViewBag.CurrentDbDisplay;
    var customers = (List<WebApplication3.Controllers.Rapor94Controller.CustomerModel>)ViewBag.Customers;
    var items = (List<WebApplication3.Controllers.Rapor94Controller.ItemModel>)ViewBag.Items;
    var slps = (List<WebApplication3.Controllers.Rapor94Controller.SalesEmployeeModel>)ViewBag.SalesEmployees;
    var vatGroups = (List<WebApplication3.Controllers.Rapor94Controller.VatGroupModel>)ViewBag.VatGroups;
    var currencies = (List<string>)ViewBag.Currencies;
    var muafCodes = (List<WebApplication3.Controllers.Rapor94Controller.MuafCodeModel>)ViewBag.MuafCodes;
    var nakliyeFirmalari = ViewBag.NakliyeFirmalari as List<WebApplication3.Controllers.Rapor94Controller.NakliyeFirmaModel>
                           ?? new List<WebApplication3.Controllers.Rapor94Controller.NakliyeFirmaModel>();
    var countries = (List<WebApplication3.Controllers.Rapor94Controller.CountryModel>)ViewBag.Countries;
    var states = (List<WebApplication3.Controllers.Rapor94Controller.StateModel>)ViewBag.States;
    var warehouses = (List<WebApplication3.Controllers.Rapor94Controller.WarehouseModel>)ViewBag.Warehouses; 
    var drivers = (List<WebApplication3.Controllers.Rapor94Controller.DriverModel>)ViewBag.Drivers;

    // İhracat listeleri (GİB ihracat e-faturası alanları)
    var ihrIncoterms = ViewBag.IhracatIncoterms as List<WebApplication3.Services.IhracatBilgileri.KodAd> ?? new List<WebApplication3.Services.IhracatBilgileri.KodAd>();
    var ihrKapCinsleri = ViewBag.IhracatKapCinsleri as List<WebApplication3.Services.IhracatBilgileri.KodAd> ?? new List<WebApplication3.Services.IhracatBilgileri.KodAd>();
    var ihrTasima = ViewBag.IhracatTasima as List<WebApplication3.Services.IhracatBilgileri.KodAd> ?? new List<WebApplication3.Services.IhracatBilgileri.KodAd>();
    var ihrOdemeSekli = ViewBag.IhracatOdemeSekli as List<WebApplication3.Services.IhracatBilgileri.KodAd> ?? new List<WebApplication3.Services.IhracatBilgileri.KodAd>();
    var ihrOdemeKanali = ViewBag.IhracatOdemeKanali as List<WebApplication3.Services.IhracatBilgileri.KodAd> ?? new List<WebApplication3.Services.IhracatBilgileri.KodAd>();
    var ihrAlanMesajlari = ViewBag.IhracatAlanMesajlari as List<string> ?? new List<string>();
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <style>
        /* Layout'un tema degiskenlerine baglanir; sayfa acik/koyu temaya uyar. */
        :root {
            --form-bg: var(--bg-card, #ffffff);
            --border-soft: var(--border-color, #e2e8f0);
            --primary-soft: rgba(59,130,246,.08);
            --baslik-bg: var(--bg-subtle, #f8fafc);
            --metin-2: var(--text-secondary, #64748b);
        }
        .sap-card { background: var(--form-bg); border: 1px solid var(--border-soft); border-radius: var(--r-lg, 14px); box-shadow: var(--shadow-sm, 0 2px 4px rgba(0,0,0,.02)); margin-bottom: 1rem; overflow: hidden; }
        /* Kolon genislikleri icerige gore dagitilir (sabit yerlesim degil).
           Kalem kolonu kisa adlarda daralir, uzun adlarda 300px'e kadar buyur,
           sonrasinda kesilir; tam metin secicinin uzerine gelince gorunur. */
        #linesTable { table-layout: auto; }

        #linesTable td:nth-child(2), #linesTable th:nth-child(2) {
            max-width: 150px;
        }
        #linesTable td:nth-child(2) .select2-selection__rendered {
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }

        /* Serbest metin kolonu dar; icerik tasmaz, tamami tooltip'te gorunur. */
        #linesTable td:nth-child(3), #linesTable th:nth-child(3) {
            width: 120px; max-width: 120px; overflow: hidden;
        }
        #linesTable td:nth-child(3) input { text-overflow: ellipsis; }

        /* Tutar kolonlari kirilmasin. */
        #linesTable td:nth-child(6), #linesTable td:nth-child(8),
        #linesTable th:nth-child(6), #linesTable th:nth-child(8) { white-space: nowrap; }

        .sap-card-header { background-color: var(--baslik-bg); border-bottom: 1px solid var(--border-soft); padding: 0.8rem 1.2rem; font-weight: 600; display: flex; justify-content: space-between; align-items: center; }
        .sap-card-body { padding: 1.5rem 1.2rem; }
        
        .form-label { font-weight: 600; color: var(--metin-2); font-size: 0.85rem; margin-bottom: 0.3rem; }
        .form-select-sm, .form-control-sm { min-height: 34px; font-size: 0.85rem;}
        
        .table-modern { border-collapse: separate; border-spacing: 0; width: 100%; }
        .table-modern th { background-color: var(--baslik-bg); color: var(--metin-2); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; padding: 10px; border-bottom: 1px solid var(--border-soft); border-right: 1px solid var(--border-soft); position: sticky; top: 0; z-index: 3; }
        .table-modern td { padding: 6px 8px; vertical-align: middle; border-bottom: 1px solid var(--border-soft); border-right: 1px solid var(--border-soft); }
        .table-modern tbody tr:hover td { background-color: var(--primary-soft); cursor:pointer;} 
        
        /* Alan ustu etiket: ayri kolon kaplamaz, dikey yer kazandirir. */
        .ust-etiket {
            font-size: 0.68rem; font-weight: 700; color: var(--metin-2, #6c757d);
            text-transform: uppercase; letter-spacing: .3px; margin-bottom: 2px;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        .table-input { border: 1px solid transparent; background: transparent; width: 100%; padding: 4px 8px; border-radius: 4px; transition: 0.2s; font-size: 0.85rem; }
        .table-input:focus, .table-input:hover { border-color: #cbd5e1; background: #fff; outline: none; }
        
        .select2-container--bootstrap-5 .select2-selection { font-size: 0.85rem; min-height: 34px; border-color: var(--border-soft); }
        
        .footer-totals-box { background: var(--baslik-bg); border: 1px solid var(--border-soft); border-radius: var(--r-md, 10px); padding: 1rem; width: 100%; }
        .footer-row { display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.85rem; color: var(--metin-2); }
        .footer-row.grand-total { font-weight: 700; font-size: 1rem; border-top: 1px solid var(--border-soft); padding-top: 0.5rem; margin-bottom: 0; }
        
        .action-bar { background: var(--form-bg); border-top: 1px solid var(--border-soft); padding: 1rem 1.5rem; position: sticky; bottom: 0; z-index: 100; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 -4px 12px -2px rgba(0,0,0,.06); }

        .view-mode .searchable-field, .view-mode textarea, .view-mode input { background-color: #f8fafc !important; cursor: not-allowed; pointer-events: none;}
        .view-mode .select2-selection { background-color: #f8fafc !important; cursor: not-allowed; pointer-events: none; }

        .find-mode .searchable-field { background-color: #fef9c3 !important; border-color: #fde047 !important; }
        .find-mode .select2-selection { background-color: #fef9c3 !important; border-color: #fde047 !important; }

        .nav-tabs .nav-link { color: var(--metin-2); font-weight: 600; border: none; padding: 0.75rem 1.25rem; font-size: 0.9rem; cursor: pointer; background: transparent; border-bottom: 2px solid transparent; }
        .nav-tabs .nav-link.active { color: var(--metro-primary, #0d6efd); border-bottom-color: var(--metro-primary, #0d6efd) !important; }
        .nav-tabs .nav-link:hover { color: var(--metro-primary, #3b82f6); }

        /* Firma bilgileri: opsiyonel, doldurulursa belgelere yazilir */
        .firma-kutu { background: var(--baslik-bg); border: 1px dashed var(--border-soft);
                      border-radius: var(--r-md, 10px); padding: 10px 12px; margin-top: 10px; }

        /* Akis secimi */
        .akis-secenek { border: 2px solid var(--border-soft); border-radius: var(--r-md, 10px);
                        padding: 14px; cursor: pointer; transition: .15s; height: 100%; }
        .akis-secenek:hover { border-color: var(--metro-primary, #0d6efd); background: var(--primary-soft); }
        .akis-secenek .zincir { font-family: Consolas, monospace; font-size: .8rem; color: var(--metin-2); }
        
        .address-box input, .address-box select { font-size: 0.8rem; height: 28px; padding: 0.25rem 0.5rem; margin-bottom: 4px; }
        .address-box label { font-size: 0.75rem; color: var(--metin-2); margin-bottom: 2px; }
        .address-box .select2-selection { min-height: 28px !important; height: 28px !important; }
        .address-box .select2-selection__rendered { line-height: 26px !important; font-size: 0.8rem; }
    </style>
}

<div class="container-fluid py-4 pb-5 mb-5" id="mainContainer">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="d-flex align-items-center">
            <h4 class="mb-0 fw-bold text-dark" id="pageTitle"><i class="fas fa-cart-plus text-warning me-2"></i>Satış Siparişi Oluştur</h4>
            <span class="badge bg-secondary fs-6 px-3 py-2 ms-3">@currentDbDisplay</span>
        </div>
        
        <div class="btn-group shadow-sm border bg-white rounded" role="group">
            <button type="button" class="btn btn-light nav-btn" data-dir="first" title="İlk Kayıt"><i class="fas fa-fast-backward"></i></button>
            <button type="button" class="btn btn-light nav-btn" data-dir="prev" title="Önceki Kayıt"><i class="fas fa-step-backward"></i></button>
            <button type="button" class="btn btn-light nav-btn" data-dir="next" title="Sonraki Kayıt"><i class="fas fa-step-forward"></i></button>
            <button type="button" class="btn btn-light nav-btn" data-dir="last" title="Son Kayıt"><i class="fas fa-fast-forward"></i></button>
            <button type="button" class="btn btn-light" id="btnFindMode" title="Kayıt Bul"><i class="fas fa-search text-info"></i></button>
            <button type="button" class="btn btn-light text-primary fw-bold" id="btnNewDoc" title="Yeni Kayıt Ekle"><i class="fas fa-plus"></i></button>
            <button type="button" class="btn btn-light text-warning fw-bold" id="btnCogalt"
                    title="Bu belgeyi çoğalt: aynısını yeni kayıt olarak forma getirir, SAP'ye kaydetmez"
                    style="display:none;"><i class="fas fa-copy"></i></button>
        </div>
    </div>

    <div id="loadingOverlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(255,255,255,0.8); z-index:9999; flex-direction:column; justify-content:center; align-items:center;">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
        <h5 class="mt-3 text-primary fw-bold">İşlem Yapılıyor...</h5>
    </div>

    <form id="orderForm" novalidate>
        <div class="sap-card">
            <div class="sap-card-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="row mb-3 align-items-center">
                            <label class="col-sm-3 form-label mb-0 text-muted">Müşteri <span class="text-danger">*</span></label>
                            <div class="col-sm-9">
                                <select id="CardCode" class="form-select select2-init searchable-field req-add">
                                    <option value="">Müşteri Seçiniz...</option>
                                    @foreach (var customer in customers)
                                    {
                                        <option value="@customer.CardCode" data-name="@customer.CardName">@customer.CardCode - @customer.CardName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row mb-3 align-items-center">
                            <label class="col-sm-3 form-label mb-0 text-muted">Satış Çalışanı <span class="text-danger">*</span></label>
                            <div class="col-sm-9">
                                <select id="SalesPersonCode" class="form-select select2-init searchable-field req-add">
                                    <option value="">Seçiniz...</option>
                                    @foreach (var slp in slps)
                                    {
                                        <option value="@slp.SlpCode">@slp.SlpName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row mb-3 align-items-center">
                            <label class="col-sm-3 form-label mb-0 text-muted">Para Birimi</label>
                            <div class="col-sm-5 pe-1">
                                <select id="CurrencyType" class="form-select form-select-sm searchable-field">
                                    <option value="BP">Muhatabın para birimi</option>
                                    <option value="LC">Ulusal para birimi</option>
                                    <option value="SC">Sistem para birimi</option>
                                </select>
                            </div>
                            <div class="col-sm-4 ps-1">
                                <select id="DocCurrency" class="form-select form-select-sm w-100 searchable-field">
                                    <option value="">Seçiniz</option>
                                    @if(currencies != null)
                                    {
                                        foreach(var c in currencies)
                                        {
                                            <option value="@c">@c</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="row mb-2 align-items-center" id="divDocNumSearch" style="display: none;">
                            <label class="col-sm-4 form-label mb-0 text-md-end text-info fw-bold">Belge Numarası</label>
                            <div class="col-sm-8">
                                <input type="number" id="SearchDocNum" class="form-control form-control-sm border-info" placeholder="Otomatik (Bulmak için buraya yazın)" />
                            </div>
                        </div>

                        @* Etiketler ayri kolon yerine alanlarin USTUNDE duruyor.
                           Boylece yedi alan dort satir yerine iki satira siğiyor ve
                           sagda bos yer kalmiyor. *@
                        <div class="row g-2 mb-2">
                            <div class="col-3">
                                <div class="ust-etiket">Kayıt T. <span class="text-danger">*</span></div>
                                <input type="date" id="DocDate" class="form-control form-control-sm searchable-field req-add" />
                            </div>
                            <div class="col-3">
                                <div class="ust-etiket">Belge T. <span class="text-danger">*</span></div>
                                <input type="date" id="TaxDate" class="form-control form-control-sm searchable-field req-add" />
                            </div>
                            <div class="col-3">
                                <div class="ust-etiket">Teslimat T. <span class="text-danger">*</span></div>
                                <input type="date" id="DocDueDate" class="form-control form-control-sm searchable-field req-add" />
                            </div>
                            <div class="col-3">
                                @* Vade tarihi (talep 26): faturaya yazilir, cari kartin odeme
                                   kosuluna gore otomatik dolar. Teslimat tarihi ise siparis
                                   tarihini takip eder (talep 44). *@
                                <div class="ust-etiket">Vade T.</div>
                                <input type="date" id="VadeTarihi" class="form-control form-control-sm searchable-field" />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-4">
                                <div class="ust-etiket">İşlem Tipi <span class="text-danger">*</span></div>
                                <select id="U_BE1_AKTAR" class="form-select form-select-sm searchable-field req-add">
                                    <option value="">- Seçiniz -</option>
                                    <option value="X">X (Sipariş Formu Yazdır)</option>
                                    <option value="R">R</option>
                                    <option value="Y">Y</option>
                                </select>
                            </div>
                            <div class="col-4">
                                <div class="ust-etiket">Fatura Tipi <span class="text-danger">*</span></div>
                                <select id="U_BE1_SEND" class="form-select form-select-sm searchable-field req-add">
                                    <option value="">- Seçiniz -</option>
                                    <option value="1">1 - SATIS</option>
                                    <option value="2">2 - IADE</option>
                                    <option value="3">3 - ISTISNA</option>
                                    <option value="4">4 - OZELMATRAH</option>
                                    <option value="5">5 - TEVKIFAT</option>
                                    <option value="8">8 - IHRACKAYITLI</option>
                                </select>
                            </div>
                            <div class="col-4">
                                <div class="ust-etiket">Muafiyet Kodu</div>
                                <select id="U_BE1_MUAFCODE" class="form-select form-select-sm searchable-field" disabled>
                                    <option value="">- Muafiyet Kodu -</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    @* ===== İHRACAT (GİB IHRACAT senaryosu) =====
                       Tik işaretlenince ihracat e-faturası için zorunlu alanlar açılır. Yurt dışı müşteri seçilince tik kendiliğinden gelir.
                       Değerler sipariş, irsaliye ve fatura başlığına (U_BE1_* alanları) ve satır GTİP'ine yazılır; e-belge bunları kullanır. *@
                    <div class="col-12 border-top pt-2 mt-1">
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input searchable-field" type="checkbox" id="IhracatTik" style="cursor:pointer;">
                                <label class="form-check-label fw-bold text-primary" for="IhracatTik" style="cursor:pointer;"><i class="fas fa-globe-europe me-1"></i>İhracat</label>
                            </div>
                            <span class="small text-muted" id="ihracatBilgi">İşaretlenince ihracat e-faturası için gereken alanlar açılır; Fatura Tipi ISTISNA ve muafiyet kodu 301 seçilir. Sipariş ve irsaliye normal oluşur, <b>fatura SAP'ye TASLAK olarak kaydedilir</b>.</span>
                        </div>
                        @if (ihrAlanMesajlari.Any())
                        {
                            <div class="alert alert-info py-1 px-2 mt-2 mb-0 small">
                                <i class="fas fa-magic me-1"></i><strong>SAP alan kontrolü:</strong> @string.Join(" | ", ihrAlanMesajlari)
                            </div>
                        }
                        <div id="ihracatPanel" class="mt-2 p-2 rounded" style="display:none; background: var(--primary-soft); border: 1px dashed #93c5fd;">
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <div class="ust-etiket">İhracat Dosya No <span class="text-danger">*</span></div>
                                    <div class="input-group input-group-sm">
                                        <select id="IhrDosyaSecim" class="form-select form-select-sm searchable-field" title="BE1 ihracat dosyaları. Seçince teslim şartı ve ödeme şekli dolar.">
                                            <option value="">- Dosya seç -</option>
                                        </select>
                                        <input type="text" id="IhrDosyaNo" class="form-control form-control-sm searchable-field" placeholder="Dosya no" maxlength="50" style="max-width: 120px;" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="ust-etiket">Teslim Şartı (Incoterm) <span class="text-danger">*</span></div>
                                    <select id="IhrIncoterm" class="form-select form-select-sm searchable-field">
                                        <option value="">- Seçiniz -</option>
                                        @foreach (var k in ihrIncoterms) { <option value="@k.Kod">@k.Ad</option> }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <div class="ust-etiket">Gönderilme Şekli <span class="text-danger">*</span></div>
                                    <select id="IhrTasima" class="form-select form-select-sm searchable-field">
                                        <option value="">- Seçiniz -</option>
                                        @foreach (var k in ihrTasima) { <option value="@k.Kod">@k.Ad</option> }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <div class="ust-etiket">Kap Cinsi <span class="text-danger">*</span></div>
                                    <select id="IhrKapCinsi" class="form-select form-select-sm searchable-field">
                                        <option value="">- Seçiniz -</option>
                                        @foreach (var k in ihrKapCinsleri) { <option value="@k.Kod">@k.Ad</option> }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <div class="ust-etiket">Kap Adedi <span class="text-danger">*</span></div>
                                    <input type="number" id="IhrKapAdedi" class="form-control form-control-sm searchable-field" min="1" step="1" placeholder="örn. 5" />
                                </div>
                                <div class="col-md-3">
                                    <div class="ust-etiket">Kap / Konteyner No <span class="text-danger">*</span></div>
                                    <input type="text" id="IhrKapNo" class="form-control form-control-sm searchable-field" maxlength="50" placeholder="örn. MSKU1234567 veya PALET-1" />
                                </div>
                                <div class="col-md-3">
                                    <div class="ust-etiket">Kap Markası</div>
                                    <input type="text" id="IhrKapMarka" class="form-control form-control-sm searchable-field" maxlength="50" placeholder="isteğe bağlı" />
                                </div>
                                <div class="col-md-4">
                                    <div class="ust-etiket">Ödeme Şekli</div>
                                    <select id="IhrOdemeSekli" class="form-select form-select-sm searchable-field">
                                        <option value="">- Seçiniz -</option>
                                        @foreach (var k in ihrOdemeSekli) { <option value="@k.Kod">@k.Ad</option> }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <div class="ust-etiket">Ödeme Kanalı</div>
                                    <select id="IhrOdemeKanali" class="form-select form-select-sm searchable-field">
                                        <option value="">- Seçiniz -</option>
                                        @foreach (var k in ihrOdemeKanali) { <option value="@k.Kod">@k.Ad</option> }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <div class="ust-etiket">IBAN</div>
                                    <input type="text" id="IhrIban" class="form-control form-control-sm searchable-field" maxlength="34" placeholder="TR.. (isteğe bağlı)" />
                                </div>
                                <div class="col-md-4">
                                    <div class="ust-etiket">Teslim Ülkesi (sevk adresinden)</div>
                                    <input type="text" id="IhrUlkeGoster" class="form-control form-control-sm bg-light" readonly placeholder="Lojistik › Sevk adresi ülkesi" />
                                </div>
                                <div class="col-12 small text-muted">
                                    <i class="fas fa-info-circle me-1"></i>Her kalem satırında <b>GTİP</b> (12 hane) zorunludur; kalem kartındaki GTİP otomatik gelir. Sevk adresinin ülkesi Türkiye olamaz.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 border-top pt-3 mt-1">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="d-flex align-items-center">
                                    <label class="form-label mb-0 text-muted me-2" style="width: 70px; text-align: right;">Belge Kuru</label>
                                    <input type="text" id="ExchangeRate" class="form-control form-control-sm bg-light fw-bold text-end flex-grow-1" readonly value="1.0000" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="d-flex align-items-center">
                                    <label class="form-label mb-0 text-muted me-2" style="width: 70px; text-align: right;">USD Kuru</label>
                                    <input type="number" id="USDRate" class="form-control form-control-sm text-end fw-bold searchable-field flex-grow-1" step="0.0001" value="0.0000" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="d-flex align-items-center">
                                    <label class="form-label mb-0 text-muted me-2" style="width: 70px; text-align: right;">EUR Kuru</label>
                                    <input type="number" id="EURRate" class="form-control form-control-sm text-end fw-bold searchable-field flex-grow-1" step="0.0001" value="0.0000" />
