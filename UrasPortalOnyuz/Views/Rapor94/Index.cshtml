                                html += `<tr>
                                            <td class="fw-bold text-dark">${m.itemCode}</td>
                                            <td class="text-muted small">${m.itemName}</td>
                                            <td><span class="badge bg-secondary">${m.warehouseCode}</span></td>
                                            <td class="text-end fw-bold">${formatNumber(m.required)}</td>
                                            <td class="text-end">${formatNumber(m.currentStock)}</td>
                                            <td class="text-end text-danger fw-bold">${formatNumber(m.missing)}</td>
                                         </tr>`;
                            });
                            
                            $('#missingStockBody').html(html);
