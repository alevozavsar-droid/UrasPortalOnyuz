                    });

                    $('#ShipToCode').html(shipHtml);
                    $('#PayToCode').html(payHtml);
                    
                    if(res.find(a => a.addressType === 'S')) $('#ShipToCode').val(res.find(a => a.addressType === 'S').addressName).trigger('change');
                    if(res.find(a => a.addressType === 'B')) $('#PayToCode').val(res.find(a => a.addressType === 'B').addressName).trigger('change');
