            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal Et</button>
                <button type="button" class="btn btn-success fw-bold px-4" id="btnConfirmMissingStock"><i class="fas fa-check me-2"></i>Onayla ve İşleme Devam Et</button>
