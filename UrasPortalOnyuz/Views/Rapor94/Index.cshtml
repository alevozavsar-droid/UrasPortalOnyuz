                                        <i class="fas fa-save me-1"></i> Sisteme Kuru Kaydet
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="sap-card" id="tabsCard">
            <div class="sap-card-header p-0 border-bottom-0 bg-light">
                <ul class="nav nav-tabs border-bottom-0" id="orderTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" id="lines-tab" data-toggle="tab" data-bs-toggle="tab" href="#lines-pane" role="tab">İçerikler</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="logistics-tab" data-toggle="tab" data-bs-toggle="tab" href="#logistics-pane" role="tab">Lojistik</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="transport-tab" data-toggle="tab" data-bs-toggle="tab" href="#transport-pane" role="tab">Nakliye</a>
                    </li>
                </ul>
                <div class="pe-3 py-2" id="btnAddRowContainer">
                    <button type="button" class="btn btn-sm btn-outline-secondary bg-white fw-bold shadow-sm" id="btnAddRow">
                        <i class="fas fa-plus text-success me-1"></i> Kalem Ekle
                    </button>
                </div>
            </div>
            
            <div class="tab-content border-top" id="orderTabsContent">
                <div class="tab-pane fade show active" id="lines-pane" role="tabpanel">
                    <div class="table-responsive" style="min-height: 250px; overflow-y:visible;">
                        <table class="table-modern border-0" id="linesTable">
                            <thead>
                                <tr>
                                    <th style="width: 40px;" class="text-center">#</th>
                                    @* Bosluk kalem kolonuna birakilir; serbest metin dar tutulur ki
                                       sagdaki tutar kolonlari tam gorunsun (uzun metin icin tooltip var). *@
                                    @* Genislik icerige gore: kisa kalem adinda daralir, uzun adda
                                       belli bir sinira kadar genisler, sonrasinda "..." ile kesilir. *@
                                    <th style="min-width: 130px; max-width: 150px;">Kalem No - Tanım <span class="text-danger">*</span></th>
                                    <th style="width: 120px; max-width: 120px;">Serbest Metin / Lot</th>
                                    <th style="width: 120px;">Depo / Stok <span class="text-danger">*</span></th>
                                    <th style="width: 110px;" class="text-end">Miktar / 2.Birim <span class="text-danger">*</span></th>
                                    <th style="width: 190px; min-width: 190px;" class="text-end">Birim Fiyat &amp; PB <span class="text-danger">*</span></th>
                                    <th style="width: 110px;">Vergi Kodu <span class="text-danger">*</span></th>
                                    <th style="width: 185px; min-width: 185px;" class="text-end">Toplam <span id="toplamKolonPB" class="text-muted fw-normal"></span></th>
                                    <th style="width: 40px;" class="text-center" id="colDelIcon"><i class="fas fa-trash text-muted"></i></th>
                                </tr>
                            </thead>
                            <tbody id="linesBody">
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade p-4 bg-white" id="logistics-pane" role="tabpanel">
                    <div class="row g-5">
                        <div class="col-md-6 address-box">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                <i class="fas fa-truck text-secondary me-2"></i>Sevkiyat Adresi
                                <a href="#" id="copyToPayTo" class="small float-end text-decoration-none text-primary"><i class="fas fa-arrow-right me-1"></i>Fatura Adresine Kopyala</a>
                            </h6>
                            <div class="d-flex gap-2 mb-3">
                                <select id="ShipToCode" class="form-select form-select-sm searchable-field flex-grow-1">
                                    <option value="">- Seçiniz -</option>
                                </select>
                                <button type="button" class="btn btn-sm btn-outline-success searchable-field" onclick="saveAddressToBP('S')" title="Formdaki bu adresi Cariye Kaydet">
                                    <i class="fas fa-save"></i> Cariye Ekle
                                </button>
                            </div>
                            
                            <div class="row g-2">
                                <div class="col-12"><label>Adres Satır 1 <span class="text-danger">*</span></label><input type="text" id="ShipToStreet" class="form-control searchable-field" /></div>
                                <div class="col-12"><label>Adres Satır 2 (Ek Bilgi)</label><input type="text" id="ShipToStreetNo" class="form-control searchable-field" /></div>
                                <div class="col-12"><label>Adres Satır 3</label><input type="text" id="ShipToBlock" class="form-control searchable-field" /></div>
                                <div class="col-6"><label>Posta Kodu <span class="text-danger">*</span></label><input type="text" id="ShipToZipCode" class="form-control searchable-field" /></div>
                                <div class="col-6"><label>İlçe / Semt <span class="text-danger">*</span></label><input type="text" id="ShipToCounty" class="form-control searchable-field" /></div>
                                <div class="col-6">
                                    <label>Ülke/Bölge <span class="text-danger">*</span></label>
                                    <select id="ShipToCountry" class="form-select select2-init searchable-field">
                                        <option value="">- Seçiniz -</option>
                                        @foreach (var c in countries) { <option value="@c.Code">@c.Name</option> }
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label>İl / Eyalet (Devlet) <span class="text-danger">*</span></label>
                                    <select id="ShipToState" class="form-select select2-init searchable-field">
                                        <option value="">- Seçiniz -</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 address-box">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                <i class="fas fa-file-invoice-dollar text-secondary me-2"></i>Fatura Adresi
                                <a href="#" id="copyToShipTo" class="small float-end text-decoration-none text-primary"><i class="fas fa-arrow-left me-1"></i>Sevk Adresine Kopyala</a>
                            </h6>
                            <div class="d-flex gap-2 mb-3">
                                <select id="PayToCode" class="form-select form-select-sm searchable-field flex-grow-1">
                                    <option value="">- Seçiniz -</option>
                                </select>
                                <button type="button" class="btn btn-sm btn-outline-success searchable-field" onclick="saveAddressToBP('B')" title="Formdaki bu adresi Cariye Kaydet">
                                    <i class="fas fa-save"></i> Cariye Ekle
                                </button>
                            </div>
                            
                            <div class="row g-2">
                                <div class="col-12"><label>Adres Satır 1 <span class="text-danger">*</span></label><input type="text" id="PayToStreet" class="form-control searchable-field" /></div>
                                <div class="col-12"><label>Adres Satır 2 (Ek Bilgi)</label><input type="text" id="PayToStreetNo" class="form-control searchable-field" /></div>
                                <div class="col-12"><label>Adres Satır 3</label><input type="text" id="PayToBlock" class="form-control searchable-field" /></div>
                                <div class="col-6"><label>Posta Kodu <span class="text-danger">*</span></label><input type="text" id="PayToZipCode" class="form-control searchable-field" /></div>
                                <div class="col-6"><label>İlçe / Semt <span class="text-danger">*</span></label><input type="text" id="PayToCounty" class="form-control searchable-field" /></div>
                                <div class="col-6">
                                    <label>Ülke/Bölge <span class="text-danger">*</span></label>
                                    <select id="PayToCountry" class="form-select select2-init searchable-field">
                                        <option value="">- Seçiniz -</option>
                                        @foreach (var c in countries) { <option value="@c.Code">@c.Name</option> }
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label>İl / Eyalet (Devlet) <span class="text-danger">*</span></label>
                                    <select id="PayToState" class="form-select select2-init searchable-field">
                                        <option value="">- Seçiniz -</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade p-4 bg-white" id="transport-pane" role="tabpanel">
                    <div class="row g-5">
                        <div class="col-md-6 address-box">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fas fa-id-card text-secondary me-2"></i>Şoför Bilgileri</h6>
                            
                            <div class="d-flex align-items-end gap-2 mb-3">
                                <div class="flex-grow-1">
                                    <label class="fw-bold text-primary">Kayıtlı Şoför Seçin <span class="text-danger">*</span></label>
                                    <select id="DriverListSelect" class="form-select select2-init searchable-field req-add">
                                        <option value="">- Seçiniz -</option>
                                        @if(drivers != null)
                                        {
                                            foreach(var d in drivers)
                                            {
                                                <option value="@d.DocEntry">@d.Name (@d.Plate)</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <button type="button" class="btn btn-primary mb-1 shadow-sm" id="btnOpenNewDriverModal"><i class="fas fa-plus me-1"></i>Yeni Şoför Ekle</button>
                            </div>

                            <div class="row g-2 mt-2 pt-2 border-top">
                                <div class="col-12">
                                    <label>Şoför Ad/Soyad <span class="text-danger">*</span></label>
                                    <input type="text" id="U_BE1_SRCNAME" class="form-control bg-light" readonly />
                                </div>
                                <div class="col-12">
                                    <label>Şoför Plaka <span class="text-danger">*</span></label>
                                    <input type="text" id="U_BE1_SRCPLAKA" class="form-control bg-light" readonly />
                                </div>
                                <div class="col-12">
                                    <label>Şoför Ünvanı</label>
                                    <input type="text" id="U_BE1_SRCTITLE" class="form-control bg-light" readonly />
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6 address-box">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fas fa-truck-loading text-secondary me-2"></i>Nakliye ve Ek Bilgiler</h6>
                            
                            <div class="row g-2">
                                <div class="col-6 mb-2">
                                    <label class="form-label mb-1 text-primary fw-bold">Nakliye Tarihi <span class="text-danger">*</span></label>
                                    <input type="date" id="U_BE1_NAKLIYETARIHI" class="form-control form-control-sm searchable-field req-add" />
                                </div>
                                <div class="col-6 mb-2">
                                    <label class="form-label mb-1 text-primary fw-bold">Nakliye Saati <span class="text-danger">*</span></label>
                                    <input type="time" id="U_BE1_NAKLIYESAATI" class="form-control form-control-sm searchable-field req-add" />
                                </div>

                                <div class="col-12 mt-2 pt-2 border-top">
                                    <label>TC Kimlik No (VKN) <span class="text-danger">*</span></label>
                                    <input type="text" id="U_BE1_SRCVKN" class="form-control bg-light" readonly />
                                </div>
                                <div class="col-4">
                                    <label>KVKK Onay (E/H)</label>
                                    <input type="text" id="U_BE1_SRCKVKK" class="form-control bg-light" readonly />
                                </div>
                                <div class="col-4">
                                    <label>Telefon</label>
                                    <input type="text" id="U_BE1_SRCTEL" class="form-control bg-light" readonly />
                                </div>
                            </div>

                            <!-- Nakliyeci firma bilgileri: opsiyonel. Doldurulursa
                                 sipariş, irsaliye ve faturaya birlikte yazılır. -->
                            <div class="firma-kutu">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="fw-bold small"><i class="fas fa-building me-1 text-secondary"></i>Nakliyeci Firma Bilgileri</span>
                                    <span class="badge bg-secondary-subtle text-secondary border">opsiyonel</span>
                                </div>
                                @* Nakliyeci firma artik SAP'deki [@@BE1_NAKLIYEFIRMA]
                                   listesinden secilir; listede yoksa "Yeni" ile eklenir.
                                   Secim, asagidaki uc alani doldurur ve kayit mantigi
                                   eskisi gibi bu alanlar uzerinden calisir. *@
                                <div class="row g-2 align-items-end">
                                    <div class="col-8">
                                        <label>Nakliyeci Firma</label>
                                        <select id="NakliyeFirmaSecim" class="form-select searchable-field">
                                            <option value="">- Seçiniz -</option>
                                            @foreach (var f in nakliyeFirmalari)
                                            {
                                                <option value="@f.FirmaAdi" data-no="@f.FirmaNo" data-vkn="@f.FirmaVkn">
                                                    @f.FirmaAdi @(string.IsNullOrWhiteSpace(f.FirmaVkn) ? "" : "(" + f.FirmaVkn + ")")
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-4">
                                        <button type="button" class="btn btn-outline-primary w-100" id="btnYeniNakliyeFirma">
                                            <i class="fas fa-plus me-1"></i> Yeni Firma
                                        </button>
                                    </div>
                                </div>

                                <div class="row g-2 mt-1">
                                    <div class="col-4">
                                        <label>Firma No</label>
                                        <input type="text" id="U_BE1_FIRMANO" class="form-control bg-light searchable-field" placeholder="-" readonly />
                                    </div>
                                    <div class="col-4">
                                        <label>Firma Ünvanı</label>
                                        <input type="text" id="U_BE1_FIRMAADI" class="form-control bg-light searchable-field" placeholder="-" readonly />
                                    </div>
                                    <div class="col-4">
                                        <label>Firma Vergi No</label>
                                        <input type="text" id="U_BE1_FIRMAVKN" class="form-control bg-light searchable-field" placeholder="-" readonly />
                                    </div>
                                </div>
                                <div class="small mt-2" style="color:var(--metin-2);">
                                    Boş bırakılabilir. Doldurulursa sipariş, irsaliye ve faturaya birlikte kaydedilir.
                                </div>
                            </div>
                            
                            <div class="alert alert-info mt-4 py-2 small">
                                <i class="fas fa-info-circle me-1"></i> Not: Seçilen şoför ve nakliye bilgileri SAP üzerinde doğrudan Teslimat (e-İrsaliye) ve Fatura (e-Fatura) kayıtlarına işlenecektir.
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="row mt-3" id="footerSection">
            <div class="col-lg-8 mb-3">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label text-muted fw-bold mb-1"><i class="fas fa-file-alt text-primary me-1"></i>Sipariş Açıklaması</label>
                        <textarea id="OrderComments" class="form-control bg-white border shadow-sm searchable-field" rows="4" style="resize:none; font-size:0.85rem;"></textarea>
                        <div class="form-check mt-2">
                            <input class="form-check-input searchable-field" type="checkbox" id="OrderDescFlag" value="Y">
                            <label class="form-check-label small fw-bold text-secondary" for="OrderDescFlag">Sipariş Formunda Göster</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted fw-bold mb-1"><i class="fas fa-truck text-warning me-1"></i>İrsaliye Açıklaması</label>
                        <textarea id="DeliveryComments" class="form-control bg-white border shadow-sm searchable-field" rows="4" style="resize:none; font-size:0.85rem;"></textarea>
                        <div class="form-check mt-2">
                            <input class="form-check-input searchable-field" type="checkbox" id="DeliveryDescFlag" value="Y">
                            <label class="form-check-label small fw-bold text-secondary" for="DeliveryDescFlag">İrsaliyede Göster</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted fw-bold mb-1"><i class="fas fa-file-invoice-dollar text-success me-1"></i>Fatura Açıklaması</label>
                        <textarea id="InvoiceComments" class="form-control bg-white border shadow-sm searchable-field" rows="4" style="resize:none; font-size:0.85rem;"></textarea>
                        <div class="form-check mt-2">
                            <input class="form-check-input searchable-field" type="checkbox" id="InvoiceDescFlag" value="Y">
                            <label class="form-check-label small fw-bold text-secondary" for="InvoiceDescFlag">Faturada Göster</label>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4">
                @* Butun tutarlar BELGE PARA BIRIMINDE gosterilir.
                   TL karsiligi gosterilmez; belge USD ise ekranda USD gorunur. *@
                <div class="footer-totals-box shadow-sm w-100">
                    <div class="footer-row">
                        <span>İndirim öncesi toplam</span>
                        <span id="lblNetTotalFC">0,00</span>
                    </div>
                    <div class="footer-row">
                        <span>Vergi</span>
                        <span id="lblTaxTotalFC">0,00</span>
                    </div>
                    <div class="footer-row grand-total">
                        <span>Genel Toplam</span>
                        <span id="lblGrandTotalFC" class="text-success">0,00</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="action-bar fixed-bottom">
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light border px-4" id="btnCancel">İptal</button>
                <button type="button" class="btn btn-danger px-4 shadow-sm" id="btnCancelDocument" style="display:none;">
                    <i class="fas fa-ban me-1"></i>Belgeyi İptal Et
                </button>
            </div>
            
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-secondary px-4 shadow-sm" id="btnPrintDocument" style="display:none;">
                    <i class="fas fa-print me-1"></i>Sipariş Formu Yazdır
                </button>
                
                <div class="btn-group dropup" id="btnCopyToContainer" style="display:none;">
                    <button type="button" class="btn btn-outline-primary dropdown-toggle fw-bold bg-white" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-copy me-1"></i> Kopyala Hedef
                    </button>
                    <ul class="dropdown-menu shadow-sm mb-2">
                        <li><a class="dropdown-item copy-to-target" href="#" data-target="Rapor108"><i class="fas fa-truck text-muted me-2"></i>Teslimat</a></li>
                        <li><a class="dropdown-item copy-to-target" href="#" data-target="Rapor109"><i class="fas fa-file-invoice-dollar text-muted me-2"></i>Satış Faturası</a></li>
                    </ul>
                </div>
                
                <button type="submit" class="btn btn-warning px-5 shadow-sm fw-bold" id="btnSave">SAP'ye Ekle</button>
            </div>
        </div>
    </form>
</div>

