<!-- YENİ ŞOFÖR MODAL -->
<div class="modal fade" id="newDriverModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-user-plus me-2"></i>Yeni Şoför Kaydı</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="frmNewDriver">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label mb-1">Ad/Soyad <span class="text-danger">*</span></label>
                            <input type="text" id="nd_Name" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label mb-1">Plaka <span class="text-danger">*</span></label>
                            <input type="text" id="nd_Plate" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label mb-1">Ünvan</label>
                            <input type="text" id="nd_Title" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label mb-1">TC / VKN <span class="text-danger">*</span></label>
                            <input type="text" id="nd_VKN" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label mb-1">Telefon</label>
                            <input type="text" id="nd_Tel" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label mb-1">Firma No</label>
                            <input type="text" id="nd_FirmaNo" class="form-control form-control-sm" />
