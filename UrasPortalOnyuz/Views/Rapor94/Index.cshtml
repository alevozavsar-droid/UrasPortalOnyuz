            });

            $(document).on('input', '.input-qty, .input-price', function () { if(currentMode === 'ADD') calculateTotals(); });

            // Kolon dar oldugu icin uzun metin kesilir; tamami tooltip'te durur.
            $(document).on('input', '.input-freetxt', function () {
                $(this).attr('title', $(this).val() || 'Serbest Metin / Lot');
            });
            // BEDELSİZ SATIR: fiyat 0 girildiğinde KDV kodu S05'e (%0 KDV'den muaf)
            // çekilir ve istisna alanları hatırlatılır. 'input' yerine 'change'
            // kullanılıyor; aksi hâlde "0" yazıp "10" yapmaya çalışırken tetiklenirdi.
            $(document).on('change', '.input-price', function () {
                if (currentMode !== 'ADD') return;

                var fiyat = parseFloat($(this).val()) || 0;
                if (fiyat !== 0) return;

                var kdv = $(this).closest('tr').find('.input-vat');
                if (kdv.find('option[value="S05"]').length && kdv.val() !== 'S05') {
                    kdv.val('S05');
                    calculateTotals();
                    toastr.info("Bedelsiz satır: KDV kodu S05 (%0 KDV'den muaf) olarak ayarlandı.");
                }

                if (!$('#U_BE1_SEND').val() || !$('#U_BE1_MUAFCODE').val()) {
                    toastr.warning("Bedelsiz satış için <strong>Fatura Tipi</strong> ve <strong>Muafiyet Kodu</strong> alanlarını doldurmayı unutmayın.",
                                   "İstisna bilgisi gerekli", { timeOut: 8000, enableHtml: true });
                }
            });

            $(document).on('change', '.input-vat, .input-currency', function () { if(currentMode === 'ADD') calculateTotals(); });

            // ---- Toplamdan birim fiyat (talep 34) --------------------------
            // Birim fiyat her zaman bilinmiyor; kullanici satir toplamini yazar,
            // birim fiyat miktara bolunerek bulunur.
            $(document).on('change', '.input-line-total', function () {
                if (currentMode !== 'ADD') return;

                var satir = $(this).closest('tr');
                var toplam = parseFloat($(this).val());
                if (isNaN(toplam)) { calculateTotals(); return; }

                var miktar = parseFloat(satir.find('.input-qty').val()) || 0;
                if (miktar <= 0) {
                    toastr.warning('Önce miktar giriniz; birim fiyat toplama göre hesaplanamadı.');
                    calculateTotals();
                    return;
                }

                // Girilen toplam BELGE para biriminde; birim fiyat ise SATIR para
                // biriminde tutuluyor. Ters cevrim yapilir:
                //   toplamTL   = toplamBelge * belgeKuru
                //   fiyatSatir = toplamTL / satirKuru / miktar
                var belgePB = $('#DocCurrency').val() || 'TRY';
                var satirPB = satir.find('.input-currency').val() || 'TRY';

                var belgeKuruStr = $('#ExchangeRate').val();
                var belgeKuru = 1.0;
                if (belgeKuruStr) belgeKuru = parseFloat(belgeKuruStr.replace(/\./g, '').replace(',', '.')) || 1.0;

                var satirKuru = parseFloat(window.exchangeRates[satirPB]) || (satirPB === belgePB ? belgeKuru : 1.0);

                if (satirKuru <= 0) {
                    toastr.warning(satirPB + ' kuru bulunamadı; birim fiyatı elle giriniz.');
                    calculateTotals();
                    return;
                }

                var fiyat = (toplam * belgeKuru) / satirKuru / miktar;
                satir.find('.input-price').val(fiyat.toFixed(4));
                calculateTotals();
            });

            // ---- Belge para birimi -> satir para birimi (talep 34) ---------
            // Ustteki belge para birimi degisince acik satirlarin hepsi ona doner.
            // Ayri bir islev: belge para birimi bazi yollarda (Kur Tipi secimi)
            // 'change' tetiklenmeden degistiriliyor, oradan da cagrilabilsin.
            window.satirParaBirimleriniEsitle = function () {
                if (isBindingData || currentMode !== 'ADD') return;

                var pb = $('#DocCurrency').val();
                if (!pb) return;

                var degisen = 0;
                $('#linesBody tr').each(function () {
                    var sec = $(this).find('.input-currency');
                    if (sec.length && sec.val() !== pb && sec.find('option[value="' + pb + '"]').length) {
                        sec.val(pb);
                        degisen++;
                    }
                });

                if (degisen > 0) {
                    calculateTotals();
                    toastr.info(degisen + ' satırın para birimi ' + pb + ' olarak güncellendi.');
                }
            };

            $('#DocCurrency').on('change', function () { window.satirParaBirimleriniEsitle(); });

            $(document).on('change', '.item-select', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                
                const row = $(this).closest('tr');
                const itemCode = $(this).val();
                const cardCode = $('#CardCode').val();
                
                const priceInput = row.find('.input-price');
                const curInput = row.find('.input-currency');
                const whsInput = row.find('.input-whs');
                const stockInput = row.find('.input-stock');
                const secNameInput = row.find('.input-sec-name');
                const multiplierInput = row.find('.input-sec-multiplier');
                const freeTxtInput = row.find('.input-freetxt');
                const gtipInput = row.find('.input-gtip');

                if (!itemCode) {
                    priceInput.val(0);
                    stockInput.text('0');
                    multiplierInput.val(0);
                    freeTxtInput.val('');
                    calculateTotals();
                    return;
                }

                if (!whsInput.val()) {
                    whsInput.val('01');
                }
                whsInput.trigger('change'); 

                if(cardCode) {
                    $.get('/Rapor94/GetItemPrice', { cardCode: cardCode, itemCode: itemCode }, function(res) {
                        // FİYAT KENDİ PARA BİRİMİNDE GELİR.
                        //
                        // Cariye özel fiyat (OSPP) ya da fiyat listesi kaydı
                        // hangi para birimindeyse satır o para birimine çekilir
                        // ve tutar OLDUĞU GİBİ yazılır. Önceden fiyat belge para
                        // birimine çevriliyordu; çevrim için o günün kuru gerekli
                        // olduğundan kur yoksa fiyat 0 kalıyordu ve özel fiyat
                        // hiç gelmiyor gibi görünüyordu.
                        //
                        // Fiyat bulunamazsa satır belge para birimiyle açılır.
                        var belgePB = $('#DocCurrency').val() || 'TRY';

                        function satirParaBirimiSabitle() {
                            if (curInput.find('option[value="' + belgePB + '"]').length) curInput.val(belgePB);
                        }

                        if (res && res.hata) {
                            // Sunucu fiyatı okuyamadı; sessiz 0 yerine sebebi görünsün.
                            toastr.error(res.hata, 'Fiyat alınamadı', { timeOut: 12000 });
                        }

                        if(res) {
                            // Kalem kartındaki GTİP ihracat satırına ön değer olarak gelir (kullanıcı değiştirebilir).
                            if (res.gtip && !gtipInput.val()) gtipInput.val(res.gtip);
                            if (res.gtipAd) gtipInput.attr("title", "GTİP: " + (res.gtip || "") + " - " + res.gtipAd);

                            var kalemPB = res.currency || belgePB;
                            var fiyat = parseFloat(res.price) > 0 ? parseFloat(res.price) : 0;

                            if (fiyat > 0) {
                                // Fiyatın kendi para birimi satıra uygulanır.
                                if (curInput.find('option[value="' + kalemPB + '"]').length) {
                                    curInput.val(kalemPB);
                                } else {
                                    satirParaBirimiSabitle();
                                    if (kalemPB !== belgePB) {
                                        toastr.warning(kalemPB + ' para birimi satır listesinde yok; '
                                                     + 'fiyat ' + belgePB + ' olarak bırakıldı, kontrol edin.');
                                    }
                                }
                            } else {
                                satirParaBirimiSabitle();
                            }

                            priceInput.val(fiyat > 0 ? fiyat.toFixed(4) : 0);
                            // NOT: burada satirParaBirimiSabitle() CAGRILMAZ; para birimi
                            // yukarida fiyatin kendi birimine ayarlandi, tekrar cagirmak
                            // onu belge para birimine geri cevirip fiyati yanlis birimde
                            // birakiyordu.
                            secNameInput.text(res.secUnitName || '');
                            multiplierInput.val(res.secUnitMultiplier || 0);
                            freeTxtInput.val(res.freeTxt || '');
                            
                            if(res.dfltWH && res.dfltWH !== whsInput.val()) {
                                whsInput.val(res.dfltWH).trigger('change');
                            }
                        } else {
                            priceInput.val(0);
                            satirParaBirimiSabitle();
                            multiplierInput.val(0);
                            freeTxtInput.val('');
                        }
                        calculateTotals();
                    });
                }
            });

            $(document).on('change', '.input-whs', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                
                const row = $(this).closest('tr');
                const itemCode = row.find('.item-select').val();
                const whsCode = $(this).val();
                const stockInput = row.find('.input-stock');
                
                if (itemCode && whsCode) {
                    $.get('/Rapor94/GetItemStock', { itemCode: itemCode, whsCode: whsCode }, function(res) {
                        stockInput.text(formatNumber(res.onHand || 0));
                    });
                } else {
                    stockInput.text('0');
                }
            });

            $('#orderForm').submit(function (e) {
                e.preventDefault();
                
                if(currentMode === 'FIND') {
                    const searchPayload = {
                        DocNum: $('#SearchDocNum').val() ? parseInt($('#SearchDocNum').val()) : null,
                        CardCode: $('#CardCode').val(),
                        SlpCode: $('#SalesPersonCode').val() ? parseInt($('#SalesPersonCode').val()) : null,
                        DocDate: $('#DocDate').val() || null, 
                        DocDueDate: $('#DocDueDate').val() || null,
                        TaxDate: $('#TaxDate').val() || null,
                        U_BE1_AKTAR: $('#U_BE1_AKTAR').val(),
                        U_BE1_SEND: $('#U_BE1_SEND').val(),
                        U_BE1_MUAFCODE: $('#U_BE1_MUAFCODE').val(),
                        DocCurrency: $('#DocCurrency').val()
                    };
                    
                    $('#loadingOverlay').css('display', 'flex');
                    
                    $.ajax({
                        url: '/Rapor94/FindOrder',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(searchPayload),
                        success: function (res) {
                            if (res.success && res.data && res.data.length > 0) {
                                if (res.data.length === 1) {
                                    loadOrderDetailsFromId(res.data[0].docEntry);
                                } else {
                                    populateSearchResults(res.data);
                                }
                            } else {
                                toastr.warning(res.message || "Kayıt bulunamadı.");
                            }
                        },
                        error: function () { toastr.error("Arama sırasında hata oluştu."); },
                        complete: function () { $('#loadingOverlay').hide(); }
                    });
                    
                    return;
                }
                
                if(currentMode === 'VIEW') return;

                const cardCode = $('#CardCode').val();
                const cardName = $('#CardCode option:selected').data('name') || "";
                
                if (!cardCode) { toastr.warning("Lütfen müşteri seçiniz."); return; }
                if (!$('#SalesPersonCode').val()) { toastr.warning("Lütfen satış temsilcisi seçiniz."); return; }
                if (!$('#DocDate').val() || !$('#DocDueDate').val() || !$('#TaxDate').val()) { toastr.warning("Lütfen tüm tarihleri eksiksiz giriniz."); return; }
                
                // Şoför VEYA nakliyeci firma: ikisinden biri yeterli. Nakliyeci seçildiyse şoför boş kalabilir.
                var soforSecili = !!$('#DriverListSelect').val();
                var soforTam = !!($('#U_BE1_SRCNAME').val() && $('#U_BE1_SRCPLAKA').val() && $('#U_BE1_SRCVKN').val());
                var nakliyeVar = !!($('#U_BE1_FIRMAADI').val() || $('#U_BE1_FIRMAVKN').val());

                if (!soforTam && !nakliyeVar) {
                    toastr.warning(soforSecili
                        ? "Seçilen şoförün Ad/Soyad, Plaka ve TC/VKN bilgileri eksik. Bilgileri tamamlayın ya da nakliyeci firma seçin."
                        : "Lütfen şoför veya nakliyeci firma seçiniz. İkisinden biri yeterlidir.");
                    $('#transport-tab').tab('show');
                    return;
                }

                if (!$('#ShipToStreet').val() || !$('#ShipToCounty').val() || !$('#ShipToZipCode').val() || !$('#ShipToCountry').val() || !$('#ShipToState').val()) {
                    toastr.warning("Sevkiyat adresi için Adres Satır 1, İlçe, İl/Eyalet, Posta Kodu ve Ülke alanları zorunludur.");
                    $('#logistics-tab').tab('show');
                    return;
                }

                if (!$('#PayToStreet').val() || !$('#PayToCounty').val() || !$('#PayToZipCode').val() || !$('#PayToCountry').val() || !$('#PayToState').val()) {
                    toastr.warning("Fatura adresi için Adres Satır 1, İlçe, İl/Eyalet, Posta Kodu ve Ülke alanları zorunludur.");
                    $('#logistics-tab').tab('show');
                    return;
                }

                const documentLines = [];
                let hasError = false;

                $('#linesBody tr').each(function (index) {
                    const itemCode = $(this).find('.item-select').val();
                    const freeTxt = $(this).find('.input-freetxt').val() || '';
                    const qty = parseFloat($(this).find('.input-qty').val()) || 0;
                    const price = parseFloat($(this).find('.input-price').val()) || 0;
                    const lineCur = $(this).find('.input-currency').val();
                    const vatGroup = $(this).find('.input-vat').val();
                    const whsCode = $(this).find('.input-whs').val(); 

                    if (!itemCode) { hasError = true; toastr.error(`${index + 1}. satırda kalem seçiniz.`); return false; }
                    if (!whsCode) { hasError = true; toastr.error(`${index + 1}. satır için depo seçiniz.`); return false; }
                    if (qty <= 0) { hasError = true; toastr.error(`${index + 1}. satır için miktar 0'dan büyük olmalıdır.`); return false; }
                    // BEDELSİZ SATIŞ (talep 26): fiyat 0 olabilir.
                    // Yalnızca negatif fiyat engellenir; 0 bilinçli bir bedelsiz satırdır.
                    if (price < 0) { hasError = true; toastr.error(`${index + 1}. satır için fiyat negatif olamaz.`); return false; }
                    if (!vatGroup) { hasError = true; toastr.error(`${index + 1}. satır için işlem tipi (KDV) seçiniz.`); return false; }

                    documentLines.push({ 
                        ItemCode: itemCode, 
                        Quantity: qty, 
                        UnitPrice: price, 
                        Currency: lineCur, 
                        VatGroup: vatGroup,
                        WarehouseCode: whsCode,
                        FreeTxt: freeTxt,
                        Gtip: ($(this).find('.input-gtip').val() || '').trim()
                    });
                });

                if (hasError) {
                    $('#lines-tab').tab('show');
                    return;
                }

                if (documentLines.length === 0) {
                    toastr.warning("Siparişe en az bir kalem ekleyiniz.");
                    $('#lines-tab').tab('show');
                    return;
                }

                // BEDELSİZ SATIŞ KONTROLÜ
                //
                // GİB, KDV tutarı 0 olan satırlar için istisna/muafiyet sebebini
                // zorunlu tutar. Fatura Tipi ve Muafiyet Kodu seçilmezse fatura
                // QNB şematronundan döner ("cbc:TaxExemptionReason ... bulunmalıdır").
                // Bu yüzden sipariş aşamasında engelleniyor.
                if (documentLines.some(function (l) { return (parseFloat(l.UnitPrice) || 0) === 0; })) {
                    if (!$('#U_BE1_SEND').val() || !$('#U_BE1_MUAFCODE').val()) {
                        toastr.error("Bedelsiz (fiyatı 0) satır var. Üstteki <strong>Fatura Tipi</strong> ve <strong>Muafiyet Kodu</strong> alanlarını doldurmadan fatura GİB'e gönderilemez.",
                                     "Eksik istisna bilgisi", { timeOut: 9000, enableHtml: true });
                        $('#U_BE1_SEND').focus();
                        return;
                    }
                }

                // İHRACAT: tik açıksa zorunlu alanlar ve satır GTİP'leri kaydetmeden önce denetlenir.
                const ihrHata = ihracatDogrula();
                if (ihrHata) { toastr.error(ihrHata, 'İhracat bilgisi eksik', { timeOut: 9000 }); return; }

                const docCur = $('#DocCurrency').val() || 'TRY';
                let docRateStr = $('#ExchangeRate').val().replace(/\./g, '').replace(',', '.');
                let docRate = parseFloat(docRateStr) || 1.0;

                const payload = {
                    Ihracat: ihracatPayload(),
                    CardCode: cardCode,
                    CardName: cardName,
                    DocDate: $('#DocDate').val(),
                    DocDueDate: $('#DocDueDate').val(),
                    VadeTarihi: $('#VadeTarihi').val() || null,
