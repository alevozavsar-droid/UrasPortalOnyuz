                        $('#SalesPersonCode').val(res.slpCode).trigger('change.select2');
                    }

                    // Yurt dışı müşteri: İhracat tiki kendiliğinden açılır (kullanıcı kapatabilir).
                    ihracatMusteri(res);

                    // Müşteri seçildiğinde teslimat ve vade tarihi ödeme koşuluna göre dolar.
                    window.cariVadeGun = res.extraDays || 0;
