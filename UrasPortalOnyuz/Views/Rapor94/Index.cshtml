</div>

<template id="rowTemplate">
    <tr>
        <td class="text-center align-middle row-index text-muted small fw-bold">1</td>
        <td>
            <select class="form-select item-select req-add">
                <option value="">- Kalem Seçin / Yazarak Arayın -</option>
            </select>
            @* İhracat: GTİP (12 hane). Yalnızca İhracat tiki açıkken görünür; kalem kartından ön değer gelir. *@
            <input type="text" class="table-input input-gtip mt-1" placeholder="GTİP (12 hane)" title="GTİP numarası (ihracat)" maxlength="16" style="display:none; font-size:0.78rem;" />
        </td>
        <td class="align-middle">
            <input type="text" class="table-input input-freetxt" placeholder="Serbest Metin / Lot"
                   title="Serbest Metin / Lot" />
        </td>
        <td class="align-middle">
            <select class="form-select form-select-sm table-input input-whs req-add" style="font-size: 0.8rem; padding: 2px 4px; min-height:26px;">
                <option value="">Depo Seç</option>
                @foreach (var whs in warehouses)
                {
                    if(whs.WhsCode == "01")
                    {
                        <option value="@whs.WhsCode" selected="selected">@whs.WhsCode</option>
                    }
                    else
                    {
                        <option value="@whs.WhsCode">@whs.WhsCode</option>
                    }
                }
            </select>
            <div class="small text-muted mt-1" style="font-size:0.75rem;">Stok: <span class="input-stock fw-bold text-dark">0</span></div>
        </td>
        <td class="align-middle text-end">
            <input type="number" class="table-input text-end input-qty fw-medium req-add" value="1" min="0.01" step="0.01" />
            <div class="small text-muted mt-1" style="font-size:0.75rem;">
                <span class="input-sec-total fw-bold text-dark">0</span> <span class="input-sec-name"></span>
            </div>
            <input type="hidden" class="input-sec-multiplier" value="0" />
        </td>
        <td>
            <div class="input-group input-group-sm">
                <input type="number" class="form-control text-end input-price fw-medium req-add" value="0.00" min="0" step="0.0001" />
                <select class="form-select input-currency text-center fw-bold text-muted px-1 req-add" style="max-width: 65px;">
                    @if(currencies != null)
                    {
                        foreach(var c in currencies)
                        {
                            <option value="@c">@c</option>
                        }
                    }
                </select>
            </div>
            @* Talep 43: birim fiyatin diger para birimindeki karsiligi goz ucuyla
               gorulebilsin diye satirin altinda kucuk ve salt okunur durur. *@
            <div class="small text-muted mt-1 fiyat-karsilik" style="font-size:0.72rem; min-height:1em;"></div>
        </td>
        <td>
            <select class="form-select form-select-sm table-input input-vat req-add">
                <option value="">İşlem Tipi Seç</option>
                @foreach(var vat in vatGroups)
                {
                    <option value="@vat.Code" data-rate="@vat.Rate">@vat.Code (@vat.Rate.ToString("0")%)</option>
                }
            </select>
        </td>
        @* Satir toplami yazilabilir: birim fiyat bilinmiyorsa toplam girilir,
           birim fiyat miktara bolunerek hesaplanir (talep 34). *@
        <td class="text-end align-middle">
            <input type="number" class="table-input text-end fw-bold text-secondary input-line-total small"
                   step="0.01" min="0" placeholder="0,00" title="Toplam yazarsanız birim fiyat miktara göre hesaplanır" />
        </td>
        <td class="text-center align-middle del-cell">
            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-row p-1 border-0" title="Sil"><i class="fas fa-times fs-6"></i></button>
        </td>
    </tr>
</template>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    <script>
        toastr.options = { positionClass: "toast-bottom-right", timeOut: "3000" };

        let currentBpCurrency = 'TRY'; 
        window.exchangeRates = { 'TRY': 1.0 }; 
        window.bpAddresses = []; 
        
        let currentMode = 'ADD'; 
        let isBindingData = false; 
        let currentDocEntry = 0; 

        const allMuafCodes = @Html.Raw(Json.Serialize(ViewBag.MuafCodes ?? new List<WebApplication3.Controllers.Rapor94Controller.MuafCodeModel>()));
        const allStates = @Html.Raw(Json.Serialize(states));
        let allDrivers = @Html.Raw(Json.Serialize(drivers)); 

        const itemDict = {};
        @foreach(var item in items) {
            <text>itemDict['@item.ItemCode'] = '@item.ItemName.Replace("'", "\\'")';</text>
        }

        // -----------------------------------------------------------------
        // TESLİMAT ve VADE TARİHİ (talep 26)
        //
        // Cari kartın ödeme koşulundan (OCTG.ExtraDays / ExtraMonth) hesaplanır.
        // Teslimat tarihi siparişe/irsaliyeye, vade tarihi faturaya yazılır.
        // Kullanıcı ikisini de elle değiştirebilir. Bu fonksiyon yalnızca yeni
        // kayıt modunda çalışır ve cari ya da belge tarihi değiştiğinde her iki
        // alanı da yeniden hesaplar (elle girilen değerin üzerine yazar).
        // -----------------------------------------------------------------
        function vadeTarihleriniHesapla() {
            if (typeof currentMode !== 'undefined' && currentMode !== 'ADD') return;

            var belgeTarihi = $('#DocDate').val();
            if (!belgeTarihi) return;

            var d = new Date(belgeTarihi);
            d.setMonth(d.getMonth() + (window.cariVadeAy || 0));
            d.setDate(d.getDate() + (window.cariVadeGun || 0));
            var hesap = d.toISOString().split('T')[0];

            // TESLIMAT TARIHI ODEME KOSULUNDAN GELMEZ (talep 44).
            //
            // Onceden musterinin vade gun/ay bilgisi hem vadeye hem teslimat
            // tarihine yaziliyordu; sonucta teslimat tarihi kendiliginden
            // ileri bir tarihe kayiyordu. Artik odeme kosulu YALNIZCA vadeyi
            // belirler; teslimat tarihi siparis tarihini takip eder ve elle
            // degistirilebilir.
            $('#VadeTarihi').val(hesap);

            if (!window.teslimatElleDegisti) $('#DocDueDate').val(belgeTarihi);
        }

        function formatNumber(num) {
            return num.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function formatItemDropdown(item) {
            if (item.loading) { return item.text; }
            if (!item.id) { return item.text; }
            
            var stockInfo = item.stock || $(item.element).data('stock') || "Stok Yok";

            var $result = $(
                '<div>' +
                '<div style="font-weight:600; color:#1e293b;">' + item.text + '</div>' +
                '<div style="font-size:0.8rem; color:#10b981; margin-top:2px;">' +
                '<i class="fas fa-boxes me-1"></i>' + stockInfo + 
                '</div>' +
                '</div>'
            );
            return $result;
        }

        $('#orderTabs a').on('click', function (e) {
            e.preventDefault();
            $(this).tab('show'); 
            if($(this).attr('id') === 'lines-tab' && currentMode === 'ADD') {
                $('#btnAddRowContainer').show();
            } else {
                $('#btnAddRowContainer').hide();
            }
        });

        window.saveAddressToBP = function(type) {
            if (currentMode !== 'ADD') return;
            const cardCode = $('#CardCode').val();
            if(!cardCode) { toastr.warning("Önce müşteri seçmelisiniz."); return; }

            const prefix = type === 'S' ? 'ShipTo' : 'PayTo';
            const street = $(`#${prefix}Street`).val();
            const country = $(`#${prefix}Country`).val();
            
            if(!street || !country) { 
                toastr.warning("Adres satırı 1 ve Ülke/Bölge boş bırakılamaz."); 
                return; 
            }

            const promptMsg = type === 'S' ? "Sevkiyat adresi için bir Adres Tanıtıcı (İsim) belirleyin (Örn: Şube 1):" : "Fatura adresi için bir Adres Tanıtıcı (İsim) belirleyin (Örn: Merkez):";
            const addrName = prompt(promptMsg);
            if(!addrName) return;

            const payload = {
                AddressName: addrName,
                AddressType: type,
                Street: street,
                StreetNo: $(`#${prefix}StreetNo`).val(),
                Block: $(`#${prefix}Block`).val(),
                ZipCode: $(`#${prefix}ZipCode`).val(),
                City: $(`#${prefix}State option:selected`).text() !== '- Seçiniz -' ? $(`#${prefix}State option:selected`).text() : '',
                County: $(`#${prefix}County`).val(),
                State: $(`#${prefix}State`).val(),
                Country: country
            };

            $('#loadingOverlay').css('display', 'flex');
            $.ajax({
                url: `/Rapor94/SaveBPAddress?cardCode=${cardCode}`,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    if(res.success) {
                        toastr.success(res.message);
                        $.get('/Rapor94/GetCustomerAddresses', { cardCode: cardCode }, function(addressesRes) {
                            window.bpAddresses = addressesRes;
                            let html = '<option value="">- Seçiniz -</option>';
                            addressesRes.forEach(a => {
                                if(a.addressType === type) html += `<option value="${a.addressName}">${a.addressName}</option>`;
                            });
                            $(`#${prefix}Code`).html(html).val(addrName).trigger('change');
                        });
                    } else {
                        toastr.error(res.message);
                    }
                },
                error: function (xhr) {
                    // Sunucu hatanin sebebini { success:false, message:"..." }
                    // olarak donuyor; eskiden bu yutulup yalnizca "Sunucu hatasi"
                    // yaziliyordu ve sorunun ne oldugu hic gorunmuyordu.
                    var mesaj = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : null;
                    if (!mesaj && xhr.responseText) {
                        try { mesaj = (JSON.parse(xhr.responseText) || {}).message; } catch (e) { }
                    }
                    toastr.error(mesaj || ('Adres kaydedilemedi. (HTTP ' + xhr.status + ')'), '', { timeOut: 9000 });
                },
                complete: function() { $('#loadingOverlay').hide(); }
            });
        };

        // ---- NAKLİYECİ FİRMA (SAP: [@@BE1_NAKLIYEFIRMA]) --------------------
        // Secim, kayitta kullanilan uc alani doldurur; alanlar salt okunur.
        function nakliyeFirmaUygula() {
            var sec = $('#NakliyeFirmaSecim').find('option:selected');
            $('#U_BE1_FIRMAADI').val(sec.val() || '');
            $('#U_BE1_FIRMANO').val(sec.data('no') || '');
            $('#U_BE1_FIRMAVKN').val(sec.data('vkn') || '');
        }

        $(document).on('change', '#NakliyeFirmaSecim', nakliyeFirmaUygula);

        $(document).on('click', '#btnYeniNakliyeFirma', function () {
            if (currentMode !== 'ADD') { toastr.warning('Yeni firma yalnızca ekleme modunda tanımlanabilir.'); return; }
            $('#yeniFirmaAdi, #yeniFirmaNo, #yeniFirmaVkn').val('');
            new bootstrap.Modal(document.getElementById('yeniNakliyeFirmaModal')).show();
        });

        $(document).on('click', '#btnYeniFirmaKaydet', function () {
            var ad = ($('#yeniFirmaAdi').val() || '').trim();
            if (!ad) { toastr.warning('Firma ünvanı zorunludur.'); return; }

            var dugme = $(this).prop('disabled', true);

            $.ajax({
                url: '/Rapor94/NakliyeFirmaEkle',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    FirmaAdi: ad,
                    FirmaNo: ($('#yeniFirmaNo').val() || '').trim(),
                    FirmaVkn: ($('#yeniFirmaVkn').val() || '').trim()
                }),
                success: function (res) {
                    if (!res.success) { toastr.error(res.message); return; }
                    toastr.success(res.message);

                    // Listeyi tazele ve yeni firmayi sec.
                    $.getJSON('/Rapor94/NakliyeFirmalari', function (liste) {
                        var html = '<option value="">- Seçiniz -</option>';
                        (liste || []).forEach(function (f) {
                            html += '<option value="' + f.firmaAdi + '" data-no="' + (f.firmaNo || '')
                                  + '" data-vkn="' + (f.firmaVkn || '') + '">' + f.firmaAdi
                                  + (f.firmaVkn ? ' (' + f.firmaVkn + ')' : '') + '</option>';
                        });
                        $('#NakliyeFirmaSecim').html(html).val(ad);
                        nakliyeFirmaUygula();
                    });

                    bootstrap.Modal.getInstance(document.getElementById('yeniNakliyeFirmaModal')).hide();
                },
                error: function (xhr) {
                    var m = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : null;
                    toastr.error(m || ('Firma eklenemedi. (HTTP ' + xhr.status + ')'), '', { timeOut: 9000 });
                },
                complete: function () { dugme.prop('disabled', false); }
            });
        });

        $('#DriverListSelect').on('change', function() {
            if(isBindingData || currentMode !== 'ADD') return;
            const docEntry = $(this).val();
            if(docEntry) {
                const driver = allDrivers.find(d => d.docEntry === docEntry);
                if(driver) {
                    $('#U_BE1_SRCNAME').val(driver.name);
                    $('#U_BE1_SRCPLAKA').val(driver.plate);
                    $('#U_BE1_SRCTITLE').val(driver.title);
                    $('#U_BE1_SRCVKN').val(driver.vkn);
                    $('#U_BE1_SRCKVKK').val(driver.kvkk);
                    $('#U_BE1_FIRMANO').val(driver.firmaNo);
                    $('#U_BE1_SRCTEL').val(driver.tel);
                }
            } else {
                $('#U_BE1_SRCNAME, #U_BE1_SRCPLAKA, #U_BE1_SRCTITLE, #U_BE1_SRCVKN, #U_BE1_SRCKVKK, #U_BE1_FIRMANO, #U_BE1_SRCTEL').val('');
                $('#NakliyeFirmaSecim').val(''); $('#U_BE1_FIRMAADI, #U_BE1_FIRMAVKN').val('');
            }
        });

        $('#btnOpenNewDriverModal').click(function() {
            if(currentMode !== 'ADD') return;
            $('#frmNewDriver')[0].reset();
            $('#newDriverModal').modal('show');
        });

        $('#btnSaveNewDriver').click(function() {
            const name = $('#nd_Name').val();
            const plate = $('#nd_Plate').val();
            const vkn = $('#nd_VKN').val();
            
            if(!name || !plate || !vkn) {
                toastr.warning("Ad/Soyad, Plaka ve TC/VKN alanları zorunludur.");
                return;
            }

            const payload = {
                Name: name,
                Plate: plate,
                Title: $('#nd_Title').val(),
                VKN: vkn,
                KVKK: $('#nd_KVKK').is(':checked') ? 'E' : 'H',
                FirmaNo: $('#nd_FirmaNo').val(),
                Tel: $('#nd_Tel').val()
            };

            const btn = $(this);
            btn.prop('disabled', true).text('Kaydediliyor...');

            $.ajax({
                url: '/Rapor94/AddDriver',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    if(res.success) {
                        toastr.success("Şoför sisteme eklendi ve seçildi.");
                        allDrivers.unshift(res.data);
                        const newOption = new Option(`${res.data.name} (${res.data.plate})`, res.data.docEntry, true, true);
                        $('#DriverListSelect').append(newOption).trigger('change');
                        $('#newDriverModal').modal('hide');
                    } else {
                        toastr.error(res.message);
                    }
                },
                error: function() {
                    toastr.error("Sunucu bağlantı hatası.");
                },
                complete: function() {
                    btn.prop('disabled', false).text('Kaydet & Seç');
                }
            });
        });

        function populateStates(countrySelectId, stateSelectId, selectedState = '') {
            const countryCode = $('#' + countrySelectId).val();
            const stateSelect = $('#' + stateSelectId);
            
            stateSelect.empty().append('<option value="">- Seçiniz -</option>');
            
            if(countryCode) {
                const filteredStates = allStates.filter(s => s.country === countryCode);
                filteredStates.forEach(s => {
                    stateSelect.append(`<option value="${s.code}">${s.name}</option>`);
                });
            }
            if(selectedState) {
                stateSelect.val(selectedState).trigger('change.select2');
            }
        }

        function fillAddressComponent(prefix, addr) {
            $(`#${prefix}Street`).val(addr ? addr.street : '');
            $(`#${prefix}StreetNo`).val(addr ? addr.streetNo : '');
            $(`#${prefix}Block`).val(addr ? addr.block : '');
            $(`#${prefix}ZipCode`).val(addr ? addr.zipCode : '');
            $(`#${prefix}County`).val(addr ? addr.county : '');
            
            if(addr && addr.country) {
                $(`#${prefix}Country`).val(addr.country).trigger('change.select2');
                populateStates(`${prefix}Country`, `${prefix}State`, addr.state);
            } else {
                $(`#${prefix}Country`).val('').trigger('change.select2');
                $(`#${prefix}State`).empty().append('<option value="">- Seçiniz -</option>');
            }
        }

        $('#ShipToCountry').on('change', function() {
            if(!isBindingData) populateStates('ShipToCountry', 'ShipToState');
        });
        $('#PayToCountry').on('change', function() {
            if(!isBindingData) populateStates('PayToCountry', 'PayToState');
        });

        $('#copyToPayTo').click(function(e) {
            e.preventDefault();
            $('#PayToStreet').val($('#ShipToStreet').val());
            $('#PayToStreetNo').val($('#ShipToStreetNo').val());
            $('#PayToBlock').val($('#ShipToBlock').val());
            $('#PayToZipCode').val($('#ShipToZipCode').val());
            $('#PayToCounty').val($('#ShipToCounty').val());
            
            let country = $('#ShipToCountry').val();
            $('#PayToCountry').val(country).trigger('change.select2');
            populateStates('PayToCountry', 'PayToState', $('#ShipToState').val());
        });

        $('#copyToShipTo').click(function(e) {
            e.preventDefault();
            $('#ShipToStreet').val($('#PayToStreet').val());
            $('#ShipToStreetNo').val($('#PayToStreetNo').val());
            $('#ShipToBlock').val($('#PayToBlock').val());
            $('#ShipToZipCode').val($('#PayToZipCode').val());
            $('#ShipToCounty').val($('#PayToCounty').val());
            
            let country = $('#PayToCountry').val();
            $('#ShipToCountry').val(country).trigger('change.select2');
            populateStates('ShipToCountry', 'ShipToState', $('#PayToState').val());
        });

        // temizle = false verilirse ADD moduna gecerken form SIFIRLANMAZ.
        // Belge cogaltmada bu gerekli: once kayit forma yuklenir, sonra ekran
        // "yeni kayit" durumuna cevrilir ama degerler yerinde kalir.
        function setFormMode(mode, isClosed = false, isCanceled = false, temizle = true) {
            currentMode = mode;
            
            $('#pageTitle .badge.bg-danger').remove(); 
            $('#pageTitle .badge.bg-secondary.status-badge').remove(); 
            $('#pageTitle .badge.bg-success.status-badge').remove(); 
            
            if (mode === 'VIEW') {
                $('#mainContainer').removeClass('find-mode').addClass('view-mode');
                $('.searchable-field').prop('disabled', true);
                
                $('#OrderComments, #DeliveryComments, #InvoiceComments').prop('disabled', true);
                $('#UpdateGlobalRates').prop('disabled', true);
                $('#USDRate, #EURRate').prop('disabled', true);
                
                $('#U_BE1_NAKLIYETARIHI, #U_BE1_NAKLIYESAATI').prop('disabled', true);

                $('.req-add').prop('required', false);

                $('#DocNum').val(currentDocEntry).prop('disabled', true);
                $('#btnCogalt').show();   // acik belge cogaltilabilir

                $('#btnAddRowContainer, .del-cell, #colDelIcon').hide();
                $('#btnSave').hide();
                $('#btnOpenNewDriverModal').hide(); 
                $('#divDocNumSearch').hide();
                $('#tabsCard, #footerSection').show();
                
                $('#btnCancel').text("Yeni Ekle").removeClass('btn-light').addClass('btn-primary text-white').prop('disabled', false);
                $('#btnPrintDocument').show();

                if (isCanceled) {
                    $('#btnCancelDocument').hide();
                    $('#btnCopyToContainer').hide();
                    $('#pageTitle').append(' <span class="badge bg-danger ms-2 fs-6 status-badge">İPTAL EDİLMİŞ</span>');
                } else if (isClosed) {
                    $('#btnCancelDocument').show(); 
                    $('#btnCopyToContainer').hide();
                    $('#pageTitle').append(' <span class="badge bg-secondary ms-2 fs-6 status-badge">KAPALI (Faturalı)</span>');
                } else {
                    $('#btnCancelDocument').show();
                    $('#btnCopyToContainer').show();
                    $('#pageTitle').append(' <span class="badge bg-success ms-2 fs-6 status-badge">AÇIK</span>');
                }
            } 
            else if (mode === 'FIND') {
                $('#mainContainer').removeClass('view-mode').addClass('find-mode');
                
                $('.searchable-field').prop('disabled', false).val('');
                $('#CardCode').val('').trigger('change.select2');
                $('#SalesPersonCode').val('').trigger('change.select2');
                $('#U_BE1_SEND').val('');
                ihracatSifirla();
                $('#U_BE1_MUAFCODE').empty().append('<option value="">- Muafiyet Kodu -</option>').prop('disabled', false);
                $('#DriverListSelect').val('').trigger('change.select2');
                $('#U_BE1_SRCNAME, #U_BE1_SRCPLAKA, #U_BE1_SRCTITLE, #U_BE1_SRCVKN, #U_BE1_SRCKVKK, #U_BE1_FIRMANO, #U_BE1_SRCTEL').val('');
                $('#NakliyeFirmaSecim').val(''); $('#U_BE1_FIRMAADI, #U_BE1_FIRMAVKN').val('');
                
                $('#OrderDescFlag, #DeliveryDescFlag, #InvoiceDescFlag').prop('checked', false);
                $('#UpdateGlobalRates').prop('checked', false);

                $('#ShipToCode, #PayToCode').empty().append('<option value="">- Seçiniz -</option>');
                fillAddressComponent('ShipTo', null);
                fillAddressComponent('PayTo', null);

                $('#divDocNumSearch').show();
                $('#SearchDocNum').prop('disabled', false).val('').focus();
                $('#ExchangeRate').val('');
                $('#USDRate, #EURRate').val('0.0000').prop('disabled', true);
                
                $('#OrderComments, #DeliveryComments, #InvoiceComments').prop('disabled', true).val('');
                
                $('#U_BE1_NAKLIYETARIHI, #U_BE1_NAKLIYESAATI').val('');

                $('.req-add').prop('required', false);

                $('#btnAddRowContainer, .del-cell, #colDelIcon').hide();
                $('#tabsCard, #footerSection').hide(); 

                $('#btnSave').show().text("Ara").removeClass('btn-warning').addClass('btn-info text-white').html('<i class="fas fa-search me-2"></i>Ara');
                
                $('#btnCancelDocument').hide();
                $('#btnCopyToContainer').hide();
                $('#btnPrintDocument').hide();
                
                $('#btnOpenNewDriverModal').hide(); 
                $('#btnCancel').text("İptal").removeClass('btn-primary text-white').addClass('btn-light').prop('disabled', false);
                $('#pageTitle').html('<i class="fas fa-search text-info me-2"></i>Kayıt Bul');
                
                $('#linesBody').empty(); 
                resetTotals();
            }
            else { 
                $('#mainContainer').removeClass('view-mode find-mode');
                
                $('.searchable-field').prop('disabled', false);
                $('#USDRate, #EURRate').prop('disabled', false);
                $('#UpdateGlobalRates').prop('disabled', false);
                
                $('#OrderComments, #DeliveryComments, #InvoiceComments').prop('disabled', false).val('');
                
                $('.req-add').prop('required', true);

                $('#DocNum').val('').prop('disabled', true);
                $('#ExchangeRate').prop('readonly', true); 

                if($('#lines-tab').hasClass('active')) $('#btnAddRowContainer').show();
                
                $('.del-cell, #colDelIcon').show();
                $('#tabsCard, #footerSection').show();
                $('#btnOpenNewDriverModal').show(); 
                
                $('#btnSave').show().removeClass('btn-info text-white').addClass('btn-warning').html('SAP\'ye Ekle');
                
                $('#btnCancelDocument').hide();
                $('#btnCopyToContainer').hide();
                $('#btnPrintDocument').hide();
                $('#btnCogalt').hide();   // yeni kayitta cogaltilacak belge yok
                
                $('#btnCancel').text("İptal").removeClass('btn-primary text-white').addClass('btn-light');
                $('#divDocNumSearch').hide();
                
                $('#pageTitle').html('<i class="fas fa-cart-plus text-warning me-2"></i>Satış Siparişi Oluştur');
                currentDocEntry = 0;
                
                if (!temizle) return;   // cogaltma: degerler korunur

                isBindingData = true;
                $('#orderForm')[0].reset();
                $('#CardCode').val('').trigger('change.select2');
                $('#SalesPersonCode').val('').trigger('change.select2');
                $('#DriverListSelect').val('').trigger('change.select2');
                $('#U_BE1_SRCNAME, #U_BE1_SRCPLAKA, #U_BE1_SRCTITLE, #U_BE1_SRCVKN, #U_BE1_SRCKVKK, #U_BE1_FIRMANO, #U_BE1_SRCTEL').val('');
                $('#NakliyeFirmaSecim').val(''); $('#U_BE1_FIRMAADI, #U_BE1_FIRMAVKN').val('');
                
                $('#OrderDescFlag, #DeliveryDescFlag, #InvoiceDescFlag').prop('checked', false);
                $('#UpdateGlobalRates').prop('checked', false);
                
                $('#U_BE1_SEND').val('1').trigger('change');
                ihracatSifirla();

                $('#DocCurrency').val('');
                $('#U_BE1_AKTAR').val('');
                $('#linesBody').empty();

                $('#ShipToCode, #PayToCode').empty().append('<option value="">- Seçiniz -</option>');
                fillAddressComponent('ShipTo', null);
                fillAddressComponent('PayTo', null);
                window.bpAddresses = [];
                
                const today = new Date();
                const yyyy_mm_dd = today.toISOString().split('T')[0];
                const hh_mm = today.toTimeString().substring(0,5);

                $('#DocDate').val(yyyy_mm_dd);
                $('#TaxDate').val(yyyy_mm_dd);
                
                $('#U_BE1_NAKLIYETARIHI').val(yyyy_mm_dd);
                $('#U_BE1_NAKLIYESAATI').val(hh_mm);

                // Teslimat tarihi varsayilan olarak SIPARIS TARIHI (bugun).
                window.teslimatElleDegisti = false;
                $('#DocDueDate').val(yyyy_mm_dd);
                // Cari secilene kadar vade = belge tarihi (talep 26)
                window.cariVadeGun = 0; window.cariVadeAy = 0;
                $('#VadeTarihi').val(yyyy_mm_dd);
                
                addRow();
                calculateTotals();
                isBindingData = false;
            }
        }

        function loadOrderDetailsFromId(docEntry) {
            $('#loadingOverlay').css('display', 'flex');
            $.get('/Rapor94/GetOrderDetails', { docEntry: docEntry }, function(res) {
                if(res && res.success && res.data) {
                    bindOrderToForm(res.data);
                } else {
                    toastr.error(res.message || "Sipariş detayları alınamadı.");
                }
            }).fail(function() {
                toastr.error("Kayıt çekilirken hata oluştu.");
            }).always(function() {
                $('#loadingOverlay').hide();
            });
        }

        // bittiginde: yukleme TAMAMEN bittikten sonra calisir. Fonksiyonun sonu
        // kur sorgusunun icinde (asenkron) oldugu icin, cagiran taraf hemen
        // ardindan ekran modunu degistirirse VIEW modu uzerine yaziyordu.
        function bindOrderToForm(res, bittiginde) {
            isBindingData = true; 
            currentDocEntry = res.docEntry;
            
            $('#pageTitle').html(`<i class="fas fa-file-invoice text-primary me-2"></i>Sipariş Görüntüle (No: ${res.docNum})`);
            
            $('#CardCode').val(res.cardCode).trigger('change.select2');
            $('#SalesPersonCode').val(res.slpCode).trigger('change.select2');
            $('#DocDate').val(res.docDate);
            $('#DocDueDate').val(res.docDueDate);
            // Kayitli sipariste ayri bir vade alani tutulmuyor; teslimat tarihi gosterilir.
            $('#VadeTarihi').val(res.docDueDate);
            $('#TaxDate').val(res.taxDate);
            $('#U_BE1_AKTAR').val(res.u_BE1_AKTAR || res.U_BE1_AKTAR);
            
            $('#OrderDescFlag').prop('checked', (res.u_BE1_DESPATCHDESC || res.U_BE1_DESPATCHDESC) === 'Y');
            
            $('#OrderComments').val(res.comments);
            $('#DeliveryComments').val(res.deliveryComments);
            $('#InvoiceComments').val(res.invoiceComments);
            
            $('#U_BE1_NAKLIYETARIHI').val(res.u_BE1_NAKLIYETARIHI || res.U_BE1_NAKLIYETARIHI || '');
            $('#U_BE1_NAKLIYESAATI').val(res.u_BE1_NAKLIYESAATI || res.U_BE1_NAKLIYESAATI || '');

            let sendType = res.u_BE1_SEND || res.U_BE1_SEND;
            $('#U_BE1_SEND').val(sendType).trigger('change');
            
            let muaf = res.u_BE1_MUAFCODE || res.U_BE1_MUAFCODE;
            if(muaf) {
                $('#U_BE1_MUAFCODE').html(`<option value="${muaf}">${muaf}</option>`).val(muaf);
            }

            $('#ShipToCode').html(`<option value="${res.shipToCode}">${res.shipToCode}</option>`).val(res.shipToCode);
            $('#PayToCode').html(`<option value="${res.payToCode}">${res.payToCode}</option>`).val(res.payToCode);
            
            if(res.addressExtension) {
                fillAddressComponent('ShipTo', {
                    street: res.addressExtension.shipToStreet, streetNo: res.addressExtension.shipToStreetNo,
                    block: res.addressExtension.shipToBlock, zipCode: res.addressExtension.shipToZipCode,
                    county: res.addressExtension.shipToCounty,
                    state: res.addressExtension.shipToState, country: res.addressExtension.shipToCountry
                });
                fillAddressComponent('PayTo', {
                    street: res.addressExtension.billToStreet, streetNo: res.addressExtension.billToStreetNo,
                    block: res.addressExtension.billToBlock, zipCode: res.addressExtension.billToZipCode,
                    county: res.addressExtension.billToCounty,
                    state: res.addressExtension.billToState, country: res.addressExtension.billToCountry
                });
            } else {
                fillAddressComponent('ShipTo', null);
                fillAddressComponent('PayTo', null);
            }

            $('#DriverListSelect').val(res.u_BE1_SOFORSECIMI || res.U_BE1_SOFORSECIMI || '').trigger('change.select2');
            $('#U_BE1_SRCNAME').val(res.u_BE1_SRCNAME || res.U_BE1_SRCNAME || '');
            $('#U_BE1_SRCPLAKA').val(res.u_BE1_SRCPLAKA || res.U_BE1_SRCPLAKA || '');
            $('#U_BE1_SRCTITLE').val(res.u_BE1_SRCTITLE || res.U_BE1_SRCTITLE || '');
            $('#U_BE1_SRCVKN').val(res.u_BE1_SRCVKN || res.U_BE1_SRCVKN || '');
            $('#U_BE1_SRCKVKK').val(res.u_BE1_SRCKVKK || res.U_BE1_SRCKVKK || '');
            $('#U_BE1_FIRMANO').val(res.u_BE1_FIRMANO || res.U_BE1_FIRMANO || '');
            $('#U_BE1_FIRMAADI').val(res.u_BE1_FIRMAADI || res.U_BE1_FIRMAADI || '');
            // Kayitli belgedeki firma listede varsa secili gelsin.
            $('#NakliyeFirmaSecim').val(res.u_BE1_FIRMAADI || res.U_BE1_FIRMAADI || '');
            $('#U_BE1_FIRMAVKN').val(res.u_BE1_FIRMAVKN || res.U_BE1_FIRMAVKN || '');
            $('#U_BE1_SRCTEL').val(res.u_BE1_SRCTEL || res.U_BE1_SRCTEL || '');

            ihracatBind(res.ihracat || res.Ihracat);

            $('#DocCurrency').val(res.docCurrency);
            $('#ExchangeRate').val(res.docRate.toLocaleString('tr-TR', { minimumFractionDigits: 4, maximumFractionDigits: 4 }));
            
            window.exchangeRates[res.docCurrency] = res.docRate;

            $.get('/Rapor94/GetAllExchangeRates', { date: res.docDate }, function(rates) {
                window.exchangeRates = rates;
                $('#USDRate').val((rates['USD'] || 0).toFixed(4));
                $('#EURRate').val((rates['EUR'] || 0).toFixed(4));
                
                let rowsHtml = '';
                let netLC = 0, taxLC = 0;
                
                res.lines.forEach((line, index) => {
                    let itemName = line.itemName || itemDict[line.itemCode] || '';
                    let displayTitle = itemName ? `${line.itemCode} - ${itemName}` : line.itemCode;
                    // KAYITLI SIPARISTE SAP'NIN KENDI KURU KULLANILIR.
                    //
                    // Onceden kur, guncel kur tablosundan aranip bulunamazsa 1.0
                    // aliniyordu; boyle olunca EUR satirin tutari TL yerine doviz
                    // rakami olarak toplaniyor ve TRY belgede toplam yanlis
                    // (dovizli) cikiyordu. Artik belgeye kaydedilmis kur esastir.
                    let lineRate = (parseFloat(line.lineRate) > 0)
                        ? parseFloat(line.lineRate)
                        : (window.exchangeRates[line.currency] || (line.currency === res.docCurrency ? res.docRate : 1.0));
                    
                    let secQty = line.quantity * line.secUnitMultiplier;
                    let lineNetFC = line.quantity * line.unitPrice;
                    // SAP'nin sakladigi yerel tutar varsa dogrudan o kullanilir.
                    let lineNetLC = (parseFloat(line.lineTotalLC) > 0)
                        ? parseFloat(line.lineTotalLC)
                        : (lineNetFC * lineRate);

                    // Toplam kolonu BELGE para birimindedir: yerel tutar belgenin
                    // kuruna bolunur (TRY belgede kur 1, yani TL karsiligi yazar).
                    let belgeKuru = parseFloat(res.docRate) > 0 ? parseFloat(res.docRate) : 1.0;
                    let lineNetDoc = lineNetLC / belgeKuru;
                    
                    let vatObj = @Html.Raw(Json.Serialize(ViewBag.VatGroups));
                    let foundVat = vatObj.find(v => v.code === line.vatGroup);
                    let vRate = foundVat ? foundVat.rate : 0;
                    let lineTaxLC = lineNetLC * (vRate / 100);

                    netLC += lineNetLC;
                    taxLC += lineTaxLC;

                    rowsHtml += `
                    <tr>
                        <td class="text-center align-middle text-muted small fw-bold">${index + 1}</td>
                        <td class="align-middle fw-medium">${displayTitle}${line.gtip ? `<div class="small text-muted fw-normal" style="font-size:0.72rem;">GTİP: ${line.gtip}</div>` : ''}</td>
                        <td class="align-middle">
                            <input type="text" class="table-input text-start fw-medium input-freetxt" value="${line.freeTxt || ''}" title="${line.freeTxt || ''}" readonly />
                        </td>
                        <td class="align-middle">
                            <select class="form-select form-select-sm table-input input-whs" disabled style="font-size: 0.8rem; padding: 2px 4px; min-height:26px;">
                                <option value="${line.warehouseCode}">${line.warehouseCode}</option>
                            </select>
                            <div class="small text-muted mt-1" style="font-size:0.75rem;">Stok: -</div>
                        </td>
                        <td class="align-middle text-end">
                            <input type="text" class="table-input text-end fw-medium" value="${line.quantity}" readonly />
                            <div class="small text-muted mt-1" style="font-size:0.75rem;">
                                <span class="fw-bold text-dark">${formatNumber(secQty)}</span> ${line.secUnitName || ''}
                            </div>
                        </td>
                        <td class="text-end align-middle">
                            ${formatNumber(line.unitPrice)} ${line.currency}
                            ${line.currency !== (res.docCurrency || 'TRY')
                                ? `<div class="small text-muted" style="font-size:0.72rem;">≈ ${formatNumber((line.unitPrice * lineRate) / belgeKuru)} ${res.docCurrency || 'TRY'}</div>`
                                : ''}
                        </td>
                        <td class="align-middle">${line.vatGroup}</td>
                        <td class="text-end align-middle fw-bold text-secondary small">
                            ${formatNumber(lineNetDoc)} ${res.docCurrency || 'TRY'}
                            ${line.currency !== (res.docCurrency || 'TRY')
                                ? `<div class="text-muted fw-normal" style="font-size:0.72rem;">${formatNumber(lineNetFC)} ${line.currency}</div>`
                                : ''}
                        </td>
                    </tr>`;
                });
                
                $('#linesBody').html(rowsHtml);

                toplamlariYaz(netLC, taxLC, res.docCurrency, res.docRate);
                
                const isCanceled = (res.canceled === 'Y' || res.canceled === 'y');
                const isClosed = (res.docStatus === 'C' || res.docStatus === 'c');
                setFormMode('VIEW', isClosed, isCanceled); 
                isBindingData = false;

                if (typeof bittiginde === 'function') bittiginde(res);
            });
        }

        function populateSearchResults(list) {
            let html = '';
            list.forEach(row => {
                html += `
                <tr onclick="loadOrderAndCloseModal(${row.docEntry})">
                    <td class="fw-bold">${row.docNum}</td>
                    <td>${row.cardCode}</td>
                    <td class="text-truncate" style="max-width: 200px;">${row.cardName || ''}</td>
                    <td>${row.docDate}</td>
                    <td><span class="badge bg-secondary">${row.docCurrency}</span></td>
                </tr>`;
            });
            $('#searchResultsBody').html(html);
            $('#searchResultsModal').modal('show');
        }

        window.loadOrderAndCloseModal = function(docEntry) {
            $('#searchResultsModal').modal('hide');
            loadOrderDetailsFromId(docEntry);
        }

        $('.nav-btn').click(function() {
            if (isBindingData) return;
            const dir = $(this).data('dir');
            
            $('#loadingOverlay').css('display', 'flex');
            
            $.get('/Rapor94/GetOrderNavigation', { currentDocEntry: currentDocEntry, direction: dir }, function(res) {
                if(res && res.success && res.data) {
                    bindOrderToForm(res.data);
                } else {
                    toastr.info("Bu yönde başka kayıt bulunmuyor.");
                }
            }).fail(function() {
                toastr.error("Kayıt çekilirken hata oluştu.");
            }).always(function() {
                $('#loadingOverlay').hide();
            });
        });

        $('#btnNewDoc').click(function() {
            setFormMode('ADD');
            fetchAllExchangeRates();
        });

        // ---- BELGEYİ ÇOĞALT ---------------------------------------------
        //
        // Açık siparişin birebir aynısını YENİ KAYIT olarak forma getirir.
        // SAP'ye hiçbir şey gönderilmez; kontrol edip "SAP'ye Ekle" düğmesine
        // basmak kullanıcıya bırakılır. Belgeye özel alanlar (belge no, kayıt
        // numarası, durum) taşınmaz; tarihler bugüne çekilir.
        $('#btnCogalt').click(function () {
            if (!currentDocEntry) { toastr.warning('Önce çoğaltılacak siparişi açın.'); return; }

            const kaynakEntry = currentDocEntry;

            $('#loadingOverlay').css('display', 'flex');
            $.get('/Rapor94/GetOrderDetails', { docEntry: kaynakEntry }, function (res) {
                if (!res || !res.success || !res.data) {
                    toastr.error((res && res.message) || 'Sipariş detayları alınamadı.');
                    return;
                }

                // Yükleme kur sorgusu yüzünden ASENKRON bitiyor; çoğaltma adımları
                // bu yüzden geri çağrıda yapılır. Aksi hâlde VIEW modu sonradan
                // gelip üzerine yazıyor, form salt okunur kalıyor ve
                // "SAP'ye Ekle" düğmesi görünmüyordu.
                bindOrderToForm(res.data, cogaltmayiTamamla);
            }).fail(function () {
                toastr.error('Kayıt çekilirken hata oluştu.');
            }).always(function () {
                $('#loadingOverlay').hide();
            });
        });

        function cogaltmayiTamamla(veri) {
            const kaynakNo = veri.docNum;

            // Ekran, değerler korunarak "yeni kayıt" durumuna çevrilir.
            isBindingData = true;
            setFormMode('ADD', false, false, false);

            // Belgeye özel alanlar temizlenir.
            currentDocEntry = 0;
            $('#DocNum').val('').prop('disabled', true);

            const bugun = new Date().toISOString().split('T')[0];
            $('#DocDate').val(bugun);
            $('#TaxDate').val(bugun);

            // Teslim ve vade tarihi geçmişte kaldıysa bugüne çekilir.
            ['#DocDueDate', '#VadeTarihi'].forEach(function (alan) {
                const mevcut = $(alan).val();
                if (!mevcut || mevcut < bugun) $(alan).val(bugun);
            });

            $('#pageTitle').html('<i class="fas fa-copy text-warning me-2"></i>Satış Siparişi Oluştur '
                               + '<span class="badge bg-warning text-dark align-middle">' + kaynakNo + ' kopyası</span>');

            isBindingData = false;

            // Satırlar DÜZENLENEBİLİR şablonla yeniden kurulur: görüntüleme
            // satırları kaydetme rutininin aradığı alanları taşımıyor.
            cogaltSatirlariKur(veri.lines || []);

            toastr.success(kaynakNo + " numaralı sipariş çoğaltıldı. Kontrol edip "
                         + "<b>SAP'ye Ekle</b> düğmesiyle kaydedin.", "", { timeOut: 9000, enableHtml: true });
        }

        $('#btnFindMode').click(function() {
            setFormMode('FIND');
        });

        $('#btnPrintDocument').click(function() {
            if(currentDocEntry > 0) {
                window.open('/Rapor94/PrintOrder?docEntry=' + currentDocEntry, '_blank');
            }
        });

        function fetchAllExchangeRates() {
            if(currentMode !== 'ADD') return;
            const date = $('#DocDate').val();
            $.get('/Rapor94/GetAllExchangeRates', { date: date }, function(res) {
                window.exchangeRates = res;
                const docCur = $('#DocCurrency').val() || 'TRY';
                const docRate = window.exchangeRates[docCur] || 1.0;
                $('#ExchangeRate').val(docRate.toLocaleString('tr-TR', { minimumFractionDigits: 4, maximumFractionDigits: 4 }));
                
                const usdRate = window.exchangeRates['USD'] || 0;
                const eurRate = window.exchangeRates['EUR'] || 0;
                $('#USDRate').val(usdRate.toFixed(4));
                $('#EURRate').val(eurRate.toFixed(4));

                calculateTotals();
            });
        }

        $(document).ready(function () {
            $('.select2-init').select2({ theme: 'bootstrap-5', width: '100%' });
            
            setFormMode('ADD');
            fetchAllExchangeRates();

            $('#USDRate').on('input change', function() {
                window.exchangeRates['USD'] = parseFloat($(this).val()) || 0;
                if ($('#DocCurrency').val() === 'USD') {
                    $('#ExchangeRate').val(window.exchangeRates['USD'].toLocaleString('tr-TR', { minimumFractionDigits: 4, maximumFractionDigits: 4 }));
                }
                calculateTotals();
            });

            $('#EURRate').on('input change', function() {
                window.exchangeRates['EUR'] = parseFloat($(this).val()) || 0;
                if ($('#DocCurrency').val() === 'EUR') {
                    $('#ExchangeRate').val(window.exchangeRates['EUR'].toLocaleString('tr-TR', { minimumFractionDigits: 4, maximumFractionDigits: 4 }));
                }
                calculateTotals();
            });

            $('#btnCancelDocument').click(function() {
                if (!currentDocEntry || currentDocEntry <= 0) return;
                
