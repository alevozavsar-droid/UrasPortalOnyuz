        function executeCreateOrder(payload) {
            $('#loadingOverlay').css('display', 'flex');
            $.ajax({
                url: '/Rapor94/CreateOrder',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        toastr.success(res.message);
                        
                        if(res.autoPrint && res.docEntry > 0) {
                            window.open('/Rapor94/PrintOrder?docEntry=' + res.docEntry, '_blank');
                        }
                        
                        setTimeout(() => { window.location.reload(); }, 2000); 
                    } else {
                        toastr.error(res.message);
                    }
                },
                error: function (xhr) {
                    const errMsg = xhr.responseJSON ? xhr.responseJSON.message : "Bağlantı hatası.";
                    toastr.error(errMsg);
                },
                complete: function () { $('#loadingOverlay').hide(); }
            });
        }

        // Cogaltmada satirlari duzenlenebilir sablondan kurar ve kaynak
        // belgedeki degerlerle doldurur. Kalem secicisi ajax select2 oldugu icin
        // secili kalem elle option olarak eklenir.
        function cogaltSatirlariKur(satirlar) {
            $('#linesBody').empty();

            if (!satirlar.length) { addRow(); calculateTotals(); return; }

            satirlar.forEach(function (line) {
                addRow();
                var $tr = $('#linesBody tr').last();

                var ad = line.itemName || '';
                var etiket = ad ? (line.itemCode + ' - ' + ad) : line.itemCode;

                var $kalem = $tr.find('.item-select');
                $kalem.append(new Option(etiket, line.itemCode, true, true)).trigger('change.select2');

                $tr.find('.input-freetxt').val(line.freeTxt || '');
                $tr.find('.input-qty').val(line.quantity);
                $tr.find('.input-price').val(line.unitPrice);

                var $pb = $tr.find('.input-currency');
                if ($pb.find('option[value="' + line.currency + '"]').length) $pb.val(line.currency);

                var $kdv = $tr.find('.input-vat');
                if ($kdv.find('option[value="' + line.vatGroup + '"]').length) $kdv.val(line.vatGroup);

                var $depo = $tr.find('.input-whs');
                if ($depo.find('option[value="' + line.warehouseCode + '"]').length) $depo.val(line.warehouseCode);
                else if (line.warehouseCode) $depo.append(new Option(line.warehouseCode, line.warehouseCode, true, true));
            });

            updateRowIndexes();
            calculateTotals();
        }

        // ===================== İHRACAT (GİB IHRACAT senaryosu) =====================
        // Tik: paneli açar, Fatura Tipi = 3 (ISTISNA) ve muafiyet 301 seçer, satırlarda GTİP kutusunu gösterir.
        function ihracatAcik() { return $('#IhracatTik').is(':checked'); }

        function ihracatPaneliUygula(acik) {
            $('#ihracatPanel').toggle(!!acik);
            $('#linesBody .input-gtip').toggle(!!acik);
            ihracatUlkeGoster();
        }

        function ihracatUlkeGoster() {
            const ulke = $('#ShipToCountry').val() || '';
            const ad = $('#ShipToCountry option:selected').text() || ulke;
            $('#IhrUlkeGoster').val(ulke ? `${ad} (${ulke})` : '')
                .toggleClass('is-invalid', ihracatAcik() && (!ulke || ulke === 'TR'));
        }

        function ihracatSifirla() {
            $('#IhracatTik').prop('checked', false);
            $('#IhrDosyaSecim').html('<option value="">- Dosya seç -</option>');
            $('#IhrDosyaNo, #IhrKapAdedi, #IhrKapNo, #IhrKapMarka, #IhrIban').val('');
            $('#IhrIncoterm, #IhrTasima, #IhrKapCinsi, #IhrOdemeSekli, #IhrOdemeKanali').val('');
            ihracatPaneliUygula(false);
        }

        // Muafiyet listesi Fatura Tipi değişince asenkron dolar; 301 birkaç denemeyle seçilir.
        function ihracatIstisnaSec() {
            if ($('#U_BE1_SEND').val() !== '3') $('#U_BE1_SEND').val('3').trigger('change');
            let deneme = 0;
            const t = setInterval(function () {
                const $m = $('#U_BE1_MUAFCODE');
                if ($m.find('option[value="301"]').length) { if (!$m.val()) $m.val('301').trigger('change'); clearInterval(t); }
                if (++deneme > 20) clearInterval(t);
            }, 150);
        }

        function ihracatDosyalariYukle(cardCode, secili) {
            const $s = $('#IhrDosyaSecim');
            $.get('/Rapor94/IhracatDosyalari', { cardCode: cardCode || '' }, function (res) {
                $s.html('<option value="">- Dosya seç -</option>');
                (res && res.data || []).forEach(d => {
                    const etiket = d.dosyaNo + (d.tanim ? ' - ' + d.tanim : '') + (d.cardCode ? ' [' + d.cardCode + ']' : '');
                    $s.append($('<option>').val(d.dosyaNo).text(etiket).attr('data-incoterm', d.incoterm || '').attr('data-odeme', d.odemeSekli || '').attr('data-ulke', d.ulke || ''));
                });
                if (secili) $s.val(secili);
            }).fail(function () { $s.html('<option value="">- Dosya listesi alınamadı -</option>'); });
        }

        function ihracatMusteri(res) {
            if (!res || currentMode !== 'ADD') return;
            if (res.yurtDisi) {
                if (!ihracatAcik()) {
                    $('#IhracatTik').prop('checked', true).trigger('change');
                    toastr.info(`Yurt dışı müşteri (${res.ulke || 'ülke: ?'}): İhracat tiki açıldı, ihracat alanlarını doldurun.`, '', { timeOut: 7000 });
                } else {
                    ihracatDosyalariYukle($('#CardCode').val(), $('#IhrDosyaSecim').val());
                }
            }
        }

        function ihracatBind(ihr) {
            if (!ihr || !(ihr.ihracat || ihr.Ihracat)) { ihracatSifirla(); return; }
            const v = k => ihr[k] || ihr[k.charAt(0).toUpperCase() + k.slice(1)] || '';
            $('#IhracatTik').prop('checked', true);
            ihracatPaneliUygula(true);
            $('#IhrDosyaNo').val(v('ihracatDosyaNo'));
            $('#IhrDosyaSecim').html(`<option value="${v('ihracatDosyaNo')}">${v('ihracatDosyaNo')}</option>`).val(v('ihracatDosyaNo'));
            $('#IhrIncoterm').val(v('incoterm'));
            $('#IhrTasima').val(v('transportMode'));
            $('#IhrKapCinsi').val(v('kapCinsi'));
            $('#IhrKapAdedi').val(v('kapAdedi'));
            $('#IhrKapNo').val(v('kapNo'));
            $('#IhrKapMarka').val(v('kapMarka'));
            $('#IhrOdemeSekli').val(v('odemeSekli'));
            $('#IhrOdemeKanali').val(v('odemeKanali'));
            $('#IhrIban').val(v('iban'));
        }

        function ihracatPayload() {
            if (!ihracatAcik()) return { Ihracat: false };
            return {
                Ihracat: true,
                IhracatDosyaNo: ($('#IhrDosyaNo').val() || '').trim(),
                Incoterm: $('#IhrIncoterm').val() || '',
                TransportMode: $('#IhrTasima').val() || '',
                KapCinsi: $('#IhrKapCinsi').val() || '',
                KapAdedi: $('#IhrKapAdedi').val() || '',
                KapNo: ($('#IhrKapNo').val() || '').trim(),
                KapMarka: ($('#IhrKapMarka').val() || '').trim(),
                OdemeSekli: $('#IhrOdemeSekli').val() || '',
                OdemeKanali: $('#IhrOdemeKanali').val() || '',
                Iban: ($('#IhrIban').val() || '').replace(/\s+/g, '')
            };
        }

        // Kaydetmeden önce istemci tarafı denetim (sunucu aynı kuralları yeniden uygular). Hata metni döner, yoksa null.
        function ihracatDogrula() {
            if (!ihracatAcik()) return null;
            if ($('#U_BE1_SEND').val() !== '3') return 'İhracat belgesinde Fatura Tipi 3 - ISTISNA olmalıdır.';
            if (!$('#U_BE1_MUAFCODE').val()) return 'İhracat belgesinde muafiyet kodu seçilmelidir (mal ihracatı: 301).';
            if (!$('#IhrDosyaNo').val().trim()) return 'İhracat Dosya No giriniz.';
            if (!$('#IhrIncoterm').val()) return 'Teslim şartı (Incoterm) seçiniz.';
            if (!$('#IhrTasima').val()) return 'Gönderilme şekli seçiniz.';
            if (!$('#IhrKapCinsi').val()) return 'Kap cinsi seçiniz.';
            if (!(parseInt($('#IhrKapAdedi').val()) > 0)) return 'Kap adedi giriniz.';
            if (!$('#IhrKapNo').val().trim()) return 'Kap / konteyner numarası giriniz.';
            const ulke = $('#ShipToCountry').val() || '';
            if (!ulke) return 'Lojistik sekmesinde sevk adresinin ülkesini seçiniz.';
            if (ulke === 'TR') return 'İhracat belgesinde sevk adresinin ülkesi Türkiye olamaz.';
            let hata = null;
            $('#linesBody tr').each(function (i) {
                const g = ($(this).find('.input-gtip').val() || '').replace(/[.\s]/g, '');
                if (!/^\d{12}$/.test(g)) { hata = `${i + 1}. satır için GTİP 12 hane olmalıdır (ör. 390950900000).`; return false; }
            });
            return hata;
        }

        $(function () {
            $('#IhracatTik').on('change', function () {
                const acik = $(this).is(':checked');
                ihracatPaneliUygula(acik);
                if (acik && currentMode === 'ADD') {
                    ihracatIstisnaSec();
                    ihracatDosyalariYukle($('#CardCode').val(), $('#IhrDosyaSecim').val());
                    // Boş GTİP'leri kalem kartından tamamla
                    $('#linesBody tr').each(function () {
                        const $tr = $(this), item = $tr.find('.item-select').val(), $g = $tr.find('.input-gtip');
                        if (item && !$g.val()) $.get('/Rapor94/GetItemPrice', { cardCode: $('#CardCode').val() || '', itemCode: item }, function (r) { if (r && r.gtip && !$g.val()) $g.val(r.gtip); });
                    });
                }
            });
            $('#IhrDosyaSecim').on('change', function () {
                const $o = $(this).find('option:selected');
                if (!$o.val()) return;
                $('#IhrDosyaNo').val($o.val());
                const inc = ($o.attr('data-incoterm') || '').toUpperCase();
                if (inc && $('#IhrIncoterm option[value="' + inc + '"]').length) $('#IhrIncoterm').val(inc);
                const odeme = $o.attr('data-odeme') || '';
                if (odeme && $('#IhrOdemeSekli option[value="' + odeme + '"]').length) $('#IhrOdemeSekli').val(odeme);
            });
            $('#ShipToCountry').on('change', ihracatUlkeGoster);
            $(document).on('input', '.input-gtip', function () {
                const g = $(this).val().replace(/[.\s]/g, '');
                $(this).toggleClass('is-invalid', g.length > 0 && !/^\d{12}$/.test(g));
            });
        });

        function addRow() {
            const template = document.getElementById('rowTemplate').innerHTML;
            const $newRow = $(template);
            $('#linesBody').append($newRow);

            // Yeni satir belge para birimiyle acilsin (talep 34).
            var belgePB = $('#DocCurrency').val();
            if (belgePB) {
                var sec = $newRow.find('.input-currency');
                if (sec.find('option[value="' + belgePB + '"]').length) sec.val(belgePB);
            }
            
            $newRow.find('.item-select').select2({ 
                theme: 'bootstrap-5', 
                width: '100%',
                placeholder: '- Kalem Seçin / Yazarak Arayın -',
                minimumInputLength: 2,
                language: {
                    inputTooShort: function() { return "Aramak için en az 2 karakter girin..."; },
                    searching: function() { return "Aranıyor..."; },
                    noResults: function() { return "Sonuç bulunamadı"; }
                },
                ajax: {
                    url: '/Rapor94/SearchItems',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { q: params.term };
                    },
                    processResults: function (data) {
                        return { results: data.results };
                    },
                    cache: true
                },
                templateResult: formatItemDropdown,
                templateSelection: function(item) {
                    return item.text || item.id;
                }
            });
            
            $newRow.find('.input-whs').val('01');
            if (ihracatAcik()) $newRow.find('.input-gtip').show();

            if ($('#U_BE1_AKTAR').val() === 'X') {
                $newRow.find('.input-vat').val('S05');
            } else {
                $newRow.find('.input-vat').val('S01');
            }
            
            updateRowIndexes();
        }

        function updateRowIndexes() {
            $('#linesBody tr').each(function (index) { $(this).find('.row-index').text(index + 1); });
        }

        function resetTotals() {
            toplamlariYaz(0, 0, $('#DocCurrency').val() || 'TRY', 1);
        }

        // Alt toplam kutusunu doldurur. Rakamlar HER ZAMAN belge para biriminde.
        //
        // Satirlar TL uzerinden toplanip (netLC/taxLC) burada belge para birimine
        // cevrilir. Kur okunamazsa cevirme yapilamaz; yanlis rakam gostermemek
        // icin tutar yerine uyari isareti konur.
        function toplamlariYaz(netLC, taxLC, docCurrency, docRate) {
            var pb = docCurrency || 'TRY';
            var kur = (pb === 'TRY') ? 1.0 : (parseFloat(docRate) || 0);
            var grandLC = netLC + taxLC;

            if (!(kur > 0)) {
                $('#lblNetTotalFC').text('kur yok');
                $('#lblTaxTotalFC').text('kur yok');
                $('#lblGrandTotalFC').text('kur yok');
                return;
            }

            $('#lblNetTotalFC').text(formatNumber(netLC / kur) + ' ' + pb);
            $('#lblTaxTotalFC').text(formatNumber(taxLC / kur) + ' ' + pb);
            $('#lblGrandTotalFC').text(formatNumber(grandLC / kur) + ' ' + pb);
        }

        function calculateTotals() {
            if(currentMode !== 'ADD') return;
            
            let netTotalLC = 0, taxTotalLC = 0;
            const docCurrency = $('#DocCurrency').val() || 'TRY';
            
            let docRateStr = $('#ExchangeRate').val();
            let docRate = 1.0;
            if(docRateStr) docRate = parseFloat(docRateStr.replace(/\./g, '').replace(',', '.')) || 1.0;

            $('#linesBody tr').each(function () {
                const qty = parseFloat($(this).find('.input-qty').val()) || 0;
                const price = parseFloat($(this).find('.input-price').val()) || 0;
                const lineCur = $(this).find('.input-currency').val() || 'TRY';
                const vatRate = parseFloat($(this).find('.input-vat option:selected').data('rate')) || 0;
                
                const secMultiplier = parseFloat($(this).find('.input-sec-multiplier').val()) || 0;
                const secTotal = qty * secMultiplier;
                $(this).find('.input-sec-total').text(formatNumber(secTotal));

                // Satır kuru (Döviz cinsi)
                const lineRate = window.exchangeRates[lineCur] || (lineCur === docCurrency ? docRate : 1.0);

                // Kur bulunamadiysa cevrim 1.0 ile yapiliyor demektir; tutar
                // yanlis olur. Sessiz kalmasin diye alan isaretlenir.
                const kurYok = (lineCur !== docCurrency) && !window.exchangeRates[lineCur];
                
                // Satır tutarları orijinal birimiyle ve TL ile (FC = Kendi birimi, LC = TRY)
                const lineNetFC = qty * price;
                const lineNetLC = lineNetFC * lineRate;
                const lineTaxLC = lineNetLC * (vatRate / 100);

                // TOPLAM KOLONU BELGE PARA BIRIMINDEDIR.
                //
                // Birim fiyat kendi para biriminde kalir (orn. USD), ama satir
                // toplami belgenin para birimine cevrilerek gosterilir; belge TRY
                // ise TL karsiligi yazar. Kurlar TRY bazlidir:
                //   tutarTL   = tutarFC * satirKuru
                //   tutarBelge = tutarTL / belgeKuru
                const lineNetDoc = docRate > 0 ? (lineNetLC / docRate) : lineNetFC;

                // Kullanici o an toplam alanina yaziyorsa uzerine yazilmaz.
                var $toplam = $(this).find('.input-line-total');
                if (!$toplam.is(':focus')) $toplam.val(lineNetDoc ? lineNetDoc.toFixed(2) : '');

                // TALEP 43: Birim fiyatin karsiligi.
                // Satir kendi para biriminde fiyatlaniyor; kullanicinin ayni
                // anda TL (ya da belge para birimi) karsiligini gormesi icin
                // fiyatin altina kucuk bir bilgi satiri yazilir.
                var $karsilik = $(this).find('.fiyat-karsilik');
                if ($karsilik.length) {
                    if (!price || lineCur === docCurrency) {
                        $karsilik.text('');
                    } else if (kurYok) {
                        $karsilik.html('<span class="text-danger">' + lineCur + ' kuru yok</span>');
                    } else {
                        var birimDoc = (price * lineRate) / (docRate > 0 ? docRate : 1);
                        $karsilik.text('≈ ' + formatNumber(birimDoc) + ' ' + docCurrency);
                    }
                }

                $toplam.toggleClass('border-danger', kurYok)
                       .attr('title', kurYok
                            ? lineCur + ' kuru bu tarihte tanımlı değil; tutar çevrilemedi, kontrol edin.'
                            : 'Toplam yazarsanız birim fiyat miktara göre hesaplanır (' + docCurrency + ')');
                
                netTotalLC += lineNetLC; 
                taxTotalLC += lineTaxLC;
            });

            $('#toplamKolonPB').text('(' + docCurrency + ')');

            toplamlariYaz(netTotalLC, taxTotalLC, docCurrency, docRate);
        }
    </script>
}