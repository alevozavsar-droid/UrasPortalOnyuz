                if(!cardCode) return;

                $.get('/Rapor94/GetCustomerInfo', { cardCode: cardCode }, function(res) {
                    currentBpCurrency = res.currency;
                    $('#CurrencyType').val('BP'); 
                    $('#DocCurrency').val(currentBpCurrency);
                    
                    const docRate = window.exchangeRates[currentBpCurrency] || 1.0;
