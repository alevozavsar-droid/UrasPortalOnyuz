@using WebApplication3.Data
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    int yil = (int)ViewBag.Yil;
    string kaynak = (string)ViewBag.Kaynak;
    var gruplar = ((string Grup, PmSutun[] Sutunlar)[])ViewBag.Gruplar;
    string[] sekmeler = { "tablo", "ozet", "uretim", "prim", "ozel", "birlesim", "ekcalisma", "kesinti", "muhasebe", "cikis", "odeme", "zam", "karsilastirma", "cari", "tesvik", "ozelrapor" };   // 6 Kas 2026: cari, tesvik, ozelrapor derin bağlantıları eklendi
    string sekme = sekmeler.Contains(Context.Request.Query["sekme"].ToString()) ? Context.Request.Query["sekme"].ToString() : "cari";   // varsayılan açılış sekmesi Personel Cari Kartı (kullanıcı, 6 Kas 2026)
    string kod = Context.Request.Query["kod"].ToString();
    string donem = Context.Request.Query["donem"].ToString();
}
@*
    PERSONEL MALİYET RAPORU — Yönetim › Özel Analizler › Özel Raporlar ve İK ve İdari İşler › İnsan Kaynakları › Personel Maliyet ve Bordro (aynı ekran).
    "Personel Bordro ve Ödeme Tablosu"nun portal karşılığı; sütun grupları ve sütunlar Data/PersonelMaliyetOrnek.cs › SutunGruplari'ndan gelir (kaynak tabloyla aynı sıra). İki sekme:
      Personel Maliyet Tablosu : tüm kişiler (bordrolu, Özel, Üretim; ayrılabilir) · kimlik bilgileri (Ödeme Şirketi-R / -X otomatik) · net ücret · puantaj ve çalışma kazançları · ek çalışmalar · sosyal yardımlar · prim ve ek kazançlar (kasa tazminatı dahil) · yan haklar · yasal ödemeler ·
                                 brüt kazanç ve SGK matrahı · gelir vergisi · damga vergisi · SGK işçi payları · işveren payları · diğer kesintiler (mazot, ihbar dahil) · ödeme özeti · maliyet ve not.
                                 Düzenle modunda kimlik bilgileri, günler ve girilen tutarlar satır bazında değiştirilir (hesaplanan sütunlar anında güncellenir); Kart düğmesi Personel Cari Kartı'nı açar
                                 (335.xxx cari kodu, durum, ayrılış, TC kimlik, telefon, e-posta, tüm girilen kalemler, not); Personel Ekle / Sil; Excel
      Özet Raporu              : seçilebilir kırılım × maliyet kalemleri, SGK işvereni × çatı departman matrisi, kalem dağılımı, ünvan / özel durum / kıdem dağılımları, en yüksek maliyetli 10 personel
      Üretim Personeli         : SGK'sız, tamamen X, saat / gün bazlı (Data/PersonelMaliyetEkOrnek.cs); Personel Maliyet Tablosu'nda da yer alır ("Üretim Personeli Gizle" ile ayrılır) · Prim Ödemeleri: ana tablodaki prim tutarlarının detayı + kişi bazında uyum
      Özel Kişiler             : PmPersonel.Ozel = true satırlar (aile üyeleri, ev çalışanları); bu sekme yalnız onları aynı sütunlarla açar; Personel Maliyet Tablosu'nda da yer alırlar ("Özel Kişiler Gizle" ile ayrılır)
      Birleşik Tablo           : Bordro + Üretim + Özel satırları; net kalemler (yol, yemek, mesai, prim), Toplam Brüt Masraflar, Toplam İşveren, Genel Maliyet
      Zam Senaryosu            : toplu veya kişi bazlı zam oranı temel maaşa uygulanır; ara toplamlar (Kalan Net, Net-X Bordro, Ara Toplam), Brüt Masraflar, SGK İşveren ve Genel Maliyet mevcut ve zamlı gösterilir (veri değişmez)
      Ek Çalışmalar            : mesai talepleri (TalepMotoru MESAI; Data/PersonelKesintiOrnek.cs) — kim, kim onayladı, ne zaman, PDKS / puantaj, tabloyla karşılaştırma; talep detayı çekmecede
      Diğer Kesintiler         : şahsi avans talepleri (NakitAvansOrnek) + Kasa Nakit Akışı senkronu, kesinti / icra planları (PDF ekleri, bitiş dönemi), yeni plan formu (KesintiEkle, multipart)
      Muhasebe Kayıtları       : IT Analiz 01.11.2026 — simülasyon (gerçek fiş yok) → 11 kontrol → onaya gönder → onayla (yetki) → muhasebeleştir (MuhasebeOrnek yevmiye) → ters kayıt; hesap eşleştirme tanım ekranı (Data/PersonelMuhasebeOrnek.cs)
    Dönem (Ay) seçimi filtrelerdedir: seçilen ayın verisi /PersonelMaliyet/Veri?donem=yyyy-MM ile yüklenir (tek dönem: Eylül 2026, Personel Maliyet Raporu 2026-09 kaynak tablosu); kayıt / ekle / sil seçili döneme işlenir.
    Filtreler (Durum dahil) ve KPI kutuları ilk iki sekme için ortaktır; "0 ₺ Sütunları Gizle" anahtarı tablolarda tamamı sıfır olan sütunları kaldırır. "Üretim Personeli Gizle" / "Özel Kişiler Gizle" kişi içeren tüm sekmelerde tek ortak durumdur (Üretim ve Özel sekmelerinde ve Muhasebe'de yoktur). Derin bağlantı: ?sekme=tablo|ozel|uretim|prim|ekcalisma|kesinti|birlesim|cikis|odeme|zam|karsilastirma|ozet|muhasebe · ?kod=335.012 (kartı açar)
    Veri: /PersonelMaliyet/Veri · Kayıt: /PersonelMaliyet/Kaydet · Ekle · Sil. Betik: wwwroot/js/personel-maliyet.js · Ortak stil: wwwroot/css/nakit-avans.css
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<style>
    .na.pm { --na-k: #0f766e; }
    .pm-pill { font-size: .62rem; font-weight: 700; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 2px 8px; }
    /* ---- yoğun yerleşim: üst bölüm tek satırlık şeritler (kutu yok), tablo ekranın kalanını doldurur ---- */
    .pm .na-ust { margin-bottom: 4px; gap: 8px; } .pm .na-ust h4 { font-size: .95rem; } .pm .na-ust .sub { display: none; } .pm.aciklama .na-ust .sub { display: block; }
    .pm-bilgi { border: 1px solid #e2e8f0; background: #fff; color: #64748b; border-radius: 50%; width: 20px; height: 20px; font-size: .62rem; font-weight: 800; line-height: 1; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; } .pm.aciklama .pm-bilgi { background: #0f766e; color: #fff; border-color: #0f766e; }
    /* KPI kutuları: Personel Maliyet Yansıtması ile aynı ölçü (ortak nakit-avans.css .na-kpi); kendi KPI şeridi olan sekmede genel şerit gizlenir */
    .pm .na-kpi { margin-bottom: 6px; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
    .pm .na-kpi > div { height: 70px; min-width: 0; overflow: hidden; }   /* tüm sekmelerde aynı kutu yüksekliği; etiket en çok iki satır, alt bilgi tek satır */
    .pm .na-kpi .l { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.25; }
