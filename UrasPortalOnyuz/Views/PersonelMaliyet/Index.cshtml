@using WebApplication3.Data
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    int yil = (int)ViewBag.Yil;
    string kaynak = (string)ViewBag.Kaynak;
    var gruplar = ((string Grup, PmSutun[] Sutunlar)[])ViewBag.Gruplar;
    string[] sekmeler = { "tablo", "ozet", "uretim", "prim", "ozel", "birlesim", "ekcalisma", "kesinti", "muhasebe", "cikis" };
    string sekme = sekmeler.Contains(Context.Request.Query["sekme"].ToString()) ? Context.Request.Query["sekme"].ToString() : "tablo";
    string kod = Context.Request.Query["kod"].ToString();
    string donem = Context.Request.Query["donem"].ToString();
}
@*
    PERSONEL MALİYET RAPORU — Yönetim › Özel Analizler › Özel Raporlar ve İK ve İdari İşler › İnsan Kaynakları › Personel Maliyet ve Bordro (aynı ekran).
    "Personel Bordro ve Ödeme Tablosu"nun portal karşılığı; sütun grupları ve sütunlar Data/PersonelMaliyetOrnek.cs › SutunGruplari'ndan gelir (kaynak tabloyla aynı sıra). İki sekme:
      Personel Maliyet Tablosu : kimlik bilgileri · net ücret · puantaj ve çalışma kazançları · ek çalışmalar · sosyal yardımlar · prim ve ek kazançlar · yan haklar · yasal ödemeler ·
                                 brüt kazanç ve SGK matrahı · gelir vergisi · damga vergisi · SGK işçi payları · işveren payları · diğer kesintiler · ödeme özeti · maliyet ve not.
                                 Düzenle modunda kimlik bilgileri, günler ve girilen tutarlar satır bazında değiştirilir (hesaplanan sütunlar anında güncellenir); Kart düğmesi Personel Cari Kartı'nı açar
                                 (335.xxx cari kodu, durum, ayrılış, TC kimlik, telefon, e-posta, tüm girilen kalemler, not); Personel Ekle / Sil; Excel
      Özet Raporu              : seçilebilir kırılım × maliyet kalemleri, SGK işvereni × çatı departman matrisi, kalem dağılımı, ünvan / özel durum / kıdem dağılımları, en yüksek maliyetli 10 personel
      Üretim Personeli         : SGK'sız, tamamen X, saat / gün bazlı (Data/PersonelMaliyetEkOrnek.cs) · Prim Ödemeleri: ana tablodaki prim tutarlarının detayı + kişi bazında uyum
      Özel Kişiler             : PmPersonel.Ozel = true satırlar (aile üyeleri, ev çalışanları); Personel Maliyet Tablosu paneli aynı sütunlarla "özel" kapsamında açılır, ana tabloda görünmezler
      Birleşik Tablo           : Bordro + Üretim + Özel satırları; net kalemler (yol, yemek, mesai, prim), Toplam Brüt Masraflar, Toplam İşveren, Genel Maliyet
      Ek Çalışmalar            : mesai talepleri (TalepMotoru MESAI; Data/PersonelKesintiOrnek.cs) — kim, kim onayladı, ne zaman, PDKS / puantaj, tabloyla karşılaştırma; talep detayı çekmecede
      Diğer Kesintiler         : şahsi avans talepleri (NakitAvansOrnek) + Kasa Nakit Akışı senkronu, kesinti / icra planları (PDF ekleri, bitiş dönemi), yeni plan formu (KesintiEkle, multipart)
      Muhasebe Kayıtları       : IT Analiz 01.11.2026 — simülasyon (gerçek fiş yok) → 11 kontrol → onaya gönder → onayla (yetki) → muhasebeleştir (MuhasebeOrnek yevmiye) → ters kayıt; hesap eşleştirme tanım ekranı (Data/PersonelMuhasebeOrnek.cs)
    Dönem (Ay) seçimi filtrelerdedir: seçilen ayın verisi /PersonelMaliyet/Veri?donem=yyyy-MM ile yüklenir (güncel Kasım 2026 kaynak tablodan, Ekim / Eylül 2026 türetilmiş örnek); kayıt / ekle / sil seçili döneme işlenir.
    Filtreler (Durum dahil) ve KPI kutuları ilk iki sekme için ortaktır; "0 ₺ Sütunları Gizle" anahtarı tablolarda tamamı sıfır olan sütunları kaldırır. Derin bağlantı: ?sekme=ozet|uretim|prim|ozel|birlesim · ?kod=335.012 (kartı açar)
    Veri: /PersonelMaliyet/Veri · Kayıt: /PersonelMaliyet/Kaydet · Ekle · Sil. Betik: wwwroot/js/personel-maliyet.js · Ortak stil: wwwroot/css/nakit-avans.css
*@
@section Styles {
