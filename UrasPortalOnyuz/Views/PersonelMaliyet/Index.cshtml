    .pm-excel .ckt .t b { color: #0f172a; } .pm-excel .ckt .c, .pm-excel .ckt .c small { color: #b91c1c; font-weight: 700; } .pm-excel .ckt .k, .pm-excel .ckt .k small { color: #166534; font-weight: 700; }
