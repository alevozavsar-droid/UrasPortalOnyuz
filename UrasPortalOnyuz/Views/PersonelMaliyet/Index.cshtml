    .pm-filtre { display: contents; }   /* filtre grupları çubuğun doğrudan öğeleri gibi akar, Temizle ile aynı satırda sarar */
    .pm-filtre .f { display: inline-flex; align-items: center; gap: 4px; }
    .pm-filtre label { margin: 0; font-size: .54rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: .03em; white-space: nowrap; }
    .pm .pm-filtre .form-control, .pm .pm-filtre .form-select { font-size: .66rem; padding: 1px 6px; height: 24px; min-height: 24px; width: auto; max-width: 150px; } .pm .pm-filtre .form-select { padding-right: 22px; }
    .pm-filtre .pm-donem { font-weight: 700; color: #134e4a; background-color: #f0fdfa; border-color: #99f6e4; }
    .pm-filtre-bar .btn { font-size: .62rem; padding-top: 1px; padding-bottom: 1px; }
    .pm-rapor-ust .pm-sayac { margin: 0; font-size: .7rem; font-weight: 700; color: #fff; white-space: nowrap; }
    .pm .na-sekme { margin-bottom: 6px; padding-bottom: 4px; flex-wrap: nowrap; overflow-x: auto; overflow-y: hidden; } .pm .na-sekme button { padding: 4px 8px; font-size: .68rem; white-space: nowrap; }
    @@media (max-width: 1999.98px) { .pm .na-sekme button { padding: 4px 6px; } .pm .na-sekme button i { display: none; } }   /* 15 sekme tek satırda kalsın (6 Kas 2026): geniş ekran dışında sekme ikonları gizli, dolgu dar */
    /* sekme şeridi: ince araç çubuğu; başlık beyaz (rapor teması h5 rengini ezer), alt açıklama başlığın ipucunda */
    .pm-rapor-ust { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; background: linear-gradient(90deg, #134e4a, #0f766e); color: #fff; border-radius: 8px; padding: 3px 10px; margin-bottom: 6px; min-height: 32px; }
    .pm-rapor-ust > div:first-child { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
    .pm-rapor-ust h5 { margin: 0; font-weight: 800; letter-spacing: .05em; font-size: .78rem; text-transform: uppercase; color: #fff !important; cursor: help; }
    .pm-rapor-ust .alt { display: none; }
    .pm-rapor-ust .ayar { margin-left: auto; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; } .pm-rapor-ust .ayar .btn { font-size: .64rem; padding-top: 1px; padding-bottom: 1px; } .pm-rapor-ust .ayar select, .pm-rapor-ust .ayar input.form-control { font-size: .68rem; padding: 1px 6px; height: 24px !important; min-height: 24px; width: auto; }
    /* zam şeridi tek satır: Excel ve PDF yalnız ikon (en sağda), boşluklar ve arama kutusu daraltılır; genişlik yetmezse şerit iki satıra geçer */
    .pm-rapor-ust.pm-tek-satir { gap: 8px; } .pm-rapor-ust.pm-tek-satir .ayar { gap: 4px; } .pm-rapor-ust.pm-tek-satir .pm-anahtar { padding: 2px 5px; } .pm-rapor-ust.pm-tek-satir #pmAra { width: 150px !important; }
    .pm-rapor-ust.pm-tek-satir .pm-senaryo-bar { gap: 4px; } .pm-rapor-ust.pm-tek-satir .pm-senaryo-bar input.form-control { width: 160px; } .pm-rapor-ust.pm-tek-satir .ayar .btn, .pm-rapor-ust.pm-tek-satir .pm-senaryo-bar .btn { padding-left: .45rem; padding-right: .45rem; }   /* Zam Senaryosu şeridi tek satır (9 Kas 2026) */
    .pm-excel { font-size: .67rem; border-collapse: separate; border-spacing: 0; } .pm-excel th, .pm-excel td { white-space: nowrap; padding: 3px 6px; border-bottom: 1px solid #e2e8f0; }
