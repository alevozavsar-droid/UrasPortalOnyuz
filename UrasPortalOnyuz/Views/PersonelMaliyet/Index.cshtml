    /* bölme standardı (tüm rapor sekmeleri): bölme sütun grubunun başında 2 px açık gri çizgidir; başlık (grup ve sütun satırı), gövde ve toplamda aynı. Hücreler arası dikey çizgi yoktur. */
    .pm-excel td.grupBas, .pm-excel th.grupBas, .pm-ozet td.grupBas, .pm-ozet th.grupBas { border-left: 2px solid #cbd5e1; }
    /* kaydırma kabı: kabuk tablo içeren div'lerin max-height'ını ezdiği için section (başlık ve dip toplam bu kap içinde yapışkan) */
    .pm-kaydir { display: block; overflow: auto; max-height: 70vh; position: relative; }
    /* sola sabit sütunlar (Sıra … Adı-Soyadı): yatay kaydırmada yerinde kalır; arka plan satırın rengini izler */
    .pm-excel td.sabit, .pm-excel th.sabit { position: sticky; z-index: 2; background: #fff; }
    .pm-excel thead th.sabit { z-index: 5; background: #1e293b; } .pm-excel thead tr.grup th.sabit { background: #0f172a; z-index: 6; }
    .pm-excel td.sabit:last-of-type, .pm-excel td.sabit.ad { box-shadow: 2px 0 0 #cbd5e1; }
    .pm-excel tbody tr:nth-child(even) td.sabit { background: #fff; } .pm-excel tr.secili td.sabit, .pm-excel.pm-tik tbody tr:hover td.sabit, .pm-excel tbody tr[data-sira]:hover td.sabit, .pm-excel tbody tr[data-deger]:hover td.sabit { background: #f0fdfa; }
    .pm-excel tr.cikacak td.sabit { background: #fff1f2; } .pm-excel tr.hatali td.sabit { background: #fff1f2; } .pm-excel tfoot td.sabit { background: #dbeafe; z-index: 4; } .pm-excel tr.toplam td.sabit { background: #f8fafc; } .pm-excel tr.ayrildi td.sabit { color: #94a3b8; }
    .pm-excel tfoot td, .pm-excel tr.toplam td { font-weight: 800; background: #dbeafe; border-top: 2px solid #1d4ed8; } .pm-excel tfoot { position: sticky; bottom: 0; z-index: 4; background: #dbeafe; }
    .pm-excel tr.emekli td.ad::after { content: " · E"; color: #b45309; font-size: .58rem; } .pm-excel tr.engelli td.ad::after { content: " · ♿"; color: #1d4ed8; font-size: .6rem; }
    .pm-excel tr.ayrildi td { color: #94a3b8; } .pm-excel tr.ayrildi td.ad { text-decoration: line-through; color: #94a3b8; }
    .pm-excel input.gir, .pm-excel select.gir { font-size: .66rem; padding: 1px 4px; height: 22px; border: 1px solid #94a3b8; border-radius: 4px; background: #fffbeb; }
    .pm-excel input.gir { width: 84px; text-align: right; } .pm-excel input.gir.gun { width: 56px; } .pm-excel input.gir.metin { width: 140px; text-align: left; } .pm-excel input.gir.dar { width: 108px; text-align: left; } .pm-excel input.gir.genis { width: 190px; text-align: left; } .pm-excel input.gir.tarih { width: 120px; text-align: left; } .pm-excel input.gir.not { width: 160px; text-align: left; } .pm-excel select.gir { width: auto; }
    .pm-excel tr.degisti td.ad { color: #b45309; }
    /* rx hücresi: aynı kalemin R (bordrolu) tutarı üstte, X (bordro dışı) tutarı altta */
    .pm-excel td.rx .rx { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.2; } .pm-excel td.rx .rx span { white-space: nowrap; } .pm-excel td.rx .rx small { display: inline-block; width: 10px; margin-left: 3px; font-size: .5rem; font-weight: 800; color: #0f766e; text-align: left; } .pm-excel td.rx .rx .x { color: #b45309; } .pm-excel td.rx .rx .x small { color: #b45309; } .pm-excel .rxt { display: flex; flex-direction: column; line-height: 1.3; padding-right: 13px; }   /* gövdedeki R/X etiketinin yeri kadar boşluk: rakamlar gövdeyle aynı sağ kenarda */ .pm-excel .rxt > span { display: flex; justify-content: space-between; gap: 10px; white-space: nowrap; } .pm-excel .rxt small { font-size: .5rem; font-weight: 700; color: #0f766e; text-transform: uppercase; } .pm-excel .rxt .x small { color: #b45309; } .pm-excel .rxt .t small { color: #64748b; } .pm-excel .rxt .t b { color: #0f172a; }
    /* İşten Çıkış dip toplamı üçlüsü (9 Kas 2026, "üstte toplam, altta seçtiğim kişiler çıkarsa ne kadar ödeyeceğim"): Toplam · Çıkacak (işaretliler) · Kalan (toplam − çıkacak), her tutar sütununda */
