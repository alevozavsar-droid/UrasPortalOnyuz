    .pm-drawer-dar { width: 720px; }
    .pm-zaman { list-style: none; margin: 0; padding: 0 0 0 14px; border-left: 2px solid #e2e8f0; } .pm-zaman li { position: relative; font-size: .68rem; padding: 2px 0 6px 10px; } .pm-zaman li::before { content: ""; position: absolute; left: -19px; top: 7px; width: 8px; height: 8px; border-radius: 50%; background: #0f766e; } .pm-zaman li small { display: block; color: #64748b; font-size: .58rem; }
    .pm-onay { width: 100%; font-size: .68rem; } .pm-onay th { font-size: .58rem; text-transform: uppercase; color: #64748b; text-align: left; padding: 2px 6px; } .pm-onay td { padding: 3px 6px; border-top: 1px solid #f1f5f9; }
