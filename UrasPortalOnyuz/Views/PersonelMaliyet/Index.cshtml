    .pm-excel.pm-tik tbody tr, .pm-ozet.pm-tik tbody tr:not(.toplam), .pm-excel tbody tr[data-sira], .pm-excel tbody tr[data-deger] { cursor: pointer; } .pm-excel.pm-tik tbody tr:hover td, .pm-ozet.pm-tik tbody tr:not(.toplam):hover td, .pm-excel tbody tr[data-sira]:hover td, .pm-excel tbody tr[data-deger]:hover td { background: #f0fdfa; }
