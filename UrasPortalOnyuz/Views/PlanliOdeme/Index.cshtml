@{
    ViewData["Title"] = "Planlı Ödemeler";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string onSirket = (string)ViewBag.Sirket ?? "";
    string onId = (string)ViewBag.Id ?? "";
}
@*
    PLANLI ÖDEMELER — Mali İşler › Finans › Ödeme Yönetimi. Konsolide Finansal Takip Paneli › Düzenli Ödemeler sekmesiyle AYNI LİSTE ve AYNI TASARIM
    (Data/DuzenliOdemeOrnek.cs: aylık ödeme takvim listesi — tedarikçi, ürün / hizmet, şirket, ödeme şekli, gün, ort. aylık tutar, kategori; her ay otomatik Kasa Nakit Akışı satırı).
    Özet kutuları, şirket alt toplamlı liste, Bu Ayı Akıt / Gelecek Ayı Planla / satır akıt, yeni kayıt / düzenle / pasife al, çekmece (kayıt + akan aylar + günlük) panelle birebir;
    ek olarak Bu Ayın Ödeme Takvimi (gün bazında). Uçlar: /PlanliOdemeler/Veri · Akit · Kaydet · Durum (Uretilen/Controllers/PlanliOdemeController.cs) · betik: wwwroot/js/planli-odeme.js
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<style>
    /* Takip Paneli (Views/Rapor123/Index.cshtml) tp-* düzeninin bu ekrandaki karşılığı — aynı rozetler, tablo ve çekmece */
    .na.po { --na-k: #1d4ed8; }
    .tp-pill { font-size: .66rem; font-weight: 700; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 3px 10px; } a.tp-pill { text-decoration: none; } a.tp-pill:hover { background: #e0f2fe; color: #0c4a6e; border-color: #bae6fd; }
    #po .na-kart .table-responsive { overflow: visible !important; } .table-container:has(#po) { overflow: visible !important; }
    .tp-filtre { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr 1.6fr; gap: 6px 8px; align-items: end; }
    .tp-filtre label { display: block; font-size: .58rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 2px; }
    .tp-filtre .form-control, .tp-filtre .form-select { font-size: .72rem; padding: 3px 7px; height: 28px; }
    @@media (max-width: 1200px) { .tp-filtre { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    #po .tp-tablo { font-size: .68rem; table-layout: fixed; width: 100%; }
    #po .tp-tablo th { font-size: .56rem; padding: 5px 6px; white-space: normal; line-height: 1.15; vertical-align: middle; overflow: hidden; position: sticky; top: 0; z-index: 3; background: #f8fafc; box-shadow: 0 1px 0 #e2e8f0; }
    #po .tp-tablo td { padding: 4px 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; vertical-align: middle; line-height: 1.2; border-bottom: 1px solid #e2e8f0; }
    #po .tp-tablo td.sol { text-align: left !important; } #po .tp-tablo td.para { font-variant-numeric: tabular-nums; font-weight: 700; text-align: right !important; } #po .tp-tablo td.kurum { font-weight: 700; color: #0f172a; }
    #po .tp-tablo td small { display: block; font-size: .58rem; color: #64748b; font-weight: 500; line-height: 1.15; margin-top: 1px; overflow: hidden; text-overflow: ellipsis; }
    #po .tp-tablo td b { font-weight: 700; }
    #po .tp-tablo tr.tik { cursor: pointer; } #po .tp-tablo tr.tik:hover td { background: #eff6ff; }
    #po .tp-tablo tr.onayli td { background: #f0fdf4; } #po .tp-tablo tr.eksik td { background: #fef2f2; } #po .tp-tablo tr.bekliyor td { background: #fffbeb; }
    #po .tp-tablo tr.toplam td { font-weight: 800; background: #f8fafc; border-top: 2px solid #1d4ed8; }
    #po .tp-tablo tr.ara td { background: #f1f5f9; font-weight: 800; border-top: 1px solid #cbd5e1; }
    #po .tp-tablo .btn-xs { font-size: .6rem; padding: 1px 6px; line-height: 1.3; }
    .tp-bozet { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 6px; } .tp-bozet > div { background: #fff; border: 1px solid #e2e8f0; border-left: 3px solid var(--k, #94a3b8); border-radius: 8px; padding: 6px 9px; min-width: 0; }
    .tp-bozet .l { font-size: .56rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .tp-bozet .v { font-size: .86rem; font-weight: 800; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .tp-bozet .s { font-size: .58rem; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    @@media (max-width: 1500px) { .tp-bozet { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    #po .rt-durum { font-size: .56rem; font-weight: 800; padding: 1px 5px; border-radius: 4px; line-height: 1.3; gap: 3px; } #po .rt-durum i { font-size: .5rem; }
    .tp-onay { display: inline-block; font-size: .56rem; font-weight: 800; border-radius: 4px; padding: 1px 5px; white-space: nowrap; } .tp-onay.bekliyor { background: #fef3c7; color: #92400e; } .tp-onay.onayli { background: #dcfce7; color: #166534; } .tp-onay.eksik { background: #fee2e2; color: #991b1b; }
    .tp-es { display: inline-block; font-size: .56rem; font-weight: 800; border-radius: 4px; padding: 1px 5px; white-space: nowrap; } .tp-es.var { background: #dbeafe; color: #1e40af; } .tp-es.yok { background: #fee2e2; color: #991b1b; } .tp-es.disi { background: #f1f5f9; color: #475569; } .tp-es.gonder { background: #ede9fe; color: #5b21b6; }
    .tp-tur { display: inline-block; font-size: .56rem; font-weight: 800; border-radius: 4px; padding: 1px 6px; color: #fff; white-space: nowrap; background: #64748b; } .tp-tur.havale { background: #1d4ed8; } .tp-tur.cek { background: #0369a1; } .tp-tur.kira { background: #b45309; }
    .tp-link { font-weight: 700; font-size: .63rem; color: #1d4ed8; cursor: pointer; text-decoration: none; } .tp-link:hover { text-decoration: underline; }
    .tp-drawer { position: fixed; top: 0; right: -760px; width: 720px; max-width: 96vw; height: 100vh; background: #fff; box-shadow: -8px 0 24px rgba(15,23,42,.18); z-index: 1060; transition: right .25s; overflow: auto; padding: 12px 14px; } .tp-drawer.acik { right: 0; }
    .main-content #poDrawer { height: 100vh !important; max-height: 100vh !important; overflow: auto !important; }
    .tp-drawer-ust { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; position: sticky; top: 0; background: #fff; padding-bottom: 6px; border-bottom: 1px solid #e2e8f0; z-index: 2; flex-wrap: wrap; }
    .tp-perde { position: fixed; inset: 0; background: rgba(15,23,42,.35); z-index: 1055; display: none; } .tp-perde.acik { display: block; }
    .tp-fis { font-size: .7rem; } .tp-fis td, .tp-fis th { padding: 3px 6px; }
    /* bu ayın ödeme takvimi: gün kartları */
    .po-takvim { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; } @@media (max-width: 1300px) { .po-takvim { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    .po-gun { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 6px 8px; min-width: 0; } .po-gun.gecti { background: #f8fafc; } .po-gun.bugun { border-color: #1d4ed8; box-shadow: 0 0 0 2px #dbeafe; }
    .po-gun .g { display: flex; align-items: baseline; gap: 6px; font-size: .62rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; } .po-gun .g b { font-size: .95rem; color: #0f172a; } .po-gun .g .t { margin-left: auto; font-size: .64rem; color: #0f172a; font-variant-numeric: tabular-nums; }
    .po-gun ul { list-style: none; margin: 4px 0 0; padding: 0; } .po-gun li { font-size: .62rem; line-height: 1.2; padding: 2px 0; border-top: 1px dashed #e2e8f0; display: flex; gap: 4px; align-items: center; } .po-gun li .ad { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .po-gun li .ad small { color: #64748b; display: block; font-size: .56rem; }
    .po-gun li i.d { width: 7px; height: 7px; border-radius: 50%; flex: none; background: #94a3b8; } .po-gun li i.d.ok { background: #16a34a; } .po-gun li i.d.plan { background: #0369a1; } .po-gun li i.d.yok { background: #dc2626; }
</style>
}

<div class="container-fluid py-3 na po" id="po" data-sirket="@onSirket" data-id="@onId">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-calendar-check"></i></span>Planlı Ödemeler</h4>
        <a class="tp-pill" href="/Rapor123?sekme=duzenli" target="_blank" rel="noopener" title="Konsolide Finansal Takip Paneli › Düzenli Ödemeler sekmesi — aynı liste"><i class="fas fa-clipboard-check me-1"></i>Takip Paneli › Düzenli Ödemeler ile aynı liste</a>
        <a class="tp-pill" href="/Rapor79" target="_blank" rel="noopener"><i class="fas fa-wallet me-1"></i>Kasa Nakit Akışı</a>
        <span class="tp-pill" id="poKapsam">yükleniyor…</span>
        <span class="sub w-100">Her ay tekrarlayan <b>planlı düzenli ödemeler</b> (aylık ödeme takvim listesi): tedarikçi, ürün / hizmet, şirket, ödeme şekli, ödeme günü, ortalama aylık tutar ve kategori. Aktif her kayıt için <b>her ay otomatik</b> olarak o ayın ödeme gününe planlanmış bir <b>Kasa Nakit Akışı</b> satırı açılır (nakit satırı nakit onayına düşer); <b>Bu Ayı Akıt</b> eksikleri tamamlar, <b>Gelecek Ayı Planla</b> gelecek ayı şimdiden planlar, satırdaki ▶ tek kaydı akıtır. Bu liste Konsolide Finansal Takip Paneli'ndeki <b>Düzenli Ödemeler</b> sekmesiyle <b>aynıdır</b>: burada ya da panelde yapılan kayıt, düzenleme, pasife alma ve akıtma iki ekranda da anında görünür. Satıra tıklayınca kayıt, akan aylar (nakit akış satırı, durum, makbuz / fiş) ve günlük açılır.</span>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>

    <div class="na-kart">
        <div class="na-kart-b"><span><i class="fas fa-calendar-check me-1"></i>Planlı Düzenli Ödemeler · Her Ay Otomatik Nakit Akışa Akar</span><span class="d-flex gap-1 align-items-center flex-wrap"><button type="button" class="btn btn-success btn-sm py-0" id="poAkit" style="font-size:.64rem" title="Bu ay için nakit akışa akmamış aktif planlı ödemeleri Kasa Nakit Akışı'na akıt"><i class="fas fa-play me-1"></i>Bu Ayı Akıt</button><button type="button" class="btn btn-primary btn-sm py-0" id="poSonraki" style="font-size:.64rem" title="Gelecek ayın planlı ödemelerini şimdiden Kasa Nakit Akışı'na planla"><i class="fas fa-forward me-1"></i>Gelecek Ayı Planla</button><button type="button" class="btn btn-light border btn-sm py-0" id="poYeni" style="font-size:.64rem"><i class="fas fa-plus me-1"></i>Yeni Planlı Ödeme</button><button type="button" class="btn btn-light border btn-sm py-0" id="poExcel" style="font-size:.64rem"><i class="fas fa-file-excel me-1"></i>Excel</button></span></div>
        <div class="na-kart-g">
            <div class="tp-filtre">
                <div><label>Şirket</label><select class="form-select" id="poSirket"><option value="">Tüm Şirketler (Konsolide)</option></select></div>
                <div><label>Durum</label><select class="form-select" id="poDurum"><option value="">Tümü</option><option value="odendi">Bu Ay Ödendi</option><option value="bekliyor">Bu Ay Planlı (Bekliyor)</option><option value="akmadi">Bu Aya Akmamış</option><option value="aktif">Aktif</option><option value="pasif">Pasif</option></select></div>
                <div><label>Kategori</label><select class="form-select" id="poKategori"><option value="">Tümü</option></select></div>
                <div><label>Ödeme Şekli</label><select class="form-select" id="poSekil"><option value="">Tümü</option></select></div>
                <div><label>Ara</label><input class="form-control" id="poAra" placeholder="No, tedarikçi, ürün / hizmet, şirket, kategori…" autocomplete="off"></div>
            </div>
            <div class="tp-bozet mt-2" id="poOzet"></div>
        </div>
    </div>

    <div class="na-kart">
        <div class="na-kart-b"><span><i class="fas fa-list me-1"></i>Planlı Ödeme Listesi · Şirket Bazında Alt Toplamlar · Sorumlu: <span id="poSorumlu"></span></span><span class="not" id="poSayi"></span></div>
        <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo tp-tablo" id="poTablo" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
    </div>

    <div class="na-kart">
        <div class="na-kart-b"><span><i class="fas fa-calendar-days me-1"></i>Bu Ayın Ödeme Takvimi · <span id="poTakvimAy"></span></span><span class="not">gün bazında · yeşil ödendi · mavi nakit akışta planlı · kırmızı akmamış · gri pasif</span></div>
        <div class="na-kart-g"><div class="po-takvim" id="poTakvim"></div></div>
    </div>

    <div class="tp-perde" id="poPerde"></div>
    <div class="tp-drawer" id="poDrawer">
        <div class="tp-drawer-ust"><b id="poDBaslik" style="font-size:.88rem"></b><span class="ms-auto"></span><button type="button" class="btn btn-light btn-sm py-0" id="poDKapat" style="font-size:.66rem"><i class="fas fa-xmark"></i></button></div>
        <div id="poDIc"></div>
    </div>
</div>
@section Scripts {
<script src="/js/planli-odeme.js?v=1"></script>
}
