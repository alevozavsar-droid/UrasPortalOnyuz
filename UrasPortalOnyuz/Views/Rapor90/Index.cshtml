@model WebApplication3.Controllers.Rapor90ViewModel
@{
    ViewData["Title"] = "Belge Aktarım Denetimi";
}


<style>
    body { background-color: #f4f6f9; }
    .dash-card { border-radius: 12px; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: transform 0.2s; background: white; }
    .icon-box { width: 48px; height: 48px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 22px; }
    .bg-gradient-primary { background: linear-gradient(45deg, #4e73df, #224abe); color: white; }
    .bg-gradient-success { background: linear-gradient(45deg, #1cc88a, #13855c); color: white; }
    .bg-gradient-warning { background: linear-gradient(45deg, #f6c23e, #dda20a); color: white; }
    .bg-gradient-danger { background: linear-gradient(45deg, #e74a3b, #be2617); color: white; }
    .bg-gradient-dark { background: linear-gradient(45deg, #343a40, #1d2124); color: white; }
    .bg-gradient-purple { background: linear-gradient(45deg, #6f42c1, #4e2b8c); color: white; }
    .bg-gradient-info { background: linear-gradient(45deg, #36b9cc, #258391); color: white; }
    .bg-gradient-secondary { background: linear-gradient(45deg, #6c757d, #495057); color: white; }
    
    .table-custom th { background-color: #f8f9fc; text-transform: uppercase; font-size: 12px; color: #858796; border-bottom: 2px solid #e3e6f0; }
    .table-custom td { vertical-align: middle; font-size: 13px; color: #5a5c69; }
    
    .nav-pills-custom .nav-link { color: #5a5c69; font-weight: 600; border-radius: 20px; padding: 8px 20px; margin-right: 10px; transition: all 0.2s ease-in-out; background-color: transparent;}
    .nav-pills-custom .nav-link:hover { background-color: #e3e6f0; }
    .nav-pills-custom .nav-link.active { background-color: #212529; color: white; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    
    .filter-bar { background-color: #f8f9fc; border-bottom: 1px solid #e3e6f0; padding: 10px 15px; border-radius: 12px 12px 0 0; }
    .btn-filter { font-weight: 600; border-radius: 20px; font-size: 12px; padding: 6px 16px; transition: all 0.2s; }
</style>

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0 text-gray-800 fw-bold"><i class="fas fa-file-invoice me-2 text-primary"></i> Belge Aktarım Paneli (M1408 ➔ T0223)</h2>
        <button class="btn btn-primary btn-sm fw-bold shadow-sm rounded-pill px-3" onclick="location.reload()">
            <i class="fas fa-redo me-1"></i> Sayfayı Yenile
        </button>
    </div>

    <div class="alert @(Model.Sayim.GercekFark == 0 ? "alert-success" : "alert-warning") shadow-sm d-flex justify-content-between align-items-center py-2 mb-4 border-0 border-start border-4 @(Model.Sayim.GercekFark == 0 ? "border-success" : "border-warning")">
        <div>
            <i class="fas fa-balance-scale fs-5 me-2"></i>
            <span class="fw-bold">Belge Aktarım Hacmi (14.04.2026 Sonrası)</span>
        </div>
        <div class="fw-bold fs-6 d-flex align-items-center">
            <span class="me-3">URAS: <span class="text-dark">@Model.Sayim.KaynakSayi.ToString("N0")</span></span>
            <span class="me-3">SELVI: <span class="text-dark">@Model.Sayim.HedefSayi.ToString("N0")</span></span>
            <span class="me-3">Ref. Atlanan: <span class="text-secondary">@Model.Sayim.AtlananReferansSayisi.ToString("N0")</span></span>
            <span>GERÇEK EKSİK: <span class="badge @(Model.Sayim.GercekFark == 0 ? "bg-success" : "bg-danger") px-2 py-1 fs-6">@Model.Sayim.GercekFark.ToString("N0")</span></span>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-2 mb-2">
            <div class="card dash-card h-100 py-2 border-start border-4 border-warning">
                <div class="card-body px-3 py-2">
                    <div class="row align-items-center">
                        <div class="col me-2">
                            <div class="text-xs fw-bold text-warning text-uppercase mb-1">Kuyrukta Bekleyen</div>
                            <div class="h4 mb-0 fw-bold text-gray-800">@Model.Summary.BekleyenSayisi.ToString("N0")</div>
                        </div>
                        <div class="col-auto"><div class="icon-box bg-gradient-warning" style="width:36px;height:36px;font-size:16px;"><i class="fas fa-hourglass-half"></i></div></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-2 mb-2">
            <div class="card dash-card h-100 py-2 border-start border-4 border-danger">
                <div class="card-body px-3 py-2">
                    <div class="row align-items-center">
                        <div class="col me-2">
                            <div class="text-xs fw-bold text-danger text-uppercase mb-1">Gerçek Hata (E)</div>
                            <div class="h4 mb-0 fw-bold text-gray-800">@Model.Summary.HataliSayisi.ToString("N0")</div>
                        </div>
                        <div class="col-auto"><div class="icon-box bg-gradient-danger" style="width:36px;height:36px;font-size:16px;"><i class="fas fa-times-circle"></i></div></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-2 mb-2">
            <div class="card dash-card h-100 py-2 border-start border-4 border-secondary">
                <div class="card-body px-3 py-2">
                    <div class="row align-items-center">
                        <div class="col me-2">
                            <div class="text-xs fw-bold text-secondary text-uppercase mb-1">Referansı Dolu</div>
                            <div class="h4 mb-0 fw-bold text-gray-800">@Model.Sayim.AtlananReferansSayisi.ToString("N0")</div>
                        </div>
                        <div class="col-auto"><div class="icon-box bg-gradient-secondary" style="width:36px;height:36px;font-size:16px;"><i class="fas fa-ban"></i></div></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-2 mb-2">
            <div class="card dash-card h-100 py-2 border-start border-4 border-purple" style="border-color: #6f42c1 !important;">
                <div class="card-body px-3 py-2">
                    <div class="row align-items-center">
                        <div class="col me-2">
                            <div class="text-xs fw-bold text-uppercase mb-1" style="color: #6f42c1;">Gerçek Eksikler</div>
                            <div class="h4 mb-0 fw-bold text-gray-800">@Model.EksikKayitlar.Count.ToString("N0")</div>
                        </div>
                        <div class="col-auto"><div class="icon-box bg-gradient-purple" style="width:36px;height:36px;font-size:16px;"><i class="fas fa-search-minus"></i></div></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-2">
            <div class="card dash-card h-100 py-2 border-start border-4 border-success">
                <div class="card-body px-3 py-2">
                    <div class="row align-items-center">
                        <div class="col me-2">
                            <div class="text-xs fw-bold text-success text-uppercase mb-1">Başarılı İşlem</div>
                            <div class="h4 mb-0 fw-bold text-gray-800">@Model.Summary.BasariliSayisi.ToString("N0")</div>
                        </div>
                        <div class="col-auto"><div class="icon-box bg-gradient-success" style="width:36px;height:36px;font-size:16px;"><i class="fas fa-check-double"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card dash-card mb-4 p-2">
        <ul class="nav nav-pills nav-pills-custom mb-3 border-bottom pb-2" id="pills-tab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(!Model.EksikKayitlar.Any() && !Model.ReferansiDoluKayitlar.Any() && !Model.IptalFarkliKayitlar.Any() && !Model.MukerrerKayitlar.Any() ? "active" : "")" id="pills-kuyruk-tab" data-bs-toggle="pill" data-bs-target="#pills-kuyruk" type="button" role="tab">
                    <i class="fas fa-list me-1"></i> Robot Kuyruk Listesi
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.EksikKayitlar.Any() ? "active" : "")" id="pills-eksik-tab" data-bs-toggle="pill" data-bs-target="#pills-eksik" type="button" role="tab">
                    <i class="fas fa-search-minus text-purple me-1"></i> Gerçek Eksikler
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(!Model.EksikKayitlar.Any() && Model.ReferansiDoluKayitlar.Any() ? "active" : "")" id="pills-ref-tab" data-bs-toggle="pill" data-bs-target="#pills-ref" type="button" role="tab">
                    <i class="fas fa-ban text-secondary me-1"></i> Referansı Dolu Olanlar
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(!Model.EksikKayitlar.Any() && !Model.ReferansiDoluKayitlar.Any() && Model.IptalFarkliKayitlar.Any() ? "active" : "")" id="pills-iptal-tab" data-bs-toggle="pill" data-bs-target="#pills-iptal" type="button" role="tab">
                    <i class="fas fa-not-equal text-info me-1"></i> İptal Edilenler
                </button>
            </li>
        </ul>

        <div class="tab-content" id="pills-tabContent">
            
            <div class="tab-pane fade @(!Model.EksikKayitlar.Any() && !Model.ReferansiDoluKayitlar.Any() && !Model.IptalFarkliKayitlar.Any() && !Model.MukerrerKayitlar.Any() ? "show active" : "")" id="pills-kuyruk" role="tabpanel">
                <div class="filter-bar d-flex flex-wrap justify-content-between align-items-center bg-transparent border-0 px-0 pb-3">
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-dark btn-filter" onclick="filterTable('all', this)">Tümü</button>
                        <button class="btn btn-outline-danger btn-filter text-danger" onclick="filterTable('E', this)"><i class="fas fa-times-circle me-1"></i> Hatalar</button>
                        <button class="btn btn-outline-warning text-dark btn-filter" onclick="filterTable('P', this)"><i class="fas fa-hourglass-half me-1"></i> Bekleyenler</button>
                        <button class="btn btn-outline-success text-success btn-filter" onclick="filterTable('S', this)"><i class="fas fa-check-circle me-1"></i> Başarılılar</button>
                    </div>
                </div>
                
                <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-hover table-custom mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width: 80px;">Sıra</th>
                                <th>Belge Tipi</th>
                                <th>Kyn. DocEntry</th>
                                <th>Kyn. DocNum</th>
                                <th>Hdf. DocNum</th>
                                <th>Durum</th>
                                <th>Mesaj / Hata</th>
                                <th class="text-center" style="width: 120px;">Aksiyon</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(Model.KuyrukListesi.Count == 0) { <tr><td colspan="8" class="text-center py-4 text-muted">Kayıt yok.</td></tr> }
                            
                            @foreach (var item in Model.KuyrukListesi)
                            {
                                <tr class="queue-row" data-status="@item.Durum" id="row-@item.KuyrukNo">
                                    <td class="fw-bold">@item.KuyrukNo</td>
                                    <td class="fw-bold text-dark">@item.BelgeTipi</td>
                                    <td class="text-primary fw-bold">@item.KaynakDocEntry</td>
                                    <td><span class="badge bg-dark">@item.KaynakDocNum</span></td>
                                    <td>@if(item.HedefDocNum != "-") { <span class="badge bg-success">@item.HedefDocNum</span> } else { <span>-</span> }</td>
                                    <td><span class="badge @item.DurumBadgeClass px-2 py-1" id="status-badge-@item.KuyrukNo"><i class="fas @item.DurumIkonu me-1"></i> @item.DurumMetni</span></td>
                                    <td class="@(item.Durum == "E" ? "text-danger fw-bold" : "text-dark") small">@item.HataMesaji</td>
                                    
                                    <td class="text-center">
                                        @if (item.Durum == "E")
                                        {
                                            <div class="d-flex justify-content-center gap-1">
                                                <button class="btn btn-sm btn-outline-primary shadow-sm" onclick="retrySingle(@item.KuyrukNo)" title="Tekrar Dene" id="btn-retry-@item.KuyrukNo">
                                                    <i class="fas fa-redo-alt"></i>
                                                </button>
                                                
                                              @if(item.HataMesaji.Contains("Kaynak Stok Kodu"))
{
    <button class="btn btn-sm btn-warning shadow-sm" data-msg="@item.HataMesaji" onclick="openMatchModal(this.getAttribute('data-msg'), @item.KuyrukNo)" title="Benzer Stok Kodunu Eşleştir">
        <i class="fas fa-search"></i>
    </button>
}
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade @(Model.EksikKayitlar.Any() ? "show active" : "")" id="pills-eksik" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-2 px-2">
                    <span class="text-muted fw-bold small"><i class="fas fa-info-circle me-1"></i> Bu belgeler hedefte YOK ve referansları BOŞ.</span>
                    @if(Model.EksikKayitlar.Any()) { <button class="btn btn-sm btn-warning fw-bold rounded-pill shadow-sm" onclick="forceAddMissing()"><i class="fas fa-bolt me-1"></i> Eksikleri Kuyruğa Gönder</button> }
                </div>
                <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-hover table-custom mb-0">
                        <thead class="sticky-top" style="background-color: #f3e8ff;">
                            <tr><th>Belge Tipi</th><th>DocEntry</th><th>DocNum</th><th>Tarih</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var eksik in Model.EksikKayitlar){ <tr><td><span class="badge bg-secondary">@eksik.BelgeTipi</span></td><td class="fw-bold" style="color: #6f42c1;">@eksik.KaynakDocEntry</td><td><span class="badge bg-dark fs-6">@eksik.KaynakDocNum</span></td><td>@eksik.Tarih</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>

            </div>
    </div>
</div>

<div class="modal fade" id="matchModal" tabindex="-1" aria-labelledby="matchModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header bg-warning text-dark border-0">
        <h5 class="modal-title fw-bold" id="matchModalLabel"><i class="fas fa-link me-2"></i> Akıllı Stok Eşleştirme Sistemi</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body bg-light">
        <div class="alert alert-dark shadow-sm">
            <span class="text-muted d-block small mb-1">Kaynak Sistemde (URASKIMYA) Bulunamayan Kod:</span>
            <span id="lblKaynakKodu" class="text-danger fw-bold fs-5 d-inline-block me-3"></span>
            <span id="lblKaynakIsim" class="text-dark fw-bold border-start border-2 border-danger ps-3 py-1"></span>
        </div>
        
        <p class="text-muted small mb-2"><i class="fas fa-robot text-primary me-1"></i> Robot, Hedef (SELVI) veri tabanında isme ve koda en çok benzeyen 10 adayı aşağıda listeledi:</p>
        
        <div class="table-responsive rounded shadow-sm border bg-white">
          <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="py-2 px-3">Hedef Kod (SELVI)</th>
                    <th class="py-2">Hedef İsim (SELVI)</th>
                    <th class="text-center py-2">Aksiyon</th>
                </tr>
            </thead>
            <tbody id="matchTableBody">
                </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
    function filterTable(status, btnElement) {
        var buttons = document.querySelectorAll('.btn-filter');
        buttons.forEach(b => {
            b.className = 'btn btn-filter ' + (
                b.innerText.includes('Tümü') ? 'btn-outline-dark text-dark' : 
                b.innerText.includes('Hatalar') ? 'btn-outline-danger text-danger' : 
                b.innerText.includes('Başarılı') ? 'btn-outline-success text-success' : 'btn-outline-warning text-dark'
            );
        });
        if(status === 'all') btnElement.className = 'btn btn-dark btn-filter text-white';
        else if(status === 'E') btnElement.className = 'btn btn-danger btn-filter text-white';
        else if(status === 'P') btnElement.className = 'btn btn-warning btn-filter text-dark border-warning';
        else if(status === 'S') btnElement.className = 'btn btn-success btn-filter text-white';

        var rows = document.querySelectorAll('.queue-row');
        rows.forEach(row => { row.style.display = (status === 'all' || row.getAttribute('data-status') === status) ? '' : 'none'; });
    }

    function retrySingle(id) {
        var btn = document.getElementById('btn-retry-' + id);
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>'; btn.disabled = true;
        $.ajax({
            url: '/Rapor90/TekrarKuyrugaEkle', type: 'POST', data: { id: id },
            success: function (res) { if (res.success) { location.reload(); } else { alert(res.message); } }
        });
    }

    function retryAllErrors() {
        if (!confirm("Tüm hatalı kayıtları tekrar denemek istediğinize emin misiniz?")) return;
        $.ajax({ url: '/Rapor90/TumHatalilariKuyrugaEkle', type: 'POST', success: function (res) { location.reload(); } });
    }

    function forceAddMissing() {
        if (!confirm("EKSİK belgeleri kuyruğa almak istediğinize emin misiniz?")) return;
        $.ajax({ url: '/Rapor90/TumEksikleriKuyrugaEkle', type: 'POST', success: function (res) { location.reload(); } });
    }

    // =========================================================================
    // 🚀 YENİ: BENZER STOK BULMA VE GÜNCELLEME JAVASCRIPT KODLARI 🚀
    // =========================================================================
    let currentKuyrukId = 0;
    let currentKaynakCode = "";

    function openMatchModal(errMsg, kuyrukId) {
        currentKuyrukId = kuyrukId;
        
        // Regex ile hata mesajından stok kodunu çıkarır: Örn. 'T11.YL.XPI.05'
        let match = errMsg.match(/Kaynak Stok Kodu '(.*?)' için/);
        
        if(match && match[1]) {
            currentKaynakCode = match[1];
            document.getElementById('lblKaynakKodu').innerText = currentKaynakCode;
            document.getElementById('lblKaynakIsim').innerText = "Aranıyor...";
            document.getElementById('matchTableBody').innerHTML = '<tr><td colspan="3" class="text-center py-4"><i class="fas fa-spinner fa-spin fs-4 text-warning"></i><br>Benzer kayıtlar taranıyor...</td></tr>';
            
            var matchModal = new bootstrap.Modal(document.getElementById('matchModal'));
            matchModal.show();

            // API'ye gidip listeyi getir
            $.ajax({
                url: '/Rapor90/BulBenzerStok?kaynakItemCode=' + encodeURIComponent(currentKaynakCode),
                type: 'GET',
                success: function(res) {
                    if(res.success) {
                        document.getElementById('lblKaynakIsim').innerText = res.kaynakIsim;
                        let html = '';
                        if(res.data.length === 0) {
                            html = '<tr><td colspan="3" class="text-center text-danger py-3"><i class="fas fa-exclamation-triangle"></i> SELVI şirketinde benzer isme veya koda sahip hiçbir stok kartı bulunamadı.</td></tr>';
                        } else {
                            res.data.forEach(x => {
                                html += `<tr>
                                            <td class="fw-bold px-3 align-middle text-primary">${x.itemCode}</td>
                                            <td class="align-middle">${x.itemName}</td>
                                            <td class="text-center align-middle">
                                                <button class="btn btn-sm btn-success fw-bold px-3 shadow-sm rounded-pill" onclick="updateAndRetry('${x.itemCode}')">
                                                    <i class="fas fa-link"></i> Eşleştir
                                                </button>
                                            </td>
                                         </tr>`;
                            });
                        }
                        document.getElementById('matchTableBody').innerHTML = html;
                    } else {
                        document.getElementById('matchTableBody').innerHTML = `<tr><td colspan="3" class="text-danger text-center py-3">${res.message}</td></tr>`;
                    }
                },
                error: function() {
                    document.getElementById('matchTableBody').innerHTML = '<tr><td colspan="3" class="text-danger text-center py-3">Sorgu sırasında sunucu hatası oluştu!</td></tr>';
                }
            });

        } else {
            alert("Hata mesajından stok kodu çıkarılamadı!");
        }
    }

    function updateAndRetry(hedefCode) {
        if(!confirm(`URAS'taki '${currentKaynakCode}' stok kodunu SELVI'deki '${hedefCode}' kodlu kartla bağlamak istediğinize emin misiniz?\n\nBu işlem Hedef sistemdeki 'U_BE1_URASKODU' alanını güncelleyip belgeyi tekrar kuyruğa alacaktır.`)) return;

        $.ajax({
            url: '/Rapor90/GuncelleUrasKodu',
            type: 'POST',
            data: { kaynakItemCode: currentKaynakCode, hedefItemCode: hedefCode, kuyrukId: currentKuyrukId },
            success: function(res) {
                if(res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert("Hata: " + res.message);
                }
            }
        });
    }
</script>