@model List<WebApplication3.Models.MutabakatSonucModel>

@{
    ViewData["Title"] = "Mutabakat Durum Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fas fa-list-alt me-2"></i>Gönderilen Mutabakatlar ve Cevaplar</h4>
            <a href="/Rapor59/Index" class="btn btn-light btn-sm fw-bold">
                <i class="fas fa-arrow-left me-1"></i> Gönderim Ekranına Dön
            </a>
        </div>
        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover" id="tblSonuclar">
                    <thead class="table-light">
                        <tr>
                            <th>Cari Adı</th>
                            <th>Bakiye</th>
                            <th>Gönderim Tarihi</th>
                            <th>Gönderen</th>
                            <th>Durum</th>
                            <th style="width: 30%;">Müşteri Notu</th>
                            <th>Cevap Tarihi</th>
                            <th>IP Adresi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.CardName</strong><br />
                                    <small class="text-muted">@item.CardCode</small>
                                </td>
                                <td>@item.Bakiye.ToString("N2") @item.ParaBirimi</td>
                                <td>@item.GonderimTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@item.Gonderen</td>
                                <td class="text-center align-middle">
                                    @if (item.Durum == 1)
                                    {
                                        <span class="badge bg-success" style="font-size:13px; padding:8px; width:100%;">
                                            <i class="fas fa-check-circle me-1"></i> MUTABIKIZ
                                        </span>
                                    }
                                    else if (item.Durum == 2)
                                    {
                                        <span class="badge bg-danger" style="font-size:13px; padding:8px; width:100%;">
                                            <i class="fas fa-times-circle me-1"></i> REDDETTİ
                                        </span>
                                    }
                                    else if (item.Durum == 3) // YENİ EKLENEN KISIM
                                    {
                                        <span class="badge bg-info text-dark" style="font-size:13px; padding:8px; width:100%;">
                                            <i class="fas fa-file-invoice me-1"></i> EKSTRE İSTEDİ
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark" style="font-size:13px; padding:8px; width:100%;">
                                            <i class="fas fa-hourglass-half me-1"></i> BEKLİYOR
                                        </span>
                                    }
                                </td>
                                <td class="small">
                                    @if (!string.IsNullOrEmpty(item.MusteriNotu))
                                    {
                                        // Tarih bilgisini vurgulamak için basit bir renklendirme
                                        if (item.MusteriNotu.Contains("[TARİH:"))
                                        {
                                            <span class="text-primary fw-bold">@item.MusteriNotu</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">@item.MusteriNotu</span>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (item.CevapTarihi.HasValue)
                                    {
                                        @item.CevapTarihi.Value.ToString("dd.MM.yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td><small class="text-muted">@item.IpAdresi</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>