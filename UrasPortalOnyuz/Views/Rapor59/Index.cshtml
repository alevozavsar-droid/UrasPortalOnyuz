@{
    ViewData["Title"] = "E-Mutabakat";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string onKod = (string)ViewBag.Kod ?? "";
}
@*
    E-MUTABAKAT — yeni tasarım. Kayıtlı iletişim bilgileriyle (ana mutabakat yetkilisinin e-postası / cep telefonu) sistem üzerinden otomatik mutabakat:
    E-POSTA (PDF ekstre + yanıt bağlantısı) ve WHATSAPP (kısa mesaj + yanıt bağlantısı) kanalları; şablondan üretilen mesaj, tekil / toplu gönderim, hatırlatma, cari yanıtı (Mutabık / İtirazlı),
    yanıt senkronu, iletişim bilgisi düzeltme. Veri ve kurallar: Data/EMutabakatOrnek.cs (Cari Mutabakat üzerinde) · uçlar: Controllers/EMutabakatController.cs · betik: wwwroot/js/e-mutabakat.js
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<link rel="stylesheet" href="/css/cari-islem.css?v=1" />
}
<div class="container-fluid py-3 na ci em" id="em" data-kod="@onKod">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-paper-plane"></i></span>E-Mutabakat</h4>
        <span style="font-size:.68rem;font-weight:700;color:#475569;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:999px;padding:3px 10px"><i class="fas fa-database me-1"></i>Cari Mutabakat · İletişim Bilgileri</span>
        <span class="ci-kanal mail"><i class="fas fa-envelope"></i> E-posta</span><span class="ci-kanal wa"><i class="fab fa-whatsapp"></i> WhatsApp</span>
        <span class="sub w-100">Cari kartta kayıtlı <b>ana mutabakat yetkilisinin e-postası ve cep telefonu</b> üzerinden sistem mutabakat talebini kendisi gönderir: e-postaya PDF ekstre ve yanıt bağlantısı, WhatsApp'a kısa mesaj ve aynı bağlantı. Cari bağlantıdan <b>Mutabıkız / İtiraz</b> der, yanıt otomatik işlenir; yanıtsız gönderimlere hatırlatma gider. Mesaj metinleri Şablonlar sekmesinden düzenlenir; mailto: / wa.me bağlantıları cihazdaki posta ve WhatsApp uygulamasını da açar.</span>
    </div>
    <div class="na-sekme" id="emSekmeler" data-dinamik="kapali">
        <button type="button" data-p="liste" class="aktif"><i class="fas fa-list me-1"></i>Cariler <span class="n" id="emN">0</span></button>
        <button type="button" data-p="gonderim"><i class="fas fa-paper-plane me-1"></i>Gönderimler ve Yanıtlar <span class="n" id="emNG">0</span></button>
        <button type="button" data-p="iletisim"><i class="fas fa-address-book me-1"></i>İletişim Bilgileri <span class="n" id="emNI">0</span></button>
        <button type="button" data-p="sablon"><i class="fas fa-file-lines me-1"></i>Şablonlar</button>
        <button type="button" data-p="gunluk"><i class="fas fa-clock-rotate-left me-1"></i>Günlük</button>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>
    <div class="ci-kpi" id="emKpi"></div>
    <div class="na-panel aktif" data-p="liste">
        <div class="row g-2">
            <div class="col-lg-8">
                <div class="na-kart">
                    <div class="na-kart-b"><span><i class="fas fa-filter me-1"></i>Filtreler</span><span class="d-flex gap-1 align-items-center">
                        <button type="button" class="btn btn-light btn-sm py-0" id="emTemizle" style="font-size:.66rem">Temizle</button>
                        <select class="form-select" id="emKanal" style="width:auto;font-size:.66rem;height:24px;padding:0 22px 0 6px"><option value="E-posta">E-posta</option><option value="WhatsApp">WhatsApp</option><option value="İkisi">E-posta + WhatsApp</option></select>
                        <button type="button" class="btn btn-primary btn-sm py-0" id="emSeciliGonder" style="font-size:.66rem" disabled><i class="fas fa-paper-plane me-1"></i>Seçilenlere Gönder</button>
                        <button type="button" class="btn btn-outline-primary btn-sm py-0" id="emHatirlatHepsi" style="font-size:.66rem" title="Hatırlatma zamanı gelmiş tüm bekleyenlere"><i class="fas fa-bell me-1"></i>Hatırlat</button>
                        <button type="button" class="btn btn-light btn-sm py-0" id="emSenkron" style="font-size:.66rem" title="Yanıt bağlantısından gelen cevapları çek"><i class="fas fa-rotate me-1"></i>Yanıtları Çek</button></span></div>
                    <div class="na-kart-g">
                        <div class="ci-filtre">
                            <div><label>Ara</label><input class="form-control" id="emAra" placeholder="Kod, ünvan, yetkili, e-posta…"></div>
                            <div><label>Cari Tipi</label><select class="form-select" id="emTip"><option value="">Tümü</option><option>Müşteri</option><option>Tedarikçi</option></select></div>
                            <div><label>Şirket</label><select class="form-select" id="emSirket"><option value="">Tümü</option></select></div>
                            <div><label>Kanal Uygunluğu</label><select class="form-select" id="emUygun"><option value="">Tümü</option><option value="mail">E-posta Var</option><option value="wa">WhatsApp Var</option><option value="ikisi">İkisi De Var</option><option value="yok">İletişim Eksik</option></select></div>
                            <div><label>E-Mutabakat Durumu</label><select class="form-select" id="emDurum"><option value="">Tümü</option><option>Gönderilmedi</option><option>Yanıt Bekliyor</option><option value="hatirlat">Hatırlatma Zamanı</option><option>Mutabık</option><option>İtirazlı</option></select></div>
                            <div><label>Bakiye</label><select class="form-select" id="emBakiye"><option value="">Tümü</option><option value="var">Bakiyesi Olan</option><option value="yok">Bakiyesi Sıfır</option></select></div>
                            <div class="ms-auto na-mini" id="emSayi"></div>
                        </div>
                        <div class="table-responsive"><table class="na-tablo ci-liste" id="emTablo" data-dinamik="kapali"><thead><tr><th class="s"><input type="checkbox" id="emHepsi" title="Listedekilerin tümünü seç"></th><th>Cari</th><th>Şirket</th><th class="e">Bakiye</th><th>Mutabakat Yetkilisi</th><th>Kanallar</th><th>Son Gönderim</th><th>Durum</th><th></th></tr></thead><tbody></tbody><tfoot></tfoot></table></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="na-kart ci-yan"><div class="na-kart-b"><span><i class="fas fa-eye me-1"></i>Mesaj Önizleme</span><span class="not" id="emOnNot">satıra tıklayın</span></div>
                    <div class="na-kart-g" id="emOnizle"><div class="na-bos">Listeden bir cari seçince e-posta ve WhatsApp mesajı burada görünür.</div></div></div>
            </div>
        </div>
    </div>
    <div class="na-panel" data-p="gonderim">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-paper-plane me-1"></i>Gönderimler ve Yanıtlar</span><span class="d-flex gap-1 align-items-center"><input class="form-control" id="emGAra" placeholder="Belge, cari, kime…" style="width:200px;font-size:.66rem;height:24px"><select class="form-select" id="emGSonuc" style="width:auto;font-size:.66rem;height:24px;padding:0 22px 0 6px"><option value="">Tüm Sonuçlar</option><option>Bekliyor</option><option>Mutabık</option><option>İtirazlı</option></select><select class="form-select" id="emGKanal" style="width:auto;font-size:.66rem;height:24px;padding:0 22px 0 6px"><option value="">Tüm Kanallar</option><option>E-posta</option><option>WhatsApp</option></select><button type="button" class="btn btn-light btn-sm py-0" id="emGExcel" style="font-size:.66rem"><i class="fas fa-file-excel me-1"></i>Excel</button></span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="emGonderimler" data-dinamik="kapali"><thead><tr><th>Belge No</th><th>Gönderim</th><th>Cari</th><th class="s">Kanal</th><th>Kime</th><th>Bakiye Özeti</th><th class="e">TL</th><th class="s">Tekrar</th><th>Sonuç</th><th>Yanıt</th><th>Gönderen</th><th></th></tr></thead><tbody></tbody></table></div></div></div>
    </div>
    <div class="na-panel" data-p="iletisim">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-address-book me-1"></i>Kayıtlı İletişim Bilgileri (Mutabakat Yetkilileri)</span><span class="d-flex gap-1 align-items-center"><input class="form-control" id="emIAra" placeholder="Cari, kişi, e-posta, telefon…" style="width:220px;font-size:.66rem;height:24px"><select class="form-select" id="emIEksik" style="width:auto;font-size:.66rem;height:24px;padding:0 22px 0 6px"><option value="">Tümü</option><option value="mail">E-postası Eksik</option><option value="cep">Cep Telefonu Eksik</option><option value="ana">Ana Yetkili Yok</option></select></span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="emKisiler" data-dinamik="kapali"><thead><tr><th>Cari</th><th>Kişi</th><th>Ünvan · Departman</th><th>E-posta</th><th>Cep Telefonu (WhatsApp)</th><th class="s">Ana Yetkili</th><th></th></tr></thead><tbody></tbody></table></div></div></div>
    </div>
    <div class="na-panel" data-p="sablon">
        <div class="row g-2">
            <div class="col-lg-6"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-envelope me-1"></i>E-posta Şablonu</span><span class="not">PDF ekstre otomatik eklenir</span></div><div class="na-kart-g">
                <label class="na-mini">Konu</label><input class="form-control form-control-sm mb-1" id="emSMailKonu" style="font-size:.68rem">
                <label class="na-mini">Gövde</label><textarea class="form-control" id="emSMailGovde" rows="12"></textarea></div></div></div>
            <div class="col-lg-6"><div class="na-kart"><div class="na-kart-b"><span><i class="fab fa-whatsapp me-1"></i>WhatsApp Şablonu</span><span class="not">kısa metin · tek mesaj</span></div><div class="na-kart-g">
                <label class="na-mini">Mesaj</label><textarea class="form-control mb-1" id="emSWaGovde" rows="6"></textarea>
                <label class="na-mini">Hatırlatma Eki (iki kanalda da)</label><textarea class="form-control" id="emSHatirlatma" rows="3"></textarea></div></div>
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-tags me-1"></i>Yer Tutucular</span></div><div class="na-kart-g"><div id="emAlanlar" class="na-mini" style="font-size:.64rem"></div><div class="d-flex gap-1 mt-2"><button type="button" class="btn btn-primary btn-sm" id="emSablonKaydet"><i class="fas fa-floppy-disk me-1"></i>Şablonu Kaydet</button><span class="na-mini" id="emSablonNot">Hatırlatma eşiği: <b id="emHatGun"></b> gün yanıtsız</span></div></div></div></div>
        </div>
    </div>
    <div class="na-panel" data-p="gunluk">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-clock-rotate-left me-1"></i>Günlük (E-Mutabakat ve İletişim Değişiklikleri)</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="emLog" data-dinamik="kapali"><thead><tr><th>Zaman</th><th>Kullanıcı</th><th>İşlem</th><th>Belge</th><th>Açıklama</th></tr></thead><tbody></tbody></table></div></div></div>
    </div>
</div>
@section Scripts {
<script src="/js/e-mutabakat.js?v=1"></script>
}
