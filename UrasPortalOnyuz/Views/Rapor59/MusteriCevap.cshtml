@model WebApplication3.Models.MutabakatCevapModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>E-Mutabakat - Uras Kimya</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .main-card {
            width: 100%;
            max-width: 600px;
            border: none;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            overflow: hidden;
            background: white;
            position: relative;
        }

        .card-header-custom {
            background: linear-gradient(135deg, #0d6efd, #0dcaf0);
            color: white;
            padding: 30px 20px;
            text-align: center;
        }

        .balance-display {
            background-color: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin: 20px 0;
            border: 1px dashed #ced4da;
        }

        .balance-amount {
            font-size: 2.5rem;
            font-weight: 800;
            color: #dc3545;
        }

        .btn-xl {
            padding: 15px 20px;
            font-size: 1.1rem;
            border-radius: 8px;
            font-weight: 600;
            display: block;
            width: 100%;
            margin-bottom: 10px;
            transition: transform 0.2s, box-shadow 0.2s;
            border: none;
        }

            .btn-xl:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            }

        .hidden-section {
            display: none;
        }

        /* Loading Overlay */
        #loadingOverlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.9);
            z-index: 10;
            display: none;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }
    </style>
</head>
<body>

    <div class="container p-3">
        <div class="main-card mx-auto">

            <div id="loadingOverlay">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                    <span class="visually-hidden">Yükleniyor...</span>
                </div>
                <h5 class="mt-3 text-secondary">İşleminiz Kaydediliyor...</h5>
            </div>

            <div class="card-header-custom">
                <h2 class="fw-bold mb-1"><i class="fas fa-check-double me-2"></i>E-MUTABAKAT</h2>
                <p class="mb-0 opacity-75">URAS KİMYA & URS MAKİNE</p>
            </div>

            <div class="card-body p-4 p-md-5 text-center">

                <h5 class="text-muted mb-3">Sayın Yetkili,</h5>
                <h4 class="fw-bold text-dark mb-4">@Model.CardName</h4>

                <p class="text-secondary">
                    Kayıtlarımıza göre <strong>@Model.Tarih</strong> tarihi itibarıyla firmanızın bakiyesi aşağıdadır:
                </p>

                <div class="balance-display">
                    <div class="balance-amount">
                        @Model.Bakiye.ToString("N2") <span style="font-size:1.5rem;">@Model.ParaBirimi</span>
                    </div>
                    <small class="text-muted">(Borç / Alacak Bakiyesidir)</small>
                </div>

                <div id="buttonGroup">
                    <button class="btn btn-success btn-xl" onclick="showForm('agree')">
                        <i class="fas fa-check-circle me-2"></i> MUTABIKIZ
                    </button>

                    <button class="btn btn-danger btn-xl" onclick="showForm('disagree')">
                        <i class="fas fa-times-circle me-2"></i> MUTABIK DEĞİLİZ
                    </button>

                    <button class="btn btn-info btn-xl text-white" onclick="showForm('statement')">
                        <i class="fas fa-file-invoice me-2"></i> EKSTRE GÖNDERİN
                    </button>
                </div>

                <div id="agreeForm" class="hidden-section text-start mt-3">
                    <div class="alert alert-success border-0 shadow-sm">
                        <label class="fw-bold text-dark mb-2">
                            <i class="fas fa-thumbs-up me-2"></i>Mutabık Olduğunuzu Onaylıyorsunuz
                        </label>
                        <p class="small text-muted mb-1">Varsa ödeme planı veya notunuz (İsteğe bağlı):</p>
                        <textarea class="form-control" id="txtAgreeNote" rows="2" placeholder="Örn: Ödeme Cuma günü yapılacaktır..."></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary flex-fill py-2" onclick="cancelForm()">İptal</button>
                        <button class="btn btn-success flex-fill py-2" onclick="sendResponse(1)">Onayla ve Gönder</button>
                    </div>
                </div>

                <div id="disagreeForm" class="hidden-section text-start mt-3">
                    <div class="alert alert-warning border-0 shadow-sm">
                        <label for="txtDisagreeNote" class="form-label fw-bold text-dark">
                            <i class="fas fa-pen me-2"></i>Lütfen fark nedenini belirtiniz:
                        </label>
                        <textarea class="form-control" id="txtDisagreeNote" rows="4" placeholder="Örn: Bizim kayıtlarımızda bakiye farklı görünmektedir..."></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary flex-fill py-2" onclick="cancelForm()">İptal</button>
                        <button class="btn btn-primary flex-fill py-2" onclick="sendResponse(2)">Gönder</button>
                    </div>
                </div>

                <div id="statementForm" class="hidden-section text-start mt-3">
                    <div class="alert alert-info border-0 shadow-sm">

                        <div class="row g-2 mb-3">
                            <div class="col-12">
                                <label class="fw-bold text-dark mb-1"><i class="fas fa-calendar-alt me-2"></i>Hangi tarih aralığını istiyorsunuz?</label>
                            </div>
                            <div class="col-6">
                                <label class="small text-muted">Başlangıç</label>
                                <input type="date" id="dtStartDate" class="form-control">
                            </div>
                            <div class="col-6">
                                <label class="small text-muted">Bitiş</label>
                                <input type="date" id="dtEndDate" class="form-control">
                            </div>
                        </div>

                        <label for="txtStatementNote" class="form-label fw-bold text-dark">
                            <i class="fas fa-sticky-note me-2"></i>Ek notunuz (Opsiyonel):
                        </label>
                        <textarea class="form-control" id="txtStatementNote" rows="2" placeholder="Örn: Excel formatında rica ederim..."></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary flex-fill py-2" onclick="cancelForm()">İptal</button>
                        <button class="btn btn-primary flex-fill py-2" onclick="sendResponse(3)">Talebi Gönder</button>
                    </div>
                </div>

                <div id="successMessage" class="hidden-section mt-4">
                    <div class="text-success mb-3">
                        <i class="fas fa-check-circle fa-5x"></i>
                    </div>
                    <h3>Teşekkürler!</h3>
                    <p class="text-muted">Cevabınız sistemimize başarıyla kaydedilmiştir.</p>
                    <div class="alert alert-light mt-3 small text-muted border">
                        Bu sayfayı güvenle kapatabilirsiniz.
                    </div>
                </div>

                <div id="errorMessage" class="hidden-section mt-4">
                    <div class="text-danger mb-3">
                        <i class="fas fa-exclamation-triangle fa-4x"></i>
                    </div>
                    <h4>Bir Hata Oluştu!</h4>
                    <p class="text-muted">İşleminiz şu an gerçekleştirilemedi. Bağlantınızı kontrol edip tekrar deneyiniz.</p>
                    <button class="btn btn-outline-dark mt-2" onclick="location.reload()">Sayfayı Yenile</button>
                </div>

            </div>

            <div class="card-footer bg-light text-center py-3">
                <small class="text-muted">&copy; @DateTime.Now.Year - Uras Kimya Bilgi Teknolojileri</small>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            // Sayfa açıldığında Tarihleri Varsayılan Ayarla
            var today = new Date();
            var firstDay = new Date(today.getFullYear(), 0, 1); // Yılın ilk günü

            // Input formatı YYYY-MM-DD olmalı
            document.getElementById("dtEndDate").valueAsDate = today;
            document.getElementById("dtStartDate").valueAsDate = firstDay;
        });

        // Form Gösterme Fonksiyonu
        function showForm(type) {
            $('#buttonGroup').slideUp();
            $('.hidden-section').hide(); // Hepsini gizle önce

            if (type === 'agree') {
                $('#agreeForm').slideDown();
            } else if (type === 'disagree') {
                $('#disagreeForm').slideDown();
            } else if (type === 'statement') {
                $('#statementForm').slideDown();
            }
        }

        // İptal Butonu
        function cancelForm() {
            $('.hidden-section').slideUp();
            $('#buttonGroup').slideDown();
            $('textarea').val('');
        }

        // Tarihi TR formatına çeviren yardımcı fonksiyon (YYYY-MM-DD -> DD.MM.YYYY)
        function formatDateTR(dateString) {
            if(!dateString) return "";
            var parts = dateString.split("-");
            return parts[2] + "." + parts[1] + "." + parts[0];
        }

        // Cevabı Sunucuya Gönder (AJAX)
        function sendResponse(statusCode) {
            var note = "";

            // DURUM 1: MUTABIKIZ (Not Opsiyonel)
            if (statusCode === 1) {
                note = $('#txtAgreeNote').val().trim();
                // Buraya zorunluluk kontrolü KOYMADIK, çünkü isteğe bağlı.
            }
            // DURUM 2: MUTABIK DEĞİLİZ (Zorunlu)
            else if (statusCode === 2) {
                note = $('#txtDisagreeNote').val().trim();
                if (note === "") {
                    alert("Lütfen açıklama alanını doldurunuz.");
                    $('#txtDisagreeNote').focus();
                    return;
                }
            }
            // DURUM 3: EKSTRE İSTEĞİ (Tarihli)
            else if (statusCode === 3) {
                var sDate = $('#dtStartDate').val();
                var eDate = $('#dtEndDate').val();
                var extraNote = $('#txtStatementNote').val().trim();

                if (sDate === "" || eDate === "") {
                    alert("Lütfen başlangıç ve bitiş tarihlerini seçiniz.");
                    return;
                }

                note = "[TARİH: " + formatDateTR(sDate) + " - " + formatDateTR(eDate) + "] ";
                if(extraNote !== "") {
                    note += " - Not: " + extraNote;
                }
            }

            // Loading Başlat
            $('#loadingOverlay').css('display', 'flex');

            var postData = {
                Token: '@Model.Token',
                CevapDurumu: statusCode,
                Aciklama: note
            };

            $.ajax({
                url: '/Rapor59/CevapKaydet',
                type: 'POST',
                data: postData,
                success: function (response) {
                    $('#loadingOverlay').hide();

                    if (response.success) {
                        $('#buttonGroup').hide();
                        $('.hidden-section').hide();
                        $('#successMessage').fadeIn();
                    } else {
                        alert(response.message);
                        location.reload();
                    }
                },
                error: function (xhr, status, error) {
                    $('#loadingOverlay').hide();
                    $('#buttonGroup').hide();
                    $('.hidden-section').hide();
                    $('#errorMessage').fadeIn();
                    console.error("Hata:", error);
                }
            });
        }
    </script>
</body>
</html>