<div class="gg-modal-bg" id="atamaModal">
    <div class="gg-modal" style="width:min(520px,94vw);">
        <div class="gg-modal-head"><h3><i class="fa-solid fa-user-tag"></i> Satırları kullanıcıya ata</h3><button class="x" onclick="kapatAtama()">✕</button></div>
        <div class="gg-modal-body">
            <div class="gg-note" style="margin:0 0 12px;">İşaretli <b id="atamaSayi">0</b> satır seçilen kullanıcıya atanır. Kullanıcı <b>Gider Onay</b> ekranında (<a href="/Rapor167" target="_blank">aç</a>) satırı, SAP detayını ve QNB fatura görüntüsünü görüp onay verir, açıklama yazar. Sonuç bu ekranda "Onay / Açıklama" kolonuna otomatik düşer.</div>
            <div class="gg-form" style="grid-template-columns: 1fr;">
                <div><label>Kullanıcı</label>
                    <div class="at-sec">
                        <input type="text" id="atamaKullaniciAra" placeholder="Kod ya da ad yazın, listeden seçin..." autocomplete="off">
                        <input type="hidden" id="atamaKullanici" value="">
                        <div class="at-sec-liste" id="atamaKullaniciListe" hidden></div>
                    </div>
                    <div id="atamaKullaniciSecili" style="font-size:.76rem; color:#6d28d9; margin-top:4px; min-height:1em;"></div>
                </div>
                <div><label>Not (isteğe bağlı)</label><input type="text" id="atamaNot" placeholder="Kullanıcıya iletilecek kısa not"></div>
                <button class="gg-ekle" id="btnAtamaKaydet"><i class="fa-solid fa-paper-plane"></i> Ata</button>
            </div>
        </div>
    </div>
</div>

<div class="gg-modal-bg" id="tersModal">
    <div class="gg-modal" style="width:min(760px,95vw);">
        <div class="gg-modal-head">
            <h3><i class="fa-solid fa-right-left"></i> Ters Etki Eden Hesaplar</h3>
            <button class="x" onclick="kapatTers()">✕</button>
        </div>
        <div class="gg-modal-body">
            <div class="gg-note" style="margin:0 0 14px;">
                Kural: <b>6'lı = Gelir</b>, <b>7'li = Gider</b>. Ters davranan hesabı (ör. 6'lı ama gider olan Satış İskontosu/İadesi) burada seçip türünü belirle; kayıt <b>@ViewBag.SelectedDb</b> veritabanına yazılır ve satırlar buna göre sekmeye düşer.
            </div>
            <div class="gg-form">
                <div>
                    <label>Hesap (6'lı / 7'li)</label>
                    <input type="text" id="ovHesap" list="ovHesapList" placeholder="Hesap kodu ara/seç...">
                    <datalist id="ovHesapList"></datalist>
                </div>
                <div>
                    <label>Tür</label>
                    <select id="ovTur"><option value="Gider">Gider</option><option value="Gelir">Gelir</option></select>
                </div>
                <div>
                    <label>Açıklama (opsiyonel)</label>
                    <input type="text" id="ovAciklama" placeholder="ör. iskonto, iade...">
                </div>
                <button class="gg-ekle" id="btnOvEkle"><i class="fa-solid fa-plus"></i> Ekle / Güncelle</button>
            </div>
            <table class="gg-kalem" id="ovTable">
                <thead><tr><th>Hesap Kodu</th><th>Hesap Adı</th><th>Tür</th><th>Açıklama</th><th></th></tr></thead>
                <tbody id="ovBody"><tr><td colspan="5" style="text-align:center;color:#94a3b8;padding:16px;">Henüz kural yok.</td></tr></tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.js"></script>
<script src="~/js/gg-kod-secici.js?v=1"></script>
<script>
    // Sayfa hangi şirketle açıldıysa tüm istekler o şirkete gider (sekmeli görünümde başka sekmede şirket değişse bile)
    const DB_QS = new URLSearchParams(location.search).get('db') || '@(ViewBag.DbKey ?? "")';
    const qs = DB_QS ? ('&db=' + encodeURIComponent(DB_QS)) : '';
    const qs1 = DB_QS ? ('?db=' + encodeURIComponent(DB_QS)) : '';
    toastr.options = { positionClass: "toast-bottom-right", timeOut: 4000, progressBar: true };

    // Layout, sayfayi backdrop-filter'li .table-container icine render ediyor; bu,
    // position:fixed modalin kapsayici blogunu viewport yerine o kap yapiyor ve
    // pencere sayfanin gorunmeyen bir yerine (uzun tablonun ortasina) dusuyor.
    // Modalleri body'ye tasiyarak viewport'a gore konumlanmalarini sagliyoruz.
    ['detayModal', 'tersModal', 'faturaModal', 'atamaModal'].forEach(id => {
        const m = document.getElementById(id);
        if (m && m.parentElement !== document.body) document.body.appendChild(m);
    });

    let DATA = { gider: [], gelir: [] };
    let aktifTab = 'gider';
    let sortKey = null, sortDir = 1;
    const secili = { gider: new Set(), gelir: new Set() };

    function esc(s) { return (s == null ? "" : String(s)).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])); }
    function fmt(n) { return (n || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

    // Dönem seçicileri doldur (varsayılan: bu ay)
    const AYLAR = ["Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık"];
    (function donemDoldur() {
        const now = new Date();
        // Adresle gelen dönem (?yil=&ay=, ör. Fatura İnceleme ekranından) varsa o seçilir
        const qp = new URLSearchParams(location.search);
        const secYil = parseInt(qp.get('yil')) || now.getFullYear(), secAy = (parseInt(qp.get('ay')) || (now.getMonth() + 1)) - 1;
        const selAy = document.getElementById('selAy'), selYil = document.getElementById('selYil');
        selAy.innerHTML = AYLAR.map((a, i) => `<option value="${i + 1}" ${i === secAy ? 'selected' : ''}>${a}</option>`).join('');
        let yopt = '';
        for (let y = Math.max(now.getFullYear(), secYil) + 1; y >= Math.min(now.getFullYear(), secYil) - 4; y--) yopt += `<option value="${y}" ${y === secYil ? 'selected' : ''}>${y}</option>`;
        selYil.innerHTML = yopt;
        selAy.addEventListener('change', yukle);
        selYil.addEventListener('change', yukle);
    })();

    function yukle(koru) {
        if (koru instanceof Event) koru = null;   // select change ile çağrıldığında
        const yil = document.getElementById('selYil').value;
        const ay = document.getElementById('selAy').value;
        // Kaydedilmemiş seçim varsa (dönem değişimi / yenileme) kullanıcıya sor; sessizce kaybolmasın
        const bekleyen = Object.keys(KIRLI).length;
        if (bekleyen > 0 && !koru && !confirm(`${bekleyen} satırda henüz kaydedilmemiş kod seçimi var. Kaydetmeden yenilensin mi? (Seçimler kaybolur)`)) return;
        secili.gider.clear(); secili.gelir.clear();
        fetch(`/Rapor163/Veri?yil=${yil}&ay=${ay}${qs}`).then(r => r.json()).then(res => {
            if (!res.success) { toastr.error("Veri alınamadı"); return; }
            if (res.sablon) document.getElementById('sablonUyari').hidden = false;
            DATA.gider = res.gider || [];
            DATA.gelir = res.gelir || [];
            document.getElementById('cntGider').textContent = DATA.gider.length;
            document.getElementById('cntGelir').textContent = DATA.gelir.length;
            for (const k in KIRLI) delete KIRLI[k];
            // Kaydedilemeyen satırların seçimi korunur (kullanıcı düzeltip tekrar kaydedebilsin)
            if (koru) for (const k in koru) { const r = DATA.gider.concat(DATA.gelir).find(x => x.id === k); if (r && koru[k] !== (r.kod || '')) KIRLI[k] = koru[k]; }
            document.getElementById('kodsuzSayi').textContent = res.kodsuz || 0;
            document.getElementById('kodsuzUyari').hidden = !(res.kodsuz > 0);
            if (res.sabitUygulanan > 0) toastr.info(`${res.sabitUygulanan} satıra sabit cari tanımından kod otomatik yazıldı.`, '', { timeOut: 7000 });
            // Adresle gelen kayıt (?vurgu=TransId-LineId&ara=belgeNo): ilgili sekmeye geç, ara, satırı vurgula (Kod Yönetimi › Kullanımı Gör)
            const vurgu = new URLSearchParams(location.search).get('vurgu'), araParam = new URLSearchParams(location.search).get('ara');
            if (vurgu && !window.vurguYapildi) {
                window.vurguYapildi = true;
                const trans = vurgu.split('-')[0];
                const hedef = DATA.gider.find(x => x.id === vurgu || x.id.split('-')[0] === trans) ? 'gider' : DATA.gelir.find(x => x.id === vurgu || x.id.split('-')[0] === trans) ? 'gelir' : null;
                if (hedef) {
                    aktifTab = hedef; document.querySelectorAll('.gg-tab').forEach(x => x.classList.toggle('active', x.dataset.tab === hedef));
                    if (araParam) document.getElementById('ggSearch').value = araParam;
                    render();
                    setTimeout(() => { const chk = document.querySelector(`.row-chk[data-id="${vurgu}"]`) || document.querySelector(`.row-chk[data-id^="${trans}-"]`); if (chk) { const tr = chk.closest('tr'); tr.style.outline = '3px solid #f59e0b'; tr.style.background = '#fffbeb'; tr.scrollIntoView({ block: 'center' }); } else toastr.warning('Aranan satır bu dönemde bulunamadı (iptal edilmiş ya da farklı dönemde olabilir).'); }, 150);
                    return;
                } else toastr.warning('Aranan kayıt bu dönemde listede yok.');
            }
            render();
        }).catch(e => toastr.error("Hata: " + e));
    }

    function aktifListe() {
        let arr = DATA[aktifTab].slice();
        const q = document.getElementById('ggSearch').value.trim().toLowerCase();
        if (q) arr = arr.filter(r => (r.belgeNo + ' ' + r.cari + ' ' + r.hesapKodu + ' ' + r.hesapAdi + ' ' + r.aciklama + ' ' + (r.kod || '') + ' ' + (r.atanan || '') + ' ' + (r.onayAciklama || '')).toLowerCase().includes(q));
        if (sadeceKodsuz) arr = arr.filter(r => !(KIRLI[r.id] !== undefined ? KIRLI[r.id] : r.kod));
        if (sortKey) {
            arr.sort((a, b) => {
                let x = a[sortKey], y = b[sortKey];
                if (typeof x === 'number' && typeof y === 'number') return (x - y) * sortDir;
                return String(x).localeCompare(String(y), 'tr') * sortDir;
            });
        }
        return arr;
    }

    function render() {
        document.getElementById('paneSabit').hidden = aktifTab !== 'sabit';
        document.getElementById('paneOrtak').hidden = aktifTab !== 'ortak';
        document.getElementById('paneAtama').hidden = aktifTab !== 'atama';
        document.getElementById('paneKod').hidden = aktifTab !== 'kod';
        document.getElementById('paneGelmeyen').hidden = aktifTab !== 'gelmeyen';
        document.getElementById('paneAna').hidden = aktifTab === 'sabit' || aktifTab === 'ortak' || aktifTab === 'atama' || aktifTab === 'kod' || aktifTab === 'gelmeyen';
        if (aktifTab === 'kod') { kodPaneliHazirla(); return; }
        if (aktifTab === 'sabit') { sabitYukle(); return; }
        if (aktifTab === 'ortak') { ortakYukle(); return; }
        if (aktifTab === 'atama') { atamaYukle(); return; }
        if (aktifTab === 'gelmeyen') { gelmeyenYukle(); return; }
        const arr = aktifListe();
        const body = document.getElementById('ggBody');
        if (!arr.length) { body.innerHTML = `<tr><td colspan="13" class="gg-empty">Kayıt yok.</td></tr>`; }
        else {
            body.innerHTML = arr.map(r => {
                const sec = secili[aktifTab].has(r.id);
                const bt = r.faturaMi ? 'ft' : 'yv';
                return `<tr data-id="${r.id}" class="${sec ? 'secili' : ''}">
                    <td><input type="checkbox" class="chk row-chk" data-id="${r.id}" ${sec ? 'checked' : ''}></td>
                    <td>${esc(r.tarih)}</td>
                    <td><span class="badge2 ${bt}">${esc(r.belgeTuru)}</span></td>
                    <td>${esc(r.belgeNo)}</td>
                    <td>${esc(r.cari)}${!r.faturaMi && r.fisCariSayisi > 0 ? ' <span class="badge2 ' + (r.fisCariTip === 'S' ? 'ft' : 'yv') + '" title="Fişteki cari satırından">' + (r.fisCariTip === 'S' ? 'tedarikçi' : r.fisCariTip === 'C' ? 'müşteri' : 'cari') + (r.fisCariSayisi > 1 ? ' · ' + r.fisCariSayisi + ' cari' : '') + '</span>' : ''}${r.faturaMi && r.cardCode ? `<button class="gg-sabitle" onclick="sabitOner('${esc(r.cardCode)}', '${esc(r.cari)}', '${r.tur === 'Gelir' ? 'GELIR' : 'GIDER'}', '${esc(r.id)}')" title="Bu cariyi sabitle: faturalarında bu kod otomatik yazılsın"><i class="fa-solid fa-thumbtack"></i></button>` : ''}${r.sabitMi ? ' <span class="badge2 sb" title="Sabit cari tanımından otomatik yazıldı">sabit</span>' : ''}</td>
                    <td class="hcode">${esc(r.hesapKodu)}</td>
                    <td>${esc(r.hesapAdi)}</td>
                    <td class="txt-r">${r.borc ? fmt(r.borc) : '—'}</td>
                    <td class="txt-r">${r.alacak ? fmt(r.alacak) : '—'}</td>
                    <td>${kodHucre(r)}</td>
                    <td style="font-size:.76rem;">${r.atanan ? esc(r.atanan) : '<span style="color:#cbd5e1">—</span>'}</td>
                    <td>${onayHucre(r)}</td>
                    <td class="txt-r" style="white-space:nowrap;"><button class="gg-detay" onclick="detay(${r.transId}, '${esc(r.id)}')">${r.faturaMi ? '<i class="fa-solid fa-file-invoice"></i> Fatura' : '<i class="fa-solid fa-list"></i> Fiş'}</button>${r.faturaMi ? `<button class="gg-goruntu" onclick="faturaGoruntu(${r.transId}, '${esc(r.belgeNo)}')" title="Faturanın QNB'deki gerçek görüntüsü (e-Fatura / e-Arşiv)"><i class="fa-solid fa-eye"></i> Görüntü</button>` : ''}</td>
                </tr>`;
            }).join('');
            body.querySelectorAll('.row-chk').forEach(c => c.addEventListener('change', function () { toggleSec(this.dataset.id, this.checked); }));
            body.querySelectorAll('.kod-btn').forEach(b => b.addEventListener('click', function () {
                const id = this.dataset.id, tip = this.dataset.tip, mevcut = this.dataset.kod;
                const rSatir = arr.find(x => x.id === id);
                GGSecici.ac({ kodlar: TUM_KODLAR, tip, secili: mevcut, baslik: 'Satır için kod seç', onerilen: rSatir ? rSatir.onerilenKodlar : null, onSec: kod => kodDegisti(id, kod) });
            }));
        }
        toplamGuncelle(arr);
        secGuncelle();
    }

    // İşaretli satır toplamı hapı (Gider/Gelir sekmeleri ve Koda Göre ortak)
    function seciliHap(n, b, a) {
        return `<span class="et"><i class="fa-solid fa-check-double"></i> Seçili <span class="n">${n}</span></span>`
            + `<span class="p"><small>Borç</small><b>${fmt(b)}</b></span><span class="p"><small>Alacak</small><b>${fmt(a)}</b></span><span class="p"><small>Net</small><b>${fmt(b - a)}</b></span>`;
    }

    function toplamGuncelle(arr) {
        const tB = arr.reduce((s, r) => s + (r.borc || 0), 0);
        const tA = arr.reduce((s, r) => s + (r.alacak || 0), 0);
        document.getElementById('ggSum').innerHTML = `${arr.length} satır · Borç <b>${fmt(tB)}</b> · Alacak <b>${fmt(tA)}</b>`;
    }

    function toggleSec(id, on) {
        if (on) secili[aktifTab].add(id); else secili[aktifTab].delete(id);
        const tr = document.querySelector(`#ggBody tr[data-id="${id}"]`);
        if (tr) tr.classList.toggle('secili', on);
        secGuncelle();
    }
    function secGuncelle() {
        const n = secili[aktifTab].size;
        document.getElementById('secSayi').textContent = n;
        // İşaretli satırların toplamı (borç, alacak, net) — liste toplamının yanında
        const secArr = (DATA[aktifTab] || []).filter(r => secili[aktifTab].has(r.id));
        const sB = secArr.reduce((s, r) => s + (r.borc || 0), 0), sA = secArr.reduce((s, r) => s + (r.alacak || 0), 0);
        const sec = document.getElementById('ggSecSum');
        if (sec) { sec.hidden = secArr.length === 0; sec.innerHTML = seciliHap(secArr.length, sB, sA); }
        kirliGuncelle();
        const arr = aktifListe();
        const all = document.getElementById('chkAll');
        all.checked = arr.length > 0 && arr.every(r => secili[aktifTab].has(r.id));
    }

    function detay(transId, satirId) {
        // satirId = "TransId-LineId": tıklanan satır detayda vurgulanır
        const secLine = satirId ? parseInt(String(satirId).split('-')[1], 10) : -1;
        document.getElementById('mTitle').textContent = 'Belge Detayı';
        document.getElementById('mBody').innerHTML = `<div style="text-align:center;padding:30px;color:#94a3b8;"><i class="fa-solid fa-spinner fa-spin"></i> Yükleniyor...</div>`;
        document.getElementById('detayModal').classList.add('on');
        fetch(`/Rapor163/BelgeDetay?transId=${transId}${qs}`).then(r => r.json()).then(res => {
            if (!res.success) { document.getElementById('mBody').innerHTML = `<div style="color:#b91c1c;padding:16px;">${esc(res.message)}</div>`; return; }
            document.getElementById('mTitle').textContent = (res.baslik || 'Belge') + ' — ' + (res.belgeNo || '');

            let kalem = '';
            if (res.kalemler && res.kalemler.length) {
                const kt = res.kalemler.reduce((s, k) => s + (Number(k.tutar) || 0), 0);
                kalem = `<div style="font-size:.78rem;font-weight:700;color:#475569;margin:10px 0 6px;">Fatura Kalemleri (${res.kalemler.length}) <span style="font-weight:500;color:#94a3b8;">— gider / gelir hesabına bağlı olmayanlar soluk</span></div>`
                    + `<table class="gg-kalem"><thead><tr><th>#</th><th>Kod</th><th>Kalem</th><th class="txt-r">Miktar</th><th class="txt-r">Birim Fiyat</th><th class="txt-r">Tutar</th><th>KDV</th><th>Depo</th><th>Bağlı Hesap</th><th>Gider / Gelir Kodu</th></tr></thead><tbody>`
                    + res.kalemler.map((k, i) => `<tr style="${k.secilebilir ? '' : 'opacity:.55;'}"><td style="color:#94a3b8;">${i + 1}</td><td>${esc(k.kod)}</td><td>${esc(k.ad)}</td><td class="txt-r">${fmt(k.miktar)}</td><td class="txt-r">${fmt(k.birimFiyat)}</td><td class="txt-r">${fmt(k.tutar)}</td><td>${esc(k.kdvKodu)} ${k.kdv != null ? '%' + Number(k.kdv) : ''}</td><td>${esc(k.depo)}</td><td>${k.hesapKodu ? '<span class="hcode">' + esc(k.hesapKodu) + '</span> ' + esc(k.hesapAdi) : '<span style="color:#94a3b8;">—</span>'}</td><td>${k.ggKod ? '<span class="hcode">' + esc(k.ggKod) + '</span> <span style="color:#64748b;font-size:.75rem;">' + esc(kodAdi(k.ggKod)) + '</span>' : (k.secilebilir ? '<span class="kod-uyari">kod yok</span>' : '<span style="color:#94a3b8;">gerekmez</span>')}</td></tr>`).join('')
                    + `<tr style="font-weight:700;background:#f8fafc;"><td colspan="5" class="txt-r">Toplam (KDV hariç)</td><td class="txt-r">${fmt(kt)}</td><td colspan="4"></td></tr></tbody></table>`;
            }
            let fis = '';
            if (res.fisSatirlari && res.fisSatirlari.length) {
                const tb = res.fisSatirlari.reduce((s, x) => s + (Number(x.borc) || 0), 0), ta = res.fisSatirlari.reduce((s, x) => s + (Number(x.alacak) || 0), 0);
                const dovizli = res.fisSatirlari.some(x => x.doviz && x.doviz !== 'TRY' && x.doviz !== 'TL' && (x.dovizBorc || x.dovizAlacak));
                const ekKolon = res.fisSatirlari.some(x => x.masrafMerkezi || x.proje);
                fis = `<div style="font-size:.78rem;font-weight:700;color:#475569;margin:14px 0 6px;">Yevmiye Fişi — Tüm Satırlar (${res.fisSatirlari.length}) <span style="font-weight:500;color:#94a3b8;">— gider / gelir hesapları koyu, seçilen satır vurgulu</span></div>`
                    + `<table class="gg-kalem"><thead><tr><th>#</th><th>Hesap / Cari</th><th>Ad</th><th class="txt-r">Borç</th><th class="txt-r">Alacak</th>${dovizli ? '<th class="txt-r">Döviz</th>' : ''}${ekKolon ? '<th>Masraf M. / Proje</th>' : ''}<th>Vade</th><th>Açıklama</th><th>Ref</th><th>Kod</th></tr></thead><tbody>`
                    + res.fisSatirlari.map(s => {
                        const hesapHucre = s.cariKodu
                            ? '<span class="hcode" style="color:#7c3aed;">' + esc(s.cariKodu) + '</span><br><span style="font-size:.7rem;color:#94a3b8;">' + esc(s.hesapKodu) + '</span>'
                            : '<span class="hcode"' + (s.secilebilir ? '' : ' style="color:#64748b;font-weight:600;"') + '>' + esc(s.hesapKodu) + '</span>';
                        return `<tr class="${s.lineId === secLine ? 'secili' : ''}" style="${s.secilebilir ? '' : 'color:#64748b;'}">
                        <td style="color:#94a3b8;">${s.lineId}</td>
                        <td>${hesapHucre}</td>
                        <td>${s.cariAdi ? esc(s.cariAdi) + (s.cariTip ? ' <span class="badge2 ' + (s.cariTip === 'Tedarikçi' ? 'ft' : s.cariTip === 'Müşteri' ? 'yv' : 'sb') + '">' + esc(s.cariTip) + '</span>' : '') : esc(s.hesapAdi)}</td>
                        <td class="txt-r">${s.borc ? fmt(s.borc) : '—'}</td><td class="txt-r">${s.alacak ? fmt(s.alacak) : '—'}</td>
                        ${dovizli ? '<td class="txt-r">' + ((s.dovizBorc || s.dovizAlacak) ? fmt(s.dovizBorc || s.dovizAlacak) + ' ' + esc(s.doviz) : '—') + '</td>' : ''}
                        ${ekKolon ? '<td style="font-size:.74rem;">' + esc(s.masrafMerkezi) + (s.proje ? ' / ' + esc(s.proje) : '') + '</td>' : ''}
                        <td style="font-size:.74rem;">${esc(s.vade)}</td><td>${esc(s.aciklama)}</td><td style="font-size:.72rem;color:#64748b;">${esc(s.ref1)}${s.ref2 ? ' / ' + esc(s.ref2) : ''}</td>
                        <td>${s.ggKod ? '<span class="hcode">' + esc(s.ggKod) + '</span>' : (s.secilebilir ? '<span class="kod-uyari">kod yok</span>' : '')}</td></tr>`; }).join('')
                    + `<tr style="font-weight:700;background:#f8fafc;"><td colspan="3" class="txt-r">Toplam</td><td class="txt-r">${fmt(tb)}</td><td class="txt-r">${fmt(ta)}</td><td colspan="${5 + (dovizli ? 1 : 0) + (ekKolon ? 1 : 0)}"></td></tr></tbody></table>`;
            } else {
                fis = `<div class="gg-note">Bu belgenin yevmiye satırı bulunamadı.</div>`;
            }
            document.getElementById('mBody').innerHTML = `
                ${res.faturaMi ? `<div style="margin-bottom:12px;"><button class="gg-goruntu" style="padding:8px 14px; font-size:.82rem; margin:0;" onclick="kapatModal(); faturaGoruntu(${transId}, '${esc(res.belgeNo)}')"><i class="fa-solid fa-eye"></i> Faturanın Gerçek Görüntüsü (QNB)</button></div>` : ''}
                ${belgeBaslik(res)}
                ${kisilerKutusu(res)}
                ${carilerKutusu(res)}
                ${kalem}
                ${fis}`;
        }).catch(e => { document.getElementById('mBody').innerHTML = `<div style="color:#b91c1c;padding:16px;">Hata: ${esc(e)}</div>`; });
    }
    // ---- Belge başlığı + kişiler (S03) ----
    function belgeBaslik(res) {
        const b = res.belge;
        const kv = (k, v) => v == null || v === '' ? '' : `<div><span class="k">${k}</span><span class="v">${v}</span></div>`;
        if (!b) return `<div class="bd-kv">${kv('Belge Türü', esc(res.baslik))}${kv('Belge No', esc(res.belgeNo))}${kv('Tarih', esc(res.tarih))}${kv('Cari', esc(res.cari))}</div>`;
        let h = `<div class="bd-kv">`
            + kv('Belge Türü', esc(res.baslik) + (b.kalemHizmet ? ' <span class="badge2 ft">' + esc(b.kalemHizmet) + '</span>' : '') + (b.iptal ? ' <span class="badge2" style="background:#fee2e2;color:#b91c1c;">İPTAL</span>' : ''))
            + kv('Belge No', b.docNum ? esc(b.docNum) : esc(res.belgeNo)) + kv('Fatura No (tedarikçi / e-fatura)', esc(b.faturaNo)) + kv('Yevmiye No', esc(b.yevmiyeNo))
            + kv('Belge Tarihi', esc(b.belgeTarihi)) + kv('Vade', esc(b.vade)) + kv('Vergi Tarihi', esc(b.vergiTarihi))
            + kv('Cari', b.cariKodu ? '<span class="hcode">' + esc(b.cariKodu) + '</span> ' + esc(b.cariAdi) : esc(b.cariAdi || res.cari))
            + (b.toplam ? kv('Toplam (KDV dahil)', fmt(b.toplam) + ' ' + esc(b.doviz)) + kv('KDV', fmt(b.kdv) + ' ' + esc(b.doviz)) + (b.doviz && b.doviz !== 'TRY' && b.doviz !== 'TL' && b.kur ? kv('Kur', fmt(b.kur)) : '') : '')
            + kv('Durum', esc(b.durum)) + kv('Satıcı', esc(b.satici)) + kv('İşlem Kodu', esc(b.islemKodu))
            + kv('Ref 1 / 2 / 3', [b.ref1, b.ref2, b.ref3].filter(x => x).map(esc).join(' / '))
            + kv('Açıklama', esc(b.aciklama)) + (b.yevmiyeAciklama && b.yevmiyeAciklama !== b.aciklama ? kv('Yevmiye Açıklaması', esc(b.yevmiyeAciklama)) : '')
            + (b.taslakEntry ? kv('Taslak No', esc(b.taslakEntry)) : '')
            + `</div>`;
        return h;
    }
    function carilerKutusu(res) {
        const c = res.cariler || []; if (!c.length) return '';
        const tipSinif = t => t === 'Tedarikçi' ? 'ft' : t === 'Müşteri' ? 'yv' : 'sb';
        return `<div style="font-size:.78rem;font-weight:700;color:#475569;margin:4px 0 6px;">Fişteki Cariler (${c.length})${c.length > 1 ? ' <span style="font-weight:500;color:#94a3b8;">— birden fazla cari var, satırlar aşağıda ayrı ayrı görünür</span>' : ''}</div>
            <table class="gg-kalem" style="margin-bottom:12px;"><thead><tr><th>Cari Kodu</th><th>Cari Adı</th><th>Tür</th><th>VKN</th><th class="txt-r">Satır</th><th class="txt-r">Borç</th><th class="txt-r">Alacak</th></tr></thead><tbody>`
            + c.map(x => `<tr><td class="hcode" style="color:#7c3aed;">${esc(x.kod)}</td><td>${esc(x.ad)}</td><td><span class="badge2 ${tipSinif(x.tip)}">${esc(x.tip || 'cari')}</span></td><td style="font-size:.76rem;color:#64748b;">${esc(x.vkn)}</td><td class="txt-r">${x.satirSayisi}</td><td class="txt-r">${x.borc ? fmt(x.borc) : '—'}</td><td class="txt-r">${x.alacak ? fmt(x.alacak) : '—'}</td></tr>`).join('')
            + `</tbody></table>`;
    }
    function kisilerKutusu(res) {
        const k = res.kisiler; if (!k) return '';
        const kutu = (rol, p, sinif) => p
            ? `<div class="bd-kisi ${sinif}"><div class="rol">${rol}</div><div class="kim">${p.ad ? esc(p.ad) : '<span class="bos">isim yok</span>'}</div><div class="kod">${esc(p.kod)}</div><div class="zaman">${esc(p.tarih)}</div>${p.not_ ? '<div class="zaman"><i>' + esc(p.not_) + '</i></div>' : ''}</div>`
            : '';
        let h = '<div class="bd-kisiler">';
        h += kutu(k.olusturan ? k.olusturan.kaynak : 'Oluşturan', k.olusturan, 'olusturan');
        if (k.onaylayan) h += kutu(k.onaylayan.kaynak, k.onaylayan, 'onaylayan');
        else if (res.faturaMi) h += `<div class="bd-kisi"><div class="rol">Onaylayan</div><div class="zaman">Bu belge taslak / onay akışından geçmemiş; doğrudan eklenmiş.</div></div>`;
        if (k.guncelleyen) h += kutu(k.guncelleyen.kaynak, k.guncelleyen, '');
        if (k.satinalmaci) h += `<div class="bd-kisi"><div class="rol">Satınalmacı (belge sahibi)</div><div class="kim">${esc(k.satinalmaci.ad)}</div><div class="kod">${esc(k.satinalmaci.kod)}</div></div>`;
        h += '</div>';
        return h;
    }
    // ---- Faturanın gerçek görüntüsü (QNB): OnayEkrani'ndaki önizleme mantığı ----
    let fAktifTrans = 0, fAktifBelgeNo = '';
    function faturaGoruntu(transId, belgeNo) {
        fAktifTrans = transId; fAktifBelgeNo = belgeNo || '';
        const htmlUrl = `/Rapor163/FaturaGoruntu?transId=${transId}${qs}`, pdfUrl = `/Rapor163/FaturaGoruntu?transId=${transId}&format=PDF${qs}`;
        const goster = (url, etiket, btn) => {
            document.getElementById('fBaslik').textContent = `Fatura ${fAktifBelgeNo} — ${etiket}`;
            document.getElementById('fYeniSekme').href = url;
            document.getElementById('fCerceve').removeAttribute('srcdoc');
            document.getElementById('fCerceve').src = url;
            document.querySelectorAll('.gg-fmodal-arac .gg-fbtn').forEach(b => b.classList.remove('on'));
            if (btn) document.getElementById(btn).classList.add('on');
        };
        document.getElementById('fHtmlBtn').onclick = () => goster(htmlUrl, 'QNB Gerçek Görüntü', 'fHtmlBtn');
        document.getElementById('fPdfBtn').onclick = () => goster(pdfUrl, 'QNB PDF', 'fPdfBtn');
        document.getElementById('fSatirBtn').onclick = () => { kapatFatura(); detay(transId, ''); };
        const uy = document.getElementById('fUyari'); uy.style.display = 'none'; uy.textContent = '';
        document.getElementById('fBilgi').textContent = '';
        document.getElementById('fBaslik').textContent = `Fatura ${fAktifBelgeNo} — QNB kontrol ediliyor...`;
        document.getElementById('fCerceve').src = 'about:blank';
        document.getElementById('faturaModal').classList.add('on');
        fetch(`/Rapor163/FaturaGoruntuDurum?transId=${transId}${qs}`).then(r => r.json()).then(d => {
            document.getElementById('fBilgi').innerHTML = d.yon ? `${d.yon === 'GELEN' ? 'Gelen (tedarikçi) e-Faturası' : 'Giden (müşteri) e-Faturası / e-Arşiv'}${d.faturaNo ? ' · No: <b>' + esc(d.faturaNo) + '</b>' : ''}` : '';
            if (d && d.bulundu) {
                goster(htmlUrl, 'QNB Gerçek Görüntü', 'fHtmlBtn');
                if (d.ipucu) { uy.innerHTML = '<i class="fa-solid fa-circle-info"></i> ' + esc(d.ipucu); uy.style.display = 'block'; }
                return;
            }
            document.getElementById('fBaslik').textContent = `Fatura ${fAktifBelgeNo} — görüntü bulunamadı`;
            uy.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> <b>QNB görüntüsü bulunamadı:</b> ' + esc((d && d.mesaj) || 'bilinmeyen neden') + (d && d.ipucu ? ' <span style="color:#64748b">— ' + esc(d.ipucu) + '</span>' : '');
            uy.style.display = 'block';
            document.getElementById('fCerceve').srcdoc = `<div style="font-family:Segoe UI,Arial;padding:40px;color:#64748b;text-align:center">Belge görüntüsü QNB'de bulunamadı. Üstteki uyarıya bakın; "Belge Satırları" ile fişi inceleyebilirsiniz.</div>`;
        }).catch(() => { uy.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> QNB kontrolü yapılamadı.'; uy.style.display = 'block'; });
    }
    function kapatFatura() { document.getElementById('faturaModal').classList.remove('on'); const c = document.getElementById('fCerceve'); c.removeAttribute('srcdoc'); c.src = 'about:blank'; }
    document.getElementById('faturaModal').addEventListener('click', e => { if (e.target.id === 'faturaModal') kapatFatura(); });

    // ---- Sabit cariler: cari → sabit gider/gelir kodu ----
    const ONAYLAYICI = @(onaylayici ? "true" : "false");
    let SABIT = [];
    function sabitYukle() {
        fetch(`/Rapor164/SabitCariler${qs1}`).then(r => r.json()).then(res => {
            if (!res.success) { toastr.error(res.message); return; }
            SABIT = res.data || [];
            const onayli = SABIT.filter(s => s.durum === 'ONAYLANDI' && s.aktif), bekleyen = SABIT.filter(s => s.durum === 'BEKLIYOR');
            document.getElementById('cntSabit').textContent = onayli.length + (bekleyen.length ? ' +' + bekleyen.length : '');
            document.getElementById('sbBekleyenAlan').hidden = !bekleyen.length;
            document.getElementById('sbBekleyen').innerHTML = bekleyen.map(s => `<tr><td><b>${esc(s.cardCode)}</b> ${esc(s.cardName)}</td><td><span class="badge2 ${s.tip === 'GELIR' ? 'yv' : 'ft'}">${s.tip === 'GELIR' ? 'Gelir' : 'Gider'}</span></td><td class="hcode">${esc(s.kokKod)}</td><td style="white-space:normal; font-size:.76rem;">${esc(s.kalemAdi)}</td><td>${esc(s.aciklama)}</td><td>${esc(s.talepEden)}</td><td>${esc(tarihStr(s.talepTarihi))}</td>
                <td style="white-space:nowrap;">${ONAYLAYICI ? `<button class="gg-detay" onclick="sabitOnayla(${s.id})"><i class="fa-solid fa-check"></i> Onayla</button> <button class="gg-sil" onclick="sabitReddet(${s.id})"><i class="fa-solid fa-xmark"></i> Reddet</button>` : '<span class="text-muted" style="font-size:.74rem;">onay bekliyor</span>'}</td></tr>`).join('');
            document.getElementById('sbListe').innerHTML = onayli.length ? onayli.map(s => `<tr><td class="hcode">${esc(s.cardCode)}</td><td>${esc(s.cardName)}</td><td><span class="badge2 ${s.tip === 'GELIR' ? 'yv' : 'ft'}">${s.tip === 'GELIR' ? 'Gelir' : 'Gider'}</span></td><td class="hcode">${esc(s.kokKod)}</td><td style="white-space:normal; font-size:.76rem;">${esc(s.kalemAdi)}</td><td>${esc(s.aciklama)}</td><td style="font-size:.76rem; color:#64748b;">${esc(s.onaylayan)} ${esc(tarihStr(s.onayTarihi))}</td>
                <td>${ONAYLAYICI ? `<button class="gg-sil" onclick="sabitSil(${s.id}, '${esc(s.cardCode)}')"><i class="fa-solid fa-trash"></i></button>` : ''}</td></tr>`).join('') : '<tr><td colspan="8" class="gg-empty">Henüz sabit cari yok.</td></tr>';
        }).catch(e => toastr.error('Sabit cariler yüklenemedi: ' + e));
    }
    function tarihStr(s) { if (!s) return ''; const d = new Date(s); return isNaN(d) ? '' : d.toLocaleDateString('tr-TR'); }

    // ---- Gelmeyenler: 620/621 + 761/771/781 hesaplarına giden, ana listeye hiç girmeyen satırlar ----
    let GELMEYEN = [];
    function gelmeyenYukle() {
        const yil = document.getElementById('selYil').value, ay = document.getElementById('selAy').value;
        document.getElementById('gelmeyenBody').innerHTML = '<tr><td colspan="8" class="gg-empty">Yükleniyor...</td></tr>';
        fetch(`/Rapor163/Gelmeyenler?yil=${yil}&ay=${ay}${qs}`).then(r => r.json()).then(res => {
            if (!res.success) { toastr.error(res.message || 'Gelmeyenler yüklenemedi'); return; }
            GELMEYEN = res.data || [];
            document.getElementById('cntGelmeyen').textContent = GELMEYEN.length;
            gelmeyenRender();
        }).catch(e => toastr.error('Gelmeyenler yüklenemedi: ' + e));
    }
    function gelmeyenRender() {
        const body = document.getElementById('gelmeyenBody');
        if (!GELMEYEN.length) { body.innerHTML = '<tr><td colspan="8" class="gg-empty">Bu dönemde hariç tutulan satır yok.</td></tr>'; document.getElementById('gelmeyenSum').textContent = '—'; return; }
        let borc = 0, alacak = 0;
        body.innerHTML = GELMEYEN.map(r => {
            borc += r.borc || 0; alacak += r.alacak || 0;
            return `<tr>
                <td>${esc(r.tarih)}</td>
                <td><span class="badge2 ${r.belgeTuru && r.belgeTuru.toLowerCase().includes('fatura') ? 'ft' : 'yv'}">${esc(r.belgeTuru)}</span></td>
                <td>${esc(r.belgeNo)}</td>
                <td>${esc(r.cari)}</td>
                <td class="hcode">${esc(r.hesapKodu)} <span style="color:#64748b;">${esc(r.hesapAdi)}</span></td>
                <td class="txt-r">${r.borc ? fmt(r.borc) : '—'}</td>
                <td class="txt-r">${r.alacak ? fmt(r.alacak) : '—'}</td>
                <td style="color:#92400e;">${esc(r.sebep)}</td>
            </tr>`;
        }).join('');
        document.getElementById('gelmeyenSum').innerHTML = `<b>${GELMEYEN.length}</b> satır · Borç <b>${fmt(borc)}</b> · Alacak <b>${fmt(alacak)}</b>`;
    }
    document.getElementById('btnGelmeyenYenile').addEventListener('click', gelmeyenYukle);
    function sabitTopluSenkron() {
        if (!confirm('Tüm şirketlerdeki onaylı sabit cari tanımları taranacak; her carinin geçmiş fatura/yevmiye satırları (elle farklı kodlanmış olsa bile) sabit tanımla eşleşecek şekilde güncellenecek. Şirket sayısına göre biraz sürebilir. Devam edilsin mi?')) return;
        const btn = document.getElementById('btnSabitSenkron'); btn.disabled = true; const eskiIcerik = btn.innerHTML; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Senkronize ediliyor...';
        fetch(`/Rapor164/SabitleriTopluSenkronizeEt${qs1}`, { method: 'POST' }).then(r => r.json()).then(res => {
            btn.disabled = false; btn.innerHTML = eskiIcerik;
            if (!res.success) { toastr.error(res.message || 'Senkronize edilemedi'); return; }
            toastr.success(`${res.toplamGuncellenen} satır güncellendi` + (res.hataSayisi ? `, ${res.hataSayisi} hata` : '') + '.', '', { timeOut: 12000 });
            console.log('Sabit cari toplu senkron sonucu:', res.sonuclar);
        }).catch(e => { btn.disabled = false; btn.innerHTML = eskiIcerik; toastr.error('Senkronize edilemedi: ' + e); });
    }

    // ---- Ortak cariler (S02): VKN ile şirketler arası eşleme + çoklu şirkete sabit kalem ----
    let ORTAK = [], ortakSecili = null, ortakYuklendi = false;
    function ortakYukle(zorla) {
        const q = document.getElementById('ortakAra').value.trim(), sabitsiz = document.getElementById('ortakSabitsiz').checked, enAz = document.getElementById('ortakEnAz').value;
        fetch(`/Rapor163/OrtakCariler?q=${encodeURIComponent(q)}&sadeceSabitsiz=${sabitsiz}&enAz=${enAz}${qs}`).then(r => r.json()).then(res => {
            if (!res.success) { toastr.error(res.message); return; }
            ORTAK = res.data || []; ortakYuklendi = true;
            document.getElementById('cntOrtak').textContent = res.toplam;
            document.getElementById('ortakOzet').innerHTML = res.taramaZamani ? `${res.toplam} ortak cari · son tarama ${esc(res.taramaZamani)}` : '<span style="color:#b91c1c;">Henüz tarama yapılmadı; "Şirketleri Tara" ile başlayın.</span>';
            ortakRender();
        }).catch(e => toastr.error('Ortak cariler yüklenemedi: ' + e));
    }
    function ortakRender() {
        const tb = document.getElementById('ortakListe');
        if (!ORTAK.length) { tb.innerHTML = '<tr><td colspan="6" class="gg-empty">Kayıt yok.</td></tr>'; return; }
        tb.innerHTML = ORTAK.map(o => {
            const sirketler = o.sirketler.map(s => `<span class="oc-sirket" title="${esc(s.dbName)}"><b>${esc(s.sirketKodu)}</b> ${esc(s.sirketAd)} <span class="cc">${esc(s.cardCode)}</span></span>`).join('');
            const sabit = o.sirketler.map(s => s.sabit.length
                ? s.sabit.map(x => `<span class="oc-sabit ${x.durum === 'ONAYLANDI' ? 'on' : 'bk'}" title="${esc(x.kalemAdi)}${x.durum === 'BEKLIYOR' ? ' (onay bekliyor)' : ''}"><b>${esc(s.sirketKodu)}</b> ${esc(x.kokKod)}${x.durum === 'BEKLIYOR' ? ' ⏳' : ''}</span>`).join('')
                : `<span class="oc-sabit yok"><b>${esc(s.sirketKodu)}</b> yok</span>`).join('');
            const tip = (o.tipler || '').includes('S') && (o.tipler || '').includes('C') ? 'Tedarikçi + Müşteri' : (o.tipler || '').includes('S') ? 'Tedarikçi' : 'Müşteri';
            return `<tr>
                <td class="hcode">${esc(o.vkn)}</td>
                <td style="white-space:normal; max-width:260px;"><b>${esc(o.ad)}</b><br><span style="font-size:.72rem; color:#64748b;">${o.sirketSayisi} şirkette · ${o.sabitli} sabitli</span></td>
                <td><span class="badge2 ${tip.startsWith('Ted') ? 'ft' : 'yv'}">${tip}</span></td>
                <td style="white-space:normal; max-width:360px;">${sirketler}</td>
                <td style="white-space:normal; max-width:320px;">${sabit}</td>
                <td style="white-space:nowrap;"><button class="gg-detay" onclick="ortakSabitleAc('${esc(o.vkn)}')" title="Seçilen şirketlerde bu cariye sabit kalem tanımla"><i class="fa-solid fa-thumbtack"></i> Kalem Sabitle</button></td>
            </tr>`;
        }).join('');
    }
    function ortakTara() {
        const b = document.getElementById('btnOrtakTara'); b.disabled = true; b.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Taranıyor...';
        fetch(`/Rapor163/OrtakCariTara${qs1}`, { method: 'POST' }).then(r => r.json()).then(res => {
            b.disabled = false; b.innerHTML = '<i class="fa-solid fa-rotate"></i> Şirketleri Tara';
            if (!res.success) { toastr.error(res.message, '', { timeOut: 10000 }); return; }
            const hatali = (res.sirketler || []).filter(s => s.hata);
            toastr.success(res.message, '', { timeOut: 8000 });
            if (hatali.length) toastr.warning('Taranamayan: ' + hatali.map(s => s.dbName + ' (' + s.hata + ')').join(' | '), '', { timeOut: 12000 });
            ortakYukle();
        }).catch(e => { b.disabled = false; b.innerHTML = '<i class="fa-solid fa-rotate"></i> Şirketleri Tara'; toastr.error('Tarama hatası: ' + e); });
    }
    function ortakSabitleAc(vkn) {
        const o = ORTAK.find(x => x.vkn === vkn); if (!o) return; ortakSecili = o;
        document.getElementById('omVkn').textContent = o.vkn; document.getElementById('omAd').textContent = o.ad;
        const tipSel = document.getElementById('omTip'); tipSel.value = (o.tipler || '').includes('S') ? 'GIDER' : 'GELIR';
        const kb = document.getElementById('omKodBtn'); kb.dataset.kod = ''; kb.className = 'kod-btn bos'; kb.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i><span class="a">Kalem seç...</span><i class="fa-solid fa-chevron-down"></i>';
        document.getElementById('omAciklama').value = '';
        omSirketleriCiz();
        document.getElementById('ortakModal').classList.add('on');
    }
    function omSirketleriCiz() {
        const tip = document.getElementById('omTip').value;
        document.getElementById('omSirketler').innerHTML = ortakSecili.sirketler.map((s, i) => {
            const mevcut = s.sabit.find(x => x.tip === tip);
            return `<label class="oc-hedef ${mevcut ? 'var' : ''}"><input type="checkbox" class="omHedef" data-i="${i}" checked> <b>${esc(s.sirketKodu)}</b> ${esc(s.sirketAd)} <span class="hcode" style="font-size:.74rem;">${esc(s.cardCode)}</span>${mevcut ? `<span class="oc-sabit ${mevcut.durum === 'ONAYLANDI' ? 'on' : 'bk'}" title="${esc(mevcut.kalemAdi)}">mevcut: ${esc(mevcut.kokKod)}</span>` : ''}</label>`;
        }).join('');
    }
    document.getElementById('omTip').addEventListener('change', () => { if (ortakSecili) { omSirketleriCiz(); const kb = document.getElementById('omKodBtn'); kb.dataset.kod = ''; kb.className = 'kod-btn bos'; kb.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i><span class="a">Kalem seç...</span><i class="fa-solid fa-chevron-down"></i>'; } });
    document.getElementById('omKodBtn').addEventListener('click', function () {
        const b = this;
        GGSecici.ac({ kodlar: TUM_KODLAR, tip: document.getElementById('omTip').value, secili: b.dataset.kod, baslik: 'Ortak cari için sabit kalem', onSec: (kod) => {
            b.dataset.kod = kod || ''; b.className = 'kod-btn' + (kod ? '' : ' bos');
            b.innerHTML = kod ? `<span class="k">${esc(kod)}</span><span class="a">${esc(kodAdi(kod))}</span><i class="fa-solid fa-chevron-down"></i>` : '<i class="fa-solid fa-triangle-exclamation"></i><span class="a">Kalem seç...</span><i class="fa-solid fa-chevron-down"></i>';
        } });
    });
    document.getElementById('btnOmKaydet').addEventListener('click', function () {
        if (!ortakSecili) return;
        const kod = document.getElementById('omKodBtn').dataset.kod; if (!kod) { toastr.warning('Önce kalem seçin.'); return; }
        const hedefler = Array.from(document.querySelectorAll('.omHedef:checked')).map(c => ortakSecili.sirketler[parseInt(c.dataset.i)]).map(s => ({ sirketKodu: s.sirketKodu, dbName: s.dbName, cardCode: s.cardCode, cardName: s.cardName }));
        if (!hedefler.length) { toastr.warning('En az bir şirket işaretleyin.'); return; }
        const b = this; b.disabled = true;
        fetch(`/Rapor163/OrtakSabitle${qs1}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ vkn: ortakSecili.vkn, tip: document.getElementById('omTip').value, kod, aciklama: document.getElementById('omAciklama').value.trim(), hedefler }) })
            .then(r => r.json()).then(res => {
                b.disabled = false;
                if (res.success) { toastr.success(res.message, '', { timeOut: 9000 }); document.getElementById('ortakModal').classList.remove('on'); ortakYukle(); }
                else toastr.error(res.message, '', { timeOut: 10000 });
            }).catch(e => { b.disabled = false; toastr.error('Hata: ' + e); });
    });
    document.getElementById('btnOrtakTara').addEventListener('click', ortakTara);
    let ortakAraZ; document.getElementById('ortakAra').addEventListener('input', () => { clearTimeout(ortakAraZ); ortakAraZ = setTimeout(ortakYukle, 250); });
    document.getElementById('ortakSabitsiz').addEventListener('change', ortakYukle);
    document.getElementById('ortakEnAz').addEventListener('change', ortakYukle);
    document.getElementById('ortakModal').addEventListener('click', e => { if (e.target.id === 'ortakModal') e.currentTarget.classList.remove('on'); });
    let sbAra;
    document.getElementById('sbCari').addEventListener('input', function () {
        clearTimeout(sbAra); const q = this.value.trim(); if (q.length < 2) return;
        sbAra = setTimeout(() => fetch(`/Rapor163/Cariler?q=${encodeURIComponent(q)}${qs}`).then(r => r.json()).then(res => {
            if (res.success) document.getElementById('sbCariList').innerHTML = res.data.map(c => `<option value="${esc(c.kod)}">${esc(c.ad)}</option>`).join('');
        }), 250);
    });
    document.getElementById('sbKodBtn').addEventListener('click', function () {
        const b = this;
        GGSecici.ac({ kodlar: TUM_KODLAR, tip: document.getElementById('sbTip').value, secili: b.dataset.kod, baslik: 'Sabit kod seç', onSec: (kod) => {
            b.dataset.kod = kod || '';
            b.className = 'kod-btn' + (kod ? '' : ' bos');
            b.innerHTML = kod ? `<span class="k">${esc(kod)}</span><span class="a">${esc(kodAdi(kod))}</span><i class="fa-solid fa-chevron-down"></i>` : `<i class="fa-solid fa-triangle-exclamation"></i><span class="a">Kod seç...</span><i class="fa-solid fa-chevron-down"></i>`;
        } });
    });
    document.getElementById('sbTip').addEventListener('change', () => { const b = document.getElementById('sbKodBtn'); b.dataset.kod = ''; b.className = 'kod-btn bos'; b.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i><span class="a">Kod seç...</span><i class="fa-solid fa-chevron-down"></i>'; });
    function sabitKaydet(cardCode, cardName, tip, kod, aciklama, sonra) {
        fetch(`/Rapor164/SabitCariKaydet${qs1}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ cardCode, cardName, tip, kod, aciklama }) })
            .then(r => r.json()).then(res => { if (res.success) { toastr.success(res.message, '', { timeOut: 8000 }); if (sonra) sonra(); } else toastr.error(res.message, '', { timeOut: 9000 }); })
            .catch(e => toastr.error('Hata: ' + e));
    }
    document.getElementById('btnSbEkle').addEventListener('click', function () {
        const cari = document.getElementById('sbCari').value.trim(); const kod = document.getElementById('sbKodBtn').dataset.kod;
        if (!cari) { toastr.warning('Cari seçin.'); return; }
        if (!kod) { toastr.warning('Sabit kodu seçin.'); return; }
        const opt = Array.from(document.getElementById('sbCariList').options).find(o => o.value === cari);
        sabitKaydet(cari, opt ? opt.textContent : '', document.getElementById('sbTip').value, kod, document.getElementById('sbAciklama').value.trim(), () => { document.getElementById('sbCari').value = ''; document.getElementById('sbAciklama').value = ''; sabitYukle(); });
    });
    // Ana listeden: satırdaki kodla cariyi sabitle / öner
    function sabitOner(cardCode, cardName, tip, satirId) {
        const r = DATA[aktifTab].find(x => x.id === satirId);
        const kod = r ? (KIRLI[r.id] !== undefined ? KIRLI[r.id] : (r.kod || '')) : '';
        GGSecici.ac({ kodlar: TUM_KODLAR, tip, secili: kod, baslik: `${cardName || cardCode} için sabit ${tip === 'GELIR' ? 'gelir' : 'gider'} kodu`, onSec: (secilen) => {
            if (!secilen) return;
            if (!confirm(`${cardCode} ${cardName}\n→ ${secilen}\n\n${ONAYLAYICI ? 'Sabit olarak tanımlansın mı? Bu carinin faturalarında kod otomatik yazılacak.' : 'Öneri olarak YKB onayına gönderilsin mi?'}`)) return;
            sabitKaydet(cardCode, cardName, tip, secilen, '', () => { if (ONAYLAYICI) yukle(); });
        } });
    }
    function sabitOnayla(id) { fetch(`/Rapor164/SabitCariOnayla${qs1}`, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'id=' + id }).then(r => r.json()).then(res => { if (res.success) { toastr.success(res.message); sabitYukle(); } else toastr.error(res.message); }); }
    function sabitReddet(id) { const not = prompt('Red notu (isteğe bağlı):', '') ; if (not === null) return; fetch(`/Rapor164/SabitCariReddet${qs1}`, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'id=' + id + '&not=' + encodeURIComponent(not) }).then(r => r.json()).then(res => { if (res.success) { toastr.success(res.message); sabitYukle(); } else toastr.error(res.message); }); }
    function sabitSil(id, kod) { if (!confirm(kod + ' sabit tanımı kaldırılsın mı?')) return; fetch(`/Rapor164/SabitCariSil${qs1}`, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'id=' + id }).then(r => r.json()).then(res => { if (res.success) { toastr.success(res.message); sabitYukle(); } else toastr.error(res.message); }); }

    // ---- Satır atama (kullanıcıya) ve onay kolonu ----
    function onayHucre(r) {
        if (!r.atanan) return '<span style="color:#cbd5e1">—</span>';
        const d = r.onayDurum || 'BEKLIYOR';
        const rozet = d === 'ONAYLANDI' ? '<span class="badge2 on">ONAYLANDI</span>' : d === 'RED' ? '<span class="badge2 rd">RED</span>' : '<span class="badge2 bk">BEKLİYOR</span>';
        return rozet + (r.onayKod ? ' <span class="hcode" style="font-size:.7rem">' + esc(r.onayKod) + '</span>' : '') + (r.onayAciklama ? '<span class="at-aciklama">' + esc(r.onayAciklama) + (r.onayTarihi ? ' <i style="color:#94a3b8">(' + esc(r.onayTarihi) + ')</i>' : '') + '</span>' : '');
    }
    let KULLANICILAR = null;
    function atamaAc() {
        const idler = Array.from(secili[aktifTab]);
        if (!idler.length) { toastr.warning('Önce satırları işaretleyin (soldaki kutucuklar).'); return; }
        document.getElementById('atamaSayi').textContent = idler.length;
        document.getElementById('atamaModal').classList.add('on');
        atamaKullaniciSec(null);
        setTimeout(() => document.getElementById('atamaKullaniciAra').focus(), 50);
        // Liste her açılışta yenilenir: pasife çekilen (kilitli) kullanıcılar hemen düşsün.
        fetch(`/Rapor163/Kullanicilar${qs1}`).then(r => r.json()).then(res => {
            if (!res.success) { toastr.error(res.message); return; }
            KULLANICILAR = res.data || [];
            atamaKullaniciListeCiz();
        });
    }
    // Aramalı kullanıcı seçimi: kod / ad / e-posta yazıldıkça süzülür, tıklayınca seçilir.
    function atamaKullaniciListeCiz() {
        const kutu = document.getElementById('atamaKullaniciListe');
        const q = (document.getElementById('atamaKullaniciAra').value || '').trim().toLocaleLowerCase('tr-TR');
        if (!KULLANICILAR) { kutu.hidden = true; return; }
        const arr = KULLANICILAR.filter(k => !q || (k.kod + ' ' + k.ad + ' ' + (k.mail || '')).toLocaleLowerCase('tr-TR').includes(q)).slice(0, 60);
        kutu.innerHTML = arr.length ? arr.map(k => `<div class="at-sec-satir" onclick="atamaKullaniciSec('${esc(k.kod)}')"><span class="kod">${esc(k.kod)}</span><span class="ad">${esc(k.ad)}</span><span class="mail ${k.mail ? '' : 'yok'}">${k.mail ? esc(k.mail) : 'E-POSTA YOK'}</span></div>`).join('')
                                    : '<div class="at-sec-satir" style="color:#94a3b8; cursor:default;">Eşleşen aktif kullanıcı yok</div>';
        kutu.hidden = document.activeElement !== document.getElementById('atamaKullaniciAra') && !q;
    }
    function atamaKullaniciSec(kod) {
        const gizli = document.getElementById('atamaKullanici'), ara = document.getElementById('atamaKullaniciAra'), etiket = document.getElementById('atamaKullaniciSecili');
        gizli.value = kod || '';
        if (!kod) { ara.value = ''; etiket.textContent = ''; document.getElementById('atamaKullaniciListe').hidden = true; return; }
        const k = (KULLANICILAR || []).find(x => x.kod === kod);
        ara.value = k ? `${k.kod} — ${k.ad}` : kod;
        etiket.innerHTML = k ? `<i class="fa-solid fa-circle-check"></i> Seçildi: <b>${esc(k.kod)}</b> ${esc(k.ad)}${k.mail ? ' · ' + esc(k.mail) : ' · <span style="color:#b91c1c">e-postası yok, bildirim gidemez</span>'}` : '';
        document.getElementById('atamaKullaniciListe').hidden = true;
    }
    document.getElementById('atamaKullaniciAra').addEventListener('input', function () { document.getElementById('atamaKullanici').value = ''; document.getElementById('atamaKullaniciSecili').textContent = ''; document.getElementById('atamaKullaniciListe').hidden = false; atamaKullaniciListeCiz(); });
    document.getElementById('atamaKullaniciAra').addEventListener('focus', function () { document.getElementById('atamaKullaniciListe').hidden = false; atamaKullaniciListeCiz(); });
    document.getElementById('atamaKullaniciAra').addEventListener('keydown', function (e) {
        const kutu = document.getElementById('atamaKullaniciListe'); const satirlar = Array.from(kutu.querySelectorAll('.at-sec-satir[onclick]'));
        if (!satirlar.length) return;
        let i = satirlar.findIndex(s => s.classList.contains('on'));
        if (e.key === 'ArrowDown') { e.preventDefault(); i = Math.min(satirlar.length - 1, i + 1); satirlar.forEach(s => s.classList.remove('on')); satirlar[i].classList.add('on'); satirlar[i].scrollIntoView({ block: 'nearest' }); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); i = Math.max(0, i - 1); satirlar.forEach(s => s.classList.remove('on')); satirlar[i].classList.add('on'); satirlar[i].scrollIntoView({ block: 'nearest' }); }
        else if (e.key === 'Enter') { e.preventDefault(); (satirlar[i >= 0 ? i : 0]).click(); }
        else if (e.key === 'Escape') { kutu.hidden = true; }
    });
    document.addEventListener('click', function (e) { if (!e.target.closest('.at-sec')) document.getElementById('atamaKullaniciListe').hidden = true; });
    function kapatAtama() { document.getElementById('atamaModal').classList.remove('on'); }

    // ---- "Atananlar" sekmesi: atanmış satırlar, atama silme (atanan kişiye e-posta) ----
    let ATAMALAR = [], ATAMA_BEN = '';
    function atamaYukle(sessiz) {
        fetch('/Rapor163/Atamalar').then(r => r.json()).then(res => {
            if (!res.success) { if (!sessiz) toastr.error(res.message); return; }
            ATAMALAR = res.data || []; ATAMA_BEN = res.kullanici || '';
            document.getElementById('cntAtama').textContent = ATAMALAR.filter(a => a.durum === 'BEKLIYOR').length;
            if (!sessiz) atamaCiz();
        }).catch(e => { if (!sessiz) toastr.error('Atamalar yüklenemedi: ' + e); });
    }
    let atamaAlt = 'BEKLIYOR', atamaKisi = null;   // alt sekme: BEKLIYOR | CEVAP ; kişi çipi süzgeci
    function atamaCiz() {
        const q = (document.getElementById('atamaAra').value || '').trim().toLocaleLowerCase('tr-TR');
        const bekleyen = ATAMALAR.filter(a => a.durum === 'BEKLIYOR'), cevap = ATAMALAR.filter(a => a.durum !== 'BEKLIYOR');
        document.getElementById('cntAtBekliyor').textContent = bekleyen.length;
        document.getElementById('cntAtCevap').textContent = cevap.length;
        document.querySelectorAll('.at-alt-sekme').forEach(b => b.classList.toggle('active', b.dataset.alt === atamaAlt));

        // Kullanıcı bazlı genel durum: her atanan için bekliyor / onaylandı / red sayıları (çipe tıklayınca süzer)
        const kisiler = {};
        ATAMALAR.forEach(a => { const k = kisiler[a.atananKullanici] || (kisiler[a.atananKullanici] = { kod: a.atananKullanici, ad: a.atananAd || '', b: 0, o: 0, r: 0 }); if (a.durum === 'BEKLIYOR') k.b++; else if (a.durum === 'ONAYLANDI') k.o++; else k.r++; });
        const kisiArr = Object.values(kisiler).sort((x, y) => (y.b - x.b) || x.kod.localeCompare(y.kod, 'tr'));
        if (atamaKisi && !kisiler[atamaKisi]) atamaKisi = null;
        document.getElementById('atamaKisiOzet').innerHTML = kisiArr.map(k => `<span class="at-kisi ${atamaKisi === k.kod ? 'on' : ''}" onclick="atamaKisiSec('${esc(k.kod)}')" title="${esc(k.ad)} — bekliyor ${k.b}, onaylandı ${k.o}, red ${k.r}">${esc(k.kod)} <span class="n b" title="bekliyor">${k.b}</span><span class="n o" title="onaylandı">${k.o}</span><span class="n r" title="red">${k.r}</span></span>`).join('');

        let arr = atamaAlt === 'BEKLIYOR' ? bekleyen : cevap;
        if (atamaKisi) arr = arr.filter(a => a.atananKullanici === atamaKisi);
        if (q) arr = arr.filter(a => [a.sirketDb, a.belgeTuru, a.belgeNo, a.cari, a.hesapKodu, a.hesapAdi, a.kod, a.atananKullanici, a.atananAd, a.atayan, a.atayanAd, a.atamaNotu, a.onayAciklama].join(' ').toLocaleLowerCase('tr-TR').includes(q));
        document.getElementById('atamaOzet').textContent = arr.length + ' atama' + (atamaKisi ? ' · ' + atamaKisi : '') + ' (toplam ' + ATAMALAR.length + ': ' + bekleyen.length + ' bekliyor, ' + cevap.length + ' cevaplı)';
        const tb = document.getElementById('atamaListe');
        if (!arr.length) { tb.innerHTML = '<tr><td colspan="12" class="gg-empty">' + (atamaAlt === 'BEKLIYOR' ? 'Bekleyen atama yok.' : 'Cevap verilmiş atama yok.') + '</td></tr>'; return; }
        tb.innerHTML = arr.map(a => {
            const silebilir = ONAYLAYICI || (a.atayan || '').toLocaleLowerCase('tr-TR') === ATAMA_BEN.toLocaleLowerCase('tr-TR');
            const tarihSaat = a.atamaTarihi ? new Date(a.atamaTarihi).toLocaleString('tr-TR', { dateStyle: 'short', timeStyle: 'short' }) : '';
            return `<tr>
                <td class="hcode">${esc(a.sirketDb)}</td>
                <td><span class="badge2 ft">${esc(a.belgeTuru)}</span> <b>${esc(a.belgeNo)}</b></td>
                <td>${esc(a.tarih)}</td>
                <td style="white-space:normal; max-width:220px;">${esc(a.cari)}</td>
                <td style="white-space:normal; font-size:.76rem;"><span class="hcode">${esc(a.hesapKodu)}</span> ${esc(a.hesapAdi)}</td>
                <td style="text-align:right;">${Number(a.tutar || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                <td class="hcode">${atamaKodHucre(a)}</td>
                <td><b>${esc(a.atananKullanici)}</b>${a.atananAd ? '<br><span style="font-size:.74rem; color:#64748b;">' + esc(a.atananAd) + '</span>' : ''}</td>
                <td>${esc(a.atayan)}${a.atayanAd ? '<br><span style="font-size:.74rem; color:#64748b;">' + esc(a.atayanAd) + '</span>' : ''}</td>
                <td style="font-size:.76rem;">${esc(tarihSaat)}${a.atamaNotu ? '<br><span style="color:#64748b;" title="Atama notu">' + esc(a.atamaNotu) + '</span>' : ''}</td>
                <td style="white-space:normal; max-width:260px;"><span class="at-durum ${esc(a.durum)}">${esc(a.durum)}</span>${a.onayAciklama ? '<br><span style="font-size:.76rem;">' + esc(a.onayAciklama) + '</span>' : ''}</td>
                <td>${silebilir ? `<button class="gg-sil" title="Atamayı sil; atanan kişiye e-posta gider" onclick="atamaSil(${a.id})"><i class="fa-solid fa-trash"></i></button>` : ''}</td>
            </tr>`;
        }).join('');
    }
    function atamaKodHucre(a) {
        const kod = a.kod || a.onayKod || '';
        const tip = (window.GGSecici ? GGSecici.hesapTipi(a.hesapKodu) : null) || 'GIDER';
        return `<button type="button" class="kod-btn ${kod ? '' : 'bos'}" data-atama-id="${a.id}" data-tip="${esc(tip)}" data-kod="${esc(kod)}" style="font-size:.76rem; padding:4px 8px; min-width:0;" title="Kod seçmek için tıklayın">`
            + (kod ? `<span class="k">${esc(kod)}</span>` : `<i class="fa-solid fa-triangle-exclamation"></i><span class="a">Kod seç...</span>`)
            + `<i class="fa-solid fa-chevron-down"></i></button>`;
    }
    function atamaKodKaydet(id, kod) {
        fetch('/Rapor163/AtamaKodKaydet', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, kod }) })
            .then(r => r.json()).then(res => {
                if (!res.success) { toastr.error(res.message); return; }
                toastr.success(res.message);
                const a = ATAMALAR.find(x => x.id === id); if (a) a.kod = kod;
                atamaCiz();
                if (typeof yukle === 'function') yukle();
            }).catch(e => toastr.error('Kaydedilemedi: ' + e));
    }
    document.getElementById('atamaListe').addEventListener('click', function (e) {
        const btn = e.target.closest('.kod-btn[data-atama-id]'); if (!btn) return;
        const id = Number(btn.dataset.atamaId), tip = btn.dataset.tip, mevcut = btn.dataset.kod;
        GGSecici.ac({ kodlar: TUM_KODLAR, tip, secili: mevcut, baslik: 'Atanan satır için kod seç', onSec: kod => atamaKodKaydet(id, kod) });
    });
    function atamaSil(id) {
        const a = ATAMALAR.find(x => x.id === id); if (!a) return;
        const not = prompt(`${a.belgeTuru} ${a.belgeNo} (${a.sirketDb}) → ${a.atananKullanici} ataması silinecek.\n${a.atananKullanici} kullanıcısına otomatik e-posta gider.\n\nE-postaya eklenecek not (isteğe bağlı):`, '');
        if (not === null) return;
        fetch('/Rapor163/AtamaSil', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, not: not.trim() }) })
            .then(r => r.json()).then(res => {
                if (res.success) { (res.mailUyari ? toastr.warning : toastr.success)(res.message, '', { timeOut: 10000 }); atamaYukle(); if (typeof yukle === 'function') yukle(); }
                else toastr.error(res.message);
            }).catch(e => toastr.error('Hata: ' + e));
    }
    function atamaKisiSec(kod) { atamaKisi = atamaKisi === kod ? null : kod; atamaCiz(); }
    document.querySelectorAll('.at-alt-sekme').forEach(b => b.addEventListener('click', function () { atamaAlt = this.dataset.alt; atamaCiz(); }));
    document.getElementById('atamaAra').addEventListener('input', atamaCiz);
    document.getElementById('btnAtamaYenile').addEventListener('click', () => atamaYukle());
    atamaYukle(true);
    document.getElementById('atamaModal').addEventListener('click', e => { if (e.target.id === 'atamaModal') kapatAtama(); });
    document.getElementById('btnAtama').addEventListener('click', atamaAc);
    document.getElementById('btnAtamaKaydet').addEventListener('click', function () {
        const kullanici = document.getElementById('atamaKullanici').value; if (!kullanici) { toastr.warning('Kullanıcı seçin.'); return; }
        const idler = Array.from(secili[aktifTab]); const b = this; b.disabled = true;
        fetch(`/Rapor163/AtamaYap${qs1}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ idler, kullanici, not: document.getElementById('atamaNot').value.trim() }) })
            .then(r => r.json()).then(res => { b.disabled = false; if (res.success) { (res.mailUyari ? toastr.warning : toastr.success)(res.message, '', { timeOut: 12000 }); kapatAtama(); yukle(); } else toastr.error(res.message); })
            .catch(e => { b.disabled = false; toastr.error('Hata: ' + e); });
    });

    function kapatModal() { document.getElementById('detayModal').classList.remove('on'); }
    document.getElementById('detayModal').addEventListener('click', e => { if (e.target.id === 'detayModal') kapatModal(); });

    // ---- Gider / gelir kodu: katalog (Rapor164), satir kutusu, toplu atama, kaydet ----
    let GG = { gider: [], gelir: [], tis: [] }, GG_AD = {}, KIRLI = {}, sadeceKodsuz = false, TUM_KODLAR = [];
    function kodlariYukle() {
        fetch(`/Rapor164/Kodlar${qs1}`).then(r => r.json()).then(res => {
            if (!res.success) { toastr.warning(res.message || 'Gider/gelir kodları alınamadı.'); return; }
            GG = { gider: [], gelir: [], tis: [] }; GG_AD = {}; TUM_KODLAR = res.data || [];
            (res.data || []).forEach(k => { GG_AD[k.kod] = k.ad; GG_AD[k.kokKod] = k.ad; (k.tip === 'GIDER' ? GG.gider : k.tip === 'GELIR' ? GG.gelir : GG.tis).push(k); });
            const opt = arr => arr.map(k => `<option value="${esc(k.kod)}">${esc(k.ad)}</option>`).join('');
            document.getElementById('ggListGider').innerHTML = opt(GG.gider) + opt(GG.tis);
            document.getElementById('ggListGelir').innerHTML = opt(GG.gelir) + opt(GG.tis);
            if (res.uyari) toastr.warning(res.uyari, '', { timeOut: 12000 });
            render();
        }).catch(() => toastr.warning('Gider/gelir kod kataloğuna ulaşılamadı.'));
    }
    function kodAdi(kod) { kod = (kod || '').trim(); if (!kod) return ''; return GG_AD[kod] || GG_AD[kod.split('.').slice(0, 4).join('.')] || ''; }
    function kodHucre(r) {
        const kod = KIRLI[r.id] !== undefined ? KIRLI[r.id] : (r.kod || '');
        const kirli = KIRLI[r.id] !== undefined && KIRLI[r.id] !== (r.kod || '');
        const bos = !kod;
        const uy = r.kodKarisik && bos ? `<span class="kod-uyari">kalemler farklı kodlanmış</span>` : (bos ? `<span class="kod-uyari"><i class="fa-solid fa-triangle-exclamation"></i> kod yok</span>` : '');
        return `<button type="button" class="kod-btn ${bos ? 'bos' : ''} ${kirli ? 'kirli' : ''}" data-id="${r.id}" data-tip="${r.tur === 'Gelir' ? 'GELIR' : 'GIDER'}" data-kod="${esc(kod)}" title="Kod seçmek için tıklayın">`
            + (bos ? `<i class="fa-solid fa-triangle-exclamation"></i><span class="a">${uy || 'Kod seç...'}</span>` : `<span class="k">${esc(kod)}</span><span class="a">${esc(kodAdi(kod))}</span>`)
            + `<i class="fa-solid fa-chevron-down"></i></button>`;
    }
    function kodDegisti(id, val) {
        val = (val || '').trim();
        const r = DATA[aktifTab].find(x => x.id === id); if (!r) return;
        if (val && !GG_AD[val]) { toastr.warning(`"${val}" katalogda yok; listeden seçin.`); }
        if (val === (r.kod || '')) delete KIRLI[id]; else KIRLI[id] = val;
        render();
    }
    function kirliGuncelle() {
        const n = Object.keys(KIRLI).length;
        document.getElementById('kirliSayi').textContent = n;
        document.getElementById('btnOnayla').disabled = n === 0;
    }
    function topluAta() {
        const idler = Array.from(secili[aktifTab]);
        if (!idler.length) { toastr.warning('Önce satırları işaretleyin (soldaki kutucuklar).'); return; }
        GGSecici.ac({
            kodlar: TUM_KODLAR, tip: aktifTab === 'gelir' ? 'GELIR' : 'GIDER', baslik: idler.length + ' işaretli satıra kod ata',
            onSec: kod => {
                if (!kod) return;
                idler.forEach(id => { const r = DATA[aktifTab].find(x => x.id === id); if (!r) return; if (kod === (r.kod || '')) delete KIRLI[id]; else KIRLI[id] = kod; });
                render();
                toastr.info(`${idler.length} satıra ${kod} atandı; "Kodları Kaydet" ile SAP'ye yazın.`);
            }
        });
    }
    function onayla() {
        const satirlar = Object.keys(KIRLI).map(id => { const p = id.split('-'); return { transId: parseInt(p[0], 10), lineId: parseInt(p[1], 10), kod: KIRLI[id] }; });
        if (!satirlar.length) return;
        const btn = document.getElementById('btnOnayla'); btn.disabled = true;
        toastr.info(`${satirlar.length} satır kaydediliyor...`, '', { timeOut: 3000 });
        fetch(`/Rapor163/KodKaydet${qs1}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ satirlar }) })
            .then(r => { if (!r.ok) throw new Error('Sunucu ' + r.status + (r.status === 403 ? ' (yetki yok)' : r.status === 401 ? ' (oturum düşmüş, sayfayı yenileyin)' : '')); return r.json(); })
            .then(res => {
                btn.disabled = false;
                // Kaydedilemeyen satırların seçimi ekranda kalır; kaydedilenler SAP'den yeniden okunur
                const kalan = {}; (res.hatali || []).forEach(id => { if (KIRLI[id] !== undefined) kalan[id] = KIRLI[id]; });
                if (res.success) toastr.success(res.message, "", { timeOut: 8000 });
                else if (res.kismi) toastr.warning(res.message, "Bazı satırlar kaydedilemedi", { timeOut: 15000 });
                else toastr.error(res.message || "Kaydedilemedi", "", { timeOut: 15000 });
                if (res.success || res.kismi || res.yazilan > 0) { for (const k in KIRLI) delete KIRLI[k]; yukle(kalan); }
                else render();
            }).catch(e => { btn.disabled = false; toastr.error("Kayıt yapılamadı: " + (e.message || e), "", { timeOut: 15000 }); });
    }
    function alanDurumu() {
        fetch(`/Rapor163/AlanDurumu${qs1}`).then(r => r.json()).then(res => {
            if (!res.success) return;
            const eksik = !res.jdt1 || !res.inv1;
            document.getElementById('btnAlan').hidden = !eksik;
            if (eksik) toastr.warning('Gider/gelir alanı (U_BE1_GIDER) bu şirkette henüz açık değil: ' + (!res.jdt1 ? 'yevmiye ' : '') + (!res.inv1 ? 'fatura ' : '') + 'satırları. "Alanı Aç" ile Service Layer üzerinden açabilirsiniz.', '', { timeOut: 12000 });
        }).catch(() => { });
    }
    function alanAc() {
        const b = document.getElementById('btnAlan'); b.disabled = true;
        fetch(`/Rapor163/GiderAlaniniHazirla${qs1}`, { method: 'POST' }).then(r => r.json()).then(res => {
            b.disabled = false;
            if (res.success) { toastr.success(res.message, '', { timeOut: 8000 }); alanDurumu(); yukle(); } else toastr.error(res.message, '', { timeOut: 12000 });
        }).catch(e => { b.disabled = false; toastr.error('Hata: ' + e); });
    }
    document.getElementById('btnToplu').addEventListener('click', topluAta);
    document.getElementById('btnAlan').addEventListener('click', alanAc);
    document.getElementById('btnKodsuz').addEventListener('click', function () { sadeceKodsuz = !sadeceKodsuz; this.classList.toggle('on', sadeceKodsuz); render(); });


    // sekme
    document.querySelectorAll('.gg-tab').forEach(t => t.addEventListener('click', function () {
        document.querySelectorAll('.gg-tab').forEach(x => x.classList.remove('active'));
        this.classList.add('active');
        aktifTab = this.dataset.tab; sortKey = null; render();
    }));

    // Dönem Excel'i: seçili ay/yılın Gider ve Gelir satırları
    document.getElementById('btnExcel').addEventListener('click', () => {
        window.location.href = `/Rapor163/Excel?yil=${document.getElementById('selYil').value}&ay=${document.getElementById('selAy').value}${qs}`;
    });

    // ===================== KODA GÖRE =====================
    let KOD_LISTE = null;          // katalog (kod + ad) — datalist için
    let KOD_DATA = [];             // son getirilen satırlar
    const kodSecili = new Set();

    function kodPaneliHazirla() {
        const bas = document.getElementById('kodBas'), bit = document.getElementById('kodBit');
        if (!bas.value) { const y = new Date().getFullYear(); bas.value = `${y}-01-01`; }
        if (!bit.value) bit.value = new Date().toISOString().substring(0, 10);
        if (KOD_LISTE) return;
        KOD_LISTE = [];
        fetch('/Rapor164/Kodlar' + qs1).then(r => r.json()).then(res => {
            if (!res.success) { toastr.error('Kod listesi alınamadı: ' + (res.message || '')); return; }
            KOD_LISTE = res.data || [];
            // datalist: "KOD — Ana › Alt › Kalem"; kullanıcı ad ya da kod yazarak seçer
            document.getElementById('kodListe').innerHTML = KOD_LISTE.map(k => `<option value="${esc(k.kod)} — ${esc(k.ad)}"></option>`).join('');
        }).catch(e => toastr.error('Kod listesi alınamadı: ' + e));
    }

    // Yazılan metinden kodu çöz: "GDR.01.02.03.07 — Ana › Alt › Kalem" ya da düz kod ya da ad parçası
    function kodCoz() {
        const m = (document.getElementById('kodAra').value || '').trim();
        if (!m) return null;
        const ilk = m.split('—')[0].trim();
        if (/^(GDR|GLR|TIS)\.\d+/i.test(ilk)) return ilk.toUpperCase();
        const q = m.toLowerCase();
        const aday = (KOD_LISTE || []).filter(k => (k.ad || '').toLowerCase().includes(q) || (k.kalem || '').toLowerCase().includes(q));
        if (aday.length === 1) return aday[0].kod;
        if (aday.length > 1) { toastr.warning(`"${m}" için ${aday.length} kalem bulundu; listeden birini seçin.`); return null; }
        return null;
    }

    function kodGetir() {
        const kod = kodCoz();
        if (!kod) { toastr.warning('Kalem adı ya da kodu seçiniz.'); return; }
        const kalem = (KOD_LISTE || []).find(k => k.kod === kod);
        document.getElementById('kodSecilen').textContent = kod + (kalem ? ' · ' + kalem.ad : '');
        document.getElementById('kodBody').innerHTML = '<tr><td colspan="12" class="gg-empty"><i class="fa-solid fa-spinner fa-spin"></i> Yükleniyor...</td></tr>';
        kodSecili.clear();
        const p = `kod=${encodeURIComponent(kod)}&baslangic=${document.getElementById('kodBas').value}&bitis=${document.getElementById('kodBit').value}${qs}`;
        fetch('/Rapor163/KodaGore?' + p).then(r => r.json()).then(res => {
            if (!res.success) { toastr.error(res.message || 'Veri alınamadı'); document.getElementById('kodBody').innerHTML = `<tr><td colspan="12" class="gg-empty">${esc(res.message)}</td></tr>`; return; }
            KOD_DATA = res.data || [];
            document.getElementById('cntKod').textContent = KOD_DATA.length;
            kodCiz();
        }).catch(e => toastr.error('Hata: ' + e));
    }

    function kodCiz() {
        const body = document.getElementById('kodBody');
        if (!KOD_DATA.length) { body.innerHTML = '<tr><td colspan="12" class="gg-empty">Bu kod ve tarih aralığında satır yok.</td></tr>'; }
        else body.innerHTML = KOD_DATA.map(r => `<tr class="${kodSecili.has(r.id) ? 'sel' : ''}">
            <td><input type="checkbox" class="chk kod-chk" data-id="${esc(r.id)}" ${kodSecili.has(r.id) ? 'checked' : ''}></td>
            <td>${esc(r.tarih)}</td><td>${esc(r.belgeTuru)}</td><td><b>${esc(r.belgeNo)}</b></td>
            <td title="${esc(r.cardCode)}">${esc(r.cari)}</td><td title="${esc(r.hesapAdi)}">${esc(r.hesapKodu)}</td>
            <td class="txt-r">${fmt(r.borc)}</td><td class="txt-r">${fmt(r.alacak)}</td>
            <td><span class="kod">${esc(r.kod)}</span></td><td>${esc(r.tur)}</td>
            <td style="font-size:.74rem;">${esc(r.atanan || '')}${r.onayDurum ? ' · ' + esc(r.onayDurum) : ''}</td>
            <td style="max-width:260px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${esc(r.aciklama)}">${esc(r.aciklama)}</td></tr>`).join('');
        kodToplamYaz();
        document.getElementById('kodChkAll').checked = KOD_DATA.length > 0 && KOD_DATA.every(r => kodSecili.has(r.id));
    }

    function kodToplamYaz() {
        const b = KOD_DATA.reduce((a, r) => a + (r.borc || 0), 0), c = KOD_DATA.reduce((a, r) => a + (r.alacak || 0), 0);
        document.getElementById('kodToplamHepsi').innerHTML = KOD_DATA.length ? `${KOD_DATA.length} satır · Borç <b>${fmt(b)}</b> · Alacak <b>${fmt(c)}</b> · Net <b>${fmt(b - c)}</b>` : '—';
        const sec = KOD_DATA.filter(r => kodSecili.has(r.id));
        const sB = sec.reduce((a, r) => a + (r.borc || 0), 0), sA = sec.reduce((a, r) => a + (r.alacak || 0), 0);
        const hap = document.getElementById('kodToplamSecili');
        hap.classList.toggle('bos', sec.length === 0);
        hap.innerHTML = sec.length ? seciliHap(sec.length, sB, sA) : `<span class="et"><i class="fa-solid fa-check-double"></i> Seçili <span class="n">0</span></span><span class="p">Satır işaretleyin</span>`;
    }

    document.getElementById('btnKodGetir').addEventListener('click', kodGetir);
    document.getElementById('kodAra').addEventListener('keydown', e => { if (e.key === 'Enter') kodGetir(); });
    document.getElementById('kodAra').addEventListener('change', () => { if (/—/.test(document.getElementById('kodAra').value)) kodGetir(); });
    document.getElementById('btnKodExcel').addEventListener('click', () => {
        const kod = kodCoz(); if (!kod) { toastr.warning('Kalem seçiniz.'); return; }
        window.location.href = `/Rapor163/KodaGoreExcel?kod=${encodeURIComponent(kod)}&baslangic=${document.getElementById('kodBas').value}&bitis=${document.getElementById('kodBit').value}${qs}`;
    });
    document.getElementById('kodBody').addEventListener('change', e => {
        if (!e.target.classList.contains('kod-chk')) return;
        const id = e.target.dataset.id;
        if (e.target.checked) kodSecili.add(id); else kodSecili.delete(id);
        e.target.closest('tr').classList.toggle('sel', e.target.checked);
        kodToplamYaz();
        document.getElementById('kodChkAll').checked = KOD_DATA.length > 0 && KOD_DATA.every(r => kodSecili.has(r.id));
    });
    document.getElementById('kodChkAll').addEventListener('change', function () { KOD_DATA.forEach(r => this.checked ? kodSecili.add(r.id) : kodSecili.delete(r.id)); kodCiz(); });
    // sıralama
    document.querySelectorAll('table.gg thead th[data-k]').forEach(th => th.addEventListener('click', function () {
        const k = this.dataset.k;
        if (sortKey === k) sortDir = -sortDir; else { sortKey = k; sortDir = 1; }
        render();
    }));
    document.getElementById('chkAll').addEventListener('change', function () {
        const on = this.checked;
        aktifListe().forEach(r => { if (on) secili[aktifTab].add(r.id); else secili[aktifTab].delete(r.id); });
        render();
    });
    let st; document.getElementById('ggSearch').addEventListener('input', () => { clearTimeout(st); st = setTimeout(render, 200); });
    document.getElementById('btnOnayla').addEventListener('click', onayla);

    // ---- Ters etki eden hesaplar (override) ----
    let hesapListesiYuklendi = false;
    function acTers() {
        document.getElementById('tersModal').classList.add('on');
        if (!hesapListesiYuklendi) {
            fetch(`/Rapor163/Hesaplar${qs1}`).then(r => r.json()).then(res => {
                if (res.success) {
                    document.getElementById('ovHesapList').innerHTML = res.data.map(h => `<option value="${esc(h.kod)}">${esc(h.kod)} - ${esc(h.ad)}</option>`).join('');
                    hesapListesiYuklendi = true;
                }
            }).catch(() => { });
        }
        overrideYukle();
    }
    function kapatTers() { document.getElementById('tersModal').classList.remove('on'); }
    document.getElementById('tersModal').addEventListener('click', e => { if (e.target.id === 'tersModal') kapatTers(); });

    function overrideYukle() {
        fetch(`/Rapor163/Override${qs1}`).then(r => r.json()).then(res => {
            const body = document.getElementById('ovBody');
            if (!res.success) { body.innerHTML = `<tr><td colspan="5" style="color:#b91c1c;padding:12px;">${esc(res.message)}</td></tr>`; return; }
            if (!res.data.length) { body.innerHTML = `<tr><td colspan="5" style="text-align:center;color:#94a3b8;padding:16px;">Henüz kural yok.</td></tr>`; return; }
            body.innerHTML = res.data.map(o => `<tr>
                <td class="hcode">${esc(o.hesapKodu)}</td>
                <td>${esc(o.hesapAdi)}</td>
                <td><span class="badge2 ${o.tur === 'Gelir' ? 'yv' : 'ft'}">${esc(o.tur)}</span></td>
                <td>${esc(o.aciklama)}</td>
                <td><button class="gg-sil" onclick="overrideSil('${esc(o.hesapKodu)}')"><i class="fa-solid fa-trash"></i></button></td>
            </tr>`).join('');
        }).catch(e => toastr.error("Hata: " + e));
    }

    function overrideEkle() {
        const kodRaw = document.getElementById('ovHesap').value.trim();
        const kod = kodRaw.split(' - ')[0].trim();
        const tur = document.getElementById('ovTur').value;
        const aciklama = document.getElementById('ovAciklama').value.trim();
        if (!kod) { toastr.warning("Hesap seçin/girin."); return; }
        // hesap adını datalist'ten bul
        let ad = "";
        const opt = Array.from(document.getElementById('ovHesapList').options).find(o => o.value === kod);
        if (opt) ad = opt.textContent.split(' - ').slice(1).join(' - ');
        fetch(`/Rapor163/OverrideKaydet${qs1}`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ hesapKodu: kod, hesapAdi: ad, tur, aciklama })
        }).then(r => r.json()).then(res => {
            if (res.success) {
                toastr.success(res.message);
                document.getElementById('ovHesap').value = ''; document.getElementById('ovAciklama').value = '';
                overrideYukle();
                yukle(); // sekmeler override'a göre yeniden dolsun
            } else toastr.error(res.message);
        }).catch(e => toastr.error("Hata: " + e));
    }

    function overrideSil(kod) {
        fetch(`/Rapor163/OverrideSil${qs1}`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ hesapKodu: kod })
        }).then(r => r.json()).then(res => {
            if (res.success) { toastr.success(res.message); overrideYukle(); yukle(); }
            else toastr.error(res.message);
        }).catch(e => toastr.error("Hata: " + e));
    }

    document.getElementById('btnTers').addEventListener('click', acTers);
    document.getElementById('btnOvEkle').addEventListener('click', overrideEkle);

    document.querySelector('.gg-tab.gider').classList.add('active');
    kodlariYukle();
    alanDurumu();
    yukle();
    fetch(`/Rapor164/SabitCariler${qs1}`).then(r => r.json()).then(res => { if (res.success) { const o = (res.data || []).filter(s => s.durum === 'ONAYLANDI' && s.aktif).length, b = (res.data || []).filter(s => s.durum === 'BEKLIYOR').length; document.getElementById('cntSabit').textContent = o + (b ? ' +' + b : ''); } }).catch(() => { });
</script>
