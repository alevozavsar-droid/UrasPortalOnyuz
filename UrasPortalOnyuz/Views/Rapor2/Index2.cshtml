                            cell.title = (item.BelgeTipi || '') + ' ' + (item.CekNumarasi || '') + ' · işlem tipi ' + (item.CekTipi || '') + ' · ' + (item.BankaAdi || '') + (item.Sube ? ' / ' + item.Sube : '') + ' · belge detayı için tıklayın';
