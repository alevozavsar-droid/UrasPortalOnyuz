            window.applyColumnConfig = function (config) {
                const table = document.querySelector('.rapor-tablo');
                if (!table) return;

                const sortedConfig = [...config].sort((a, b) => a.newIndex - b.newIndex);
                window.currentColumnConfig = sortedConfig;

                const theadRow = table.querySelector('thead tr.main-header-row');
                const filterRow = table.querySelector('thead tr.filter-row');
                
                const originalHeaders = new Map(Array.from(theadRow.children).map(el => [el.dataset.column, el]));
                const originalFilterCells = new Map(Array.from(filterRow?.children || []).map(el => [el.dataset.column, el]));
                
                const newHeadersFragment = document.createDocumentFragment();
                const newFilterRowFragment = document.createDocumentFragment();

                sortedConfig.forEach(item => {
                    const header = originalHeaders.get(item.columnName);
                    const filterCell = originalFilterCells.get(item.columnName);
                    
                    if (header) { 
                        if (!item.visible) {
                            header.style.display = 'none';
                            if (filterCell) filterCell.style.display = 'none';
                        } else {
                            header.style.display = '';
                            if (filterCell) filterCell.style.display = '';
                        }
                        newHeadersFragment.appendChild(header); 
                    }
                    if (filterCell) { newFilterRowFragment.appendChild(filterCell); }
                });

                theadRow.innerHTML = ''; theadRow.appendChild(newHeadersFragment);
                if (filterRow) { filterRow.innerHTML = ''; filterRow.appendChild(newFilterRowFragment); }

                if (typeof window.filterTableAndRender === 'function') {
                    window.filterTableAndRender();
                }
            };

