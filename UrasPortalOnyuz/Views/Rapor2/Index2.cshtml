@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            window.currentColumnNames = Array.from(document.querySelectorAll('#rapor2Table thead .main-header-row th')).map(th => th.dataset.column);
            
            const currentDbParam = '@(Context.Request.Query["db"].ToString() ?? Context.Request.Cookies["SelectedDatabase"] ?? "")';
            const dbQueryString = currentDbParam ? `?db=${currentDbParam}` : '';

            // Sutun duzenini bu sayfa kendisi kuruyor; layout'un gecikmeli
            // yukleyicisi araya girmesin.
            window.sayfaKolonlariniKendiYonetir = true;

            // Modaller sayfa govdesi icinde duruyor; layout @@RenderBody()'yi
            // .table-container icinde render ettigi icin olusan stacking context
            // yuzunden pencere backdrop'un altinda kalip bulanik ve tiklanamaz
            // goruluyordu. Body'ye tasiyoruz.
            ['detayModal', 'cekDetayModal', 'cekFisModal', 'farkliIslemlerModal'].forEach(function (id) {
                const el = document.getElementById(id);
                if (el && el.parentElement !== document.body) document.body.appendChild(el);
            });

            const storageKey = `reportConfig_${window.location.pathname.replace(/\//g, '_')}`;

            const allReportData = @Html.Raw(reportDataJson);

            // DocEntry -> kayıt haritası: satır döngüleri içinde lineer arama yapılmasın.
            const reportDataMap = new Map();
            allReportData.forEach(function (d) {
                reportDataMap.set(d.DocEntry, d);
                // süzgeç / sıralama için türetilmiş metinler (Nakit Akış Eşleşmesi, Kontrol, Fiş)
                d.NakitAkisDurum = d.PlanDocEntry ? (d.PlanDurum || '') : d.IslemTuru === 'Planlandı' ? 'Satır Yok' : '—';
                d.KontrolMetni = d.Kontrol || '—';
                d.FisNo = d.FisNo || '';
                d.Dolasim = d.Dolasim || '';
                d.Kaynak = d.Kaynak || '';
            });
            
            const table = document.getElementById('rapor2Table');
            const tableBody = table.querySelector('tbody');

            // "Sutunlari Yonet" duzeni degistirdiginde satirlari yeniden ciz:
            // hucreler yeni sutun sirasina gore olusturuluyor.
            window.addEventListener('columnConfigUpdated', function () {
                if (tableBody && tableBody.children.length > 0 && window.filterTableAndRender) {
                    window.filterTableAndRender();
                }
            });
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');

            // Seçili çeklerin DocEntry kümesi (DOM'dan bağımsız tutulur; parça parça
            // çizimde görünmeyen satırlar DOM'da olmadığı için bu şart).
            const seciliSet = new Set();

            // Parça parça çizim durumu
            const PARCA_BOYUTU = 150;
            let cizimVerisi = [];
            let cizilenAdet = 0;
            let cizimSatirYapici = null;
            const totalSelectedTlAmountSpan = document.getElementById('totalSelectedTlAmount');
            const selectedCheckCountSpan = document.getElementById('selectedCheckCount');
            const totalRecordsSpan = document.getElementById('totalRecords');
            const BOOTSTRAP_COLOR_CLASSES = ['table-info', 'table-secondary', 'table-danger', 'table-warning', 'table-success', 'table-primary'];
            const ORIGINAL_ROW_CLASSES = new Map();
            const checkTransactionTypesJs = @Html.Raw(checkTransactionTypesJson);

            let currentlyFilteredRows = [...allReportData];
            let currentSortColumn = null;
            let currentSortDirection = 'none';
            let activeYearFilter = 'all';

            const columnMappings = {
                'Checkbox': null, 
                'CekNumarasi': 'CekNumarasi', 
                'BelgeTipi': 'BelgeTipi', 
                'HareketDurumu': 'HareketDurumu', 
                'Aciklama': 'Aciklama', 
                'KonumDurumu': 'KonumDurumu',
                'KullanimDurumu': 'KullanımDurumu',
                'VadeDurumu': 'VadeDurumu', 
                'UygunlukDurumu': 'UygunlukDurumu',
                'Tutar': 'Tutar',
                'ParaBirimi': 'ParaBirimi', 
                'TlKarsiligi': 'TlKarsiligi',
                'VadeTarihi': 'VadeTarihi', 
                'VadeAyiVeYili': 'VadeAyiVeYili',
                'PortfoyeGirisTarihi': 'PortfoyeGirisTarihi',
                'PortfoyVadeAyiYili': 'PortfoyVadeAyiYili', 
                'IbrazTarihi': 'IbrazTarihi', 
                'CekKimdenGeldi': 'CekKimdenGeldi', 
                'AsilBorclu': 'AsilBorclu', 
                'PlanlananTedarikci': 'PlanlananTedarikci',
                'CekKimeVerildi': 'CekKimeVerildi', 
                'VadeliCekIbrazi': 'VadeliCekIbrazi',
                'BankaAdi': 'BankaAdi', 
                'Sube': 'Sube',
                'IbrazBelgeNo': 'IbrazBelgeNo',
                'TahsilatBelgeNo': 'TahsilatBelgeNo', 
                'IslemTipiAdi': 'IslemTipiAdi',
                'CekIslemTuru': 'CekIslemTuru',
                // Takip Paneli ile ortak sütunlar
                'Dolasim': 'Dolasim',
                'Kaynak': 'Kaynak',
                'NakitAkis': 'NakitAkisDurum',
                'Kontrol': 'KontrolMetni',
                'Fis': 'FisNo'
            };

            function adjustLayoutHeight() {
                const reportBox = document.getElementById('mainReportBox');
                const tableContainer = document.getElementById('tableContainer');
                const toolbar = document.querySelector('.sticky-toolbar');
                const cards = document.querySelector('.summary-cards-wrapper');
                const footer = document.querySelector('.footer-row-container');

                if (reportBox && tableContainer && toolbar && cards && footer) {
                    const boxTop = reportBox.getBoundingClientRect().top;
                    const availableHeight = window.innerHeight - boxTop - 15;
                    reportBox.style.height = availableHeight + 'px';

                    const ozet = document.getElementById('cekOzetPanel');   // Durum Özeti paneli açıksa tablo alanı küçülür
                    const tableHeight = availableHeight - toolbar.offsetHeight - cards.offsetHeight - footer.offsetHeight - (ozet && !ozet.classList.contains('d-none') ? ozet.offsetHeight : 0);
                    tableContainer.style.height = Math.max(160, tableHeight) + 'px';
                }

                // Filtre satırı, başlık satırının hemen altına yapışsın (ikisi de sabit kalır)
                const headerRow = document.querySelector('#rapor2Table thead tr.main-header-row');
                if (headerRow && headerRow.offsetHeight > 0) {
                    document.documentElement.style.setProperty('--head-row-h', headerRow.offsetHeight + 'px');
                }
            }

            window.addEventListener('resize', adjustLayoutHeight);
            // pencere genişliği değişince sütunlar yeniden sığdırılır
            let sigdirZamanlayici = null;
            window.addEventListener('resize', function () {
                clearTimeout(sigdirZamanlayici);
                sigdirZamanlayici = setTimeout(function () { if (cizimVerisi.length && typeof sutunGenisliklerineUygula === 'function') sutunGenisliklerineUygula(cizimVerisi, window.currentColumnConfig || window.currentColumnNames.map((c, i) => ({ columnName: c, visible: true, newIndex: i }))); }, 150);
            });

            // Tablo kutusunun sonuna yaklaşınca sonraki parçayı çiz
            (function () {
                // getElementById kullaniliyor: querySelector('.table-container')
                // DOM'daki ILK esleseni, yani sablonun sarmalayicisini aliyordu.
                const kutu = document.getElementById('tableContainer');
                if (!kutu) return;
                kutu.addEventListener('scroll', function () {
                    if (kutu.scrollTop + kutu.clientHeight >= kutu.scrollHeight - 400) sonrakiParcayiCiz();
                }, { passive: true });
            })();

            function calculateSummaryCards() {
                let portfoyAdet = 0, portfoyTutar = 0;
                let tahsilAdet = 0, tahsilTutar = 0;
                let cikisAdet = 0, cikisTutar = 0;
                let riskliAdet = 0, riskliTutar = 0;
                let planAdet = 0, planTutar = 0;   // Kasa Nakit Akışı'nda planlanan belgeler

                let dataToCalculate = allReportData;
                if (activeYearFilter !== 'all') {
                    dataToCalculate = allReportData.filter(item => {
                        if(item.VadeTarihi) return new Date(item.VadeTarihi).getFullYear().toString() === activeYearFilter;
                        return false;
                    });
                }

                dataToCalculate.forEach(item => {
                    const durum = item.HareketDurumu || '';
                    const islem = item.IslemTuru || '';
                    const tutar = item.TlKarsiligi || item.Tutar || 0;

                    if (durum === 'Portföyde') { portfoyAdet++; portfoyTutar += tutar; }
                    else if (islem === 'Bankadan Tahsil Edildi' || islem === 'Elden Tahsil Edildi') { tahsilAdet++; tahsilTutar += tutar; }
                    else if (durum === 'İşlem Yapıldı' && (islem !== 'Bankadan Tahsil Edildi' && islem !== 'Elden Tahsil Edildi' && !islem.includes('Karşılıksız') && !islem.includes('Protesto') && !islem.includes('Konkordato'))) { cikisAdet++; cikisTutar += tutar; }
                    
                    if (islem.includes('Karşılıksız') || islem.includes('Protesto') || islem.includes('Konkordato')) { riskliAdet++; riskliTutar += tutar; }
                    if (islem === 'Planlandı' || item.CekIslemTuru === '2') { planAdet++; planTutar += tutar; }
                });
                const statPlanTutar = document.getElementById('statPlanTutar'), statPlanAdet = document.getElementById('statPlanAdet');
                if (statPlanTutar) statPlanTutar.textContent = planTutar.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' TL';
                if (statPlanAdet) statPlanAdet.textContent = planAdet + ' Adet';

                document.getElementById('statPortfoyTutar').textContent = portfoyTutar.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' TL';
                document.getElementById('statPortfoyAdet').textContent = portfoyAdet + ' Adet';
                document.getElementById('statTahsilTutar').textContent = tahsilTutar.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' TL';
                document.getElementById('statTahsilAdet').textContent = tahsilAdet + ' Adet';
                document.getElementById('statCikisTutar').textContent = cikisTutar.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' TL';
                document.getElementById('statCikisAdet').textContent = cikisAdet + ' Adet';
                document.getElementById('statRiskliTutar').textContent = riskliTutar.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' TL';
                document.getElementById('statRiskliAdet').textContent = riskliAdet + ' Adet';
            }

            document.querySelectorAll('.quick-filter-card').forEach(card => {
                card.addEventListener('click', function() {
                    const column = this.dataset.column;
                    const valueString = this.dataset.value; 
                    const valueArray = valueString.split(',');
                    $('.filter-select-bs').selectpicker('val', '');
                    $('.filter-row input').val('');
                    $('#quickSearchInput').val('').trigger('input');

                    const $select = $(`.filter-row th[data-column="${column}"] .filter-select-bs`);
                    if($select.length > 0) {
                        $select.selectpicker('val', valueArray);
                        filterTableAndRender();
                        toastr.success('Tablo seçiminize göre filtrelendi.');
                    }
                });
            });

            function updatePaginationInfo(totalCount) { if (totalRecordsSpan) totalRecordsSpan.textContent = totalCount; }

            // ---------------------------------------------------------------
            // OTOMATİK SÜTUN GENİŞLİĞİ
            // Her sütun içindeki en uzun veriye (ve başlığına) göre ölçülür.
            // Görünür sütunların toplamı tabloya min-width olarak verilir: az
            // sütunda tablo ekrana sığar, çok sütunda yatay kaydırma çıkar.
            // ---------------------------------------------------------------
            // Takip Paneli › Çek · Senet ile aynı ölçüler: Satır Kaynağı · İşlem (206) ve Dolaşım (190) kırpılmaz
            const SUTUN_ALT_SINIR = { 'Checkbox': 34, 'IbrazBelgeNo': 96, 'PlanlananTedarikci': 130, 'CekIslemTuru': 150, 'CekNumarasi': 160, 'VadeTarihi': 110, 'CekKimdenGeldi': 130, 'Dolasim': 190, 'Kaynak': 206, 'CekKimeVerildi': 150, 'Tutar': 104, 'NakitAkis': 124, 'Kontrol': 100, 'UygunlukDurumu': 80, 'Fis': 90 };
            const SUTUN_UST_SINIR = 280;
            // iki satırlı hücreler (alt satır "…" ile kırpılır, tam metin araç ipucunda): en uzun veriye göre büyümesin
            // genişliğe sığdırırken kolonların inebileceği en küçük genişlik (varsayılan görünür 14 kolonun toplamı ≈ 1290 px: 1366 px ekranda yatay kaydırma yok)
            const SIGDIRMA_ALT_SINIR = { 'Checkbox': 28, 'CekNumarasi': 116, 'VadeTarihi': 76, 'CekKimdenGeldi': 90, 'CekIslemTuru': 104, 'Dolasim': 112, 'Kaynak': 146, 'PlanlananTedarikci': 92, 'CekKimeVerildi': 100, 'Tutar': 88, 'NakitAkis': 92, 'Kontrol': 76, 'UygunlukDurumu': 62, 'Fis': 74 };
            // dar ekran (≈ 1100 px kap): ikinci kademe; işlem düğmeleri alt alta geçer, kalan yatay kaydırma küçülür
            const SIGDIRMA_DAR_SINIR = { 'Checkbox': 28, 'CekNumarasi': 108, 'VadeTarihi': 72, 'CekKimdenGeldi': 84, 'CekIslemTuru': 96, 'Dolasim': 96, 'Kaynak': 108, 'PlanlananTedarikci': 84, 'CekKimeVerildi': 92, 'Tutar': 82, 'NakitAkis': 84, 'Kontrol': 70, 'UygunlukDurumu': 58, 'Fis': 70 };
            const SUTUN_UST_SINIR_KOLON = { 'CekNumarasi': 160, 'VadeTarihi': 110, 'CekKimdenGeldi': 150, 'CekIslemTuru': 150, 'PlanlananTedarikci': 150, 'CekKimeVerildi': 170, 'NakitAkis': 134, 'Fis': 96, 'Kontrol': 100, 'UygunlukDurumu': 80, 'Tutar': 112 };
            const HUCRE_DOLGUSU = 16;

            // Uzun metin taşıyan kolonlar. Tablo ekrana sığmıyorsa önce bunlar
            // daraltılır; içerik kırpılmaz, alt satıra geçer.
            const SARILABILIR_KOLONLAR = [
                'AsilBorclu', 'IslemTipiAdi',
                'HareketDurumu', 'KonumDurumu', 'VadeDurumu', 'BelgeTipi'
            ];
            const SARILABILIR_UST_SINIR = 170;   // bu kolonlar en fazla bu kadar geniş başlar
            const SARILABILIR_ALT_SINIR = 76;    // daraltma bu değerin altına inmez

            let olcumCtx = null, olcumFontNormal = '', olcumFontKalin = '';

            function metinGenisligi(metin, kalinMi) {
                if (!olcumCtx) {
                    olcumCtx = document.createElement('canvas').getContext('2d');
                    const stil = getComputedStyle(table);
                    olcumFontNormal = stil.fontSize + ' ' + stil.fontFamily;
                    olcumFontKalin = '700 ' + olcumFontNormal;
                }
                olcumCtx.font = kalinMi ? olcumFontKalin : olcumFontNormal;
                return olcumCtx.measureText(metin == null ? '' : String(metin)).width;
            }

            function hucreMetni(item, colName) {
                if (['VadeTarihi', 'PortfoyeGirisTarihi', 'IbrazTarihi'].includes(colName)) {
                    return item[colName] ? new Date(item[colName]).toLocaleDateString('tr-TR') : '';
                }
                if (['Tutar', 'TlKarsiligi'].includes(colName)) {
                    const v = item[colName];
                    return (v == null) ? '' : v.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }
                // Takip Paneli ile ortak sütunlar (ölçüm, detay penceresi ve Excel metni)
                if (colName === 'NakitAkis') return item.PlanDocEntry ? '#' + item.PlanDocEntry + ' · ' + (item.PlanDurum || '') + (item.PlanTalimat ? ' · talimat ' + item.PlanTalimat : item.CikisTalebi && item.PlanOnay !== 'Onaylandı' ? ' · GMY onayı bekliyor' : '') : item.NakitAkisDurum;
                if (colName === 'Dolasim') return item.Dolasim ? item.Dolasim + ' · ' + item.DolasimGerceklesen + '/' + item.DolasimToplam + ' adım' : '';
                if (colName === 'Fis') return item.FisNo ? item.FisNo + (item.FisKaynak ? ' · ' + item.FisKaynak : '') : '';
                if (colName === 'KaynakDetay') return item.KaynakDetay || '';
                if (colName === 'DolasimSiradaki') return item.DolasimSiradaki || '';
                return item[columnMappings[colName]] || '';
            }

            // ---- Takip Paneli › Çek · Senet ile aynı hücre dili ----
            const esc = s => String(s === null || s === undefined ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            const altSatir = (s, sinif) => s ? '<span class="alt ' + (sinif || '') + '" title="' + esc(s) + '">' + esc(s) + '</span>' : '';
            const tarihTr = v => v ? new Date(v).toLocaleDateString('tr-TR') : '';
            const kynSinif = k => /^Kasa Nakit Akışı/.test(k) ? 'na' : /^Çek Akıbeti/.test(k) ? 'akibet' : /^Dolaşım/.test(k) ? 'dolasim' : 'diger';
            const kontrolHtml = item => { const k = item.Kontrol; return k === 'Uyumlu' ? '<span class="ca-kontrol uyumlu" title="Planlanan tedarikçiye çıktı">Uyumlu</span>' : k === 'Farklı' ? '<span class="ca-kontrol farkli" title="DİKKAT: plan ' + esc(item.PlanlananTedarikci) + ', çıkış ' + esc(item.CekKimeVerildi) + '">FARKLI</span>' : k === 'İbraz Bekliyor' ? '<span class="ca-kontrol bekliyor">İbraz Bekliyor</span>' : k === 'Plansız İbraz' ? '<span class="ca-kontrol plansiz">Plansız İbraz</span>' : '<span class="text-muted">—</span>'; };
            const dolasimHtml = item => {
                const L = item.DolasimAdimlar || []; if (!L.length) return '<span class="text-muted">—</span>';
                return '<div class="ca-dol" title="' + esc(item.Dolasim) + '">' + esc(L[0].Eden) + L.map(a => ' <i class="fas fa-arrow-right"></i> <span class="' + (a.Durum === 'Gerçekleşti' ? 'ok' : 'plan') + '">' + esc(a.Alan) + '</span>').join('') + '</div>'
                    + altSatir(item.DolasimGerceklesen + '/' + item.DolasimToplam + ' adım gerçekleşti' + (item.DolasimSiradaki ? ' · sıradaki: ' + item.DolasimSiradaki : ' · dolaşım tamamlandı'));
            };
            // satır kaynağı rozeti + yapılacak iş: portföyde → Nakit Akışa Ekle / İbraz Et, planlı → Tedarikçiye Çık (belge detayındaki hızlı işlemler), GMY onayı bekleyen, çıkmış belge → işlem gerekmez
            const kaynakHtml = item => {
                const k = item.Kaynak || ''; const b = (ad, ikon, sinif, baslik) => '<button type="button" class="btn btn-xs ' + sinif + ' cek-islem-btn" data-docentry="' + item.DocEntry + '" title="' + esc(baslik) + '">' + (ikon ? '<i class="fas ' + ikon + ' me-1"></i>' : '') + ad + '</button>';
                let is;
                if (item.SatirIslem === 'portfoy') is = b('Nakit Akışa Ekle', '', 'btn-primary', 'Kasa Nakit Akışı\'nda çek / senet satırı açılır, belge planlanır') + ' ' + b('İbraz Et', '', 'btn-outline-success', 'Plansız çıkış: GMY onayına düşer');
                else if (item.SatirIslem === 'planli') is = b('Tedarikçiye Çık', 'fa-share-from-square', 'btn-success', 'Plan satırı üzerinden ciro / ibraz: Kasa Nakit Akışı satırı ÖDENDİ, fiş atılır');
                else if (item.SatirIslem === 'gmy') is = '<span class="ca-roz uyari"><i class="fas fa-user-shield me-1"></i>GMY Onayı Bekliyor</span>';
                else is = 'işlem gerekmez';
                return '<span class="ca-kyn ' + kynSinif(k) + '" title="' + esc(item.KaynakDetay || '') + '">' + esc(k) + '</span><div class="ca-kyn-is">' + is + '</div>';
            };
            const nakitAkisHtml = item => item.PlanDocEntry
                ? '<a href="' + esc(item.PlanLink || '#') + '" target="_blank" class="ca-link" title="Kasa Nakit Akışı satırını aç">#' + item.PlanDocEntry + '</a> <span class="ca-roz ' + (item.PlanDurum === 'ÖDENDİ' ? 'ok' : item.PlanDurum === 'Gecikti' ? 'hata' : 'bilgi') + '">' + esc(item.PlanDurum || '') + '</span>' + altSatir(item.PlanTalimat ? 'talimat ' + item.PlanTalimat : item.CikisTalebi && item.PlanOnay !== 'Onaylandı' ? 'GMY onayı bekliyor' : '')
                : item.IslemTuru === 'Planlandı' ? '<span class="ca-roz hata">Satır Yok</span>' + altSatir('Çek Akıbeti\'nden planlı') : '<span class="text-muted">—</span>';
            const fisHtml = item => item.FisNo ? '<a href="#" class="ca-link cek-fis-ac" data-docentry="' + item.DocEntry + '" title="Muhasebe fişini aç">' + esc(item.FisNo) + '</a>' + altSatir(item.FisKaynak) : '<span class="text-muted">—</span>';
            const tutarHtml = item => { const v = item.Tutar == null ? '' : item.Tutar.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); const pb = item.ParaBirimi || 'TRY'; return '<span class="fw-bold">' + esc(v) + '</span>' + (pb !== 'TRY' ? altSatir(pb + ' · ' + (item.TlKarsiligi == null ? '' : item.TlKarsiligi.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })) + ' TL') : ''); };

            function sutunGenisliklerineUygula(data, colsToRender) {
                try {
                    const basliklar = new Map();
                    document.querySelectorAll('#rapor2Table thead .main-header-row th').forEach(function (th) {
                        basliklar.set(th.dataset.column, th);
                    });

                    let toplam = 0;
                    const olculenler = [];

                    (colsToRender || []).forEach(function (c) {
                        const th = basliklar.get(c.columnName);
                        if (!th) return;
                        if (c.visible === false) { th.style.width = ''; return; }

                        // Kullanici bu kolonu elle genislettiyse ona dokunma.
                        if (th.dataset.elleAyarlandi === '1') {
                            toplam += th.offsetWidth || 0;
                            return;
                        }

                        // başlık iki satıra sarılabilir: başlık metni sütunu en fazla 96 px'e kadar genişletir
                        let enGenis = Math.min(metinGenisligi((th.textContent || '').trim(), true) + 14, 96);

                        if (c.columnName !== 'Checkbox') {
                            // Önce karakter sayısıyla en uzun metni bul (ucuz),
                            // piksel ölçümünü yalnızca onun için yap (pahalı).
                            let enUzunMetin = '';
                            for (let i = 0; i < data.length; i++) {
                                const m = hucreMetni(data[i], c.columnName);
                                if (m && m.length > enUzunMetin.length) enUzunMetin = m;
                            }
                            const g = metinGenisligi(enUzunMetin, false);
                            if (g > enGenis) enGenis = g;
                        }

                        const sarilabilir = SARILABILIR_KOLONLAR.includes(c.columnName);

                        let genislik = Math.ceil(enGenis) + HUCRE_DOLGUSU;
                        genislik = Math.max(genislik, SUTUN_ALT_SINIR[c.columnName] || 44);
                        genislik = Math.min(genislik, sarilabilir ? SARILABILIR_UST_SINIR : (SUTUN_UST_SINIR_KOLON[c.columnName] || SUTUN_UST_SINIR));

                        olculenler.push({ th: th, ad: c.columnName, genislik: genislik, sarilabilir: sarilabilir });
                        toplam += genislik;
                    });

                    // GENİŞLİĞE SIĞDIRMA: tablo kaba sığmıyorsa önce sarılabilir kolonlar (metin alt satıra geçer),
                    // sonra bütün kolonlar alt sınırlarına kadar orantılı daraltılır (kırpılan metin "…", tamamı araç ipucunda).
                    // Yalnız alt sınırların toplamı bile sığmazsa yatay kaydırma kalır.
                    // kabın iç genişliği eksi her kolonun sağ kenarlığı ve küçük pay (ölçülen genişlikler kenarlıksız)
                    const kullanilabilir = table.parentElement ? table.parentElement.clientWidth - olculenler.length - 6 : 0;
                    function daralt(aday, altSinir) {
                        const kisilabilir = aday.reduce(function (t, x) { return t + Math.max(0, x.genislik - altSinir(x)); }, 0);
                        if (kisilabilir <= 0 || toplam <= kullanilabilir) return;
                        const oran = Math.min(1, (toplam - kullanilabilir) / kisilabilir);
                        aday.forEach(function (x) { const kis = Math.floor(Math.max(0, x.genislik - altSinir(x)) * oran); x.genislik -= kis; toplam -= kis; });
                    }
                    table.classList.remove('dar');
                    if (kullanilabilir > 40 && toplam > kullanilabilir) {
                        daralt(olculenler.filter(function (x) { return x.sarilabilir; }), function () { return SARILABILIR_ALT_SINIR; });
                        daralt(olculenler, function (x) { return SIGDIRMA_ALT_SINIR[x.ad] || 56; });
                        if (toplam > kullanilabilir) { table.classList.add('dar'); daralt(olculenler, function (x) { return SIGDIRMA_DAR_SINIR[x.ad] || 50; }); }
                    }
                    // sığıyorsa kalan boşluk kolonlara orantılı dağıtılır (tablo her zaman kabı doldurur)
                    if (kullanilabilir > 40 && toplam < kullanilabilir && olculenler.length) {
                        const oran = kullanilabilir / toplam; let dagitilan = 0;
                        olculenler.forEach(function (x) { const yeni = Math.floor(x.genislik * oran); dagitilan += yeni - x.genislik; x.genislik = yeni; });
                        toplam += dagitilan;
                    }

                    olculenler.forEach(function (x) { x.th.style.width = x.genislik + 'px'; });
                    table.style.minWidth = toplam > kullanilabilir ? toplam + 'px' : '';
                } catch (e) {
                    table.style.minWidth = '';
                }
            }

            function updateSelectAllCheckboxState() {
                if (!selectAllCheckbox) return;

                const toplam = cizimVerisi.length;
                let secili = 0;
                cizimVerisi.forEach(function (item) { if (seciliSet.has(item.DocEntry)) secili++; });

                selectAllCheckbox.checked = (toplam > 0 && secili === toplam);
                selectAllCheckbox.indeterminate = (secili > 0 && secili < toplam);
            }

            function saveRowOriginalClass(row) {
                if (ORIGINAL_ROW_CLASSES.has(row)) return;
                let originalClass = '';
                row.classList.forEach(className => { if (BOOTSTRAP_COLOR_CLASSES.includes(className)) originalClass = className; });
                ORIGINAL_ROW_CLASSES.set(row, originalClass);
            }

            window.getTahsilatDetay = function(no) {
                if(!no) return;
                $('#detayBody').html('<div class="text-center py-3"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i></div>');
                $('#detayModal').modal('show');
                $.get(`/CekAkibeti/GetTahsilatDetay?no=${no}${dbQueryString.replace('?','&')}`, function(data) {
                    $('#detayBody').html(data);
                }).fail(function() {
                    $('#detayBody').html('<div class="alert alert-danger">Detay yüklenirken hata oluştu.</div>');
                });
            }

            window.getIbrazDetay = function(no) {
                if(!no) return;
                $('#detayBody').html('<div class="text-center py-3"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i></div>');
                $('#detayModal').modal('show');
                $.get(`/CekAkibeti/GetIbrazDetay?no=${no}${dbQueryString.replace('?','&')}`, function(data) {
                    $('#detayBody').html(data);
                }).fail(function() {
                    $('#detayBody').html('<div class="alert alert-danger">Detay yüklenirken hata oluştu.</div>');
                });
            }

            function renderTable(data) {
                tableBody.innerHTML = '';
                if (data.length === 0) {
                    tableBody.innerHTML = '<tr><td colspan="' + (window.currentColumnNames || []).length + '" class="text-center py-4 fw-bold text-muted">Gösterilecek veri bulunamadı.</td></tr>';
                    updatePaginationInfo(0);
                    return;
                }
                
                let colsToRender = [];
                if (window.currentColumnConfig && window.currentColumnConfig.length > 0) {
                    colsToRender = window.currentColumnConfig;
                } else {
                    colsToRender = window.currentColumnNames.map((c, i) => ({ columnName: c, visible: true, newIndex: i }));
                }
                
                const dateColumns = ['VadeTarihi', 'PortfoyeGirisTarihi', 'IbrazTarihi'];
                const numColumns = ['Tutar', 'TlKarsiligi'];

                cizimSatirYapici = function (item) {
                    const row = document.createElement('tr');
                    const rowClass = item.HareketDurumu ? {
                        'Portföyde': 'table-info',
                        'İşlem Yapıldı': 'table-secondary',
                        'İade Edildi': 'table-danger',
                    }[item.HareketDurumu.trim()] || '' : '';

                    if (rowClass) row.classList.add(rowClass);
                    row.dataset.docentry = item.DocEntry;
                    row.dataset.ibrazBelgeNo = item.IbrazBelgeNo;

                    colsToRender.forEach(colConfig => {
                        const colName = colConfig.columnName;
                        const cell = document.createElement('td');
                        cell.dataset.column = colName;
                        
                        if (!colConfig.visible) {
                            cell.style.display = 'none';
                        }

                        if (colName === 'Checkbox') {
                            cell.classList.add('checkbox-column');
                            const checkbox = document.createElement('input');
                            checkbox.type = 'checkbox';
                            checkbox.className = 'form-check-input row-selector';
                            checkbox.dataset.tlValue = item.TlKarsiligi || 0;
                            cell.appendChild(checkbox);
                        } 
                        else if (colName === 'IbrazBelgeNo') {
                            if (item.IbrazBelgeNo) {
                                const container = document.createElement('div');
                                container.className = "d-flex align-items-center justify-content-between";
                                
                                const detailLink = document.createElement('span');
                                detailLink.className = "detail-link fw-bold";
                                detailLink.textContent = item.IbrazBelgeNo;
                                detailLink.onclick = (e) => { e.stopPropagation(); window.getIbrazDetay(item.IbrazBelgeNo); };
                                container.appendChild(detailLink);

                                const attLink = document.createElement('a');
                                attLink.href = `/CekAkibeti/DownloadAttachment/${item.IbrazBelgeNo}`;
                                attLink.title = 'Eki İndir/Görüntüle';
                                attLink.target = '_blank';
                                attLink.className = "text-decoration-none text-primary ms-2";
                                attLink.innerHTML = '<i class="fas fa-paperclip"></i>';
                                attLink.onclick = (e) => { e.stopPropagation(); };
                                container.appendChild(attLink);

                                cell.appendChild(container);
                            }
                        } 
                        else if (colName === 'TahsilatBelgeNo') {
                            if (item.TahsilatBelgeNo) {
                                const detailLink = document.createElement('span');
                                detailLink.className = "detail-link fw-bold";
                                detailLink.textContent = item.TahsilatBelgeNo;
                                detailLink.onclick = (e) => { e.stopPropagation(); window.getTahsilatDetay(item.TahsilatBelgeNo); };
                                cell.appendChild(detailLink);
                            }
                        }
                        else if (colName === 'CekIslemTuru') {
                            const select = document.createElement('select');
                            select.className = 'check-transaction-select shadow-sm';
                            select.dataset.docentry = item.DocEntry;
                            select.dataset.ibrazBelgeNo = item.IbrazBelgeNo;
                            select.dataset.tahsilatBelgeNo = item.TahsilatBelgeNo;
                            select.dataset.previousValue = item.CekIslemTuru;

                            const emptyOption = document.createElement('option');
                            emptyOption.value = ''; emptyOption.textContent = 'Seçiniz';
                            select.appendChild(emptyOption);

                            checkTransactionTypesJs.forEach(type => {
                                if (type.Code !== "0" && type.Code !== "12") {
                                    const option = document.createElement('option');
                                    option.value = type.Code;
                                    option.textContent = type.Description;
                                    if (item.CekIslemTuru == type.Code) option.selected = true;
                                    select.appendChild(option);
                                }
                            });

                            select.disabled = item.HareketDurumu === 'İade Edildi';
                            select.addEventListener('change', async function() {
                                const newType = this.value;
                                const tahsilatNo = this.dataset.tahsilatBelgeNo;
                                const ibrazNo = this.dataset.ibrazBelgeNo;
                                let isSuccess = false;

                                if (ibrazNo && ibrazNo !== 'null' && ibrazNo !== '') isSuccess = await updateCheckTransactionTypeByIbrazBelge(ibrazNo, newType);
                                else if (tahsilatNo && tahsilatNo !== 'null' && tahsilatNo !== '') isSuccess = await updateCheckTransactionTypeByTahsilat(tahsilatNo, newType);
                                else isSuccess = await updateCheckTransactionTypeByDocEntry(this.dataset.docentry, newType);   // portföydeki (belge numarasız) çek: kayıtla güncelle

                                if (isSuccess) {
                                    this.dataset.previousValue = newType;
                                    if (item) item.CekIslemTuru = newType;
                                    toastr.success("İşlem başarıyla güncellendi. Yeni hesaplamaların yansıması için sayfayı yenileyiniz.");
                                } else { this.value = this.dataset.previousValue; }
                            });
                            cell.appendChild(select);
                        } 
                        else if (colName === 'PlanlananTedarikci') {
                            const input = document.createElement('input');
                            input.type = 'text';
                            input.className = 'planned-supplier-input shadow-sm';
                            input.setAttribute('list', `suppliersList_${item.DocEntry}`);
                            input.value = item.PlanlananTedarikci || '';
                            input.dataset.docentry = item.DocEntry;
                            input.dataset.previousValue = item.PlanlananTedarikci;
                            
                            const datalist = document.createElement('datalist');
                            datalist.id = `suppliersList_${item.DocEntry}`;

                            input.addEventListener('input', async function() {
                                const currentText = this.value.trim();
                                if (currentText.length >= 2) {
                                    try {
                                        const response = await fetch(`/CekAkibeti/SearchSuppliers${dbQueryString}${dbQueryString ? '&' : '?'}term=${encodeURIComponent(currentText)}`);
                                        if (response.ok) {
                                            const suppliers = await response.json();
                                            datalist.innerHTML = '';
                                            suppliers.forEach(supplier => {
                                                const option = document.createElement('option');
                                                option.value = supplier;
                                                datalist.appendChild(option);
                                            });
                                        }
                                    } catch (error) { console.error('Tedarikçi arama hatası:', error); }
                                } else if (currentText.length === 0) datalist.innerHTML = '';
                            });
                            input.addEventListener('focusout', async function() {
                                const docEntry = parseInt(this.dataset.docentry);
                                const newValue = this.value.trim();
                                const previousValue = this.dataset.previousValue;
                                if (newValue !== previousValue) await updatePlannedSupplier(docEntry, newValue);
                            });
                            input.addEventListener('keydown', function(event) {
                                if (event.key === 'Enter') { event.preventDefault(); this.blur(); }
                            });
                            cell.appendChild(input);
                            cell.appendChild(datalist);
                        } 
                        else if (colName === 'CekNumarasi') {
                            const bag = document.createElement('span');
                            bag.className = 'cek-no-link';
                            bag.dataset.docentry = item.DocEntry;
                            bag.textContent = item.CekNumarasi || '';
                            bag.title = 'Detayları görmek için tıklayın';
                            cell.appendChild(bag);
                            cell.insertAdjacentHTML('beforeend', altSatir(((item.BelgeTipi || '') + ' ' + (item.CekTipi || '')).trim() + (item.BankaAdi ? ' · ' + item.BankaAdi : '')));
                        }
                        // ---- Takip Paneli › Çek · Senet ile ortak hücreler ----
                        else if (colName === 'VadeTarihi') {
                            cell.classList.add('text-center'); const vd = item.VadeDurumu || '';
                            cell.innerHTML = esc(tarihTr(item.VadeTarihi)) + altSatir(vd, vd === 'Vadesi Geçti' ? 'text-danger' : vd === 'Bugün' || vd === 'Bu Hafta' ? 'text-warning' : '');
                            cell.title = tarihTr(item.VadeTarihi) + (vd ? ' · ' + vd : '');
                        }
                        else if (colName === 'CekKimdenGeldi') {
                            cell.innerHTML = esc(item.CekKimdenGeldi || '') + (item.AsilBorclu && item.AsilBorclu !== item.CekKimdenGeldi ? altSatir('keşideci: ' + item.AsilBorclu) : '');
                            cell.title = (item.CekKimdenGeldi || '') + (item.AsilBorclu ? ' · keşideci ' + item.AsilBorclu : '');
                        }
                        else if (colName === 'Dolasim') cell.innerHTML = dolasimHtml(item);
                        else if (colName === 'Kaynak') cell.innerHTML = kaynakHtml(item);
                        else if (colName === 'CekKimeVerildi') {
                            if (item.CekKimeVerildi) {
                                cell.innerHTML = esc(item.CekKimeVerildi) + '<span class="alt">' + esc((item.IslemTipiAdi || '') + (item.IbrazTarihi ? ' · ' + tarihTr(item.IbrazTarihi) : '')) + (item.IbrazBelgeNo ? ' · <span class="detail-link" data-ibraz="' + esc(item.IbrazBelgeNo) + '" title="İbraz detayı">' + esc(item.IbrazBelgeNo) + '</span>' : '') + '</span>';
                                cell.title = item.CekKimeVerildi + ' · ' + (item.IslemTipiAdi || '') + (item.IbrazTarihi ? ' · ' + tarihTr(item.IbrazTarihi) : '') + (item.IbrazBelgeNo ? ' · ' + item.IbrazBelgeNo : '');
                            } else cell.innerHTML = '<span class="text-muted">—</span>';
                        }
                        else if (colName === 'Tutar') { cell.classList.add('text-end'); cell.innerHTML = tutarHtml(item); cell.title = hucreMetni(item, 'Tutar') + ' ' + (item.ParaBirimi || 'TRY'); }
                        else if (colName === 'NakitAkis') { cell.innerHTML = nakitAkisHtml(item); cell.title = hucreMetni(item, 'NakitAkis'); }
                        else if (colName === 'Kontrol') cell.innerHTML = kontrolHtml(item);
                        else if (colName === 'Fis') { cell.innerHTML = fisHtml(item); cell.title = hucreMetni(item, 'Fis'); }
                        else {
                            let valText = '';
                            
                            if (dateColumns.includes(colName)) {
                                valText = item[colName] ? new Date(item[colName]).toLocaleDateString('tr-TR') : '';
                                cell.classList.add("text-center"); 
                            } else if (numColumns.includes(colName)) {
                                valText = item[colName]?.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) ?? '';
                                cell.classList.add("text-end", "fw-bold"); 
                            } else {
                                valText = item[columnMappings[colName]] || '';
                            }

                            cell.textContent = valText;
                            if(valText) cell.title = valText;

                            if (colName === 'UygunlukDurumu') {
                                if (valText === 'Uygun') cell.classList.add("text-success", "fw-bold");
                                if (valText === 'Uygun Değil') cell.classList.add("text-danger");
                            }
                            if (colName === 'Aciklama') cell.classList.add("text-primary", "fw-bold");
                        }

                        row.appendChild(cell);
                    });
                    saveRowOriginalClass(row);

                    if (seciliSet.has(item.DocEntry)) {
                        const kutu = row.querySelector('.row-selector');
                        if (kutu) kutu.checked = true;
                        BOOTSTRAP_COLOR_CLASSES.forEach(c => row.classList.remove(c));
                        row.classList.add('selected-hover');
                    }

                    return row;
                };

                cizimVerisi = data;
                cizilenAdet = 0;

                sutunGenisliklerineUygula(data, colsToRender);
                sonrakiParcayiCiz();

                updatePaginationInfo(data.length);
                calculateSelectedTotal();
                updateSelectAllCheckboxState();

                adjustLayoutHeight();
            }

            // ---------------------------------------------------------------
            // Parça parça çizim: tablo bir kerede değil, kaydırdıkça dolar.
            // ---------------------------------------------------------------
            function sonrakiParcayiCiz() {
                if (!cizimSatirYapici || cizilenAdet >= cizimVerisi.length) return;

                const son = Math.min(cizilenAdet + PARCA_BOYUTU, cizimVerisi.length);
                const frag = document.createDocumentFragment();

                for (let i = cizilenAdet; i < son; i++) {
                    frag.appendChild(cizimSatirYapici(cizimVerisi[i]));
                }

                tableBody.appendChild(frag);
                cizilenAdet = son;
                cizimDurumunuGuncelle();
            }

            function cizimDurumunuGuncelle() {
                const bilgi = document.getElementById('cizimDurumu');
                if (!bilgi) return;
                bilgi.textContent = (cizilenAdet >= cizimVerisi.length)
                    ? ''
                    : cizilenAdet + ' / ' + cizimVerisi.length + ' satır';
            }

            window.filterTableAndRender = function() {
                const filters = {};
                $('.filter-select-bs').each(function () {
                    const selectElement = $(this);
                    const columnKey = selectElement.closest('th').data('column');
                    const selectedValues = selectElement.val();
                    if (selectedValues && selectedValues.length > 0) filters[columnKey] = selectedValues.map(v => (v || '').toLowerCase().trim());
                });

                const textFilters = {};
                $('.column-text-filter').each(function() {
                    const inputEl = $(this);
                    const columnKey = inputEl.closest('th').data('column');
                    const val = inputEl.val().toLowerCase().trim();
                    if(val) textFilters[columnKey] = val;
                });

                let filteredData = allReportData.filter(item => {
                    let isMatch = true;

                    for (const column in filters) {
                        const filterValues = filters[column];
                        const propName = columnMappings[column];
                        if (!propName) continue;

                        let itemValue = item[propName];
                        if (itemValue === null || itemValue === undefined) itemValue = '';
                        else if (propName.includes('Tarihi')) {
                            const date = new Date(itemValue);
                            itemValue = isNaN(date.getTime()) ? '' : date.toLocaleDateString('tr-TR');
                        } else if (typeof itemValue === 'number') {
                            itemValue = itemValue.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        } else itemValue = itemValue.toString();

                        itemValue = itemValue.toLowerCase().trim();
                        if (filterValues.length > 0 && !filterValues.includes(itemValue)) { isMatch = false; break; }
                    }

                    if (isMatch) {
                        for (const column in textFilters) {
                            const propName = columnMappings[column];
                            if (!propName) continue;
                            let itemValue = (item[propName] || '').toString().toLowerCase().trim();
                            if (!itemValue.includes(textFilters[column])) { isMatch = false; break; }
                        }
                    }

                    if (isMatch && activeYearFilter !== 'all') {
                        if (item.VadeTarihi) {
                            const itemDate = new Date(item.VadeTarihi);
                            if (itemDate.getFullYear().toString() !== activeYearFilter) isMatch = false;
                        } else isMatch = false;
                    }
                    return isMatch;
                });

                if (currentSortColumn && currentSortDirection !== 'none') {
                    const sortType = document.querySelector(`th[data-column="${currentSortColumn}"]`)?.dataset.sortType;
                    const propName = columnMappings[currentSortColumn];
                    filteredData.sort((itemA, itemB) => {
                        let valA = itemA[propName]; let valB = itemB[propName];
                        if (valA === null || valA === undefined) valA = '';
                        if (valB === null || valB === undefined) valB = '';

                        let comparison = 0;
                        if (sortType === 'number') {
                            const numA = parseFloat(valA.toString().replace(/\./g, '').replace(',', '.') || 0);
                            const numB = parseFloat(valB.toString().replace(/\./g, '').replace(',', '.') || 0);
                            comparison = numA - numB;
                        } else if (sortType === 'date') {
                            const dateA = valA ? new Date(valA) : null;
                            const dateB = valB ? new Date(valB) : null;
                            if (dateA === null && dateB === null) comparison = 0;
                            else if (dateA === null) comparison = 1;
                            else if (dateB === null) comparison = -1;
                            else comparison = dateA.getTime() - dateB.getTime();
                        } else comparison = (valA || '').localeCompare((valB || ''), 'tr', { sensitivity: 'base' });
                        
                        return currentSortDirection === 'asc' ? comparison : -comparison;
                    });
                }

                currentlyFilteredRows = filteredData;
                renderTable(currentlyFilteredRows);
                calculateSummaryCards();
            }

            // Her tuş vuruşunda binlerce satır yeniden çizilmesin
            let metinFiltreZamanlayici = null;
            $('.column-text-filter').on('input', function() {
                clearTimeout(metinFiltreZamanlayici);
                metinFiltreZamanlayici = setTimeout(function () { window.filterTableAndRender(); }, 250);
            });

            function initializePage() {
                $('.filter-select-bs').selectpicker('destroy').selectpicker({ 
                    liveSearch: true, 
                    selectedTextFormat: 'count > 2', 
                    width: '100%', 
                    container: 'body',
                    actionsBox: true,
                    selectAllText: 'Tümünü Seç',
                    deselectAllText: 'Temizle',
                    noneSelectedText: 'Tümü'
                }).off('changed.bs.select').on('changed.bs.select', function () { 
                    window.filterTableAndRender(); 
                });
                
                document.querySelectorAll('th.sortable-column').forEach(header => {
                    header.addEventListener('click', function () {
                        const columnKey = this.dataset.column;
                        if (currentSortColumn === columnKey) {
                            if (currentSortDirection === 'asc') currentSortDirection = 'desc';
                            else if (currentSortDirection === 'desc') { currentSortDirection = 'none'; currentSortColumn = null; } 
                            else currentSortDirection = 'asc';
                        } else {
                            if (currentSortColumn !== null) {
                                const prevHeader = document.querySelector(`th.sortable-column[data-column="${currentSortColumn}"] i`);
                                if (prevHeader) prevHeader.className = 'fas fa-sort text-muted ms-1';
                            }
                            currentSortColumn = columnKey;
                            currentSortDirection = 'asc';
                        }

                        document.querySelectorAll('th.sortable-column i').forEach(icon => icon.className = 'fas fa-sort text-muted ms-1');
                        const sortIcon = this.querySelector('i');
                        if (sortIcon && currentSortDirection !== 'none') sortIcon.className = `fas fa-sort-${currentSortDirection === 'asc' ? 'up' : 'down'} text-primary ms-1`;

                        window.filterTableAndRender();
                    });
                });

                // Yıl seçimi artık sunucuda: düğmeler sayfayı ?yil=... ile yeniden yükler.
                document.querySelectorAll('.year-filter-btn').forEach(btn => {
                    btn.addEventListener('click', function () {
                        this.classList.add('disabled');
                        this.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Yükleniyor';
                    });
                });
                
                window.filterTableAndRender();
            }

            // "Tümünü seç": çizilmiş satırları değil, filtrelenmiş TÜM kayıtları seçer
            selectAllCheckbox.addEventListener('change', function () {
                const isChecked = this.checked;

                cizimVerisi.forEach(function (item) {
                    if (isChecked) seciliSet.add(item.DocEntry);
                    else seciliSet.delete(item.DocEntry);
                });

                document.querySelectorAll('#rapor2Table tbody tr').forEach(function (row) {
                    const kutu = row.querySelector('.row-selector');
                    if (!kutu) return;
                    kutu.checked = isChecked;
                    satirVurgusunuGuncelle(row, isChecked);
                });

                calculateSelectedTotal();
            });

            tableBody.addEventListener('change', function (event) {
                if (!event.target.classList.contains('row-selector')) return;

                const row = event.target.closest('tr');
                const docEntry = parseInt(row.dataset.docentry);

                if (event.target.checked) seciliSet.add(docEntry);
                else seciliSet.delete(docEntry);

                satirVurgusunuGuncelle(row, event.target.checked);
                calculateSelectedTotal();
                updateSelectAllCheckboxState();
            });

            function satirVurgusunuGuncelle(row, seciliMi) {
                saveRowOriginalClass(row);
                if (seciliMi) {
                    BOOTSTRAP_COLOR_CLASSES.forEach(c => row.classList.remove(c));
                    row.classList.add('selected-hover');
                } else {
                    row.classList.remove('selected-hover');
                    const originalClass = ORIGINAL_ROW_CLASSES.get(row);
                    if (originalClass) row.classList.add(originalClass);
                }
            }

            function calculateSelectedTotal() {
                let totalAmount = 0, selectedCount = 0, weightedDateSum = 0, totalTimestampDiff = 0, validDateCount = 0;
                const baseTimestamp = new Date().setHours(0, 0, 0, 0);

                seciliSet.forEach(function (docEntry) {
                    const itemData = reportDataMap.get(docEntry);
                    if (!itemData) return;

                    const tlValue = parseFloat(itemData.TlKarsiligi);
                    if (isNaN(tlValue)) return;

                    totalAmount += tlValue;
                    selectedCount++;

                    if (itemData.VadeTarihi) {
                        const vadeTarihi = new Date(itemData.VadeTarihi);
                        if (!isNaN(vadeTarihi.getTime())) {
                            const diff = vadeTarihi.getTime() - baseTimestamp;
                            weightedDateSum += (tlValue * diff);
                            totalTimestampDiff += diff;
                            validDateCount++;
                        }
                    }
                });
                totalSelectedTlAmountSpan.textContent = totalAmount.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' TL';
                selectedCheckCountSpan.textContent = selectedCount;

                const adatSpan = document.getElementById('adatTarihi');
                const ortVadeSpan = document.getElementById('ortalamaVadeTarihi');

                if (adatSpan && ortVadeSpan) {
                    if (totalAmount > 0 && validDateCount > 0) {
                        const adatTimestamp = baseTimestamp + (weightedDateSum / totalAmount);
                        adatSpan.textContent = new Date(adatTimestamp).toLocaleDateString('tr-TR');
                        const ortTimestamp = baseTimestamp + (totalTimestampDiff / validDateCount);
                        ortVadeSpan.textContent = new Date(ortTimestamp).toLocaleDateString('tr-TR');
                    } else { adatSpan.textContent = '-'; ortVadeSpan.textContent = '-'; }
                }
            }

            // ---------------------------------------------------------------
            // ÇEK DETAYI
            // Ana tabloda yalnızca 8 sütun var; kalan bütün alanlar burada.
            // İşlem türü ve planlanan tedarikçi buradan da düzenlenebilir.
            // ---------------------------------------------------------------
            const DETAY_BOLUMLERI = [
                // Takip Paneli › Çek · Plan ↔ İbraz Kontrolü kartıyla aynı alanlar (tabloda sütun olmayan ayrıntılar burada)
                { baslik: 'Kasa Nakit Akışı Planı ↔ İbraz Kontrolü', alanlar: [
                    ['Kaynak', 'Satır Kaynağı'], ['KaynakDetay', 'Kaynak Ayrıntısı'], ['Kontrol', 'Plan ↔ İbraz Kontrolü'],
                    ['NakitAkis', 'Nakit Akış Satırı'], ['PlanlananTedarikci', 'Planlanan Tedarikçi'], ['Dolasim', 'Dolaşım Planı'],
                    ['DolasimSiradaki', 'Sıradaki Adım'], ['Fis', 'Muhasebe Fişi']
                ]},
                { baslik: 'Çek Bilgileri', alanlar: [
                    ['CekNumarasi', 'Çek No'], ['BelgeTipi', 'Belge Tipi'], ['BankaAdi', 'Banka'],
                    ['Sube', 'Şube'], ['ParaBirimi', 'Para Birimi'], ['Tutar', 'Tutar'],
                    ['TlKarsiligi', 'TL Karşılığı']
                ]},
                { baslik: 'Tarihler', alanlar: [
                    ['VadeTarihi', 'Vade Tarihi'], ['VadeAyiVeYili', 'Vade Ay / Yıl'],
                    ['PortfoyeGirisTarihi', 'Portföye Giriş'], ['PortfoyVadeAyiYili', 'Portföy Ay / Yıl'],
                    ['IbrazTarihi', 'İbraz Tarihi']
                ]},
                { baslik: 'Durum', alanlar: [
                    ['HareketDurumu', 'Hareket Durumu'], ['KonumDurumu', 'Konum'],
                    ['KullanimDurumu', 'Kullanım'], ['VadeDurumu', 'Vade Durumu'],
                    ['UygunlukDurumu', 'Uygunluk'], ['IslemTipiAdi', 'İşlem Tipi'],
                    ['Aciklama', 'Açıklama']
                ]},
                { baslik: 'Taraflar', alanlar: [
                    ['CekKimdenGeldi', 'Kimden Geldi'], ['AsilBorclu', 'Asıl Borçlu'],
                    ['CekKimeVerildi', 'Kime Verildi']
                ]},
                { baslik: 'Belgeler', alanlar: [
                    ['IbrazBelgeNo', 'İbraz Belge No'], ['TahsilatBelgeNo', 'Tahsilat Belge No'],
                    ['VadeliCekIbrazi', 'Vadeli Çek İbrazı']
                ]}
            ];

            function detaySatiri(etiket, deger) {
                const bos = (deger === null || deger === undefined || deger === '');
                const guvenli = $('<div>').text(bos ? '-' : deger).html();
                return '<div class="detay-satir"><div class="k">' + etiket + '</div><div class="v">' + guvenli + '</div></div>';
            }

            function cekDetayiniAc(docEntry) {
                const item = reportDataMap.get(docEntry);
                if (!item) { toastr.warning('Çek kaydı bulunamadı.'); return; }

                document.getElementById('cekDetayBaslik').innerHTML =
                    '<i class="fas fa-money-check-alt me-2"></i>Çek No: ' + ($('<div>').text(item.CekNumarasi || '-').html());

                let html = cekHizliIslemHtml(item);

                DETAY_BOLUMLERI.forEach(function (bolum) {
                    html += '<div class="detay-bolum-baslik">' + bolum.baslik + '</div><div class="detay-grid">';
                    bolum.alanlar.forEach(function (a) {
                        html += detaySatiri(a[1], hucreMetni(item, a[0]));
                    });
                    html += '</div>';
                    // dolaşım planı adımları (tür, eden → alan, durum, tarih, belge) — Takip Paneli çekmecesindeki adım listesiyle aynı
                    if (bolum.alanlar[0][0] === 'Kaynak' && (item.DolasimAdimlar || []).length) {
                        html += '<table class="ca-dol-tablo" data-dinamik="kapali"><thead><tr><th>Adım</th><th>Tür</th><th>Eden → Alan</th><th>Durum</th><th>Tarih</th><th>Belge</th></tr></thead><tbody>'
                            + item.DolasimAdimlar.map(a => '<tr><td>' + a.Sira + '</td><td>' + esc(a.Tur) + '</td><td>' + esc(a.Eden) + ' → <b>' + esc(a.Alan) + '</b></td><td>' + (a.Durum === 'Gerçekleşti' ? '<span class="ca-roz ok">Gerçekleşti</span>' : '<span class="ca-roz uyari">Planlandı</span>') + '</td><td>' + esc(a.Tarih) + '</td><td>' + esc(a.BelgeNo || '—') + '</td></tr>').join('')
                            + '</tbody></table>';
                    }
                });

                // Düzenlenebilir alanlar
                html += '<div class="detay-bolum-baslik">Düzenlenebilir Alanlar</div>';
                html += '<div class="row g-3">';
                html += '<div class="col-md-6"><label class="form-label fw-bold small">İşlem Türü</label>'
                     +  '<select id="detayIslemTuru" class="form-select form-select-sm"></select></div>';
                html += '<div class="col-md-6"><label class="form-label fw-bold small">Planlanan Tedarikçi</label>'
                     +  '<input type="text" id="detayTedarikci" class="form-control form-control-sm" list="detayTedarikciListesi">'
                     +  '<datalist id="detayTedarikciListesi"></datalist></div>';
                html += '</div>';

                const govde = document.getElementById('cekDetayGovde');
                govde.innerHTML = html;

                // --- İşlem türü açılır kutusu ---
                const secim = document.getElementById('detayIslemTuru');
                const bosSecenek = document.createElement('option');
                bosSecenek.value = ''; bosSecenek.textContent = 'Seçiniz';
                secim.appendChild(bosSecenek);

                checkTransactionTypesJs.forEach(function (type) {
                    if (type.Code !== "0" && type.Code !== "12") {
                        const o = document.createElement('option');
                        o.value = type.Code;
                        o.textContent = type.Description;
                        if (item.CekIslemTuru == type.Code) o.selected = true;
                        secim.appendChild(o);
                    }
                });

                secim.disabled = item.HareketDurumu === 'İade Edildi';
                secim.dataset.previousValue = item.CekIslemTuru || '';

                secim.addEventListener('change', async function () {
                    const newType = this.value;
                    const ibrazNo = item.IbrazBelgeNo;
                    const tahsilatNo = item.TahsilatBelgeNo;
                    let isSuccess = false;

                    if (ibrazNo && ibrazNo !== 'null' && ibrazNo !== '') isSuccess = await updateCheckTransactionTypeByIbrazBelge(ibrazNo, newType);
                    else if (tahsilatNo && tahsilatNo !== 'null' && tahsilatNo !== '') isSuccess = await updateCheckTransactionTypeByTahsilat(tahsilatNo, newType);
                    else { toastr.warning("Güncellenecek belge numarası bulunamadı."); this.value = this.dataset.previousValue; return; }

                    if (isSuccess) {
                        this.dataset.previousValue = newType;
                        item.CekIslemTuru = newType;
                        toastr.success("İşlem başarıyla güncellendi. Yeni hesaplamaların yansıması için sayfayı yenileyiniz.");
                    } else { this.value = this.dataset.previousValue; }
                });

                // --- Planlanan tedarikçi ---
                const tedarikci = document.getElementById('detayTedarikci');
                const liste = document.getElementById('detayTedarikciListesi');
                tedarikci.value = item.PlanlananTedarikci || '';
                tedarikci.dataset.previousValue = item.PlanlananTedarikci || '';

                tedarikci.addEventListener('input', async function () {
                    const metin = this.value.trim();
                    if (metin.length < 2) { liste.innerHTML = ''; return; }
                    try {
                        const cevap = await fetch(`/CekAkibeti/SearchSuppliers${dbQueryString}${dbQueryString ? '&' : '?'}term=${encodeURIComponent(metin)}`);
                        if (cevap.ok) {
                            const tedarikciler = await cevap.json();
                            liste.innerHTML = '';
                            tedarikciler.forEach(function (t) {
                                const o = document.createElement('option');
                                o.value = t;
                                liste.appendChild(o);
                            });
                        }
                    } catch (e) { console.error('Tedarikçi arama hatası:', e); }
                });

                tedarikci.addEventListener('focusout', async function () {
                    const yeni = this.value.trim();
                    if (yeni === this.dataset.previousValue) return;
                    const ok = await updatePlannedSupplier(item.DocEntry, yeni);
                    if (ok !== false) {
                        this.dataset.previousValue = yeni;
                        item.PlanlananTedarikci = yeni;
                    }
                });

                cekHizliIslemBagla(item);

                // Çek Ekstresi (Rapor60) ekranına, dönüş adresiyle birlikte git
                const ekstreDugmesi = document.getElementById('cekEkstresineGit');
                if (ekstreDugmesi) {
                    const p = new URLSearchParams();
                    p.set('checkNum', item.CekNumarasi || '');
                    const secili = new URLSearchParams(window.location.search).get('db');
                    if (secili) p.set('db', secili);
                    p.set('geri', window.location.pathname + window.location.search);
                    ekstreDugmesi.href = '/Rapor60?' + p.toString();
                }

                new bootstrap.Modal(document.getElementById('cekDetayModal')).show();
            }

            // Çek numarasına tıklama (parça parça çizim nedeniyle olay devri ile); Satır Kaynağı · İşlem düğmeleri belge detayındaki hızlı işlemleri açar; Fiş → muhasebe fişi; ibraz belge no → ibraz detayı
            tableBody.addEventListener('click', function (event) {
                const bag = event.target.closest('.cek-no-link, .cek-islem-btn, .cek-fis-ac, .detail-link[data-ibraz]');
                if (!bag) return;
                event.preventDefault(); event.stopPropagation();
                if (bag.classList.contains('cek-fis-ac')) { fisAc(parseInt(bag.dataset.docentry)); return; }
                if (bag.dataset.ibraz) { window.getIbrazDetay(bag.dataset.ibraz); return; }
