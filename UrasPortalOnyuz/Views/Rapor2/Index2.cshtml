                    const valueArray = valueString.split(',');
                    $('.filter-select-bs').selectpicker('val', '');
                    $('.filter-row input').val('');
                    $('#quickSearchInput').val('').trigger('input');

                    const $select = $(`.filter-row .filter-select-bs[data-key="${column}"]`);
                    if($select.length > 0) {
                        // listede olmayan değer (ör. bu yıl hiç Kapandı yok) seçeneğe eklenir ki süzgeç "tümü" yerine boş sonuç versin
                        let eklendi = false; valueArray.forEach(v => { if (!$select.find('option').filter((i, o) => o.value === v).length) { $select.append($('<option>').attr('value', v).text(v)); eklendi = true; } });
