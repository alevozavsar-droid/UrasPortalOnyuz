            async function updateCheckTransactionTypeByTahsilat(tahsilatBelgeNo, newType) {
                try {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    const response = await fetch(`/CekAkibeti/UpdateCheckTransactionTypeByTahsilat${dbQueryString}`, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify({ TahsilatBelgeNo: parseInt(tahsilatBelgeNo), NewCheckTransactionType: newType }) });
                    if (!response.ok) { toastr.error(`HTTP Hata: ${response.status}`); return false; }
                    const data = await response.json();
                    if (data.success) return true; else return false;
                } catch (error) { return false; }
            }

            async function updateCheckTransactionTypeByIbrazBelge(ibrazBelgeNo, newType) {
                try {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    const response = await fetch(`/CekAkibeti/UpdateCheckTransactionTypeByIbrazBelge${dbQueryString}`, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify({ IbrazBelgeNo: ibrazBelgeNo, NewCheckTransactionType: newType }) });
                    if (!response.ok) { toastr.error(`HTTP Hata: ${response.status}`); return false; }
                    const data = await response.json();
                    if (data.success) return true; else return false;
                } catch (error) { return false; }
            }

            async function updatePlannedSupplier(docEntry, newSupplier) {
                try {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    const response = await fetch(`/CekAkibeti/UpdatePlannedSupplier${dbQueryString}`, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify({ DocEntry: docEntry, NewPlannedSupplier: newSupplier }) });
                    if (!response.ok) return;
                    const data = await response.json();
                    if (data.success) {
                        toastr.success(data.message);
                        const itemToUpdate = reportDataMap.get(docEntry);
                        if (itemToUpdate) itemToUpdate.PlanlananTedarikci = newSupplier;
