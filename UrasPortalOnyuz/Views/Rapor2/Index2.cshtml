            function cekDetayiniAc(docEntry) {
                const item = reportDataMap.get(docEntry);
                if (!item) { toastr.warning('Çek kaydı bulunamadı.'); return; }

                document.getElementById('cekDetayBaslik').innerHTML =
                    '<i class="fas fa-money-check-alt me-2"></i>Çek No: ' + ($('<div>').text(item.CekNumarasi || '-').html());

                let html = cekHizliIslemHtml(item);

                DETAY_BOLUMLERI.forEach(function (bolum) {
                    html += '<div class="detay-bolum-baslik">' + bolum.baslik + '</div><div class="detay-grid">';
                    bolum.alanlar.forEach(function (a) {
                        html += detaySatiri(a[1], a[0] === 'HareketDurumu' ? (item.HareketDurumu || '') : hucreMetni(item, a[0]));
                    });
                    html += '</div>';
                    if (bolum.alanlar[0][0] === 'IslemTipiAdi') html += '<div class="it-not"><b>Otomatik kural:</b> Konum ve Hareket işlem türünden; Vade Durumu vade tarihinden (tahsil → Tahsil, iade / iptal → Kapandı); Uygunluk = Portföyde ya da Erteleme Yapıldı + konum Portföyde + Vade Bekleniyor + kullanılabilir. Vadesi bugün / geçmiş, planlı, bankada, tedarikçide, avukatta ve riskli evrak başka tedarikçiye verilemez.</div>';
                    // dolaşım bölümü: zincir görseli, adım tablosu (tür, eden → alan, durum, tarih, belge) ve Kasa Nakit Akışı bağlantıları — Takip Paneli çekmecesindeki adım listesiyle aynı
                    if (bolum.alanlar[0][0] === 'Dolasim') {
                        const L = item.DolasimAdimlar || []; const db = (ozetVeri && ozetVeri.db) || '';
