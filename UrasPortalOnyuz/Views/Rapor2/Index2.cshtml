            // ---------------------------------------------------------------
            // standart düzen ölçüleri: Satır Kaynağı · İşlem (206) kırpılmaz; iki satırlı hücreler en uzun veriye göre büyümez (alt satır "…", tam metin araç ipucunda)
            const SUTUN_ALT_SINIR = { 'Checkbox': 34, 'CekNumarasi': 150, 'VadeTarihi': 92, 'VadeDurumu': 100, 'UygunlukDurumu': 86, 'Tutar': 104, 'CekKimdenGeldi': 130, 'HareketDurumu': 110, 'CekIslemTuru': 150, 'CekKimeVerildi': 150, 'Kaynak': 206, 'PlanlananTedarikci': 130, 'KullanimDurumu': 92, 'PortfoyeGirisTarihi': 92, 'IbrazBelgeNo': 96, 'Dolasim': 190, 'NakitAkis': 124, 'Kontrol': 100, 'Fis': 90 };
            const SUTUN_UST_SINIR = 280;
            // genişliğe sığdırırken kolonların inebileceği en küçük genişlik (varsayılan görünür 14 kolonun toplamı ≈ 1230 px: 1600 px pencerede menü açıkken yatay kaydırma yok)
            // her sütunun en küçük / en büyük genişliği (px): içerik ölçülür, bu aralığa alınır; toplam kap genişliğinden küçükse artan boşluk orantılı dağıtılır, büyükse tablo yatay kaydırılır
            // [alt sınır (sığdırırken inilebilecek en dar), üst sınır]: alt sınırların toplamı ≈ 1270 px → 1600 px pencerede menü açıkken yatay kaydırma yok
            const SUTUN_SINIR = {
                'Checkbox': [26, 30], 'CekNumarasi': [112, 124], 'PortfoyeGirisTarihi': [78, 86], 'VadeTarihi': [84, 100], 'UygunlukDurumu': [82, 96], 'Tutar': [102, 118], 'CekKimdenGeldi': [94, 140],
                'HareketDurumu': [84, 100], 'CekIslemTuru': [112, 150], 'CekKimeVerildi': [92, 140], 'IbrazTarihi': [78, 86], 'IbrazBelgeNo': [106, 124], 'PlanlananTedarikci': [84, 130], 'Aciklama': [108, 230]
            };
            const SABIT_SUTUNLAR = ['Checkbox', 'CekNumarasi'];   // yatay kaydırma gerekirse solda sabit
            const HUCRE_DOLGUSU = 14;

            let olcumCtx = null, olcumFontNormal = '', olcumFontKalin = '';

            function metinGenisligi(metin, kalinMi) {
                if (!olcumCtx) {
                    olcumCtx = document.createElement('canvas').getContext('2d');
                    const stil = getComputedStyle(table);
                    olcumFontNormal = stil.fontSize + ' ' + stil.fontFamily;
                    olcumFontKalin = '700 ' + olcumFontNormal;
                }
                olcumCtx.font = kalinMi ? olcumFontKalin : olcumFontNormal;
                return olcumCtx.measureText(metin == null ? '' : String(metin)).width;
            }

            function hucreMetni(item, colName) {
                if (['VadeTarihi', 'PortfoyeGirisTarihi', 'IbrazTarihi'].includes(colName)) {
                    return item[colName] ? new Date(item[colName]).toLocaleDateString('tr-TR') : '';
                }
                if (['Tutar', 'TlKarsiligi'].includes(colName)) {
                    const v = item[colName];
                    return (v == null) ? '' : v.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }
                // Takip Paneli ile ortak sütunlar (ölçüm, detay penceresi ve Excel metni)
                if (colName === 'NakitAkis') return item.PlanDocEntry ? '#' + item.PlanDocEntry + ' · ' + (item.PlanDurum || '') + (item.PlanTalimat ? ' · talimat ' + item.PlanTalimat : item.CikisTalebi && item.PlanOnay !== 'Onaylandı' ? ' · GMY onayı bekliyor' : '') : item.NakitAkisDurum;
                if (colName === 'Dolasim') return item.Dolasim ? item.Dolasim + ' · ' + item.DolasimGerceklesen + '/' + item.DolasimToplam + ' adım' : '';
                if (colName === 'Fis') return item.FisNo ? item.FisNo + (item.FisKaynak ? ' · ' + item.FisKaynak : '') : '';
                if (colName === 'KaynakDetay') return item.KaynakDetay || '';
                if (colName === 'DolasimSiradaki') return item.DolasimSiradaki || '';
                if (colName === 'Aciklama') return item.Kaynak || '';   // ölçüm: üst satır (rozet + düğmeler); açıklama alt satırda "…" ile kırpılır, tamamı araç ipucunda
                if (colName === 'UygunlukNedeni') return item.UygunlukNedeniMetni || '';
                return item[columnMappings[colName]] || '';
            }
            // ---- standart durum parametreleri (Çek / Senet Durum Parametreleri Standart Raporu): rozetler ve istemci tarafı türetme (işlem türü değişiklik penceresi önizlemesi) ----
            const KONUM_SECENEKLERI = { 'Portföyde': ['Portföyde'], 'Planlandı': ['Portföyde'], 'Erteleme Yapıldı': ['Portföyde', 'Bankada', 'Tedarikçide'], 'Bankaya Tahsile Verildi': ['Bankada'], 'Bankadan Tahsil Edildi': ['Kapandı'], 'Elden Tahsil Edildi': ['Kapandı'], 'Ciro Edildi': ['Tedarikçide'], 'Teminata Verildi': ['Bankada'], 'Tahsil Riski': ['Portföyde', 'Bankada', 'Tedarikçide', 'Avukatta'], 'Konkordato Sürecinde': ['Portföyde', 'Bankada', 'Tedarikçide', 'Avukatta'], 'Karşılıksız': ['Portföyde', 'Bankada', 'Tedarikçide', 'Avukatta'], 'Protesto Edildi': ['Portföyde', 'Bankada', 'Tedarikçide', 'Avukatta'], 'İade Edildi': ['Kapandı'], 'İptal Edildi': ['Kapandı'] };
            function durumTuret(tur, konum, vadeTarihi, kullanim) {
                const sec = KONUM_SECENEKLERI[tur] || ['Portföyde']; konum = sec.length === 1 ? sec[0] : (sec.includes(konum) ? konum : sec[0]);
                const hareket = konum === 'Portföyde' ? 'Portföyde' : 'İşlem Yapıldı';
                let vade; if (tur === 'Bankadan Tahsil Edildi' || tur === 'Elden Tahsil Edildi') vade = 'Tahsil'; else if (tur === 'İade Edildi' || tur === 'İptal Edildi') vade = 'Kapandı';
                else { const g = Math.round((new Date(vadeTarihi).setHours(0, 0, 0, 0) - new Date().setHours(0, 0, 0, 0)) / 86400000); vade = g > 0 ? 'Vade Bekleniyor' : g === 0 ? 'Vadesi Bugün' : 'Vadesi Geçti'; }
                let neden = ''; if (tur === 'Planlandı') neden = 'Planlandı'; else if (tur !== 'Portföyde' && tur !== 'Erteleme Yapıldı') neden = tur; else if (konum !== 'Portföyde') neden = konum; else if (vade !== 'Vade Bekleniyor') neden = vade; else if ((kullanim || 'Kullanılabilir') !== 'Kullanılabilir') neden = 'Kullanım durumu ' + kullanim;
                return { konum, hareket, vade, uygunluk: neden ? 'Uygun Değil' : 'Uygun', neden };
            }
            const vadeDurumSinif = v => v === 'Vade Bekleniyor' ? 'bilgi' : v === 'Vadesi Bugün' ? 'uyari' : v === 'Vadesi Geçti' ? 'hata' : v === 'Tahsil' ? 'ok' : 'notr';
            const konumSinif = k => k === 'Portföyde' ? 'bilgi' : k === 'Bankada' ? 'mor' : k === 'Tedarikçide' ? 'uyari' : k === 'Avukatta' ? 'hata' : 'notr';
            const durumRozet = (metin, sinif, baslik) => '<span class="ca-durum ' + (sinif || '') + '" title="' + esc(baslik || metin) + '">' + esc(metin) + '</span>';
            const kullanimSinif = k => k === 'Kullanılabilir' ? 'ok' : k === 'Riskli' ? 'hata' : k === 'Bloke' ? 'notr' : 'uyari';

            // ---- Takip Paneli › Çek · Senet ile aynı hücre dili ----
            const esc = s => String(s === null || s === undefined ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            const altSatir = (s, sinif) => s ? '<span class="alt ' + (sinif || '') + '" title="' + esc(s) + '">' + esc(s) + '</span>' : '';
            const tarihTr = v => v ? new Date(v).toLocaleDateString('tr-TR') : '';
            const kynSinif = k => /^Kasa Nakit Akışı/.test(k) ? 'na' : /^Çek Akıbeti/.test(k) ? 'akibet' : /^Dolaşım/.test(k) ? 'dolasim' : 'diger';
            const kontrolHtml = item => { const k = item.Kontrol; return k === 'Uyumlu' ? '<span class="ca-kontrol uyumlu" title="Planlanan tedarikçiye çıktı">Uyumlu</span>' : k === 'Farklı' ? '<span class="ca-kontrol farkli" title="DİKKAT: plan ' + esc(item.PlanlananTedarikci) + ', çıkış ' + esc(item.CekKimeVerildi) + '">FARKLI</span>' : k === 'İbraz Bekliyor' ? '<span class="ca-kontrol bekliyor">İbraz Bekliyor</span>' : k === 'Plansız İbraz' ? '<span class="ca-kontrol plansiz">Plansız İbraz</span>' : '<span class="text-muted">—</span>'; };
            const dolasimHtml = item => {
                const L = item.DolasimAdimlar || []; if (!L.length) return '<span class="text-muted">—</span>';
                return '<div class="ca-dol" title="' + esc(item.Dolasim) + '">' + esc(L[0].Eden) + L.map(a => ' <i class="fas fa-arrow-right"></i> <span class="' + (a.Durum === 'Gerçekleşti' ? 'ok' : 'plan') + '">' + esc(a.Alan) + '</span>').join('') + '</div>'
                    + altSatir(item.DolasimGerceklesen + '/' + item.DolasimToplam + ' adım gerçekleşti' + (item.DolasimSiradaki ? ' · sıradaki: ' + item.DolasimSiradaki : ' · dolaşım tamamlandı'));
            };
            // satır kaynağı rozeti + yapılacak iş: portföyde → Nakit Akışa Ekle / İbraz Et, planlı → Tedarikçiye Çık (belge detayındaki hızlı işlemler), GMY onayı bekleyen, çıkmış belge → işlem gerekmez
            const kaynakHtml = item => {
                const k = item.Kaynak || ''; const b = (ad, ikon, sinif, baslik) => '<button type="button" class="btn btn-xs ' + sinif + ' cek-islem-btn" data-docentry="' + item.DocEntry + '" title="' + esc(baslik) + '">' + (ikon ? '<i class="fas ' + ikon + ' me-1"></i>' : '') + ad + '</button>';
                let is;
                if (item.SatirIslem === 'portfoy') is = b('Nakit Akışa Ekle', '', 'btn-primary', 'Kasa Nakit Akışı\'nda çek / senet satırı açılır, belge planlanır') + ' ' + b('İbraz Et', '', 'btn-outline-success', 'Plansız çıkış: GMY onayına düşer');
                else if (item.SatirIslem === 'ibraz') is = b('İbraz Et', '', 'btn-outline-success', 'Vadesi gelmiş / geçmiş belge başka tedarikçiye verilemez; bankaya ibraz ya da ciro (plansız çıkış GMY onayına düşer)') + ' <span class="text-muted">' + esc(item.UygunlukNedeni || '') + '</span>';
                else if (item.SatirIslem === 'planli') is = b('Tedarikçiye Çık', 'fa-share-from-square', 'btn-success', 'Plan satırı üzerinden ciro / ibraz: Kasa Nakit Akışı satırı ÖDENDİ, fiş atılır');
                else if (item.SatirIslem === 'gmy') is = '<span class="ca-roz uyari"><i class="fas fa-user-shield me-1"></i>GMY Onayı Bekliyor</span>';
                else is = 'işlem gerekmez';
                return '<span class="ca-kyn ' + kynSinif(k) + '" title="' + esc(item.KaynakDetay || '') + '">' + esc(k) + '</span><div class="ca-kyn-is">' + is + '</div>';
            };
            const nakitAkisHtml = item => item.PlanDocEntry
                ? '<a href="' + esc(item.PlanLink || '#') + '" target="_blank" class="ca-link" title="Kasa Nakit Akışı satırını aç">#' + item.PlanDocEntry + '</a> <span class="ca-roz ' + (item.PlanDurum === 'ÖDENDİ' ? 'ok' : item.PlanDurum === 'Gecikti' ? 'hata' : 'bilgi') + '">' + esc(item.PlanDurum || '') + '</span>' + altSatir(item.PlanTalimat ? 'talimat ' + item.PlanTalimat : item.CikisTalebi && item.PlanOnay !== 'Onaylandı' ? 'GMY onayı bekliyor' : '')
                : item.IslemTuru === 'Planlandı' ? '<span class="ca-roz hata">Satır Yok</span>' + altSatir('Çek Akıbeti\'nden planlı') : '<span class="text-muted">—</span>';
            const fisHtml = item => item.FisNo ? '<a href="#" class="ca-link cek-fis-ac" data-docentry="' + item.DocEntry + '" title="Muhasebe fişini aç">' + esc(item.FisNo) + '</a>' + altSatir(item.FisKaynak) : '<span class="text-muted">—</span>';
            // Çek Tutarı yalnızca para simgesiyle (₺ € $ £); kod ayrıca yazılmaz. Dövizli belgede alt satırda ₺ karşılığı görünür
            const PB_SIMGE = { 'TRY': '₺', 'TL': '₺', 'USD': '$', 'EUR': '€', 'GBP': '£', 'CHF': '₣', 'JPY': '¥' };
            const pbSimge = pb => PB_SIMGE[(pb || 'TRY').toUpperCase()] || (pb || '');
            const tl2 = v => v == null ? '' : Number(v).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const tutarHtml = item => { const pb = (item.ParaBirimi || 'TRY').toUpperCase(); const tl = pb === 'TRY' || pb === 'TL'; return '<span class="fw-bold">' + esc(tl2(item.Tutar)) + ' <span class="pb-simge" title="' + esc(pb) + '">' + esc(pbSimge(pb)) + '</span></span>' + altSatir(tl ? '' : '₺ ' + tl2(item.TlKarsiligi) + ' karşılığı'); };
            const ayYil = v => v ? new Date(v).toLocaleDateString('tr-TR', { month: 'long', year: 'numeric' }) : '';

            // Sütun genişlikleri: her sütun içeriğine göre ölçülür ve SUTUN_SINIR aralığına alınır. Toplam kaptan küçükse boşluk orantılı dağıtılır;
            // büyükse tablo toplam genişliğinde kalır ve yatay kaydırılır (sütun gizlenmez, daraltılmaz). İlk üç sütunun sabit "left" değeri burada hesaplanır.
            window.sabitSol = {};
            function sutunGenisliklerineUygula(data) {
                try {
                    let toplam = 0; const olculenler = [];
                    document.querySelectorAll('#rapor2Table thead .main-header-row th').forEach(function (th) {
                        const ad = th.dataset.column; const sinir = SUTUN_SINIR[ad] || [60, 200];
                        if (th.dataset.elleAyarlandi === '1') { olculenler.push({ th: th, ad: ad, genislik: th.offsetWidth || sinir[0], sabit: true }); toplam += th.offsetWidth || sinir[0]; return; }
                        let enGenis = Math.min(metinGenisligi((th.textContent || '').trim(), true) + 14, 110);   // başlık iki satıra sarılabilir
                        if (ad !== 'Checkbox') {
                            let enUzunMetin = '';
                            for (let i = 0; i < data.length; i++) { const m = hucreMetni(data[i], ad); if (m && m.length > enUzunMetin.length) enUzunMetin = m; }
                            const g = metinGenisligi(enUzunMetin, false); if (g > enGenis) enGenis = g;
                        }
                        const genislik = Math.min(sinir[1], Math.max(sinir[0], Math.ceil(enGenis) + HUCRE_DOLGUSU));
                        olculenler.push({ th: th, ad: ad, genislik: genislik }); toplam += genislik;
                    });
                    const kullanilabilir = table.parentElement ? table.parentElement.clientWidth - olculenler.length - 4 : 0;
                    // sığmıyorsa sütunlar alt sınırlarına kadar orantılı daraltılır (kırpılan metin "…", tamamı araç ipucunda); alt sınırlar da sığmazsa yatay kaydırma kalır
                    if (kullanilabilir > 40 && toplam > kullanilabilir) {
                        const kisilabilir = olculenler.reduce(function (t, x) { return t + (x.sabit ? 0 : Math.max(0, x.genislik - (SUTUN_SINIR[x.ad] || [60])[0])); }, 0);
                        const oran = kisilabilir > 0 ? Math.min(1, (toplam - kullanilabilir) / kisilabilir) : 0;
                        olculenler.forEach(function (x) { if (x.sabit) return; const kis = Math.ceil(Math.max(0, x.genislik - (SUTUN_SINIR[x.ad] || [60])[0]) * oran); x.genislik -= kis; toplam -= kis; });
                    }
                    if (kullanilabilir > 40 && toplam < kullanilabilir) {
                        const oran = kullanilabilir / toplam; let dagitilan = 0;
                        olculenler.forEach(function (x) { if (x.sabit || x.ad === 'Checkbox') return; const yeni = Math.floor(x.genislik * oran); dagitilan += yeni - x.genislik; x.genislik = yeni; });
                        toplam += dagitilan;
                    }
                    olculenler.forEach(function (x) { if (!x.sabit) x.th.style.width = x.genislik + 'px'; });
                    table.style.minWidth = toplam + 'px';
                    // sabit sütunların sol konumu
                    let sol = 0; const son = SABIT_SUTUNLAR[SABIT_SUTUNLAR.length - 1];
                    olculenler.forEach(function (x) { if (!SABIT_SUTUNLAR.includes(x.ad)) return; window.sabitSol[x.ad] = sol; sol += x.genislik + 1; });
                    document.querySelectorAll('#rapor2Table thead th.sabit, #rapor2Table tbody td.sabit').forEach(function (h) { h.style.left = (window.sabitSol[h.dataset.column] || 0) + 'px'; h.classList.toggle('sabit-son', h.dataset.column === son); });
                } catch (e) { table.style.minWidth = ''; }
            }

            function updateSelectAllCheckboxState() {
                if (!selectAllCheckbox) return;

                const toplam = cizimVerisi.length;
                let secili = 0;
                cizimVerisi.forEach(function (item) { if (seciliSet.has(item.DocEntry)) secili++; });

                selectAllCheckbox.checked = (toplam > 0 && secili === toplam);
                selectAllCheckbox.indeterminate = (secili > 0 && secili < toplam);
            }

            function saveRowOriginalClass(row) {
                if (ORIGINAL_ROW_CLASSES.has(row)) return;
                let originalClass = '';
                row.classList.forEach(className => { if (BOOTSTRAP_COLOR_CLASSES.includes(className)) originalClass = className; });
                ORIGINAL_ROW_CLASSES.set(row, originalClass);
            }

