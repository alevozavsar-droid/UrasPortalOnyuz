                        else if (colName === 'Tutar') { cell.classList.add('text-end'); cell.innerHTML = tutarHtml(item); cell.title = tl2(item.Tutar) + ' ' + (item.ParaBirimi || 'TRY') + ' · TL karşılığı ' + tl2(item.TlKarsiligi) + ' ₺'; }
                        else if (colName === 'Aciklama') {
                            // Açıklama / İşlem Tipi: satır kaynağı rozeti + yapılacak iş (Nakit Akışa Ekle / İbraz Et / Tedarikçiye Çık …) ve altında açıklama
                            cell.innerHTML = kaynakHtml(item) + altSatir(item.Aciklama || '');
                            cell.title = hucreMetni(item, 'Aciklama') + (item.KaynakDetay ? ' · ' + item.KaynakDetay : '');
                        }
                        else {
                            let valText = '';
                            
                            if (dateColumns.includes(colName)) {
                                valText = item[colName] ? new Date(item[colName]).toLocaleDateString('tr-TR') : '';
                                cell.classList.add("text-center"); 
                            } else if (numColumns.includes(colName)) {
                                valText = item[colName]?.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) ?? '';
                                cell.classList.add("text-end", "fw-bold"); 
                            } else {
                                valText = item[columnMappings[colName]] || '';
                            }

                            cell.textContent = valText;
