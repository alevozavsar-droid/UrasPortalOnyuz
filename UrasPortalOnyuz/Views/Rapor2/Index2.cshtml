                        }
                        else if (colName === 'CekKimdenGeldi') {
                            cell.innerHTML = esc(item.CekKimdenGeldi || '') + altSatir(item.AsilBorclu ? 'Asıl Borçlu: ' + item.AsilBorclu : '');
                            cell.title = (item.CekKimdenGeldi || '') + (item.AsilBorclu ? ' · Asıl Borçlu: ' + item.AsilBorclu : '');
