            function cekOzetCiz() {
                const V = ozetVeri, P = V.portfoy, n = V.nakitAkis;
                const vadesiGecen = V.planli.filter(x => x.vadeGun < 0).length;
                const R = [
                    { grup: 'Portföy (' + V.sirket + ')' },
                    { k: '#1d4ed8', l: 'Çek X · Çek R', s: 'kullanılabilir ' + P.cekX.kullanilabilir + ' / ' + P.cekR.kullanilabilir + ' · planlı ' + P.cekX.planli + ' / ' + P.cekR.planli, n: P.cekX.adet + ' · ' + P.cekR.adet, t: P.cekX.tutar + P.cekR.tutar, f: { column: 'HareketDurumu', value: 'Portföyde' } },
                    { k: '#7c3aed', l: 'Senet X · Senet R', s: 'kullanılabilir ' + P.senetX.kullanilabilir + ' / ' + P.senetR.kullanilabilir + ' · planlı ' + P.senetX.planli + ' / ' + P.senetR.planli, n: P.senetX.adet + ' · ' + P.senetR.adet, t: P.senetX.tutar + P.senetR.tutar, f: { column: 'HareketDurumu', value: 'Portföyde' } },
                    { grup: 'Kasa Nakit Akışı Planı' },
                    { k: '#b45309', l: 'Planlı Belge (Planlandı)', s: 'vadesi 7 gün içinde ' + V.vadesiGelen + (vadesiGecen ? ' · vadesi geçen ' + vadesiGecen : '') + ' · sağdaki listede "Tedarikçiye Çık"', n: V.planli.length, t: V.planliToplam, f: { column: 'CekIslemTuru', value: '2' } },
                    { k: '#0369a1', l: 'Nakit Akışta Çek / Senet Satırı', s: 'ödenmemiş ' + n.planliSatir + ' satır · belge seçilmemiş ' + n.belgesiz + ' · açık çek talimatı ' + n.acikTalimat, n: n.planliSatir, t: null, link: n.link, linkAd: 'Kasa Nakit Akışı › Çek' },
                    { k: '#9d174d', l: 'GMY Onayı Bekleyen Plansız Çıkış', s: 'Çek Akıbeti\'nden planlanmamış belge çıkışı talebi; onaylanınca çıkış işlenir', n: V.gmy.length, t: V.gmy.reduce((s, x) => s + x.tutar, 0), link: n.link, linkAd: 'Kasa Nakit Akışı' },
                    { grup: 'Kontrol' },
                    { k: '#dc2626', l: 'Plana Aykırı Çıkış', s: 'Kasa Nakit Akışı planı ≠ ibraz / ciro yeri · Takip Paneli › Çek', n: V.farkli.length, t: V.farkli.reduce((s, x) => s + x.tutar, 0), link: V.takipPaneli, linkAd: 'Takip Paneli' },
                    { k: '#15803d', l: 'Bankada Tahsilde', s: 'bu hafta vadesi gelen ' + V.bankada.buHafta, n: V.bankada.adet, t: V.bankada.tutar, f: { column: 'CekIslemTuru', value: '5' } }
                ];
                document.querySelector('#cekOzetDurum tbody').innerHTML = R.map(r => r.grup ? '<tr class="grup"><td colspan="4">' + h(r.grup) + '</td></tr>' : '<tr class="' + (r.f ? 'tik' : '') + '" style="--k:' + r.k + '" ' + (r.f ? 'data-column="' + r.f.column + '" data-value="' + r.f.value + '" title="Tabloyu süz"' : '') + '><td class="gost">' + h(r.l) + '<small>' + h(r.s) + '</small></td><td class="s adet ' + (!r.n || r.n === 0 ? 'sifir' : '') + '">' + h(String(r.n)) + '</td><td class="s">' + (r.t == null ? '' : kisa(r.t)) + '</td><td>' + (r.link ? '<a href="' + h(r.link) + '" target="_blank" class="fw-bold">' + h(r.linkAd) + ' <i class="fas fa-arrow-up-right-from-square" style="font-size:.5rem"></i></a>' : r.f ? '<span class="text-muted">tıkla: tabloyu süz</span>' : '') + '</td></tr>').join('');
                document.getElementById('cekOzetNot').textContent = V.bugun + ' · ' + V.sirket;
                const dikkat = V.vadesiGelen + V.gmy.length + V.farkli.length + n.belgesiz; document.getElementById('cekOzetSayi').textContent = dikkat;
                document.querySelector('#cekOzetPlanli tbody').innerHTML = V.planli.length ? V.planli.map(p => '<tr class="' + (p.vadeGun < 0 ? 'gecti' : p.vadeGun <= 7 ? 'vade' : '') + '"><td><a href="#" class="cek-no-link fw-bold" data-docentry="' + p.docEntry + '">' + h(p.no) + '</a><small>' + h(p.musteri + ' · ' + p.belge + ' ' + p.tip + ' · ' + p.banka) + '</small></td><td>' + h(p.vade) + '<small>' + (p.vadeGun < 0 ? '<span class="text-danger">' + (-p.vadeGun) + ' gün geçti</span>' : p.vadeGun === 0 ? 'bugün' : p.vadeGun + ' gün') + '</small></td><td class="s fw-bold">' + tl(p.tutar) + '</td><td>' + h(p.planlananTedarikci || '—') + '<small>' + h((p.planlayan || '') + ' ' + (p.planlamaTarihi || '')) + '</small></td><td>' + planHucre(p) + '</td><td>' + kontrolRoz(p.kontrol) + (p.dolasim ? '<small>' + h(p.dolasim) + '</small>' : '') + '</td><td class="text-nowrap">' + (p.cikisTalebi && p.planOnay !== 'Onaylandı' ? roz('GMY Onayı', 'uyari') : '<button type="button" class="btn btn-success btn-xs cek-cik-btn" data-docentry="' + p.docEntry + '" title="Planlanan tedarikçiye ciro et: Kasa Nakit Akışı satırı ÖDENDİ, muhasebe fişi, akıbet Ciro Edildi"><i class="fas fa-share-from-square me-1"></i>Tedarikçiye Çık</button>') + '</td></tr>').join('') : '<tr><td colspan="7" class="text-center text-muted py-2">Planlı belge yok. Portföydeki belgeyi detay penceresinden "Nakit Akışa Gönder" ile planlayabilirsiniz.</td></tr>';
                document.getElementById('cekOzetPlanNot').textContent = V.planli.length + ' belge · ' + kisa(V.planliToplam) + ' TL · vadesi 7 gün içinde ' + V.vadesiGelen;
                document.querySelector('#cekOzetGmy tbody').innerHTML = V.gmy.length ? V.gmy.map(g => '<tr><td class="fw-bold">' + h(g.cekNolar) + '</td><td>' + h(g.cikisTalebi) + (g.ibrazYeri ? '<small>→ ' + h(g.ibrazYeri) + '</small>' : '') + '</td><td class="s">' + tl(g.tutar) + '</td><td>' + h(g.talepEden) + '<small>' + h(g.tarih) + '</small></td><td><a href="' + h(g.link) + '" target="_blank" title="Kasa Nakit Akışı #' + g.docEntry + ' (GMY onayı)"><i class="fas fa-arrow-up-right-from-square"></i></a></td></tr>').join('') : '<tr><td colspan="5" class="text-center text-muted py-2">Bekleyen talep yok.</td></tr>';
                document.querySelector('#cekOzetFarkli tbody').innerHTML = V.farkli.length ? V.farkli.map(p => '<tr><td><a href="#" class="cek-no-link fw-bold" data-docentry="' + p.docEntry + '">' + h(p.no) + '</a></td><td>' + h(p.planlananTedarikci) + '</td><td class="text-danger fw-bold">' + h(p.ibrazYeri) + '<small>' + h(p.ibrazTuru) + '</small></td><td class="s">' + tl(p.tutar) + '</td><td>' + h(p.ibrazTarihi || '') + '</td></tr>').join('') : '<tr><td colspan="5" class="text-center text-success py-2"><i class="fas fa-check me-1"></i>Plana aykırı çıkış yok.</td></tr>';
                document.querySelector('#cekOzetGunluk tbody').innerHTML = V.gunluk.length ? V.gunluk.map(g => '<tr><td class="text-nowrap">' + h(g.tarih) + '</td><td class="fw-bold">' + h(g.no) + '</td><td>' + roz(g.islem, /Planlandı|Ciro|Tahsil/.test(g.islem) ? 'bilgi' : /Kaldır|İptal/.test(g.islem) ? 'hata' : 'notr') + '</td><td class="wrap"><small style="display:inline">' + h(g.aciklama) + '</small><small>' + h(g.kullanici) + '</small></td></tr>').join('') : '<tr><td colspan="4" class="text-center text-muted py-2">Kayıt yok.</td></tr>';
                document.getElementById('cekOzetSenkron').innerHTML = '<a href="' + h(n.link) + '" target="_blank">Kasa Nakit Akışı</a> · <a href="' + h(V.takipPaneli) + '" target="_blank">Takip Paneli</a>';
            }
            document.getElementById('cekOzetBtn').addEventListener('click', function () {
                const acik = ozetPanel.classList.toggle('d-none') === false; this.classList.toggle('btn-primary', !acik); this.classList.toggle('btn-outline-primary', acik);
                try { localStorage.setItem('cekAkibetiOzetAcik', acik ? '1' : '0'); } catch (e) { }
                if (acik && !ozetVeri) cekOzetYukle(); adjustLayoutHeight();
            });
            // gösterge satırı → hızlı süzgeç (üstteki kartlarla aynı mekanizma)
            document.getElementById('cekOzetDurum').addEventListener('click', function (e) {
                const tr = e.target.closest('tr.tik'); if (!tr) return;
                const kart = document.querySelector('.quick-filter-card[data-column="' + tr.dataset.column + '"][data-value="' + tr.dataset.value + '"]');
                if (kart) kart.click(); else toastr.info('Süzgeç: ' + tr.dataset.column + ' = ' + tr.dataset.value);
            });
            ozetPanel.addEventListener('click', function (e) {
                const bag = e.target.closest('.cek-no-link'); if (bag) { e.preventDefault(); cekDetayiniAc(parseInt(bag.dataset.docentry)); return; }
                const b = e.target.closest('.cek-cik-btn'); if (!b) return;
                const p = (ozetVeri.planli || []).find(x => x.docEntry === parseInt(b.dataset.docentry)); if (!p) return;
                if (!confirm(p.no + ' · ' + tl(p.tutar) + ' TL planlanan tedarikçiye (' + (p.planlananTedarikci || '—') + ') ciro edilsin mi? Kasa Nakit Akışı satırı ÖDENDİ olur, muhasebe fişi atılır.')) return;
                cekCikisYap(p.docEntry, 'Tedarikçiye Ciro', p.planlananTedarikci, '', '');
            });
            async function cekGonder(docEntry, tedarikci, tarih, belgeTipi, belgeNo, urun) {
                const token = $('input[name="__RequestVerificationToken"]').val();
                try {
                    const r = await fetch('/CekAkibeti/NakitAkisaGonder' + dbQueryString, { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }, body: JSON.stringify({ DocEntry: docEntry, Tedarikci: tedarikci, PlanlananTarih: tarih, BelgeTipi: belgeTipi, BelgeNo: belgeNo, UrunHizmet: urun }) });
                    const d = await r.json(); if (!d.success) { toastr.error(d.message || 'Gönderilemedi.'); return false; }
                    toastr.success(d.message + (d.satir ? ' <a href="' + d.satir.link + '" target="_blank" class="fw-bold">Kasa Nakit Akışı\'nda aç</a>' : ''), 'Nakit Akışa Gönderildi', { timeOut: 9000, escapeHtml: false }); setTimeout(() => location.reload(), 1800); return true;
                } catch (e) { toastr.error('Ağ hatası.'); return false; }
            }
            async function cekCikisYap(docEntry, tur, yer, belgeNo, not) {
                const token = $('input[name="__RequestVerificationToken"]').val();
                try {
                    const r = await fetch('/CekAkibeti/TedarikciyeCik' + dbQueryString, { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }, body: JSON.stringify({ DocEntry: docEntry, Tur: tur, IbrazYeri: yer, BelgeNo: belgeNo, Not: not }) });
                    const d = await r.json();
                    if (d.onayaDustu) { toastr.warning(d.message, 'GMY onayı', { timeOut: 12000 }); setTimeout(() => location.reload(), 2500); return false; }
                    if (!d.success) { toastr.error(d.message || 'Çıkış yapılamadı.', '', { timeOut: 10000 }); return false; }
                    toastr.success(d.message + (d.satir ? ' <a href="' + d.satir.link + '" target="_blank" class="fw-bold">Kasa Nakit Akışı\'nda aç</a>' : ''), 'Çıkış işlendi', { timeOut: 9000, escapeHtml: false }); setTimeout(() => location.reload(), 1800); return true;
                } catch (e) { toastr.error('Ağ hatası.'); return false; }
            }
            // detay penceresi: hızlı işlemler (portföyde → Nakit Akışa Gönder; planlı → Tedarikçiye Çık; plan satırı / Takip Paneli bağlantıları)
            window.cekHizliIslemHtml = function (item) {
                const p = (ozetVeri && ozetVeri.planlar && ozetVeri.planlar[String(item.DocEntry)]) || null;
                const portfoyde = p ? p.portfoyde : item.HareketDurumu === 'Portföyde', secilebilir = p ? p.secilebilir : (item.HareketDurumu === 'Portföyde' && item.CekIslemTuru == '1' && item.UygunlukDurumu === 'Uygun');
                const planli = p ? p.islemTuru === 'Planlandı' : item.CekIslemTuru == '2', gmy = p && p.cikisTalebi && p.planOnay !== 'Onaylandı';
                const ted = (ozetVeri && ozetVeri.tedarikciler) || [];
                const dl = '<datalist id="hzTedarikciler">' + ted.map(t => '<option value="' + h(t) + '">').join('') + '</datalist>';
                let html = '<div class="detay-bolum-baslik">Hızlı İşlemler · Kasa Nakit Akışı Senkronu</div><div class="cek-hizli">' + dl;
                if (secilebilir) html += '<div style="min-width:220px"><label>Ödenecek Tedarikçi</label><input id="hzTedarikci" class="form-control" list="hzTedarikciler" placeholder="tedarikçi adı" value="' + h(item.PlanlananTedarikci || '') + '"></div><div><label>Planlanan Tarih</label><input id="hzTarih" type="date" class="form-control" value="' + h(item.VadeTarihi || '') + '"></div><div><label>Belge Tipi</label><select id="hzBelgeTipi" class="form-select"><option>Cari Bakiye</option><option>Fatura</option><option>Sipariş</option><option>Diğer</option></select></div><div><label>Belge No</label><input id="hzBelgeNo" class="form-control" placeholder="FT-…"></div><div><button type="button" class="btn btn-primary btn-sm" id="hzGonder"><i class="fas fa-paper-plane me-1"></i>Nakit Akışa Gönder</button></div>';
                if (portfoyde && !gmy) html += '<div><label>Çıkış Türü</label><select id="hzTur" class="form-select"><option value="Tedarikçiye Ciro">Tedarikçiye Ciro</option><option value="Bankaya Tahsile Ver">Bankaya Tahsile Ver</option></select></div><div style="min-width:200px"><label>Ciro Edilen Tedarikçi / Banka</label><input id="hzYer" class="form-control" list="hzTedarikciler" value="' + h(item.PlanlananTedarikci || '') + '"></div><div><button type="button" class="btn btn-success btn-sm" id="hzCik"><i class="fas fa-share-from-square me-1"></i>' + (planli ? 'Tedarikçiye Çık · İbraz Et' : 'Çıkış Talebi (GMY Onayı)') + '</button></div>';
                if (p && p.planDocEntry) html += '<div><a class="btn btn-light border btn-sm" href="' + h(p.planLink || '#') + '" target="_blank"><i class="fas fa-money-bill-transfer me-1"></i>Kasa Nakit Akışı #' + p.planDocEntry + ' (' + h(p.planDurum || '') + (p.planTalimat ? ' · ' + h(p.planTalimat) : '') + ')</a></div>';
                html += '<div><a class="btn btn-light border btn-sm" href="' + h((ozetVeri && ozetVeri.takipPaneli) || '/Rapor123?sekme=cek') + '" target="_blank"><i class="fas fa-clipboard-check me-1"></i>Takip Paneli</a></div>';
                html += '<div class="not">' + (gmy ? '<i class="fas fa-user-shield me-1 text-danger"></i>Plansız çıkış talebi GMY onayı bekliyor (Kasa Nakit Akışı #' + p.planDocEntry + ').' : planli ? '<i class="fas fa-check me-1 text-success"></i>Belge Kasa Nakit Akışı\'nda planlı: çıkış plan satırı üzerinden işlenir (satır ÖDENDİ, fiş atılır, Takip Paneli güncellenir).' : secilebilir ? '<i class="fas fa-info-circle me-1"></i>Portföyde: "Nakit Akışa Gönder" ile ödeme satırı açılır ve belge planlanır; plansız çıkış GMY onayına düşer.' : '<i class="fas fa-info-circle me-1"></i>' + h(item.IslemTipiAdi || '') + (item.CekKimeVerildi ? ' → ' + h(item.CekKimeVerildi) : '') + ' · bu belge için hızlı işlem yok.') + '</div></div>';
                return html;
            };
            window.cekHizliIslemBagla = function (item) {
                const g = document.getElementById('hzGonder'); if (g) g.addEventListener('click', async function () { const t = document.getElementById('hzTedarikci').value.trim(); if (!t) { toastr.warning('Tedarikçi girin.'); return; } g.disabled = true; const ok = await cekGonder(item.DocEntry, t, document.getElementById('hzTarih').value, document.getElementById('hzBelgeTipi').value, document.getElementById('hzBelgeNo').value, ''); if (!ok) g.disabled = false; });
                const c = document.getElementById('hzCik'); if (c) c.addEventListener('click', async function () { const tur = document.getElementById('hzTur').value, yer = document.getElementById('hzYer').value.trim(); if (tur === 'Tedarikçiye Ciro' && !yer) { toastr.warning('Tedarikçi girin.'); return; } if (!confirm(item.CekNumarasi + ' ' + (tur === 'Bankaya Tahsile Ver' ? 'bankaya tahsile verilsin' : 'tedarikçiye ciro edilsin') + ' mi? → ' + yer)) return; c.disabled = true; const ok = await cekCikisYap(item.DocEntry, tur, yer, '', ''); if (!ok) c.disabled = false; });
            };
            // özet verisi her açılışta yüklenir (detay penceresindeki hızlı işlemler plan bilgisini kullanır); panel son durumunu hatırlar
            cekOzetYukle(true).then(() => { let acik = false; try { acik = localStorage.getItem('cekAkibetiOzetAcik') === '1'; } catch (e) { } if (acik) document.getElementById('cekOzetBtn').click(); });

            // Kasa Nakit Akışı'nda çek planlanınca / ibraz edilince bu sekmeye dönüldüğünde liste kendini tazeler (planlanan tedarikçi, Planlandı, kime verildi, uygunluk):
            // /CekAkibeti/Versiyon değişim sayacı sayfa açılışındakinden farklıysa yeniden yüklenir.
            (function () {
                const q = typeof dbQueryString === 'string' ? dbQueryString : '';
                let surum = null; const oku = () => fetch('/CekAkibeti/Versiyon' + q).then(r => r.json()).catch(() => null);
                oku().then(v => { if (v) surum = v.v; });
                document.addEventListener('visibilitychange', async () => { if (document.visibilityState !== 'visible' || surum === null) return; const v = await oku(); if (v && v.v !== surum) location.reload(); });
                window.addEventListener('focus', async () => { if (surum === null) return; const v = await oku(); if (v && v.v !== surum) location.reload(); });
            })();
        });
    </script>
}