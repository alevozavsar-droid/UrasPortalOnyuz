            async function updateCheckTransactionTypeByTahsilat(tahsilatBelgeNo, newType) {
                try {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    const response = await fetch(`/CekAkibeti/UpdateCheckTransactionTypeByTahsilat${dbQueryString}`, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify({ TahsilatBelgeNo: parseInt(tahsilatBelgeNo), NewCheckTransactionType: newType }) });
                    if (!response.ok) { toastr.error(`HTTP Hata: ${response.status}`); return false; }
                    const data = await response.json();
                    if (data.onayaDustu) { toastr.warning(data.message, 'GMY onayı', { timeOut: 12000 }); return false; }   // plansız çıkış: işlenmedi, Kasa Nakit Akışı'na onaya düştü
                    if (data.success) return true; else { if (data.message) toastr.error(data.message); return false; }
                } catch (error) { return false; }
            }

            async function updateCheckTransactionTypeByIbrazBelge(ibrazBelgeNo, newType) {
                try {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    const response = await fetch(`/CekAkibeti/UpdateCheckTransactionTypeByIbrazBelge${dbQueryString}`, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify({ IbrazBelgeNo: ibrazBelgeNo, NewCheckTransactionType: newType }) });
                    if (!response.ok) { toastr.error(`HTTP Hata: ${response.status}`); return false; }
                    const data = await response.json();
                    if (data.onayaDustu) { toastr.warning(data.message, 'GMY onayı', { timeOut: 12000 }); return false; }
                    if (data.success) return true; else { if (data.message) toastr.error(data.message); return false; }
                } catch (error) { return false; }
            }

            // İşlem türü (+ konum, ibraz yeri, belge no) kayıt numarasıyla güncellenir (Data/CekAkibetOrnek.cs; Kasa Nakit Akışı planıyla ortak kayıt). Başarıda sunucunun döndürdüğü güncel satır tabloya konur.
            async function updateCheckTransactionTypeByDocEntry(docEntry, newType, konum, ibrazYeri, ibrazBelgeNo) {
                try {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    const response = await fetch(`/CekAkibeti/UpdateCheckTransactionTypeByDocEntry${dbQueryString}`, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify({ DocEntry: parseInt(docEntry), NewCheckTransactionType: newType, Konum: konum || '', IbrazYeri: ibrazYeri || '', IbrazBelgeNo: ibrazBelgeNo || '' }) });
                    if (!response.ok) { toastr.error(`HTTP Hata: ${response.status}`); return false; }
                    const data = await response.json();
                    // Kasa Nakit Akışı'nda planlanmamış çek: çıkış işlenmez, GMY onayına düşer (belge Planlandı olur; satır tazelenir)
                    if (data.onayaDustu) { toastr.warning(data.message, 'GMY onayı', { timeOut: 12000 }); if (data.satirJson) satiriGuncelle(JSON.parse(data.satirJson)); cekOzetYukle(true); return false; }
                    if (data.success) { if (data.message && data.message.indexOf('DİKKAT') >= 0) toastr.warning(data.message, '', { timeOut: 10000 }); else toastr.success(data.message || 'Güncellendi.'); if (data.satirJson) satiriGuncelle(JSON.parse(data.satirJson)); cekOzetYukle(true); return true; }
                    toastr.error(data.message || 'Güncellenemedi.'); return false;
                } catch (error) { return false; }
            }

            // ---------------------------------------------------------------
            // İŞLEM TÜRÜ DEĞİŞİKLİĞİ · STANDART AKIŞ PENCERESİ
            // Tür seçilir → konumu türden tek başına çıkmayan türlerde konum seçilir → konuma göre ibraz / ciro yeri ve belge no →
            // hareket, konum, vade durumu ve uygunluk anında önizlenir (sunucu aynı kuralla hesaplar) → Uygula.
            // ---------------------------------------------------------------
            const itModalEl = document.getElementById('islemTuruModal'); let itBaglam = null;
            const itTur = document.getElementById('itTur'), itKonum = document.getElementById('itKonum'), itYer = document.getElementById('itYer'), itNo = document.getElementById('itNo');
            function islemTuruDegistirAkisi(item, yeniKod, selectEl, sonra) {
                const tur = checkTransactionTypesJs.find(t => t.Code == yeniKod); if (!tur) { if (selectEl) selectEl.value = selectEl.dataset.previousValue || item.CekIslemTuru; return; }
                itBaglam = { item, selectEl, sonra, uygulandi: false };
                document.getElementById('itBelge').textContent = (item.BelgeTipi || '') + ' ' + (item.CekNumarasi || '') + ' · ' + (item.IslemTuru || '');
                itTur.innerHTML = checkTransactionTypesJs.filter(t => t.Code !== '0').map(t => '<option value="' + t.Code + '"' + (t.Code == yeniKod ? ' selected' : '') + '>' + esc(t.Description) + '</option>').join('');
                const ted = (ozetVeri && ozetVeri.tedarikciler) || []; document.getElementById('itYerListesi').innerHTML = ted.map(t => '<option value="' + esc(t) + '">').join('') + ['Ziraat Bankası', 'Halk Bankası'].map(b => '<option value="' + b + '">').join('');
                itNo.value = '';
                itTurDegisti(true);
                new bootstrap.Modal(itModalEl).show();
            }
            function itTurDegisti(ilk) {
                const item = itBaglam.item; const ad = itTur.options[itTur.selectedIndex].text; const sec = KONUM_SECENEKLERI[ad] || ['Portföyde'];
                document.getElementById('itTurAciklama').textContent = ({ 'Portföyde': 'Evrak kasada / portföyde beklemektedir.', 'Planlandı': 'Evrak belirli bir tedarikçi için ayrılmıştır (Kasa Nakit Akışı).', 'Erteleme Yapıldı': 'Vade ötelendi; portföyde, bankada veya tedarikçide olabilir.', 'Bankaya Tahsile Verildi': 'Tahsil edilmek üzere bankaya verildi.', 'Bankadan Tahsil Edildi': 'Bedeli bankadan tahsil edildi.', 'Elden Tahsil Edildi': 'Bedeli elden / nakit tahsil edildi.', 'Ciro Edildi': 'Tedarikçiye devredildi.', 'Teminata Verildi': 'Teminat amacıyla kullanıldı.', 'Tahsil Riski': 'Tahsilat riski oluştu.', 'Konkordato Sürecinde': 'Borçlu konkordato sürecinde.', 'Karşılıksız': 'Çek için karşılıksız işlemi oluştu.', 'Protesto Edildi': 'Senet için protesto işlemi oluştu.', 'İade Edildi': 'İade edildi; süreç kapalı.', 'İptal Edildi': 'İptal edildi; süreç kapalı.' })[ad] || '';
                // konum: tek olasılık → otomatik (kutu gizli); birden çok → seçim (mevcut konum uygunsa o)
                const konumKutu = document.getElementById('itKonumKutu'); konumKutu.style.display = sec.length > 1 ? '' : 'none';
                const mevcut = sec.includes(item.KonumDurumu) ? item.KonumDurumu : sec[0];
                itKonum.innerHTML = sec.map(k => '<option' + (k === mevcut ? ' selected' : '') + '>' + k + '</option>').join('');
                itKonumDegisti(ilk);
            }
            function itKonumDegisti(ilk) {
                const item = itBaglam.item; const ad = itTur.options[itTur.selectedIndex].text; const konum = itKonum.value;
                const yerKutu = document.getElementById('itYerKutu'), noKutu = document.getElementById('itNoKutu');
                const cikis = ad === 'Ciro Edildi' || konum === 'Tedarikçide', banka = ad === 'Bankaya Tahsile Verildi' || ad === 'Bankadan Tahsil Edildi' || ad === 'Teminata Verildi' || konum === 'Bankada', avukat = konum === 'Avukatta', iade = ad === 'İade Edildi', tahsil = ad === 'Bankadan Tahsil Edildi' || ad === 'Elden Tahsil Edildi';
                const yerGerekli = cikis || banka || avukat || iade; yerKutu.style.display = yerGerekli ? '' : 'none'; noKutu.style.display = yerGerekli || tahsil ? '' : 'none';
                document.getElementById('itYerEtiket').textContent = cikis ? 'Ciro Edilen Tedarikçi' : banka ? 'Banka' : avukat ? 'Avukat / Hukuk Bürosu' : iade ? 'İade Edilen (Müşteri)' : 'Kime Verildi';
                document.getElementById('itNoEtiket').textContent = tahsil ? 'Tahsilat Belge No' : 'İbraz Belge No';
                const mevcutYer = (item.CekKimeVerildi || '').replace(' (Tahsil)', '');
                itYer.value = cikis ? (item.IbrazTuru === 'Ciro' && mevcutYer ? mevcutYer : item.PlanlananTedarikci || '') : banka ? (item.IbrazTuru === 'Bankaya İbraz' && mevcutYer ? mevcutYer : 'Ziraat Bankası') : avukat ? (item.IbrazTuru === 'Avukat' && mevcutYer ? mevcutYer : '') : iade ? item.CekKimdenGeldi || '' : '';
                itOnizle();
            }
            function itOnizle() {
                const item = itBaglam.item; const ad = itTur.options[itTur.selectedIndex].text; const d = durumTuret(ad, itKonum.value, item.VadeTarihi, item.KullanımDurumu);
                document.getElementById('itOnHareket').innerHTML = durumRozet(d.hareket, d.hareket === 'Portföyde' ? 'bilgi' : 'notr');
                document.getElementById('itOnKonum').innerHTML = durumRozet(d.konum, konumSinif(d.konum));
                document.getElementById('itOnVade').innerHTML = durumRozet(d.vade, vadeDurumSinif(d.vade));
                document.getElementById('itOnUygunluk').innerHTML = durumRozet(d.uygunluk, d.uygunluk === 'Uygun' ? 'ok' : 'hata') + (d.neden ? ' <span class="text-muted" style="font-size:.6rem">' + esc(d.neden) + '</span>' : '');
                const yerGorunur = document.getElementById('itYerKutu').style.display !== 'none'; document.getElementById('itOnYer').textContent = yerGorunur ? (itYer.value || '—') : (d.konum === 'Portföyde' ? 'portföyde kalır' : d.konum === 'Kapandı' ? 'süreç kapanır' : '—');
                const planli = item.IslemTuru === 'Planlandı' && item.PlanDocEntry, cikis = (['Ciro Edildi', 'Bankaya Tahsile Verildi', 'Teminata Verildi'].includes(ad) || d.konum === 'Bankada' || d.konum === 'Tedarikçide') && item.KonumDurumu === 'Portföyde';
                document.getElementById('itNot').innerHTML = cikis && !planli ? '<i class="fas fa-user-shield me-1 text-danger"></i><b>Plansız çıkış:</b> belge Kasa Nakit Akışı\'nda planlanmamış; çıkış işlenmez, GMY onayına düşer (onaylanınca uygulanır).' : cikis && planli ? '<i class="fas fa-check me-1 text-success"></i><b>Planlı çıkış:</b> Kasa Nakit Akışı #' + item.PlanDocEntry + ' üzerinden işlenir (plan ↔ ibraz kontrolü: planlanan ' + esc(item.PlanlananTedarikci || '—') + ').' : '<i class="fas fa-info-circle me-1"></i>Hareket, konum, vade durumu ve uygunluk standart kuralla otomatik yazılır; elle girilmez.';
            }
            itTur.addEventListener('change', function () { itTurDegisti(false); }); itKonum.addEventListener('change', function () { itKonumDegisti(false); }); itYer.addEventListener('input', itOnizle);
            document.getElementById('itUygula').addEventListener('click', async function () {
                if (!itBaglam) return; const item = itBaglam.item, b = this; const sec = KONUM_SECENEKLERI[itTur.options[itTur.selectedIndex].text] || [];
                const yerGorunur = document.getElementById('itYerKutu').style.display !== 'none'; if (yerGorunur && !itYer.value.trim() && itTur.options[itTur.selectedIndex].text !== 'Teminata Verildi') { toastr.warning('Kime verildiğini girin.'); return; }
                b.disabled = true; const ok = await updateCheckTransactionTypeByDocEntry(item.DocEntry, itTur.value, sec.length > 1 ? itKonum.value : '', yerGorunur ? itYer.value.trim() : '', itNo.value.trim()); b.disabled = false;
                itBaglam.uygulandi = true; bootstrap.Modal.getInstance(itModalEl).hide();
                if (ok && itBaglam.sonra) itBaglam.sonra();
            });
            itModalEl.addEventListener('hidden.bs.modal', function () { if (itBaglam && !itBaglam.uygulandi && itBaglam.selectEl) { itBaglam.selectEl.value = itBaglam.selectEl.dataset.previousValue || itBaglam.item.CekIslemTuru; if (itBaglam.sonra) itBaglam.sonra(); } itBaglam = null; });

            async function updatePlannedSupplier(docEntry, newSupplier) {
                try {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    const response = await fetch(`/CekAkibeti/UpdatePlannedSupplier${dbQueryString}`, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify({ DocEntry: docEntry, NewPlannedSupplier: newSupplier }) });
                    if (!response.ok) { toastr.error('HTTP ' + response.status); return false; }
                    const data = await response.json();
                    // Kasa Nakit Akışı ile bütünleşik: plan satırı açıldı / kurumu değişti / belge satırdan çıktı → güncel satır tabloya konur, özet tazelenir
                    if (data.satirJson) satiriGuncelle(JSON.parse(data.satirJson));
                    if (data.success) { toastr.success(data.message + (data.satir ? ' <a href="' + data.satir.link + '" target="_blank" class="fw-bold">Kasa Nakit Akışı #' + data.satir.docEntry + '</a>' : ''), 'Planlanan Tedarikçi', { timeOut: 9000, escapeHtml: false }); cekOzetYukle(true); return true; }
                    toastr.error(data.message || 'Güncellenemedi.'); return false;
                } catch (error) { console.error(error); return false; }
            }

            document.getElementById('farkliIslemlerBtn').addEventListener('click', async function () {
                const modal = new bootstrap.Modal(document.getElementById('farkliIslemlerModal'));
                const tbody = document.getElementById('farkliIslemlerBody');
                
                tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-warning"></i><br>Kayıtlar aranıyor...</td></tr>';
                modal.show();

                try {
                    const response = await fetch(`/CekAkibeti/GetFarkliIslemler${dbQueryString}`);
                    const result = await response.json();

                    if (result.success) {
                        tbody.innerHTML = '';
                        if (result.data.length === 0) {
                            tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-success fw-bold"><i class="fas fa-check-circle fa-2x mb-2"></i><br>Tüm kayıtlar birbiriyle uyumlu. Farklı işlem bulunamadı.</td></tr>';
                            return;
                        }

                        result.data.forEach(item => {
                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                                <td class="align-middle fw-bold">${item.islemKaynagi}</td>
                                <td class="align-middle">${item.belgeNo}</td>
                                <td class="align-middle">${item.belgeTarihi}</td>
                                <td class="align-middle text-success fw-bold">${item.belgedekiAktar || '- BOŞ -'}</td>
                                <td class="align-middle">${item.yevmiyeNo}</td>
                                <td class="align-middle text-danger">${item.yevmiyedekiAktar || '- BOŞ -'}</td>
                                <td class="align-middle text-start text-muted small" style="max-width: 200px; white-space: normal;">${item.yevmiyeAciklamasi}</td>
                                <td class="align-middle">
                                    <div class="d-flex flex-column gap-1">
                                        <button class="btn btn-sm btn-primary esitle-btn shadow-sm" 
                                            data-direction="ToYevmiye"
                                            data-kaynak="${item.islemKaynagi}" 
                                            data-belge="${item.belgeNo}" 
                                            data-yevmiye="${item.yevmiyeNo}" 
                                            data-aktar="${item.belgedekiAktar}" 
                                            title="Belgedeki Değeri (Doğru) Yevmiyeye Kopyala">
                                            <i class="fas fa-arrow-right me-1"></i> Yevmiyeye Aktar
                                        </button>
                                        <button class="btn btn-sm btn-info text-white esitle-btn shadow-sm" 
                                            data-direction="ToBelge"
                                            data-kaynak="${item.islemKaynagi}" 
                                            data-belge="${item.belgeNo}" 
                                            data-yevmiye="${item.yevmiyeNo}" 
                                            data-aktar="${item.yevmiyedekiAktar}" 
                                            title="Yevmiyedeki Değeri Belgeye Kopyala">
                                            <i class="fas fa-arrow-left me-1"></i> Belgeye Aktar
                                        </button>
                                    </div>
                                </td>
                            `;
                            tbody.appendChild(tr);
                        });

                        document.querySelectorAll('.esitle-btn').forEach(btn => {
                            btn.addEventListener('click', async function () {
                                const btnElement = this;
                                const container = btnElement.closest('.d-flex'); 
                                
                                const direction = btnElement.getAttribute('data-direction');
                                const islemKaynagi = btnElement.getAttribute('data-kaynak');
                                const belgeNo = btnElement.getAttribute('data-belge');
                                const yevmiyeNo = btnElement.getAttribute('data-yevmiye');
                                const aktarDegeri = btnElement.getAttribute('data-aktar');
                                const originalHtml = btnElement.innerHTML;

                                container.querySelectorAll('button').forEach(b => b.disabled = true);
                                btnElement.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

                                try {
                                    const token = $('input[name="__RequestVerificationToken"]').val();
                                    
                                    const payload = { 
                                        IslemKaynagi: islemKaynagi,
                                        BelgeNo: belgeNo,
                                        YevmiyeNo: parseInt(yevmiyeNo), 
                                        AktarDegeri: aktarDegeri,
                                        Direction: direction
                                    };

                                    const updateRes = await fetch(`/CekAkibeti/SyncUBe1Aktar${dbQueryString}`, {
                                        method: 'POST',
                                        headers: { 
                                            'Content-Type': 'application/json', 
                                            'X-Requested-With': 'XMLHttpRequest',
                                            'RequestVerificationToken': token 
                                        },
                                        body: JSON.stringify(payload)
                                    });

                                    const updateData = await updateRes.json();
                                    if (updateData.success) {
                                        toastr.success(`${yevmiyeNo} nolu yevmiye/belge başarıyla eşitlendi.`);
                                        btnElement.closest('tr').remove(); 
                                        
                                        if(tbody.children.length === 0) {
                                            tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-success fw-bold"><i class="fas fa-check-circle fa-2x mb-2"></i><br>Tüm kayıtlar eşitlendi.</td></tr>';
                                        }
                                    } else {
                                        toastr.error(updateData.message || 'Eşitleme sırasında hata oluştu.');
                                        container.querySelectorAll('button').forEach(b => b.disabled = false);
                                        btnElement.innerHTML = originalHtml;
                                    }
                                } catch (err) {
                                    toastr.error('Sunucuya ulaşılamadı.');
                                    container.querySelectorAll('button').forEach(b => b.disabled = false);
                                    btnElement.innerHTML = originalHtml;
                                }
                            });
                        });

                    } else {
                        tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-danger fw-bold">Hata: ${result.message}</td></tr>`;
                    }
                } catch (error) {
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-danger fw-bold">Sunucuya bağlanılamadı.</td></tr>';
                }
            });

            // sütun yönetimi kaldırıldı: eski kayıtlı sütun düzenleri yok sayılır, bütün standart başlıklar sabit sırayla gösterilir
            try { localStorage.removeItem(`reportConfig_${window.location.pathname.replace(/\//g, '_')}`); localStorage.removeItem('cekAkibetiDuzenSurumu'); } catch (e) { }
            initializePage();
            setTimeout(adjustLayoutHeight, 100);
            setTimeout(adjustLayoutHeight, 500);

            // ---------------------------------------------------------------
            // DURUM ÖZETİ · SENKRON (veri /CekAkibeti/Ozet) — Takip Paneli ile aynı dil
            // Planlı belge → "Tedarikçiye Çık" (plan satırı üzerinden ciro; Kasa Nakit Akışı ÖDENDİ, muhasebe fişi), portföydeki belge → "Nakit Akışa Gönder"
            // (çek / senet satırı açılır, belge Planlandı). Plansız belgede çıkış GMY onayına düşer. İşlemden sonra sayfa tazelenir (sürüm sayacı değişir).
            // ---------------------------------------------------------------
            const ozetPanel = document.getElementById('cekOzetPanel');
            let ozetVeri = null;
            const h = s => $('<div>').text(s === null || s === undefined ? '' : s).html();
            const tl = v => (Number(v) || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const kisa = v => (Number(v) || 0).toLocaleString('tr-TR', { maximumFractionDigits: 0 });
            const roz = (m, t) => '<span class="cek-roz ' + t + '">' + h(m) + '</span>';
            const kontrolRoz = k => k === 'Uyumlu' ? roz('Uyumlu', 'ok') : k === 'Farklı' ? roz('FARKLI', 'hata') : k === 'İbraz Bekliyor' ? roz('İbraz Bekliyor', 'uyari') : k === 'Plansız İbraz' ? roz('Plansız İbraz', 'bilgi') : '<span class="text-muted">—</span>';
            const planHucre = p => p.planDocEntry ? '<a href="' + h(p.planLink || '#') + '" target="_blank" class="fw-bold">#' + p.planDocEntry + '</a> ' + roz(p.planDurum || '', p.planDurum === 'ÖDENDİ' ? 'ok' : p.planDurum === 'Gecikti' ? 'hata' : 'bilgi') + '<small>' + (p.planTalimat ? 'talimat ' + h(p.planTalimat) : p.cikisTalebi ? '<span class="text-danger">GMY onayı bekliyor</span>' : 'talimat yok') + '</small>' : roz('Satır Yok', 'hata') + '<small>Çek Akıbeti\'nden planlı</small>';
            async function cekOzetYukle(sessiz) {
                try { const r = await fetch('/CekAkibeti/Ozet' + dbQueryString); ozetVeri = await r.json(); } catch (e) { ozetVeri = null; }
                if (!ozetVeri || !ozetVeri.success) { document.getElementById('cekOzetSayi').textContent = '!'; return; }
                cekOzetCiz(); if (!sessiz) adjustLayoutHeight();
            }
            function cekOzetCiz() {
                const V = ozetVeri, P = V.portfoy, n = V.nakitAkis;
                const vadesiGecen = V.planli.filter(x => x.vadeGun < 0).length;
                const R = [
                    { grup: 'Portföy (' + V.sirket + ')' },
                    { k: '#1d4ed8', l: 'Çek X · Çek R', s: 'kullanılabilir ' + P.cekX.kullanilabilir + ' / ' + P.cekR.kullanilabilir + ' · planlı ' + P.cekX.planli + ' / ' + P.cekR.planli, n: P.cekX.adet + ' · ' + P.cekR.adet, t: P.cekX.tutar + P.cekR.tutar, f: { column: 'HareketDurumu', value: 'Portföyde' } },
                    { k: '#7c3aed', l: 'Senet X · Senet R', s: 'kullanılabilir ' + P.senetX.kullanilabilir + ' / ' + P.senetR.kullanilabilir + ' · planlı ' + P.senetX.planli + ' / ' + P.senetR.planli, n: P.senetX.adet + ' · ' + P.senetR.adet, t: P.senetX.tutar + P.senetR.tutar, f: { column: 'HareketDurumu', value: 'Portföyde' } },
                    { grup: 'Kasa Nakit Akışı Planı' },
                    { k: '#b45309', l: 'Planlı Belge (Planlandı)', s: 'vadesi 7 gün içinde ' + V.vadesiGelen + (vadesiGecen ? ' · vadesi geçen ' + vadesiGecen : '') + ' · sağdaki listede "Tedarikçiye Çık"', n: V.planli.length, t: V.planliToplam, f: { column: 'CekIslemTuru', value: '2' } },
                    { k: '#0369a1', l: 'Nakit Akışta Çek / Senet Satırı', s: 'ödenmemiş ' + n.planliSatir + ' satır · belge seçilmemiş ' + n.belgesiz + ' · açık çek talimatı ' + n.acikTalimat, n: n.planliSatir, t: null, link: n.link, linkAd: 'Kasa Nakit Akışı › Çek' },
                    { k: '#9d174d', l: 'GMY Onayı Bekleyen Plansız Çıkış', s: 'Çek Akıbeti\'nden planlanmamış belge çıkışı talebi; onaylanınca çıkış işlenir', n: V.gmy.length, t: V.gmy.reduce((s, x) => s + x.tutar, 0), link: n.link, linkAd: 'Kasa Nakit Akışı' },
                    { grup: 'Kontrol' },
                    { k: '#dc2626', l: 'Plana Aykırı Çıkış', s: 'Kasa Nakit Akışı planı ≠ ibraz / ciro yeri · Takip Paneli › Çek', n: V.farkli.length, t: V.farkli.reduce((s, x) => s + x.tutar, 0), link: V.takipPaneli, linkAd: 'Takip Paneli' },
                    { k: '#15803d', l: 'Bankada (Konum Durumu)', s: 'tahsilde, teminatta, bankada ertelenmiş / riskli · bu hafta vadesi gelen ' + V.bankada.buHafta, n: V.bankada.adet, t: V.bankada.tutar, f: { column: 'KonumDurumu', value: 'Bankada' } }
                ];
                document.querySelector('#cekOzetDurum tbody').innerHTML = R.map(r => r.grup ? '<tr class="grup"><td colspan="4">' + h(r.grup) + '</td></tr>' : '<tr class="' + (r.f ? 'tik' : '') + '" style="--k:' + r.k + '" ' + (r.f ? 'data-column="' + r.f.column + '" data-value="' + r.f.value + '" title="Tabloyu süz"' : '') + '><td class="gost">' + h(r.l) + '<small>' + h(r.s) + '</small></td><td class="s adet ' + (!r.n || r.n === 0 ? 'sifir' : '') + '">' + h(String(r.n)) + '</td><td class="s">' + (r.t == null ? '' : kisa(r.t)) + '</td><td>' + (r.link ? '<a href="' + h(r.link) + '" target="_blank" class="fw-bold">' + h(r.linkAd) + ' <i class="fas fa-arrow-up-right-from-square" style="font-size:.5rem"></i></a>' : r.f ? '<span class="text-muted">tıkla: tabloyu süz</span>' : '') + '</td></tr>').join('');
                document.getElementById('cekOzetNot').textContent = V.bugun + ' · ' + V.sirket;
                const dikkat = V.vadesiGelen + V.gmy.length + V.farkli.length + n.belgesiz; document.getElementById('cekOzetSayi').textContent = dikkat;
                document.querySelector('#cekOzetPlanli tbody').innerHTML = V.planli.length ? V.planli.map(p => '<tr class="' + (p.vadeGun < 0 ? 'gecti' : p.vadeGun <= 7 ? 'vade' : '') + '"><td><a href="#" class="cek-no-link fw-bold" data-docentry="' + p.docEntry + '">' + h(p.no) + '</a><small>' + h(p.musteri + ' · ' + p.belge + ' ' + p.tip + ' · ' + p.banka) + '</small></td><td>' + h(p.vade) + '<small>' + (p.vadeGun < 0 ? '<span class="text-danger">' + (-p.vadeGun) + ' gün geçti</span>' : p.vadeGun === 0 ? 'bugün' : p.vadeGun + ' gün') + '</small></td><td class="s fw-bold">' + tl(p.tutar) + '</td><td>' + h(p.planlananTedarikci || '—') + '<small>' + h((p.planlayan || '') + ' ' + (p.planlamaTarihi || '')) + '</small></td><td>' + planHucre(p) + '</td><td>' + kontrolRoz(p.kontrol) + (p.dolasim ? '<small>' + h(p.dolasim) + '</small>' : '') + '</td><td class="text-nowrap">' + (p.cikisTalebi && p.planOnay !== 'Onaylandı' ? roz('GMY Onayı', 'uyari') : '<button type="button" class="btn btn-success btn-xs cek-cik-btn" data-docentry="' + p.docEntry + '" title="Planlanan tedarikçiye ciro et: Kasa Nakit Akışı satırı ÖDENDİ, muhasebe fişi, akıbet Ciro Edildi"><i class="fas fa-share-from-square me-1"></i>Tedarikçiye Çık</button>') + '</td></tr>').join('') : '<tr><td colspan="7" class="text-center text-muted py-2">Planlı belge yok. Portföydeki belgeyi detay penceresinden "Nakit Akışa Gönder" ile planlayabilirsiniz.</td></tr>';
                document.getElementById('cekOzetPlanNot').textContent = V.planli.length + ' belge · ' + kisa(V.planliToplam) + ' TL · vadesi 7 gün içinde ' + V.vadesiGelen;
                document.querySelector('#cekOzetGmy tbody').innerHTML = V.gmy.length ? V.gmy.map(g => '<tr><td class="fw-bold">' + h(g.cekNolar) + '</td><td>' + h(g.cikisTalebi) + (g.ibrazYeri ? '<small>→ ' + h(g.ibrazYeri) + '</small>' : '') + '</td><td class="s">' + tl(g.tutar) + '</td><td>' + h(g.talepEden) + '<small>' + h(g.tarih) + '</small></td><td><a href="' + h(g.link) + '" target="_blank" title="Kasa Nakit Akışı #' + g.docEntry + ' (GMY onayı)"><i class="fas fa-arrow-up-right-from-square"></i></a></td></tr>').join('') : '<tr><td colspan="5" class="text-center text-muted py-2">Bekleyen talep yok.</td></tr>';
                document.querySelector('#cekOzetFarkli tbody').innerHTML = V.farkli.length ? V.farkli.map(p => '<tr><td><a href="#" class="cek-no-link fw-bold" data-docentry="' + p.docEntry + '">' + h(p.no) + '</a></td><td>' + h(p.planlananTedarikci) + '</td><td class="text-danger fw-bold">' + h(p.ibrazYeri) + '<small>' + h(p.ibrazTuru) + '</small></td><td class="s">' + tl(p.tutar) + '</td><td>' + h(p.ibrazTarihi || '') + '</td></tr>').join('') : '<tr><td colspan="5" class="text-center text-success py-2"><i class="fas fa-check me-1"></i>Plana aykırı çıkış yok.</td></tr>';
                document.querySelector('#cekOzetGunluk tbody').innerHTML = V.gunluk.length ? V.gunluk.map(g => '<tr><td class="text-nowrap">' + h(g.tarih) + '</td><td class="fw-bold">' + h(g.no) + '</td><td>' + roz(g.islem, /Planlandı|Ciro|Tahsil/.test(g.islem) ? 'bilgi' : /Kaldır|İptal/.test(g.islem) ? 'hata' : 'notr') + '</td><td class="wrap"><small style="display:inline">' + h(g.aciklama) + '</small><small>' + h(g.kullanici) + '</small></td></tr>').join('') : '<tr><td colspan="4" class="text-center text-muted py-2">Kayıt yok.</td></tr>';
                document.getElementById('cekOzetSenkron').innerHTML = '<a href="' + h(n.link) + '" target="_blank">Kasa Nakit Akışı</a> · <a href="' + h(V.takipPaneli) + '" target="_blank">Takip Paneli</a>';
            }
            document.getElementById('cekOzetBtn').addEventListener('click', function () {
                const acik = ozetPanel.classList.toggle('d-none') === false; this.classList.toggle('btn-primary', !acik); this.classList.toggle('btn-outline-primary', acik);
                try { localStorage.setItem('cekAkibetiOzetAcik', acik ? '1' : '0'); } catch (e) { }
                if (acik && !ozetVeri) cekOzetYukle(); adjustLayoutHeight();
            });
            // gösterge satırı → hızlı süzgeç (üstteki kartlarla aynı mekanizma)
            document.getElementById('cekOzetDurum').addEventListener('click', function (e) {
                const tr = e.target.closest('tr.tik'); if (!tr) return;
                const kart = document.querySelector('.quick-filter-card[data-column="' + tr.dataset.column + '"][data-value="' + tr.dataset.value + '"]');
                if (kart) kart.click(); else toastr.info('Süzgeç: ' + tr.dataset.column + ' = ' + tr.dataset.value);
            });
            ozetPanel.addEventListener('click', function (e) {
                const bag = e.target.closest('.cek-no-link'); if (bag) { e.preventDefault(); cekDetayiniAc(parseInt(bag.dataset.docentry)); return; }
                const b = e.target.closest('.cek-cik-btn'); if (!b) return;
                const p = (ozetVeri.planli || []).find(x => x.docEntry === parseInt(b.dataset.docentry)); if (!p) return;
                if (!confirm(p.no + ' · ' + tl(p.tutar) + ' TL planlanan tedarikçiye (' + (p.planlananTedarikci || '—') + ') ciro edilsin mi? Kasa Nakit Akışı satırı ÖDENDİ olur, muhasebe fişi atılır.')) return;
                cekCikisYap(p.docEntry, 'Tedarikçiye Ciro', p.planlananTedarikci, '', '');
            });
            async function cekGonder(docEntry, tedarikci, tarih, belgeTipi, belgeNo, urun) {
                const token = $('input[name="__RequestVerificationToken"]').val();
                try {
                    const r = await fetch('/CekAkibeti/NakitAkisaGonder' + dbQueryString, { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }, body: JSON.stringify({ DocEntry: docEntry, Tedarikci: tedarikci, PlanlananTarih: tarih, BelgeTipi: belgeTipi, BelgeNo: belgeNo, UrunHizmet: urun }) });
                    const d = await r.json(); if (!d.success) { toastr.error(d.message || 'Gönderilemedi.'); return false; }
                    toastr.success(d.message + (d.satir ? ' <a href="' + d.satir.link + '" target="_blank" class="fw-bold">Kasa Nakit Akışı\'nda aç</a>' : ''), 'Nakit Akışa Gönderildi', { timeOut: 9000, escapeHtml: false }); setTimeout(() => location.reload(), 1800); return true;
                } catch (e) { toastr.error('Ağ hatası.'); return false; }
            }
            async function cekCikisYap(docEntry, tur, yer, belgeNo, not) {
                const token = $('input[name="__RequestVerificationToken"]').val();
                try {
                    const r = await fetch('/CekAkibeti/TedarikciyeCik' + dbQueryString, { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }, body: JSON.stringify({ DocEntry: docEntry, Tur: tur, IbrazYeri: yer, BelgeNo: belgeNo, Not: not }) });
                    const d = await r.json();
                    if (d.onayaDustu) { toastr.warning(d.message, 'GMY onayı', { timeOut: 12000 }); setTimeout(() => location.reload(), 2500); return false; }
                    if (!d.success) { toastr.error(d.message || 'Çıkış yapılamadı.', '', { timeOut: 10000 }); return false; }
                    toastr.success(d.message + (d.satir ? ' <a href="' + d.satir.link + '" target="_blank" class="fw-bold">Kasa Nakit Akışı\'nda aç</a>' : ''), 'Çıkış işlendi', { timeOut: 9000, escapeHtml: false }); setTimeout(() => location.reload(), 1800); return true;
                } catch (e) { toastr.error('Ağ hatası.'); return false; }
            }
            // detay penceresi: hızlı işlemler (portföyde → Nakit Akışa Gönder; planlı → Tedarikçiye Çık; plan satırı / Takip Paneli bağlantıları)
            window.cekHizliIslemHtml = function (item) {
                const p = (ozetVeri && ozetVeri.planlar && ozetVeri.planlar[String(item.DocEntry)]) || null;
                const portfoyde = p ? p.portfoyde : item.HareketDurumu === 'Portföyde', secilebilir = p ? p.secilebilir : item.UygunlukDurumu === 'Uygun';
                const planli = p ? p.islemTuru === 'Planlandı' : item.CekIslemTuru == '2', gmy = p && p.cikisTalebi && p.planOnay !== 'Onaylandı';
                const ted = (ozetVeri && ozetVeri.tedarikciler) || [];
                const dl = '<datalist id="hzTedarikciler">' + ted.map(t => '<option value="' + h(t) + '">').join('') + '</datalist>';
                let html = '<div class="detay-bolum-baslik">Hızlı İşlemler · Kasa Nakit Akışı Senkronu</div><div class="cek-hizli">' + dl;
                if (secilebilir) html += '<div style="min-width:220px"><label>Ödenecek Tedarikçi</label><input id="hzTedarikci" class="form-control" list="hzTedarikciler" placeholder="tedarikçi adı" value="' + h(item.PlanlananTedarikci || '') + '"></div><div><label>Planlanan Tarih</label><input id="hzTarih" type="date" class="form-control" value="' + h(item.VadeTarihi || '') + '"></div><div><label>Belge Tipi</label><select id="hzBelgeTipi" class="form-select"><option>Cari Bakiye</option><option>Fatura</option><option>Sipariş</option><option>Diğer</option></select></div><div><label>Belge No</label><input id="hzBelgeNo" class="form-control" placeholder="FT-…"></div><div><button type="button" class="btn btn-primary btn-sm" id="hzGonder"><i class="fas fa-paper-plane me-1"></i>Nakit Akışa Gönder</button></div>';
                if (portfoyde && !gmy) html += '<div><label>Çıkış Türü</label><select id="hzTur" class="form-select"><option value="Tedarikçiye Ciro">Tedarikçiye Ciro</option><option value="Bankaya Tahsile Ver">Bankaya Tahsile Ver</option></select></div><div style="min-width:200px"><label>Ciro Edilen Tedarikçi / Banka</label><input id="hzYer" class="form-control" list="hzTedarikciler" value="' + h(item.PlanlananTedarikci || '') + '"></div><div><button type="button" class="btn btn-success btn-sm" id="hzCik"><i class="fas fa-share-from-square me-1"></i>' + (planli ? 'Tedarikçiye Çık · İbraz Et' : 'Çıkış Talebi (GMY Onayı)') + '</button></div>';
                if (p && p.planDocEntry) html += '<div><a class="btn btn-light border btn-sm" href="' + h(p.planLink || '#') + '" target="_blank"><i class="fas fa-money-bill-transfer me-1"></i>Kasa Nakit Akışı #' + p.planDocEntry + ' (' + h(p.planDurum || '') + (p.planTalimat ? ' · ' + h(p.planTalimat) : '') + ')</a></div>';
                html += '<div><a class="btn btn-light border btn-sm" href="' + h((ozetVeri && ozetVeri.takipPaneli) || '/Rapor123?sekme=cek') + '" target="_blank" title="Konsolide Günlük Finansal Hareketler (Takip Paneli) › Çek · Senet"><i class="fas fa-clipboard-check me-1"></i>Konsolide Günlük Finansal Hareketler</a></div>';
                if (item.FisNo) html += '<div><button type="button" class="btn btn-light border btn-sm" id="hzFis" title="Muhasebe fişi (Takip Paneli ile aynı numara)"><i class="fas fa-file-invoice me-1"></i>Fiş ' + h(item.FisNo) + '</button></div>';
                html += '<div class="not">' + (gmy ? '<i class="fas fa-user-shield me-1 text-danger"></i>Plansız çıkış talebi GMY onayı bekliyor (Kasa Nakit Akışı #' + p.planDocEntry + ').' : planli ? '<i class="fas fa-check me-1 text-success"></i>Belge Kasa Nakit Akışı\'nda planlı: çıkış plan satırı üzerinden işlenir (satır ÖDENDİ, fiş atılır, Takip Paneli güncellenir).' : secilebilir ? '<i class="fas fa-info-circle me-1"></i>Portföyde: "Nakit Akışa Gönder" ile ödeme satırı açılır ve belge planlanır; plansız çıkış GMY onayına düşer.' : '<i class="fas fa-info-circle me-1"></i>' + h(item.IslemTipiAdi || '') + (item.CekKimeVerildi ? ' → ' + h(item.CekKimeVerildi) : '') + ' · bu belge için hızlı işlem yok.') + '</div></div>';
                return html;
            };
            window.cekHizliIslemBagla = function (item) {
                const f = document.getElementById('hzFis'); if (f) f.addEventListener('click', function () { fisAc(item.DocEntry); });
                const g = document.getElementById('hzGonder'); if (g) g.addEventListener('click', async function () { const t = document.getElementById('hzTedarikci').value.trim(); if (!t) { toastr.warning('Tedarikçi girin.'); return; } g.disabled = true; const ok = await cekGonder(item.DocEntry, t, document.getElementById('hzTarih').value, document.getElementById('hzBelgeTipi').value, document.getElementById('hzBelgeNo').value, ''); if (!ok) g.disabled = false; });
                const c = document.getElementById('hzCik'); if (c) c.addEventListener('click', async function () { const tur = document.getElementById('hzTur').value, yer = document.getElementById('hzYer').value.trim(); if (tur === 'Tedarikçiye Ciro' && !yer) { toastr.warning('Tedarikçi girin.'); return; } if (!confirm(item.CekNumarasi + ' ' + (tur === 'Bankaya Tahsile Ver' ? 'bankaya tahsile verilsin' : 'tedarikçiye ciro edilsin') + ' mi? → ' + yer)) return; c.disabled = true; const ok = await cekCikisYap(item.DocEntry, tur, yer, '', ''); if (!ok) c.disabled = false; });
            };
            // özet verisi her açılışta yüklenir (detay penceresindeki hızlı işlemler plan bilgisini kullanır); panel son durumunu hatırlar
            cekOzetYukle(true).then(() => { let acik = false; try { acik = localStorage.getItem('cekAkibetiOzetAcik') === '1'; } catch (e) { } if (acik) document.getElementById('cekOzetBtn').click(); });

            // DİNAMİK LİSTE: Kasa Nakit Akışı / Konsolide Günlük Finansal Hareketler'de belge planlanınca, ibraz edilince, dolaşım adımı gerçekleşince sürüm sayacı değişir;
            // ekran 20 sn'de bir ve sekmeye dönüşte sayacı okur, değişmişse listeyi /CekAkibeti/Veri'den sayfa yenilemeden tazeler (süzgeç, sıralama ve seçim korunur).
            (function () {
                const q = typeof dbQueryString === 'string' ? dbQueryString : ''; const yil = new URLSearchParams(window.location.search).get('yil') || '';
                let surum = null, mesgul = false; const oku = () => fetch('/CekAkibeti/Versiyon' + q).then(r => r.json()).catch(() => null);
                oku().then(v => { if (v) surum = v.v; });
                async function tazele() {
                    if (mesgul) return; mesgul = true;
                    try {
                        const r = await fetch('/CekAkibeti/Veri' + (q ? q + '&' : '?') + 'yil=' + encodeURIComponent(yil)); const d = await r.json(); if (!d || !d.success) return;
                        allReportData.length = 0; reportDataMap.clear(); d.satirlar.forEach(x => { turetilmisAlanlar(x); allReportData.push(x); reportDataMap.set(x.DocEntry, x); });
                        surum = d.surum; if (window.filterTableAndRender) window.filterTableAndRender(); cekOzetYukle(true);
                        toastr.info('Çek listesi tazelendi (Kasa Nakit Akışı / Takip Paneli değişikliği).', '', { timeOut: 4000 });
                    } catch (e) { } finally { mesgul = false; }
                }
                async function kontrol() { if (surum === null || document.visibilityState !== 'visible') return; const v = await oku(); if (v && v.v !== surum) tazele(); }
                setInterval(kontrol, 20000);
                document.addEventListener('visibilitychange', kontrol); window.addEventListener('focus', kontrol);
                window.cekListesiniTazele = tazele;
            })();
        });
    </script>
}