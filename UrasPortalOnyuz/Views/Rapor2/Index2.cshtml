                        html += '<div class="it-not">' + (item.PlanDocEntry && item.PlanLink ? '<a href="' + esc(item.PlanLink) + '" target="_blank" class="fw-bold me-3"><i class="fas fa-money-bill-transfer me-1"></i>Kasa Nakit Akışı #' + item.PlanDocEntry + '</a>' : '<a href="/Rapor79?sirket=' + esc(db) + '&sekme=cek" target="_blank" class="fw-bold me-3"><i class="fas fa-money-bill-transfer me-1"></i>Kasa Nakit Akışı › Çek / Senet</a>') + '<a href="/Rapor123?sirket=' + esc(db) + '&sekme=cek" target="_blank" class="fw-bold"><i class="fas fa-clipboard-check me-1"></i>Konsolide Günlük Finansal Hareketler › Çek</a></div>';
                    }
                });

                // Düzenlenebilir alanlar
                html += '<div class="detay-bolum-baslik">Düzenlenebilir Alanlar</div>';
