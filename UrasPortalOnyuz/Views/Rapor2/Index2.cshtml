            // özet kartları = standart raporun yönetici süzgeçleri (Hareket = Portföyde, Uygunluk = Uygun, İşlem Türü = Planlandı, Vade Durumu = Vadesi Geçti / Tahsil / Kapandı, Konum = Bankada, riskli türler)
            const RISKLI_TURLER = ['Tahsil Riski', 'Konkordato Sürecinde', 'Karşılıksız', 'Protesto Edildi'];
            function calculateSummaryCards() {
                const t = { Portfoy: [0, 0], Uygun: [0, 0], Plan: [0, 0], VadesiGecti: [0, 0], Bankada: [0, 0], Riskli: [0, 0], Tahsil: [0, 0], Kapandi: [0, 0] };
                let dataToCalculate = allReportData;
                if (activeYearFilter !== 'all') {
                    dataToCalculate = allReportData.filter(item => {
                        if(item.VadeTarihi) return new Date(item.VadeTarihi).getFullYear().toString() === activeYearFilter;
                        return false;
                    });
                }
                const ekle = (k, tutar) => { t[k][0]++; t[k][1] += tutar; };
                dataToCalculate.forEach(item => {
                    const islem = item.IslemTuru || '', vd = item.VadeDurumu || '', tutar = item.TlKarsiligi || item.Tutar || 0;
                    if (item.HareketDurumu === 'Portföyde') ekle('Portfoy', tutar);
                    if (item.UygunlukDurumu === 'Uygun') ekle('Uygun', tutar);
                    if (islem === 'Planlandı') ekle('Plan', tutar);
                    if (vd === 'Vadesi Geçti') ekle('VadesiGecti', tutar);
                    if (item.KonumDurumu === 'Bankada') ekle('Bankada', tutar);
                    if (RISKLI_TURLER.includes(islem)) ekle('Riskli', tutar);
                    if (vd === 'Tahsil') ekle('Tahsil', tutar);
                    if (vd === 'Kapandı') ekle('Kapandi', tutar);
                });
                // kartlar tek sırada dar olduğundan tutar kısa yazılır (292,96 Mn TL); tam değer araç ipucunda
                const kisaTutar = v => Math.abs(v) >= 1e6 ? (v / 1e6).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Mn TL' : Math.abs(v) >= 1e3 ? (v / 1e3).toLocaleString('tr-TR', { maximumFractionDigits: 1 }) + ' Bin TL' : v.toLocaleString('tr-TR', { maximumFractionDigits: 0 }) + ' TL';
                Object.keys(t).forEach(k => {
                    const tutarEl = document.getElementById('stat' + k + 'Tutar'), adetEl = document.getElementById('stat' + k + 'Adet');
                    if (tutarEl) { tutarEl.textContent = kisaTutar(t[k][1]); tutarEl.title = t[k][1].toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' TL'; }
                    if (adetEl) adetEl.textContent = t[k][0] + ' Adet';
                });
            }

            document.querySelectorAll('.quick-filter-card').forEach(card => {
                card.addEventListener('click', function() {
