                    + (y.satirlar || []).map(s => '<tr><td class="fw-bold">' + esc(s.hesapKodu) + '</td><td>' + esc(s.hesapAdi) + (s.aciklama ? ' <span class="text-muted">· ' + esc(s.aciklama) + '</span>' : '') + '</td><td class="s">' + (s.borc ? tl2(s.borc) : '') + '</td><td class="s">' + (s.alacak ? tl2(s.alacak) : '') + '</td></tr>').join('')
                    + '<tr class="fw-bold"><td colspan="2" class="text-end">TOPLAM</td><td class="s">' + tl2(y.toplamBorc) + '</td><td class="s">' + tl2(y.toplamAlacak) + '</td></tr></tbody></table>';
