                                + L.map(a => '<tr><td>' + a.Sira + '</td><td>' + esc(a.Tur) + '</td><td>' + esc(a.Eden) + ' → <b>' + esc(a.Alan) + '</b></td><td>' + (a.Durum === 'Gerçekleşti' ? '<span class="ca-roz ok">Gerçekleşti</span>' : '<span class="ca-roz uyari">Planlandı</span>') + '</td><td>' + esc(a.Tarih) + '</td><td>' + esc(a.BelgeNo || '—') + '</td></tr>').join('')
                                + '</tbody></table>';
