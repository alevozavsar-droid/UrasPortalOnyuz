            async function loadAndApplyColumnConfig() {
                const table = document.querySelector('.rapor-tablo');
                
                // Tablonun 1366px'de yatay kaydırma olmadan sığması için varsayılan gizlenen kolonlar.
                // Kolonlar SİLİNMEZ; kullanıcı "Sütunları Yönet" ile istediğini geri açabilir.
                // Bu liste yalnızca kayıtlı şablonu olmayan kullanıcılara uygulanır.
                //
                // Ana tabloda duracak kolonlar ve soldan sağa sırası:
                // Konsolide Finansal Takip Paneli › Çek · Senet sekmesiyle aynı sıra ve adlar:
                const DEFAULT_COLUMN_ORDER = [
                    'Checkbox',
                    'CekNumarasi',      // Belge · No (belge tipi, X / R ve banka altında)
                    'VadeTarihi',       // Vade (vade durumu altında)
                    'CekKimdenGeldi',   // Kimden Geldi (keşideci altında)
                    'CekIslemTuru',     // İşlem Türü
                    'Dolasim',          // Dolaşım (Kasa Nakit Akışı dolaşım planı zinciri)
                    'Kaynak',           // Satır Kaynağı · İşlem
                    'PlanlananTedarikci', // Planlanan Tedarikçi (Kasa Nakit Akışı'ndan)
                    'CekKimeVerildi',   // İbraz / Ciro · Kime Çıktı (çıkış türü, tarih, ibraz belgesi altında)
                    'Tutar',            // Tutar (dövizde PB ve TL karşılığı altında)
                    'NakitAkis',        // Nakit Akış Eşleşmesi
                    'Kontrol',          // Plan ↔ İbraz Kontrolü
                    'UygunlukDurumu',   // Uygunluk
                    'Fis'               // Muhasebe Fişi
                ];

                // Kalan bütün alanlar belge detayında ("Sütunlar"dan tabloya da açılabilir).
                const DEFAULT_HIDDEN_COLUMNS = [
                    'BelgeTipi', 'HareketDurumu', 'Aciklama', 'KonumDurumu', 'KullanimDurumu', 'VadeDurumu', 'ParaBirimi', 'TlKarsiligi',
                    'VadeAyiVeYili', 'PortfoyeGirisTarihi', 'PortfoyVadeAyiYili', 'IbrazTarihi', 'AsilBorclu', 'VadeliCekIbrazi', 'BankaAdi',
                    'Sube', 'IbrazBelgeNo', 'TahsilatBelgeNo', 'IslemTipiAdi'
                ];

                function createInitialConfig() {
                    if (!table) return [];
                    const basliklar = Array.from(table.querySelectorAll('thead tr.main-header-row th'));
                    return basliklar.map((header, index) => {
                        const ad = header.dataset.column;
                        const sira = DEFAULT_COLUMN_ORDER.indexOf(ad);
                        return {
                            originalIndex: index,
                            // Sırası belirtilmeyenler (gizli kalanlar) sona atılır
                            newIndex: sira === -1 ? DEFAULT_COLUMN_ORDER.length + index : sira,
                            visible: !DEFAULT_HIDDEN_COLUMNS.includes(ad),
                            columnName: ad
                        };
                    });
                }

                let localData = localStorage.getItem(storageKey);
                let serverData = null;

                try {
                    const fetchUrl = `/CekAkibeti/GetUserTemplate${dbQueryString ? dbQueryString + '&' : '?'}raporAdi=CekAkibetiRapor2`;
                    const res = await fetch(fetchUrl);
                    if (res.ok) {
                        const data = await res.json();
                        if (data && data.sablonVerisi && data.sablonVerisi.length > 5) {
                            serverData = data.sablonVerisi;
                        }
                    }
                } catch (e) {
                    console.error("Sunucudan ayar çekilemedi.");
                }

                // Sade görünüme geçiş: kayıtlı eski sütun düzenleri bir kereliğine yok sayılır.
                const DUZEN_SURUMU = 'sade-v4';   // v4: Takip Paneli › Çek · Senet düzeni (Dolaşım, Satır Kaynağı · İşlem, Nakit Akış Eşleşmesi, Kontrol, Fiş)
                if (localStorage.getItem('cekAkibetiDuzenSurumu') !== DUZEN_SURUMU) {
                    localStorage.removeItem(storageKey);
                    localStorage.setItem('cekAkibetiDuzenSurumu', DUZEN_SURUMU);
                    localData = null;
                    serverData = null;
                }

                let finalConfigString = serverData || localData;

                if (finalConfigString) {
                    try {
                        const parsed = JSON.parse(finalConfigString);
                        // Eğer eski konfigte silinmiş IslemTuru varsa onu filtrele
                        const filteredParsed = parsed.filter(p => p.columnName !== 'IslemTuru');
                        if(filteredParsed && filteredParsed.length > 0) {
                            window.applyColumnConfig(filteredParsed);
                            localStorage.setItem(storageKey, JSON.stringify(filteredParsed));
                        } else {
                            window.applyColumnConfig(createInitialConfig());
                        }
                    } catch (e) {
                        window.applyColumnConfig(createInitialConfig());
                    }
                } else {
                    window.applyColumnConfig(createInitialConfig());
                }
                
                initializePage();
            }

            loadAndApplyColumnConfig();
            setTimeout(adjustLayoutHeight, 100);
            setTimeout(adjustLayoutHeight, 500);

            // ---------------------------------------------------------------
            // DURUM ÖZETİ · SENKRON (veri /CekAkibeti/Ozet) — Takip Paneli ile aynı dil
            // Planlı belge → "Tedarikçiye Çık" (plan satırı üzerinden ciro; Kasa Nakit Akışı ÖDENDİ, muhasebe fişi), portföydeki belge → "Nakit Akışa Gönder"
            // (çek / senet satırı açılır, belge Planlandı). Plansız belgede çıkış GMY onayına düşer. İşlemden sonra sayfa tazelenir (sürüm sayacı değişir).
            // ---------------------------------------------------------------
            const ozetPanel = document.getElementById('cekOzetPanel');
            let ozetVeri = null;
            const h = s => $('<div>').text(s === null || s === undefined ? '' : s).html();
            const tl = v => (Number(v) || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const kisa = v => (Number(v) || 0).toLocaleString('tr-TR', { maximumFractionDigits: 0 });
            const roz = (m, t) => '<span class="cek-roz ' + t + '">' + h(m) + '</span>';
            const kontrolRoz = k => k === 'Uyumlu' ? roz('Uyumlu', 'ok') : k === 'Farklı' ? roz('FARKLI', 'hata') : k === 'İbraz Bekliyor' ? roz('İbraz Bekliyor', 'uyari') : k === 'Plansız İbraz' ? roz('Plansız İbraz', 'bilgi') : '<span class="text-muted">—</span>';
            const planHucre = p => p.planDocEntry ? '<a href="' + h(p.planLink || '#') + '" target="_blank" class="fw-bold">#' + p.planDocEntry + '</a> ' + roz(p.planDurum || '', p.planDurum === 'ÖDENDİ' ? 'ok' : p.planDurum === 'Gecikti' ? 'hata' : 'bilgi') + '<small>' + (p.planTalimat ? 'talimat ' + h(p.planTalimat) : p.cikisTalebi ? '<span class="text-danger">GMY onayı bekliyor</span>' : 'talimat yok') + '</small>' : roz('Satır Yok', 'hata') + '<small>Çek Akıbeti\'nden planlı</small>';
            async function cekOzetYukle(sessiz) {
                try { const r = await fetch('/CekAkibeti/Ozet' + dbQueryString); ozetVeri = await r.json(); } catch (e) { ozetVeri = null; }
