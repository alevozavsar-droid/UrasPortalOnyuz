            function updatePaginationInfo(totalCount) { if (totalRecordsSpan) totalRecordsSpan.textContent = totalCount; }

            // ---------------------------------------------------------------
            // OTOMATİK SÜTUN GENİŞLİĞİ
            // Her sütun içindeki en uzun veriye (ve başlığına) göre ölçülür.
            // Görünür sütunların toplamı tabloya min-width olarak verilir: az
            // sütunda tablo ekrana sığar, çok sütunda yatay kaydırma çıkar.
            // ---------------------------------------------------------------
            const SUTUN_ALT_SINIR = { 'Checkbox': 34, 'IbrazBelgeNo': 96, 'PlanlananTedarikci': 130, 'CekIslemTuru': 120 };
            const SUTUN_UST_SINIR = 280;
            const HUCRE_DOLGUSU = 16;

            // Uzun metin taşıyan kolonlar. Tablo ekrana sığmıyorsa önce bunlar
            // daraltılır; içerik kırpılmaz, alt satıra geçer.
            const SARILABILIR_KOLONLAR = [
                'AsilBorclu', 'CekKimdenGeldi', 'CekKimeVerildi', 'IslemTipiAdi',
                'HareketDurumu', 'KonumDurumu', 'VadeDurumu', 'UygunlukDurumu', 'BelgeTipi'
            ];
            const SARILABILIR_UST_SINIR = 170;   // bu kolonlar en fazla bu kadar geniş başlar
            const SARILABILIR_ALT_SINIR = 76;    // daraltma bu değerin altına inmez

            let olcumCtx = null, olcumFontNormal = '', olcumFontKalin = '';

            function metinGenisligi(metin, kalinMi) {
                if (!olcumCtx) {
                    olcumCtx = document.createElement('canvas').getContext('2d');
                    const stil = getComputedStyle(table);
                    olcumFontNormal = stil.fontSize + ' ' + stil.fontFamily;
                    olcumFontKalin = '700 ' + olcumFontNormal;
                }
                olcumCtx.font = kalinMi ? olcumFontKalin : olcumFontNormal;
                return olcumCtx.measureText(metin == null ? '' : String(metin)).width;
            }

            function hucreMetni(item, colName) {
                if (['VadeTarihi', 'PortfoyeGirisTarihi', 'IbrazTarihi'].includes(colName)) {
                    return item[colName] ? new Date(item[colName]).toLocaleDateString('tr-TR') : '';
                }
                if (['Tutar', 'TlKarsiligi'].includes(colName)) {
                    const v = item[colName];
                    return (v == null) ? '' : v.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }
                return item[columnMappings[colName]] || '';
            }

            function sutunGenisliklerineUygula(data, colsToRender) {
                try {
                    const basliklar = new Map();
                    document.querySelectorAll('#rapor2Table thead .main-header-row th').forEach(function (th) {
                        basliklar.set(th.dataset.column, th);
                    });

                    let toplam = 0;
                    const olculenler = [];

                    (colsToRender || []).forEach(function (c) {
                        const th = basliklar.get(c.columnName);
                        if (!th) return;
                        if (c.visible === false) { th.style.width = ''; return; }

                        // Kullanici bu kolonu elle genislettiyse ona dokunma.
                        if (th.dataset.elleAyarlandi === '1') {
                            toplam += th.offsetWidth || 0;
                            return;
                        }

                        let enGenis = metinGenisligi((th.textContent || '').trim(), true) + 14; // sıralama ikonu payı

                        if (c.columnName !== 'Checkbox') {
                            // Önce karakter sayısıyla en uzun metni bul (ucuz),
                            // piksel ölçümünü yalnızca onun için yap (pahalı).
                            let enUzunMetin = '';
                            for (let i = 0; i < data.length; i++) {
                                const m = hucreMetni(data[i], c.columnName);
                                if (m && m.length > enUzunMetin.length) enUzunMetin = m;
                            }
                            const g = metinGenisligi(enUzunMetin, false);
                            if (g > enGenis) enGenis = g;
                        }

                        const sarilabilir = SARILABILIR_KOLONLAR.includes(c.columnName);

                        let genislik = Math.ceil(enGenis) + HUCRE_DOLGUSU;
                        genislik = Math.max(genislik, SUTUN_ALT_SINIR[c.columnName] || 44);
                        genislik = Math.min(genislik, sarilabilir ? SARILABILIR_UST_SINIR : SUTUN_UST_SINIR);

                        olculenler.push({ th: th, genislik: genislik, sarilabilir: sarilabilir });
                        toplam += genislik;
                    });

                    // Tablo ekrana sığmıyorsa sarılabilir kolonlardan orantılı kısılır;
                    // metin kırpılmaz, hücre içinde alt satıra geçer.
                    const kullanilabilir = table.parentElement ? table.parentElement.clientWidth : 0;
                    if (kullanilabilir > 40 && toplam > kullanilabilir) {
                        const esnekler = olculenler.filter(function (x) { return x.sarilabilir; });
                        const kisilabilir = esnekler.reduce(function (t, x) {
                            return t + Math.max(0, x.genislik - SARILABILIR_ALT_SINIR);
                        }, 0);
                        if (kisilabilir > 0) {
                            const oran = Math.min(1, (toplam - kullanilabilir) / kisilabilir);
                            esnekler.forEach(function (x) {
                                const kis = Math.floor(Math.max(0, x.genislik - SARILABILIR_ALT_SINIR) * oran);
                                x.genislik -= kis;
                                toplam -= kis;
                            });
                        }
                    }

                    olculenler.forEach(function (x) { x.th.style.width = x.genislik + 'px'; });
                    table.style.minWidth = toplam > 0 ? toplam + 'px' : '';
                } catch (e) {
                    table.style.minWidth = '';
                }
            }

            function updateSelectAllCheckboxState() {
                if (!selectAllCheckbox) return;

                const toplam = cizimVerisi.length;
                let secili = 0;
                cizimVerisi.forEach(function (item) { if (seciliSet.has(item.DocEntry)) secili++; });

                selectAllCheckbox.checked = (toplam > 0 && secili === toplam);
                selectAllCheckbox.indeterminate = (secili > 0 && secili < toplam);
            }

            function saveRowOriginalClass(row) {
                if (ORIGINAL_ROW_CLASSES.has(row)) return;
                let originalClass = '';
                row.classList.forEach(className => { if (BOOTSTRAP_COLOR_CLASSES.includes(className)) originalClass = className; });
                ORIGINAL_ROW_CLASSES.set(row, originalClass);
            }

            window.getTahsilatDetay = function(no) {
                if(!no) return;
                $('#detayBody').html('<div class="text-center py-3"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i></div>');
                $('#detayModal').modal('show');
                $.get(`/CekAkibeti/GetTahsilatDetay?no=${no}${dbQueryString.replace('?','&')}`, function(data) {
                    $('#detayBody').html(data);
                }).fail(function() {
                    $('#detayBody').html('<div class="alert alert-danger">Detay yüklenirken hata oluştu.</div>');
                });
            }

            window.getIbrazDetay = function(no) {
                if(!no) return;
                $('#detayBody').html('<div class="text-center py-3"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i></div>');
                $('#detayModal').modal('show');
                $.get(`/CekAkibeti/GetIbrazDetay?no=${no}${dbQueryString.replace('?','&')}`, function(data) {
                    $('#detayBody').html(data);
                }).fail(function() {
                    $('#detayBody').html('<div class="alert alert-danger">Detay yüklenirken hata oluştu.</div>');
                });
            }

            function renderTable(data) {
                tableBody.innerHTML = '';
                if (data.length === 0) {
                    tableBody.innerHTML = '<tr><td colspan="28" class="text-center py-4 fw-bold text-muted">Gösterilecek veri bulunamadı.</td></tr>';
                    updatePaginationInfo(0);
                    return;
                }
                
                let colsToRender = [];
                if (window.currentColumnConfig && window.currentColumnConfig.length > 0) {
                    colsToRender = window.currentColumnConfig;
                } else {
                    colsToRender = window.currentColumnNames.map((c, i) => ({ columnName: c, visible: true, newIndex: i }));
                }
                
                const dateColumns = ['VadeTarihi', 'PortfoyeGirisTarihi', 'IbrazTarihi'];
                const numColumns = ['Tutar', 'TlKarsiligi'];

                cizimSatirYapici = function (item) {
                    const row = document.createElement('tr');
                    const rowClass = item.HareketDurumu ? {
                        'Portföyde': 'table-info',
                        'İşlem Yapıldı': 'table-secondary',
                        'İade Edildi': 'table-danger',
                    }[item.HareketDurumu.trim()] || '' : '';

                    if (rowClass) row.classList.add(rowClass);
                    row.dataset.docentry = item.DocEntry;
                    row.dataset.ibrazBelgeNo = item.IbrazBelgeNo;

                    colsToRender.forEach(colConfig => {
                        const colName = colConfig.columnName;
                        const cell = document.createElement('td');
                        cell.dataset.column = colName;
                        
                        if (!colConfig.visible) {
                            cell.style.display = 'none';
                        }

                        if (colName === 'Checkbox') {
                            cell.classList.add('checkbox-column');
                            const checkbox = document.createElement('input');
                            checkbox.type = 'checkbox';
                            checkbox.className = 'form-check-input row-selector';
                            checkbox.dataset.tlValue = item.TlKarsiligi || 0;
                            cell.appendChild(checkbox);
                        } 
                        else if (colName === 'IbrazBelgeNo') {
                            if (item.IbrazBelgeNo) {
                                const container = document.createElement('div');
                                container.className = "d-flex align-items-center justify-content-between";
                                
                                const detailLink = document.createElement('span');
                                detailLink.className = "detail-link fw-bold";
                                detailLink.textContent = item.IbrazBelgeNo;
                                detailLink.onclick = (e) => { e.stopPropagation(); window.getIbrazDetay(item.IbrazBelgeNo); };
                                container.appendChild(detailLink);

                                const attLink = document.createElement('a');
                                attLink.href = `/CekAkibeti/DownloadAttachment/${item.IbrazBelgeNo}`;
                                attLink.title = 'Eki İndir/Görüntüle';
                                attLink.target = '_blank';
                                attLink.className = "text-decoration-none text-primary ms-2";
                                attLink.innerHTML = '<i class="fas fa-paperclip"></i>';
                                attLink.onclick = (e) => { e.stopPropagation(); };
                                container.appendChild(attLink);

                                cell.appendChild(container);
                            }
                        } 
                        else if (colName === 'TahsilatBelgeNo') {
                            if (item.TahsilatBelgeNo) {
                                const detailLink = document.createElement('span');
                                detailLink.className = "detail-link fw-bold";
                                detailLink.textContent = item.TahsilatBelgeNo;
                                detailLink.onclick = (e) => { e.stopPropagation(); window.getTahsilatDetay(item.TahsilatBelgeNo); };
                                cell.appendChild(detailLink);
                            }
                        }
                        else if (colName === 'CekIslemTuru') {
                            const select = document.createElement('select');
                            select.className = 'check-transaction-select shadow-sm';
                            select.dataset.docentry = item.DocEntry;
                            select.dataset.ibrazBelgeNo = item.IbrazBelgeNo;
                            select.dataset.tahsilatBelgeNo = item.TahsilatBelgeNo;
                            select.dataset.previousValue = item.CekIslemTuru;

                            const emptyOption = document.createElement('option');
                            emptyOption.value = ''; emptyOption.textContent = 'Seçiniz';
                            select.appendChild(emptyOption);

                            checkTransactionTypesJs.forEach(type => {
                                if (type.Code !== "0" && type.Code !== "12") {
                                    const option = document.createElement('option');
                                    option.value = type.Code;
                                    option.textContent = type.Description;
                                    if (item.CekIslemTuru == type.Code) option.selected = true;
                                    select.appendChild(option);
                                }
                            });

                            select.disabled = item.HareketDurumu === 'İade Edildi';
                            select.addEventListener('change', async function() {
                                const newType = this.value;
                                const tahsilatNo = this.dataset.tahsilatBelgeNo;
                                const ibrazNo = this.dataset.ibrazBelgeNo;
                                let isSuccess = false;

                                if (ibrazNo && ibrazNo !== 'null' && ibrazNo !== '') isSuccess = await updateCheckTransactionTypeByIbrazBelge(ibrazNo, newType);
                                else if (tahsilatNo && tahsilatNo !== 'null' && tahsilatNo !== '') isSuccess = await updateCheckTransactionTypeByTahsilat(tahsilatNo, newType);
                                else { toastr.warning("Güncellenecek belge numarası bulunamadı."); this.value = this.dataset.previousValue; return; }

                                if (isSuccess) {
                                    this.dataset.previousValue = newType;
                                    toastr.success("İşlem başarıyla güncellendi. Yeni hesaplamaların yansıması için sayfayı yenileyiniz.");
                                }
                            });
                            cell.appendChild(select);
                        } 
                        else if (colName === 'PlanlananTedarikci') {
                            const input = document.createElement('input');
                            input.type = 'text';
                            input.className = 'planned-supplier-input shadow-sm';
                            input.setAttribute('list', `suppliersList_${item.DocEntry}`);
                            input.value = item.PlanlananTedarikci || '';
                            input.dataset.docentry = item.DocEntry;
                            input.dataset.previousValue = item.PlanlananTedarikci;
                            
                            const datalist = document.createElement('datalist');
                            datalist.id = `suppliersList_${item.DocEntry}`;

                            input.addEventListener('input', async function() {
                                const currentText = this.value.trim();
                                if (currentText.length >= 2) {
                                    try {
                                        const response = await fetch(`/CekAkibeti/SearchSuppliers${dbQueryString}${dbQueryString ? '&' : '?'}term=${encodeURIComponent(currentText)}`);
                                        if (response.ok) {
                                            const suppliers = await response.json();
                                            datalist.innerHTML = '';
                                            suppliers.forEach(supplier => {
                                                const option = document.createElement('option');
                                                option.value = supplier;
                                                datalist.appendChild(option);
                                            });
                                        }
                                    } catch (error) { console.error('Tedarikçi arama hatası:', error); }
                                } else if (currentText.length === 0) datalist.innerHTML = '';
                            });
                            input.addEventListener('focusout', async function() {
                                const docEntry = parseInt(this.dataset.docentry);
                                const newValue = this.value.trim();
                                const previousValue = this.dataset.previousValue;
                                if (newValue !== previousValue) await updatePlannedSupplier(docEntry, newValue);
                            });
                            input.addEventListener('keydown', function(event) {
                                if (event.key === 'Enter') { event.preventDefault(); this.blur(); }
                            });
                            cell.appendChild(input);
                            cell.appendChild(datalist);
                        } 
                        else if (colName === 'CekNumarasi') {
                            const bag = document.createElement('span');
                            bag.className = 'cek-no-link';
                            bag.dataset.docentry = item.DocEntry;
                            bag.textContent = item.CekNumarasi || '';
                            bag.title = 'Detayları görmek için tıklayın';
                            cell.appendChild(bag);
                        }
                        else {
                            let valText = '';
                            
                            if (dateColumns.includes(colName)) {
                                valText = item[colName] ? new Date(item[colName]).toLocaleDateString('tr-TR') : '';
                                cell.classList.add("text-center"); 
                            } else if (numColumns.includes(colName)) {
                                valText = item[colName]?.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) ?? '';
                                cell.classList.add("text-end", "fw-bold"); 
                            } else {
                                valText = item[columnMappings[colName]] || '';
                            }

                            cell.textContent = valText;
                            if(valText) cell.title = valText;

                            if (colName === 'UygunlukDurumu') {
                                if (valText === 'Uygun') cell.classList.add("text-success", "fw-bold");
                                if (valText === 'Uygun Değil') cell.classList.add("text-danger");
                            }
                            if (colName === 'Aciklama') cell.classList.add("text-primary", "fw-bold");
                        }

                        row.appendChild(cell);
                    });
                    saveRowOriginalClass(row);

                    if (seciliSet.has(item.DocEntry)) {
                        const kutu = row.querySelector('.row-selector');
                        if (kutu) kutu.checked = true;
                        BOOTSTRAP_COLOR_CLASSES.forEach(c => row.classList.remove(c));
                        row.classList.add('selected-hover');
                    }

                    return row;
                };

                cizimVerisi = data;
                cizilenAdet = 0;

                sutunGenisliklerineUygula(data, colsToRender);
                sonrakiParcayiCiz();

                updatePaginationInfo(data.length);
                calculateSelectedTotal();
                updateSelectAllCheckboxState();

                adjustLayoutHeight();
            }

            // ---------------------------------------------------------------
            // Parça parça çizim: tablo bir kerede değil, kaydırdıkça dolar.
            // ---------------------------------------------------------------
            function sonrakiParcayiCiz() {
                if (!cizimSatirYapici || cizilenAdet >= cizimVerisi.length) return;

                const son = Math.min(cizilenAdet + PARCA_BOYUTU, cizimVerisi.length);
                const frag = document.createDocumentFragment();

                for (let i = cizilenAdet; i < son; i++) {
                    frag.appendChild(cizimSatirYapici(cizimVerisi[i]));
                }

                tableBody.appendChild(frag);
                cizilenAdet = son;
                cizimDurumunuGuncelle();
            }

            function cizimDurumunuGuncelle() {
                const bilgi = document.getElementById('cizimDurumu');
                if (!bilgi) return;
                bilgi.textContent = (cizilenAdet >= cizimVerisi.length)
                    ? ''
                    : cizilenAdet + ' / ' + cizimVerisi.length + ' satır';
            }

            window.filterTableAndRender = function() {
                const filters = {};
                $('.filter-select-bs').each(function () {
                    const selectElement = $(this);
                    const columnKey = selectElement.closest('th').data('column');
                    const selectedValues = selectElement.val();
                    if (selectedValues && selectedValues.length > 0) filters[columnKey] = selectedValues.map(v => (v || '').toLowerCase().trim());
                });

                const textFilters = {};
                $('.column-text-filter').each(function() {
                    const inputEl = $(this);
                    const columnKey = inputEl.closest('th').data('column');
                    const val = inputEl.val().toLowerCase().trim();
                    if(val) textFilters[columnKey] = val;
                });

                let filteredData = allReportData.filter(item => {
                    let isMatch = true;

                    for (const column in filters) {
                        const filterValues = filters[column];
                        const propName = columnMappings[column];
                        if (!propName) continue;

                        let itemValue = item[propName];
                        if (itemValue === null || itemValue === undefined) itemValue = '';
                        else if (propName.includes('Tarihi')) {
                            const date = new Date(itemValue);
                            itemValue = isNaN(date.getTime()) ? '' : date.toLocaleDateString('tr-TR');
                        } else if (typeof itemValue === 'number') {
                            itemValue = itemValue.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        } else itemValue = itemValue.toString();

                        itemValue = itemValue.toLowerCase().trim();
                        if (filterValues.length > 0 && !filterValues.includes(itemValue)) { isMatch = false; break; }
                    }

                    if (isMatch) {
                        for (const column in textFilters) {
                            const propName = columnMappings[column];
                            if (!propName) continue;
                            let itemValue = (item[propName] || '').toString().toLowerCase().trim();
                            if (!itemValue.includes(textFilters[column])) { isMatch = false; break; }
                        }
                    }

                    if (isMatch && activeYearFilter !== 'all') {
                        if (item.VadeTarihi) {
                            const itemDate = new Date(item.VadeTarihi);
                            if (itemDate.getFullYear().toString() !== activeYearFilter) isMatch = false;
                        } else isMatch = false;
                    }
                    return isMatch;
                });

                if (currentSortColumn && currentSortDirection !== 'none') {
                    const sortType = document.querySelector(`th[data-column="${currentSortColumn}"]`)?.dataset.sortType;
                    const propName = columnMappings[currentSortColumn];
                    filteredData.sort((itemA, itemB) => {
                        let valA = itemA[propName]; let valB = itemB[propName];
                        if (valA === null || valA === undefined) valA = '';
                        if (valB === null || valB === undefined) valB = '';

                        let comparison = 0;
                        if (sortType === 'number') {
                            const numA = parseFloat(valA.toString().replace(/\./g, '').replace(',', '.') || 0);
                            const numB = parseFloat(valB.toString().replace(/\./g, '').replace(',', '.') || 0);
                            comparison = numA - numB;
                        } else if (sortType === 'date') {
                            const dateA = valA ? new Date(valA) : null;
                            const dateB = valB ? new Date(valB) : null;
                            if (dateA === null && dateB === null) comparison = 0;
                            else if (dateA === null) comparison = 1;
                            else if (dateB === null) comparison = -1;
                            else comparison = dateA.getTime() - dateB.getTime();
                        } else comparison = (valA || '').localeCompare((valB || ''), 'tr', { sensitivity: 'base' });
                        
                        return currentSortDirection === 'asc' ? comparison : -comparison;
                    });
                }

                currentlyFilteredRows = filteredData;
                renderTable(currentlyFilteredRows);
                calculateSummaryCards();
            }

