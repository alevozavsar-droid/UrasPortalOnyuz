                        <th><input type="text" class="filter-input" data-column="HesaplananVadeTarihi" placeholder="Ara..." /></th>
                        <th>
                            <select class="form-select form-select-sm filter-select-bs" multiple
                                    data-live-search="true" data-actions-box="true"
                                    data-selected-text-format="count > 2" data-width="100%"
                                    title="Tümü" data-column="HesaplananVadeAyYil">
                            </select>
                        </th>
                        <th>
                            <select class="form-select form-select-sm filter-select-bs" multiple
                                    data-live-search="true" data-actions-box="true"
                                    data-selected-text-format="count > 2" data-width="100%"
                                    title="Tümü" data-column="MusteriAdi">
                            </select>
                        </th>
                        <th>
                            <select class="form-select form-select-sm filter-select-bs" multiple
                                    data-live-search="true" data-actions-box="true"
                                    data-selected-text-format="count > 2" data-width="100%"
                                    title="Tümü" data-column="MusteriGrubu">
                            </select>
                        </th>
                        <th><input type="text" class="filter-input" data-column="SiparisBelgeTutari" placeholder="Ara..." /></th>
                        <th><input type="text" class="filter-input" data-column="KDVsizSiparisBelgeTutari" placeholder="Ara..." /></th>
                        <th>
                            <select class="form-select form-select-sm filter-select-bs" multiple
                                    data-live-search="true" data-actions-box="true"
                                    data-selected-text-format="count > 2" data-width="100%"
                                    title="Tümü" data-column="BelgeParaBirimi">
                            </select>
                        </th>
                        <th>
                            <select class="form-select form-select-sm filter-select-bs" multiple
                                    data-live-search="true" data-actions-box="true"
                                    data-selected-text-format="count > 2" data-width="100%"
                                    title="Tümü" data-column="SatisTemsilcisi">
                            </select>
                        </th>
                        <th><input type="text" class="filter-input" data-column="OdemeKosuluGrubu" placeholder="Ara..." /></th>
                        <th><input type="text" class="filter-input" data-column="SiparisTLTutariGuncelKur" placeholder="Ara..." /></th>
                        <th><input type="text" class="filter-input" data-column="ToplamFaturaTutariFaturaPB" placeholder="Ara..." /></th>
                        <th><input type="text" class="filter-input" data-column="ToplamFaturaTutariTL" placeholder="Ara..." /></th>
                        <th><input type="text" class="filter-input" data-column="ToplamOdenenTutarFaturaPB" placeholder="Ara..." /></th>
                        <th><input type="text" class="filter-input" data-column="ToplamOdenenTutarTL" placeholder="Ara..." /></th>
                        <th><input type="text" class="filter-input" data-column="KalanTutarFaturaPB" placeholder="Ara..." /></th>
                        <th><input type="text" class="filter-input" data-column="KalanTutarTL" placeholder="Ara..." /></th>
                        <th><input type="text" class="filter-input" data-column="MusteriGuncelBakiyesi" placeholder="Ara..." /></th>
                        <th><input type="text" class="filter-input" data-column="VadesiGecmisFaturaTutariTL" placeholder="Ara..." /></th>
                    </tr>
                </thead>
                <tbody id="salesOrderTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        const activeSalesEmployees = @Html.Raw(Json.Serialize(ViewBag.AllSalesEmployees));

        // Aktif Şirketi JavaScript tarafında hafızaya alıyoruz
        const activeDbCode = '@currentDb';

        let currentPage = 1;
        const pageSize = 300;
        let currentSortColumn = "BelgeTarihi";
        let currentSortDirection = "desc";
        let isUpdatingDropdowns = false;

        // Global Filtre Temizleyici
        window.clearReportFilters = function() {
            $('.filter-input').val('');
            $('.filter-select-bs').selectpicker('val', '');
            applyFilters();
        };

        function buildFilterObject() {
            const filters = {};
            $('.filter-input').each(function () {
                const col = $(this).data('column');
                const val = $(this).val().trim();
                if (val) filters[col] = val;
            });
            $('.filter-select-bs').each(function () {
                const col  = $(this).data('column');
                const vals = $(this).val();
                if (vals && vals.length > 0) filters[col] = vals.join('|||');
            });
            return filters;
        }

        function updateDropdowns(currentFilters) {
            $.ajax({
                url: '/Rapor4/GetDynamicFilters',
                type: 'GET',
                data: { filters: JSON.stringify(currentFilters), db: activeDbCode },
                success: function (r) {
                    isUpdatingDropdowns = true;
                    updateSelect('BelgeTarihi',        r.belgeTarihiList);
                    updateSelect('BelgeAyYil',         r.belgeAyiList);
                    updateSelect('HesaplananVadeAyYil', r.vadeAyiList);
                    updateSelect('MusteriAdi',         r.musteriAdiList);
                    updateSelect('MusteriGrubu',       r.musteriGrubuList);
                    updateSelect('SatisTemsilcisi',     r.satisTemsilcisiList);
                    updateSelect('BelgeParaBirimi',     r.belgeParaBirimiList);
                    isUpdatingDropdowns = false;
                }
            });
        }

        function updateSelect(columnName, newList) {
            const sel = $(`select.filter-select-bs[data-column="${columnName}"]`);
            if (!sel.length) return;

            let selected = sel.val() || [];
            if (!Array.isArray(selected)) selected = [selected];

            const unique = newList
                ? [...new Set(newList.map(i => String(i).trim()).filter(Boolean))]
                : [];

            selected.forEach(s => { if (!unique.includes(s)) unique.push(s); });

            let html = '';
            unique.forEach(item => {
                const esc = item.replace(/"/g, '&quot;');
                html += `<option value="${esc}">${item}</option>`;
            });
            sel.html(html);

            sel.val(selected);
            sel.selectpicker('refresh');
        }

        function fetchData() {
            const overlay = $('#loadingOverlay');
            const body    = $('#salesOrderTableBody');

            $('.sortable-column i.fas')
                .removeClass('fa-sort-up fa-sort-down text-primary')
                .addClass('fa-sort text-secondary');
            $(`.sortable-column[data-column="${currentSortColumn}"]`).find('i.fas')
                .removeClass('fa-sort text-secondary')
                .addClass((currentSortDirection === 'asc' ? 'fa-sort-up' : 'fa-sort-down') + ' text-primary');

            overlay.show();
            $('#selectAllCheckbox, #selectAllFilterCheckbox').prop('checked', false).prop('indeterminate', false);
            
            // Seçili değerleri sıfırla
            $('#kpiSelectedCount').text('0');
            $('#kpiSelectedTotalAmount').text('0,00 ₺');
            $('#kpiSelectedTotalKDVsiz').text('0,00 ₺');
            $('#selectedTotalAmount').text('0,00 TL');
            $('#selectedTotalKDVsiz').text('0,00 TL');

            const filters = buildFilterObject();

            $.ajax({
                url: '/Rapor4/GetData',
                type: 'GET',
                data: {
                    page: currentPage,
                    pageSize: pageSize,
                    sortColumn: currentSortColumn,
                    sortDirection: currentSortDirection,
                    filters: JSON.stringify(filters),
                    db: activeDbCode
                },
                success: function (res) {
                    if (res.data) {
                        renderTable(res.data);
                        renderPagination(res.totalRecords);
                        $('#kpiTotalRecords').text(res.totalRecords.toLocaleString('tr-TR'));
                        $('#totalRecordsCount').text(res.totalRecords.toLocaleString('tr-TR'));
                    } else {
                        toastr.error(res.message || 'Veri çekilirken hata oluştu.');
                        body.empty().append('<tr><td colspan="23" class="text-center text-muted py-5"><i class="fas fa-folder-open fa-3x mb-3 opacity-25"></i><br>Gösterilecek belge bulunamadı.</td></tr>');
                        $('#kpiTotalRecords').text('0');
                        $('#totalRecordsCount').text('0');
                        $('#pagination').empty();
                    }
                },
                error: function () {
                    toastr.error('Veri yüklenemedi. Sunucu hatası.');
                    body.empty().append('<tr><td colspan="23" class="text-center text-danger py-5"><i class="fas fa-exclamation-triangle fa-3x mb-3 opacity-25"></i><br>Veri yüklenirken hata oluştu.</td></tr>');
                    $('#kpiTotalRecords').text('0');
                    $('#totalRecordsCount').text('0');
                    $('#pagination').empty();
                },
                complete: function () { overlay.hide(); }
            });
        }

        function applyFilters() {
            currentPage = 1;
            const filters = buildFilterObject();
            fetchData();
            updateDropdowns(filters);
        }

        function renderTable(data) {
            const body = $('#salesOrderTableBody');
            body.empty();
            if (!data.length) {
                body.append('<tr><td colspan="23" class="text-center text-muted py-5"><i class="fas fa-folder-open fa-3x mb-3 opacity-25"></i><br>Gösterilecek belge bulunamadı.</td></tr>');
                return;
            }

            data.forEach(item => {
                const row = $('<tr>')
                    .attr('data-docentry', item.docEntry)
                    .attr('data-slpcode', item.slpCode);

                row.append(`<td class="text-center"><input type="checkbox" class="form-check-input m-0 row-selector" /></td>`);
                row.append(`<td class="fw-bold" title="${item.belgeNumarasi}">${item.belgeNumarasi}</td>`);

                const bClass = item.belgeTipi === 'İade' ? 'badge-soft-danger' : 'badge-soft-primary';
                row.append(`<td class="text-center" data-belgetipi="${item.belgeTipi}">
                                <span class="${bClass} w-100">${item.belgeTipi}</span>
                            </td>`);

                row.append(`<td class="text-center">${item.belgeTarihi}</td>`);
                row.append(`<td class="text-center">${item.belgeAyYil}</td>`);
                row.append(`<td class="text-center">${item.hesaplananVadeTarihi}</td>`);
                row.append(`<td class="text-center">${item.hesaplananVadeAyYil}</td>`);
                row.append(`<td class="fw-medium text-dark col-truncate-md" title="${item.musteriAdi}">${item.musteriAdi}</td>`);
                row.append(`<td><span class="badge-soft-secondary">${item.musteriGrubu || ''}</span></td>`);
                row.append(`<td class="num" data-numeric-value="${item.siparisBelgeTutari}">${formatNumber(item.siparisBelgeTutari)}</td>`);
                row.append(`<td class="num text-muted" data-numeric-value="${item.kdVsizSiparisBelgeTutari}" data-column="KDVsizSiparisBelgeTutari">${formatNumber(item.kdVsizSiparisBelgeTutari)}</td>`);
                row.append(`<td class="text-center"><span class="badge-soft-secondary border">${item.belgeParaBirimi}</span></td>`);

                let slpHtml = `<select class="form-select form-select-sm inline-slp-select"
                                        data-docentry="${item.docEntry}"
                                        data-belgetipi="${item.belgeTipi}"
                                        data-original-val="${item.slpCode}"
                                        title="${item.satisTemsilcisi}">`;
                let aktif = false;
                if (activeSalesEmployees) {
                    activeSalesEmployees.forEach(emp => {
                        const sel = emp.slpCode === item.slpCode ? 'selected' : '';
                        if (sel) aktif = true;
                        slpHtml += `<option value="${emp.slpCode}" ${sel}>${emp.slpName}</option>`;
                    });
                }
                if (!aktif && item.slpCode !== 0 && item.slpCode !== null) {
                    slpHtml += `<option value="${item.slpCode}" selected>${item.satisTemsilcisi} (Pasif)</option>`;
                }
                slpHtml += `</select>`;
                row.append(`<td style="padding:4px;">${slpHtml}</td>`);

                row.append(`<td class="text-muted">${item.odemeKosuluGrubu || ''}</td>`);
                row.append(`<td class="num fw-medium text-primary" data-numeric-value="${item.siparisTLTutariGuncelKur}">${formatNumber(item.siparisTLTutariGuncelKur)}</td>`);
                row.append(`<td class="num" data-numeric-value="${item.toplamFaturaTutariFaturaPB}">${formatNumber(item.toplamFaturaTutariFaturaPB)}</td>`);
                row.append(`<td class="num fw-bold text-dark" data-numeric-value="${item.toplamFaturaTutariTL}" data-column="ToplamFaturaTutariTL">${formatNumber(item.toplamFaturaTutariTL)}</td>`);
                row.append(`<td class="num text-muted" data-numeric-value="${item.toplamOdenenTutarFaturaPB}">${formatNumber(item.toplamOdenenTutarFaturaPB)}</td>`);
                row.append(`<td class="num text-muted" data-numeric-value="${item.toplamOdenenTutarTL}">${formatNumber(item.toplamOdenenTutarTL)}</td>`);
                row.append(`<td class="num text-muted" data-numeric-value="${item.kalanTutarFaturaPB}">${formatNumber(item.kalanTutarFaturaPB)}</td>`);
                row.append(`<td class="num fw-bold text-primary" data-numeric-value="${item.kalanTutarTL}" data-column="KalanTutarTL">${formatNumber(item.kalanTutarTL)}</td>`);

                const bakiyeClass = (item.musteriGuncelBakiyesi || 0) > 0 ? 'text-danger' : 'text-success';
                row.append(`<td class="num" data-numeric-value="${item.musteriGuncelBakiyesi}"><span class="${bakiyeClass} fw-medium">${formatNumber(item.musteriGuncelBakiyesi)}</span></td>`);

                const vadesiClass = (item.vadesiGecmisFaturaTutariTL || 0) > 0 ? 'text-danger' : 'text-success';
                row.append(`<td class="num" data-numeric-value="${item.vadesiGecmisFaturaTutariTL}"><span class="${vadesiClass} fw-medium">${formatNumber(item.vadesiGecmisFaturaTutariTL)}</span></td>`);

                body.append(row);
            });
        }

        function renderPagination(totalRecords) {
            const cont = $('#pagination');
            const totalPages = Math.ceil(totalRecords / pageSize);
            cont.empty();
            if (totalPages <= 1) return;

            const max = 5;
            let start = Math.max(1, currentPage - Math.floor(max / 2));
            let end   = Math.min(totalPages, start + max - 1);
            if (end - start + 1 < max) start = Math.max(1, end - max + 1);

            const prev = $(`<li class="page-item ${currentPage === 1 ? 'disabled' : ''}"><a class="page-link" href="#">&laquo;</a></li>`);
            prev.on('click', e => { e.preventDefault(); if (currentPage > 1) { currentPage--; fetchData(); } });
            cont.append(prev);

            for (let i = start; i <= end; i++) {
                const li = $(`<li class="page-item ${i === currentPage ? 'active' : ''}"><a class="page-link" href="#">${i}</a></li>`);
                li.on('click', (pg => e => { e.preventDefault(); if (pg !== currentPage) { currentPage = pg; fetchData(); } })(i));
                cont.append(li);
            }

            const next = $(`<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}"><a class="page-link" href="#">&raquo;</a></li>`);
            next.on('click', e => { e.preventDefault(); if (currentPage < totalPages) { currentPage++; fetchData(); } });
            cont.append(next);
        }

        function formatNumber(value) {
            if (value === null || value === undefined || isNaN(value)) return '0,00';
            return parseFloat(value).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function calculateSelectedTotal() {
            let totalAmount = 0, totalKDV = 0;
            let selectedCount = 0;

            $('#salesOrderTable tbody tr.selected').each(function () {
                selectedCount++;
                const tipi    = $(this).find('td[data-belgetipi]').data('belgetipi');
                const tlCell  = $(this).find('td[data-column="ToplamFaturaTutariTL"]');
                const kdvCell = $(this).find('td[data-column="KDVsizSiparisBelgeTutari"]');
                const mult    = tipi === 'İade' ? -1 : 1;
                
                if (tlCell.length)  { const v = parseFloat(tlCell.data('numeric-value'));  if (!isNaN(v)) totalAmount += mult * v; }
                if (kdvCell.length) { const v = parseFloat(kdvCell.data('numeric-value')); if (!isNaN(v)) totalKDV    += mult * v; }
            });

            // Üstteki mini toolbar ve KPI kartları için güncellemeler
            $('#selectedTotalAmount').text(formatNumber(totalAmount) + ' TL');
            $('#selectedTotalKDVsiz').text(formatNumber(totalKDV) + ' TL');
            
            $('#kpiSelectedCount').text(selectedCount.toLocaleString('tr-TR'));
            $('#kpiSelectedTotalAmount').text(formatNumber(totalAmount) + ' ₺');
            $('#kpiSelectedTotalKDVsiz').text(formatNumber(totalKDV) + ' ₺');
        }

        function updateSelectAllState() {
            const boxes   = $('#salesOrderTableBody .row-selector');
            const allChk  = boxes.length > 0 && boxes.toArray().every(cb => cb.checked);
            const anyChk  = boxes.toArray().some(cb => cb.checked);
            $('#selectAllCheckbox, #selectAllFilterCheckbox')
                .prop('checked', allChk)
                .prop('indeterminate', !allChk && anyChk);
        }

        function debounce(fn, wait) {
            let t;
            return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), wait); };
        }

        $(document).ready(function () {

            $('.filter-select-bs').selectpicker({
                liveSearch: true,
                actionsBox: true,
                selectAllText: 'Tümünü Seç',
                deselectAllText: 'Tümünü Kaldır',
                selectedTextFormat: 'count > 2',
                width: '100%',
                container: 'body'
            });

            $(document).on('changed.bs.select', '.filter-select-bs', function () {
                if (isUpdatingDropdowns) return;
                applyFilters();
            });

            const debouncedApply = debounce(applyFilters, 600);
            $('.filter-input').on('input', debouncedApply);

            $('#salesOrderTable').on('click', '.sortable-column', function () {
                const col = $(this).data('column');
                currentSortDirection = (currentSortColumn === col && currentSortDirection === 'asc') ? 'desc' : 'asc';
                currentSortColumn = col;
                currentPage = 1;
                fetchData();
            });

            updateDropdowns({});
            fetchData();

            $(document).on('click', '#salesOrderTable tbody tr', function (e) {
                if (!$(e.target).is('input, select, option, button')) {
                    const cb = $(this).find('.row-selector');
                    cb.prop('checked', !cb.prop('checked'));
                    $(this).toggleClass('selected', cb.prop('checked'));
                    calculateSelectedTotal();
                    updateSelectAllState();
                }
            });

            $(document).on('change', '.row-selector', function () {
                $(this).closest('tr').toggleClass('selected', this.checked);
                calculateSelectedTotal();
                updateSelectAllState();
            });

            $(document).on('change', '#selectAllCheckbox, #selectAllFilterCheckbox', function () {
                const checked = $(this).prop('checked');
                $('#selectAllCheckbox, #selectAllFilterCheckbox').prop('checked', checked).prop('indeterminate', false);
                $('#salesOrderTableBody .row-selector').prop('checked', checked).closest('tr').toggleClass('selected', checked);

                if (checked) {
                    $('#loadingOverlay').show();
                    $.ajax({
                        url: '/Rapor4/GetTotalAmount',
                        type: 'GET',
                        data: { filters: JSON.stringify(buildFilterObject()), db: activeDbCode },
                        success: function (r) {
                            if (r.success) {
                                $('#selectedTotalAmount').text(formatNumber(r.totalAmount) + ' TL');
                                $('#selectedTotalKDVsiz').text(formatNumber(r.totalKDVsiz) + ' TL');

                                $('#kpiSelectedTotalAmount').text(formatNumber(r.totalAmount) + ' ₺');
                                $('#kpiSelectedTotalKDVsiz').text(formatNumber(r.totalKDVsiz) + ' ₺');
                                $('#kpiSelectedCount').text($('#totalRecordsCount').text());
                            } else {
                                toastr.error(r.message || 'Toplam tutar alınırken hata oluştu.');
                            }
                        },
                        error: () => toastr.error('Toplam tutar alınırken sunucu hatası.'),
                        complete: () => $('#loadingOverlay').hide()
                    });
                } else {
                    $('#selectedTotalAmount').text('0,00 TL');
                    $('#selectedTotalKDVsiz').text('0,00 TL');
                    
                    $('#kpiSelectedCount').text('0');
                    $('#kpiSelectedTotalAmount').text('0,00 ₺');
                    $('#kpiSelectedTotalKDVsiz').text('0,00 ₺');
                }
            });

            $(document).on('change', '.inline-slp-select', function () {
                const sel      = $(this);
                const docEntry = sel.data('docentry');
                const tipi     = sel.data('belgetipi');
                const newCode  = parseInt(sel.val());
                const origVal  = sel.data('original-val');
                if (!newCode) return;

                sel.prop('disabled', true);
                toastr.info("Güncelleniyor...", "", { timeOut: 1500 });

                $.ajax({
                    url: '/Rapor4/UpdateSalesEmployee?db=' + activeDbCode,
                    type: 'POST',
                    contentType: 'application/json',
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify({ DocEntry: docEntry, BelgeTipi: tipi, NewSlpCode: newCode }),
                    success: function (r) {
                        if (r.success) {
                            toastr.success("Satış temsilcisi başarıyla değiştirildi.");
                            sel.data('original-val', newCode);
                        } else {
                            toastr.error(r.message || "Hata oluştu.");
                            sel.val(origVal);
                        }
                    },
                    error: () => { toastr.error("Sunucu ile iletişimde hata oluştu."); sel.val(origVal); },
                    complete: () => sel.prop('disabled', false)
                });
            });
        });
    </script>
}