@using System.Globalization
@model WebApplication3.Controllers.Rapor102ViewModel
@{
    ViewData["Title"] = "Konsolide Finansal Dashboard";

    // Aktif Veritabanını (Şirketi) URL veya Cookie'den alıyoruz
    var currentDb = Context.Request.Query["db"].ToString();
    if (string.IsNullOrEmpty(currentDb))
    {
        currentDb = Context.Request.Cookies["SelectedDatabase"];
    }
}

@functions {
    public string FormatTutar(decimal net, decimal kdv, bool includeVat) {
        decimal total = includeVat ? (net + kdv) : net;
        return total.ToString("N2", new CultureInfo("tr-TR")) + " ₺";
    }
    public string FormatFark(decimal net, decimal kdv) {
        if (net == 0) return "%0.0";
        decimal pct = (kdv / Math.Abs(net)) * 100;
        string isaret = kdv >= 0 ? "+" : "";
        return $"{isaret}{kdv.ToString("N2", new CultureInfo("tr-TR"))} ₺ (%{pct.ToString("N1", new CultureInfo("tr-TR"))})";
    }
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

<style>
    body { background-color: #f4f6f9; }
    .dash-card { border-radius: 12px; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.05); background: white; transition: transform 0.3s ease; }
    .dash-card:hover { transform: translateY(-5px); }
    .icon-box { width: 54px; height: 54px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 26px; }
    
    .bg-gradient-satis { background: linear-gradient(135deg, #1cc88a, #13855c); color: white; box-shadow: 0 4px 10px rgba(28,200,138,0.3); }
    .bg-gradient-alis { background: linear-gradient(135deg, #36b9cc, #258391); color: white; box-shadow: 0 4px 10px rgba(54,185,204,0.3); }
    .bg-gradient-gider { background: linear-gradient(135deg, #e74a3b, #be2617); color: white; box-shadow: 0 4px 10px rgba(231,74,59,0.3); }
    .bg-gradient-taslak { background: linear-gradient(135deg, #f6c23e, #dda20a); color: white; box-shadow: 0 4px 10px rgba(246,194,62,0.3); }
    .bg-gradient-total { background: linear-gradient(135deg, #858796, #5a5c69); color: white; box-shadow: 0 4px 10px rgba(133,135,150,0.3); }
    
    .table-custom th { background-color: #f8f9fc; text-transform: uppercase; font-size: 11.5px; color: #6e707e; border-bottom: 2px solid #e3e6f0; }
    .table-custom td { vertical-align: middle; font-size: 12.5px; color: #5a5c69; }
    .table-custom tfoot th { background-color: #5a5c69; color: white; font-size: 13px; }
    .table-matris td { vertical-align: middle; font-size: 12px; }
    
    .matris-link { color: #4e73df; font-weight: bold; text-decoration: underline; cursor: pointer; transition: 0.2s; }
    .matris-link:hover { color: #224abe; }
    
    .nav-pills-custom .nav-link { color: #5a5c69; font-weight: 600; border-radius: 8px; padding: 10px 20px; margin-right: 10px; border: 1px solid #e3e6f0; transition: all 0.2s; background: white; cursor: pointer; }
    .nav-pills-custom .nav-link.active { background-color: #4e73df; color: white; border-color: #4e73df; box-shadow: 0 4px 10px rgba(78,115,223,0.3); }

    .modal-custom-wide { max-width: 98%; }
    .kdv-info-bar { font-size: 11px; padding: 6px 12px; border-radius: 8px; margin-top: 10px; display: inline-block; font-weight: 600; }
    
    .kdv-bg-satis { background-color: rgba(28,200,138,0.1); color: #13855c; }
    .kdv-bg-alis { background-color: rgba(54,185,204,0.1); color: #258391; }
    .kdv-bg-gider { background-color: rgba(231,74,59,0.1); color: #be2617; }
    .kdv-bg-taslak { background-color: rgba(246,194,62,0.1); color: #dda20a; }
    .kdv-bg-total { background-color: rgba(133,135,150,0.1); color: #5a5c69; }

    .form-check-input { width: 1.5em; height: 1.5em; margin-top: 0.1em; cursor: pointer; }
</style>

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 bg-white p-3 rounded-3 shadow-sm border-start border-5 border-primary">
        <h2 class="h5 mb-0 text-gray-800 fw-bold"><i class="fas fa-chart-pie me-2 text-primary"></i> Konsolide Yönetim Özeti</h2>
        
        <form method="get" action="/Rapor102/Index" class="d-flex align-items-center gap-3">
            
            @if (!string.IsNullOrEmpty(currentDb))
            {
                <input type="hidden" name="db" value="@currentDb" />
            }

            <div class="input-group input-group-sm rounded-pill border px-2 py-1 bg-white" style="width: auto;">
                <input type="date" name="startDate" id="startDate" class="form-control border-0 bg-transparent text-secondary fw-bold" value="@Model.BaslangicTarihi.ToString("yyyy-MM-dd")" required />
                <span class="input-group-text border-0 bg-transparent text-muted px-1"><i class="fas fa-arrow-right"></i></span>
                <input type="date" name="endDate" id="endDate" class="form-control border-0 bg-transparent text-secondary fw-bold" value="@Model.BitisTarihi.ToString("yyyy-MM-dd")" required />
            </div>
            
            <div class="form-check d-flex align-items-center gap-2 mb-0">
                <input class="form-check-input" type="checkbox" id="includeVat" name="includeVat" value="true" @(Model.IncludeVat ? "checked" : "") onchange="this.form.submit()">
                <label class="form-check-label text-primary mb-0 mt-1" for="includeVat" style="cursor: pointer; font-size: 14.5px; font-weight: 500;">
                    KDV Dahil (Brüt)
                </label>
            </div>

            <div class="form-check d-flex align-items-center gap-2 mb-0 ms-2 border-start ps-3">
                <input class="form-check-input border-warning" type="checkbox" id="includeDealers" name="includeDealers" value="true" @(Model.IncludeDealers ? "checked" : "") onchange="this.form.submit()">
                <label class="form-check-label text-warning mb-0 mt-1" for="includeDealers" style="cursor: pointer; font-size: 14.5px; font-weight: 600;">
                    Bayileri Dahil Et
                </label>
            </div>

            <button type="submit" class="btn btn-primary btn-sm fw-bold shadow-sm rounded-pill px-4 py-2 ms-2"><i class="fas fa-sync-alt me-1"></i> Raporla</button>
        </form>
    </div>

    @if (ViewBag.WarningMessage != null) { <div class="alert alert-warning shadow-sm rounded-3"><i class="fas fa-info-circle me-2"></i> @ViewBag.WarningMessage</div> }

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-5 mb-4">
        <div class="col mb-3">
            <div class="card dash-card h-100 p-3 border-bottom-success border-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs fw-bold text-success text-uppercase mb-1">Net Satış (Taslak Hariç)</div>
                        <div class="h5 mb-0 fw-bold text-gray-800">@FormatTutar(Model.GenelSatisNet, Model.GenelSatisKdv, Model.IncludeVat)</div>
                    </div>
                    <div class="icon-box bg-gradient-satis"><i class="fas fa-arrow-up"></i></div>
                </div>
                <div class="kdv-info-bar kdv-bg-satis w-100 text-center mt-auto">
                    <i class="fas fa-calculator me-1"></i>KDV: @FormatFark(Model.GenelSatisNet, Model.GenelSatisKdv)
                </div>
            </div>
        </div>

        <div class="col mb-3">
            <div class="card dash-card h-100 p-3 border-bottom-warning border-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs fw-bold text-warning text-uppercase mb-1">Bekleyen Taslak Satış</div>
                        <div class="h5 mb-0 fw-bold text-gray-800">@FormatTutar(Model.GenelTaslakSatisNet, Model.GenelTaslakSatisKdv, Model.IncludeVat)</div>
                    </div>
                    <div class="icon-box bg-gradient-taslak"><i class="fas fa-clock"></i></div>
                </div>
                <div class="kdv-info-bar kdv-bg-taslak w-100 text-center mt-auto">
                    <i class="fas fa-calculator me-1"></i>KDV: @FormatFark(Model.GenelTaslakSatisNet, Model.GenelTaslakSatisKdv)
                </div>
            </div>
        </div>

        <div class="col mb-3">
            <div class="card dash-card h-100 p-3 border-bottom-info border-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs fw-bold text-info text-uppercase mb-1">Grup Dışı Net Alış</div>
                        <div class="h5 mb-0 fw-bold text-gray-800">@FormatTutar(Model.GenelAlisNet, Model.GenelAlisKdv, Model.IncludeVat)</div>
                    </div>
                    <div class="icon-box bg-gradient-alis"><i class="fas fa-shopping-cart"></i></div>
                </div>
                <div class="kdv-info-bar kdv-bg-alis w-100 text-center mt-auto">
                    <i class="fas fa-calculator me-1"></i>KDV: @FormatFark(Model.GenelAlisNet, Model.GenelAlisKdv)
                </div>
            </div>
        </div>

        <div class="col mb-3">
            <div class="card dash-card h-100 p-3 border-bottom-danger border-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs fw-bold text-danger text-uppercase mb-1">Grup Dışı Net Gider</div>
                        <div class="h5 mb-0 fw-bold text-gray-800">@FormatTutar(Model.GenelGiderNet, Model.GenelGiderKdv, Model.IncludeVat)</div>
                    </div>
                    <div class="icon-box bg-gradient-gider"><i class="fas fa-arrow-down"></i></div>
                </div>
                <div class="kdv-info-bar kdv-bg-gider w-100 text-center mt-auto">
                    <i class="fas fa-calculator me-1"></i>KDV: @FormatFark(Model.GenelGiderNet, Model.GenelGiderKdv)
                </div>
            </div>
        </div>

        <div class="col mb-3">
            <div class="card dash-card h-100 p-3 border-bottom-secondary border-3" style="background-color: #fafbfc;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs fw-bold text-secondary text-uppercase mb-1">Toplam Alım & Gider</div>
                        <div class="h5 mb-0 fw-bold text-gray-800">@FormatTutar(Model.GenelAlimVeGiderToplami, (Model.GenelAlisKdv + Model.GenelGiderKdv), Model.IncludeVat)</div>
                    </div>
                    <div class="icon-box bg-gradient-total"><i class="fas fa-balance-scale"></i></div>
                </div>
                <div class="kdv-info-bar kdv-bg-total w-100 text-center mt-auto">
                    <i class="fas fa-calculator me-1"></i>Toplam KDV Etkisi
                </div>
            </div>
        </div>
    </div>

    <div class="card dash-card mb-4 p-4">
        <h6 class="fw-bold text-gray-800 border-bottom pb-3 mb-3"><i class="fas fa-chart-bar text-primary me-2"></i>Aylık Trend Analizi (@(Model.IncludeVat ? "KDV Dahil" : "KDV Hariç"))</h6>
        <canvas id="trendChart" style="max-height: 280px;"></canvas>
    </div>

    <div class="card dash-card p-4 mb-5">
        <ul class="nav nav-pills nav-pills-custom mb-4 border-bottom pb-3 flex-wrap gap-2" id="pills-tab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="pills-sirket-tab" data-bs-target="#pills-sirket" type="button" role="tab"><i class="fas fa-building text-primary me-1"></i> Şirket Özeti</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link bg-light border-warning" id="pills-bayi-tab" data-bs-target="#pills-bayi" type="button" role="tab" style="color: #d97706;"><i class="fas fa-store me-1"></i> Bayi Şirketleri</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link bg-light border-secondary text-secondary" id="pills-operasyon-tab" data-bs-target="#pills-operasyon" type="button" role="tab"><i class="fas fa-cogs me-1"></i> Operasyon (MO)</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-satis-tab" data-bs-target="#pills-satis" type="button" role="tab"><i class="fas fa-arrow-up text-success me-1"></i> Satışlar</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-taslaksatis-tab" data-bs-target="#pills-taslaksatis" type="button" role="tab"><i class="fas fa-clock text-warning me-1"></i> Taslak Satışlar</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-alis-tab" data-bs-target="#pills-alis" type="button" role="tab"><i class="fas fa-shopping-bag text-info me-1"></i> Alımlar</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-gider-tab" data-bs-target="#pills-gider" type="button" role="tab"><i class="fas fa-receipt text-danger me-1"></i> Giderler</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-aylik-tab" data-bs-target="#pills-aylik" type="button" role="tab"><i class="fas fa-calendar-alt text-warning me-1"></i> Gider Matrisi</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-grupici-tab" data-bs-target="#pills-grupici" type="button" role="tab"><i class="fas fa-handshake text-primary me-1"></i> Grup İçi</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-mukerrer-tab" data-bs-target="#pills-mukerrer" type="button" role="tab">
                    <i class="fas fa-exclamation-triangle text-danger me-1"></i> Mükerrer 
                    <span class="badge bg-danger ms-1 rounded-pill">@Model.MukerrerKayitlar.Count</span>
                </button>
            </li>
        </ul>

        <div class="tab-content" id="pills-tabContent">
            
            <div class="tab-pane fade show active" id="pills-sirket" role="tabpanel">
                <div class="table-responsive border rounded-3">
                    <table class="table table-hover table-custom mb-0 dt-table" style="width: 100%;">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-white border-0 py-3">Firma Adı</th>
                                <th class="text-end text-white border-0 py-3 sort-num">Toplam Satış</th>
                                <th class="text-end text-white border-0 py-3 sort-num">İçindeki Taslak Payı</th>
                                <th class="text-end text-white border-0 py-3 sort-num">Toplam Alış</th>
                                <th class="text-end text-white border-0 py-3 sort-num">Toplam Gider</th>
                                <th class="text-end text-white border-0 py-3 sort-num">Brüt Fark (Satış-Alış-Gider)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sirket in Model.FirmaOzetleri)
                            {
                                decimal karZarar = sirket.ToplamSatis - sirket.ToplamAlis - sirket.ToplamGider;
                                <tr>
                                    <td class="fw-bold text-primary" style="font-size:13.5px;">@sirket.FirmaAdi</td>
                                    <td class="text-end fw-bold text-success" data-sort="@sirket.ToplamSatis.ToString(CultureInfo.InvariantCulture)">@sirket.ToplamSatis.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
                                    <td class="text-end fw-bold text-warning" data-sort="@sirket.ToplamTaslakSatis.ToString(CultureInfo.InvariantCulture)">@(sirket.ToplamTaslakSatis > 0 ? sirket.ToplamTaslakSatis.ToString("N2", new CultureInfo("tr-TR")) + " ₺" : "-")</td>
                                    <td class="text-end fw-bold text-info" data-sort="@sirket.ToplamAlis.ToString(CultureInfo.InvariantCulture)">@sirket.ToplamAlis.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
                                    <td class="text-end fw-bold text-danger" data-sort="@sirket.ToplamGider.ToString(CultureInfo.InvariantCulture)">@sirket.ToplamGider.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
                                    <td class="text-end fw-bold" data-sort="@karZarar.ToString(CultureInfo.InvariantCulture)" style="color: @(karZarar >= 0 ? "#1cc88a" : "#e74a3b"); font-size:14px; background-color: @(karZarar >= 0 ? "rgba(28,200,138,0.05)" : "rgba(231,74,59,0.05)");">@karZarar.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>GENEL TOPLAM</th>
                                <th class="text-end">@Model.FirmaOzetleri.Sum(x => x.ToplamSatis).ToString("N2", new CultureInfo("tr-TR")) ₺</th>
                                <th class="text-end">@Model.FirmaOzetleri.Sum(x => x.ToplamTaslakSatis).ToString("N2", new CultureInfo("tr-TR")) ₺</th>
                                <th class="text-end">@Model.FirmaOzetleri.Sum(x => x.ToplamAlis).ToString("N2", new CultureInfo("tr-TR")) ₺</th>
                                <th class="text-end">@Model.FirmaOzetleri.Sum(x => x.ToplamGider).ToString("N2", new CultureInfo("tr-TR")) ₺</th>
                                <th class="text-end">@Model.FirmaOzetleri.Sum(x => x.ToplamSatis - x.ToplamAlis - x.ToplamGider).ToString("N2", new CultureInfo("tr-TR")) ₺</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="pills-bayi" role="tabpanel">
                <div class="table-responsive border rounded-3 mt-3">
                    <table class="table table-hover table-custom mb-0 dt-table" style="width: 100%;">
                        <thead style="background-color: #fef3c7;">
                            <tr>
                                <th class="text-dark border-0 py-3">Firma Adı</th>
                                <th class="text-end text-dark border-0 py-3 sort-num">Toplam Satış</th>
                                <th class="text-end text-dark border-0 py-3 sort-num">İçindeki Taslak Payı</th>
                                <th class="text-end text-dark border-0 py-3 sort-num">Toplam Alış</th>
                                <th class="text-end text-dark border-0 py-3 sort-num">Toplam Gider</th>
                                <th class="text-end text-dark border-0 py-3 sort-num">Brüt Fark</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sirket in Model.BayiOzetleri)
                            {
                                decimal karZarar = sirket.ToplamSatis - sirket.ToplamAlis - sirket.ToplamGider;
                                <tr>
                                    <td class="fw-bold text-dark" style="font-size:13.5px;">@sirket.FirmaAdi</td>
                                    <td class="text-end fw-bold text-success" data-sort="@sirket.ToplamSatis.ToString(CultureInfo.InvariantCulture)">@sirket.ToplamSatis.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
                                    <td class="text-end fw-bold text-warning" data-sort="@sirket.ToplamTaslakSatis.ToString(CultureInfo.InvariantCulture)">@(sirket.ToplamTaslakSatis > 0 ? sirket.ToplamTaslakSatis.ToString("N2", new CultureInfo("tr-TR")) + " ₺" : "-")</td>
                                    <td class="text-end fw-bold text-info" data-sort="@sirket.ToplamAlis.ToString(CultureInfo.InvariantCulture)">@sirket.ToplamAlis.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
                                    <td class="text-end fw-bold text-danger" data-sort="@sirket.ToplamGider.ToString(CultureInfo.InvariantCulture)">@sirket.ToplamGider.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
                                    <td class="text-end fw-bold" data-sort="@karZarar.ToString(CultureInfo.InvariantCulture)" style="color: @(karZarar >= 0 ? "#1cc88a" : "#e74a3b"); font-size:14px;">@karZarar.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>GENEL TOPLAM</th>
                                <th class="text-end">@Model.BayiOzetleri.Sum(x => x.ToplamSatis).ToString("N2", new CultureInfo("tr-TR")) ₺</th>
                                <th class="text-end">@Model.BayiOzetleri.Sum(x => x.ToplamTaslakSatis).ToString("N2", new CultureInfo("tr-TR")) ₺</th>
                                <th class="text-end">@Model.BayiOzetleri.Sum(x => x.ToplamAlis).ToString("N2", new CultureInfo("tr-TR")) ₺</th>
                                <th class="text-end">@Model.BayiOzetleri.Sum(x => x.ToplamGider).ToString("N2", new CultureInfo("tr-TR")) ₺</th>
                                <th class="text-end">@Model.BayiOzetleri.Sum(x => x.ToplamSatis - x.ToplamAlis - x.ToplamGider).ToString("N2", new CultureInfo("tr-TR")) ₺</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="pills-operasyon" role="tabpanel">
                <div class="alert alert-secondary py-2 small fw-bold rounded-3 border-0">
                    <i class="fas fa-cogs me-2"></i> Bu sekmede Cari Kodu <b>"MO"</b> ile başlayan operasyon işlemleri ana toplamlardan bağımsız olarak listelenmektedir.
                </div>
                <div class="table-responsive border rounded-3 mt-3">
                    <table class="table table-hover table-custom mb-0 dt-table" style="width: 100%;">
                        <thead class="bg-secondary text-white">
                            <tr>
                                <th class="text-white border-0 py-3">Firma Adı</th>
                                <th class="text-end text-white border-0 py-3 sort-num">Satışlar</th>
                                <th class="text-end text-white border-0 py-3 sort-num">Taslak Satışlar</th>
                                <th class="text-end text-white border-0 py-3 sort-num">Alışlar</th>
                                <th class="text-end text-white border-0 py-3 sort-num">Giderler</th>
                                <th class="text-center text-white border-0 py-3">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sirket in Model.OperasyonOzetleri)
                            {
                                <tr>
                                    <td class="fw-bold text-dark" style="font-size:13.5px;">@sirket.FirmaAdi</td>
                                    <td class="text-end fw-bold text-success" data-sort="@sirket.ToplamSatis.ToString(CultureInfo.InvariantCulture)">@sirket.ToplamSatis.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
                                    <td class="text-end fw-bold text-warning" data-sort="@sirket.ToplamTaslakSatis.ToString(CultureInfo.InvariantCulture)">@sirket.ToplamTaslakSatis.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
                                    <td class="text-end fw-bold text-info" data-sort="@sirket.ToplamAlis.ToString(CultureInfo.InvariantCulture)">@sirket.ToplamAlis.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
