            <div class="modal-body p-0 bg-light">
                <div class="p-3 d-flex justify-content-between align-items-center bg-white border-bottom shadow-sm">
                    <span class="fw-bold text-muted" style="font-size: 0.9rem;">
                        <i class="fas fa-list me-1"></i>
                        Ayrıntılı Satır Listesi (Toplamlar Güncellenir)
                    </span>
                    <input type="text" id="docModalSearch" class="form-control form-control-sm rounded-pill border-danger px-3" style="width: 300px;" placeholder="Satırlarda Hızlı Ara...">
                </div>
                <div id="docLoadingSpinner" class="text-center py-5" style="display:none;">
                    <div class="spinner-border text-secondary" style="width: 3rem; height: 3rem;" role="status"></div>
                    <div class="mt-3 text-secondary fw-bold fs-5">Satır Detayları Yükleniyor...</div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-sm table-custom mb-0" id="dynamicDocTable" style="width: 100%;">
                        <thead class="sticky-top bg-light shadow-sm">
                            <tr>
                                <th class="py-3">CARİ KODU</th>
                                <th class="py-3">STOK/HESAP KODU</th>
                                <th class="py-3">AÇIKLAMA</th>
                                <th class="text-end py-3 sort-num">MİKTAR</th>
                                <th class="text-end py-3 sort-num">FİYAT</th>
                                <th class="text-center py-3">P.B</th>
                                <th class="text-end py-3 sort-num">ORJ. TUTAR</th>
                                <th class="text-center py-3 sort-num">KUR</th>
                                <th class="text-end text-primary fw-bold py-3 sort-num">NET TUTAR</th>
                                <th class="text-end py-3 sort-num">KDV</th>
                                <th class="text-end text-danger fw-bold py-3 border-start sort-num">KALEM TOPLAMI</th>
                            </tr>
                        </thead>
                        <tbody id="docModalBody" class="bg-white"></tbody>
                        <tfoot id="docModalFoot" style="background-color: #5a5c69; color: white;"></tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        var isVatIncluded = @Model.IncludeVat.ToString().ToLower();

        // Aktif veritabanı parametresini değişkene alıyoruz
        const currentDbParam = '@currentDb';

        $.extend( true, $.fn.dataTable.defaults, {
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json"
            },
            "paging": false,
            "info": false,
            "searching": true,
            "dom": 'rt',
            "columnDefs": [
                // "sort-num" classına sahip olan kolonları DataTables'a "Bu kolon kesinlikle sayıdır, string gibi davranma" diyerek tanıtıyoruz.
                { "type": "num", "targets": ".sort-num" }
            ]
        });

        $(document).ready(function() {
            $('.dt-table').DataTable();

            $('.nav-link[data-bs-target]').on('click', function (e) {
                e.preventDefault();
                $('.nav-link[data-bs-target]').removeClass('active');
                $('.tab-pane').removeClass('show active');
                
                $(this).addClass('active');
                let target = $(this).attr('data-bs-target');
                $(target).addClass('show active');

                let table = $(target).find('table.dataTable').DataTable();
                if (table) {
                    table.columns.adjust().draw();
                }
            });
        });

        var modalDt = null;
        var docDt = null;

        // Modal Hızlı Arama
        $('#modalSearch').on('keyup', function() {
            if (modalDt) {
                modalDt.search(this.value).draw();
            }
        });

        // Belge İçi Hızlı Arama
        $('#docModalSearch').on('keyup', function() {
            if (docDt) {
                docDt.search(this.value).draw();
            }
        });

        function openDetail(firma, tip, isGrupIci, isOperasyon) {
            let titleColor = tip === "Satis" ? "bg-success" : (tip === "Alis" ? "bg-info" : (tip === "TaslakSatis" ? "bg-warning" : "bg-danger"));
            let typeName = tip === "Satis" ? "Satış" : (tip === "Alis" ? "Alış" : (tip === "TaslakSatis" ? "Taslak Satış" : "Gider"));
            let suffix = isGrupIci ? " (Grup İçi)" : " (Grup Dışı)";
            if(isOperasyon) suffix += " [Operasyon İşlemleri]";
            
            $("#modalTitle").text(firma + " - " + typeName + suffix + " Listesi");
            $(".modal-header").removeClass("bg-primary bg-dark bg-success bg-info bg-danger bg-warning text-dark").addClass(titleColor);
            if(tip === "TaslakSatis" || tip === "Alis") $(".modal-header").addClass("text-dark"); else $(".modal-header").addClass("text-white");
            
            if ($.fn.DataTable && $.fn.DataTable.isDataTable('#dynamicModalTable')) {
                $('#dynamicModalTable').DataTable().destroy();
            }

            let thead = $("#modalTableHead");
            thead.empty();
            
            // Footer'ı tablo indexlerine bağlamak yerine direkt custom ID atıyoruz (Hataları önler)
            let colspan = tip === "Gider" ? 7 : 8;
            let footerHtml = `<tr>
                <th colspan="${colspan}" class="text-end border-0">FİLTRELENEN TOPLAM : </th>
                <th class="text-end border-0" id="ft-orj">0,00</th>
                <th class="border-0"></th>
                <th class="text-end text-danger fs-6 border-0" id="ft-net">0,00</th>
                <th class="text-end text-white-50 fs-6 border-0" id="ft-kdv">0,00</th>
                <th class="text-end text-warning fs-6 border-0" id="ft-comp">0,00 ₺</th>
                <th class="border-0"></th>
            </tr>`;
            $("#modalTableFoot").html(footerHtml);

            // Başlıklar arasına "sort-num" classını gömerek sıralamanın düzgün çalışmasını sağlıyoruz.
            if(tip === "Gider") {
                thead.append('<tr><th class="py-3">Tarih</th><th class="py-3">Tür</th><th class="py-3">Yevmiye No</th><th class="py-3">Belge No</th><th class="py-3">Cari Kodu</th><th class="py-3">Cari Adı</th><th class="text-center py-3">P.B</th><th class="text-end py-3 sort-num">Orj.Tutar</th><th class="text-center py-3 sort-num">Kur</th><th class="text-end text-danger fw-bold py-3 fs-6 border-start sort-num">TL Net Tutar</th><th class="text-end text-muted fw-bold py-3 fs-6 sort-num">TL KDV</th><th class="text-end text-dark fw-bold py-3 fs-6 sort-num">Hesaplanan Tutar</th><th class="text-center py-3">İşlem</th></tr>');
            } else {
                let tColor = tip === "Satis" || tip === "TaslakSatis" ? "text-success" : "text-info";
                thead.append(`<tr><th class="py-3">Tarih</th><th class="py-3">İşlem Tipi</th><th class="py-3">Tür</th><th class="py-3">Yevmiye No</th><th class="py-3">Belge No</th><th class="py-3">Cari Kodu</th><th class="py-3">Cari Adı</th><th class="text-center py-3">P.B</th><th class="text-end py-3 sort-num">Orj.Tutar</th><th class="text-center py-3 sort-num">Kur</th><th class="text-end ${tColor} fw-bold py-3 fs-6 border-start sort-num">TL Net Tutar</th><th class="text-end text-muted fw-bold py-3 fs-6 sort-num">TL KDV</th><th class="text-end text-dark fw-bold py-3 fs-6 sort-num">Hesaplanan Tutar</th><th class="text-center py-3">İşlem</th></tr>`);
            }

            $("#modalTableBody").empty();
            $('#modalSearch').val('');
            $("#loadingSpinner").show();
            
            var detailModal = new bootstrap.Modal(document.getElementById('detailModal'));
            detailModal.show();

            let sDate = $("#startDate").val();
            let eDate = $("#endDate").val();

            $.ajax({
                url: '@Url.Action("GetDetay", "Rapor102")',
                type: 'GET',
                // db parametresini API isteğine ekliyoruz
                data: { firma: firma, tip: tip, start: sDate, end: eDate, isGrupIci: isGrupIci, isOperasyon: isOperasyon, db: currentDbParam },
                success: function (res) {
                    $("#loadingSpinner").hide();
                    if (res.success) {
                        if(res.data.length > 0) {
                            let tbody = $("#modalTableBody");
                            res.data.forEach(function(item) {
                                let btnHtml = `<button class="btn btn-sm btn-outline-dark rounded-pill py-1 px-3 fw-bold shadow-sm" onclick="openDocument('${firma}', '${item.turKod}', '${item.docId}', '${item.tur}')"><i class="fas fa-search me-1"></i>Detay</button>`;
                                
                                let tlNet = item.tlNetTutar;
                                let tlKdv = item.tlKdv;
                                let computed = isVatIncluded ? (tlNet + tlKdv) : tlNet;

                                let orjNetTutarDisplay = item.orjNetTutar === 0 ? "<span class='text-muted'>0,00</span>" : item.orjNetTutar.toLocaleString('tr-TR', {minimumFractionDigits:2});
                                let tlNetDisplay = tlNet === 0 ? "<span class='badge bg-warning text-dark'>0,00</span>" : tlNet.toLocaleString('tr-TR', {minimumFractionDigits:2});
                                let tlKdvDisplay = tlKdv === 0 ? "<span class='text-muted'>0,00</span>" : tlKdv.toLocaleString('tr-TR', {minimumFractionDigits:2});
                                let computedDisplay = computed === 0 ? "<span class='badge bg-secondary'>0,00</span>" : computed.toLocaleString('tr-TR', {minimumFractionDigits:2}) + " ₺";

                                // SADECE HAM VERİYİ ROW DATA'YA GÖM (Dinamik Arama Hesaplaması için En Sağlam Yöntem)
                                let row = `<tr data-orj="${item.orjNetTutar}" data-net="${tlNet}" data-kdv="${tlKdv}" data-comp="${computed}">`;

                                if(tip === "Gider") {
                                    row += `<td class="py-2" data-sort="${item.tarih.split('.').reverse().join('')}">${item.tarih}</td><td class="py-2"><span class="badge bg-secondary px-2 py-1">${item.tur}</span></td>`;
                                    row += `<td class="fw-bold py-2">${item.yevmiyeNo}</td><td class="fw-bold py-2">${item.belgeNo}</td>`;
                                    row += `<td class="fw-bold py-2 text-secondary">${item.cariKodu || '-'}</td>`;
                                    row += `<td class="small fw-bold py-2">${item.cariAdi}</td>`;
                                    row += `<td class="text-center fw-bold text-muted py-2">${item.paraBirimi}</td><td class="text-end py-2" data-sort="${item.orjNetTutar}">${orjNetTutarDisplay}</td>`;
                                    row += `<td class="text-center small py-2" data-sort="${item.kur}">${item.kur.toLocaleString('tr-TR', {minimumFractionDigits:4})}</td>`;
                                    row += `<td class="text-end fw-bold text-danger border-start py-2" data-sort="${tlNet}">${tlNetDisplay}</td><td class="text-end text-muted py-2" data-sort="${tlKdv}">${tlKdvDisplay}</td><td class="text-end fw-bold text-dark py-2" data-sort="${computed}" style="font-size:13.5px;">${computedDisplay}</td>`;
                                    row += `<td class="text-center py-2">${btnHtml}</td>`;
                                } else {
                                    let bColor = tip === "Satis" ? "bg-success" : (tip === "TaslakSatis" ? "bg-warning text-dark" : "bg-info text-dark");
                                    let tColor = tip === "Satis" || tip === "TaslakSatis" ? "text-success" : "text-info";
                                    let islemTipiBadge = item.islemTipi && item.islemTipi !== '' ? `<span class="badge bg-dark">${item.islemTipi}</span>` : `<span class="text-muted">-</span>`;

                                    row += `<td class="py-2" data-sort="${item.tarih.split('.').reverse().join('')}">${item.tarih}</td><td class="py-2 text-center">${islemTipiBadge}</td><td class="py-2"><span class="badge ${bColor} px-2 py-1">${item.tur}</span></td>`;
                                    row += `<td class="fw-bold py-2">${item.yevmiyeNo}</td><td class="fw-bold py-2">${item.belgeNo}</td>`;
                                    row += `<td class="fw-bold py-2 text-secondary">${item.cariKodu || '-'}</td>`;
                                    row += `<td class="small fw-bold py-2">${item.cariAdi}</td>`;
                                    row += `<td class="text-center fw-bold text-muted py-2">${item.paraBirimi}</td><td class="text-end py-2" data-sort="${item.orjNetTutar}">${orjNetTutarDisplay}</td>`;
                                    row += `<td class="text-center small py-2" data-sort="${item.kur}">${item.kur.toLocaleString('tr-TR', {minimumFractionDigits:4})}</td>`;
                                    row += `<td class="text-end fw-bold ${tColor} border-start py-2" data-sort="${tlNet}">${tlNetDisplay}</td><td class="text-end text-muted py-2" data-sort="${tlKdv}">${tlKdvDisplay}</td><td class="text-end fw-bold text-dark py-2" data-sort="${computed}" style="font-size:13.5px;">${computedDisplay}</td>`;
                                    row += `<td class="text-center py-2">${btnHtml}</td>`;
                                }
                                row += "</tr>";
                                tbody.append(row);
                            });

                            // Datatable'i başlat ve footer callbacki dinamik ekle
                            modalDt = $('#dynamicModalTable').DataTable({
                                destroy: true,
                                language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json" },
                                paging: false,
                                info: false,
                                searching: true,
                                dom: 'rt',
                                footerCallback: function () {
                                    let sumOrj = 0, sumNet = 0, sumKdv = 0, sumComp = 0;
                                    // Sadece ARAMA İLE GÖRÜNEN satırların verisini TR elementinden alarak topluyoruz
                                    this.api().rows({search: 'applied'}).nodes().each(function(tr) {
                                        sumOrj += parseFloat($(tr).attr('data-orj')) || 0;
                                        sumNet += parseFloat($(tr).attr('data-net')) || 0;
                                        sumKdv += parseFloat($(tr).attr('data-kdv')) || 0;
                                        sumComp += parseFloat($(tr).attr('data-comp')) || 0;
                                    });
                                    $("#ft-orj").text(sumOrj.toLocaleString('tr-TR', {minimumFractionDigits:2}));
                                    $("#ft-net").text(sumNet.toLocaleString('tr-TR', {minimumFractionDigits:2}));
                                    $("#ft-kdv").text(sumKdv.toLocaleString('tr-TR', {minimumFractionDigits:2}));
                                    $("#ft-comp").text(sumComp.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺');
                                }
                            });
                        } else { $("#modalTableBody").append('<tr><td colspan="15" class="text-center py-5 text-muted"><i class="fas fa-search fa-2x d-block mb-2"></i>Kayıt bulunamadı.</td></tr>'); }
                    } else { $("#modalTableBody").append(`<tr><td colspan="15" class="text-center py-4 text-danger"><b>Hata:</b> ${res.message}</td></tr>`); }
                },
                error: function (xhr) {
                    $("#loadingSpinner").hide();
                    $("#modalTableBody").append(`<tr><td colspan="15" class="text-center py-4 text-danger"><b>Sistem Hatası:</b> ${xhr.responseText || xhr.statusText}</td></tr>`);
                }
            });
        }

        function openMatrixDetail(anaKat, altKat, ay) {
            let aylar = ["", "Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık"];
            $("#modalTitle").text(aylar[ay] + " Ayı - " + anaKat + " (" + altKat + ") Konsolide Gider Detayları");
            $(".modal-header").removeClass("bg-primary bg-dark bg-success bg-info bg-danger").addClass("bg-warning text-dark");
            
            if ($.fn.DataTable && $.fn.DataTable.isDataTable('#dynamicModalTable')) {
                $('#dynamicModalTable').DataTable().destroy();
            }

            let thead = $("#modalTableHead");
            thead.empty();
            thead.append('<tr><th class="py-3">Firma</th><th class="py-3">Tarih</th><th class="py-3">Yevmiye No</th><th class="py-3">Belge No</th><th class="py-3">Cari Kodu</th><th class="py-3">Cari Adı</th><th class="text-center py-3">P.B</th><th class="text-end py-3 sort-num">Orj.Tutar</th><th class="text-center py-3 sort-num">Kur</th><th class="text-end text-danger fw-bold border-start py-3 sort-num">TL Net Tutar</th><th class="text-end text-muted fw-bold py-3 sort-num">TL KDV</th><th class="text-end text-dark fw-bold py-3 sort-num">Hesaplanan Tutar</th><th class="text-center py-3">İşlem</th></tr>');

            let footerHtml = `<tr>
                <th colspan="7" class="text-end border-0">FİLTRELENEN TOPLAM : </th>
                <th class="text-end border-0" id="fmt-orj">0,00</th>
                <th class="border-0"></th>
                <th class="text-end text-danger fs-6 border-0" id="fmt-net">0,00</th>
                <th class="text-end text-white-50 fs-6 border-0" id="fmt-kdv">0,00</th>
                <th class="text-end text-warning fs-6 border-0" id="fmt-comp">0,00 ₺</th>
                <th class="border-0"></th>
            </tr>`;
            $("#modalTableFoot").html(footerHtml);

            $("#modalTableBody").empty();
            $('#modalSearch').val(''); 
            $("#loadingSpinner").show();
            
            var detailModal = new bootstrap.Modal(document.getElementById('detailModal'));
            detailModal.show();

            let sDate = $("#startDate").val();
            $.ajax({
                url: '@Url.Action("GetMatrisDetay", "Rapor102")',
                type: 'GET',
                // db parametresini API isteğine ekliyoruz
                data: { anaKat: anaKat, altKat: altKat, ay: ay, start: sDate, db: currentDbParam },
                success: function (res) {
                    $("#loadingSpinner").hide();
                    if (res.success) {
                        if (res.data.length > 0) {
                            let tbody = $("#modalTableBody");
                            res.data.forEach(function(item) {
                                let tlNet = item.tlNetTutar;
                                let tlKdv = item.tlKdv;
                                let computed = isVatIncluded ? (tlNet + tlKdv) : tlNet;

                                let tlNetDisplay = tlNet === 0 ? "<span class='badge bg-warning text-dark'>0,00</span>" : tlNet.toLocaleString('tr-TR', {minimumFractionDigits:2});
                                let tlKdvDisplay = tlKdv === 0 ? "<span class='text-muted'>0,00</span>" : tlKdv.toLocaleString('tr-TR', {minimumFractionDigits:2});
                                let computedDisplay = computed === 0 ? "<span class='badge bg-secondary'>0,00</span>" : computed.toLocaleString('tr-TR', {minimumFractionDigits:2}) + " ₺";
                                let orjNetTutarDisplay = item.orjNetTutar === 0 ? "<span class='text-muted'>0,00</span>" : item.orjNetTutar.toLocaleString('tr-TR', {minimumFractionDigits:2});
                                
                                let btnHtml = `<button class="btn btn-sm btn-outline-dark rounded-pill py-1 px-3 fw-bold shadow-sm" onclick="openDocument('${item.firma}', '${item.turKod}', '${item.docId}', '${item.tur}')"><i class="fas fa-search me-1"></i>Detay</button>`;
                                
                                let row = `<tr data-orj="${item.orjNetTutar}" data-net="${tlNet}" data-kdv="${tlKdv}" data-comp="${computed}">
                                    <td class="fw-bold text-primary py-2">${item.firma}</td><td class="py-2" data-sort="${item.tarih.split('.').reverse().join('')}">${item.tarih}</td>
                                    <td class="fw-bold py-2">${item.yevmiyeNo}</td><td class="fw-bold py-2">${item.belgeNo}</td>
                                    <td class="fw-bold text-secondary py-2">${item.cariKodu || '-'}</td>
                                    <td class="small fw-bold py-2">${item.cariAdi}</td>
                                    <td class="text-center fw-bold text-muted py-2">${item.paraBirimi}</td>
                                    <td class="text-end py-2" data-sort="${item.orjNetTutar}">${orjNetTutarDisplay}</td>
                                    <td class="text-center small py-2" data-sort="${item.kur}">${item.kur.toLocaleString('tr-TR', {minimumFractionDigits:4})}</td>
                                    <td class="text-end fw-bold text-danger border-start py-2" data-sort="${tlNet}">${tlNetDisplay}</td>
                                    <td class="text-end text-muted py-2" data-sort="${tlKdv}">${tlKdvDisplay}</td>
                                    <td class="text-end fw-bold text-dark py-2" data-sort="${computed}" style="font-size:13.5px;">${computedDisplay}</td>
                                    <td class="text-center py-2">${btnHtml}</td>
                                </tr>`;
                                tbody.append(row);
                            });

                            modalDt = $('#dynamicModalTable').DataTable({
                                destroy: true,
                                language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json" },
                                paging: false,
                                info: false,
                                searching: true,
                                dom: 'rt',
                                footerCallback: function () {
                                    let sumOrj = 0, sumNet = 0, sumKdv = 0, sumComp = 0;
                                    this.api().rows({search: 'applied'}).nodes().each(function(tr) {
                                        sumOrj += parseFloat($(tr).attr('data-orj')) || 0;
                                        sumNet += parseFloat($(tr).attr('data-net')) || 0;
                                        sumKdv += parseFloat($(tr).attr('data-kdv')) || 0;
                                        sumComp += parseFloat($(tr).attr('data-comp')) || 0;
                                    });
                                    $("#fmt-orj").html(sumOrj.toLocaleString('tr-TR', {minimumFractionDigits:2}));
                                    $("#fmt-net").html(sumNet.toLocaleString('tr-TR', {minimumFractionDigits:2}));
                                    $("#fmt-kdv").html(sumKdv.toLocaleString('tr-TR', {minimumFractionDigits:2}));
                                    $("#fmt-comp").html(sumComp.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺');
                                }
                            });
                        } else { $("#modalTableBody").append('<tr><td colspan="15" class="text-center py-5 text-muted"><i class="fas fa-search fa-2x d-block mb-2"></i>Bu kategoriye ait işlem bulunamadı.</td></tr>'); }
                    } else { $("#modalTableBody").append(`<tr><td colspan="15" class="text-center py-4 text-danger"><b>Hata:</b> ${res.message}</td></tr>`); }
                },
                error: function (xhr) {
                    $("#loadingSpinner").hide();
                    $("#modalTableBody").append(`<tr><td colspan="15" class="text-center py-4 text-danger"><b>Sistem Hatası:</b> ${xhr.responseText || xhr.statusText}</td></tr>`);
                }
            });
        }

        function openDocument(firma, turKod, docId, turAdi) {
            $("#docModalTitle").html(`<i class="fas fa-file-invoice me-2"></i>${firma} - ${turAdi} Belge Satırları`);
            
            if ($.fn.DataTable && $.fn.DataTable.isDataTable('#dynamicDocTable')) {
                $('#dynamicDocTable').DataTable().destroy();
            }

            let footerHtml = `<tr>
                <th colspan="3" class="text-end border-0">FİLTRELENEN TOPLAM : </th>
                <th class="text-end border-0" id="fdoc-mik">0</th>
                <th class="text-end border-0">-</th>
                <th class="border-0"></th>
                <th class="text-end border-0" id="fdoc-orj">0,00</th>
                <th class="border-0"></th>
                <th class="text-end text-primary fs-6 border-0" id="fdoc-net">0,00</th>
                <th class="text-end text-white-50 fs-6 border-0" id="fdoc-kdv">0,00</th>
                <th class="text-end text-warning fs-6 border-0" id="fdoc-comp">0,00 ₺</th>
            </tr>`;
            $("#docModalFoot").html(footerHtml);

            $("#docModalBody").empty();
            $('#docModalSearch').val('');
            $("#docLoadingSpinner").show();
            var docModal = new bootstrap.Modal(document.getElementById('documentModal'));
            docModal.show();

            $.ajax({
                url: '@Url.Action("GetBelgeDetay", "Rapor102")',
                type: 'GET',
                // db parametresini API isteğine ekliyoruz
                data: { firma: firma, turKod: turKod, docId: docId, db: currentDbParam }, 
                success: function (res) {
                    $("#docLoadingSpinner").hide();
                    if (res.success && res.data.length > 0) {
                        let tbody = $("#docModalBody");
                        res.data.forEach(function(item) {
                            let tlNet = item.tlNetTutar;
                            let tlKdv = item.tlKdv;
                            let computed = isVatIncluded ? (tlNet + tlKdv) : tlNet;

                            let tlNetDisplay = tlNet === 0 ? "<span class='badge bg-warning text-dark'>0,00</span>" : tlNet.toLocaleString('tr-TR', {minimumFractionDigits:2});
                            let tlKdvDisplay = tlKdv === 0 ? "<span class='text-muted'>0,00</span>" : tlKdv.toLocaleString('tr-TR', {minimumFractionDigits:2});
                            let computedDisplay = computed === 0 ? "<span class='badge bg-secondary'>0,00</span>" : computed.toLocaleString('tr-TR', {minimumFractionDigits:2}) + " ₺";

                            let orjNetTutarDisplay = item.orjNetTutar === 0 ? "<span class='text-muted'>0,00</span>" : item.orjNetTutar.toLocaleString('tr-TR', {minimumFractionDigits:2});
                            let fiyatDisplay = item.fiyat === 0 ? "<span class='text-muted'>0,00</span>" : item.fiyat.toLocaleString('tr-TR', {minimumFractionDigits:4});

                            let row = `<tr data-mik="${item.miktar}" data-orj="${item.orjNetTutar}" data-net="${tlNet}" data-kdv="${tlKdv}" data-comp="${computed}">
                                <td class="fw-bold text-secondary py-2">${item.cariKodu || '-'}</td>
                                <td class="fw-bold text-dark py-2">${item.kod}</td><td class="py-2">${item.aciklama}</td>
                                <td class="text-end py-2" data-sort="${item.miktar}">${item.miktar.toLocaleString('tr-TR')}</td>
                                <td class="text-end py-2" data-sort="${item.fiyat}">${fiyatDisplay}</td>
                                <td class="text-center fw-bold text-muted py-2">${item.paraBirimi}</td>
                                <td class="text-end py-2" data-sort="${item.orjNetTutar}">${orjNetTutarDisplay}</td>
                                <td class="text-center small py-2" data-sort="${item.kur}">${item.kur.toLocaleString('tr-TR', {minimumFractionDigits:4})}</td>
                                <td class="text-end fw-bold text-primary py-2" data-sort="${tlNet}">${tlNetDisplay}</td>
                                <td class="text-end text-muted py-2" data-sort="${tlKdv}">${tlKdvDisplay}</td>
                                <td class="text-end fw-bold text-danger border-start py-2 bg-light" data-sort="${computed}" style="font-size:13.5px;">${computedDisplay}</td>
                            </tr>`;
                            tbody.append(row);
                        });

                        docDt = $('#dynamicDocTable').DataTable({
                            destroy: true,
                            language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json" },
                            paging: false,
                            info: false,
                            searching: true,
                            dom: 'rt',
                            footerCallback: function () {
                                let sumMik = 0, sumOrj = 0, sumNet = 0, sumKdv = 0, sumComp = 0;
                                this.api().rows({search: 'applied'}).nodes().each(function(tr) {
                                    sumMik += parseFloat($(tr).attr('data-mik')) || 0;
                                    sumOrj += parseFloat($(tr).attr('data-orj')) || 0;
                                    sumNet += parseFloat($(tr).attr('data-net')) || 0;
                                    sumKdv += parseFloat($(tr).attr('data-kdv')) || 0;
                                    sumComp += parseFloat($(tr).attr('data-comp')) || 0;
                                });
                                $("#fdoc-mik").html(sumMik.toLocaleString('tr-TR'));
                                $("#fdoc-orj").html(sumOrj.toLocaleString('tr-TR', {minimumFractionDigits:2}));
                                $("#fdoc-net").html(sumNet.toLocaleString('tr-TR', {minimumFractionDigits:2}));
                                $("#fdoc-kdv").html(sumKdv.toLocaleString('tr-TR', {minimumFractionDigits:2}));
                                $("#fdoc-comp").html(sumComp.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺');
                            }
                        });
                    } else {
                        let errorMsg = res.message ? res.message : "Detay bulunamadı veya satır tutarı yok.";
                        $("#docModalBody").append(`<tr><td colspan="15" class="text-center py-5 text-danger"><i class="fas fa-exclamation-triangle fa-2x d-block mb-2"></i>${errorMsg}</td></tr>`);
                    }
                },
                error: function (xhr) {
                    $("#docLoadingSpinner").hide();
                    $("#docModalBody").append(`<tr><td colspan="15" class="text-center py-4 text-danger"><b>Sistem Hatası:</b> ${xhr.responseText || xhr.statusText}</td></tr>`);
                }
            });
        }

        Chart.defaults.font.family = '"Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif';
        Chart.defaults.color = '#858796';
        var ctxTrend = document.getElementById('trendChart').getContext('2d');
        new Chart(ctxTrend, {
            type: 'bar',
            data: {
                labels: ['Oca', 'Şub', 'Mar', 'Nis', 'May', 'Haz', 'Tem', 'Ağu', 'Eyl', 'Eki', 'Kas', 'Ara'],
                datasets: [
                    { label: 'Satışlar', data: [@string.Join(",", Model.TrendOzetler.Select(x => x.Satis.ToString(CultureInfo.InvariantCulture)))], backgroundColor: '#1cc88a', borderRadius: 4, barPercentage: 0.7 },
                    { label: 'Alımlar', data: [@string.Join(",", Model.TrendOzetler.Select(x => x.Alis.ToString(CultureInfo.InvariantCulture)))], backgroundColor: '#36b9cc', borderRadius: 4, barPercentage: 0.7 },
                    { label: 'Giderler', data: [@string.Join(",", Model.TrendOzetler.Select(x => x.Gider.ToString(CultureInfo.InvariantCulture)))], backgroundColor: '#e74a3b', borderRadius: 4, barPercentage: 0.7 }
                ]
            },
            options: { 
                responsive: true, 
                maintainAspectRatio: false, 
                plugins: { 
                    legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 10 } },
                    tooltip: { backgroundColor: "rgba(255,255,255,0.9)", titleColor: "#5a5c69", bodyColor: "#5a5c69", borderColor: '#dddfeb', borderWidth: 1, padding: 10 }
                },
                scales: {
                    y: { grid: { borderDash: [2], color: "#e3e6f0", drawBorder: false }, ticks: { callback: function(val) { return val.toLocaleString('tr-TR') + ' ₺'; } } },
                    x: { grid: { display: false, drawBorder: false } }
                }
            }
        });
    </script>
}