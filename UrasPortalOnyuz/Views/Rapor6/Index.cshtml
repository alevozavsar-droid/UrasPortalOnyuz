                                <th class="sortable-column" data-column="OncekiFiyatTRY" data-sort-type="number">Önc. Fiyat (TRY) <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="OncekiSaticiAdi" data-sort-type="text">Önc. Satıcı <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="OncekiSaticiGrupAdi" data-sort-type="text">Önc. Grup <i class="fas fa-sort float-end"></i></th>

                                <th class="sortable-column" data-column="FiyatDegisimYuzdesiTRY" data-sort-type="number">Değ.% (TRY) <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="FiyatDegisimYuzdesiEUR" data-sort-type="number">Değ.% (EUR) <i class="fas fa-sort float-end"></i></th>
