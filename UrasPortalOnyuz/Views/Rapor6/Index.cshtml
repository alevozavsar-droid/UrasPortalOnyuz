@model List<WebApplication3.Models.ProductPriceComparisonViewModel>
@using System.Globalization;
@using Newtonsoft.Json;

@{
    ViewData["Title"] = "Ürün Fiyat Karşılaştırma Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 1. KURAL: URL'den veya Cookie'den aktif şirketi okuyan değişken
    var currentDb = Context.Request.Query["db"].FirstOrDefault() ?? Context.Request.Cookies["AktifSirket"] ?? "";

    var reportDataJson = Model != null ? JsonConvert.SerializeObject(Model, new JsonSerializerSettings { DateFormatString = "yyyy-MM-dd" }) : "[]";

    // Dropdown filtreleri için listeler (Controller'dan gelen ViewBag'leri kullanıyoruz veya Model üzerinden tekrar çekiyoruz)
    var distinctValues = new Dictionary<string, List<string>>();
    if (Model != null)
    {
        distinctValues["MalzemeKodu"] = Model.Where(m => !string.IsNullOrEmpty(m.MalzemeKodu)).Select(m => m.MalzemeKodu).Distinct().OrderBy(s => s).ToList();
        distinctValues["MalzemeAciklamasi"] = Model.Where(m => !string.IsNullOrEmpty(m.MalzemeAciklamasi)).Select(m => m.MalzemeAciklamasi).Distinct().OrderBy(s => s).ToList();

        distinctValues["SonSaticiAdi"] = Model.Where(m => !string.IsNullOrEmpty(m.SonSaticiAdi)).Select(m => m.SonSaticiAdi).Distinct().OrderBy(s => s).ToList();
        distinctValues["SonSaticiGrupAdi"] = Model.Where(m => !string.IsNullOrEmpty(m.SonSaticiGrupAdi)).Select(m => m.SonSaticiGrupAdi).Distinct().OrderBy(s => s).ToList();

        distinctValues["OncekiSaticiAdi"] = Model.Where(m => !string.IsNullOrEmpty(m.OncekiSaticiAdi)).Select(m => m.OncekiSaticiAdi).Distinct().OrderBy(s => s).ToList();
        distinctValues["OncekiSaticiGrupAdi"] = Model.Where(m => !string.IsNullOrEmpty(m.OncekiSaticiGrupAdi)).Select(m => m.OncekiSaticiGrupAdi).Distinct().OrderBy(s => s).ToList();

        distinctValues["SonParaBirimi"] = Model.Where(m => !string.IsNullOrEmpty(m.SonParaBirimi)).Select(m => m.SonParaBirimi).Distinct().OrderBy(s => s).ToList();
        distinctValues["ParaBirimiDurumu"] = Model.Where(m => !string.IsNullOrEmpty(m.ParaBirimiDurumu)).Select(m => m.ParaBirimiDurumu).Distinct().OrderBy(s => s).ToList();
    }
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/css/bootstrap-select.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <style>
        :root {
            --primary-color: #0d6efd;
            --secondary-color: #6c757d;
            --success-color: #198754;
            --danger-color: #dc3545;
            --warning-color: #ffc107;
            --info-color: #0dcaf0;
            --light-bg: #f8f9fa;
            --dark-text: black;
            --border-color: #d0d0d0;
            --header-bg: #212529;
            --header-text: #ffffff;
            --box-shadow-light: 0 0 8px rgba(0, 0, 0, 0.08);
            --box-shadow-medium: 0 2px 3px rgba(0, 0, 0, 0.06);
            --selected-row-color-hex: #ffc107;
            --selected-row-border: #e0a800;
            --selected-row-hover-color: #ffda6a;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 12px;
            background-color: var(--light-bg);
            color: var(--dark-text);
        }

        .main-content {
            margin-top: 0 !important;
            padding-top: 0 !important;
            font-size: 1.15em;
            padding: 8px;
            background-color: #ffffff;
            border-radius: 6px;
            box-shadow: var(--box-shadow-light);
            position: relative;
        }

        .container-fluid.py-4 {
            padding-top: 5px;
            padding-bottom: 10px;
            padding-left: 5px;
            padding-right: 5px;
        }

        .database-info {
            background-color: var(--info-color);
            color: #ffffff;
            padding: 4px 8px;
            border-radius: 4px;
            margin-bottom: 6px;
            font-weight: bold;
            display: flex;
            align-items: center;
            font-size: 0.96em;
            line-height: 1.1;
        }

            .database-info .fas {
                margin-right: 4px;
            }

        .sticky-toolbar {
            position: sticky;
            top: 0;
            background-color: #ffffff;
            z-index: 1000;
            padding: 8px 12px;
            border-bottom: 1px solid var(--border-color);
            margin-top: 0px !important;
            margin-bottom: 6px;
            box-shadow: var(--box-shadow-medium);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: nowrap;
            gap: 10px;
        }

            .sticky-toolbar .selected-check-count-display {
                font-size: 0.96em;
                font-weight: bold;
                color: var(--success-color);
                margin-left: 15px;
                white-space: nowrap;
            }

        .table-container {
            overflow-x: auto;
            position: relative;
            border-radius: 6px;
            box-shadow: var(--box-shadow-medium);
            background-color: #ffffff;
            margin-top: 6px;
            border: 1px solid var(--border-color);
        }

        .rapor-tablo {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 0.84em;
            color: var(--dark-text);
            table-layout: fixed;
            min-width: 2400px; /* Sütun sayısı arttığı için genişliği artırdık */
        }

            .rapor-tablo thead {
                position: sticky;
                top: 0;
                z-index: 101;
                background-color: #ffffff;
            }

                .rapor-tablo thead .main-header-row th {
                    background-color: var(--header-bg);
                    color: var(--header-text);
                    padding: 4px 3px;
                    text-align: center;
                    white-space: nowrap;
                    font-weight: 700;
                    border-bottom: 2px solid var(--border-color);
                    height: auto;
                    line-height: 1.3;
                }

                .rapor-tablo thead .filter-row th {
                    padding: 2px 3px;
                    height: 30px;
                    line-height: normal;
                    vertical-align: top;
                    white-space: nowrap;
                    background-color: #ffffff;
                    border-bottom: 1px solid var(--border-color);
                }

            .rapor-tablo th, .rapor-tablo td {
                padding: 1px;
                vertical-align: middle;
                border-right: 1px solid var(--border-color);
            }

                .rapor-tablo th:last-child, .rapor-tablo td:last-child {
                    border-right: none;
                }

            .rapor-tablo td {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                height: 25px;
                line-height: 25px;
                border-bottom: 1px solid var(--border-color);
            }

        .table-hover tbody tr:hover {
            background-color: var(--light-bg);
        }

        .rapor-tablo tbody tr.selected-hover:hover {
            background-color: var(--selected-row-hover-color) !important;
        }

        .checkbox-column {
            min-width: 28px !important;
            max-width: 28px !important;
            width: 28px !important;
            text-align: right !important;
            padding: 0 !important;
            vertical-align: middle !important;
            overflow: visible;
        }

        .filter-row th .form-control,
        .filter-row th .bootstrap-select .btn {
            width: 100% !important;
            box-sizing: border-box !important;
            height: 28px !important;
            line-height: normal !important;
            padding: 2px 5px !important;
            font-size: 0.85em !important;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
        }

        /* Artış ve azalış renkleri */
        .text-pos {
            color: var(--success-color);
            font-weight: 600;
        }

        .text-neg {
            color: var(--danger-color);
            font-weight: 600;
        }
    </style>
}

@* 2. KURAL: Güvenlik (CSRF) - Yetkisiz veri işlemlerini engellemek için eklendi *@
