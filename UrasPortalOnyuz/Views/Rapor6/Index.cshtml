@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const allReportData = @Html.Raw(reportDataJson);
            const table = document.getElementById('rapor6Table');
            const tableBody = table.querySelector('tbody');
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            const selectedCheckCountSpan = document.getElementById('selectedCheckCount');
            const totalRecordsSpan = document.getElementById('totalRecords');

            const SELECTED_COLOR = '#ffc107';
            const SELECTED_BORDER = '1px solid #e0a800';

            let currentlyFilteredRows = [...allReportData];
            let currentSortColumn = null;
            let currentSortDirection = 'none';

            // Veri Modeli ile Tablo Sütunları arasındaki eşleştirme
            const columnMappings = {
                'Checkbox': null,
                'MalzemeKodu': 'MalzemeKodu',
                'MalzemeAciklamasi': 'MalzemeAciklamasi',
                'SonFaturaTarihi': 'SonFaturaTarihi',
                'SonFiyatTRY': 'SonFiyatTRY',
                'SonParaBirimi': 'SonParaBirimi',
                'SonSaticiAdi': 'SonSaticiAdi',
                'SonSaticiGrupAdi': 'SonSaticiGrupAdi',
                'OncekiFaturaTarihi': 'OncekiFaturaTarihi',
                'OncekiFiyatTRY': 'OncekiFiyatTRY',
                'OncekiSaticiAdi': 'OncekiSaticiAdi',
                'OncekiSaticiGrupAdi': 'OncekiSaticiGrupAdi',
                'FiyatDegisimYuzdesiTRY': 'FiyatDegisimYuzdesiTRY',
                'FiyatDegisimYuzdesiEUR': 'FiyatDegisimYuzdesiEUR',
                'FiyatDegisimYuzdesiUSD': 'FiyatDegisimYuzdesiUSD',
                'ParaBirimiDurumu': 'ParaBirimiDurumu'
            };

            function updatePaginationInfo(totalCount) {
                if (totalRecordsSpan) {
                    totalRecordsSpan.textContent = totalCount;
                }
            }

            function updateSelectAllCheckboxState() {
                if (!selectAllCheckbox) return;
                const visibleCheckboxes = document.querySelectorAll('#rapor6Table tbody tr:not([style*="display: none"]) .row-selector');
                if (visibleCheckboxes.length > 0) {
                    const allChecked = Array.from(visibleCheckboxes).every(checkbox => checkbox.checked);
                    const anyChecked = Array.from(visibleCheckboxes).some(checkbox => checkbox.checked);
                    selectAllCheckbox.checked = allChecked;
                    selectAllCheckbox.indeterminate = !allChecked && anyChecked;
                } else {
                    selectAllCheckbox.checked = false;
                    selectAllCheckbox.indeterminate = false;
                }
            }

            function renderTable(data) {
                tableBody.innerHTML = '';
                if (data.length === 0) {
                    tableBody.innerHTML = '<tr><td colspan="16" class="text-center">Gösterilecek veri bulunamadı.</td></tr>';
                    updatePaginationInfo(0);
                    return;
                }
                const frag = document.createDocumentFragment();
                // Varsayılan sütun konfigürasyonu (hepsi görünür)
                const visibleColumns = Object.keys(columnMappings).map(key => ({ columnName: key, visible: true }));

                data.forEach(item => {
                    const row = document.createElement('tr');

                    visibleColumns.forEach(col => {
                        const cell = document.createElement('td');
                        cell.dataset.column = col.columnName;

                        if (col.columnName === 'Checkbox') {
                            cell.className = 'checkbox-column';
                            const checkbox = document.createElement('input');
                            checkbox.type = 'checkbox';
                            checkbox.className = 'form-check-input row-selector';
                            cell.appendChild(checkbox);
                        } else {
                            let value = item[col.columnName];

                            // Formatlama Mantığı
                            if (col.columnName.includes('Tarihi') && value) {
                                cell.textContent = new Date(value).toLocaleDateString('tr-TR');
                            } else if ((col.columnName.includes('Fiyat') || col.columnName.includes('Yuzdesi')) && typeof value === 'number') {
                                cell.textContent = value.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                                cell.style.textAlign = 'right';

                                // Yüzde değişimleri için renklendirme
                                if (col.columnName.includes('Yuzdesi')) {
                                    if (value > 0) cell.classList.add('text-neg'); // Fiyat artışı kırmızı
                                    else if (value < 0) cell.classList.add('text-pos'); // Fiyat düşüşü yeşil
                                    cell.textContent += '%';
                                }
                            } else {
                                cell.textContent = value ?? '';
                            }
                        }
                        row.appendChild(cell);
                    });
                    frag.appendChild(row);
                });

                tableBody.appendChild(frag);
                updatePaginationInfo(data.length);
                calculateSelectedTotal();
                updateSelectAllCheckboxState();
            }

            // Filtreleme Fonksiyonu
            function filterTableAndRender() {
                const filters = {};
                $('.filter-select-bs').each(function () {
                    const selectElement = $(this);
                    const columnKey = selectElement.closest('th').data('column');
                    const selectedValues = selectElement.val();
                    if (selectedValues && selectedValues.length > 0) {
                        filters[columnKey] = selectedValues.map(v => (v || '').toLowerCase().trim());
                    }
                });

                let filteredData = allReportData.filter(item => {
                    let isMatch = true;
                    for (const column in filters) {
                        const filterValues = filters[column];
                        const propName = columnMappings[column];
                        if (!propName) continue;

                        let itemValue = item[propName];
                        if (itemValue === null || itemValue === undefined) itemValue = '';
                        else itemValue = itemValue.toString();

                        itemValue = itemValue.toLowerCase().trim();

                        if (filterValues.length > 0 && !filterValues.includes(itemValue)) {
                            isMatch = false;
                            break;
                        }
                    }
                    return isMatch;
                });

                // Sıralama Mantığı
                if (currentSortColumn && currentSortDirection !== 'none') {
                    const sortType = document.querySelector(`th[data-column="${currentSortColumn}"]`)?.dataset.sortType;
                    const propName = columnMappings[currentSortColumn];

                    filteredData.sort((itemA, itemB) => {
                        let valA = itemA[propName];
                        let valB = itemB[propName];

                        if (valA === null || valA === undefined) valA = '';
                        if (valB === null || valB === undefined) valB = '';

                        let comparison = 0;
                        if (sortType === 'number') {
                            comparison = (parseFloat(valA) || 0) - (parseFloat(valB) || 0);
                        } else if (sortType === 'date') {
                             const dateA = valA ? new Date(valA).getTime() : 0;
                             const dateB = valB ? new Date(valB).getTime() : 0;
                             comparison = dateA - dateB;
                        } else {
                            comparison = (valA.toString()).localeCompare(valB.toString(), 'tr', { sensitivity: 'base' });
                        }
                        return currentSortDirection === 'asc' ? comparison : -comparison;
                    });
                }

                currentlyFilteredRows = filteredData;
                renderTable(currentlyFilteredRows);
            }

            // Sayfa Yüklendiğinde Başlat
            function initializePage() {
                $('.filter-select-bs').selectpicker({
                    liveSearch: true,
                    actionsBox: true,
                    selectedTextFormat: 'count > 2',
                    width: '100%',
                    container: 'body'
                }).on('changed.bs.select', function () {
                    filterTableAndRender();
                });

                document.querySelectorAll('th.sortable-column').forEach(header => {
                    header.addEventListener('click', function () {
                        const columnKey = this.dataset.column;
                        if (currentSortColumn === columnKey) {
                            if (currentSortDirection === 'asc') currentSortDirection = 'desc';
                            else if (currentSortDirection === 'desc') { currentSortDirection = 'none'; currentSortColumn = null; }
                            else currentSortDirection = 'asc';
                        } else {
                            currentSortColumn = columnKey;
                            currentSortDirection = 'asc';
                        }

                        document.querySelectorAll('th.sortable-column i').forEach(icon => icon.className = 'fas fa-sort float-end');
                        const sortIcon = this.querySelector('i');
                        if (sortIcon && currentSortDirection !== 'none') {
                            sortIcon.className = `fas fa-sort-${currentSortDirection === 'asc' ? 'up' : 'down'} float-end`;
                        }
                        filterTableAndRender();
                    });
                });

                renderTable(allReportData);
            }

            initializePage();

            // Checkbox Olayları (Seçim ve Renklendirme)
            selectAllCheckbox.addEventListener('change', function () {
                const isChecked = this.checked;
                document.querySelectorAll('#rapor6Table tbody tr:not([style*="display: none"]) .row-selector').forEach(checkbox => {
                    checkbox.checked = isChecked;
                });
                calculateSelectedTotal();
            });

            tableBody.addEventListener('change', function (event) {
                if (event.target.classList.contains('row-selector')) {
                    calculateSelectedTotal();
                    const allVisible = document.querySelectorAll('#rapor6Table tbody tr:not([style*="display: none"]) .row-selector');
                    const allChecked = document.querySelectorAll('#rapor6Table tbody tr:not([style*="display: none"]) .row-selector:checked');
                    selectAllCheckbox.checked = (allVisible.length > 0 && allVisible.length === allChecked.length);
                    selectAllCheckbox.indeterminate = (allChecked.length > 0 && allChecked.length < allVisible.length);
                }
            });

            function calculateSelectedTotal() {
                let selectedCount = 0;
                document.querySelectorAll('#rapor6Table tbody tr').forEach(row => {
                    const checkbox = row.querySelector('.row-selector');
                    if (checkbox) {
                        if (checkbox.checked) {
                            selectedCount++;
                            row.style.backgroundColor = SELECTED_COLOR;
                            row.style.border = SELECTED_BORDER;
                            row.classList.add('selected-hover');
                        } else {
                            row.style.backgroundColor = '';
                            row.style.border = '';
                            row.classList.remove('selected-hover');
                        }
                    }
                });
                selectedCheckCountSpan.textContent = selectedCount;
            }

            window.clearReportFilters = function () {
                $('.filter-select-bs').selectpicker('val', '');
                currentlyFilteredRows = [...allReportData];
                currentSortColumn = null;
                currentSortDirection = 'none';
                document.querySelectorAll('th.sortable-column i').forEach(icon => {
                    icon.className = 'fas fa-sort float-end';
                });
                renderTable(currentlyFilteredRows);
                toastr.success('Filtreler temizlendi!');
            };
        });
    </script>
}