@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string sekme = (string)ViewBag.Sekme ?? "malzeme";
    var sekmeler = new[] { ("malzeme", "Malzeme Fiyat Analizi", "fa-flask"), ("tedarikci", "Tedarikçi Karşılaştırması", "fa-code-compare"), ("aylik", "Aylık Fiyat Seyri", "fa-calendar-days"), ("detay", "Alım Detayı", "fa-list"),
        ("temsilci", "Temsilci Özeti", "fa-user-tie"), ("tedOzet", "Tedarikçi Özeti", "fa-truck"), ("kategori", "Kategori Özeti", "fa-layer-group"), ("ozet", "Özet", "fa-chart-pie") };
}
@*
    SATINALMA FİYAT ANALİZ RAPORU (/UrunFiyatKarsilastirma, 23 Kas 2026) — kullanıcı: "Satınalma Fiyat Analizi raporunu geliştirelim, temsilci seçelim, TL fiyat, dövizli fiyat, detaylı rapor hazırla".
    Veri /UrunFiyatKarsilastirma/Veri (Data/SatinalmaFiyatOrnek.cs: tedarikçi cari ekstre alış faturalarının kalemleri), betik wwwroot/js/satinalma-fiyat.js; hesap tarayıcıda.
    TASARIM (23 Kas 2026, kullanıcı Nakit Akış Planlama ekran görüntüsüyle: "Satınalma Fiyat Analizi raporunu bu rapor tasarımına uyarla"): Nakit Akış Planlama düzeni —
      beyaz üst şerit iki sıkı satır (1: başlık + dönem + doğrudan bağlantılar · 2: Getir, Döviz, Seçili Tutar kutuları, Excel, sağda bugünkü kurlar),
      tek satır süzgeç kartı (etiket kutunun solunda; hızlı dönem düğmeleri ve Temizle sağda), hap biçimli SAYILI sekmeler (sekmeye özgü düğmeler şeridin sağında),
      büyük harf başlık + sıralama oku, başlık altında süzgeç satırı, satır rengi fiyat yönüne göre, seçim kutusu + sıra no tek hücre, lacivert kurumsal renk.
      Tablo üstünde kutucuk yok: özet kartları Özet sekmesinde (en çok artan / düşen malzemelerle birlikte).
    Stil wwwroot/css/satinalma-fiyat.css (kendi kendine yeter) + ortak süzgeç çubuğu (suzgec-cubuk.js / .css).
    Sekmeler: Malzeme Fiyat Analizi · Tedarikçi Karşılaştırması · Aylık Fiyat Seyri · Alım Detayı | Temsilci Özeti · Tedarikçi Özeti · Kategori Özeti · Özet.
    Malzeme koduna / fiyata tıklayınca Fiyat Geçmişi penceresi (₺ ve döviz fiyat endeksi grafiği + alımlar).
*@
<link rel="stylesheet" href="/css/suzgec-cubuk.css?v=3" />
<link rel="stylesheet" href="/css/satinalma-fiyat.css?v=11" />

<div class="container-fluid py-1 sf" id="sr" data-rapor="satinalma-fiyat" data-sekme="@sekme">
    <div class="sf-ust">
        <div class="sf-ust-satir">
            <div class="sf-baslik"><h4><span class="rt-ikon"><i class="fas fa-chart-line"></i></span>Satınalma Fiyat Analiz Raporu</h4><div class="sf-donem" id="sfDonemYazi">Fiyat Analizi</div></div>
            <span class="sf-ornek" id="sfOrnek" hidden title="Alış faturaları tedarikçi cari ekstresinden gelir; fatura kalemleri (malzeme, miktar, birim fiyat) örnek olarak türetilir — portalda gerçek satınalma faturası satır kaynağı bağlı değil">Örnek Veri</span>
            <div class="sag">
            <a class="sf-pill" href="/AlimOnay" title="Aylık Alım Onay Ekranı'na git: tedarikçi faturalarının satınalmacı ve direktör onayı"><i class="fas fa-clipboard-check"></i>Aylık Alım Onay <i class="fas fa-arrow-up-right-from-square"></i></a>
            <a class="sf-pill" href="/Rapor52" title="Tedarikçi Fatura ve Ödeme Takip raporuna git: bu rapordaki alış faturalarının vade ve ödeme durumu"><i class="fas fa-truck"></i>Tedarikçi Fatura ve Ödeme Takip <i class="fas fa-arrow-up-right-from-square"></i></a>
            <a class="sf-pill" href="/Rapor20" title="Cari Ekstre Raporu'na git: carinin hareketleri, bakiyesi ve açık kalemleri"><i class="fas fa-file-invoice"></i>Cari Ekstre <i class="fas fa-arrow-up-right-from-square"></i></a>
            </div>
        </div>
        <div class="sf-ust-satir">
            <button type="button" class="btn btn-primary btn-sm" id="sfGetir" title="Veriyi yeniden getir"><i class="fas fa-rotate me-2"></i>Getir</button>
            <span class="sf-secim" id="sfDoviz" title="Döviz fiyatı sütunlarının para birimi (fatura günü TCMB kuruyla)"><span class="e">Döviz</span><button type="button" data-d="USD" class="aktif">$ USD</button><button type="button" data-d="EUR">€ EUR</button></span>
            <span class="sf-kutu" title="Tabloda işaretli satırların ₺ alım tutarı"><i class="fas fa-calculator"></i>Seçili Tutar (₺) <b id="sfSeciliTl">0&nbsp;₺</b></span>
            <span class="sf-kutu" title="Tabloda işaretli satırların döviz alım tutarı (fatura günü kuruyla)"><i class="fas fa-coins"></i><span>Seçili Tutar (<span id="sfSeciliDvAd">$</span>)</span> <b id="sfSeciliDv">0&nbsp;$</b></span>
            <button type="button" class="btn btn-light btn-sm border" id="sfExcel" title="Ekrandaki tabloyu göründüğü gibi Excel'e aktar (.xlsx)"><i class="fas fa-file-excel me-2 text-success"></i>Excel</button>
            <div class="sag"><span class="sf-pill bilgi" id="sfKur" title="Bugünkü kur (TCMB serisi)"></span></div>
        </div>
    </div>

    <div class="sf-filtre-kart"><div id="sfSuz"></div></div>
    @* süzgeç çubuğuna taşınan ekler: dönem tarihleri (şirketten sonra) ve hızlı dönem düğmeleri (Temizle'nin solunda) *@
    <span id="sfEk" hidden><span class="sf-tarih"><label for="sfBas">Başlangıç</label><input type="date" id="sfBas" /></span><span class="sf-tarih"><label for="sfBit">Bitiş</label><input type="date" id="sfBit" /></span></span>
    <span class="sf-hizli" id="sfHizli" hidden><button type="button" data-donem="ay">Bu Ay</button><button type="button" data-donem="3">3 Ay</button><button type="button" data-donem="6">6 Ay</button><button type="button" data-donem="12">12 Ay</button><button type="button" data-donem="tum">Tümü</button></span>

    <div class="sf-govde">
    <div class="sf-sekme" id="sfSekmeler" data-dinamik="kapali">
        @foreach (var s in sekmeler) { if (s.Item1 == "temsilci") { <span class="ayrac"></span> } <button type="button" data-p="@s.Item1"><i class="fas @s.Item3"></i>@s.Item2<span class="n"></span></button> }
        <span class="sf-sekme-islem"><span id="sfIslem"></span><span class="sf-kapsam" id="sfKapsam"></span></span>
    </div>

    <div class="sf-kart" id="sfTabloKart">
        <section class="sr-kap" id="sfKap"><table class="sr-tablo" id="sfTablo" data-dinamik="kapali"><colgroup></colgroup><thead></thead><tbody><tr><td class="bos">Yükleniyor…</td></tr></tbody><tfoot></tfoot></table></section>
    </div>

    @* Özet sekmesi: kutucuklar (tablo üstünde yer kaplamasın diye burada) + en çok artan / düşen malzemeler *@
    <div class="sf-ozet" id="sfOzet" hidden>
        <div class="sf-kpi" id="sfKpi" data-dinamik="kapali"></div>
        <div class="sf-ozet-izgara">
            <div class="sf-kart"><div class="sf-kart-b"><i class="fas fa-arrow-trend-up art"></i>Fiyatı En Çok Artan Malzemeler (₺)</div><section class="sr-kap"><table class="sr-tablo" id="sfOzetArt" data-dinamik="kapali"><colgroup></colgroup><thead></thead><tbody></tbody><tfoot></tfoot></table></section></div>
            <div class="sf-kart"><div class="sf-kart-b"><i class="fas fa-arrow-trend-down dus"></i>Fiyatı En Çok Düşen Malzemeler (₺)</div><section class="sr-kap"><table class="sr-tablo" id="sfOzetDus" data-dinamik="kapali"><colgroup></colgroup><thead></thead><tbody></tbody><tfoot></tfoot></table></section></div>
        </div>
    </div>
    </div>

    @* Fatura İncelemesi penceresi (eski adı Fiyat Geçmişi): malzemenin bütün alış faturaları, ₺ ve döviz fiyat endeksi (ilk alım = 100); kod, ad ya da herhangi bir fiyata tıklayınca açılır.
       perde ve pencere <section>: kabuk, tablo içeren her div'in max-height değerini ezer (pencere ekrandan taşardı) *@
    <section class="gc-perde" id="sfPerde" hidden>
        <section class="gc-pencere">
            <div class="gc-ust">
                <span class="gc-ikon"><i class="fas fa-magnifying-glass-dollar"></i></span>
                <div class="gc-baslik"><div class="ad" id="sfGcAd"></div><div class="alt" id="sfGcAlt"></div></div>
                <div class="gc-sag"><button type="button" class="sr-dgm" id="sfGcExcel"><i class="fas fa-file-excel"></i>Excel</button><button type="button" class="gc-kapat" id="sfGcKapat" title="Kapat (Esc)"><i class="fas fa-xmark"></i></button></div>
            </div>
            <div class="sf-kpi gc-kpi" id="sfGcKpi" data-dinamik="kapali"></div>
            <div class="sf-grafik" id="sfGcGrafik"></div>
            <section class="gc-kap"><table class="sr-tablo" id="sfGcTablo" data-dinamik="kapali"><colgroup></colgroup><thead></thead><tbody></tbody><tfoot></tfoot></table></section>
        </section>
    </section>

    @* Fatura penceresi: tek alış faturasının başlığı ve bütün kalemleri; fatura tarihine / belge numarasına tıklayınca açılır (Fatura İncelemesi'nin üstünde durur) *@
    <section class="gc-perde gc-fat" id="sfFatPerde" hidden>
        <section class="gc-pencere">
            <div class="gc-ust">
                <span class="gc-ikon"><i class="fas fa-file-invoice"></i></span>
                <div class="gc-baslik"><div class="ad" id="sfFtAd"></div><div class="alt" id="sfFtAlt"></div></div>
                <div class="gc-sag">
                    <span class="sf-ornek" id="sfFtOrnek" hidden title="Fatura cari ekstreden gelir; kalemleri (malzeme, miktar, birim fiyat) örnek olarak türetilir — portalda gerçek satınalma faturası satır kaynağı bağlı değil">Örnek Veri</span>
                    <a class="sr-dgm" id="sfFtEkstre" target="_blank" rel="noopener" title="Tedarikçinin Cari Ekstre Raporu"><i class="fas fa-file-invoice"></i>Cari Ekstre</a>
                    <a class="sr-dgm" id="sfFtTakip" target="_blank" rel="noopener" title="Tedarikçi Fatura ve Ödeme Takip: bu faturanın vade ve ödeme durumu"><i class="fas fa-truck"></i>Fatura ve Ödeme Takip</a>
                    <button type="button" class="sr-dgm" id="sfFtExcel"><i class="fas fa-file-excel"></i>Excel</button><button type="button" class="gc-kapat" id="sfFtKapat" title="Kapat (Esc)"><i class="fas fa-xmark"></i></button>
                </div>
            </div>
            <div class="sf-kpi gc-kpi" id="sfFtKpi" data-dinamik="kapali"></div>
            <section class="gc-kap"><table class="sr-tablo" id="sfFtTablo" data-dinamik="kapali"><colgroup></colgroup><thead></thead><tbody></tbody><tfoot></tfoot></table></section>
        </section>
    </section>
</div>

@section Scripts {
<script src="/js/tablo-excel.js?v=16"></script>
<script src="/js/suzgec-cubuk.js?v=3"></script>
<script src="/js/satinalma-fiyat.js?v=13"></script>
}
