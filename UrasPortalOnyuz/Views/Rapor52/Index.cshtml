@{
    ViewData["Title"] = "Tedarikçi Fatura ve Ödeme Takip Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string onKod = (string)ViewBag.Kod ?? "";
}
@*
    TEDARİKÇİ FATURA VE ÖDEME TAKİP RAPORU — yeni tasarım. Tedarikçi cari kartları (ortak 14 süzgeç) üzerinde: borç bakiyesi, açık alış faturalarının vade kırılımı (gecikmiş · bu hafta · 8–30 · 31–60 · 60+),
    verilen çek / senetler, Kasa Nakit Akışı'ndaki planlı ödemeler, son ödeme / son alım, ortalama ödeme gecikmesi, kredi (açık hesap) limiti ve risk. Tedarikçi detayında alış faturaları
    (ödeme eşleşmesi, durum), ödemeler ve verilen çekler, eşleşmemiş ödemeler, planlı ödemeler, günlük; Otomatik Kapat, Ödeme Talebi, Kasa Nakit Akışı, ekstre PDF / Excel, kart, adat bağlantıları.
    Ödeme Takvimi: açık fatura vadeleri ve nakit akış planı hafta hafta. Uçlar: Controllers/TedarikciController.cs · betik: wwwroot/js/tedarikci-takip.js
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<link rel="stylesheet" href="/css/cari-islem.css?v=2" />
}
<div class="container-fluid py-3 na ci tt" id="tt" data-kod="@onKod">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-truck"></i></span>Tedarikçi Fatura ve Ödeme Takip Raporu</h4>
        <span style="font-size:.68rem;font-weight:700;color:#475569;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:999px;padding:3px 10px"><i class="fas fa-database me-1"></i>Tedarikçi Kartları + Cari Mutabakat + Kasa Nakit Akışı</span>
        <span class="sub w-100">Tedarikçi bazında <b>açık alış faturaları</b> (gecikmiş · bu hafta · 8–30 · 31–60 · 60+ gün), <b>verilen çek / senetler</b>, Kasa Nakit Akışı'ndaki <b>planlı ödemeler</b>, son ödeme / son alım, ortalama ödeme gecikmesi, açık hesap limiti ve risk. Tedarikçi detayında fatura ↔ ödeme eşleşmesi, eşleşmemiş ödemeler ve planlı ödemeler; <b>Otomatik Kapat</b>, <b>Ödeme Talebi</b> ve Kasa Nakit Akışı bağlantıları. Ödeme Takvimi fatura vadeleri ile nakit akış planını hafta hafta karşılaştırır.</span>
    </div>
    <div class="na-sekme" id="ttSekmeler" data-dinamik="kapali">
        <button type="button" data-p="liste" class="aktif"><i class="fas fa-list me-1"></i>Tedarikçiler <span class="n" id="ttN">0</span></button>
        <button type="button" data-p="detay"><i class="fas fa-file-invoice me-1"></i>Tedarikçi Detayı <span class="n" id="ttNDetay">—</span></button>
        <button type="button" data-p="takvim"><i class="fas fa-calendar-week me-1"></i>Ödeme Takvimi</button>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>
    <div class="ci-kpi" id="ttKpi"></div>
    <div class="na-panel aktif" data-p="liste">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-filter me-1"></i>Filtreler</span><span class="d-flex gap-1"><button type="button" class="btn btn-light btn-sm py-0" id="ttTemizle" style="font-size:.66rem">Temizle</button><button type="button" class="btn btn-light btn-sm py-0" id="ttExcel" style="font-size:.66rem"><i class="fas fa-file-excel me-1"></i>Excel</button><a class="btn btn-light btn-sm py-0" style="font-size:.66rem" href="/Rapor53"><i class="fas fa-building me-1"></i>Konsolide Ödeme Takip</a></span></div>
            <div class="na-kart-g">
                <div id="ttSuzgec"></div>
                <div class="ci-filtre">
                    <div><label>Ödeme Durumu</label><select class="form-select" id="ttDurum"><option value="">Tümü</option><option value="gecmis">Gecikmiş Ödemesi Olan</option><option value="buhafta">Bu Hafta Vadesi Gelen</option><option value="plan">Planlı Ödemesi Olan</option><option value="planGecikmis">Planı Gecikmiş</option><option value="cek">Verilen Çeki Olan</option><option value="eslesmemis">Eşleşmemiş Ödemesi Olan</option><option value="acik">Açık Borcu Olan</option></select></div>
                    <div><label>Sırala</label><select class="form-select" id="ttSirala"><option value="gecmis">Gecikmiş (Büyükten)</option><option value="acik">Açık Toplam</option><option value="buhafta">Bu Hafta</option><option value="plan">Planlı Ödeme</option><option value="borc">Borç Bakiyesi</option><option value="kod">Cari Kodu</option></select></div>
                    <div class="ms-auto na-mini" id="ttSayi"></div>
                </div>
                <div class="table-responsive"><table class="na-tablo ci-liste" id="ttTablo" data-dinamik="kapali"><thead><tr><th>Tedarikçi · Satınalmacı</th><th>Şirket</th><th class="e">Borç Bakiyesi</th><th class="e">Gecikmiş</th><th class="e">Bu Hafta</th><th class="e">8+ Gün (8–30 · 31–60 · 60+)</th><th class="e">Açık Toplam</th><th class="e">Verilen Çek / Senet</th><th class="e">Planlı Ödeme</th><th>Son Ödeme · Son Alım</th><th>Risk · Limit</th><th></th></tr></thead><tbody></tbody><tfoot></tfoot></table></div>
            </div>
        </div>
    </div>
    <div class="na-panel" data-p="detay">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-truck me-1"></i>Tedarikçi</span><span class="d-flex gap-1 align-items-center"><select class="form-select" id="ttCari" style="width:340px;font-size:.68rem;height:24px;padding:0 20px 0 6px"><option value="">Seçiniz…</option></select><select class="form-select" id="ttAy" style="width:auto;font-size:.66rem;height:24px;padding:0 20px 0 6px"><option value="6">Son 6 Ay</option><option value="12" selected>Son 12 Ay</option><option value="24">Son 24 Ay</option></select></span></div>
            <div class="na-kart-g"><div class="ci-bilgi" id="ttOzet"><span class="text-muted">Listeden ya da yukarıdan bir tedarikçi seçin.</span></div><div class="d-flex gap-1 flex-wrap mt-1" id="ttIslem"></div></div></div>
        <div class="row g-2">
            <div class="col-xl-7"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-file-invoice me-1"></i>Alış Faturaları <span class="n" id="ttNFat">0</span></span><span class="d-flex gap-1 align-items-center"><select class="form-select" id="ttFatDurum" style="width:auto;font-size:.66rem;height:24px;padding:0 20px 0 6px"><option value="">Tümü</option><option value="acik">Yalnız Açık</option><option>Gecikmiş</option><option>Bu Hafta</option><option>Vadesi Gelecek</option><option>Ödendi</option></select></span></div>
                <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:480px"><table class="na-tablo ci-liste" id="ttFaturalar" data-dinamik="kapali"><thead><tr><th>Belge No</th><th>Tarih</th><th>Vade</th><th class="s">Gün</th><th class="s">Tip</th><th class="e">Tutar</th><th class="e">Kalan</th><th class="e">Kalan (TL)</th><th>Durum</th><th>Ödeme Eşleşmesi</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div></div></div>
            <div class="col-xl-5">
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-money-bill-transfer me-1"></i>Ödemeler ve Verilen Çekler <span class="n" id="ttNOde">0</span></span><span class="not">eşleşmemiş ödemeler sarı</span></div>
                    <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:300px"><table class="na-tablo ci-liste" id="ttOdemeler" data-dinamik="kapali"><thead><tr><th>Belge</th><th>Tip</th><th>Tarih</th><th>Vade</th><th class="e">Tutar</th><th class="e">TL</th><th>Durum</th></tr></thead><tbody></tbody></table></div></div></div>
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-calendar-check me-1"></i>Kasa Nakit Akışı · Planlı Ödemeler <span class="n" id="ttNPlan">0</span></span><span class="not">tüm grup şirketleri</span></div>
                    <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:300px"><table class="na-tablo ci-liste" id="ttPlanlar" data-dinamik="kapali"><thead><tr><th>Şirket</th><th>Plan Tarihi</th><th>Belge</th><th>Yöntem</th><th class="e">Tutar (TL)</th><th>Durum</th><th></th></tr></thead><tbody></tbody></table></div></div></div>
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-clock-rotate-left me-1"></i>Günlük</span></div><div class="na-kart-g" id="ttLog" style="font-size:.62rem"></div></div>
            </div>
        </div>
    </div>
    <div class="na-panel" data-p="takvim">
        <div class="row g-2">
            <div class="col-lg-7"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-calendar-week me-1"></i>Haftalık Ödeme Takvimi (Fatura Vadeleri ↔ Nakit Akış Planı)</span><span class="not">liste süzgecine göre</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="ttHafta" data-dinamik="kapali"><thead><tr><th>Hafta</th><th>Tarih Aralığı</th><th class="s">Fatura</th><th class="e">Vadesi Gelen (TL)</th><th class="s">Plan</th><th class="e">Planlı Ödeme (TL)</th><th class="e">Fark</th><th>Dağılım</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div></div></div>
            <div class="col-lg-5"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-list-ol me-1"></i>Seçili Haftanın Faturaları</span><span class="not" id="ttHaftaNot">satıra tıklayın</span></div><div class="na-kart-g p-0"><div class="table-responsive" style="max-height:480px"><table class="na-tablo ci-liste" id="ttHaftaDetay" data-dinamik="kapali"><thead><tr><th>Vade</th><th>Tedarikçi</th><th>Belge</th><th class="s">Tip</th><th class="e">Kalan</th><th class="e">TL</th></tr></thead><tbody><tr><td colspan="6" class="na-bos">Haftalık tablodan bir satır seçin.</td></tr></tbody></table></div></div></div></div>
        </div>
    </div>
</div>
@section Scripts {
<script src="/js/cari-suzgec.js?v=1"></script>
<script src="/js/tedarikci-takip.js?v=4"></script>
}
