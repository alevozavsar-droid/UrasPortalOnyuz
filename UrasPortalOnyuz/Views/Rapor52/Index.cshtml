@model List<WebApplication3.Models.Rapor52ViewModel>
@using WebApplication3.Models
@using System.Globalization
@using System.Net
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Xsrf

@{
    ViewData["Title"] = "Satın Alma Fatura ve Ödeme Takip Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 1. KURAL: URL'den veya varsa Cookie'den aktif şirketi okuma (currentDb)
    var currentDb = Context.Request.Query["db"].ToString();
    if (string.IsNullOrEmpty(currentDb))
    {
        currentDb = Context.Request.Cookies["ActiveDb"] ?? "VarsayilanSirket";
    }

    var currentSelectedDbDisplay = (string)ViewBag.CurrentDbDisplay ?? currentDb;
    var selectedBpCode = (string)ViewBag.SelectedBpCode;
    var bpName = ViewBag.SelectedBpName ?? "Muhatap Adı Bulunamadı";
    var vendorList = ViewBag.VendorList as List<CariViewModel> ?? new List<CariViewModel>(); // Tedarikçi listesi
    var culture = new CultureInfo("tr-TR");
    var allData = Model ?? new List<Rapor52ViewModel>();

    // Sadece SATINALMA FATURASI ve FATURA DIŞI ALACAK satırları için (Ana tablo verisi)
    var faturalarVeAlacaklar = allData.Where(d => d.IslemTipi == "SATINALMA FATURASI" || d.IslemTipi.StartsWith("FATURA DIŞI ALACAK")).OrderBy(d => d.SiralamaNo).ThenBy(d => d.SiraTipi).ToList();

    // Ödemeleri, Fatura No'ya göre grupluyoruz.
    var odemeler = allData.Where(d => d.IslemTipi == "ÖDEME" || d.IslemTipi == "KREDİ NOTU" || d.IslemTipi == "YEVMIYE ÖDEME").GroupBy(d => d.FaturaNo).ToDictionary(g => g.Key, g => g.ToList());

    // Özet Metrikler Controller'dan çekildi
    decimal totalOverdueAmount = (decimal)ViewBag.TotalOverdueAmount;
    double avgOverdueAdat = (double)ViewBag.AvgOverdueAdat;
    int countOverdueInvoices = (int)ViewBag.CountOverdueInvoices;
    int daysSinceOldestOverdue = (int)ViewBag.DaysSinceOldestOverdue;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/v/bs5/dt-1.11.5/r-2.2.9/sc-2.0.5/sl-1.3.4/datatables.min.css" />

    <style>
        /* Ana Stil Ayarları */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
        }

        .container {
            max-width: 100%;
            padding: 0 10px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Yeni Özet Kart Stilleri */
        .summary-card {
            border-left: 5px solid #007bff;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        .bg-overdue {
            background-color: #ffe0e0;
            border-left-color: #dc3545 !important;
        }

        .text-huge {
            font-size: 2.2rem;
            font-weight: 600;
        }

        .text-danger-custom {
            color: #dc3545;
        }

        /* Tedarikçi raporuna özel stil - Alacak/Borç yerleri tersine dönebilir */
        .fatura-row.fatura-disi-alacak {
             background-color: #d1e7dd !important; /* Yeşil tonu (Alacak) */
             border-left: 5px solid #198754;
        }
        
        .table-container {
            max-height: calc(100vh - 240px);
            overflow-y: auto;
            border-radius: 8px;
            background-color: white;
            border: 1px solid #dee2e6;
        }
    </style>
}

<div class="container mt-4">
    @* 2. KURAL: Güvenlik (CSRF) - Yetkisiz istek manipülasyonlarını engellemek amacıyla eklendi *@
    @Html.AntiForgeryToken()
    
    <input type="hidden" id="currentDb" value="@currentDb" />

    <div class="header text-center p-3 mb-4 rounded shadow-sm text-white" style="background-color: #0d6efd;">
        <h2>SATIN ALMA FATURA VE ÖDEME TAKİP RAPORU (Tedarikçi Raporu)</h2>
        <p class="mb-0">Seçilen tedarikçi muhatabın satın alma faturası, fatura dışı alacak ve ödeme hareketleri</p>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">@ViewBag.ErrorMessage</div>
    }

    <div id="loading-message" class="text-center mt-3" style="display:none;">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Yükleniyor...</span></div>
        <span class="ms-2 fw-bold text-primary">Veri yükleniyor...</span>
    </div>

    <div class="database-info mb-4 p-2 rounded" style="background-color: #e9ecef; border-left: 4px solid #0d6efd;">
        <i class="fas fa-database me-2"></i> Aktif veritabanı: <strong>@currentSelectedDbDisplay</strong>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Rapor Filtreleri</h5>
            <form asp-controller="Rapor52" asp-action="Index" method="get">
                <input type="hidden" name="db" value="@currentDb" />

                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-6 col-lg-4">
                        <label for="bpCode" class="form-label">Tedarikçi Seçimi</label>
                        <select class="form-control form-control-sm" id="bpCode" name="bpCode">
                            <option value="">-- Tedarikçi Seçiniz --</option>
                            @if (vendorList.Any())
                            {
                                foreach (var vendor in vendorList)
                                {
                                    @* ÇÖZÜM: selectedSelectedBpCode hatası selectedBpCode değişkeni ile düzeltildi *@
                                    <option value="@vendor.CardCode" selected="@(vendor.CardCode == selectedBpCode)">@($"{vendor.CardCode} - {vendor.CardName}")</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-6 col-md-3 col-lg-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100"><i class="fas fa-search me-1"></i>Raporla</button>
                    </div>

                    <div class="col-6 col-md-3 col-lg-2">
                        <button id="exportToExcelBtn" type="button" class="btn btn-success btn-sm w-100" @(string.IsNullOrEmpty(selectedBpCode) ? "disabled" : "")>
                            <i class="fas fa-file-excel me-1"></i> Excel'e Aktar
                        </button>
                    </div>

                    <div class="col-12 col-md-6 col-lg-2">
                        <a id="reconciliationSimulationBtn" href="@Url.Action("ReconciliationSimulation", new { bpCode = selectedBpCode, db = currentDb })" class="btn btn-danger btn-sm w-100 @(string.IsNullOrEmpty(selectedBpCode) ? "disabled" : "")">
                            <i class="fas fa-sync-alt me-1"></i> Mutabakat Sim.
                        </a>
                    </div>

                    <div class="col-12 col-md-6 col-lg-2">
                        <button id="toggleAllOdemeBtn" type="button" class="btn btn-warning btn-sm w-100" @(string.IsNullOrEmpty(selectedBpCode) ? "disabled" : "")>
                            <i class="fas fa-layer-group me-1"></i> Tüm Ödemeleri Aç/Kapat
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(selectedBpCode))
    {
        <div class="cari-bilgi mb-3">
            <h4>Seçilen Tedarikçi: <strong>@selectedBpCode - @bpName</strong></h4>
        </div>

        <div class="row mb-4">
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card summary-card @(totalOverdueAmount > 0 ? "bg-overdue" : "border-left-success")">
                    <div class="card-body p-3">
                        <h6 class="card-subtitle mb-2 text-muted small">Vadesi Geçmiş Açık Borç Tutarı (Tedarikçiye)</h6>
                        <div class="text-huge @(totalOverdueAmount > 0 ? "text-danger-custom" : "text-success")">@totalOverdueAmount.ToString("N2", culture)</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card summary-card">
                    <div class="card-body p-3">
                        <h6 class="card-subtitle mb-2 text-muted small">Vadesi Geçmiş Açık Borç Adat Ort. (Gün)</h6>
                        <div class="text-huge text-primary">@avgOverdueAdat.ToString("N2", culture)</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card summary-card">
                    <div class="card-body p-3">
                        <h6 class="card-subtitle mb-2 text-muted small">Vadesi Geçmiş Açık Borç Adedi</h6>
                        <div class="text-huge text-success">@countOverdueInvoices</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card summary-card @(daysSinceOldestOverdue > 0 ? "bg-overdue" : "border-left-info")">
                    <div class="card-body p-3">
                        <h6 class="card-subtitle mb-2 text-muted small">Vadesi Geçmiş En Eski Borç Farkı (Gün)</h6>
                        <div class="text-huge @(daysSinceOldestOverdue > 0 ? "text-danger-custom" : "text-info")">@daysSinceOldestOverdue</div>
                    </div>
                </div>
            </div>
        </div>

        <div id="progress-container" class="mt-3" style="display:none;">
            <div class="progress" style="height: 20px;">
                <div id="progress-bar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%;"></div>
            </div>
            <p class="text-center mt-1"><small id="progress-text">İşlem başlatılıyor...</small></p>
        </div>

        <div id="selected-summary" class="alert alert-light mt-3 py-2" style="display:none;">
            <i class="fas fa-calculator me-2"></i>
            Seçilen Kayıtlar Toplamı:
            <strong id="selected-borc-total" class="borc">0,00</strong> (Borç - Tedarikçiye) /
            <strong id="selected-alacak-total" class="alacak">0,00</strong> (Alacak - Tedarikçiden) /
            <strong id="selected-kalan-total" class="kalan">0,00</strong> (Açık Kalan Bakiye)
        </div>

        <div class="table-container shadow-sm p-3">
            <table id="rapor-tablo" class="table table-bordered table-striped table-hover rapor-tablo" style="width:100%">
                <thead>
                    <tr>
                        <th style="width: 30px;" class="text-center">
                            <input type="checkbox" id="selectAllCheckbox" title="Tümünü Seç">
                        </th>
                        <th style="width: 120px;">İşlem No</th>
                        <th style="width: 80px;">İşlem Tipi</th>
                        <th style="width: 120px;">Belge/Kayıt Tar. Ay/Yıl</th>
                        <th style="width: 100px;">Belge/Kayıt Tarihi</th>
                        <th style="width: 80px;">Kritik Vade Bil. (Gün)</th>
                        <th style="width: 120px;">Vade Tar. Ay/Yıl</th>
                        <th style="width: 100px;">Vade Tarihi</th>
                        <th style="width: 100px;" class="text-right">Borç Tutarı (Tedarikçiye)</th>
                        <th style="width: 100px;" class="text-right">Alacak Tutarı (Tedarikçiden)</th>
                        <th style="width: 100px;" class="text-right">Açık Kalan Bakiye</th>
                        <th style="width: 100px;" class="text-right">Hesap Bakiyesi</th>
                        <th style="width: 120px;">Kritik Ödeme Vadesi Ay/Yıl</th>
                        <th style="width: 100px;">Kritik Ödeme Vadesi</th>
                        <th style="width: 100px;">Ödeme/Tahsilat Şekli</th>
                        <th style="width: 120px;">Çek No / EFT No</th>
                        <th style="width: 120px;">Çek Vade Tar. Ay/Yıl</th>
                        <th style="width: 100px;">Çek Vade Tarihi</th>
                        <th style="width: 80px;">Ödeme Yaşl. (Gün)</th>
                        <th style="width: 80px;">Adat Yaşl. (Gün)</th>
                        <th style="width: 100px;">Mutabakat Durumu</th>
                        <th style="width: 100px;">Mutabakat No</th>
                        <th style="width: 150px;">Durum Bilgisi</th>
                    </tr>
                </thead>
                <tbody id="rapor-body">
                    @foreach (var item in faturalarVeAlacaklar)
                    {
                        var jsonString = item.IslemTipi == "SATINALMA FATURASI" && item.FaturaNo.HasValue && odemeler.ContainsKey(item.FaturaNo.Value)
                        ? System.Text.Json.JsonSerializer.Serialize(odemeler[item.FaturaNo.Value])
                        : "[]";
                        var safeJsonString = WebUtility.HtmlEncode(jsonString);

                        string rowClass = "fatura-row";
                        if (item.IslemTipi.StartsWith("FATURA DIŞI ALACAK"))
                        {
                            rowClass += " fatura-disi-alacak";
                        }
                        
                        if (item.DurumBilgisi == "BORÇ VADESİ GEÇTİ")
                        {
                            rowClass += " table-danger";
                        }
                        else if (item.DurumBilgisi == "KAPANDI" || item.DurumBilgisi == "Ödendi")
                        {
                            rowClass += " table-success";
                        }
                        else if (item.IslemTipi.StartsWith("FATURA DIŞI ALACAK") && item.DurumBilgisi == "AÇIK")
                        {
                            rowClass += " table-warning";
                        }

                        <tr class="@rowClass"
                            data-fatura-no="@(item.FaturaNo.HasValue? item.FaturaNo.Value.ToString() : "null")"
                            data-islem-tipi="@item.IslemTipi"
                            data-borc="@item.Borc?.ToString(CultureInfo.InvariantCulture)"
                            data-alacak="@item.Alacak?.ToString(CultureInfo.InvariantCulture)"
                            data-kalan="@item.Kalan?.ToString(CultureInfo.InvariantCulture)"
                            data-odeme-json="@safeJsonString">

                            <td></td>
                            <td class="details-control @(item.IslemTipi == "SATINALMA FATURASI" ? "text-primary" : "")">
                                @{
                                    bool hasDetails = item.IslemTipi == "SATINALMA FATURASI" && item.FaturaNo.HasValue && odemeler.ContainsKey(item.FaturaNo.Value);
                                }
                                @if (hasDetails)
                                {
                                    <i class="fas fa-plus-circle fa-lg me-2"></i>
                                }
                                @item.IslemNoStr
                            </td>
                            <td>@item.IslemTipi</td>
                            <td>@item.BelgeTarihiAyYil</td>
                            <td data-order="@item.BelgeTarihi?.Ticks">@item.BelgeTarihi?.ToString("dd.MM.yyyy")</td>
                            <td class="text-center">@item.TedarikciVadeGunu</td> 
                            <td>@item.VadeTarihiAyYil</td>
                            <td data-order="@item.VadeTarihi?.Ticks">@item.VadeTarihi?.ToString("dd.MM.yyyy")</td>
                            <td class="text-right " data-order="@item.Borc">@item.Borc?.ToString("N2", culture)</td>
                            <td class="text-right alacak" data-order="@item.Alacak">@item.Alacak?.ToString("N2", culture)</td>
                            <td class="text-right kalan" data-order="@item.Kalan">@item.Kalan?.ToString("N2", culture)</td>
                            <td class="text-right" data-order="@item.Bakiye">@item.Bakiye?.ToString("N2", culture)</td>

                            <td>@item.OdemeTarihiAyYil</td>
                            <td data-order="@item.KritikOdemeVadesi?.Ticks">@item.KritikOdemeVadesi?.ToString("dd.MM.yyyy")</td>
                            <td>@item.OdemeTuru</td>
                            <td>@item.CekNo</td>
                            <td>@item.CekVadesiAyYil</td>
                            <td data-order="@item.CekVadesi?.Ticks">@item.CekVadesi?.ToString("dd.MM.yyyy")</td>

                            <td class="text-right">@item.OdemeYaslandirma</td> 
                            <td class="text-right">@item.AdatYaslandirma</td>

                            <td>@item.MutabakatDurumu</td>
                            <td>@item.MutabakatNumarasi</td>

                            <td class="text-center">
                                @if (item.DurumBilgisi == "BORÇ VADESİ GEÇTİ")
                                {
                                    <span class="badge bg-danger">@item.DurumBilgisi</span>
                                }
                                else if (item.DurumBilgisi == "KAPANDI" || item.DurumBilgisi == "Ödendi")
                                {
                                    <span class="badge bg-success">@item.DurumBilgisi</span>
                                }
                                else if (item.DurumBilgisi == "AÇIK")
                                {
                                    <span class="badge bg-primary">@item.DurumBilgisi</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.DurumBilgisi</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* 4. KURAL: UI/UX Standartlarına uygun şık, db parametreli Ana Sayfa Dönüş butonu *@
    <div class="mt-4 mb-4 text-center">
        <a asp-controller="Home" asp-action="Index" asp-route-db="@currentDb" class="btn btn-outline-secondary fw-bold shadow-sm">
            <i class="fas fa-home me-2"></i> Ana Sayfaya Dön
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/v/bs5/dt-1.11.5/r-2.2.9/sc-2.0.5/sl-1.3.4/datatables.min.js"></script>

    <script>
        $(document).ready(function () {
            
            // --- GÜVENLİK VE AJAX STANDARTLARI (KURAL 1 ve 2) ---
            const currentDb = $('#currentDb').val();
            const csrfToken = $('input[name="__RequestVerificationToken"]').val();

            // Tüm jQuery AJAX isteklerine otomatik olarak Token ve db parametresi eklenmesi
            $.ajaxSetup({
                headers: { 'RequestVerificationToken': csrfToken },
                data: { db: currentDb }
            });
            // ----------------------------------------------------

            var tableApi;
            var isAllOpen = false;
            var CHUNK_SIZE = 50;
            var rowsToProcess = [];

            function formatCurrency(number) {
                if (number === null || isNaN(number)) return '0,00';
                number = parseFloat(number);
                return number.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function updateSelectedSummary() {
                var totalBorc = 0;
                var totalAlacak = 0;
                var totalKalan = 0;

                tableApi.rows({ page: 'current', search: 'applied' }).nodes().to$().each(function () {
                    var $row = $(this);
                    var isFaturaOrAlacak = $row.hasClass('fatura-row');

                    if (isFaturaOrAlacak && $row.find('.row-select-checkbox').is(':checked')) {
                        var borc = parseFloat($row.data('borc')) || 0;
                        var alacak = parseFloat($row.data('alacak')) || 0;
                        var kalan = parseFloat($row.data('kalan')) || 0;

                        totalBorc += borc;
                        totalAlacak += alacak;
                        totalKalan += kalan;
                    }
                });

                if (totalBorc > 0 || totalAlacak > 0 || totalKalan !== 0) {
                    $('#selected-borc-total').text(formatCurrency(totalBorc));
                    $('#selected-alacak-total').text(formatCurrency(totalAlacak));
                    $('#selected-kalan-total').text(formatCurrency(totalKalan));
                    $('#selected-summary').show();
                } else {
                    $('#selected-summary').hide();
                }
            }

            function syncFilterWidths(tableApi) {
                var $tableWrapper = tableApi.table().container();
                var $scrollHead = $('.dataTables_scrollHead', $tableWrapper);
                var $scrollHeadInner = $('.dataTables_scrollHeadInner', $tableWrapper);
                var $filterTable = $('#filter-table');

                if ($scrollHeadInner.length === 0 || $filterTable.length === 0) {
                    return;
                }

                tableApi.columns.adjust();

                $filterTable.css('width', $scrollHeadInner.width());

                $('th', $scrollHeadInner).each(function (index) {
                    var $th = $(this);
                    var width = $th.outerWidth();
                    $('#filter-headers th').eq(index).css('width', width);
                });

                $('.dataTables_scrollBody', $tableWrapper).on('scroll', function () {
                    $('#filter-table-wrapper').scrollLeft($(this).scrollLeft());
                });
            }

            function createAndInjectFilterRow(tableApi) {
                var $tableWrapper = tableApi.table().container();
                var $scrollHead = $('.dataTables_scrollHead', $tableWrapper);

                var $filterTable = $('<table id="filter-table" class="table table-bordered table-striped rapor-tablo" style="width: 100%; margin-bottom: 0px !important;"><thead><tr id="filter-headers"></tr></thead></table>');
                var $filterRow = $('#filter-headers', $filterTable);

                var $filterWrapper = $('<div id="filter-table-wrapper"></div>');
                $filterWrapper.append($filterTable);

                $scrollHead.after($filterWrapper);

                tableApi.columns().every(function (index) {
                    var column = this;
                    var $newTh = $('<th></th>');

                    if (index > 0) {
                        var selectId = 'filter-select-injected-' + index;
                        var $select = $('<select id="' + selectId + '" multiple="multiple" class="form-select form-select-sm" data-placeholder="' + $('th', tableApi.table().header()).eq(index).text().trim() + ' Tümü"></select>');
                        $newTh.append($select);

                        $select.select2({
                            theme: "bootstrap-5",
                            dropdownAutoWidth: true,
                            width: 'resolve',
                            allowClear: true,
                            closeOnSelect: false,
                            templateSelection: function (selected, container) {
                                var count = $select.select2('data').length;
                                var placeholder = $select.attr('data-placeholder');
                                return (count === 0) ? placeholder : (count === 1) ? selected.text : count + ' Öğe Seçildi';
                            },
                        });

                        $select.on('change', function () {
                            var selectedValues = $(this).val();

                            if (selectedValues && selectedValues.length > 0) {
                                var regex = selectedValues.map(function (val) {
                                    return $.fn.dataTable.util.escapeRegex(val);
                                }).join('|');
                                column.search('^(' + regex + ')$', true, false).draw();
                            } else {
                                column.search('', false, false).draw();
                            }
                            $('#selectAllCheckbox').prop('checked', false);
                            updateSelectedSummary();
                        });

                        column.data().unique().sort().each(function (d, j) {
                            var display = $('<div>').html(d).text().trim();
                            if (display && display !== '') {
                                if ($select.find('option[value="' + display + '"]').length === 0) {
                                    $select.append('<option value="' + display + '">' + display + '</option>');
                                }
                            }
                        });
                    }
                    $filterRow.append($newTh);
                });

                syncFilterWidths(tableApi);
            }

            function formatOdeme(tr, faturaNo) {
                var islemTipi = $(tr).data('islem-tipi');

                if (islemTipi && islemTipi.startsWith('FATURA DIŞI ALACAK')) {
                    return '<div class="alert alert-info py-1 text-center small m-2">Fatura Dışı Alacak işlemlerinin ödeme detayları bu raporda alt satır olarak gösterilmez.</div>';
                }

                var encodedJson = $(tr).data('odeme-json');

                if (!faturaNo || faturaNo === 'null' || !encodedJson || encodedJson.length <= 4) {
                    return '<div class="alert alert-info py-1 text-center small m-2">Bu işleme ait ödeme kaydı bulunmamaktadır.</div>';
                }

                var decodedJson = $('<div>').html(encodedJson).text();

                var odemeData;
                try {
                    odemeData = JSON.parse(decodedJson);
                } catch (e) {
                    return '<div class="alert alert-danger py-1 text-center small m-2">Ödeme verisi ayrıştırılamadı. Lütfen sunucu loglarını kontrol edin.</div>';
                }

                if (!odemeData || odemeData.length === 0) {
                    return '<div class="alert alert-info py-1 text-center small m-2">Bu faturaya ait ödeme kaydı bulunmamaktadır.</div>';
                }

                var html = '<div style="padding: 10px 50px;"><table class="table table-sm table-bordered table-striped sub-table" style="width:100%; margin: 5px 0 5px 0;">' +
                    '<thead>' +
                    '<tr class="bg-secondary text-white">' +
                    '<th style="width:120px;">İşlem No (Ödeme)</th>' +
                    '<th style="width:100px;">İşlem Tipi</th>' +
                    '<th style="width:100px;" class="text-right">Alacak Tutarı (Kapanan Borç)</th>' +
                    '<th style="width:100px;">Ödeme Tipi</th>' +
                    '<th style="width:120px;">Çek No / EFT No</th>' +
                    '<th style="width:100px;">Ödeme Tarihi</th>' +
                    '<th style="width:100px;">Çek Vade Tarihi</th>' +
                    '<th style="width:100px;">Ödeme Yaşl. (Gün)</th>' +
                    '<th style="width:100px;">Mutabakat No</th>' +
                    '<th style="width:150px;">Durum Bilgisi</th>' +
                    '</tr>' +
                    '</thead>' +
                    '<tbody>';

                $.each(odemeData, function (i, odeme) {
                    if (odeme.FaturaNo === parseInt(faturaNo)) {
                        html += '<tr>' +
                            '<td>' + odeme.IslemNoStr + '</td>' +
                            '<td>' + odeme.IslemTipi + '</td>' +
                            '<td class="text-right alacak">' + formatCurrency(odeme.Alacak) + '</td>' +
                            '<td>' + odeme.OdemeTuru + '</td>' +
                            '<td>' + (odeme.CekNo || '') + '</td>' +
                            '<td>' + (odeme.KritikOdemeVadesi ? new Date(odeme.KritikOdemeVadesi).toLocaleDateString('tr-TR') : '') + '</td>' +
                            '<td>' + (odeme.CekVadesi ? new Date(odeme.CekVadesi).toLocaleDateString('tr-TR') : '') + '</td>' +
                            '<td class="text-right">' + (odeme.OdemeYaslandirma || '0') + '</td>' +
                            '<td>' + (odeme.MutabakatNumarasi || '') + '</td>' +
                            '<td>' + (odeme.DurumBilgisi || '') + '</td>' +
                            '</tr>';
                    }
                });

                html += '</tbody></table></div>';
                return html;
            }

            function processChunk(i, total) {
                if (i >= total) {
                    $('#progress-container').hide();
                    $('#toggleAllOdemeBtn').on('click').prop('disabled', false).html(isAllOpen ? '<i class="fas fa-plus-circle me-1"></i> Tüm Ödemeleri Aç' : '<i class="fas fa-minus-circle me-1"></i> Tüm Ödemeleri Kapat');
                    isAllOpen = !isAllOpen;
                    return;
                }

                var end = Math.min(i + CHUNK_SIZE, total);
                for (let k = i; k < end; k++) {
                    let rowData = rowsToProcess[k];
                    let row = tableApi.row(rowData.tr);
                    let tr = $(rowData.tr);
                    let icon = tr.find('td.details-control i');
                    let islemTipi = tr.data('islem-tipi');

                    if (islemTipi === "SATINALMA FATURASI" && tr.data('odeme-json').length > 4) {
                        if (rowData.action === 'open') {
                            if (row.child.isShown() !== true) {
                                row.child(formatOdeme(tr, tr.data('fatura-no'))).show();
                                tr.addClass('details-shown');
                                icon.removeClass('fa-plus-circle').addClass('fa-minus-circle');
                            }
                        } else {
                            if (row.child.isShown()) {
                                row.child.hide();
                                tr.removeClass('details-shown');
                                icon.removeClass('fa-minus-circle').addClass('fa-plus-circle');
                            }
                        }
                    }
                }

                var progress = Math.round((end / total) * 100);
                $('#progress-bar').css('width', progress + '%').attr('aria-valuenow', progress);
                $('#progress-text').text(`İşleniyor: %${progress} (${end} / ${total})`);

                setTimeout(() => processChunk(end, total), 10);
            }

            function toggleAllOdemeAsync() {
                $('#toggleAllOdemeBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> İşleniyor...');
                $('#progress-container').show();
                $('#progress-bar').css('width', '0%').attr('aria-valuenow', 0);

                rowsToProcess = [];

                tableApi.rows({ page: 'current', search: 'applied' }).every(function () {
                    var tr = $(this.node());
                    var islemTipi = tr.data('islem-tipi');
                    if (islemTipi === "SATINALMA FATURASI" && tr.data('fatura-no') && tr.data('odeme-json').length > 4) {
                        rowsToProcess.push({
                            tr: this.node(),
                            action: isAllOpen ? 'close' : 'open'
                        });
                    }
                });

                var totalRows = rowsToProcess.length;

                if (totalRows === 0) {
                    processChunk(0, 0);
                    return;
                }

                processChunk(0, totalRows);
            }

            if ($('#rapor-body tr').length > 0 && $('#rapor-body tr:first td').length > 1) {

                tableApi = $('#rapor-tablo').DataTable({
                    responsive: false,
                    scrollX: true,
                    ordering: true,
                    searching: true,
                    info: true,
                    lengthChange: false,
                    paging: false,
                    order: [[1, 'asc']],
                    language: {
                        url: "//cdn.datatables.net/plug-ins/1.11.5/i18n/tr.json"
                    },
                    columnDefs: [
                        {
                            orderable: false, searchable: false, className: 'text-center', targets: 0,
                            render: function (data, type, row) {
                                return '<input type="checkbox" class="row-select-checkbox">';
                            }
                        },
                        { orderable: true, searchable: true, className: 'dt-control details-control', targets: 1 },
                        { targets: [4, 7, 8, 9, 10, 11, 13, 17, 18, 19], type: 'num-html' }
                    ],
                    initComplete: function () {
                        var api = this.api();
                        createAndInjectFilterRow(api);

                        setTimeout(function () {
                            syncFilterWidths(api);
                            api.columns.adjust().draw();
                        }, 100);

                        hideLoading();
                    }
                });

                $('#rapor-tablo tbody').on('change', '.row-select-checkbox', function (e) {
                    var $row = $(this).closest('tr');
                    $row.toggleClass('selected-manually', this.checked);

                    var $visibleCheckboxes = tableApi.rows({ page: 'current', search: 'applied' }).nodes().to$().find('.row-select-checkbox');
                    var allChecked = $visibleCheckboxes.length > 0 && $visibleCheckboxes.filter(':checked').length === $visibleCheckboxes.length;

                    $('#selectAllCheckbox').prop('checked', allChecked);

                    updateSelectedSummary();
                });

                $('#selectAllCheckbox').on('change', function () {
                    var isChecked = this.checked;

                    tableApi.rows({ page: 'current', search: 'applied' }).nodes().to$().each(function () {
                        var $row = $(this);
                        $row.find('.row-select-checkbox').prop('checked', isChecked);
                        $row.toggleClass('selected-manually', isChecked);
                    });

                    updateSelectedSummary();
                });

                $('#rapor-tablo tbody').on('click', 'td.details-control', function () {
                    var tr = $(this).closest('tr');
                    var row = tableApi.row(tr);
                    var icon = $(this).find('i');
                    var faturaNo = tr.data('fatura-no');
                    var islemTipi = tr.data('islem-tipi');

                    if (islemTipi !== "SATINALMA FATURASI" || !faturaNo || tr.data('odeme-json').length <= 4) {
                        return;
                    }

                    if (row.child.isShown()) {
                        row.child.hide();
                        tr.removeClass('details-shown');
                        icon.removeClass('fa-minus-circle').addClass('fa-plus-circle');
                    } else {
                        row.child(formatOdeme(tr, faturaNo)).show();
                        tr.addClass('details-shown');
                        icon.removeClass('fa-plus-circle').addClass('fa-minus-circle');
                    }
                });

                $('#toggleAllOdemeBtn').on('click', function () {
                    toggleAllOdemeAsync();
                });

                $(window).on('resize', function () {
                    tableApi.columns.adjust().draw();
                    syncFilterWidths(tableApi);
                });

                tableApi.on('draw', function () {
                    $('#selectAllCheckbox').prop('checked', false);
                    updateSelectedSummary();
                    syncFilterWidths(tableApi);
                });

            } else {
                hideLoading();
            }

            $('#exportToExcelBtn').on('click', function () {
                var selectedBpCode = $('#bpCode').val();
                if (!selectedBpCode) {
                    alert('Lütfen raporu dışa aktarmak için bir tedarikçi seçiniz.');
                    return;
                }

                showLoading();

                // KURAL 1 ve 2: Dinamik form oluşturup POST atarken db ve CSRF parametrelerini de gönderiyoruz.
                var form = $('<form action="/Rapor52/ExportToExcel" method="post"></form>');
                form.append('<input type="hidden" name="__RequestVerificationToken" value="' + csrfToken + '">');
                form.append('<input type="hidden" name="db" value="' + currentDb + '">');
                form.append('<input type="hidden" name="bpCode" value="' + selectedBpCode + '">');
                
                $('body').append(form);
                form.submit();

                setTimeout(function () {
                    hideLoading();
                }, 5000);
            });
        });

        function showLoading() {
            document.getElementById('loading-message').style.display = 'block';
        }

        function hideLoading() {
            document.getElementById('loading-message').style.display = 'none';
        }
    </script>
}