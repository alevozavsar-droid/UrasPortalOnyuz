@{
    ViewData["Title"] = "Araç Takip Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string onSekme = (string)ViewBag.Sekme ?? "ozet";
    string onPlaka = (string)ViewBag.Plaka ?? "";
    string ben = (string)ViewBag.Ben ?? "";
}
@*
    ARAÇ TAKİP RAPORU · FİLO ÖZETİ — İK ve İdari İşler › İdari İşler › Araç, Taşınmaz ve Demirbaş. Tüm araçlar tek tabloda ve senkron: kayıtlı şirket, zimmet, km, kasko / trafik
    (Sigorta ekranı), bakım durumu ve muayene (Araç Bakım), ruhsat belgeleri (Şirket Dökümanları); idari işler alanları: km girişi (aracın km'si otomatik güncellenir), yakıt tüketimi
    ve aylık limit (L / ₺), yakıt alımları, HGS aylık limit ve gerçekleşen, ev–iş mesafesi → 30 günde kaç litre / ₺ hesabı, uyarılar (limit aşımı, poliçe yok, bakım / muayene gecikti, km girilmedi).
    Sekmeler: Özet · Km Girişi · Yakıt · HGS · Limitler · Ev–İş Hesabı. Çekmece: aracın tüm takip bilgisi ve bağlantılar. Veri: /AracTakip/Veri (Controllers/AracTakipController.cs,
    Data/AracTakipOrnek.cs) · betik: wwwroot/js/arac-takip.js
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<style>
    .na.at { --na-k: #be123c; }
    .at-pill { font-size: .66rem; font-weight: 700; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 3px 10px; } a.at-pill { text-decoration: none; } a.at-pill:hover { background: #ffe4e6; color: #9f1239; border-color: #fecdd3; }
    #at .na-kpi { grid-template-columns: repeat(8, 1fr); } @@media (max-width: 1400px) { #at .na-kpi { grid-template-columns: repeat(4, 1fr); } }
    .at-filtre { display: grid; grid-template-columns: 1fr 1fr 1fr 1.6fr auto; gap: 6px 8px; align-items: end; }
    .at-filtre label, .at-ic label { display: block; font-size: .58rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 2px; }
    .at-filtre .form-control, .at-filtre .form-select, .at-ic .form-control, .at-ic .form-select { font-size: .72rem; padding: 3px 7px; height: 28px; }
    #at .at-tablo { font-size: .68rem; table-layout: fixed; width: 100%; }
    #at .at-tablo th { font-size: .56rem; padding: 5px 5px; white-space: normal; line-height: 1.15; vertical-align: middle; position: sticky; top: 0; z-index: 3; background: #f8fafc; box-shadow: 0 1px 0 #e2e8f0; }
    #at .at-tablo td { padding: 4px 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; vertical-align: middle; line-height: 1.2; border-bottom: 1px solid #e2e8f0; }
    #at .at-tablo td.sol { text-align: left !important; } #at .at-tablo td.para { font-variant-numeric: tabular-nums; text-align: right !important; font-weight: 700; }
    #at .at-tablo td small { display: block; font-size: .56rem; color: #64748b; font-weight: 500; line-height: 1.15; overflow: hidden; text-overflow: ellipsis; }
    #at .at-tablo tr.tik { cursor: pointer; } #at .at-tablo tr.tik:hover td { background: #fff1f2; }
    #at .at-tablo tr.uyari td { background: #fffbeb; } #at .at-tablo tr.kritik td { background: #fef2f2; }
    #at .at-tablo tr.toplam td { font-weight: 800; background: #f8fafc; border-top: 2px solid var(--na-k); }
    .at-rozet { display: inline-block; font-size: .58rem; font-weight: 800; border-radius: 4px; padding: 1px 6px; white-space: nowrap; } .at-rozet.ok { background: #dcfce7; color: #166534; } .at-rozet.uyar { background: #fef3c7; color: #92400e; } .at-rozet.hata { background: #fee2e2; color: #991b1b; } .at-rozet.bilgi { background: #dbeafe; color: #1e40af; } .at-rozet.notr { background: #f1f5f9; color: #475569; }
    .at-plaka { display: inline-block; font-family: monospace; font-weight: 800; font-size: .66rem; background: #fff; border: 1.5px solid #0f172a; border-left: 6px solid #1d4ed8; border-radius: 4px; padding: 0 5px; white-space: nowrap; }
    .at-bar { display: inline-block; width: 56px; height: 7px; background: #e2e8f0; border-radius: 999px; overflow: hidden; vertical-align: middle; margin-right: 4px; } .at-bar i { display: block; height: 100%; background: #16a34a; } .at-bar i.uyar { background: #d97706; } .at-bar i.hata { background: #dc2626; }
    #at .btn-xs { font-size: .58rem; padding: 1px 6px; line-height: 1.3; }
    .at-ic { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr 1.4fr auto; gap: 6px 8px; align-items: end; background: #fff1f2; border: 1px solid #fecdd3; border-radius: 10px; padding: 8px 10px; } @@media (max-width: 1100px) { .at-ic { grid-template-columns: repeat(3, 1fr); } }
    .at-drawer { position: fixed; top: 0; right: -860px; width: 820px; max-width: 97vw; height: 100vh; background: #fff; box-shadow: -8px 0 24px rgba(15,23,42,.18); z-index: 1060; transition: right .25s; overflow: auto; padding: 12px 14px; } .at-drawer.acik { right: 0; }
    .main-content #atDrawer { height: 100vh !important; max-height: 100vh !important; overflow: auto !important; }
    .at-drawer-ust { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; position: sticky; top: 0; background: #fff; padding-bottom: 6px; border-bottom: 1px solid #e2e8f0; z-index: 2; flex-wrap: wrap; }
    .at-perde { position: fixed; inset: 0; background: rgba(15,23,42,.35); z-index: 1055; display: none; } .at-perde.acik { display: block; }
    .at-hesap { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; } @@media (max-width: 1100px) { .at-hesap { grid-template-columns: repeat(2, 1fr); } }
    .at-hesap .k { background: #fff; border: 1px solid #e2e8f0; border-left: 4px solid var(--na-k); border-radius: 10px; padding: 8px 12px; } .at-hesap .k .l { font-size: .58rem; font-weight: 800; text-transform: uppercase; color: #64748b; letter-spacing: .04em; } .at-hesap .k .v { font-size: 1.1rem; font-weight: 800; color: #0f172a; } .at-hesap .k .s { font-size: .62rem; color: #64748b; }
    .at-uyari { font-size: .64rem; color: #991b1b; } .at-uyari span { display: inline-block; background: #fee2e2; border-radius: 4px; padding: 0 5px; margin: 1px 2px 1px 0; }
</style>
}

<div class="container-fluid py-3 na at" id="at" data-sekme="@onSekme" data-plaka="@onPlaka">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-car-side"></i></span>Araç Takip Raporu · Filo Özeti</h4>
        <span class="at-pill" id="atKapsam">…</span>
        <a class="at-pill" href="/AracBakim" target="_blank" rel="noopener"><i class="fas fa-car-wrench me-1"></i>Araç Bakım ve Onarım</a>
        <a class="at-pill" href="/Sigorta?sekme=araclar" target="_blank" rel="noopener"><i class="fas fa-shield-halved me-1"></i>Sigorta ve Kasko</a>
        <a class="at-pill" href="/SirketDokuman/Varlik" target="_blank" rel="noopener"><i class="fas fa-folder-tree me-1"></i>Ruhsat / Muayene Belgeleri</a>
        <a class="at-pill" href="/Zimmet?sekme=kisiler" target="_blank" rel="noopener"><i class="fas fa-laptop me-1"></i>Zimmet Raporu</a>
        <span class="at-pill"><i class="fas fa-user me-1"></i>@ben</span>
        <span class="sub w-100">İdari İşler için <b>tüm araçlar tek tabloda</b>: hangi şirkete kayıtlı, kimde, km, <b>kaskosu ve trafik sigortası var mı</b> (Sigorta ekranından canlı), <b>bakım durumu</b> ve muayene (Araç Bakım'dan canlı), ruhsat belgeleri (Şirket Dökümanları). Bu ekranda ayrıca <b>km girişi</b> yapılır (aracın km'si ve sonraki bakım hesabı otomatik güncellenir), <b>yakıt tüketimi ve aylık yakıt limiti</b>, yakıt alımları, <b>aylık HGS limiti</b> ve gerçekleşen tutar izlenir; <b>ev–iş mesafesine göre 30 günde kaç litre / kaç ₺ yakıt</b> tüketileceği hesaplanır, limit aşımları ve eksikler uyarı olarak çıkar. Raporlar aynı veriyi paylaşır; bir ekranda yapılan değişiklik diğerlerinde görünür.</span>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>

    <div class="na-kpi" id="atKpi" data-dinamik="kapali"></div>

    <div class="na-sekme" id="atSekmeler" data-dinamik="kapali">
        <button type="button" data-p="ozet" class="aktif"><i class="fas fa-table-list me-1"></i>Filo Özeti <span class="n" id="atN-ozet">0</span></button>
        <button type="button" data-p="km"><i class="fas fa-gauge me-1"></i>Km Girişi</button>
        <button type="button" data-p="yakit"><i class="fas fa-gas-pump me-1"></i>Yakıt</button>
        <button type="button" data-p="hgs"><i class="fas fa-road me-1"></i>HGS</button>
        <button type="button" data-p="limitler"><i class="fas fa-sliders me-1"></i>Limitler</button>
        <button type="button" data-p="hesap"><i class="fas fa-calculator me-1"></i>Ev–İş Yakıt Hesabı</button>
    </div>

    <div class="na-panel aktif" data-p="ozet">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-table-list me-1"></i>Araçlar · Şirket, Sigorta, Bakım, Km, Yakıt ve HGS</span><span class="not" id="atSayi"></span></div>
            <div class="na-kart-g">
                <div class="at-filtre">
                    <div><label>Şirket</label><select class="form-select" id="atSirketF"><option value="">Tümü</option></select></div>
                    <div><label>Durum</label><select class="form-select" id="atDurumF"><option value="">Tümü</option><option value="uyari">Uyarısı Olanlar</option><option value="kasko">Kaskosu Olmayan</option><option value="bakim">Bakımı Geciken</option><option value="yakit">Yakıt Limitini Aşan</option><option value="hgs">HGS Limitini Aşan</option><option value="km">Km Girişi Eksik</option></select></div>
                    <div><label>Tip</label><select class="form-select" id="atTipF"><option value="">Tümü</option></select></div>
                    <div><label>Ara</label><input class="form-control" id="atAra" placeholder="Plaka, araç, zimmet, departman…" autocomplete="off"></div>
                    <div><label>&nbsp;</label><button type="button" class="btn btn-light border btn-sm py-0" id="atExcel" style="font-size:.66rem;height:28px"><i class="fas fa-file-excel me-1"></i>Excel</button></div>
                </div>
            </div>
            <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:66vh"><table class="na-tablo at-tablo" id="atTablo" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>

    <div class="na-panel" data-p="km">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-gauge me-1"></i>Km Girişi · Aylık Km Bildirimi</span><span class="not">girilen km aracın güncel km'si olur; Araç Bakım'daki sonraki bakım hesabı ve yakıt tüketimi buna göre güncellenir</span></div>
            <div class="na-kart-g"><div class="at-ic"><div><label>Araç</label><select class="form-select" id="kmPlaka"></select></div><div><label>Tarih</label><input type="date" class="form-control" id="kmTarih"></div><div><label>Km</label><input type="number" class="form-control" id="kmDeger"></div><div><label>Son Kayıt</label><div class="form-control" id="kmSon" style="background:#f8fafc">—</div></div><div><label>Not</label><input class="form-control" id="kmNot" placeholder="aylık bildirim, servis çıkışı…"></div><div><label>&nbsp;</label><button type="button" class="btn btn-primary btn-sm py-0" id="kmKaydet" style="font-size:.68rem;height:28px"><i class="fas fa-floppy-disk me-1"></i>Km Kaydet</button></div></div></div>
            <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:50vh"><table class="na-tablo at-tablo" id="atKmTablo" data-dinamik="kapali"><thead></thead><tbody></tbody></table></div></div>
        </div>
    </div>

    <div class="na-panel" data-p="yakit">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-gas-pump me-1"></i>Yakıt · Alımlar, Limit ve Tüketim</span><span class="d-flex gap-2 align-items-center"><span class="not">yakıt fiyatı: benzin <b id="atBenzin"></b> · dizel <b id="atDizel"></b> ₺/L</span><button type="button" class="btn btn-light border btn-xs" id="atFiyatBtn"><i class="fas fa-pen me-1"></i>Fiyat</button></span></div>
            <div class="na-kart-g"><div class="at-ic"><div><label>Araç</label><select class="form-select" id="ykPlaka"></select></div><div><label>Tarih</label><input type="date" class="form-control" id="ykTarih"></div><div><label>Litre</label><input type="number" step="0.1" class="form-control" id="ykLitre"></div><div><label>Tutar (₺) · boş = fiyattan</label><input type="number" step="0.01" class="form-control" id="ykTutar"></div><div><label>İstasyon · Km</label><div class="d-flex gap-1"><input class="form-control" id="ykIstasyon" list="ykIstasyonlar"><datalist id="ykIstasyonlar"></datalist><input type="number" class="form-control" id="ykKm" placeholder="km" style="max-width:90px"></div></div><div><label>&nbsp;</label><button type="button" class="btn btn-primary btn-sm py-0" id="ykKaydet" style="font-size:.68rem;height:28px"><i class="fas fa-floppy-disk me-1"></i>Alım Kaydet</button></div></div></div>
            <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:50vh"><table class="na-tablo at-tablo" id="atYakitTablo" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>

    <div class="na-panel" data-p="hgs">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-road me-1"></i>HGS · Aylık Limit ve Gerçekleşen</span><span class="not">aylık HGS ekstresi girilir; limit aşımı kırmızı</span></div>
            <div class="na-kart-g"><div class="at-ic" style="grid-template-columns:1.4fr 1fr 1fr 1fr auto"><div><label>Araç</label><select class="form-select" id="hgPlaka"></select></div><div><label>Ay</label><input type="month" class="form-control" id="hgAy"></div><div><label>Tutar (₺)</label><input type="number" step="0.01" class="form-control" id="hgTutar"></div><div><label>Geçiş Sayısı</label><input type="number" class="form-control" id="hgGecis"></div><div><label>&nbsp;</label><button type="button" class="btn btn-primary btn-sm py-0" id="hgKaydet" style="font-size:.68rem;height:28px"><i class="fas fa-floppy-disk me-1"></i>HGS Kaydet</button></div></div></div>
            <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:50vh"><table class="na-tablo at-tablo" id="atHgsTablo" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>

    <div class="na-panel" data-p="limitler">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-sliders me-1"></i>Limitler · Tüketim, Yakıt, HGS, Ev–İş Mesafesi</span><span class="not">satırdaki değerleri değiştirip Kaydet · yakıt limiti ₺ karşılığı fiyattan hesaplanır</span></div>
            <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:66vh"><table class="na-tablo at-tablo" id="atLimitTablo" data-dinamik="kapali"><thead></thead><tbody></tbody></table></div></div>
        </div>
    </div>

    <div class="na-panel" data-p="hesap">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-calculator me-1"></i>Ev–İş Yakıt Hesabı · 30 Günde Kaç Litre?</span><span class="not">30 gün = çalışma günü × 2 (gidiş-dönüş) × mesafe · litre = km × tüketim / 100 · ₺ = litre × yakıt fiyatı</span></div>
            <div class="na-kart-g"><div class="at-ic" style="grid-template-columns:1.4fr 1fr 1fr 1fr 1fr auto"><div><label>Araç</label><select class="form-select" id="hsPlaka"></select></div><div><label>Ev–İş Mesafesi (km, tek yön)</label><input type="number" step="0.1" class="form-control" id="hsMesafe"></div><div><label>Çalışma Günü (30 günde)</label><input type="number" class="form-control" id="hsGun"></div><div><label>Tüketim (L/100 km)</label><input type="number" step="0.1" class="form-control" id="hsTuketim"></div><div><label>Yakıt Fiyatı (₺/L)</label><input type="number" step="0.01" class="form-control" id="hsFiyat"></div><div><label>&nbsp;</label><button type="button" class="btn btn-light border btn-sm py-0" id="hsLimiteYaz" style="font-size:.68rem;height:28px" title="Hesaplanan değerleri aracın limitine kaydet"><i class="fas fa-floppy-disk me-1"></i>Limite Kaydet</button></div></div>
                <div class="at-hesap mt-2" id="hsSonuc"></div>
            </div>
            <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:50vh"><table class="na-tablo at-tablo" id="atHesapTablo" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>

    <div class="at-perde" id="atPerde"></div>
    <div class="at-drawer" id="atDrawer">
        <div class="at-drawer-ust"><b id="atDBaslik" style="font-size:.88rem"></b><span class="ms-auto"></span><button type="button" class="btn btn-light btn-sm py-0" id="atDKapat" style="font-size:.66rem"><i class="fas fa-xmark"></i></button></div>
        <div id="atDIc"></div>
    </div>
</div>
@section Scripts {
<script src="/js/arac-takip.js?v=1"></script>
}
