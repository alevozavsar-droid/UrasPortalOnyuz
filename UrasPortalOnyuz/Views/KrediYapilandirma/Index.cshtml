    // üç küme: kredi sekmeleri (öncesi ↔ sonrası, takvim, aylık yük) | teminat ve belge sekmeleri (rehin · ipotek takibi, teminat çekleri, belgeler) | konkordato (alacaklı bankalar, sözleşmeler · kefiller, mühlet tarihi bakiyeleri, tahsilatlar, teminat mektupları; 10 Kas 2026); "rehin" ve "konkordato" ayraçla başlar
    var sekmeler = new[] { ("ozet", "Özet", "fa-chart-pie"), ("krediler", "Krediler · Öncesi ↔ Sonrası", "fa-table-list"), ("oncesi", "Yapılandırma Öncesi", "fa-clock-rotate-left"), ("sonrasi", "Yapılandırma Sonrası", "fa-file-signature"), ("takvim", "Taksit Takvimi", "fa-calendar-days"), ("aylik", "Aylık Nakit Yükü", "fa-chart-column"), ("borclar", "Banka Borç Dökümü", "fa-file-invoice-dollar"),
        ("rehin", "Rehin · İpotek Takibi", "fa-house-lock"), ("cekler", "Teminat Çekleri", "fa-money-check-dollar"), ("belgeler", "Belgeler · Sözleşme / GKS", "fa-file-pdf"),
        ("konkordato", "Konkordato · Alacaklı Bankalar", "fa-scale-balanced"), ("sozlesmeler", "Kredi Sözleşmeleri · Kefiller", "fa-file-contract"), ("hesaplar", "Mühlet Tarihi Bakiyeleri", "fa-list-ol"), ("tahsilatlar", "Mühlet Sonrası Tahsilatlar", "fa-hand-holding-dollar"), ("mektuplar", "Teminat Mektupları", "fa-envelope-open-text"),
        ("kontrol", "Banka Kontrol Listesi", "fa-list-check") };   // 11 Kas 2026: banka × şirket veri kontrol listesi (tüm bilgiler yüklendiyse OK)
    var grupIlk = new[] { "krediler", "rehin", "konkordato" };
    // Özet sekmesi (10 Kas 2026, "Kredi Raporu'na bir özet sekmesi hazırla"): açılış sekmesi; dava dosyası şeridi + alacaklı bankalar özeti (ana tablo kyTablo-ozet) + borçlu şirketler, teminat · rehin · gayrinakdi, yapılandırma, tahsilat kanalları, süreç takvimi tabloları
    var ozetTablolar = new[] { ("ozetSirket", "Borçlu Şirketler", "fa-building"), ("ozetTeminat", "Teminat · Rehin · Gayrinakdi", "fa-house-lock"), ("ozetKredi", "Yapılandırma Durumu", "fa-file-signature"), ("ozetTahsilat", "Mühlet Sonrası Tahsilat Kanalları", "fa-hand-holding-dollar"), ("ozetTakvim", "Süreç Takvimi", "fa-calendar-days") };
