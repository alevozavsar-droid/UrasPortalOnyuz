@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string sekme = (string)ViewBag.Sekme ?? "krediler";
    var sekmeler = new[] { ("krediler", "Krediler · Öncesi ↔ Sonrası", "fa-table-list"), ("oncesi", "Yapılandırma Öncesi", "fa-clock-rotate-left"), ("sonrasi", "Yapılandırma Sonrası", "fa-file-signature"), ("teminat", "Teminatlar · İpotek", "fa-house-lock"), ("takvim", "Taksit Takvimi", "fa-calendar-days"), ("aylik", "Aylık Nakit Yükü", "fa-chart-column") };
}
@*
    KREDİ YAPILANDIRMA RAPORU (9 Kas 2026) — Mali İşler › Finans › Krediler ve Finansman. Veri /KrediYapilandirma/Veri (Data/KrediYapilandirmaOrnek.cs, App_Data/kredi-yapilandirma.json kalıcı),
    betik wwwroot/js/kredi-yapilandirma.js, ortak stil nakit-avans.css. Kredi ekle / düzenle modalı: yapılandırma öncesi, sonrası, teminatlar (ipotek …), not, nakit akışa aktarım.
    Taksitler Kasa Nakit Akışı'na Havale / EFT satırı (belge no "KRD-001 · 03/36") ve Planlı Düzenli Ödemeler'e "Kredi" kaydı olarak akar. Derin bağlantı: /KrediYapilandirma?sekme=takvim
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<style>
    .na.ky { --na-k: #1e40af; }
    .ky-pill { font-size: .66rem; font-weight: 700; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 2px 8px; } a.ky-pill { text-decoration: none; } a.ky-pill:hover { background: #dbeafe; color: #1e3a8a; border-color: #bfdbfe; }
    #ky .na-ust { margin-bottom: 6px; } #ky .na-kpi { margin-bottom: 6px; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 5px; } #ky .na-kart { margin-bottom: 6px; } #ky .na-kart-b { padding: 4px 12px; }
    #ky .na-kpi > div { padding: 5px 8px; min-width: 0; overflow: hidden; } #ky .na-kpi .v { font-size: .9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } #ky .na-kpi .l { font-size: .54rem; letter-spacing: .02em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    @@media (max-width: 1500px) { #ky .na-kpi { grid-template-columns: repeat(4, 1fr); } }
    .ky-filtre-kart .na-kart-g { padding: 5px 12px 7px; }
    .ky-filtre { display: grid; grid-template-columns: 1fr 1fr 1fr 1.8fr auto; gap: 6px 8px; align-items: end; }
    .ky-filtre label { display: block; font-size: .58rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 2px; }
    .ky-filtre .form-control, .ky-filtre .form-select { font-size: .72rem; padding: 3px 7px; height: 28px; } .ky-filtre .btn { font-size: .64rem; padding: 3px 9px; }
    /* sekme çubuğu: sola yaslı, sıkı, tam adlar; sağda kapsam özeti (Kasa Nakit Akışı ile aynı düzen) */
    #ky .na-sekme { flex-wrap: wrap; gap: 0 2px; margin-bottom: 6px; } #ky .na-sekme button { flex: 0 0 auto; white-space: nowrap; padding: 5px 9px; font-size: .72rem; } #ky .na-sekme button i { margin-right: 4px !important; font-size: .66rem; opacity: .85; }
    #ky .na-sekme .ky-kapsam { margin-left: auto; flex: 1 1 0; min-width: 0; text-align: right; align-self: center; font-size: .64rem; font-weight: 600; color: #64748b; padding: 0 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    /* tablolar: sıkı yazı, stun çizgileri, iki satırlı hücreler */
    #ky .ky-tablo { font-size: .68rem; } #ky .ky-tablo th { font-size: .56rem; padding: 4px 5px; white-space: normal; line-height: 1.15; vertical-align: bottom; position: sticky; top: 0; z-index: 2; background: #f8fafc; box-shadow: 0 1px 0 #e2e8f0; }
    #ky .ky-tablo thead tr.grup th { top: 0; font-size: .54rem; letter-spacing: .04em; background: #eef2ff; color: #3730a3; border-bottom: 1px solid #c7d2fe; } #ky .ky-tablo thead tr.grup + tr th { top: 21px; }
    #ky .ky-tablo td { padding: 3px 5px; white-space: nowrap; vertical-align: middle; } #ky .ky-tablo td small { display: block; font-size: .58rem; color: #64748b; font-weight: 500; line-height: 1.1; }
    #ky .ky-tablo td.ad { font-weight: 700; color: #0f172a; } #ky .ky-tablo td.para { font-variant-numeric: tabular-nums; font-weight: 700; } #ky .ky-tablo td.genel { font-weight: 800; color: #1e3a8a; }
    #ky table.na-tablo th, #ky table.na-tablo td { border-right: 1px solid #cbd5e1; } #ky table.na-tablo th:last-child, #ky table.na-tablo td:last-child { border-right: 0; }
    #ky .ky-tablo tfoot td { font-weight: 800; background: #f1f5f9; border-top: 2px solid #cbd5e1; }
    #ky .ky-tablo tr.ornek td { background: #fffbeb; } #ky .ky-tablo tr.odendi td { color: #166534; } #ky .ky-tablo tr.gecikti td { background: #fef2f2; }
    .ky-rz { display: inline-block; font-size: .56rem; font-weight: 800; border-radius: 4px; padding: 1px 6px; white-space: nowrap; }
    .ky-rz.ok { background: #dcfce7; color: #166534; } .ky-rz.hata { background: #fee2e2; color: #991b1b; } .ky-rz.bekle { background: #fef3c7; color: #92400e; } .ky-rz.mavi { background: #dbeafe; color: #1e40af; } .ky-rz.gri { background: #f1f5f9; color: #475569; } .ky-rz.ornek { background: #fde68a; color: #78350f; }
    .ky-fark.art { color: #b91c1c; font-weight: 700; } .ky-fark.az { color: #166534; font-weight: 700; }
    .ky-tablo .btn { font-size: .6rem; padding: 0 5px; }
    .ky-not { font-size: .66rem; color: #64748b; line-height: 1.4; margin: 2px 2px 8px; }
    /* kredi formu (modal) */
    .ky-bolum { border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 8px; } .ky-bolum > .b { background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 4px 10px; font-size: .66rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: #475569; border-radius: 8px 8px 0 0; display: flex; justify-content: space-between; align-items: center; }
    .ky-bolum > .g { padding: 8px 10px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px 10px; } .ky-bolum.oncesi > .b { background: #fff7ed; color: #9a3412; } .ky-bolum.sonrasi > .b { background: #ecfdf5; color: #065f46; } .ky-bolum.teminat > .b { background: #eef2ff; color: #3730a3; }
    .ky-f label { display: block; font-size: .56rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 1px; } .ky-f .form-control, .ky-f .form-select { font-size: .72rem; padding: 2px 6px; height: 27px; } .ky-f textarea.form-control { height: auto; }
    .ky-f.g2 { grid-column: span 2; } .ky-f.g4 { grid-column: span 4; }
    .ky-onizleme { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 6px; padding: 8px 10px; } .ky-onizleme div { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 4px 8px; } .ky-onizleme .l { font-size: .54rem; font-weight: 800; text-transform: uppercase; color: #64748b; } .ky-onizleme .v { font-size: .82rem; font-weight: 800; color: #0f172a; } .ky-onizleme .s { font-size: .6rem; color: #64748b; }
    .ky-teminat { width: 100%; font-size: .7rem; } .ky-teminat th { font-size: .56rem; font-weight: 700; color: #64748b; text-transform: uppercase; padding: 2px 4px; text-align: left; } .ky-teminat td { padding: 2px 3px; } .ky-teminat .form-control, .ky-teminat .form-select { font-size: .7rem; padding: 1px 5px; height: 25px; }
    @@media (max-width: 1100px) { .ky-bolum > .g { grid-template-columns: repeat(2, 1fr); } .ky-onizleme { grid-template-columns: repeat(3, 1fr); } }
</style>
}

<div class="container-fluid py-3 na ky" id="ky" data-sekme="@sekme">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-building-columns"></i></span>Kredi Yapılandırma Raporu</h4>
        <span class="ky-pill" title="Zamanında ödenemeyen banka kredilerinin yapılandırması: yapılandırma öncesi kredi bilgileri, sonrası (yeni anapara, faiz, vade, taksit), teminatlar (ipotek, kefalet …) ve taksit takvimi"><i class="fas fa-arrows-left-right me-1"></i>Öncesi ↔ Sonrası · Teminat · Taksit Takvimi</span>
        <a class="ky-pill" href="/Rapor79?sekme=havale" target="_blank" rel="noopener" title="Taksitler Kasa Nakit Akışı'na Havale / EFT satırı olarak akar"><i class="fas fa-money-bill-transfer me-1"></i>Kasa Nakit Akışı <i class="fas fa-arrow-up-right-from-square ms-1" style="font-size:.56rem"></i></a>
        <a class="ky-pill" href="/Rapor123?sekme=duzenli" target="_blank" rel="noopener" title="Her kredi Planlı Düzenli Ödemeler'de Kredi kategorisiyle izlenir"><i class="fas fa-repeat me-1"></i>Planlı Düzenli Ödemeler <i class="fas fa-arrow-up-right-from-square ms-1" style="font-size:.56rem"></i></a>
        <span class="ky-pill" id="kyKalici" title="Kayıtlar sunucuda saklanır (App_Data/kredi-yapilandirma.json); yeniden başlatınca korunur"><i class="fas fa-database me-1"></i>Kalıcı Kayıt</span>
        <div class="sag">
            <button type="button" class="btn btn-primary btn-sm" id="kyYeni" style="font-size:.7rem"><i class="fas fa-plus me-1"></i>Kredi Ekle</button>
            <button type="button" class="btn btn-light btn-sm border" id="kyExcel" style="font-size:.7rem" title="Açık sekmedeki tabloyu göründüğü gibi Excel'e indirir"><i class="fas fa-file-excel me-1"></i>Excel</button>
        </div>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>

    <div class="na-kart ky-filtre-kart"><div class="na-kart-g"><div class="ky-filtre">
        <div><label for="kyS">Şirket</label><select class="form-select" id="kyS"><option value="">Tümü</option></select></div>
        <div><label for="kyB">Banka</label><select class="form-select" id="kyB"><option value="">Tümü</option></select></div>
        <div><label for="kyD">Durum</label><select class="form-select" id="kyD"><option value="">Tümü</option></select></div>
        <div><label for="kyAra">Ara</label><input class="form-control" id="kyAra" placeholder="Kredi no, banka, şube, protokol, teminat, malik, not…"></div>
        <div><label>&nbsp;</label><button type="button" class="btn btn-light border" id="kyTemizle"><i class="fas fa-eraser me-1"></i>Temizle</button></div>
    </div></div></div>

    <div class="na-kpi" id="kyKpi" data-dinamik="kapali"></div>

    <div class="na-sekme" id="kySekmeler" data-dinamik="kapali">
        @foreach (var s in sekmeler) { <button type="button" data-p="@s.Item1"><i class="fas @s.Item3 me-1"></i>@s.Item2</button> }
        <span class="ky-kapsam" id="kyKapsam" title="Filtreye uyan kredi · şirket · banka"></span>
    </div>

    @foreach (var s in sekmeler)
    {
        <div class="na-panel" data-p="@s.Item1">
            <div class="na-kart">
                <div class="na-kart-b"><span><i class="fas @s.Item3 me-1"></i>@s.Item2</span><span class="d-flex gap-2 align-items-center flex-wrap"><span class="not" id="kyNot-@s.Item1"></span>@if (s.Item1 == "takvim") { <select class="form-select" id="kyTakvimKredi" style="font-size:.68rem;height:24px;padding:1px 6px;width:auto" title="Takvimi tek krediye daralt"><option value="">Tüm Krediler</option></select> }</span></div>
                <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:70vh"><table class="na-tablo ky-tablo" id="kyTablo-@s.Item1" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
            </div>
            <div class="ky-not" id="kyAciklama-@s.Item1"></div>
        </div>
    }

    @* ===== kredi ekle / düzenle ===== *@
    <div class="modal fade" id="kyModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.86rem"><i class="fas fa-building-columns me-2 text-primary"></i><span id="kyMBaslik">Kredi</span></h6><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
        <div class="modal-body py-2" id="kyMGovde"></div>
        <div class="modal-footer py-2"><span class="me-auto" id="kyMOzet" style="font-size:.68rem;color:#475569"></span><button type="button" class="btn btn-outline-danger btn-sm" id="kyMSil" style="display:none"><i class="fas fa-trash me-1"></i>Sil</button><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-primary btn-sm" id="kyMKaydet"><i class="fas fa-save me-1"></i>Kaydet</button></div>
    </div></div></div>
</div>

@section Scripts {
<script src="/js/tablo-hizala.js?v=11"></script>
<script src="/js/tablo-excel.js?v=3"></script>
<script src="/js/kredi-yapilandirma.js?v=2"></script>
}
