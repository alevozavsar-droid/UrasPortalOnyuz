        <div><label for="kyD" id="kyDEtiket">Durum</label><select class="form-select" id="kyD"><option value="">Tümü</option></select></div>
        <div><label for="kyAra">Ara</label><input class="form-control" id="kyAra" placeholder="Kredi no, banka, şube, protokol, ek no, tapu, malik, çek no, keşideci, belge adı, not…"></div>
        <div><label>&nbsp;</label><button type="button" class="btn btn-light border" id="kyTemizle"><i class="fas fa-eraser me-1"></i>Temizle</button></div>
    </div></div></div>

    <div class="na-kpi" id="kyKpi" data-dinamik="kapali"></div>

    <div class="na-sekme" id="kySekmeler" data-dinamik="kapali">
        @foreach (var s in sekmeler) { <button type="button" data-p="@s.Item1" class="@(grupIlk.Contains(s.Item1) ? "ky-grup-ilk" : null)"><i class="fas @s.Item3 me-1"></i>@s.Item2</button> }
        <span class="ky-kapsam" id="kyKapsam" title="Filtreye uyan kayıt · şirket · banka"></span>
    </div>

    @* ===== Özet sekmesi: şerit + ana tablo + beş yardımcı tablo (ızgara) ===== *@
    <div class="na-panel" data-p="ozet">
        <div class="ky-dosya-serit" id="kyDosyaSerit-ozet" data-dinamik="kapali"></div>
        <div class="ky-ozet-grid">
            <div class="na-kart ky-ozet-genis">
                <div class="na-kart-b"><span><i class="fas fa-building-columns me-1"></i>Alacaklı Bankalar Özeti</span><span class="d-flex gap-2 align-items-center flex-wrap"><span class="not" id="kyNot-ozet"></span></span></div>
                <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ky-tablo" id="kyTablo-ozet" data-dinamik="kapali" data-dikey="orta"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
            </div>
            @foreach (var o in ozetTablolar)
            {
                <div class="na-kart">
                    <div class="na-kart-b"><span><i class="fas @o.Item3 me-1"></i>@o.Item2</span><span class="not" id="kyNot-@o.Item1"></span></div>
                    <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ky-tablo" id="kyTablo-@o.Item1" data-dinamik="kapali" data-dikey="orta"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
                </div>
            }
        </div>
        <div class="ky-not" id="kyAciklama-ozet"></div>
    </div>

    @foreach (var s in sekmeler.Where(x => x.Item1 != "ozet"))
    {
        <div class="na-panel" data-p="@s.Item1">
            @if (s.Item1 == "konkordato") { <div class="ky-dosya-serit" id="kyDosyaSerit" data-dinamik="kapali"></div> }
            @if (s.Item1 == "borclar")
            {
                @* Firma × Döviz Özeti: dosyanın ÖZET sayfası (filtreye uyan satırlardan hesaplanır) *@
                <div class="na-kart">
                    <div class="na-kart-b"><span><i class="fas fa-table-cells-large me-1"></i>Firma × Döviz Özeti</span><span class="not" id="kyNot-borcOzet"></span></div>
                    <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ky-tablo" id="kyTablo-borcOzet" data-dinamik="kapali" data-dikey="orta"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
                </div>
            }
            <div class="na-kart">
                <div class="na-kart-b"><span><i class="fas @s.Item3 me-1"></i>@s.Item2</span><span class="d-flex gap-2 align-items-center flex-wrap"><span class="not" id="kyNot-@s.Item1"></span>
                    @if (s.Item1 == "takvim") { <select class="form-select" id="kyTakvimKredi" title="Takvimi tek krediye daralt"><option value="">Tüm Krediler</option></select> }
                    @if (s.Item1 == "rehin") { <button type="button" class="btn btn-light border" id="kyRehinEkle" title="Yapılandırma kaydı olmayan eski kredinin rehin / ipoteğini bağımsız kayıt olarak ekle"><i class="fas fa-plus me-1"></i>Rehin / İpotek Ekle</button> }
                    @if (s.Item1 == "cekler") { <button type="button" class="btn btn-light border" id="kyCekEkle" title="Bankaya teminat olarak verilen müşteri çeki / senedi ekle"><i class="fas fa-plus me-1"></i>Teminat Çeki Ekle</button> }
                    @if (s.Item1 == "borclar") { <button type="button" class="btn btn-light border" id="kyBorcEkle" title="Banka dökümüne taksit / masraf borç satırı ekle (kredi kaydı değildir; nakit akışa yazmaz)"><i class="fas fa-plus me-1"></i>Borç Satırı Ekle</button> }
                    @if (s.Item1 == "belgeler") { <span id="kyBelgeBag"></span><select class="form-select" id="kyBelgeKredi" title="Belgeleri tek krediye daralt"><option value="">Tüm Krediler</option></select><button type="button" class="btn btn-light border" id="kyBelgeYukle2"><i class="fas fa-file-arrow-up me-1"></i>Belge Yükle</button> }
                    @if (s.Item1 == "konkordato") { <span class="ky-konk-bag" id="kyKonkBag-konkordato"></span><button type="button" class="btn btn-light border" id="kyKonkDosya" title="Mahkeme, dosya no, davacılar, geçici mühlet ve rapor tarihleri, kur"><i class="fas fa-gavel me-1"></i>Dava Dosyası</button><button type="button" class="btn btn-light border ky-konk-ekle" data-tip="alacak" title="Banka × borçlu alacak kaydı ekle"><i class="fas fa-plus me-1"></i>Alacak Kaydı Ekle</button> }
                    @if (s.Item1 == "sozlesmeler") { <span class="ky-konk-bag" id="kyKonkBag-sozlesmeler"></span><button type="button" class="btn btn-light border ky-konk-ekle" data-tip="sozlesme" title="Genel kredi sözleşmesi / finansal kiralama sözleşmesi ve kefilleri ekle"><i class="fas fa-plus me-1"></i>Sözleşme Ekle</button> }
                    @if (s.Item1 == "hesaplar") { <span class="ky-konk-bag" id="kyKonkBag-hesaplar"></span><button type="button" class="btn btn-light border ky-konk-ekle" data-tip="hesap" title="Geçici mühlet tarihi itibariyle kredi / hesap bakiye satırı ekle"><i class="fas fa-plus me-1"></i>Hesap Satırı Ekle</button> }
                    @if (s.Item1 == "tahsilatlar") { <span class="ky-konk-bag" id="kyKonkBag-tahsilatlar"></span><button type="button" class="btn btn-light border ky-konk-ekle" data-tip="tahsilat" title="Geçici mühlet sonrası tahsilat ekle"><i class="fas fa-plus me-1"></i>Tahsilat Ekle</button> }
                    @if (s.Item1 == "kontrol") { <span class="text-muted" style="font-size:.64rem">Bekliyor → Eksik → OK · işaret ve not kalıcıdır, sayılar kayıtlardan canlı</span> }
                    @if (s.Item1 == "mektuplar") { <span class="ky-konk-bag" id="kyKonkBag-mektuplar"></span><button type="button" class="btn btn-light border ky-konk-ekle" data-tip="mektup" title="Teminat mektubu ekle"><i class="fas fa-plus me-1"></i>Teminat Mektubu Ekle</button> }
                </span></div>
                <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:70vh"><table class="na-tablo ky-tablo" id="kyTablo-@s.Item1" data-dinamik="kapali" data-dikey="orta"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
            </div>
            <div class="ky-not" id="kyAciklama-@s.Item1"></div>
        </div>
    }

    @* ===== kredi ekle / düzenle ===== *@
    <div class="modal fade" id="kyModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.86rem"><i class="fas fa-building-columns me-2 text-primary"></i><span id="kyMBaslik">Kredi</span></h6><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
        <div class="modal-body py-2" id="kyMGovde"></div>
        <div class="modal-footer py-2"><span class="me-auto" id="kyMOzet" style="font-size:.68rem;color:#475569"></span><button type="button" class="btn btn-outline-danger btn-sm" id="kyMSil" style="display:none"><i class="fas fa-trash me-1"></i>Sil</button><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-primary btn-sm" id="kyMKaydet"><i class="fas fa-save me-1"></i>Kaydet</button></div>
    </div></div></div>

    @* ===== rehin / ipotek kaydı · teminat çeki · belge yükleme (ortak küçük modal; gövde betikle dolar) ===== *@
    <div class="modal fade" id="kyAltModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header py-2"><h6 class="modal-title mb-0" style="font-size:.86rem"><i class="fas fa-file-shield me-2 text-primary" id="kyAMIkon"></i><span id="kyAMBaslik">Kayıt</span></h6><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
        <div class="modal-body py-2" id="kyAMGovde"></div>
        <div class="modal-footer py-2"><span class="me-auto" id="kyAMOzet" style="font-size:.68rem;color:#475569"></span><button type="button" class="btn btn-outline-danger btn-sm" id="kyAMSil" style="display:none"><i class="fas fa-trash me-1"></i>Sil</button><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-primary btn-sm" id="kyAMKaydet"><i class="fas fa-save me-1"></i>Kaydet</button></div>
    </div></div></div>
</div>

@section Scripts {
<script src="/js/tablo-hizala.js?v=13"></script>
<script src="/js/tablo-excel.js?v=3"></script>
<script src="/js/kredi-yapilandirma.js?v=26"></script>
}
