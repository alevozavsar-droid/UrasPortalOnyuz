@model List<WebApplication3.Controllers.Rapor66ViewModel>
@using WebApplication3.Models

@{
    ViewData["Title"] = "Hammadde Fiyat Analizi";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Merkezi layout şablonunu kullanır

    // 1. KURAL: URL'den veya Cookie'den aktif şirketi okuyan değişken
    var currentDb = Context.Request.Query["db"].FirstOrDefault() ?? Context.Request.Cookies["AktifSirket"] ?? "";

    var currentSelectedDbDisplay = (string)ViewBag.CurrentDbDisplay ?? "Bilinmiyor";
    var modelData = Model ?? new List<WebApplication3.Controllers.Rapor66ViewModel>();
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            font-size: 0.85rem;
            overflow-y: hidden;
        }
        .container-fluid { padding: 5px 15px !important; }
        .form-control, .btn, .form-select { font-size: 11px; padding: 2px 6px; height: 28px; }
        .select2-container--bootstrap-5 .select2-selection--multiple {
            min-height: 28px !important; height: 28px !important; font-size: 11px; padding: 0 4px;
            display: flex; align-items: center; overflow: hidden !important; border-color: #dee2e6;
        }
        .select2-selection__choice { display: none !important; }
        .select2-selection__rendered { padding-left: 4px !important; color: #212529; width: 100%; }
        .select2-search--inline, .select2-search__field { margin: 0 !important; height: 24px !important; line-height: 24px !important; }
        .table-container {
            height: calc(100vh - 150px); overflow: auto; border: 1px solid #dee2e6; /* Buton için alan bırakıldı */
            background-color: white; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-top: 5px;
        }
        table { width: 100%; border-collapse: separate; border-spacing: 0; }
        th, td { padding: 4px 8px !important; font-size: 11px !important; border: 1px solid #ddd; vertical-align: middle; white-space: nowrap; color: #212529; }
        thead { position: sticky; top: 0; z-index: 10; }
        thead tr th { position: sticky; top: 0; background-color: #1a5276; color: white; z-index: 20; height: 32px; text-align: center; border: 1px solid #154360; }
        .num { text-align: right; font-family: 'Consolas', 'Monaco', monospace; font-weight: 700; }
        .text-center { text-align: center; }
        .fw-bold { font-weight: bold; }
        tbody tr:hover { background-color: #d6eaf8 !important; cursor: default; }
        .table-striped tbody tr:nth-of-type(odd) { background-color: rgba(0,0,0,.02); }
    </style>
}

@* 2. KURAL: Güvenlik (CSRF) - Yetkisiz veri işlemlerini engellemek için eklendi *@
@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-body p-2">
            <form asp-controller="Rapor66" asp-action="Index" method="get" id="raporForm">
                
                @* 1. KURAL: GET formuna şirket bilgisini ekleyen gizli input *@
                <input type="hidden" name="db" value="@currentDb" />

                <div class="row g-1 align-items-end">
                    <div class="col-auto">
                        <h6 class="m-0 fw-bold text-primary"><i class="fas fa-flask me-2"></i>Hammadde Analiz <span class="text-secondary small">(@currentSelectedDbDisplay)</span></h6>
                    </div>
                    <div class="col-auto ms-auto">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text fw-bold py-0">Başlangıç</span>
                            <input type="date" class="form-control" name="startDate" value="@ViewBag.StartDate">
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text fw-bold py-0">Bitiş</span>
                            <input type="date" class="form-control" name="endDate" value="@ViewBag.EndDate">
                        </div>
                    </div>
                    <div class="col-auto" style="min-width: 200px; max-width: 250px;">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text py-0"><i class="fas fa-users"></i></span>
                            <select class="form-select" name="selectedCaris" id="cariSelect" multiple="multiple">
                                @if (ViewBag.VendorList != null)
                                {
                                    foreach (var item in (List<SelectListItem>)ViewBag.VendorList)
                                    {
                                        var isSelected = ViewBag.SelectedCaris != null && ((List<string>)ViewBag.SelectedCaris).Contains(item.Value);
                                        <option value="@item.Value" selected="@(isSelected ? "selected" : null)">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-auto" style="min-width: 200px; max-width: 250px;">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text py-0"><i class="fas fa-box"></i></span>
                            <select class="form-select" name="selectedItems" id="itemSelect" multiple="multiple">
                                @if (ViewBag.ItemList != null)
                                {
                                    foreach (var item in (List<SelectListItem>)ViewBag.ItemList)
                                    {
                                        var isSelected = ViewBag.SelectedItems != null && ((List<string>)ViewBag.SelectedItems).Contains(item.Value);
                                        <option value="@item.Value" selected="@(isSelected ? "selected" : null)">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Listele</button>
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-success w-100 fw-bold" id="exportToExcelButton">
                            <i class="fas fa-file-excel"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="table-container">
        @if (modelData.Any())
        {
            <table class="table table-bordered table-striped mb-0">
                <thead>
                    <tr>
                        <th>Tedarikçi Kodu</th>
                        <th>Tedarikçi Adı</th>
                        <th>Kalem Kodu</th>
                        <th>Açıklama</th>
                        <th>Birim Fiyat (Org)</th>
                        <th>P.Birimi</th>
                        <th>Anlaş. Döviz (U_BE1_DOV)</th>
                        <th>Hesaplanan USD</th>
                        <th>Hesaplanan EUR</th>
                        <th>Belge No</th>
                        <th>Belge Tarihi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in modelData)
                    {
                        <tr>
                            <td>@item.TedarikciKodu</td>
                            <td title="@item.TedarikciAdi">
                                @if (item.TedarikciAdi != null && item.TedarikciAdi.Length > 25)
                                {
                                    @item.TedarikciAdi.Substring(0, 25) <span class="text-muted">...</span>
                                }
                                else
                                {
                                    @item.TedarikciAdi
                                }
                            </td>
                            <td class="fw-bold">@item.KalemKodu</td>
                            <td title="@item.Aciklama">
                                @if (item.Aciklama != null && item.Aciklama.Length > 30)
                                {
                                    @item.Aciklama.Substring(0, 30) <span class="text-muted">...</span>
                                }
                                else
                                {
                                    @item.Aciklama
                                }
                            </td>
                            <td class="num">@item.BirimFiyatOrjinal.ToString("N4")</td>
                            <td class="text-center">@item.ParaBirimi</td>
                            
                            <td class="text-center @(string.IsNullOrEmpty(item.AnlasilanDoviz) ? "text-muted" : "fw-bold text-dark")">
                                @(string.IsNullOrEmpty(item.AnlasilanDoviz) ? "-" : item.AnlasilanDoviz)
                            </td>

                            <td class="num @(item.UsdKarsiligi > 0 ? "text-primary" : "text-muted")">
                                @(item.UsdKarsiligi > 0 ? item.UsdKarsiligi.ToString("N4") : "-")
                            </td>
                            <td class="num @(item.EurKarsiligi > 0 ? "text-danger" : "text-muted")">
                                @(item.EurKarsiligi > 0 ? item.EurKarsiligi.ToString("N4") : "-")
                            </td>
                            <td class="text-center">@item.BelgeNo</td>
                            <td class="text-center">@item.BelgeTarihi?.ToString("dd.MM.yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-warning m-3 text-center" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i> Veri bulunamadı.
            </div>
        }
    </div>

    @* 4. KURAL: UI/UX Standartlarına uygun şık, db parametreli Ana Sayfa butonu *@
    <div class="mt-3 mb-2 text-center">
        <a asp-controller="Home" asp-action="Index" asp-route-db="@currentDb" class="btn btn-outline-secondary fw-bold shadow-sm">
            <i class="fas fa-home me-2"></i> Ana Sayfaya Dön
        </a>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            function initExcelStyleSelect2(selector, placeholder, entityName) {
                var $element = $(selector);
                $element.select2({ theme: 'bootstrap-5', placeholder: placeholder, allowClear: true, width: '100%', closeOnSelect: false });
                function updateText() {
                    var count = $element.val() ? $element.val().length : 0;
                    var $renderedContainer = $element.next('.select2-container').find('.select2-selection__rendered');
                    if (count > 0) {
                        $renderedContainer.html('<span class="fw-bold text-primary">' + count + ' ' + entityName + ' Seçildi</span>');
                        $renderedContainer.css('opacity', '1');
                    } else { $renderedContainer.removeAttr('style'); }
                }
                $element.on('change select2:select select2:unselect select2:close', function () { updateText(); });
                updateText();
            }
            initExcelStyleSelect2('#cariSelect', 'Tedarikçi', 'Tedarikçi');
            initExcelStyleSelect2('#itemSelect', 'Malzeme', 'Malzeme');

            $('#exportToExcelButton').on('click', function () {
                var startDate = $('input[name="startDate"]').val();
                var endDate = $('input[name="endDate"]').val();
                var selectedCaris = $('#cariSelect').val();
                var selectedItems = $('#itemSelect').val();

                // 1. KURAL: Şirket bilgisini Razor'dan garanti şekilde exportUrl'e bağlıyoruz
                var exportUrl = '@Url.Action("ExportToExcel", "Rapor66")' + '?startDate=' + encodeURIComponent(startDate) + '&endDate=' + encodeURIComponent(endDate) + '&db=' + encodeURIComponent('@currentDb');
                
                if (selectedCaris && selectedCaris.length > 0) { selectedCaris.forEach(function(item) { exportUrl += '&selectedCaris=' + encodeURIComponent(item); }); }
                if (selectedItems && selectedItems.length > 0) { selectedItems.forEach(function(item) { exportUrl += '&selectedItems=' + encodeURIComponent(item); }); }
                
                window.location.href = exportUrl;
            });
        });
    </script>
}