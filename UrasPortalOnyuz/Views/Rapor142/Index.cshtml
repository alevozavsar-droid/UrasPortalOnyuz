        <div class="modal-content" style="border-radius:16px;">
            <div class="modal-header"><h5 class="modal-title fw-bold" id="zimmetBaslik">Zimmetle</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="zimmetVarlikId">
                <label class="form-label small fw-bold">Kişi *</label>
                <select class="form-select mb-3" id="zimmetPersonel">
                    @foreach (var k in kisiler.Where(x => x.Aktif))
                    {
                        <option value="@k.Id">@k.AdSoyad @(string.IsNullOrWhiteSpace(k.Departman) ? "" : " - " + k.Departman)</option>
