            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var YETKILI = @(yetkili ? "true" : "false");
        var VARLIKLAR = @Html.Raw(Json.Serialize(varliklar.Select(v => new {
            v.Id, v.VarlikTipi, v.Marka, v.Model, v.SeriNo, v.DemirbasNo, v.Imei, v.HatNumarasi,
            v.Operator, v.MacAdresi, v.IsletimSistemi, v.Islemci, v.Ram, v.Disk, v.EkranBoyutu,
            v.FaturaNo, v.AlisTutari, v.ParaBirimi, v.Durum, v.Lokasyon, v.Sirket, v.Notlar,
            AlisTarihi = v.AlisTarihi.HasValue ? v.AlisTarihi.Value.ToString("yyyy-MM-dd") : "",
            GarantiBitis = v.GarantiBitis.HasValue ? v.GarantiBitis.Value.ToString("yyyy-MM-dd") : ""
        })));
        var KISILER = @Html.Raw(Json.Serialize(kisiler.Select(k => new {
            k.Id, k.SicilNo, k.AdSoyad, k.Departman, k.Gorev, k.Sirket, k.Lokasyon, k.Email, k.Telefon, k.Aktif, k.Notlar,
            IseGiris = k.IseGiris.HasValue ? k.IseGiris.Value.ToString("yyyy-MM-dd") : "",
            Cikis = k.Cikis.HasValue ? k.Cikis.Value.ToString("yyyy-MM-dd") : ""
        })));

        var ZIMMETLI_IDLER = @Html.Raw(Json.Serialize(varliklar.Where(v => v.PersonelId.HasValue).Select(v => v.Id)));

        var aktifSekme = 'kisiler';

        function token() { return $('input[name="__RequestVerificationToken"]').first().val(); }
        function bildir(ok, mesaj) {
            if (window.toastr) { toastr.options = { positionClass: 'toast-bottom-right', timeOut: 4000 }; ok ? toastr.success(mesaj) : toastr.error(mesaj); }
            else { alert(mesaj); }
        }
        function kacis(s) { return $('<div>').text(s == null ? '' : s).html(); }

        $(document).ready(function () {
            ['#kisiDetayModal', '#kisiFormModal', '#varlikFormModal', '#zimmetModal', '#iadeModal', '#kisiyeZimmetModal'].forEach(function (sec) {
                var $e = $(sec);
                if ($e.length && !$e.parent().is('body')) $e.appendTo('body');
            });
            tipAlanlariniGoster();
        });

        /* ---------- Sekme & filtre ---------- */
        function sekmeSec(ad, el) {
            aktifSekme = ad;
            $('.zt-tab').removeClass('active');
            $(el).addClass('active');
            ['kisiler', 'varliklar', 'depo'].forEach(function (s) {
                document.getElementById('sekme-' + s).classList.toggle('d-none', s !== ad);
            });
            suz();
        }

        function suz() {
            var q = ($('#fArama').val() || '').toLocaleLowerCase('tr-TR');
            var tip = $('#fTip').val(), durum = $('#fDurum').val(), dep = $('#fDepartman').val(), sirket = $('#fSirket').val();
            var gorunen = 0;

            $('#sekme-kisiler .kisi-kart').each(function () {
                var uygun = (!q || ('' + $(this).data('ara')).indexOf(q) > -1) &&
                            (!dep || $(this).data('departman') === dep) &&
                            (!sirket || $(this).data('sirket') === sirket);
                $(this).toggle(uygun);
                if (uygun && aktifSekme === 'kisiler') gorunen++;
            });

            $('#sekme-varliklar tbody tr, #sekme-depo tbody tr').each(function () {
                var uygun = (!q || ('' + $(this).data('ara')).indexOf(q) > -1) &&
                            (!tip || $(this).data('tip') === tip) &&
                            (!durum || $(this).data('durum') === durum) &&
                            (!sirket || $(this).data('sirket') === sirket);
                $(this).toggle(uygun);
                if (uygun && aktifSekme !== 'kisiler' && $(this).closest('#sekme-' + aktifSekme).length) gorunen++;
            });

            $('#sonucBilgi').text(gorunen + ' kayıt gösteriliyor');
        }

        /* ---------- Kişi detayı ---------- */
        function kisiDetayAc(id) {
            $('#kisiDetayGovde').html('<div class="text-center py-5 text-muted"><i class="fas fa-spinner fa-spin fa-2x"></i></div>');
            new bootstrap.Modal(document.getElementById('kisiDetayModal')).show();

            $.getJSON('/ZimmetTakip/PersonelDetay', { id: id }, function (res) {
                if (!res.success) { $('#kisiDetayGovde').html('<div class="alert alert-danger">' + kacis(res.message) + '</div>'); return; }

                var p = res.personel;
                $('#kisiDetayBaslik').text(p.adSoyad + (p.departman ? ' — ' + p.departman : ''));

                var h = '<div class="d-flex justify-content-end gap-2 mb-3">';
                h += '<a class="btn btn-sm btn-outline-danger" target="_blank" href="/ZimmetTakip/Tutanak?personelId=' + p.id + '"><i class="fas fa-file-pdf me-1"></i>Zimmet Tutanağı</a>';
                if (YETKILI) {
                    h += '<button class="btn btn-sm btn-primary" onclick="kisiyeZimmetAc(' + p.id + ', \'' + kacis(p.adSoyad) + '\')"><i class="fas fa-plus me-1"></i>Zimmet Ver</button>';
                    h += '<button class="btn btn-sm btn-outline-primary" onclick="kisiAc(' + p.id + ')"><i class="fas fa-pen me-1"></i>Kişiyi Düzenle</button>';
                }
                h += '</div>';

                h += '<div class="det-grid">';
                h += satir('Sicil No', p.sicilNo) + satir('Ad Soyad', p.adSoyad) + satir('Departman', p.departman);
                h += satir('Görev', p.gorev) + satir('Şirket', p.sirket) + satir('Lokasyon', p.lokasyon);
                h += satir('E-Posta', p.email) + satir('Telefon', p.telefon);
                h += satir('İşe Giriş', p.iseGiris) + satir('Çıkış', p.cikis);
                h += satir('Durum', p.aktif ? 'Aktif' : 'Pasif');
                h += '</div>';
                if (p.notlar) h += '<div class="mt-2 p-3" style="background:var(--bg-subtle,#f8fafc); border-radius:10px; font-size:.83rem;">' + kacis(p.notlar) + '</div>';

                h += '<div class="fw-bold mt-4 mb-2" style="font-size:.72rem; letter-spacing:.1em; text-transform:uppercase; color:var(--text-secondary); border-bottom:2px solid var(--border-color); padding-bottom:6px;">Zimmetli Varlıklar (' + res.varliklar.length + ')</div>';

                if (res.varliklar.length === 0) {
                    h += '<div class="text-muted small">Bu kişide zimmetli varlık yok.</div>';
                } else {
                    res.varliklar.forEach(function (v) {
                        h += '<div class="varlik-kart"><div class="varlik-baslik">';
                        h += '<div><span class="tag tag-mor me-2">' + kacis(v.varlikTipi) + '</span><span class="ad">' + kacis((v.marka || '') + ' ' + (v.model || '')) + '</span></div>';
                        h += '<div class="d-flex gap-2 align-items-center">';
                        if (v.zimmet) h += '<span class="tag tag-gri">Zimmet: ' + kacis(v.zimmet) + '</span>';
                        if (v.garanti) h += '<span class="tag ' + (v.garantiDoldu ? 'tag-kirmizi' : 'tag-yesil') + '">Garanti: ' + kacis(v.garanti) + '</span>';
                        if (YETKILI && v.hareketId) h += '<button class="btn btn-sm btn-outline-warning" onclick="iadeAc(' + v.hareketId + ', \'' + kacis((v.marka || '') + ' ' + (v.model || '')) + '\')"><i class="fas fa-rotate-left"></i></button>';
                        h += '</div></div>';

                        h += '<div class="varlik-ozellik">';
                        h += ozellik('Seri No', v.seriNo) + ozellik('Demirbaş', v.demirbasNo) + ozellik('IMEI', v.imei);
                        h += ozellik('Hat', v.hatNumarasi) + ozellik('Operatör', v.operator) + ozellik('MAC', v.macAdresi);
                        h += ozellik('İşletim Sist.', v.isletimSistemi) + ozellik('İşlemci', v.islemci) + ozellik('RAM', v.ram);
                        h += ozellik('Disk', v.disk) + ozellik('Ekran', v.ekranBoyutu) + ozellik('Lokasyon', v.lokasyon);
                        h += ozellik('Fatura No', v.faturaNo) + ozellik('Alış', v.alis) + ozellik('Tutar', v.tutar ? v.tutar + ' ' + (v.paraBirimi || '') : '');
                        h += ozellik('Şirket', v.sirket);
                        h += '</div>';
                        if (v.notlar) h += '<div class="mt-2 text-muted" style="font-size:.75rem;">' + kacis(v.notlar) + '</div>';
                        h += '</div>';
                    });
                }

                if (res.gecmis.length) {
                    h += '<div class="fw-bold mt-4 mb-2" style="font-size:.72rem; letter-spacing:.1em; text-transform:uppercase; color:var(--text-secondary); border-bottom:2px solid var(--border-color); padding-bottom:6px;">Geçmiş (İade Edilenler)</div>';
                    h += '<div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Tip</th><th>Cihaz</th><th>Seri No</th><th>Zimmet</th><th>İade</th></tr></thead><tbody>';
                    res.gecmis.forEach(function (g) {
                        h += '<tr><td>' + kacis(g.varlikTipi) + '</td><td>' + kacis((g.marka || '') + ' ' + (g.model || '')) + '</td><td>' + kacis(g.seriNo) + '</td><td>' + kacis(g.zimmet) + '</td><td>' + kacis(g.iade) + '</td></tr>';
                    });
                    h += '</tbody></table></div>';
                }

                $('#kisiDetayGovde').html(h);
            }).fail(function () { $('#kisiDetayGovde').html('<div class="alert alert-danger">Detay alınamadı.</div>'); });
        }

        function satir(k, v) { return '<div class="det-satir"><div class="k">' + k + '</div><div class="v">' + (v ? kacis(v) : '-') + '</div></div>'; }
        function ozellik(k, v) { return v ? '<div><span>' + k + ':</span> <b>' + kacis(v) + '</b></div>' : ''; }

        /* ---------- Kişi formu ---------- */
        function kisiAc(id) {
            var f = document.getElementById('kisiForm');
            f.reset();
            f.Id.value = id || 0;
            $('#kisiFormBaslik').text(id ? 'Kişiyi Düzenle' : 'Yeni Kişi');

            if (id) {
                var k = KISILER.filter(function (x) { return x.id === id; })[0];
                if (k) {
                    ['sicilNo','adSoyad','departman','gorev','sirket','lokasyon','email','telefon','iseGiris','cikis','notlar'].forEach(function (alan) {
                        var ad = alan.charAt(0).toUpperCase() + alan.slice(1);
                        if (f[ad]) f[ad].value = k[alan] || '';
                    });
                    f.Aktif.checked = !!k.aktif;
                }
            }
            new bootstrap.Modal(document.getElementById('kisiFormModal')).show();
        }

        function kisiKaydet() {
            var f = document.getElementById('kisiForm');
            if (!f.checkValidity()) { f.reportValidity(); return; }

            var veri = $(f).serializeArray();
            if (!f.Aktif.checked) veri.push({ name: 'Aktif', value: 'false' });
            veri.push({ name: '__RequestVerificationToken', value: token() });

            $.post('/ZimmetTakip/PersonelKaydet', veri, function (res) {
                bildir(res.success, res.message);
                if (res.success) setTimeout(function () { location.reload(); }, 700);
            }).fail(function () { bildir(false, 'Sunucuya ulaşılamadı.'); });
        }

        /* ---------- Varlık formu ---------- */
        function varlikAc(id) {
            var f = document.getElementById('varlikForm');
            f.reset();
            f.Id.value = id || 0;
            f.ParaBirimi.value = 'TRY';
            $('#varlikFormBaslik').text(id ? 'Varlığı Düzenle' : 'Yeni Varlık');

            if (id) {
                var v = VARLIKLAR.filter(function (x) { return x.id === id; })[0];
                if (v) {
                    Object.keys(v).forEach(function (alan) {
                        var ad = alan.charAt(0).toUpperCase() + alan.slice(1);
                        if (f[ad] && v[alan] !== null && v[alan] !== undefined) f[ad].value = v[alan];
                    });
                }
            }
            tipAlanlariniGoster();
            new bootstrap.Modal(document.getElementById('varlikFormModal')).show();
        }

        function tipAlanlariniGoster() {
            var tip = $('#varlikTipi').val() || '';
            var telefonMu = tip.indexOf('Telefon') > -1 || tip.indexOf('Hat') > -1 || tip.indexOf('Tablet') > -1;
            $('.alan-telefon').toggle(telefonMu || tip === '');
        }

        function varlikKaydet() {
            var f = document.getElementById('varlikForm');
            if (!f.checkValidity()) { f.reportValidity(); return; }

            var veri = $(f).serializeArray();
            veri.push({ name: '__RequestVerificationToken', value: token() });

            $.post('/ZimmetTakip/VarlikKaydet', veri, function (res) {
                bildir(res.success, res.message);
                if (res.success) setTimeout(function () { location.reload(); }, 700);
            }).fail(function () { bildir(false, 'Sunucuya ulaşılamadı.'); });
        }

        /* ---------- Kişiye zimmet ver ---------- */
        function kisiyeZimmetAc(personelId, ad) {
            $('#kzPersonelId').val(personelId);
            $('#kisiyeZimmetBaslik').html('<i class="fas fa-user-plus me-2"></i>Zimmet Ver - ' + kacis(ad));
            $('#kzArama').val('');
            kzListele();
            new bootstrap.Modal(document.getElementById('kisiyeZimmetModal')).show();
        }

        function kzListele() {
            var q = ($('#kzArama').val() || '').toLocaleLowerCase('tr-TR');

            // Boştakiler: kişiye atanmamış ve hurda/kayıp olmayan varlıklar
            var uygunlar = VARLIKLAR.filter(function (v) {
                if (v.durum === 'Hurda' || v.durum === 'Kayıp') return false;
                if (ZIMMETLI_IDLER.indexOf(v.id) > -1) return false;
                if (!q) return true;
                var metin = ((v.varlikTipi || '') + ' ' + (v.marka || '') + ' ' + (v.model || '') + ' ' +
                             (v.seriNo || '') + ' ' + (v.demirbasNo || '') + ' ' + (v.hatNumarasi || '')).toLocaleLowerCase('tr-TR');
                return metin.indexOf(q) > -1;
            });

            if (uygunlar.length === 0) {
                $('#kzListe').html('<div class="text-center py-4 text-muted"><i class="fas fa-box-open fa-2x d-block mb-2 opacity-50"></i>Uygun boşta varlık bulunamadı.</div>');
                return;
            }

            var h = '<div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">';
            h += '<thead><tr><th>Tip</th><th>Marka / Model</th><th>Seri No / Hat</th><th>Durum</th><th class="text-end">İşlem</th></tr></thead><tbody>';

            uygunlar.forEach(function (v) {
                var kimlik = v.seriNo || v.hatNumarasi || v.imei || '';
                h += '<tr>'
                   + '<td><span class="tag tag-mor">' + kacis(v.varlikTipi) + '</span></td>'
                   + '<td class="fw-semibold">' + kacis(((v.marka || '') + ' ' + (v.model || '')).trim()) + '</td>'
                   + '<td>' + kacis(kimlik) + '</td>'
                   + '<td><span class="tag tag-gri">' + kacis(v.durum) + '</span></td>'
                   + '<td class="text-end"><button class="btn btn-sm btn-primary" onclick="kzZimmetle(' + v.id + ')">'
                   + '<i class="fas fa-check me-1"></i>Zimmetle</button></td>'
                   + '</tr>';
            });

            h += '</tbody></table></div>';
            $('#kzListe').html(h);
        }

        function kzZimmetle(varlikId) {
            $.post('/ZimmetTakip/Zimmetle', {
                varlikId: varlikId,
                personelId: $('#kzPersonelId').val(),
                zimmetTarihi: $('#kzTarih').val(),
                teslimEden: $('#kzTeslimEden').val(),
                aciklama: '',
                __RequestVerificationToken: token()
            }, function (res) {
                bildir(res.success, res.message);
                if (res.success) setTimeout(function () { location.reload(); }, 700);
            }).fail(function () { bildir(false, 'Sunucuya ulaşılamadı.'); });
        }

        /* ---------- Zimmet / iade ---------- */
        function zimmetAc(varlikId, ad) {
            $('#zimmetVarlikId').val(varlikId);
            $('#zimmetBaslik').text('Zimmetle: ' + ad);
            new bootstrap.Modal(document.getElementById('zimmetModal')).show();
        }

        function zimmetKaydet() {
            $.post('/ZimmetTakip/Zimmetle', {
                varlikId: $('#zimmetVarlikId').val(),
                personelId: $('#zimmetPersonel').val(),
                zimmetTarihi: $('#zimmetTarihi').val(),
                teslimEden: $('#zimmetTeslimEden').val(),
                aciklama: $('#zimmetAciklama').val(),
                __RequestVerificationToken: token()
            }, function (res) {
                bildir(res.success, res.message);
                if (res.success) setTimeout(function () { location.reload(); }, 700);
            }).fail(function () { bildir(false, 'Sunucuya ulaşılamadı.'); });
        }

        function iadeAc(hareketId, ad) {
            $('#iadeHareketId').val(hareketId);
            $('#iadeBaslik').text('İade Al: ' + ad);
            new bootstrap.Modal(document.getElementById('iadeModal')).show();
        }

        function iadeKaydet() {
            $.post('/ZimmetTakip/IadeAl', {
                hareketId: $('#iadeHareketId').val(),
                iadeTarihi: $('#iadeTarihi').val(),
                yeniDurum: $('#iadeDurum').val(),
                aciklama: $('#iadeAciklama').val(),
                __RequestVerificationToken: token()
            }, function (res) {
                bildir(res.success, res.message);
                if (res.success) setTimeout(function () { location.reload(); }, 700);
            }).fail(function () { bildir(false, 'Sunucuya ulaşılamadı.'); });
        }
    </script>
}
