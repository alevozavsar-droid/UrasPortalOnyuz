                <input type="date" class="form-control mb-3" id="zimmetTarihi" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                <label class="form-label small fw-bold">Teslim Eden</label>
                <input class="form-control mb-3" id="zimmetTeslimEden">
