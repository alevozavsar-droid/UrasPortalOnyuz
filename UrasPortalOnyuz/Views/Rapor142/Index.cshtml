</div>

<!-- İADE -->
<div class="modal fade" id="iadeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px;">
            <div class="modal-header"><h5 class="modal-title fw-bold" id="iadeBaslik">İade Al</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="iadeHareketId">
                <label class="form-label small fw-bold">İade Tarihi</label>
                <input type="date" class="form-control mb-3" id="iadeTarihi" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                <label class="form-label small fw-bold">İade Sonrası Durum</label>
                <select class="form-select mb-3" id="iadeDurum">
                    <option value="Depoda">Depoda</option>
                    <option value="Bakımda">Bakımda</option>
                    <option value="Hurda">Hurda</option>
                    <option value="Kayıp">Kayıp</option>
                </select>
                <label class="form-label small fw-bold">Açıklama</label>
                <textarea class="form-control" id="iadeAciklama" rows="2" placeholder="Cihazın durumu, eksik parça vb."></textarea>
            </div>
            <div class="modal-footer">
                <button class="btn btn-light" data-bs-dismiss="modal">Vazgeç</button>
