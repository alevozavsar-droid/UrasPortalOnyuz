    .pm-excel td.ad { font-weight: 700; color: #0f172a; } .pm-excel td.kucuk { color: #64748b; font-size: .62rem; } .pm-excel td.hesap { background: #f8fafc; font-weight: 700; } .pm-excel td.genel { background: #ccfbf1; font-weight: 800; color: #134e4a; }
