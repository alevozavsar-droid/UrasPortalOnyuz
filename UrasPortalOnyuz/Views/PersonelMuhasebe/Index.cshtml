    .pm-rapor-ust .pm-sayac { margin: 0; font-size: .66rem; color: #ccfbf1; white-space: nowrap; }
    .pm-rapor-ust .ayar { margin-left: auto; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; } .pm-rapor-ust .ayar .btn { font-size: .64rem; padding-top: 1px; padding-bottom: 1px; } .pm-rapor-ust .ayar select, .pm-rapor-ust .ayar input.form-control { font-size: .68rem; padding: 1px 6px; height: 24px !important; min-height: 24px; width: auto; }
    .pm-rapor-ust .pm-anahtar { font-size: .66rem; font-weight: 700; color: #fff; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.35); border-radius: 6px; padding: 2px 8px; display: inline-flex; align-items: center; gap: 5px; margin: 0 2px; cursor: pointer; white-space: nowrap; } .pm-rapor-ust .pm-anahtar input { margin: 0; accent-color: #fbbf24; }
    /* tablolar: kaydırma kabı, yapışkan başlık ve dip toplam */
