    .pm-excel tr.hatali td { background: #fff1f2; } .pm-excel tr.secili td { background: #f0fdfa; } .pm-excel tr.ayrildi td { color: #94a3b8; } .pm-excel tr.kaydedildi td.ad { color: #16a34a; }
    .pm-excel .kart { font-size: .6rem; padding: 0 6px; line-height: 18px; }
    .pm-rz { display: inline-block; font-size: .58rem; font-weight: 800; letter-spacing: .03em; padding: 1px 7px; border-radius: 999px; white-space: nowrap; } .pm-rz.ok { background: #dcfce7; color: #166534; } .pm-rz.bekle { background: #fef3c7; color: #92400e; } .pm-rz.hata { background: #fee2e2; color: #991b1b; } .pm-rz.gri { background: #f1f5f9; color: #475569; } .pm-rz.mavi { background: #dbeafe; color: #1e40af; }
    /* muhasebe: akış şeridi, kontrol listesi, aksiyonlar, fiş önizleme, audit */
    .pm-akis { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 6px; } .pm-akis span { font-size: .62rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; } .pm-akis span.oldu { background: #dcfce7; color: #166534; border-color: #bbf7d0; } .pm-akis span.simdi { background: #0f766e; color: #fff; border-color: #0f766e; } .pm-akis span.hata { background: #fee2e2; color: #991b1b; border-color: #fecaca; }
    .pm-kontrol { width: 100%; font-size: .68rem; } .pm-kontrol td { padding: 3px 6px; border-top: 1px solid #f1f5f9; vertical-align: top; } .pm-kontrol td.n { width: 24px; color: #64748b; } .pm-kontrol tr.hata td { background: #fff1f2; } .pm-kontrol tr.uyari td { background: #fffbeb; }
    .pm-aksiyon { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin-bottom: 6px; } .pm-aksiyon .btn { font-size: .66rem; } .pm-aksiyon .btn:disabled { opacity: .45; }
    .pm-tfis { width: 100%; font-size: .68rem; border-collapse: collapse; } .pm-tfis th { font-size: .58rem; text-transform: uppercase; color: #64748b; text-align: left; padding: 2px 6px; border-bottom: 1px solid #e2e8f0; } .pm-tfis td { padding: 3px 6px; border-bottom: 1px solid #f1f5f9; } .pm-tfis td.s, .pm-tfis th.s { text-align: right; font-variant-numeric: tabular-nums; } .pm-tfis tr.toplam td { font-weight: 800; background: #f8fafc; border-top: 2px solid #cbd5e1; }
    .pm-zaman { list-style: none; margin: 0; padding: 0 0 0 14px; border-left: 2px solid #e2e8f0; } .pm-zaman li { position: relative; font-size: .68rem; padding: 2px 0 6px 10px; } .pm-zaman li::before { content: ""; position: absolute; left: -19px; top: 7px; width: 8px; height: 8px; border-radius: 50%; background: #0f766e; } .pm-zaman li small { display: block; color: #64748b; font-size: .58rem; }
    .pm-not { font-size: .66rem; color: #475569; margin-top: 6px; }
    .ph .na-kart { margin-bottom: 6px; } .ph .na-kart-b { padding: 4px 10px; font-size: .66rem; }
    /* formlar (hesap eşleştirme) */
    .pm-form { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 6px 10px; } .pm-form .g2 { grid-column: span 2; }
    .pm-form label { display: block; font-size: .6rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 2px; } .pm-form label.z::after { content: " *"; color: #dc2626; }
    .pm-form .form-control, .pm-form .form-select { font-size: .72rem; padding: 3px 7px; height: 28px; min-height: 28px; } .pm-form .ro { background: #f1f5f9; font-weight: 700; }
    @@media (max-width: 1200px) { .pm-form { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    /* yansıtma: yön, kalem tabloları, dağılım, matris, iki taraflı fiş */
    .ph-yon { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; } .ph-yon b { color: #0f172a; } .ph-yon .ok { color: #b45309; font-weight: 800; } .ph-pay { font-size: .6rem; color: #64748b; }
    #phAdayTablo tbody tr.detay td { background: #fffbeb; padding: 6px 10px; white-space: normal; cursor: default; } #phAdayTablo tbody tr.detay:hover td { background: #fffbeb; }
    .ph-kalem { font-size: .66rem; width: auto; } .ph-kalem th, .ph-kalem td { padding: 2px 6px; white-space: nowrap; } .ph-kalem td.s, .ph-kalem th.s { text-align: right; } .ph-kalem .kod { font-family: ui-monospace, monospace; font-size: .62rem; color: #475569; } .ph-kalem tr.top td { font-weight: 700; background: #f8fafc; border-top: 2px solid #cbd5e1; }
    .ph-dagilim { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; font-size: .66rem; } .ph-dagilim input { width: 64px; font-size: .66rem; padding: 1px 4px; height: 22px; min-height: 22px; text-align: right; } .ph-dagilim .form-select { width: auto; font-size: .66rem; padding: 1px 22px 1px 4px; height: 22px; min-height: 22px; }
    .ph-matris td.s, .ph-matris th.s { text-align: right; white-space: nowrap; } .ph-matris tr.toplam td { font-weight: 700; background: #f8fafc; border-top: 2px solid #cbd5e1; }
    .ph-fis { font-size: .66rem; width: 100%; } .ph-fis th, .ph-fis td { padding: 2px 6px; white-space: nowrap; } .ph-fis td.s, .ph-fis th.s { text-align: right; } .ph-fis tr.top td { font-weight: 700; background: #f8fafc; border-top: 2px solid #cbd5e1; } .ph-fis .kod { font-family: ui-monospace, monospace; font-size: .62rem; color: #475569; }
    .ph-fis-bas { display: flex; align-items: center; gap: 8px; font-size: .7rem; font-weight: 800; padding: 6px 8px; border-radius: 8px 8px 0 0; color: #fff; } .ph-fis-bas.k { background: #b45309; } .ph-fis-bas.h { background: #0f766e; } .ph-fis-bas small { font-weight: 500; opacity: .85; margin-left: auto; }
    .ph-master { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px 12px; font-size: .72rem; } .ph-master .l { font-size: .6rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; } .ph-master .v { font-weight: 600; color: #0f172a; }
    .ph-gecmis { font-size: .66rem; color: #475569; } .ph-gecmis li { margin-bottom: 2px; }
    .ph-esleme td .form-select { font-size: .7rem; padding: 2px 22px 2px 6px; height: 26px; min-height: 26px; width: auto; max-width: 360px; }
    /* çekmece */
    .pm-drawer { position: fixed; top: 0; right: -900px; width: 860px; max-width: 96vw; height: 100vh; background: #fff; box-shadow: -8px 0 24px rgba(15,23,42,.18); z-index: 1060; transition: right .25s; overflow: auto; padding: 12px 14px; } .pm-drawer.acik { right: 0; }
    .pm-drawer-ust { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; position: sticky; top: 0; background: #fff; padding-bottom: 6px; border-bottom: 1px solid #e2e8f0; z-index: 2; flex-wrap: wrap; } .pm-drawer-ust .btn { font-size: .66rem; }
    .pm-perde { position: fixed; inset: 0; background: rgba(15,23,42,.35); z-index: 1055; display: none; } .pm-perde.acik { display: block; }
</style>
}

<div class="container-fluid py-3 na ph" id="ph" data-baslangic="@sekme" data-donem="@donem">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-building-columns"></i></span>Personel Muhasebe İşlemleri</h4>
        <span class="pm-pill"><i class="fas fa-link me-1"></i>Personel Maliyet Raporu › Muhasebe Kayıtları ile Senkron</span>
        <span class="pm-pill"><i class="fas fa-calendar me-1"></i><span id="phDonemPill">@donemAd</span></span>
        <span class="pm-pill"><i class="fas fa-code-compare me-1"></i>Yansıtma GDR.13 ↔ YNS.13</span>
        <button type="button" class="pm-bilgi" id="phBilgi" title="Ekran açıklamasını göster / gizle">i</button>
        <span class="sub w-100">Personelle ilgili <b>tüm muhasebe işlemleri</b> bu ekrandan yapılır ve Personel Maliyet Raporu'ndaki <b>Muhasebe Kayıtları</b> sekmesiyle aynı veriyi kullanır: seçili dönemin bordro simülasyonu burada personel bazlı satırlarıyla, 11 kontrolüyle, şirket fişleriyle ve özet (muhasebeye atılacak) kayıtlarıyla görünür; <b>Onaya Gönder → Onayla → Muhasebeleştir → Ters Kayıt</b> adımları burada atılır ve raporda anında görünür (raporda atılan adımlar da burada). <b>Ödemeler</b> sekmesi dönemin net ödeme listesini (banka R / kasa X, ödeyen şirket, hesap, fiş) verir. <b>Yansıtma Hazırlığı</b> ve <b>Yansıtma Kayıtları</b> SGK işvereni ≠ fiili görev yeri olan personelin maliyetini Gider Kataloğu 13 (GDR.13.AA.KK ↔ YNS.13.AA.KK) kalemleriyle iki şirkete kaydeder ve simülasyonun B grubuyla mutabakatını gösterir. <b>Hesap Eşleştirme</b> simülasyon hesaplarını, <b>Kalem Eşleme</b> yansıtma kalemlerini tanımlar; <b>Fiş Arşivi</b> tüm dönemlerin simülasyonlarını ve muhasebe fiş numaralarını listeler. Her personel tablosunda <b>SGK İşvereni · Fiili Görev Yeri · Ödeme Şirketi</b> sütunları vardır; filtre çubuğundaki aynı üç seçim tüm sekmelerdeki personel satırlarını süzer (tanım ve arşiv sekmelerinde personel satırı olmadığından pasiftir).</span>
    </div>
    <div class="na-kpi" id="phKpi" data-dinamik="kapali"></div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>
    <div class="pm-filtre-bar" data-dinamik="kapali">
        <div class="f"><label for="phDonem">Dönem</label><select class="form-select pm-donem" id="phDonem" title="Bordro dönemi (Personel Maliyet Raporu dönemleri)"></select></div>
        <div class="f"><label for="phAra">Ara</label><input class="form-control" id="phAra" placeholder="Personel, hesap, fiş, şirket, yansıtma no…"></div>
        @* ortak üç filtre: tüm sekmelerdeki personel satırlarına uygulanır (aynı üç alan her personel tablosunda sütundur); tanım / arşiv sekmelerinde pasif *@
        <div class="f"><label for="phSgk">SGK İşvereni</label><select class="form-select" id="phSgk" title="Tüm sekmelerdeki personel satırlarını SGK işverenine göre süzer"><option value="">Tüm SGK İşverenleri</option></select></div>
        <div class="f"><label for="phGorevYeri">Fiili Görev Yeri</label><select class="form-select" id="phGorevYeri" title="Tüm sekmelerdeki personel satırlarını fiili görev yerine göre süzer"><option value="">Tüm Görev Yerleri</option></select></div>
        <div class="f"><label for="phOdemeSirketi">Ödeme Şirketi</label><select class="form-select" id="phOdemeSirketi" title="Tüm sekmelerdeki personel satırlarını ödeme şirketine göre süzer"><option value="">Tüm Ödeme Şirketleri</option></select></div>
        <a class="btn btn-light btn-sm py-0" id="phRapor" href="/PersonelMaliyet?sekme=muhasebe" target="_blank" title="Personel Maliyet Raporu › Muhasebe Kayıtları (özet görünüm)"><i class="fas fa-table-list me-1"></i>Personel Maliyet Raporu</a>
        <span class="na-mini" id="phSayi"></span>
    </div>
    <div class="na-sekme" id="phSekmeler" data-dinamik="kapali">
        <button type="button" data-p="kayitlar"><i class="fas fa-book me-1"></i>Muhasebe Kayıtları <span class="n" id="phNSim">0</span></button>
        <button type="button" data-p="odemeler"><i class="fas fa-money-bill-transfer me-1"></i>Ödemeler <span class="n" id="phNOdeme">0</span></button>
        <button type="button" data-p="hazirlik"><i class="fas fa-wand-magic-sparkles me-1"></i>Yansıtma Hazırlığı <span class="n" id="phNAday">0</span></button>
        <button type="button" data-p="yansitma"><i class="fas fa-file-invoice-dollar me-1"></i>Yansıtma Kayıtları <span class="n" id="phNKayit">0</span></button>
        <button type="button" data-p="esleme"><i class="fas fa-code-compare me-1"></i>Kalem Eşleme</button>
        <button type="button" data-p="hesap"><i class="fas fa-sitemap me-1"></i>Hesap Eşleştirme <span class="n" id="phNEsleme">0</span></button>
        <button type="button" data-p="arsiv"><i class="fas fa-box-archive me-1"></i>Fiş Arşivi <span class="n" id="phNArsiv">0</span></button>
    </div>

    @* ============================ SEKME: MUHASEBE KAYITLARI (ayrıntılı; Personel Maliyet Raporu ile aynı simülasyon) ============================ *@
    <div class="na-panel" data-p="kayitlar">
        <div class="pm-rapor-ust">
            <div><h5>Muhasebe Kayıtları</h5><span class="pm-sayac" id="phKayitSayi"></span></div>
            <div class="ayar"><label class="pm-anahtar" for="phDetay" title="Personel bazlı satırlar bu ekranda açık gelir (muhasebe çalışma alanı); raporda varsayılan özet görünümdür"><input type="checkbox" id="phDetay" checked> Personel Bazlı Satırlar</label><button type="button" class="btn btn-light btn-sm py-0" id="phSimule" title="Seçili dönem için yeni simülasyon versiyonu üretir (gerçek fiş atmaz)"><i class="fas fa-rotate me-1"></i>Yeniden Simüle</button><button type="button" class="btn btn-light btn-sm py-0" id="phKayitExcel"><i class="fas fa-file-excel me-1"></i>Excel</button></div>
        </div>
        <div class="pm-akis" id="phAkis"></div>
