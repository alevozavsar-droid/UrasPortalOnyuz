    .pm-pill { font-size: .62rem; font-weight: 700; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 2px 8px; }
    .ph .na-ust { margin-bottom: 4px; gap: 8px; } .ph .na-ust h4 { font-size: .95rem; } .ph .na-ust .sub { display: none; } .ph.aciklama .na-ust .sub { display: block; }
    .pm-bilgi { border: 1px solid #e2e8f0; background: #fff; color: #64748b; border-radius: 50%; width: 20px; height: 20px; font-size: .62rem; font-weight: 800; line-height: 1; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; } .ph.aciklama .pm-bilgi { background: #0f766e; color: #fff; border-color: #0f766e; }
    .ph .na-kpi { margin-bottom: 6px; }
    /* filtre çubuğu: tek satır */
