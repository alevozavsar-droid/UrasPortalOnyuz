    .ph .pm-filtre-bar .form-control, .ph .pm-filtre-bar .form-select { font-size: .66rem; padding: 1px 6px; height: 24px; min-height: 24px; width: auto; max-width: 190px; } .ph .pm-filtre-bar .form-select { padding-right: 22px; } .ph .pm-filtre-bar #phAra { width: 190px; }
    .pm-filtre-bar .pm-donem { font-weight: 700; color: #134e4a; background-color: #f0fdfa; border-color: #99f6e4; }
    .pm-filtre-bar .btn, .pm-filtre-bar a.btn { font-size: .62rem; padding-top: 1px; padding-bottom: 1px; } .pm-filtre-bar .na-mini { margin: 0 0 0 auto; font-size: .6rem; white-space: nowrap; }
    .ph .na-sekme { margin-bottom: 6px; } .ph .na-sekme button { padding: 4px 10px; font-size: .74rem; }
