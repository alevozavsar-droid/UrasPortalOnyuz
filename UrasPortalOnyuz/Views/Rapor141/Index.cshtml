@{
    ViewData["Title"] = "Cari Ekstre / Hesap Ekstresi Mutabakatı";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string onKod = (string)ViewBag.Kod ?? "";
}
@*
    CARİ EKSTRE / HESAP EKSTRESİ MUTABAKATI — yeni tasarım. Her carinin cari ekstresi (120 / 320 cari hesabı) ile muhasebe hesap ekstresi (kebir hesabı) karşılaştırılır:
    bakiye farkı olan cariler listede, satıra girince satır satır eşleştirme (Eşleşti · Tutar Farkı · Yalnız Cari · Yalnız Hesap · Mükerrer), fark nedeni, öneri ve tek tıkla düzeltme fişi.
    Veri: Data/EkstreKarsilastirmaOrnek.cs (Cari Mutabakat hareketleri) · uçlar: Controllers/EkstreKarsilastirmaController.cs · betik: wwwroot/js/ekstre-karsilastirma.js
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<link rel="stylesheet" href="/css/cari-islem.css?v=1" />
}
<div class="container-fluid py-3 na ci ek" id="ek" data-kod="@onKod">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-scale-balanced"></i></span>Cari Ekstre / Hesap Ekstresi Mutabakatı</h4>
        <span style="font-size:.68rem;font-weight:700;color:#475569;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:999px;padding:3px 10px"><i class="fas fa-database me-1"></i>Cari Hesaplar ↔ Muhasebe Kebir Hesapları</span>
        <span class="sub w-100">Her carinin <b>cari ekstresi</b> (120 / 320 cari hesabı) ile <b>muhasebe hesap ekstresi</b> (bağlı kebir hesabı) aynı dönem için karşılaştırılır. Listede bakiye farkı ve fark nedenleri; satıra girince <b>satır satır eşleştirme</b>: Eşleşti · Tutar Farkı (kur / kuruş) · Yalnız Cari (fatura muhasebeye aktarılmamış) · Yalnız Hesap (fiş cariye işlenmemiş, kur farkı / mahsup fişi) · Mükerrer fiş. Her fark için öneri ve tek tıkla <b>düzeltme fişi</b>.</span>
    </div>
    <div class="na-sekme" id="ekSekmeler" data-dinamik="kapali">
        <button type="button" data-p="liste" class="aktif"><i class="fas fa-list me-1"></i>Cariler <span class="n" id="ekN">0</span></button>
        <button type="button" data-p="detay"><i class="fas fa-table-columns me-1"></i>Satır Karşılaştırma <span class="n" id="ekNDetay">—</span></button>
        <button type="button" data-p="fis"><i class="fas fa-file-pen me-1"></i>Düzeltme Fişleri <span class="n" id="ekNFis">0</span></button>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>
    <div class="ci-kpi" id="ekKpi"></div>
    <div class="na-panel aktif" data-p="liste">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-filter me-1"></i>Filtreler</span><span class="d-flex gap-1"><button type="button" class="btn btn-light btn-sm py-0" id="ekTemizle" style="font-size:.66rem">Temizle</button><button type="button" class="btn btn-light btn-sm py-0" id="ekExcel" style="font-size:.66rem"><i class="fas fa-file-excel me-1"></i>Excel</button></span></div>
            <div class="na-kart-g">
                <div class="ci-filtre">
                    <div><label>Ara</label><input class="form-control" id="ekAra" placeholder="Kod, ünvan, hesap kodu…"></div>
                    <div><label>Başlangıç</label><input type="date" class="form-control" id="ekBas" style="width:130px"></div>
                    <div><label>Bitiş</label><input type="date" class="form-control" id="ekBit" style="width:130px"></div>
                    <div><label>Cari Tipi</label><select class="form-select" id="ekTip"><option value="">Tümü</option><option>Müşteri</option><option>Tedarikçi</option></select></div>
                    <div><label>Şirket</label><select class="form-select" id="ekSirket"><option value="">Tümü</option></select></div>
                    <div><label>Durum</label><select class="form-select" id="ekDurum"><option value="">Tümü</option><option>Fark Var</option><option>Uyuşuyor</option><option>Hesap Tanımsız</option></select></div>
                    <div><label>Fark Türü</label><select class="form-select" id="ekFarkTur"><option value="">Tümü</option><option>Tutar Farkı</option><option>Yalnız Cari</option><option>Yalnız Hesap</option><option>Mükerrer</option></select></div>
                    <div><button type="button" class="btn btn-primary btn-sm py-0" id="ekRaporla" style="font-size:.66rem;height:24px"><i class="fas fa-rotate me-1"></i>Raporla</button></div>
                    <div class="ms-auto na-mini" id="ekSayi"></div>
                </div>
                <div class="table-responsive"><table class="na-tablo ci-liste" id="ekTablo" data-dinamik="kapali"><thead><tr><th>Cari</th><th>Şirket</th><th>Hesap Kodu</th><th class="e">Cari Borç</th><th class="e">Cari Alacak</th><th class="e">Cari Bakiye</th><th class="e">Hesap Borç</th><th class="e">Hesap Alacak</th><th class="e">Hesap Bakiye</th><th class="e">Fark</th><th class="s">Satır (C / H)</th><th>Durum</th><th>Fark Nedenleri</th><th></th></tr></thead><tbody></tbody><tfoot></tfoot></table></div>
            </div>
        </div>
    </div>
    <div class="na-panel" data-p="detay">
        <div class="row g-2">
            <div class="col-lg-9">
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-user-tie me-1"></i>Cari</span><span class="d-flex gap-1 align-items-center"><select class="form-select" id="ekCari" style="width:320px;font-size:.66rem;height:24px;padding:0 20px 0 6px"><option value="">Seçiniz…</option></select><select class="form-select" id="ekSatirDurum" style="width:auto;font-size:.66rem;height:24px;padding:0 20px 0 6px"><option value="">Tüm Satırlar</option><option value="fark">Yalnız Farklar</option><option>Eşleşti</option><option>Tutar Farkı</option><option>Yalnız Cari</option><option>Yalnız Hesap</option><option>Mükerrer</option></select></span></div>
                    <div class="na-kart-g"><div id="ekCariOzet" class="na-mini"><span class="text-muted">Listeden ya da yukarıdan bir cari seçin.</span></div></div></div>
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-table-columns me-1"></i>Satır Satır Karşılaştırma</span><span class="not">sol: cari ekstre · sağ: muhasebe hesap ekstresi · tutarlar TL</span></div>
                    <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:560px"><table class="na-tablo ci-liste" id="ekSatirlar" data-dinamik="kapali"><thead><tr><th>Tarih</th><th>Belge</th><th>Tip</th><th class="e">Cari Borç</th><th class="e">Cari Alacak</th><th class="s"></th><th>Fiş</th><th class="e">Hesap Borç</th><th class="e">Hesap Alacak</th><th class="e">Fark</th><th>Durum</th><th>Neden · Öneri</th><th></th></tr></thead><tbody><tr><td colspan="13" class="na-bos">Cari seçin.</td></tr></tbody><tfoot></tfoot></table></div></div></div>
            </div>
            <div class="col-lg-3">
                <div class="na-kart ci-yan"><div class="na-kart-b"><span><i class="fas fa-calculator me-1"></i>Karşılaştırma Özeti</span></div>
                    <div class="na-kart-g">
                        <div class="ci-ozet" id="ekOzet"></div>
                        <div class="d-grid gap-1 mt-2"><button type="button" class="btn btn-primary btn-sm" id="ekTumFis" disabled><i class="fas fa-file-pen me-1"></i>Tüm Farklar İçin Düzeltme Fişi</button><a class="btn btn-light btn-sm" id="ekEkstre" href="#" target="_blank" rel="noopener"><i class="fas fa-file-invoice me-1"></i>Cari Ekstre</a></div>
                        <div class="ci-rehber"><div><b>Yalnız Cari:</b> fatura / hareket muhasebeye aktarılmamış → fiş oluştur.</div><div><b>Yalnız Hesap:</b> fiş cariye işlenmemiş (kur farkı, mahsup) → cari hareketi oluştur.</div><div><b>Tutar Farkı:</b> kur / kuruş farkı → düzeltme fişi.</div><div><b>Mükerrer:</b> aynı belge iki kez fişlenmiş → iptal.</div></div>
                    </div></div>
            </div>
        </div>
    </div>
    <div class="na-panel" data-p="fis">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-file-pen me-1"></i>Oluşturulan Düzeltme Fişleri</span><span class="not">simülasyon · gerçek sistemde yevmiye fişi</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="ekFisler" data-dinamik="kapali"><thead><tr><th>Zaman</th><th>Fiş No</th><th>Cari</th><th>Tür</th><th>Açıklama</th><th class="e">Tutar</th><th>Kim</th></tr></thead><tbody></tbody></table></div></div></div>
    </div>
</div>
@section Scripts {
<script src="/js/ekstre-karsilastirma.js?v=1"></script>
}
