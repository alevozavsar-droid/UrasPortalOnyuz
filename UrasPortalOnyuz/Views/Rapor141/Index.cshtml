                    + 'sunucu her kartı tekrar denetler, SAP reddederse kart olduğu gibi kalır. '
                    + '<b>Güvenlik için hiçbiri önceden seçili değildir</b> - silmek istediklerinizi işaretleyin.</div>'
                    + '<div class="text-start mb-2"><label style="font-size:12.5px;cursor:pointer;">'
                    + '<input type="checkbox" id="hszHepsi"> Tümünü seç</label></div>'
                    + '<div style="max-height:50vh; overflow:auto;">'
                    + '<table class="table table-sm table-hover align-middle mb-0">'
                    + '<thead class="table-light"><tr><th style="width:40px;"></th>'
                    + (cokSirket ? '<th class="text-start" style="width:120px;">Şirket</th>' : '')
                    + '<th style="width:120px;">Cari Kodu</th><th class="text-start">Cari Adı</th>'
                    + '<th style="width:100px;">Tip</th><th class="text-start" style="width:170px;">Mutabakat Hesabı</th>'
                    + '</tr></thead><tbody>' + satirlar + '</tbody></table></div>',
                    showCancelButton: true,
                    confirmButtonText: 'Seçilenleri SAP\'den sil',
                    cancelButtonText: 'Kapat',
