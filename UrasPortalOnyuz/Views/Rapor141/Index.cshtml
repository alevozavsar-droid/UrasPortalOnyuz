                        $('#hszHepsi').on('change', function () {
                            $('.hsz-kutu').prop('checked', $(this).is(':checked'));
                        });
                    },
                    preConfirm: function () {
                        var secili = $('.hsz-kutu:checked').map(function () {
                            return { Kod: this.value, DbKey: $(this).data('db') || '' };
