        // ---- HAREKETSIZ CARILERI SILME --------------------------------------
        // Ekranda gorunen (suzulmus) hareketsiz carileri Service Layer ile siler.
        // Sunucu her kart icin tarih araligindan bagimsiz yeniden denetim yapar.
        function hareketsizleriSil(kayitlar) {
            kayitlar = (kayitlar || []).filter(function (k) { return k && k.Kod; });
            if (kayitlar.length === 0) { Swal.fire('Bilgi', 'Silinecek cari seçilmedi.', 'info'); return; }

            var sirketler = [];
            kayitlar.forEach(function (k) { if (sirketler.indexOf(k.DbKey) < 0) sirketler.push(k.DbKey); });

            Swal.fire({
                title: kayitlar.length + ' cari silinsin mi?',
                html: '<div style="text-align:left; font-size:13px;">'
                    + '<b>Şirket:</b> ' + htmlKacis(sirketler.join(', ')) + '<br><br>'
                    + 'Bu kartların bakiyesi sıfır ve hiç hareketi yok. Silmeden önce her biri '
                    + 'tarih aralığından bağımsız olarak yeniden denetlenir; yevmiye satırı veya '
                    + 'belgesi bulunan kart <b>silinmez</b>. Silme SAP Service Layer ile yapılır, '
                    + 'SAP reddederse kart olduğu gibi kalır.'
                    + '<div class="mt-2" style="max-height:160px; overflow:auto; font-size:12px;">'
                    + kayitlar.map(function (k) { return htmlKacis(k.Kod); }).join(', ') + '</div></div>',
                icon: 'warning', showCancelButton: true,
                confirmButtonText: 'Evet, sil', cancelButtonText: 'Vazgeç',
                confirmButtonColor: '#dc3545'
            }).then(function (secim) {
                if (!secim.isConfirmed) return;

                Swal.fire({
                    title: 'Siliniyor...', html: '<i class="fas fa-spinner fa-spin fa-2x text-danger"></i>',
                    showConfirmButton: false, allowOutsideClick: false
                });

                $.ajax({
                    url: '/Rapor141/HareketsizCarileriSil',
                    type: 'POST', contentType: 'application/json',
                    data: JSON.stringify({ Kayitlar: kayitlar }),
                    success: function (res) {
                        if (!res.success) { Swal.fire('Hata', res.message || 'İşlem başarısız.', 'error'); return; }

                        var satir = (res.sonuclar || []).map(function (s) {
                            var renk = s.durum === 'silindi' ? 'text-success'
                                     : (s.durum === 'hata' ? 'text-danger' : 'text-warning');
                            return '<tr><td class="fw-bold">' + htmlKacis(s.kod) + '</td>'
                                 + '<td style="font-size:11.5px;">' + htmlKacis(s.sirket || '') + '</td>'
                                 + '<td class="' + renk + ' text-start">' + htmlKacis(s.mesaj) + '</td></tr>';
                        }).join('');

                        Swal.fire({
                            title: res.silinen + ' / ' + res.toplam + ' cari silindi',
                            width: 720,
                            html: '<div style="max-height:56vh; overflow:auto;">'
                                + '<table class="table table-sm align-middle mb-0"><tbody>' + satir + '</tbody></table></div>',
                            icon: res.silinen > 0 ? 'success' : 'info',
                            confirmButtonText: 'Kapat'
                        }).then(function () { if (res.silinen > 0) location.reload(); });
                    },
                    error: function (x) {
                        Swal.fire('Sunucu Hatası (' + x.status + ')',
                                  (x.responseText || x.statusText || '').substring(0, 400), 'error');
                    }
                });
            });
        }


        $(document).ready(function () {
            // Modal sayfa gövdesinin içinde kalırsa Bootstrap backdrop'u üstüne biner
            // ve pencere bulanık / tıklanamaz görünür.
            $('.modal').each(function () {
                var $m = $(this);
                if (!$m.parent().is('body')) $m.appendTo('body');
            });

            tipEtiketiGuncelle();

            $('.tip-check').on('change', tipEtiketiGuncelle);
            $('#inpBas, #inpBit, #selCariTipi, #inpArama, #chkDevir, #chkSadeceUyusmayan, #selKonsolide').on('change keyup', excelLinkiGuncelle);

            $('#filtreForm').on('submit', function () {
                $('#tiplerInput').val(secilenTiplerCsv());
            });

            $('#tabloAra').on('keyup', tabloyuSuz);

            // Sekme rozetleri ilk aciliste da dolsun.
            tabloyuSuz();

            excelLinkiGuncelle();
        });

        function secilenTipler() {
            var t = [];
            $('.tip-check:checked').each(function () { t.push($(this).val()); });
            return t;
        }

        function secilenTiplerCsv() {
            var adet = $('.tip-check:checked').length;
            var toplam = $('.tip-check').length;
            return (adet === toplam) ? '' : secilenTipler().join('||');
        }

        function tumTipler(sec) {
            $('.tip-check').prop('checked', sec);
            tipEtiketiGuncelle();
        }

        function tipEtiketiGuncelle() {
            var adet = $('.tip-check:checked').length;
            var toplam = $('.tip-check').length;
            $('#tipDropdownLabel').text((adet === 0 || adet === toplam) ? 'Tüm işlem tipleri' : adet + ' işlem tipi seçili');
            $('#tiplerInput').val(secilenTiplerCsv());
            excelLinkiGuncelle();
        }

        function excelLinkiGuncelle() {
            var url = '/Rapor141/ExcelExport'
                + '?bas=' + encodeURIComponent($('#inpBas').val())
                + '&bit=' + encodeURIComponent($('#inpBit').val())
                + '&tipler=' + encodeURIComponent($('#tiplerInput').val())
                + '&cariTipi=' + encodeURIComponent($('#selCariTipi').val())
                + '&devirDahil=' + ($('#chkDevir').is(':checked') ? 'true' : 'false')
                + '&sadeceUyusmayanlar=' + ($('#chkSadeceUyusmayan').is(':checked') ? 'true' : 'false')
                + '&arama=' + encodeURIComponent($('#inpArama').val())
                + '&konsolide=' + encodeURIComponent($('#selKonsolide').val() || '');
            $('#btnExcel').attr('href', url);
        }

        // Secili uyusma sekmesi ('' = tumu)
        var aktifUyusmaDurumu = '';

        function tabloyuSuz() {
            var q = ($('#tabloAra').val() || '').toLocaleLowerCase('tr-TR');
            var kapsam = $('#selKapsam').val() || '3';   // 1 / 2 / 3 (konsolide)

            var gorunen = 0;
            var sayim = { '': 0, 'OK': 0, 'FARK': 0, 'TEKSIRKET': 0, 'HESAPYOK': 0, 'YOK': 0 };

            $('#cariTable tbody tr[data-durum]').each(function () {
                var $tr = $(this);

                var durumUygun = (aktifDurumFiltresi === 'ALL') || ($tr.data('durum') === aktifDurumFiltresi);
                var metin = $tr.text().toLocaleLowerCase('tr-TR');
                var metinUygun = metin.indexOf(q) > -1;

                // Kapsamdaki uyusma durumu. Konsolide degilken data-durum1/2/3
                // dolmaz; o durumda satirin kendi durumu kullanilir.
                var uDurum = KONSOLIDE_MI
                    ? String($tr.data('durum' + kapsam) || '')
                    : String($tr.data('durum') || '');


                // Sekme rozetleri, uyusma sekmesi DISINDAKI suzgeclere gore sayilir;
                // boylece bir sekmeye gecince digerlerinin sayisi degismez.
                if (durumUygun && metinUygun) {
                    sayim[''] = sayim[''] + 1;
                    if (sayim.hasOwnProperty(uDurum)) sayim[uDurum] = sayim[uDurum] + 1;
                }

                var uyusmaUygun = (aktifUyusmaDurumu === '') || (uDurum === aktifUyusmaDurumu);
                var uygun = durumUygun && metinUygun && uyusmaUygun;

                $tr.toggle(uygun);
                if (uygun) gorunen++;
            });

            $('#uyusmaSekmeleri button').each(function () {
                var dur = String($(this).data('durum') || '');
                $(this).find('.badge').text(sayim.hasOwnProperty(dur) ? sayim[dur] : 0);
            });

            if (aktifUyusmaDurumu !== '' || q) {
                $('#filterStatusText').text(gorunen + ' cari gösteriliyor.');
            }
        }

        $(document).on('click', '#uyusmaSekmeleri button[data-durum]', function () {
            $('#uyusmaSekmeleri button').removeClass('active');
            $(this).addClass('active');
            aktifUyusmaDurumu = String($(this).data('durum') || '');
            tabloyuSuz();
        });

        function filterTable(durum, element) {
            aktifDurumFiltresi = durum;
            $('.dashboard-card.filter-card').removeClass('active-filter');
            $(element).addClass('active-filter');
            tabloyuSuz();

            var metinler = {
                'ALL': 'Tüm kayıtlar gösteriliyor.',
                'OK': 'Sadece uyuşan cariler gösteriliyor.',
                'FARK': 'Sadece UYUŞMAYAN cariler gösteriliyor.',
                'YOK': 'Sadece ana verisinde kontrol hesabı tanımsız cariler gösteriliyor.'
            };
            $('#filterStatusText').text(metinler[durum]);
        }

        function tutarFormat(x) {
            return (x || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function htmlKacis(s) {
            return $('<div>').text(s == null ? '' : s).html();
        }

        function ozetKutu(baslik, deger, sinif) {
            return '<div class="col-md-4"><div class="dashboard-card p-3 border-0 ' + sinif + '">'
                 + '<div class="kpi-title">' + htmlKacis(baslik) + '</div>'
                 + '<div class="kpi-value" style="font-size:18px;">' + htmlKacis(deger) + '</div>'
                 + '</div></div>';
        }

        function farkTablosu(baslik, satirlar, toplam, renkSinifi) {
            var html = '<h6 class="fw-bold mt-3 mb-2" style="font-size:.85rem;">' + htmlKacis(baslik) + '</h6>'
                     + '<div class="table-responsive" style="max-height:260px; overflow-y:auto;">'
                     + '<table class="table table-sm table-hover align-middle mb-0"><thead class="sticky-top"><tr>'
                     + '<th>Tarih</th><th>Yevmiye No</th><th>Satır</th><th>İşlem Tipi</th><th>Hesap</th>'
                     + '<th>Açıklama</th><th class="text-end">Tutar</th><th>Neden</th>'
                     + '</tr></thead><tbody>';

            satirlar.forEach(function (r) {
                html += '<tr>'
                     + '<td>' + htmlKacis(r.tarih) + '</td>'
                     + '<td class="fw-bold">' + htmlKacis(r.yevmiyeNo) + '</td>'
                     + '<td>' + htmlKacis(r.satirNo) + '</td>'
                     + '<td>' + htmlKacis(r.islemTipi) + '</td>'
                     + '<td>' + htmlKacis(r.hesapKodu) + '</td>'
                     + '<td style="max-width:220px; font-size:11.5px;">' + htmlKacis(r.aciklama) + '</td>'
                     + '<td class="tutar fw-bold">' + tutarFormat(r.tutar) + '</td>'
                     + '<td><span class="badge-soft-warning">' + htmlKacis(r.neden) + '</span></td>'
                     + '</tr>';
            });

            html += '</tbody><tfoot><tr class="' + renkSinifi + '">'
                  + '<td colspan="6" class="text-end fw-bold">TOPLAM ETKİ</td>'
                  + '<td class="tutar fw-bold">' + htmlKacis(toplam) + '</td><td></td>'
                  + '</tr></tfoot></table></div>';

            return html;
        }

        function ekstreTablosu(satirlar, baslik, renkSinifi) {
            if (!satirlar || satirlar.length === 0) {
                return '<div class="alert alert-light border">' + baslik + ': kayıt yok.</div>';
            }

            var bakiye = 0;
            var html = '<h6 class="fw-bold mt-3 mb-2">' + baslik + '</h6>'
                + '<div class="table-responsive" style="max-height:320px; overflow-y:auto;">'
                + '<table class="table table-sm table-hover align-middle mb-0"><thead class="sticky-top"><tr>'
                + '<th>Tarih</th><th>İşlem No</th><th>Belge Tipi</th><th>İşlem Tipi</th><th>Hesap</th><th>Açıklama</th>'
                + '<th class="text-end">Borç</th><th class="text-end">Alacak</th><th class="text-end">Bakiye</th>'
                + '</tr></thead><tbody>';

            for (var i = 0; i < satirlar.length; i++) {
                var r = satirlar[i];
                bakiye += (r.borc - r.alacak);
                html += '<tr>'
                    + '<td>' + htmlKacis(r.tarih) + '</td>'
                    + '<td>' + htmlKacis(r.islemNo) + '</td>'
                    + '<td>' + htmlKacis(r.islemTipi) + '</td>'
                    + '<td><span class="badge-soft-secondary">' + htmlKacis(r.aktarimTipi) + '</span></td>'
                    + '<td>' + htmlKacis(r.hesapKodu) + '<div class="text-muted" style="font-size:11px;">' + htmlKacis(r.hesapAdi) + '</div></td>'
                    + '<td style="max-width:240px; font-size:11.5px;">' + htmlKacis(r.aciklama) + '</td>'
                    + '<td class="tutar">' + tutarFormat(r.borc) + '</td>'
                    + '<td class="tutar">' + tutarFormat(r.alacak) + '</td>'
                    + '<td class="tutar fw-bold">' + tutarFormat(bakiye) + '</td>'
                    + '</tr>';
            }

            html += '</tbody><tfoot><tr class="' + renkSinifi + '"><td colspan="8" class="text-end fw-bold">TOPLAM BAKİYE</td>'
                + '<td class="tutar fw-bold">' + tutarFormat(bakiye) + '</td></tr></tfoot></table></div>';
            return html;
        }

        function ekstreAc(btn) {
            var satir = $(btn).closest('tr');
            var cardCode = satir.data('cardcode');
            var cardName = satir.data('cardname');
            var hesaplar = satir.data('hesaplar');

            $('#ekstreModalBaslik').text('Ekstre Karşılaştırması - ' + cardCode + ' / ' + cardName);
            $('#ekstreModalBody').html('<div class="text-center py-5 text-muted"><i class="fas fa-spinner fa-spin fa-2x"></i><div class="mt-2">Ekstre satırları getiriliyor...</div></div>');

            var modal = new bootstrap.Modal(document.getElementById('ekstreModal'));
            modal.show();

            $.getJSON('/Rapor141/Detay', {
                cardCode: cardCode,
                hesaplar: hesaplar,
                bas: $('#inpBas').val(),
                bit: $('#inpBit').val(),
                tipler: $('#tiplerInput').val(),
                devirDahil: $('#chkDevir').is(':checked'),
                konsolide: $('#selKonsolide').val() || '',
                vergiNo: satir.data('vergino') || '',
                unvan: satir.data('unvan') || ''
            }, function (res) {
                if (!res.success) {
                    $('#ekstreModalBody').html('<div class="alert alert-danger">' + htmlKacis(res.message) + '</div>');
                    return;
                }

                var html = '';

                (res.bolumler || []).forEach(function (b) {
                    html += '<div class="mb-4">';
                    html += '<h6 class="fw-bold mb-2" style="letter-spacing:-.02em;">'
                          + '<i class="fas fa-building me-2 text-primary"></i>' + htmlKacis(b.sirket) + '</h6>';

                    if (!b.bulundu) {
                        html += '<div class="alert alert-warning py-2" style="font-size:12.5px;">'
                              + htmlKacis(b.mesaj) + '</div></div>';
                        return;
                    }

                    /* Özet şeridi */
                    html += '<div class="row g-2 mb-3">'
                          + ozetKutu('Cari Ekstre (Rapor20)', b.cariBakiye, 'border-top-primary')
                          + ozetKutu('Hesap Ekstresi (Rapor39) - ' + (b.hesapKodu || '-'), b.hesapBakiye, 'border-top-purple')
                          + ozetKutu('Fark', b.fark, b.farkVar ? 'border-top-danger' : 'border-top-success')
                          + '</div>';

                    /* FARK ANALİZİ */
                    if (b.sadeceCaride.length || b.sadeceHesapta.length) {
                        html += '<div class="alert alert-warning py-2 mb-2" style="font-size:12.5px;">'
                              + '<i class="fas fa-magnifying-glass-chart me-1"></i> <b>Farkı oluşturan kayıtlar</b> — '
                              + 'iki ekstre yevmiye no + satır no ile eşleştirildi, eşleşmeyenler aşağıda.</div>';

                        if (b.sadeceCaride.length) {
                            html += farkTablosu('Yalnızca CARİ ekstresinde olanlar (' + b.sadeceCaride.length + ')',
                                                b.sadeceCaride, b.sadeceCarideToplam, 'table-primary');
                        }
                        if (b.sadeceHesapta.length) {
                            html += farkTablosu('Yalnızca HESAP ekstresinde olanlar (' + b.sadeceHesapta.length + ')',
                                                b.sadeceHesapta, b.sadeceHesaptaToplam, 'table-secondary');
                        }
                    } else {
                        html += '<div class="alert alert-success py-2 mb-2" style="font-size:12.5px;">'
                              + '<i class="fas fa-circle-check me-1"></i> İki ekstrenin bütün satırları eşleşiyor.</div>';
                    }

                    /* Tam ekstreler */
                    var kartBilgi = (b.cariKartSayisi > 1) ? (' [' + b.cariKartSayisi + ' cari kartı]') : '';
                    html += ekstreTablosu(b.cariSatirlar, 'Cari Ekstresi (Rapor20) - ' + (b.cariKodu || '') + kartBilgi, 'table-primary');
                    html += ekstreTablosu(b.hesapSatirlar, 'Kontrol Hesabı Ekstresi (Rapor39) - ' + (b.hesapKodu || ''), 'table-secondary');

                    html += '</div>';
                });

                $('#ekstreModalBody').html(html);
            }).fail(function () {
                $('#ekstreModalBody').html('<div class="alert alert-danger">Sunucu ile iletişim kurulurken bir hata oluştu.</div>');
            });
        }
    </script>

    @* ---- DÜZELTME (VİRMAN) PENCERESİ -------------------------------------- *@
    <div class="modal fade" id="duzeltmeModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
          <div class="modal-header bg-light">
            <h5 class="modal-title fw-bold">
              <i class="fas fa-screwdriver-wrench text-warning me-2"></i>Düzeltme Fişi — 1. Şirkete Yevmiye
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
          </div>

          <div class="modal-body">
            <div class="alert alert-light border py-2 mb-3" style="font-size:12.5px;">
              <b id="dzCariAdi">-</b> <span class="text-muted" id="dzCariKodu"></span>
              <div class="text-muted mt-1" id="dzFarkBilgi"></div>
            </div>

            <div class="row g-3">
              <div class="col-12">
                <label class="filtre-label">Fişin kesileceği şirket <span class="text-muted" style="text-transform:none;">(her zaman 1. şirket; 2. şirkete fiş atılmaz)</span></label>
                <input type="text" class="form-control form-control-sm bg-light fw-bold" id="dzSirketAd" readonly />
                <input type="hidden" id="dzSirket" />
              </div>
              <div class="col-md-4">
                <label class="filtre-label">Tarih</label>
                <input type="date" class="form-control form-control-sm" id="dzTarih" />
              </div>
              <div class="col-md-4">
                <label class="filtre-label">İşlem Tipi (U_BE1_AKTAR)</label>
                <select class="form-select form-select-sm" id="dzIslemTipi"></select>
              </div>
              <div class="col-md-4">
                <label class="filtre-label">Aktarılmasın (U_BE1_AKTARMA)</label>
                <select class="form-select form-select-sm" id="dzAktarilmasin">
                  <option value="Y" selected>Evet</option>
                  <option value="N">Hayır</option>
                </select>
              </div>

              <div class="col-md-6">
                <label class="filtre-label">Cari satırının yönü</label>
                <select class="form-select form-select-sm" id="dzYon">
                  <option value="B">Cari BORÇ / karşı hesap ALACAK</option>
                  <option value="A">Cari ALACAK / karşı hesap BORÇ</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="filtre-label">Tutar</label>
                <input type="number" step="0.01" min="0" class="form-control form-control-sm" id="dzTutar" />
              </div>

              <div class="col-12">
                <label class="filtre-label">Karşı hesap <span class="text-muted" style="text-transform:none;">(yıldıza tıklayarak favoriye alın; favoriler en üstte gelir)</span></label>
                <input type="text" class="form-control form-control-sm mb-2" id="dzHesapAra" placeholder="Hesap kodu veya adı ile ara..." autocomplete="off" />
                <div id="dzHesapListe" style="max-height:230px; overflow:auto; border:1px solid #e2e8f0; border-radius:8px; padding:4px;">
                  <div class="text-muted text-center py-3" style="font-size:12.5px;">Şirket seçilince yüklenecek.</div>
                </div>
                <input type="hidden" id="dzKarsiHesap" />
              </div>

              <div class="col-12">
                <label class="filtre-label">Açıklama</label>
                <input type="text" class="form-control form-control-sm" id="dzAciklama" maxlength="50"
                       placeholder="Fiş açıklaması (en fazla 50 karakter)" />
              </div>
            </div>
          </div>

          <div class="modal-footer bg-light border-top-0">
            <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">İptal</button>
            <button type="button" class="btn btn-warning px-4 fw-bold" id="dzKaydet">
              <i class="fas fa-check me-1"></i>Fişi Kes
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
        // =============== TABLO SIRALAMA ===================================
        // Basliklara tiklayinca satirlar yerinde siralanir; ok yonu hangi
        // kolona gore siralandigini gosterir.
        var siraDurumu = { alan: null, yon: 1 };

        function sayiyaCevir(x) { var s = parseFloat(x); return isNaN(s) ? 0 : s; }

        $(document).on('click', '#cariTable th.sirali', function () {
            var alan = $(this).data('sira');
            siraDurumu = (siraDurumu.alan === alan)
                ? { alan: alan, yon: -siraDurumu.yon }
                : { alan: alan, yon: 1 };

            $('#cariTable th.sirali').removeClass('aktif').find('.ok').html('&#8645;');
            $(this).addClass('aktif').find('.ok').html(siraDurumu.yon > 0 ? '&#9650;' : '&#9660;');

            var govde = $('#cariTable tbody');
            var satirlar = govde.find('tr[data-durum]').get();

            satirlar.sort(function (a, b) {
                var $a = $(a), $b = $(b), x, y;

                if (alan === 'kod' || alan === 'ad') {
                    x = String($a.data(alan === 'kod' ? 'cardcode' : 'cardname') || '');
                    y = String($b.data(alan === 'kod' ? 'cardcode' : 'cardname') || '');
                    return x.localeCompare(y, 'tr') * siraDurumu.yon;
                }

                x = sayiyaCevir($a.data(alan));
                y = sayiyaCevir($b.data(alan));
                return (x - y) * siraDurumu.yon;
            });

            $.each(satirlar, function (i, tr) { govde.append(tr); });
        });

        // =============== DÜZELTME FİŞİ ====================================
        var dzSatir = null;
        var dzHesaplar = [];

        var DZ_ISLEM_TIPLERI = [@Html.Raw(string.Join(",", (Model.IslemTipleri ?? new List<WebApplication3.Controllers.IslemTipiOgesi>()).Select(t => "'" + t.Kod.Replace("'", "\\'") + "'")))];

        function duzeltmeAc(dugme) {
            dzSatir = $(dugme).closest('tr');

            $('#dzCariAdi').text(dzSatir.data('cardname') || '');
            $('#dzCariKodu').text('· ' + (dzSatir.data('cardcode') || ''));
            $('#dzKarsiHesap').val('');
            $('#dzHesapAra').val('');
            $('#dzAciklama').val('Mutabakat düzeltme ' + (dzSatir.data('cardcode') || ''));
            $('#dzTarih').val(new Date().toISOString().substring(0, 10));

            // İşlem tipi listesi
            var it = '<option value="">(boş)</option>';
            DZ_ISLEM_TIPLERI.forEach(function (t) { it += '<option value="' + t + '">' + t + '</option>'; });
            $('#dzIslemTipi').html(it);

            // Şirket listesi: sayfanın filtresinden gelir (A.Ş. / normal)
            $.get('/Rapor141/FiltreSirketleri', { konsolide: $('#selKonsolide').val() || '' }, function (res) {
                if (!res.success) { Swal.fire('Hata', 'Şirket listesi alınamadı.', 'error'); return; }

                if (!res.liste || !res.liste.length) { Swal.fire('Hata', 'Şirket listesi boş.', 'error'); return; }
                // Fiş her zaman 1. şirkete kesilir; 2. şirket yalnızca eşitlenecek bakiyeyi verir.
                $('#dzSirket').val(res.liste[0].key);
                $('#dzSirketAd').val(res.liste[0].ad + (res.liste.length > 1 ? '   |   2. şirket: ' + res.liste[1].ad : ''));
                $('#dzAktarilmasin').val('Y');

                farkiUygula();
                hesaplariYukle();
                new bootstrap.Modal(document.getElementById('duzeltmeModal')).show();
            }).fail(function () { Swal.fire('Hata', 'Sunucuya bağlanılamadı.', 'error'); });
        }

        // 1. şirketin cari bakiyesi, 2. şirketteki cari bakiyeye eşitlenir.
        // 2. şirkette aynı cari karşı taraftır (müşteri <-> tedarikçi), bakiyesi ters işaretle alınır.
        // Örnek: 1. şirkette 100 borç, 2. şirkette 120 alacak -> 1. şirkete 20 BORÇ kesilir.
        function farkiUygula() {
            var s1 = sayiyaCevir(dzSatir.data('s1cari'));
            var s2 = sayiyaCevir(dzSatir.data('s2cari'));
            var hedef = -s2;
            var fark = Math.round((hedef - s1) * 100) / 100;
            $('#dzTutar').val(Math.abs(fark).toFixed(2));
            // fark > 0: 1. şirketteki bakiye artmalı -> cari BORÇ; fark < 0 -> cari ALACAK. Öneridir, değiştirilebilir.
            $('#dzYon').val(fark >= 0 ? 'B' : 'A');
            $('#dzFarkBilgi').html(
                '1. şirket cari bakiyesi: <b>' + tutarFormat(s1) + '</b>'
              + ' &nbsp;|&nbsp; 2. şirket bakiyesi (ters işaret): <b>' + tutarFormat(hedef) + '</b>'
              + ' &nbsp;|&nbsp; ' + (fark
                    ? '1. şirkete kesilecek: <b class="' + (fark > 0 ? 'text-danger' : 'text-success') + '">'
                      + tutarFormat(Math.abs(fark)) + ' ' + (fark > 0 ? 'BORÇ' : 'ALACAK') + '</b>'
                    : '<b class="text-success">Bakiyeler eşit, fark yok.</b>'));
        }
        function hesaplariYukle() {
            $('#dzHesapListe').html('<div class="text-muted text-center py-3" style="font-size:12.5px;">' +
                '<i class="fas fa-spinner fa-spin me-1"></i>Yükleniyor...</div>');

            $.get('/Rapor141/KarsiHesaplar', {
                dbKey: $('#dzSirket').val(),
                arama: $('#dzHesapAra').val() || ''
            }, function (res) {
                if (!res.success) {
                    $('#dzHesapListe').html('<div class="text-danger p-2" style="font-size:12.5px;">' + htmlKacis(res.message || 'Liste alınamadı.') + '</div>');
                    return;
                }

                dzHesaplar = res.liste || [];
                hesaplariCiz();
            }).fail(function () {
                $('#dzHesapListe').html('<div class="text-danger p-2">Sunucuya bağlanılamadı.</div>');
            });
        }

        function hesaplariCiz() {
            if (dzHesaplar.length === 0) {
                $('#dzHesapListe').html('<div class="text-muted text-center py-3" style="font-size:12.5px;">Hesap bulunamadı.</div>');
                return;
            }

            var secili = $('#dzKarsiHesap').val();
            var oncekiFavori = true;

            var h = dzHesaplar.map(function (x, i) {
                var ayirici = '';
                if (x.favori) oncekiFavori = true;
                else if (oncekiFavori && i > 0) { ayirici = '<div class="border-top my-1"></div>'; oncekiFavori = false; }
                else if (i === 0) oncekiFavori = false;

                return ayirici
                     + '<div class="kh-satir' + (x.kod === secili ? ' secili' : '') + '" data-kod="' + htmlKacis(x.kod) + '">'
                     + '<i class="fas fa-star kh-yildiz' + (x.favori ? ' dolu' : '') + '" data-fav="' + htmlKacis(x.kod) + '" title="Favori"></i>'
                     + '<span class="fw-bold" style="min-width:120px;">' + htmlKacis(x.hesapKodu) + '</span>'
                     + '<span class="text-truncate">' + htmlKacis(x.ad) + '</span>'
                     + '</div>';
            }).join('');

            $('#dzHesapListe').html(h);
        }

        $(document).on('click', '#dzHesapListe .kh-yildiz', function (e) {
            e.stopPropagation();
            var kod = $(this).data('fav');
            var kayit = dzHesaplar.filter(function (x) { return x.kod === kod; })[0];
            if (!kayit) return;

            var yeni = !kayit.favori;
            $.ajax({
                url: '/Rapor141/HesapFavoriDegistir', type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ DbKey: $('#dzSirket').val(), AcctCode: kod, Favori: yeni }),
                success: function (res) {
                    if (!res.success) { toastr.error(res.message || 'Favori kaydedilemedi.'); return; }
                    kayit.favori = yeni;
                    // Favoriler en üste taşınsın diye listeyi yeniden sırala.
                    dzHesaplar.sort(function (a, b) {
                        if (a.favori !== b.favori) return a.favori ? -1 : 1;
                        return String(a.kod).localeCompare(String(b.kod));
                    });
                    hesaplariCiz();
                }
            });
        });

        $(document).on('click', '#dzHesapListe .kh-satir', function () {
            $('#dzKarsiHesap').val($(this).data('kod'));
            $('#dzHesapListe .kh-satir').removeClass('secili');
            $(this).addClass('secili');
        });

        $(document).on('change', '#dzSirket', function () { farkiUygula(); hesaplariYukle(); });

        var dzAramaZaman = null;
        $(document).on('input', '#dzHesapAra', function () {
            clearTimeout(dzAramaZaman);
            dzAramaZaman = setTimeout(hesaplariYukle, 350);
        });

        $(document).on('click', '#dzKaydet', function () {
            var karsi = $('#dzKarsiHesap').val();
            var tutar = parseFloat($('#dzTutar').val() || '0');

            if (!karsi) { toastr.warning('Karşı hesap seçin.'); return; }
            if (!(tutar > 0)) { toastr.warning('Tutar sıfırdan büyük olmalı.'); return; }

            var dugme = $(this).prop('disabled', true)
                               .html('<span class="spinner-border spinner-border-sm me-1"></span>Kesiliyor...');

            $.ajax({
                url: '/Rapor141/DuzeltmeYevmiyesi', type: 'POST', contentType: 'application/json',
                data: JSON.stringify({
                    DbKey: $('#dzSirket').val(),
                    CardCode: dzSatir.data('cardcode'),
                    KarsiHesap: karsi,
                    Tutar: tutar,
                    Yon: $('#dzYon').val(),
                    Tarih: $('#dzTarih').val(),
                    IslemTipi: $('#dzIslemTipi').val(),
                    Aciklama: $('#dzAciklama').val(),
                    Aktarilmasin: $('#dzAktarilmasin').val()
                }),
                success: function (res) {
                    if (!res.success) { Swal.fire({ title: 'Fiş kesilemedi', html: res.message, icon: 'error' }); return; }

                    bootstrap.Modal.getInstance(document.getElementById('duzeltmeModal')).hide();
                    Swal.fire({ title: 'Tamam', html: res.message, icon: 'success' })
                        .then(function () { location.reload(); });
                },
                error: function (x) {
                    Swal.fire('Sunucu Hatası (' + x.status + ')', (x.responseText || '').substring(0, 400), 'error');
                },
                complete: function () {
                    dugme.prop('disabled', false).html('<i class="fas fa-check me-1"></i>Fişi Kes');
                }
            });
        });
    </script>
}
