        }

        .note-column {
            min-width: 60px;
            max-width: 60px;
            width: 60px;
            text-align: center;
        }

            .note-column button {
                padding: 3px 6px;
                font-size: 0.75rem;
            }

        .text-right {
            text-align: right;
        }

        .text-center {
            text-align: center;
        }

        .vadesi-gecmis {
            color: var(--danger-color);
            font-weight: 600;
        }
    </style>
}

<div class="container-fluid py-4">
