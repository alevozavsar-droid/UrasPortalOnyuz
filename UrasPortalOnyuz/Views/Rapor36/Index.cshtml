                        <th data-column="XBakiye"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                        <th data-column="Hesap420Bakiyesi"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th> 
                        <th data-column="GenelBakiyeFarki"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th> 
                        <th data-column="RYaslananBakiyeGecikmeGunSayisi"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                        <th data-column="RYaslananBakiye"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                        <th data-column="XYaslananBakiyeGecikmeGunSayisi"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                        <th data-column="XYaslananBakiye"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                        <th data-column="SatisSorumlusu">
                            <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Satış Sorumlusu">
                                @if (distinctValues.ContainsKey("SatisSorumlusu"))
                                {
                                    foreach (var item in distinctValues["SatisSorumlusu"])
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                            </select>
                        </th>
                        <th data-column="MusteriGrubu">
                            <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Müşteri Grubu">
                                @if (distinctValues.ContainsKey("MusteriGrubu"))
                                {
                                    foreach (var item in distinctValues["MusteriGrubu"])
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                            </select>
                        </th>
                        <th data-column="SonAyFaturaLimiti"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                    </tr>
                </thead>
                <tbody>
                    @* İçerik JavaScript ile doldurulur *@
                </tbody>
            </table>
        </div>
        <p class="mt-3">Toplam Kayıt: <strong id="totalRecords">@(Model?.Count ?? 0)</strong></p>
    }
    else
    {
        <div class="alert alert-info text-center shadow-sm">Gösterilecek veri bulunamadı.</div>
    }
    
    @* 4. KURAL: UI/UX Standartlarına uygun şık, db parametreli Ana Sayfa Dönüş butonu *@
    <div class="mt-4 mb-5 text-center">
        <a asp-controller="Home" asp-action="Index" asp-route-db="@currentDb" class="btn btn-outline-secondary fw-bold shadow-sm">
            <i class="fas fa-home me-2"></i> Ana Sayfaya Dön
        </a>
    </div>
</div>

@* Müşteri Notları Modal *@
<div class="modal fade" id="noteModal" tabindex="-1" aria-labelledby="noteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="noteModalLabel">Müşteri Notları</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
