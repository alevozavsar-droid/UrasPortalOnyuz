            position: sticky;
            top: 0;
            background-color: var(--white-bg);
            z-index: 1000;
            padding: 10px 15px;
            border-radius: 8px;
            margin-bottom: 10px;
            box-shadow: var(--box-shadow-medium);
            display: flex;
            justify-content: flex-end; 
            align-items: center;
            gap: 20px;
        }

        .total-amount-display {
            font-size: 1em;
            font-weight: 600;
            color: var(--danger-color);
            white-space: nowrap;
        }

        .btn {
            padding: 0.4rem 0.8rem;
            font-size: 0.8rem;
