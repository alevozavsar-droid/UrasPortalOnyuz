                    <p class="text-muted">Yükleniyor...</p>
                </div>

                <h6 id="newNoteHeader">Yeni Not Ekle</h6>
                <form id="addNoteForm">
                    <input type="hidden" id="noteCardCode" name="CardCode" />
                    <div class="mb-3">
                        <textarea class="form-control" id="newNoteContent" name="Note" rows="3" placeholder="Görüşme notlarınızı buraya yazınız..." required></textarea>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary" id="cancelEditButton" style="display:none;" onclick="cancelEdit()">İptal</button>
                        <button type="button" class="btn btn-success" id="updateNoteButton" style="display:none;">Güncelle</button>
                        <button type="submit" class="btn btn-primary" id="saveNoteButton">Kaydet</button>
                    </div>
                    <div class="clearfix"></div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            // Aktif veritabanı parametresini JS değişkenine alıyoruz
            const currentDbParam = '@currentDb';
            const dbQueryString = currentDbParam ? `?db=${currentDbParam}` : '';
            const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            const allReportData = @Html.Raw(reportDataJson);
            const table = document.getElementById('rapor36Table');
            
            if(!table) return;

            const tableBody = table.querySelector('tbody');
            const totalSelectedTlAmountSpan = document.getElementById('totalSelectedTlAmount');
            const totalRecordsSpan = document.getElementById('totalRecords');
            const monthFilterSelect = document.getElementById('monthFilter');
            const applyFilterBtn = document.getElementById('applyFilterBtn');

            // Modal Elementleri
            const noteModal = new bootstrap.Modal(document.getElementById('noteModal'));
            const customerInfoH6 = document.getElementById('customerInfo');
            const existingNotesDiv = document.getElementById('existingNotes');
            const noteCardCodeInput = document.getElementById('noteCardCode');
            const addNoteForm = document.getElementById('addNoteForm');
            const newNoteContent = document.getElementById('newNoteContent');
            const saveNoteButton = document.getElementById('saveNoteButton');
            const updateNoteButton = document.getElementById('updateNoteButton');
            const cancelEditButton = document.getElementById('cancelEditButton');
            const newNoteHeader = document.getElementById('newNoteHeader');

            let currentlyFilteredRows = [...allReportData];
            let currentSortColumn = null;
            let currentSortDirection = 'none';
            let selectedRowsData = {};
            let currentEditingNoteId = null;

            // Global Filtre Temizleyici
            window.clearReportFilters = function () {
                $('.filter-row .filter-input').val('');
                $('.filter-select-bs').selectpicker('val', '');
                currentSortColumn = null;
                currentSortDirection = 'none';
                $('th.sortable-column i').attr('class', 'fas fa-sort float-end');
                
                currentlyFilteredRows = [...allReportData];
                renderTable(currentlyFilteredRows);
                if (typeof toastr !== 'undefined') toastr.success('Filtreler başarıyla sıfırlandı.');
            };

            const columnMappings = {
                'MusteriKodu': 'MusteriKodu',
                'MusteriFirmaAdi': 'MusteriFirmaAdi',
                'RBakiye': 'RBakiye',
                'XBakiye': 'XBakiye',
                'Hesap420Bakiyesi': 'Hesap420Bakiyesi', 
                'GenelBakiyeFarki': 'GenelBakiyeFarki', 
                'RYaslananBakiyeGecikmeGunSayisi': 'RYaslananBakiyeGecikmeGunSayisi',
                'RYaslananBakiye': 'RYaslananBakiye',
                'XYaslananBakiyeGecikmeGunSayisi': 'XYaslananBakiyeGecikmeGunSayisi',
                'XYaslananBakiye': 'XYaslananBakiye',
                'SatisSorumlusu': 'SatisSorumlusu',
                'MusteriGrubu': 'MusteriGrubu',
                'SonAyFaturaLimiti': 'SonAyFaturaLimiti'
            };

            function updatePaginationInfo(totalCount) {
                if (totalRecordsSpan) {
                    totalRecordsSpan.textContent = totalCount;
                }
            }

            function formatCurrency(value) {
                return value?.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) ?? '0,00';
            }

            function formatNumber(value) {
                return value?.toLocaleString('tr-TR') ?? '0';
            }

            function formatDate(dateString) {
                if (!dateString) return '';
                const date = new Date(dateString);
                if (isNaN(date.getTime())) return '';
                return date.toLocaleDateString('tr-TR');
            }

            function calculateSelectedTotal() {
                let totalAmount = 0;
                for (const cardCode in selectedRowsData) {
                    totalAmount += selectedRowsData[cardCode];
                }
                totalSelectedTlAmountSpan.textContent = totalAmount.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' TL';
            }

            function toggleRowSelection(rowElement, item) {
                const cardCode = item.MusteriKodu;
                const riskBakiye = (item.RBakiye || 0) + (item.XBakiye || 0);

                if (rowElement.classList.contains('selected-row')) {
                    rowElement.classList.remove('selected-row');
                    delete selectedRowsData[cardCode];
                } else {
                    rowElement.classList.add('selected-row');
                    selectedRowsData[cardCode] = riskBakiye;
                }
                calculateSelectedTotal();
            }

            function renderTable(data) {
                tableBody.innerHTML = '';
                const visibleHeaders = document.querySelectorAll('#rapor36Table thead .main-header-row th');
                const headerCount = visibleHeaders.length;

                if (data.length === 0) {
                    tableBody.innerHTML = `<tr><td colspan="${headerCount}" class="text-center">Gösterilecek veri bulunamadı.</td></tr>`;
                    updatePaginationInfo(0);
                    return;
                }

                const frag = document.createDocumentFragment();

                data.forEach(item => {
                    const row = document.createElement('tr');
                    const cardCode = item.MusteriKodu;
                    row.setAttribute('data-cardcode', cardCode);

                    if (selectedRowsData.hasOwnProperty(cardCode)) {
                        row.classList.add('selected-row');
                    }

                    row.addEventListener('click', function(event) {
                        if (!event.target.closest('.filter-input, .filter-select-bs, .bootstrap-select, .btn-note-operations')) {
                            toggleRowSelection(row, item);
                        }
                    });

                    visibleHeaders.forEach(header => {
                        const cell = document.createElement('td');
                        const columnKey = header.dataset.column;
                        const propName = columnMappings[columnKey];
                        
                        if (columnKey === 'NotIslemleri') {
                            cell.className = 'note-column';
                            const noteButton = document.createElement('button');
                            noteButton.className = `btn btn-sm ${item.CustomerNotes && item.CustomerNotes.length > 0 ? "btn-danger" : "btn-outline-secondary"} btn-note-operations`;
                            noteButton.dataset.cardcode = item.MusteriKodu; 
                            noteButton.title = item.CustomerNotes && item.CustomerNotes.length > 0 ? "Notları Görüntüle / Ekle" : "Not Ekle";
                            noteButton.innerHTML = `<i class="fas fa-comment"></i> ${item.CustomerNotes && item.CustomerNotes.length > 0 ? `(${item.CustomerNotes.length})` : ''}`;

                            noteButton.onclick = function(e) {
                                e.stopPropagation(); 
                                customerInfoH6.textContent = `${item.MusteriKodu} - ${item.MusteriFirmaAdi}`;
                                noteCardCodeInput.value = item.MusteriKodu;
                                newNoteContent.value = '';
                                renderNotes(item.CustomerNotes);
                                noteModal.show();
                            };
                            cell.appendChild(noteButton);
                        } 
                        else {
                            let value = propName ? item[propName] : null;

                            if (header.dataset.sortType === 'number') {
                                if (propName && typeof item[propName] === 'number') {
                                    if (columnKey.includes('GunSayisi')) {
                                        cell.textContent = formatNumber(value);
                                    } else {
                                        cell.textContent = formatCurrency(value);
                                    }
                                } else {
                                    cell.textContent = columnKey.includes('GunSayisi') ? '0' : '0,00';
                                }
                            } else {
                                cell.textContent = value || '';
                            }
                        }

                        row.appendChild(cell);
                    });

                    frag.appendChild(row);
                });

                tableBody.appendChild(frag);
                updatePaginationInfo(data.length);
                calculateSelectedTotal();
            }

            function filterTableAndRender() {
                const filters = {};
                const filterInputs = document.querySelectorAll('.filter-input');
                const filterSelects = $('.filter-select-bs');

                filterSelects.each(function () {
                    const selectElement = $(this);
                    const columnKey = selectElement.closest('th').data('column');
                    const selectedValues = selectElement.val();
                    if (selectedValues && selectedValues.length > 0) {
                        filters[columnKey] = selectedValues.map(v => (v || '').toLowerCase().trim());
                    }
                });

                filterInputs.forEach(input => {
                    const columnKey = input.closest('th').dataset.column;
                    const inputValue = input.value.toLowerCase().trim();
                    if (inputValue) {
                        filters[columnKey] = [inputValue];
                    }
                });

                let filteredData = allReportData.filter(item => {
                    let isMatch = true;
                    for (const column in filters) {
                        const filterValues = filters[column];
                        const propName = columnMappings[column];
                        let itemValue = item[propName];

                        if (itemValue === null || itemValue === undefined) {
                            itemValue = '';
                        }

                        const inputElement = document.querySelector(`.filter-row th[data-column="${column}"] .filter-input`);
                        const isNumericFilter = inputElement && inputElement.classList.contains('number-filter');
                        const isDateFilter = inputElement && inputElement.classList.contains('date-filter');

                        if (!isNumericFilter && !isDateFilter) {
                             const isMatchFound = filterValues.some(filterVal =>
                                 itemValue.toString().toLowerCase().includes(filterVal)
                             );
                            if (!isMatchFound) {
                                isMatch = false;
                                break;
                            }
                        }
                        else if (isDateFilter) {
                            const formattedDate = formatDate(itemValue).toLowerCase();
                            const filterValue = filterValues[0];
                            if (!formattedDate.includes(filterValue)) {
                                isMatch = false;
                                break;
                            }
                        }
                        else if (isNumericFilter) {
                            const filterValue = filterValues[0];
                            const numericFilterValue = parseFloat(filterValue.replace(/\./g, '').replace(',', '.'));
                            const itemNumericValue = parseFloat(itemValue.toString().replace(',', '.'));

                            if (isNaN(numericFilterValue)) {
                                if (filterValue !== "") {
                                    if (!itemValue.toString().toLowerCase().includes(filterValue)) {
                                        isMatch = false;
                                        break;
                                    }
                                }
                            } else {
                                if (Math.round(itemNumericValue * 100) !== Math.round(numericFilterValue * 100)) {
                                    isMatch = false;
                                    break;
                                }
                            }
                        }
                    }
                    return isMatch;
                });

                if (currentSortColumn && currentSortDirection !== 'none') {
                    const sortType = document.querySelector(`th[data-column="${currentSortColumn}"]`)?.dataset.sortType;
                    const propName = columnMappings[currentSortColumn];
                    filteredData.sort((itemA, itemB) => {
                        let valA = itemA[propName];
                        let valB = itemB[propName];

                        let comparison = 0;
                        if (sortType === 'number') {
                            valA = parseFloat(valA?.toString().replace(',', '.')) || 0;
                            valB = parseFloat(valB?.toString().replace(',', '.')) || 0;
                            comparison = valA - valB;
                        } else if (sortType === 'date') {
                            const dateA = valA ? new Date(valA) : new Date(0);
                            const dateB = valB ? new Date(valB) : new Date(0);
                            comparison = dateA.getTime() - dateB.getTime();
                        }
                         else {
                            comparison = (valA || '').localeCompare((valB || ''), 'tr', { sensitivity: 'base' });
                        }
                        return currentSortDirection === 'asc' ? comparison : -comparison;
                    });
                }

                currentlyFilteredRows = filteredData;
                renderTable(currentlyFilteredRows);
            }

            // Notu Düzenleme Moduna Alır
            window.startEdit = function(noteId, content) {
                currentEditingNoteId = noteId;
                newNoteContent.value = content;

                saveNoteButton.style.display = 'none';
                updateNoteButton.style.display = 'block';
                cancelEditButton.style.display = 'block';
                newNoteHeader.textContent = 'Not Düzenle';

                newNoteContent.focus();
            };

            // Düzenleme Modunu İptal Eder
            window.cancelEdit = function() {
                currentEditingNoteId = null;
                newNoteContent.value = '';

                saveNoteButton.style.display = 'block';
                updateNoteButton.style.display = 'none';
                cancelEditButton.style.display = 'none';
                newNoteHeader.textContent = 'Yeni Not Ekle';
            };

            // Not Silme İşlemi
            window.deleteNote = async function(noteId, cardCode) {
                if (!confirm('Bu notu silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.')) {
                    return;
                }

                try {
                    const response = await fetch('@Url.Action("DeleteNote", "Rapor36")' + dbQueryString, {
                        method: 'POST', 
                        headers: { 
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiForgeryToken
                        },
                        body: JSON.stringify({ NoteId: noteId })
                    });

                    if (response.ok) {
                        const result = await response.json();
                        toastr.success(result.message);

                        const customerData = allReportData.find(d => d.MusteriKodu === cardCode);
                        if (customerData) {
                            customerData.CustomerNotes = customerData.CustomerNotes.filter(n => n.NoteId !== noteId);
                            renderNotes(customerData.CustomerNotes);

                            const row = document.querySelector(`tr[data-cardcode="${cardCode}"]`);
                            if (row) {
                                const button = row.querySelector('.btn-note-operations');
                                if (button) {
                                    if (customerData.CustomerNotes.length === 0) {
                                        button.classList.remove('btn-danger');
                                        button.classList.add('btn-outline-secondary');
                                    }
                                    button.innerHTML = `<i class="fas fa-comment"></i> ${customerData.CustomerNotes.length > 0 ? `(${customerData.CustomerNotes.length})` : ''}`;
                                }
                            }
                        }

                    } else {
                        const errorText = await response.text();
                        toastr.error('Not silinemedi: ' + errorText);
                    }
                } catch (error) {
                    toastr.error('Bir hata oluştu: ' + error.message);
                }
            };

            // Notları modal içinde gösteren fonksiyon
            function renderNotes(notes) {
                existingNotesDiv.innerHTML = '';
                cancelEdit();

                if (notes && notes.length > 0) {
                    notes.sort((a, b) => new Date(b.EklemeTarihi) - new Date(a.EklemeTarihi));
                    notes.forEach(note => {
                        const noteElement = document.createElement('div');
                        noteElement.className = 'card mb-2 bg-light';
                        noteElement.dataset.noteid = note.NoteId;

                        const noteContent = note.KisaNot;
                        const noteContentHtml = noteContent.replace(/\n/g, '<br>');
                        const safeContentForJS = noteContent.replace(/'/g, "\\'").replace(/\n/g, '\\n').trim();

                        noteElement.innerHTML = `
                            <div class="card-body p-2">
                                <small class="text-muted float-end">
                                    ${note.KullaniciKodu} - ${formatDate(note.EklemeTarihi)}
                                </small>
                                <p class="card-text mb-2">${noteContentHtml}</p>
                                <div class="d-flex justify-content-end gap-1">
                                    <button type="button" class="btn btn-sm btn-info"
                                        onclick="startEdit(${note.NoteId}, '${safeContentForJS}')"
                                        title="Notu Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger"
                                        onclick="deleteNote(${note.NoteId}, '${note.CardCode}')"
                                        title="Notu Sil">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </div>
                        `;
                        existingNotesDiv.appendChild(noteElement);
                    });
                } else {
                    existingNotesDiv.innerHTML = '<p class="text-muted">Bu müşteri için kayıtlı not bulunmamaktadır.</p>';
                }
            }

            function initializePage() {
                $('.filter-select-bs').selectpicker({
                    liveSearch: true,
                    actionsBox: true,
                    selectedTextFormat: 'count > 2',
                    width: '100%',
                    container: 'body'
                }).on('changed.bs.select', function () {
                    filterTableAndRender();
                });

                document.querySelectorAll('.filter-input').forEach(input => {
                    if (input.classList.contains('number-filter') || input.classList.contains('date-filter')) {
                         input.addEventListener('keyup', (e) => {
                             if (e.key === 'Enter') {
                                 filterTableAndRender();
                             }
                         });
                    } else {
                        input.addEventListener('keyup', () => filterTableAndRender());
                    }
                });

                document.querySelectorAll('th.sortable-column').forEach(header => {
                    header.addEventListener('click', function () {
                        if (this.style.display === 'none' || this.classList.contains('no-sort')) {
                            return;
                        }

                        const columnKey = this.dataset.column;
                        let newSortDirection;

                        if (currentSortColumn === columnKey) {
                            if (currentSortDirection === 'asc') {
                                newSortDirection = 'desc';
                            } else if (currentSortDirection === 'desc') {
                                newSortDirection = 'none';
                                currentSortColumn = null; 
                            } else {
                                newSortDirection = 'asc';
                            }
                        } else {
                            if (currentSortColumn !== null) {
                                const prevHeader = document.querySelector(`th.sortable-column[data-column="${currentSortColumn}"] i`);
                                if (prevHeader) {
                                    prevHeader.className = 'fas fa-sort float-end';
                                }
                            }
                            newSortDirection = 'asc';
                            currentSortColumn = columnKey;
                        }

                        currentSortDirection = newSortDirection;

                        document.querySelectorAll('th.sortable-column i').forEach(icon => icon.className = 'fas fa-sort float-end');
                        const sortIcon = this.querySelector('i');
                        if (sortIcon && currentSortDirection !== 'none') {
                            sortIcon.className = `fas fa-sort-${currentSortDirection === 'asc' ? 'up' : 'down'} float-end`;
                        } else if (sortIcon && currentSortDirection === 'none') {
                            sortIcon.className = 'fas fa-sort float-end';
                        }

                        filterTableAndRender();
                    });
                });

                if (applyFilterBtn) {
                    applyFilterBtn.addEventListener('click', function() {
                        const selectedMonth = document.getElementById('monthFilter').value;
                        const currentUrl = new URL(window.location.href);
                        currentUrl.searchParams.set('monthFilter', selectedMonth);
                        
                        if (currentDbParam && !currentUrl.searchParams.has('db')) {
                            currentUrl.searchParams.set('db', currentDbParam);
                        }
                        window.location.href = currentUrl.toString();
                    });
                }

                // Not Güncelleme Butonuna Tıklama Olayı
                $('#updateNoteButton').on('click', async function(e) {
                    e.preventDefault();
                    const noteContent = newNoteContent.value.trim();
                    const noteId = currentEditingNoteId;
                    const cardCode = noteCardCodeInput.value;

                    if (!noteContent) { toastr.warning('Not içeriği boş olamaz.'); return; }
                    if (!noteId) return;

                    const button = $(this);
                    button.prop('disabled', true).text('Güncelleniyor...');

                    try {
                        const response = await fetch('@Url.Action("UpdateNote", "Rapor36")' + dbQueryString, {
                            method: 'POST', 
                            headers: { 
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': antiForgeryToken
                            },
                            body: JSON.stringify({ NoteId: noteId, Note: noteContent })
                        });

                        if (response.ok) {
                            const result = await response.json();
                            toastr.success(result.message);

                            const customerData = allReportData.find(d => d.MusteriKodu === cardCode);
                            if (customerData) {
                                const noteToUpdate = customerData.CustomerNotes.find(n => n.NoteId === noteId);

                                if (noteToUpdate) {
                                    noteToUpdate.KisaNot = noteContent;
                                    noteToUpdate.EklemeTarihi = new Date().toISOString();
                                    renderNotes(customerData.CustomerNotes);
                                    cancelEdit();
                                }
                            }
                        } else {
                            const errorText = await response.text();
                            toastr.error('Not güncellenemedi: ' + errorText);
                        }
                    } catch (error) {
                        toastr.error('Bir hata oluştu: ' + error.message);
                    } finally {
                        button.prop('disabled', false).text('Güncelle');
                    }
                });

                // Not Kaydetme Event'i
                addNoteForm.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    if (currentEditingNoteId) return;

                    const cardCode = noteCardCodeInput.value;
                    const noteContent = newNoteContent.value.trim();

                    if (!noteContent) { toastr.warning('Not içeriği boş olamaz.'); return; }

                    saveNoteButton.disabled = true;
                    saveNoteButton.textContent = 'Kaydediliyor...';

                    try {
                        const response = await fetch('@Url.Action("AddNote", "Rapor36")' + dbQueryString, {
                            method: 'POST', 
                            headers: { 
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': antiForgeryToken
                            },
                            body: JSON.stringify({ CardCode: cardCode, Note: noteContent })
                        });

                        if (response.ok) {
                            const result = await response.json();
                            toastr.success(result.message);

                            const customerData = allReportData.find(d => d.MusteriKodu === cardCode);
                            if (customerData) {
                                if (!customerData.CustomerNotes) customerData.CustomerNotes = [];
                                
                                customerData.CustomerNotes.push({
                                    NoteId: result.newNoteId,
                                    CardCode: cardCode,
                                    KisaNot: noteContent,
                                    KullaniciKodu: 'WEBUSER',
                                    EklemeTarihi: new Date().toISOString(),
                                    NotTarihi: new Date().toISOString()
                                });

                                renderNotes(customerData.CustomerNotes);

                                const row = document.querySelector(`tr[data-cardcode="${cardCode}"]`);
                                if (row) {
                                    const button = row.querySelector('.btn-note-operations');
                                    if (button) {
                                        button.classList.remove('btn-outline-secondary');
                                        button.classList.add('btn-danger');
                                        button.innerHTML = `<i class="fas fa-comment"></i> (${customerData.CustomerNotes.length})`;
                                    }
                                }
                            }
                            newNoteContent.value = '';

                        } else {
                            const errorText = await response.text();
                            toastr.error('Not kaydedilemedi: ' + errorText);
                        }
                    } catch (error) {
                        toastr.error('Bir hata oluştu: ' + error.message);
                    } finally {
                        saveNoteButton.disabled = false;
                        saveNoteButton.textContent = 'Kaydet';
                    }
                });

                renderTable(allReportData);
            }

            window.addEventListener('columnConfigUpdated', () => {
                filterTableAndRender();
                $('.filter-select-bs').selectpicker('refresh');
            });

            initializePage();
        });
    </script>
}