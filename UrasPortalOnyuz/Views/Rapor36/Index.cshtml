        }

        /* Tablo Konteyneri ve Stilleri */
        .table-container {
            overflow-x: auto;
            max-height: calc(100vh - 240px); /* Alt taraftaki ortak buton için alan optimize edildi */
            overflow-y: auto;
            position: relative;
            border-radius: 8px;
            box-shadow: var(--shadow-medium);
            background-color: var(--white-bg);
            border: 1px solid var(--border-color);
        }

        .rapor-tablo {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            table-layout: fixed;
            min-width: 1400px; 
        }

            .rapor-tablo thead {
                position: sticky;
