@{
    ViewData["Title"] = "Erişim Reddedildi";
    // Bu View için _Layout.cshtml kullanmak istiyorsanız, belirtin
    // Genellikle yetkisiz erişim sayfalarında ana layout kullanılır.
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center py-5">
    <h1 class="display-4 text-danger">Erişim Reddedildi!</h1>
    <p class="lead mt-4">Bu sayfayı görüntüleme yetkiniz bulunmamaktadır.</p>
    <p>Giriş bilgilerinizle ilgili bir sorun olduğunu düşünüyorsanız, lütfen sistem yöneticinizle iletişime geçin.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Ana Sayfaya Dön</a>
    <a asp-controller="Account" asp-action="Login" class="btn btn-secondary mt-3">Giriş Sayfası</a>
</div>

@section Scripts {
    @* Bu sayfaya özel JavaScript kodları buraya gelebilir. *@
    @* Örneğin, 5 saniye sonra giriş sayfasına otomatik yönlendirme: *@
    @* <script>
            setTimeout(function() {
                window.location.href = '@Url.Action("Login", "Account")';
            }, 5000);
        </script> *@
}