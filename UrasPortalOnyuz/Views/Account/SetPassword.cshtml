@model WebApplication3.Models.SetPasswordViewModel

@{
    ViewData["Title"] = "Şifre Oluştur / Güncelle";
    Layout = null;
    bool eskiSifreVar = ViewBag.HasExistingPassword == true;
}

<!DOCTYPE html>
<html lang="tr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Rapor Sistemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" href="~/images/HOLDING.png" type="image/png" />
    <link rel="stylesheet" href="~/css/auth-sifre.css" asp-append-version="true" />
</head>
<body>
    <div class="bg-gradient"></div>
    <canvas id="bgCanvas"></canvas>
    <div class="bg-grid"></div>

    <div class="page">
        <div class="card-x">
            <div class="card-top">
                <img src="~/images/HOLDING.png" alt="Uras Holding" />
                <button type="button" id="themeToggleBtn" class="theme-toggle-btn" title="Açık/Koyu Tema"><i class="fas fa-moon"></i></button>
            </div>
            <div class="head">
                <div class="ico"><i class="fas fa-key"></i></div>
                <h2>@(eskiSifreVar ? "Şifrenizi güncelleyin" : "Şifrenizi oluşturun")</h2>
                <p>@(eskiSifreVar ? "Güvenliğiniz için önce mevcut şifrenizi doğrulayın." : "Hesabınız için ilk şifrenizi belirleyin; sonrasında bu şifreyle giriş yapacaksınız.")</p>
            </div>

            <form asp-controller="Account" asp-action="SetPassword" method="post" id="sifreForm">
                @Html.AntiForgeryToken()

                @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success"><i class="fas fa-check-circle mt-1"></i><div>@TempData["SuccessMessage"]</div></div> }
                @if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger"><i class="fas fa-exclamation-triangle mt-1"></i><div>@TempData["ErrorMessage"]</div></div> }

                <div class="field">
                    <label asp-for="UserCode" class="form-label">Kullanıcı Kodu</label>
                    <div class="input-shell readonly"><span class="ico"><i class="fas fa-user"></i></span><input asp-for="UserCode" class="form-control" readonly /></div>
                    <span asp-validation-for="UserCode" class="text-danger"></span>
                </div>

                @if (eskiSifreVar)
                {
                    <div class="field">
                        <label asp-for="OldPassword" class="form-label">Mevcut Şifre</label>
                        <div class="input-shell"><span class="ico"><i class="fas fa-lock"></i></span><input asp-for="OldPassword" class="form-control" type="password" placeholder="Mevcut şifreniz" autocomplete="current-password" /><button type="button" class="eye" data-goz><i class="fas fa-eye"></i></button></div>
                        <span asp-validation-for="OldPassword" class="text-danger"></span>
                    </div>
                }

                <div class="field">
                    <label asp-for="NewPassword" class="form-label">Yeni Şifre</label>
                    <div class="input-shell"><span class="ico"><i class="fas fa-shield-halved"></i></span><input asp-for="NewPassword" class="form-control" type="password" id="yeniSifre" placeholder="Yeni şifre" autocomplete="new-password" /><button type="button" class="eye" data-goz><i class="fas fa-eye"></i></button></div>
                    <div class="guc"><div class="guc-bar"><i id="gucBar"></i></div><div class="guc-txt"><span id="gucTxt">Şifre gücü</span><span id="gucPuan"></span></div></div>
                    <div class="kurallar"><span class="kural" data-k="uzun">8+ karakter</span><span class="kural" data-k="buyuk">Büyük harf</span><span class="kural" data-k="kucuk">Küçük harf</span><span class="kural" data-k="rakam">Rakam</span><span class="kural" data-k="ozel">Özel karakter</span></div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="field">
                    <label asp-for="ConfirmPassword" class="form-label">Yeni Şifre (Tekrar)</label>
                    <div class="input-shell"><span class="ico"><i class="fas fa-check-double"></i></span><input asp-for="ConfirmPassword" class="form-control" type="password" id="sifreTekrar" placeholder="Yeni şifreyi tekrar yazın" autocomplete="new-password" /><button type="button" class="eye" data-goz><i class="fas fa-eye"></i></button></div>
                    <div class="eslesme" id="eslesme"></div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-x" id="btnKaydet"><i class="fas fa-circle-notch fa-spin spin"></i><span>Şifreyi Kaydet</span><i class="fas fa-arrow-right"></i></button>
                <div asp-validation-summary="All" class="validation-summary-errors" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>
            </form>

            <a asp-action="Login" asp-controller="Account" class="back"><i class="fas fa-arrow-left"></i> Giriş sayfasına dön</a>
            <div class="card-foot"><span><i class="fas fa-lock me-1" style="color:var(--success)"></i>Güvenli bağlantı</span><span>© @DateTime.Now.Year Uras Holding</span></div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/auth-sifre.js" asp-append-version="true"></script>
</body>
</html>
