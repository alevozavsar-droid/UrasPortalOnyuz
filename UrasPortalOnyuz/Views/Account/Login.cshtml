@model WebApplication3.Models.LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap | Rapor Sistemi";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" href="~/images/HOLDING.png" type="image/png" />

    <link rel="stylesheet" href="~/css/auth-giris.css" asp-append-version="true" />
</head>
<body>

    @* Zemin (referans): portal bu görünümün birebir kopyasını css/aurora.css ile kullanır *@
    <div class="bg-gradient"></div>
    <canvas id="bgCanvas"></canvas>
    <div class="bg-grid"></div>
    <div class="bg-noise"></div>

    <div class="page">
        <!-- SOL: MARKA -->
        <section class="brand">
            <div class="brand-logo">
                <img src="~/images/HOLDING.png" alt="Uras Holding" />
                <span>URAS HOLDİNG · RAPOR SİSTEMİ</span>
            </div>
            <h1>Tüm şirketleriniz,<br><span class="accent">tek ekranda</span> yönetimde.</h1>
            <p class="lead-text">Finans, muhasebe, satın alma ve üretim süreçlerini SAP ile bütünleşik, güvenli ve hızlı biçimde takip edin.</p>

            <div class="slides" id="slides">
                <div class="slide active">
                    <div class="slide-icon"><i class="fas fa-chart-line"></i></div>
                    <div><div class="slide-title">Canlı finansal görünüm</div><div class="slide-text">Cari ekstre, adat ve vade farkı, nakit akışı — anlık SAP verisiyle.</div></div>
                </div>
                <div class="slide">
                    <div class="slide-icon"><i class="fas fa-money-check-alt"></i></div>
                    <div><div class="slide-title">Çek ve tahsilat yönetimi</div><div class="slide-text">İbraz, vadeli çek ibrazı ve onay akışları tek noktadan.</div></div>
                </div>
                <div class="slide">
                    <div class="slide-icon"><i class="fas fa-industry"></i></div>
                    <div><div class="slide-title">Üretim ve stok takibi</div><div class="slide-text">Üretim siparişleri, sayım, bakım ve kalite süreçleri.</div></div>
                </div>
                <div class="slide">
                    <div class="slide-icon"><i class="fas fa-shield-halved"></i></div>
                    <div><div class="slide-title">Yetki bazlı güvenli erişim</div><div class="slide-text">Kişi ve rol bazında ekran yetkileri, izlenebilir işlemler.</div></div>
                </div>
            </div>
            <div class="dots" id="dots">
                <div class="dot active"><i></i></div><div class="dot"><i></i></div><div class="dot"><i></i></div><div class="dot"><i></i></div>
            </div>

            <div class="stats">
                <div class="stat"><b>30+</b><span>şirket veritabanı</span></div>
                <div class="stat"><b>150+</b><span>rapor ve işlem ekranı</span></div>
                <div class="stat"><b>7/24</b><span>SAP ile bütünleşik</span></div>
            </div>
        </section>

        <!-- SAĞ: GİRİŞ KARTI -->
        <div class="card-wrap">
            <div class="login-card">
                <div class="card-top">
                    <div class="mini-logo"><img src="~/images/HOLDING.png" alt="Uras Holding" /></div>
                    <button type="button" id="themeToggleBtn" class="theme-toggle-btn" title="Açık/Koyu Tema"><i class="fas fa-moon"></i></button>
                </div>

                <div class="form-header">
                    <h2>Hoş geldiniz</h2>
                    <p>Devam etmek için kullanıcı bilgilerinizi girin.</p>
                </div>

                @* returnUrl form'a taşınır: e-postadaki "Gider Onay ekranını aç" gibi bağlantılar
                   giriş sonrası dashboard'a değil, istenen sayfaya dönsün. *@
                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" id="loginForm" novalidate>
                    @Html.AntiForgeryToken()

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success"><i class="fas fa-check-circle"></i><div>@TempData["SuccessMessage"]</div></div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i><div>@TempData["ErrorMessage"]</div></div>
                    }

                    <div class="field">
                        <label asp-for="UserCode" class="form-label">Kullanıcı Kodu</label>
                        <div class="input-shell">
                            <span class="ico"><i class="fas fa-user"></i></span>
                            <input asp-for="UserCode" class="form-control" placeholder="Örn: it02" id="userCodeInput" autocomplete="username" autocapitalize="off" spellcheck="false" autofocus />
                        </div>
                        <span asp-validation-for="UserCode" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Password" class="form-label">Şifre</label>
                        <div class="input-shell">
                            <span class="ico"><i class="fas fa-lock"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" type="password" id="passwordInput" autocomplete="current-password" />
                            <button type="button" class="eye" id="togglePassword" title="Şifreyi göster/gizle"><i class="fas fa-eye"></i></button>
                        </div>
                        <div class="caps-hint" id="capsHint"><i class="fas fa-triangle-exclamation me-1"></i>Caps Lock açık</div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="row-between">
                        <div class="form-check">
                            <input type="checkbox" asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                            <label class="form-check-label" asp-for="RememberMe" for="rememberMeCheck">Beni hatırla</label>
                        </div>
                        <a id="changePasswordLink" asp-action="SetPassword" asp-controller="Account" class="forgot-password-link">Şifremi değiştir</a>
                    </div>

                    <button type="submit" class="btn-login" id="btnLogin">
                        <i class="fas fa-circle-notch fa-spin spin"></i>
                        <span>Giriş Yap</span>
                        <i class="fas fa-arrow-right arrow"></i>
                    </button>

                    <div asp-validation-summary="All" class="validation-summary-errors" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>
                </form>

                <div class="card-foot">
                    <span class="secure"><i class="fas fa-lock"></i> Güvenli bağlantı</span>
                    <span>© @DateTime.Now.Year Uras Holding</span>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script src="~/js/auth-giris.js" asp-append-version="true"></script>
    <script>
        // Giris sayfasina gelindiginde (yeni oturum / cikis) onceki oturumdan
        // kalan acik sekmeler temizlenir; giristen sonra kabuk sifirdan baslar.
        try { localStorage.removeItem('portalSekmeler'); } catch (e) { }
    </script>
</body>
</html>
