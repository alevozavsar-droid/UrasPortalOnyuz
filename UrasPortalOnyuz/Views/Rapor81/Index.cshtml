@model WebApplication3.Models.Rapor81DashboardViewModel
@{
    ViewData["Title"] = "Detaylı Şirket Kokpiti";
    var aylar = new[] { "", "Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık" };
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    /* Dashboard Özel Stilleri */
    .dash-card { border-radius: 12px; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: transform 0.2s; background: white; }
    .dash-card:hover { transform: translateY(-2px); }
    .icon-box { width: 48px; height: 48px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 22px; }
    
    .bg-gradient-primary { background: linear-gradient(45deg, #4e73df, #224abe); color: white; }
    .bg-gradient-success { background: linear-gradient(45deg, #1cc88a, #13855c); color: white; }
    .bg-gradient-warning { background: linear-gradient(45deg, #f6c23e, #dda20a); color: white; }
    .bg-gradient-info { background: linear-gradient(45deg, #36b9cc, #258391); color: white; }
    
    .table-custom th { background-color: #fff; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; color: #858796; border-bottom: 2px solid #e3e6f0; position: sticky; top: 0; z-index: 10; }
    .table-custom td { vertical-align: middle; font-size: 13px; color: #5a5c69; }
    
    .badge-soft-success { background-color: #e6f9ed; color: #28a745; padding: 4px 8px; border-radius: 20px; font-weight: 600;}
    .badge-soft-danger { background-color: #fceceb; color: #dc3545; padding: 4px 8px; border-radius: 20px; font-weight: 600;}
    .badge-soft-warning { background-color: #fff8e6; color: #ffc107; padding: 4px 8px; border-radius: 20px; font-weight: 600;}

    .hidden-row { display: none !important; }
    .view-more-btn { width: 100%; border: none; background: #f8f9fa; color: #4e73df; font-weight: bold; padding: 10px; border-radius: 0 0 12px 12px; transition: 0.2s; }
    .view-more-btn:hover { background: #eaecf4; }
    .expand-btn { cursor: pointer; color: #b7b9cc; transition: 0.2s; }
    .expand-btn:hover { color: #4e73df; }
    
    .fullscreen-card { position: fixed !important; top: 0; left: 0; width: 100%; height: 100%; /* zoom: vw/vh yerine % */ z-index: 9999; border-radius: 0; overflow-y: auto; margin: 0; padding: 20px; box-shadow: none; background-color: #f8f9fa;}
    .fullscreen-card .dash-table-container { max-height: calc(100vh - 160px) !important; overflow-y: auto; }
    
    .filter-bar { background-color: #f8f9fc; border-bottom: 1px solid #e3e6f0; padding: 10px 15px; }
    .btn-filter { font-weight: 600; border-radius: 20px; font-size: 12px; padding: 5px 15px; transition: all 0.2s; }

    .month-cell { min-width: 90px; text-align: center; }
    .yoy-badge { font-size: 10px; padding: 2px 4px; border-radius: 4px; font-weight: bold; display: inline-block; margin-top: 4px;}
</style>

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h4 mb-0 text-gray-800 fw-bold"><i class="fas fa-building me-2 text-primary"></i> @ViewBag.CurrentDbDisplay Ciro & Maliyet Analizi</h2>
        <form method="get" class="d-flex align-items-center" id="dbForm">
            <label class="me-2 fw-bold text-muted mb-0">Şirket Seçin:</label>
            <select name="db" id="dbSelector" class="form-select shadow-sm fw-bold text-primary" style="width: 220px; border-color:#4e73df; background-color:#f1f4fb;" onchange="this.form.submit()">
                @foreach (var db in ViewBag.Databases)
                {
                    if (db.Display == ViewBag.CurrentDbDisplay)
                    {
                        <option value="@db.Key" selected>🏢 @db.Display</option>
                    }
                    else
                    {
                        <option value="@db.Key">@db.Display</option>
                    }
                }
            </select>
        </form>
    </div>

    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card dash-card h-100 py-2 border-start border-4 border-primary">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col me-2">
                            <div class="text-xs fw-bold text-primary text-uppercase mb-1">Bu Ay Net Ciro</div>
                            <div class="h4 mb-0 fw-bold text-gray-800">@Model.ManagerSummary.CurrMonthSales.ToString("N0") ₺</div>
                            <small class="@(Model.ManagerSummary.MoMPercentage >= 0 ? "text-success" : "text-danger") fw-bold mt-1 d-block">
                                <i class="fas @(Model.ManagerSummary.MoMPercentage >= 0 ? "fa-arrow-up" : "fa-arrow-down")"></i>
                                %@Math.Abs(Model.ManagerSummary.MoMPercentage).ToString("N1") (Geçen Aya Göre)
                            </small>
                        </div>
                        <div class="col-auto"><div class="icon-box bg-gradient-primary"><i class="fas fa-calendar-alt"></i></div></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card dash-card h-100 py-2 border-start border-4 border-success">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col me-2">
                            <div class="text-xs fw-bold text-success text-uppercase mb-1">Yıllık Ciro (YoY)</div>
                            <div class="h4 mb-0 fw-bold text-gray-800">@Model.ManagerSummary.CurrYearSales.ToString("N0") ₺</div>
                            <small class="@(Model.ManagerSummary.YoYPercentage >= 0 ? "text-success" : "text-danger") fw-bold mt-1 d-block">
                                <i class="fas @(Model.ManagerSummary.YoYPercentage >= 0 ? "fa-arrow-up" : "fa-arrow-down")"></i>
                                %@Math.Abs(Model.ManagerSummary.YoYPercentage).ToString("N1") (Geçen Yıla Göre)
                            </small>
                        </div>
                        <div class="col-auto"><div class="icon-box bg-gradient-success"><i class="fas fa-chart-line"></i></div></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card dash-card h-100 py-2 border-start border-4 border-warning">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col me-2">
                            <div class="text-xs fw-bold text-warning text-uppercase mb-1">Şirket Kârı</div>
                            <div class="h4 mb-0 fw-bold text-gray-800">@Model.ManagerSummary.CurrYearProfit.ToString("N0") ₺</div>
                            <div class="progress mt-2" style="height: 4px;">
                                <div class="progress-bar bg-warning" style="width: @Model.ManagerSummary.ProfitMargin.ToString("0")%"></div>
                            </div>
                        </div>
                        <div class="col-auto"><div class="icon-box bg-gradient-warning"><i class="fas fa-coins"></i></div></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card dash-card h-100 py-2 border-start border-4 border-info">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col me-2">
                            <div class="text-xs fw-bold text-info text-uppercase mb-1">Ortalama Kâr Marjı</div>
                            <div class="h4 mb-0 fw-bold text-gray-800">%@Model.ManagerSummary.ProfitMargin.ToString("N1")</div>
                            <small class="text-muted mt-1 d-block">Şirketin Genel Kârlılığı</small>
                        </div>
                        <div class="col-auto"><div class="icon-box bg-gradient-info"><i class="fas fa-percentage"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-8">
            <div class="card dash-card h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold text-primary"><i class="fas fa-chart-area me-2"></i>Aylık Büyüme Trendi</h6>
                    <i class="fas fa-expand expand-btn" onclick="toggleCardFullscreen(this)" title="Büyüt"></i>
                </div>
                <div class="card-body dash-table-container">
                    <canvas id="trendChart" style="min-height:250px;"></canvas>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card dash-card h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold text-primary"><i class="fas fa-chart-pie me-2"></i>Kategori Dağılımı</h6>
                    <i class="fas fa-expand expand-btn" onclick="toggleCardFullscreen(this)" title="Büyüt"></i>
                </div>
                <div class="card-body d-flex justify-content-center align-items-center dash-table-container">
                    <canvas id="categoryChart" style="min-height:250px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card dash-card h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="m-0 fw-bold text-primary"><i class="fas fa-box-open me-2"></i>Ürün Kârlılık Analizi</h6>
                        <small class="text-muted">Aşağıdaki hızlı filtreleri kullanarak riskli veya yüksek hacimli ürünleri anında bulabilirsiniz.</small>
                    </div>
                    <i class="fas fa-expand expand-btn" onclick="toggleCardFullscreen(this)" title="Büyüt"></i>
                </div>
                
                <div class="filter-bar d-flex flex-wrap gap-2 align-items-center">
                    <span class="text-muted fw-bold me-2"><i class="fas fa-filter"></i> Hızlı Filtre:</span>
                    <button class="btn btn-dark btn-filter prod-filter-btn" onclick="applyFilter('prod', 'all', this)">Tümü</button>
                    <button class="btn btn-outline-danger btn-filter prod-filter-btn" onclick="applyFilter('prod', 'risk', this)">🚨 Kâr < %20</button>
                    <button class="btn btn-outline-success btn-filter prod-filter-btn" onclick="applyFilter('prod', 'volume', this)">💎 Ciro > 10.000 ₺</button>
                    <button class="btn btn-outline-warning text-dark btn-filter prod-filter-btn" onclick="applyFilter('prod', 'risk_volume', this)">⚠️ Kâr < %20 VE Ciro > 10.000 ₺</button>
                </div>

                <div class="card-body p-0 dash-table-container">
                    <div class="table-responsive">
                        <table class="table table-hover table-custom mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Ürün</th>
                                    <th class="text-center">Satılan Miktar</th>
                                    <th class="text-center" style="width: 180px;">Net Satış Detayı</th>
                                    <th class="text-center">Gerçek Kâr Marjı</th>
                                    <th class="text-center" style="width: 180px;">Maliyet Detayı</th>
                                    <th class="text-center">Stok Durumu</th>
                                </tr>
                            </thead>
                            <tbody id="prodTableBody">
                                @{ int pIndex = 0; }
                                @foreach (var item in Model.AllProducts)
                                {
                                    <tr class="prod-row-item @(pIndex >= 10 ? "hidden-row prod-row" : "prod-row")" 
                                        data-margin="@item.ProfitMargin.ToString(System.Globalization.CultureInfo.InvariantCulture)" 
                                        data-sales="@item.NetSales.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                        <td>
                                            <div class="fw-bold text-dark">@item.ItemCode</div>
                                            <div class="text-muted small text-truncate" style="max-width: 350px;" title="@item.ItemName">@item.ItemName</div>
                                        </td>
                                        <td class="text-center fw-bold text-dark">@item.NetQty.ToString("N0")</td>
                                        
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-primary w-100 rounded-pill fw-bold shadow-sm" 
                                                    onclick="openSalesModal('@item.ItemCode', '@Html.Raw(item.ItemName.Replace("'", "\\'"))', @item.UnitCost.ToString(System.Globalization.CultureInfo.InvariantCulture))" 
                                                    title="Kime, Ne Kadara Satıldı?">
                                                @item.NetSales.ToString("N0") ₺ <i class="fas fa-search-dollar ms-1"></i>
                                            </button>
                                        </td>

                                        <td class="text-center">
                                            <span class="badge @(item.ProfitMargin > 30 ? "bg-success" : (item.ProfitMargin < 20 ? "bg-danger" : "bg-warning text-dark")) px-3 py-2 fs-6 shadow-sm">
                                                %@item.ProfitMargin.ToString("N1")
                                            </span>
                                        </td>

                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-secondary w-100 rounded-pill fw-bold shadow-sm" onclick="openCostModal('@item.ItemCode')" title="Rapor 7C Ürün Ağacı (BOM) Simülasyonu">
                                                @item.UnitCost.ToString("N2") ₺ <i class="fas fa-sitemap ms-1"></i>
                                            </button>
                                        </td>

                                        <td class="text-center">
                                            <span class="@(item.StockStatus == "İyi" ? "badge-soft-success" : (item.StockStatus == "Şişkin" ? "badge-soft-warning" : "badge-soft-danger"))">
                                                @item.StockStatus (@item.CurrentStock.ToString("N0"))
                                            </span>
                                        </td>
                                    </tr>
                                    pIndex++;
                                }
                            </tbody>
                        </table>
                    </div>
                    <button id="btnViewMoreProd" class="view-more-btn" onclick="toggleRows('prod-row', this)" style="display: @(Model.AllProducts.Count > 10 ? "block" : "none");">Tüm Ürünleri Gör <i class="fas fa-chevron-down ms-1"></i></button>
                    <div id="prodEmptyState" class="text-center p-4 text-muted fw-bold d-none">
                        <i class="fas fa-check-circle text-success fs-3 mb-2 d-block"></i> Bu kritere uyan riskli/yüksek hacimli ürün bulunmamaktadır.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card dash-card h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="m-0 fw-bold text-primary"><i class="fas fa-users-cog me-2"></i>Satış Temsilcisi Performans Kıyaslaması (Aylık Büyüme - YoY)</h6>
                        <small class="text-muted">Ayların altındaki yüzdeler, geçen yılın aynı ayına göre yaşanan büyümeyi/küçülmeyi ifade eder.</small>
                    </div>
                    <i class="fas fa-expand expand-btn" onclick="toggleCardFullscreen(this)" title="Büyüt"></i>
                </div>

                <div class="card-body p-0 dash-table-container">
                    <div class="table-responsive">
                        <table class="table table-hover table-custom mb-0 align-middle text-nowrap">
                            <thead>
                                <tr>
                                    <th style="min-width: 150px; position: sticky; left: 0; background: #fff; z-index: 11; box-shadow: 2px 0 5px -2px rgba(0,0,0,0.1);">Personel</th>
                                    <th class="text-center bg-light">Bu Yıl Toplam</th>
                                    <th class="text-center bg-light">Geçen Yıl Toplam</th>
                                    <th class="text-center border-end bg-light">Değişim</th>
                                    @for(int i=1; i<=12; i++) {
                                        <th class="text-center">@aylar[i]</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rIndex = 0; }
                                @foreach (var rep in Model.SalesReps)
                                {
                                    <tr class="@(rIndex >= 5 ? "hidden-row rep-row" : "rep-row")">
                                        <td class="fw-bold text-dark" style="position: sticky; left: 0; background: #fff; z-index: 1; box-shadow: 2px 0 5px -2px rgba(0,0,0,0.1);">@rep.SlpName</td>
                                        <td class="text-end fw-bold text-primary bg-light">@rep.CurrTotal.ToString("N0") ₺</td>
                                        <td class="text-end text-muted bg-light">@rep.PrevTotal.ToString("N0") ₺</td>
                                        <td class="text-center border-end bg-light">
                                            <span class="badge @(rep.YoY >= 0 ? "bg-success" : "bg-danger") px-2">
                                                <i class="fas fa-arrow-@(rep.YoY >= 0 ? "up" : "down")"></i> %@Math.Abs(rep.YoY).ToString("N1")
                                            </span>
                                        </td>
                                        
                                        @for(int m=1; m<=12; m++) {
                                            decimal currM = rep.CurrMonths[m];
                                            decimal prevM = rep.PrevMonths[m];
                                            decimal diffM = prevM == 0 ? (currM > 0 ? 100 : 0) : ((currM - prevM) / Math.Abs(prevM)) * 100;
                                            
                                            <td class="month-cell">
                                                <div class="fw-bold @(currM > 0 ? "text-dark" : "text-muted")">@currM.ToString("N0") ₺</div>
                                                @if(currM > 0 || prevM > 0) {
                                                    <div class="yoy-badge text-@(diffM >= 0 ? "success" : "danger")" style="background-color: @(diffM >= 0 ? "#e6f9ed" : "#fceceb");">
                                                        <i class="fas fa-@(diffM >= 0 ? "caret-up" : "caret-down")"></i> %@Math.Abs(diffM).ToString("N0")
                                                    </div>
                                                } else {
                                                    <div class="yoy-badge text-muted">-</div>
                                                }
                                            </td>
                                        }
                                    </tr>
                                    rIndex++;
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.SalesReps.Count > 5)
                    {
                        <button class="view-more-btn" onclick="toggleRows('rep-row', this)">Tüm Temsilcileri Gör <i class="fas fa-chevron-down ms-1"></i></button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 mb-4">
            <div class="card dash-card h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="m-0 fw-bold text-primary"><i class="fas fa-handshake me-2"></i>Müşteri Kârlılık & Ciro Listesi</h6>
                    </div>
                    <i class="fas fa-expand expand-btn" onclick="toggleCardFullscreen(this)" title="Büyüt"></i>
                </div>

                <div class="filter-bar d-flex flex-wrap gap-2 align-items-center">
                    <span class="text-muted fw-bold me-2"><i class="fas fa-filter"></i> Hızlı Filtre:</span>
                    <button class="btn btn-dark btn-filter cust-filter-btn" onclick="applyFilter('cust', 'all', this)">Tümü</button>
                    <button class="btn btn-outline-danger btn-filter cust-filter-btn" onclick="applyFilter('cust', 'risk', this)">🚨 Kâr < %20</button>
                    <button class="btn btn-outline-success btn-filter cust-filter-btn" onclick="applyFilter('cust', 'volume', this)">💎 Ciro > 10.000 ₺</button>
                </div>

                <div class="card-body p-0 dash-table-container">
                    <div class="table-responsive">
                        <table class="table table-hover table-custom mb-0">
                            <thead>
                                <tr>
                                    <th>Müşteri</th>
                                    <th class="text-center">İşlem Hacmi (Fatura Ayı)</th>
                                    <th class="text-center">Kâr Marjı</th>
                                    <th class="text-end">Net Ciro</th>
                                </tr>
                            </thead>
                            <tbody id="custTableBody">
                                @{ int cIndex = 0; }
                                @foreach (var cust in Model.AllCustomers)
                                {
                                    <tr class="cust-row-item @(cIndex >= 10 ? "hidden-row cust-row" : "cust-row")"
                                        data-margin="@cust.ProfitMargin.ToString(System.Globalization.CultureInfo.InvariantCulture)" 
                                        data-sales="@cust.TotalSales.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                        <td>
                                            <div class="fw-bold text-dark">@cust.CardCode</div>
                                            <div class="text-muted small text-truncate" style="max-width: 400px;" title="@cust.CardName">@cust.CardName</div>
                                        </td>
                                        <td class="text-center"><span class="badge bg-dark rounded-pill px-3">@cust.InvoiceCount</span></td>
                                        <td class="text-center">
                                            <span class="badge @(cust.ProfitMargin > 30 ? "bg-success" : (cust.ProfitMargin < 20 ? "bg-danger" : "bg-warning text-dark")) px-3 py-2 shadow-sm">
                                                %@cust.ProfitMargin.ToString("N1")
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold text-primary">@cust.TotalSales.ToString("N0") ₺</td>
                                    </tr>
                                    cIndex++;
                                }
                            </tbody>
                        </table>
                    </div>
                    <button id="btnViewMoreCust" class="view-more-btn" onclick="toggleRows('cust-row', this)" style="display: @(Model.AllCustomers.Count > 10 ? "block" : "none");">Tüm Müşterileri Gör <i class="fas fa-chevron-down ms-1"></i></button>
                    <div id="custEmptyState" class="text-center p-4 text-muted fw-bold d-none">
                        <i class="fas fa-check-circle text-success fs-3 mb-2 d-block"></i> Kriterlere uyan müşteri bulunmamaktadır.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="costModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header bg-secondary text-white">
        <h5 class="modal-title fw-bold"><i class="fas fa-sitemap me-2"></i> Ürün Ağacı (BOM) Maliyet Simülasyonu</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0">
        <iframe id="costDetailIframe" src="" style="width: 100%; height: 75vh; border: none;"></iframe>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="salesModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title fw-bold" id="salesModalTitle"><i class="fas fa-search-dollar me-2"></i> Satış Detayları</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 bg-light" id="salesModalBody">
      </div>
    </div>
  </div>
</div>

<script>
    // Büyütme (Fullscreen) Metodu (İsim değiştirildi ki Layout'taki ile çakışmasın)
    function toggleCardFullscreen(btn) {
        var card = btn.closest('.card');
        card.classList.toggle('fullscreen-card');
        if (card.classList.contains('fullscreen-card')) {
            btn.classList.replace('fa-expand', 'fa-compress');
            btn.style.color = '#e74a3b';
        } else {
            btn.classList.replace('fa-compress', 'fa-expand');
            btn.style.color = '#b7b9cc';
        }
    }

    // Klasik "Devamını Gör" Metodu
    function toggleRows(rowClass, btn) {
        var rows = document.querySelectorAll('.' + rowClass);
        var isHidden = rows[0].classList.contains('hidden-row');
        rows.forEach(r => isHidden ? r.classList.remove('hidden-row') : r.classList.add('hidden-row'));
        btn.innerHTML = isHidden ? 'Daha Az Göster <i class="fas fa-chevron-up ms-1"></i>' : 'Tümünü Gör <i class="fas fa-chevron-down ms-1"></i>';
    }

    // HIZLI FİLTRELEME METODU
    function applyFilter(tableType, filterType, btnElement) {
        var buttons = btnElement.parentElement.querySelectorAll('.btn-filter');
        buttons.forEach(b => {
            b.className = 'btn btn-filter ' + tableType + '-filter-btn ' + (b.innerText.includes('Tümü') ? 'btn-outline-dark' : 
                          b.innerText.includes('🚨') ? 'btn-outline-danger' : 
                          b.innerText.includes('💎') ? 'btn-outline-success' : 'btn-outline-warning text-dark');
        });
        
        if(filterType === 'all') btnElement.className = 'btn btn-dark btn-filter';
        else if(filterType === 'risk') btnElement.className = 'btn btn-danger text-white btn-filter';
        else if(filterType === 'volume') btnElement.className = 'btn btn-success text-white btn-filter';
        else if(filterType === 'risk_volume') btnElement.className = 'btn btn-warning text-dark btn-filter';

        var rows = document.querySelectorAll('.' + tableType + '-row-item');
        var viewMoreBtn = document.getElementById('btnViewMore' + (tableType === 'prod' ? 'Prod' : 'Cust'));
        var emptyState = document.getElementById(tableType + 'EmptyState');
        var visibleCount = 0;

        rows.forEach(function(row) {
            var margin = parseFloat(row.getAttribute('data-margin'));
            var sales = parseFloat(row.getAttribute('data-sales'));
            var show = false;

            if (filterType === 'all') show = true;
            else if (filterType === 'risk') show = margin < 20;
            else if (filterType === 'volume') show = sales > 10000;
            else if (filterType === 'risk_volume') show = margin < 20 && sales > 10000;

            if (show) {
                row.classList.remove('d-none');
                if (filterType !== 'all') {
                    row.classList.remove('hidden-row');
                } else {
                    if(visibleCount >= 10 && viewMoreBtn.innerText.includes('Tümünü')) {
                        row.classList.add('hidden-row');
                    }
                }
                visibleCount++;
            } else {
                row.classList.add('d-none');
            }
        });

        if (viewMoreBtn) viewMoreBtn.style.display = (filterType === 'all' && rows.length > 10) ? 'block' : 'none';
        if (emptyState) {
            if(visibleCount === 0) {
                emptyState.classList.remove('d-none');
                document.getElementById(tableType + 'TableBody').parentElement.style.display = 'none';
            } else {
                emptyState.classList.add('d-none');
                document.getElementById(tableType + 'TableBody').parentElement.style.display = 'table';
            }
        }
    }

    // Modal 1: Maliyet (Bootstrap 5 API kullanılarak JS ile açılış garantilendi)
    function openCostModal(itemCode) {
        var dbKey = document.getElementById('dbSelector').value;
        document.getElementById('costDetailIframe').src = '/Rapor7c?itemCode=' + encodeURIComponent(itemCode) + '&db=' + encodeURIComponent(dbKey);
        var myModal = new bootstrap.Modal(document.getElementById('costModal'));
        myModal.show();
    }

    // Modal 2: API'den Satış Detayı Çekici
    function openSalesModal(itemCode, itemName, unitCost) {
        document.getElementById('salesModalTitle').innerHTML = '<i class="fas fa-file-invoice me-2"></i> ' + itemCode + ' - ' + itemName;
        document.getElementById('salesModalBody').innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><div class="mt-2 text-muted fw-bold">Yıl İçi Satış ve İade Kayıtları Çekiliyor...</div></div>';
        
        var dbKey = document.getElementById('dbSelector').value;
        var myModal = new bootstrap.Modal(document.getElementById('salesModal'));
        myModal.show();

        fetch('/Rapor81/GetProductSalesApi?itemCode=' + encodeURIComponent(itemCode) + '&db=' + encodeURIComponent(dbKey))
            .then(response => response.json())
            .then(res => {
                if(res.success) {
                    var html = '<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover table-custom mb-0"><thead><tr><th>Tarih</th><th>Şirket</th><th>Evrak No</th><th>İşlem Tipi</th><th>Müşteri Bilgisi</th><th class="text-center">Miktar</th><th class="text-end">Birim Fiyat</th><th class="text-end">Net Tutar (₺)</th><th class="text-center">İşlem Kârı (Simüle)</th></tr></thead><tbody>';
                    
                    var tQty = 0, tCiro = 0;
                    if(res.data.length === 0) {
                        html += '<tr><td colspan="9" class="text-center py-4 text-muted">Bu ürüne ait satış faturası bulunamadı.</td></tr>';
                    }

                    res.data.forEach(function(d) {
                        var isReturn = d.docType === 'İade';
                        var rowColor = isReturn ? 'table-danger' : '';
                        var badgeColor = isReturn ? 'bg-danger' : 'bg-primary';

                        var marginHtml = '';
                        if (isReturn) {
                            marginHtml = '<span class="text-muted">İade</span>';
                        } else {
                            var simulatedCost = d.quantity * unitCost; 
                            var margin = d.netTotal === 0 ? 0 : ((d.netTotal - simulatedCost) / d.netTotal) * 100;
                            var mClass = margin > 20 ? 'text-success' : (margin < 0 ? 'text-danger fw-bold' : 'text-warning text-dark');
                            marginHtml = '<span class="badge bg-light '+mClass+' border">%' + margin.toFixed(1) + '</span>';
                        }

                        html += '<tr class="'+rowColor+'">';
                        html += '<td>' + d.docDate + '</td>';
                        html += '<td><span class="badge bg-secondary">' + d.company + '</span></td>';
                        html += '<td><span class="fw-bold text-dark">' + d.docNum + '</span></td>';
                        html += '<td><span class="badge '+badgeColor+'">' + d.docType + '</span></td>';
                        html += '<td><div class="text-truncate fw-bold" style="max-width: 200px;" title="'+d.cardName+'">' + d.cardName + '</div></td>';
                        html += '<td class="text-center fw-bold">' + d.quantity.toLocaleString('tr-TR') + '</td>';
                        html += '<td class="text-end">' + d.unitPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) + ' ' + d.currency + '</td>';
                        html += '<td class="text-end fw-bold text-dark">' + d.netTotal.toLocaleString('tr-TR', {minimumFractionDigits: 2}) + ' ₺</td>';
                        html += '<td class="text-center">' + marginHtml + '</td>';
                        html += '</tr>';

                        tQty += d.quantity;
                        tCiro += d.netTotal;
                    });

                    html += '</tbody><tfoot class="table-light fs-6"><tr><td colspan="5" class="text-end fw-bold text-dark">GENEL TOPLAM:</td><td class="text-center fw-bold text-primary">' + tQty.toLocaleString('tr-TR') + '</td><td></td><td class="text-end fw-bold text-primary">' + tCiro.toLocaleString('tr-TR', {minimumFractionDigits: 2}) + ' ₺</td><td></td></tr></tfoot></table></div></div>';
                    
                    document.getElementById('salesModalBody').innerHTML = html;
                } else {
                    document.getElementById('salesModalBody').innerHTML = '<div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i> Veriler yüklenirken hata oluştu: ' + res.message + '</div>';
                }
            })
            .catch(err => {
                document.getElementById('salesModalBody').innerHTML = '<div class="alert alert-danger"><i class="fas fa-wifi me-2"></i> Sunucu ile bağlantı kurulamadı. Lütfen tekrar deneyin.</div>';
            });
    }

    // Grafikleri Başlat
    document.addEventListener("DOMContentLoaded", function () {
        var rawData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends));
        var labels = ["Oca", "Şub", "Mar", "Nis", "May", "Haz", "Tem", "Ağu", "Eyl", "Eki", "Kas", "Ara"];
        var currYearData = new Array(12).fill(0);
        var lastYearData = new Array(12).fill(0);

        rawData.forEach(function(item) {
            currYearData[item.Month - 1] = item.CurrYearSales;
            lastYearData[item.Month - 1] = item.LastYearSales;
        });

        new Chart(document.getElementById('trendChart').getContext('2d'), {
            type: 'line',
            data: { labels: labels, datasets: [ { label: 'Bu Yıl', data: currYearData, borderColor: '#4e73df', backgroundColor: 'rgba(78, 115, 223, 0.1)', borderWidth: 3, pointBackgroundColor: '#4e73df', pointRadius: 4, fill: true, tension: 0.4 }, { label: 'Geçen Yıl', data: lastYearData, borderColor: '#858796', borderWidth: 2, borderDash: [5, 5], pointBackgroundColor: '#858796', pointRadius: 3, fill: false, tension: 0.4 } ] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'top' } }, scales: { y: { beginAtZero: true, ticks: { callback: function(v) { return v.toLocaleString('tr-TR') + ' ₺'; } } } } }
        });

        var categoryRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ItemGroups));
        var catLabels = [], catData = [];
        var bgColors = ['#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b', '#858796', '#5a5c69', '#2e59d9', '#17a673', '#2c9faf'];

        categoryRaw.forEach(c => { catLabels.push(c.GroupName); catData.push(c.TotalSales); });

        new Chart(document.getElementById('categoryChart').getContext('2d'), {
            type: 'doughnut',
            data: { labels: catLabels, datasets: [{ data: catData, backgroundColor: bgColors, hoverBorderColor: "rgba(234, 236, 244, 1)" }] },
            options: { responsive: true, maintainAspectRatio: false, cutout: '70%', plugins: { legend: { display: false }, tooltip: { callbacks: { label: function(ctx) { let l = ctx.label || ''; if(l) l+=': '; if(ctx.parsed !== null) l += new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY', maximumFractionDigits: 0 }).format(ctx.parsed); return l; } } } } }
        });
    });
</script>