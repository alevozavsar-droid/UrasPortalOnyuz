@{
    ViewData["Title"] = "Aylık Satış Onay Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cariler = ViewBag.Cariler as List<WebApplication3.Controllers.Rapor150Controller.CariModel> ?? new List<WebApplication3.Controllers.Rapor150Controller.CariModel>();
    var currentSelectedDbDisplay = (string)ViewBag.CurrentDbDisplay ?? "Bilinmiyor";
    bool yoneticiMi = ViewBag.YoneticiMi != null && (bool)ViewBag.YoneticiMi;
    string varsayilanDonem = (string)ViewBag.VarsayilanDonem ?? DateTime.Today.ToString("yyyy-MM");
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <style>
        body { background-color: var(--bg-main, #f4f7fe); }
        .card-dash { border: none; border-radius: 10px; box-shadow: 0 2px 12px rgba(0,0,0,0.04); margin-bottom: 1rem; background: var(--bg-card, #fff); }
        .card-header-dash { background-color: var(--bg-card, #fff); border-bottom: 1px solid var(--border-color, #e9ecef); border-radius: 10px 10px 0 0; padding: 0.7rem 1.1rem; }
        .form-label { font-weight: 600; color: #344767; font-size: 0.72rem; margin-bottom: 0.2rem; text-transform: uppercase; letter-spacing: 0.4px; }
        .form-control, .form-select { border-radius: 6px; border: 1px solid #d2d6da; font-size: 0.8rem; padding: 0.35rem 0.7rem; min-height: 32px; }
        .select2-container--bootstrap-5 .select2-selection--multiple { max-height: 62px; overflow-y: auto; border-radius: 6px; font-size: 0.8rem; border-color: #d2d6da; }
        .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__rendered .select2-selection__choice { font-size: 0.7rem; background-color: #e9ecef; color: #344767; margin-top: 4px; padding: 1px 6px; }
        .filter-switches { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; background: var(--bg-subtle, #f8f9fa); padding: 0.45rem 0.9rem; border-radius: 6px; border: 1px solid var(--border-color, #e9ecef); min-height: 32px; }
        .form-check-label { font-size: 0.78rem; font-weight: 600; color: #344767; cursor: pointer; }

        .widget-card { border-radius: 10px; border: none; color: #fff; position: relative; overflow: hidden; }
        .widget-icon { position: absolute; right: -12px; bottom: -14px; font-size: 4.5rem; opacity: 0.15; transform: rotate(-10deg); }
        .bg-grad-primary { background: linear-gradient(135deg, #4361ee 0%, #3f37c9 100%); }
        .bg-grad-success { background: linear-gradient(135deg, #2dce89 0%, #20c997 100%); }
        .bg-grad-info { background: linear-gradient(135deg, #11cdef 0%, #0fb9b1 100%); }
        .bg-grad-warning { background: linear-gradient(135deg, #fb6340 0%, #f5365c 100%); }
        .bg-grad-dark { background: linear-gradient(135deg, #495057 0%, #212529 100%); }
        .bg-grad-purple { background: linear-gradient(135deg, #8e54e9 0%, #4776e6 100%); }
        .widget-title { text-transform: uppercase; font-weight: 700; font-size: 0.68rem; opacity: .8; }
        .widget-value { font-size: 1.25rem; font-weight: 700; margin-top: 2px; white-space: nowrap; }
        .widget-sub { font-size: 0.7rem; opacity: .85; }

        .nav-tabs .nav-link { font-weight: 700; font-size: 0.85rem; color: #6c757d; }
        .nav-tabs .nav-link.active { color: #4361ee; border-bottom: 3px solid #4361ee; }
        .nav-pills .nav-link { font-size: .8rem; color: #495057; background: #fff; border: 1px solid #dee2e6; margin-right: .4rem; text-align: left; line-height: 1.15; }
        .nav-pills .nav-link.active { background: #4361ee; color: #fff; border-color: #4361ee; }
        .table-wrapper { border-radius: 8px; overflow: auto; max-height: 600px; border: 1px solid var(--border-color, #e9ecef); }
        .table-dash { width: 100%; margin-bottom: 0; background: var(--bg-card, #fff); }
        .table-dash thead th { position: sticky; top: 0; background-color: var(--bg-subtle, #f8f9fa); color: var(--text-secondary, #6c757d); font-size: 0.68rem; text-transform: uppercase; font-weight: 700; padding: 8px; border-bottom: 2px solid var(--border-color, #e9ecef); z-index: 2; white-space: nowrap; cursor: pointer; }
        .table-dash thead th.sorted-asc::after { content: " \25B2"; font-size: .6rem; }
        .table-dash thead th.sorted-desc::after { content: " \25BC"; font-size: .6rem; }
        .table-dash tbody td { padding: 6px 8px; font-size: 0.78rem; color: #344767; border-bottom: 1px solid #f1f3f5; vertical-align: middle; white-space: nowrap; }
        .table-dash tbody tr:hover td { background-color: var(--bg-subtle, #f8f9fa); }
        .table-dash tfoot td { padding: 8px; font-size: 0.8rem; font-weight: 700; background: #e9ecef; border-top: 2px solid #ced4da; position: sticky; bottom: 0; white-space: nowrap; }
        tr.row-haric td { color: #adb5bd !important; text-decoration: line-through; background: #fff5f5 !important; }
        tr.row-haric td.no-strike { text-decoration: none; }
        tr.row-iade td { color: #b02a37; }
        tr.row-taslak td { background: #fffbea; font-style: italic; }
        .num { text-align: right; font-variant-numeric: tabular-nums; }
        .badge-op { background: #fd7e14; }
        .badge-grup { background: #6f42c1; }
        .onay-kutu { border: 2px dashed #ced4da; border-radius: 10px; padding: .9rem 1.1rem; background: #fff; }
        .onay-kutu.onayli { border-color: #2dce89; background: #f0fff8; }
        .onay-kutu.kapali { background: #f8f9fa; }
        .onay-kutu .form-check-input { width: 1.4em; height: 1.4em; }
        .chip { display: inline-block; padding: .2rem .6rem; border-radius: 999px; font-size: .72rem; font-weight: 700; background: #eef1ff; color: #3f37c9; margin-right: .35rem; margin-bottom: .3rem; }
        .chip .v { color: #212529; margin-left: .3rem; }
        #loadingOverlay { display: none; position: fixed; inset: 0; background: rgba(255,255,255,.6); z-index: 2000; align-items: center; justify-content: center; }
        .cursor-pointer { cursor: pointer; }
        .kanal-bar { height: 10px; border-radius: 5px; background: #e9ecef; overflow: hidden; }
        /* Dashboard alt bölümü: üç eşit kart, aynı yükseklik, içerik kart içinde kayar */
        .dash-kart { height: 420px; display: flex; flex-direction: column; margin-bottom: 0; }
        .dash-kart .dash-icerik { flex: 1 1 auto; min-height: 0; overflow: auto; }
        .dash-kart .dash-grafik { position: relative; flex: 1 1 auto; min-height: 0; padding: .5rem; }
        .dash-kart .table-wrapper { border: none; border-radius: 0 0 10px 10px; max-height: none; }
        .kanal-bar > div { height: 100%; }
    </style>
}

<div id="loadingOverlay"><div class="text-center"><i class="fas fa-spinner fa-spin fa-3x text-primary"></i><div class="mt-2 fw-bold text-primary">Yükleniyor...</div></div></div>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h4 class="fw-bold text-dark mb-0"><i class="fas fa-clipboard-check text-success me-2"></i>Aylık Satış Onay Raporu</h4>
            <span class="text-muted" style="font-size: 12.5px;">Aktif Şirket: <strong class="text-primary">@currentSelectedDbDisplay</strong> | Yurt içi / yurt dışı fatura bazlı onay</span>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-sm btn-outline-secondary fw-bold" id="btnOnayGecmisi"><i class="fas fa-history me-1"></i>Onay Geçmişi</button>
            <button class="btn btn-sm btn-outline-primary fw-bold" id="btnGrupSirketleri"><i class="fas fa-sitemap me-1"></i>Grup Şirketleri</button>
            <button class="btn btn-sm btn-primary shadow-sm fw-bold px-4" id="btnRunReport"><i class="fas fa-play me-1"></i>Raporu Çalıştır</button>
        </div>
    </div>

    <!-- FİLTRELER -->
    <div class="card card-dash">
        <div class="card-header-dash d-flex justify-content-between align-items-center cursor-pointer" data-bs-toggle="collapse" data-bs-target="#filterBody">
            <span class="fw-bold text-primary"><i class="fas fa-filter me-2"></i>Filtreler</span>
            <i class="fas fa-chevron-down text-muted small"></i>
        </div>
        <div class="collapse show" id="filterBody">
            <div class="card-body p-3">
                <div class="row g-3">
                    <div class="col-lg-2 col-md-4">
                        <label class="form-label">Dönem (Ay)</label>
                        <input type="month" class="form-control fw-bold text-primary" id="txtDonem" value="@varsayilanDonem" />
                    </div>
                    <div class="col-lg-2 col-md-4">
                        <label class="form-label">Belge Türü</label>
                        <select class="form-select" id="cbDocTur">
                            <option value="H">Kalem + Hizmet</option>
                            <option value="I">Sadece Kalem Faturaları</option>
                            <option value="S">Sadece Hizmet Faturaları</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4">
                        <label class="form-label">Grup İçi Şirketler</label>
                        <select class="form-select" id="cbGrupIci">
                            <option value="H">Getir (Hepsi)</option>
                            <option value="HARIC">Getirme (Grup Hariç)</option>
                            <option value="SADECE">Sadece Grup İçi</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4">
                        <label class="form-label">Operasyon (MO) Carileri</label>
                        <select class="form-select" id="cbOperasyon">
                            <option value="H">Getir (Hepsi)</option>
                            <option value="HARIC">Getirme (Operasyon Hariç)</option>
                            <option value="SADECE">Sadece Operasyon</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4">
                        <label class="form-label">Onay Durumu</label>
                        <select class="form-select" id="cbOnayDurumu">
                            <option value="H">Hepsi</option>
                            <option value="ONAYLI">Sadece Onaylı (Bakiyede)</option>
                            <option value="HARIC">Sadece Hariç Tutulan</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4">
                        <label class="form-label">Belge Tipi</label>
                        <div class="filter-switches">
                            <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" id="chkFatura" checked><label class="form-check-label" for="chkFatura">Fatura</label></div>
                            <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" id="chkIade" checked><label class="form-check-label" for="chkIade">İade</label></div>
                            <div class="form-check form-switch mb-0" title="Yalnızca yurt dışı kanalında, açık taslak faturalar"><input class="form-check-input" type="checkbox" id="chkTaslak" checked><label class="form-check-label" for="chkTaslak">Taslak</label></div>
                        </div>
                    </div>
                    <div class="col-lg-7 col-md-8">
                        <label class="form-label">Cari Seçimi (boş = tümü)</label>
                        <select class="form-select" id="cbCariler" multiple>
                            @foreach (var c in cariler)
                            {
                                <option value="@c.CardCode">@c.CardCode - @c.CardName</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-4">
                        <label class="form-label">Ara (belge no / cari / müşteri ref.)</label>
                        <input type="text" class="form-control" id="txtAra" placeholder="Yazıp Enter'a basın" />
                    </div>
                    <div class="col-lg-2 col-md-12 d-flex align-items-end">
                        <button class="btn btn-sm btn-light border fw-bold w-100 text-secondary" id="btnClearFilters"><i class="fas fa-eraser me-1"></i>Temizle</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SEKMELER -->
    <ul class="nav nav-tabs mb-3" id="anaSekmeler" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link active" id="tab-yi" data-bs-toggle="tab" data-bs-target="#pane-yi" type="button"><i class="fas fa-home me-1"></i>Yurt İçi <span class="badge bg-primary ms-1" id="badgeYI">0</span></button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" id="tab-yd" data-bs-toggle="tab" data-bs-target="#pane-yd" type="button"><i class="fas fa-globe me-1"></i>Yurt Dışı / İhracat <span class="badge bg-info text-dark ms-1" id="badgeYD">0</span></button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" id="tab-ozet" data-bs-toggle="tab" data-bs-target="#pane-ozet" type="button"><i class="fas fa-chart-pie me-1"></i>Özet / Dashboard</button></li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="pane-yi" role="tabpanel"></div>
        <div class="tab-pane fade" id="pane-yd" role="tabpanel"></div>
        <div class="tab-pane fade" id="pane-ozet" role="tabpanel">
            <div class="text-center text-muted py-5">Raporu çalıştırın.</div>
        </div>
    </div>
</div>

<!-- FATURA DETAY MODALI -->
<div class="modal fade" id="detayModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title mb-0"><i class="fas fa-file-invoice me-2"></i><span id="detayBaslik">Belge Detayı</span></h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3" id="detayIcerik"></div>
        </div>
    </div>
</div>

<!-- GRUP ŞİRKETLERİ MODALI -->
<div class="modal fade" id="grupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white py-2">
                <h6 class="modal-title mb-0"><i class="fas fa-sitemap me-2"></i>Grup İçi Şirket Listesi</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <div class="alert alert-secondary small py-2">
                    <i class="fas fa-info-circle me-1"></i> Bu liste tüm şirketler için ortaktır. <b>Ad Deseni</b>: cari adı bu metni içeriyorsa grup içi sayılır. <b>Cari Kodu</b>: yalnızca o kart. Pasif satırlar dikkate alınmaz.
                </div>
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Tür</label>
                        <select class="form-select" id="grupTip"><option value="AD">Ad Deseni (içerir)</option><option value="KOD">Cari Kodu (eşit)</option></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Desen / Kod</label>
                        <input type="text" class="form-control" id="grupDeger" placeholder="Örn: URAS K veya C00123" maxlength="100" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Açıklama</label>
                        <input type="text" class="form-control" id="grupAciklama" placeholder="Şirket adı" maxlength="200" />
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-sm btn-primary fw-bold w-100" id="btnGrupEkle"><i class="fas fa-plus me-1"></i>Ekle</button>
                    </div>
                </div>
                <div class="table-wrapper mb-3" style="max-height:260px;">
                    <table class="table-dash">
                        <thead><tr><th>Tür</th><th>Desen / Kod</th><th>Açıklama</th><th class="text-center">Aktif</th><th class="text-center">Sil</th></tr></thead>
                        <tbody id="grupListe"></tbody>
                    </table>
                </div>
                <div class="fw-bold small text-secondary mb-1"><i class="fas fa-building me-1"></i>Bu şirkette (@currentSelectedDbDisplay) grup içi sayılan cariler: <span id="grupEslesenAdet" class="badge bg-secondary">0</span></div>
                <div class="table-wrapper" style="max-height:220px;">
                    <table class="table-dash">
                        <thead><tr><th>Cari Kodu</th><th>Cari Adı</th><th>Ülke</th></tr></thead>
                        <tbody id="grupEslesen"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ONAY GEÇMİŞİ MODALI -->
<div class="modal fade" id="gecmisModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-secondary text-white py-2">
                <h6 class="modal-title mb-0"><i class="fas fa-history me-2"></i>Dönem Onay Geçmişi (@currentSelectedDbDisplay)</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <div class="table-wrapper">
                    <table class="table-dash">
                        <thead><tr><th>Dönem</th><th>Kanal</th><th>Durum</th><th class="num">Net TL</th><th class="num">Net USD</th><th class="num">Net EUR</th><th class="num">Belge</th><th class="num">Hariç</th><th>Kullanıcı</th><th>Tarih</th><th>Açıklama</th></tr></thead>
                        <tbody id="gecmisListe"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var YONETICI = @(yoneticiMi ? "true" : "false");
        var sonVeri = null;
        var sonDonem = null;
        var grafikler = {};
        var siralama = { YI: { kolon: 'tarih', yon: -1 }, YD: { kolon: 'tarih', yon: -1 } };

        function fmt(n, dec) {
            if (n === null || n === undefined || isNaN(n)) return '0,00';
            return Number(n).toLocaleString('tr-TR', { minimumFractionDigits: dec === undefined ? 2 : dec, maximumFractionDigits: dec === undefined ? 2 : dec });
        }
        function esc(v) { return $('<div>').text(v == null ? '' : String(v)).html(); }
        function tarihFmt(iso) {
            if (!iso) return '';
            var d = new Date(iso); if (isNaN(d)) return esc(iso);
            return ('0' + d.getDate()).slice(-2) + '.' + ('0' + (d.getMonth() + 1)).slice(-2) + '.' + d.getFullYear();
        }
        function kanalAdi(k) { return k === 'YI' ? 'Yurt İçi' : 'Yurt Dışı'; }

        // ------------------------------------------------------------------
        // RAPOR ÇALIŞTIR
        // ------------------------------------------------------------------
        function filtreOku() {
            return {
                Donem: $('#txtDonem').val(),
                IncFatura: $('#chkFatura').is(':checked'),
                IncIade: $('#chkIade').is(':checked'),
                IncTaslak: $('#chkTaslak').is(':checked'),
                DocTur: $('#cbDocTur').val(),
                GrupIci: $('#cbGrupIci').val(),
                Operasyon: $('#cbOperasyon').val(),
                OnayDurumu: $('#cbOnayDurumu').val(),
                Ara: $('#txtAra').val(),
                SelectedCustomers: $('#cbCariler').val() || []
            };
        }

        function raporCalistir() {
            var f = filtreOku();
            if (!f.Donem) { toastr.warning('Dönem seçiniz.'); return; }
            var btn = $('#btnRunReport');
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Çalışıyor');
            $('#loadingOverlay').css('display', 'flex');
            $.ajax({
                url: '/Rapor150/RunReport', type: 'POST', contentType: 'application/json', data: JSON.stringify(f),
                success: function (r) {
                    if (!r.success) { toastr.error('Hata: ' + r.message); return; }
                    sonVeri = r; sonDonem = f.Donem;
                    sekmeCiz('YI', r.yurtIci, r);
                    sekmeCiz('YD', r.yurtDisi, r);
                    ozetCiz(r);
                    $('#badgeYI').text(r.yurtIci.satirlar.length);
                    $('#badgeYD').text(r.yurtDisi.satirlar.length);
                    toastr.success(r.donemAdi + ' dönemi yüklendi.');
                },
                error: function () { toastr.error('Sunucu bağlantısı koptu.'); },
                complete: function () {
                    $('#loadingOverlay').hide();
                    btn.prop('disabled', false).html('<i class="fas fa-play me-1"></i>Raporu Çalıştır');
                }
            });
        }

        // ------------------------------------------------------------------
        // SEKME (YI / YD)
        // ------------------------------------------------------------------
        // Grup içi belgeler (kendi şirketlerimize satış) net toplamlara KATILMAZ; ayrı sayılır.
        // "Sadece grup içi" filtresi seçiliyken (sonVeri.grupDahil) toplamlar grup içini kapsar.
        function toplamHesapla(satirlar) {
            var grupDahil = !!(sonVeri && sonVeri.grupDahil);
            var t = { adet: satirlar.length, faturaAdet: 0, iadeAdet: 0, taslakAdet: 0, haricAdet: 0, netTL: 0, kdvTL: 0, brutTL: 0, netUSD: 0, netEUR: 0, haricNetTL: 0, haricNetUSD: 0, haricNetEUR: 0, normalTL: 0, opTL: 0, grupTL: 0, grupUSD: 0, grupEUR: 0, grupAdet: 0 };
            satirlar.forEach(function (s) {
                if (s.objType === '13') t.faturaAdet++; else if (s.objType === 'T13') t.taslakAdet++; else t.iadeAdet++;
                if (s.haric) { t.haricAdet++; t.haricNetTL += s.netTL; t.haricNetUSD += s.netUSD; t.haricNetEUR += s.netEUR; return; }
                if (s.grupIci) { t.grupAdet++; t.grupTL += s.netTL; t.grupUSD += s.netUSD; t.grupEUR += s.netEUR; if (!grupDahil) return; }
                t.netTL += s.netTL; t.kdvTL += s.kdvTL; t.brutTL += s.brutTL; t.netUSD += s.netUSD; t.netEUR += s.netEUR;
                if (s.operasyon) t.opTL += s.netTL; else if (!s.grupIci) t.normalTL += s.netTL;
            });
            return t;
        }

        function sekmeCiz(kanal, veri, r) {
            var pane = $(kanal === 'YI' ? '#pane-yi' : '#pane-yd');
            var t = toplamHesapla(veri.satirlar);
            var onay = veri.onay;

            var html = '';
            html += '<div class="row g-3 mb-3">';
            var grupNotu = (sonVeri && sonVeri.grupDahil) ? 'Sadece grup içi filtresi: grup dahil' : 'Grup içi ve KDV hariç';
            html += widget('bg-grad-primary', 'Onaylı NET Toplam (TL)', fmt(t.netTL) + ' ₺', grupNotu, 'fa-lira-sign', 'Brüt (KDV dahil): ' + fmt(t.brutTL) + ' ₺ | KDV: ' + fmt(t.kdvTL) + ' ₺');
            html += widget('bg-grad-success', 'Onaylı NET Toplam (USD)', '$ ' + fmt(t.netUSD), grupNotu, 'fa-dollar-sign', 'Belge USD ise kendi tutarı, değilse belge günü kuru');
            html += widget('bg-grad-info', 'Onaylı NET Toplam (EUR)', '€ ' + fmt(t.netEUR), grupNotu, 'fa-euro-sign', 'Belge EUR ise kendi tutarı, değilse belge günü kuru');
            html += widget('bg-grad-purple', 'Grup İçi (bakiyeye dahil değil)', fmt(t.grupTL) + ' ₺', '$ ' + fmt(t.grupUSD) + ' | € ' + fmt(t.grupEUR) + ' | ' + t.grupAdet + ' belge', 'fa-sitemap', 'Kendi şirketlerimize satış, ayrı gösterilir');
            html += widget('bg-grad-warning', 'Hariç Tutulan', t.haricAdet + ' belge', fmt(t.haricNetTL) + ' ₺ bakiyeden düşüldü', 'fa-ban');
            html += widget('bg-grad-dark', 'Listelenen Belge', t.adet + ' adet', t.faturaAdet + ' fatura / ' + t.iadeAdet + ' iade' + (t.taslakAdet ? ' / ' + t.taslakAdet + ' taslak' : ''), 'fa-file-invoice');
            html += '</div>';

            // Alt sekme (segment) toplamları
            var segToplam = {};
            veri.segmentler.forEach(function (sg) { segToplam[sg.kod] = toplamHesapla(veri.satirlar.filter(function (x) { return x.segment === sg.kod; })); });
            html += '<div class="mb-2">';
            veri.segmentler.forEach(function (sg) {
                var st = segToplam[sg.kod];
                html += '<span class="chip" style="' + segRenk(sg.kod) + '">' + esc(sg.ad) + ' <span class="v">' + fmt(st.netTL) + ' ₺ / ' + st.adet + ' belge</span></span>';
            });
            html += '<span class="chip" style="background:#f1eaff;color:#5a2ea6;">Grup İçi — bakiyeye dahil değil <span class="v">' + fmt(t.grupTL) + ' ₺ / ' + t.grupAdet + ' belge</span></span>';
            if (veri.tumToplam.adet !== t.adet) html += '<span class="chip" style="background:#f8f9fa;color:#6c757d;">Filtresiz dönem toplamı <span class="v">' + fmt(veri.tumToplam.netTL) + ' ₺ / ' + veri.tumToplam.adet + ' belge</span></span>';
            html += '</div>';

            // Kanal onayı (alt sekmelerin tümünü kapsar)
            html += onayKutusu(kanal, onay, t, r);

            html += '<div class="small text-muted mb-2"><i class="fas fa-info-circle me-1"></i>Satırdaki kutunun işaretini kaldırırsanız belge <b>bakiyeden düşer</b>. Satıra çift tıklayarak veya <i class="fas fa-search"></i> ile kalem detayını görebilirsiniz. Kanal onayı alt sekmelerin tamamını kapsar. <b>Grup içi</b> rozetli belgeler listelenir ama net toplamlara ve onaylanan tutara katılmaz.</div>';

            // Alt sekmeler
            html += '<ul class="nav nav-pills mb-2" id="altSekme' + kanal + '" role="tablist">';
            veri.segmentler.forEach(function (sg, i) {
                var st = segToplam[sg.kod];
                html += '<li class="nav-item"><button class="nav-link fw-bold ' + (i === 0 ? 'active' : '') + '" data-bs-toggle="pill" data-bs-target="#alt' + kanal + '_' + sg.kod + '" type="button">' + esc(sg.ad) +
                    ' <span class="badge bg-light text-dark border ms-1">' + st.adet + '</span><span class="d-block small fw-normal" style="font-size:.68rem;opacity:.85">' + fmt(st.netTL) + ' ₺</span></button></li>';
            });
            html += '</ul><div class="tab-content">';
            veri.segmentler.forEach(function (sg, i) {
                var st = segToplam[sg.kod];
                html += '<div class="tab-pane fade ' + (i === 0 ? 'show active' : '') + '" id="alt' + kanal + '_' + sg.kod + '">';
                html += '<div class="d-flex justify-content-end gap-2 mb-2"><input type="text" class="form-control form-control-sm" style="width:220px" placeholder="Bu sekmede hızlı ara..." oninput="tabloAra(\'' + kanal + '\',\'' + sg.kod + '\', this.value)">';
                html += '<button class="btn btn-sm btn-success fw-bold" onclick="excelAktar(\'' + kanal + '\',\'' + sg.kod + '\')"><i class="fas fa-file-excel me-1"></i>Excel</button></div>';
                html += '<div class="table-wrapper"><table class="table-dash" id="tbl' + kanal + '_' + sg.kod + '">' + tabloBaslik(kanal) + '<tbody id="tbody' + kanal + '_' + sg.kod + '"></tbody>' + tabloAltBilgi(kanal, st) + '</table></div>';
                html += '</div>';
            });
            html += '</div>';

            pane.html(html);
            veri.segmentler.forEach(function (sg) { tabloSatirlariCiz(kanal, sg.kod, veri.satirlar); });
        }

        function segRenk(kod) {
            switch (kod) {
                case 'AVRASYA': return 'background:#e3f2fd;color:#0d47a1;';
                case 'ASIA': return 'background:#e8f5e9;color:#1b5e20;';
                case 'OPERASYON': return 'background:#fff3e6;color:#c25e00;';
                case 'DRN': return 'background:#fde2e4;color:#8b1e2d;';
                default: return 'background:#eef1ff;color:#3f37c9;';
            }
        }

        function widget(cls, baslik, deger, alt, ikon, alt2) {
            return '<div class="col-xl col-md-4 col-sm-6"><div class="card widget-card ' + cls + ' shadow-sm h-100 p-3">' +
                '<div class="widget-title">' + baslik + '</div><div class="widget-value">' + deger + '</div><div class="widget-sub">' + alt + '</div>' +
                (alt2 ? '<div class="widget-sub" style="opacity:.7;font-size:.66rem">' + alt2 + '</div>' : '') +
                '<i class="fas ' + ikon + ' widget-icon"></i></div></div>';
        }
        function brutYazi(k) { return 'Brüt (KDV dahil): ' + fmt(k.brutTL) + ' ₺ | KDV: ' + fmt(k.kdvTL) + ' ₺'; }

        function onayKutusu(kanal, onay, t, r) {
            var acikSinif = onay.onayli ? 'onayli' : (onay.acik ? '' : 'kapali');
            var h = '<div class="onay-kutu mb-3 ' + acikSinif + '" id="onayKutu' + kanal + '">';
            h += '<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">';
            h += '<div>';
            h += '<div class="fw-bold" style="font-size:.95rem"><i class="fas fa-calendar-check me-1 text-' + (onay.onayli ? 'success' : 'secondary') + '"></i>' + r.donemAdi + ' — ' + kanalAdi(kanal) + ' Dönem Onayı</div>';
            h += '<div class="small text-muted">Onay günü: <b>' + esc(onay.onayGunu) + ' (' + esc(onay.onayGunuAdi) + ')</b> — ' +
                (kanal === 'YD' ? 'ayın son günü, hafta sonuysa son hafta içi günü' : 'ayın son Cumartesi günü') + '.';
            if (!onay.acik) h += ' <span class="badge bg-warning text-dark">Kutu ' + onay.kalanGun + ' gün sonra açılır</span>';
            else if (!onay.onayli && onay.kalanGun < 0) h += ' <span class="badge bg-danger">Onay günü ' + Math.abs(onay.kalanGun) + ' gün geçti</span>';
            h += '</div>';
            if (onay.onayli) {
                h += '<div class="small mt-1 text-success fw-bold"><i class="fas fa-check-circle me-1"></i>ONAYLANDI — ' + esc(onay.onaylayanKullanici) + ', ' + esc(onay.onayTarihi) +
                    ' | Onaylanan: ' + fmt(onay.onayNetTL) + ' ₺ / $ ' + fmt(onay.onayNetUSD) + ' / € ' + fmt(onay.onayNetEUR) + ' (' + onay.onayFaturaSayisi + ' belge)';
                if (onay.onayAciklama) h += '<div class="text-muted fw-normal">Not: ' + esc(onay.onayAciklama) + '</div>';
                h += '</div>';
                if (Math.abs(onay.onayNetTL - t.netTL) > 0.01 && veriFiltresiz()) h += '<div class="small text-danger mt-1"><i class="fas fa-exclamation-triangle me-1"></i>Dikkat: onaydan sonra bakiye değişmiş (şu an ' + fmt(t.netTL) + ' ₺).</div>';
            }
            h += '</div>';
            h += '<div style="min-width:320px">';
            if (onay.onayli) {
                h += '<button class="btn btn-sm btn-outline-danger fw-bold" onclick="donemOnay(\'' + kanal + '\', false)"><i class="fas fa-undo me-1"></i>Onayı Geri Al</button>';
            } else {
                h += '<div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="chkOnay' + kanal + '" ' + (onay.acik ? '' : 'disabled') + ' onchange="donemOnayKutu(\'' + kanal + '\', this)">' +
                    '<label class="form-check-label fw-bold ms-2" for="chkOnay' + kanal + '" style="font-size:.9rem">' + kanalAdi(kanal) + ' satışlarını onaylıyorum (' + fmt(t.netTL) + ' ₺, grup içi hariç)</label></div>';
                h += '<textarea class="form-control form-control-sm" id="txtOnayNot' + kanal + '" rows="1" placeholder="Onay notu (isteğe bağlı)" ' + (onay.acik ? '' : 'disabled') + '></textarea>';
                if (!onay.acik && YONETICI) h += '<div class="small text-muted mt-1">Yönetici yetkisiyle kutu her zaman açıktır.</div>';
            }
            h += '</div></div></div>';
            return h;
        }

        function veriFiltresiz() {
            var f = filtreOku();
            return f.IncFatura && f.IncIade && f.IncTaslak && f.DocTur === 'H' && f.GrupIci === 'H' && f.Operasyon === 'H' && f.OnayDurumu === 'H' && !f.Ara && f.SelectedCustomers.length === 0;
        }

        var kolonlar = [
            { k: 'onay', b: 'Onay', sinif: 'text-center no-strike', sirala: false },
            { k: 'belgeTipi', b: 'Tip' },
            { k: 'docNum', b: 'Belge No', sinif: 'num' },
            { k: 'tarih', b: 'Tarih' },
            { k: 'cardCode', b: 'Cari Kodu' },
            { k: 'cardName', b: 'Cari Adı' },
            { k: 'etiket', b: 'Etiket', sirala: false },
            { k: 'paraBirimi', b: 'PB' },
            { k: 'orjNet', b: 'Net (Belge PB)', sinif: 'num' },
            { k: 'netTL', b: 'Net TL', sinif: 'num' },
            { k: 'kdvTL', b: 'KDV TL', sinif: 'num' },
            { k: 'brutTL', b: 'Brüt TL', sinif: 'num' },
            { k: 'netUSD', b: 'Net USD', sinif: 'num' },
            { k: 'netEUR', b: 'Net EUR', sinif: 'num' },
            { k: 'kurUSD', b: 'Kur USD', sinif: 'num' },
            { k: 'kurEUR', b: 'Kur EUR', sinif: 'num' },
            { k: 'musteriGrubu', b: 'Müşteri Grubu' },
            { k: 'ulke', b: 'Ülke' },
            { k: 'satisTemsilcisi', b: 'Temsilci' },
            { k: 'islemTipi', b: 'İşlem Tipi' },
            { k: 'musteriBelgeNo', b: 'Müşteri Ref.' },
            { k: 'detay', b: 'Detay', sinif: 'text-center no-strike', sirala: false }
        ];

        function tabloBaslik(kanal) {
            var h = '<thead><tr>';
            kolonlar.forEach(function (c) {
                var s = siralama[kanal];
                var cls = (c.sinif || '') + (s.kolon === c.k ? (s.yon === 1 ? ' sorted-asc' : ' sorted-desc') : '');
                h += '<th class="' + cls + '" ' + (c.sirala === false ? '' : 'onclick="sirala(\'' + kanal + '\',\'' + c.k + '\')"') + '>' + c.b + '</th>';
            });
            return h + '</tr></thead>';
        }

        function tabloAltBilgi(kanal, t) {
            var h = '<tfoot><tr><td colspan="9" class="text-end">ONAYLI NET TOPLAM — grup içi hariç (' + (t.adet - t.haricAdet - ((sonVeri && sonVeri.grupDahil) ? 0 : t.grupAdet)) + ' belge)</td>';
            h += '<td class="num">' + fmt(t.netTL) + '</td><td class="num">' + fmt(t.kdvTL) + '</td><td class="num">' + fmt(t.brutTL) + '</td>';
            h += '<td class="num">' + fmt(t.netUSD) + '</td><td class="num">' + fmt(t.netEUR) + '</td><td colspan="8"></td></tr></tfoot>';
            return h;
        }

        function satirlariGetir(kanal) { return kanal === 'YI' ? sonVeri.yurtIci.satirlar : sonVeri.yurtDisi.satirlar; }

        function tabloSatirlariCiz(kanal, seg, satirlar) {
            var s = siralama[kanal];
            var liste = satirlar.filter(function (x) { return x.segment === seg; }).sort(function (a, b) {
                var x = a[s.kolon], y = b[s.kolon];
                if (s.kolon === 'tarih') { x = a.tarih.split('.').reverse().join(''); y = b.tarih.split('.').reverse().join(''); }
                if (typeof x === 'number' && typeof y === 'number') return (x - y) * s.yon;
                return String(x || '').localeCompare(String(y || ''), 'tr') * s.yon;
            });
            var h = '';
            liste.forEach(function (r) {
                var cls = (r.haric ? 'row-haric ' : '') + (r.objType === '14' ? 'row-iade' : (r.objType === 'T13' ? 'row-taslak' : ''));
                var kimlik = r.objType + '_' + r.docEntry;
                h += '<tr class="' + cls + '" id="row' + kanal + '_' + kimlik + '" data-ara="' + esc((r.docNum + ' ' + r.cardCode + ' ' + r.cardName + ' ' + (r.musteriBelgeNo || '')).toLowerCase()) + '" ondblclick="faturaDetay(\'' + r.objType + '\',' + r.docEntry + ')">';
                h += '<td class="text-center no-strike"><input type="checkbox" class="form-check-input" ' + (r.haric ? '' : 'checked') + ' title="' + (r.haric ? esc('Hariç: ' + (r.haricAciklama || '') + ' (' + (r.haricKullanici || '') + ' ' + (r.haricTarih || '') + ')') : 'Bakiyede') + '" onchange="faturaOnayDegistir(\'' + kanal + '\',\'' + r.objType + '\',' + r.docEntry + ', this)"></td>';
                var tipRozet = r.objType === '14' ? '<span class="badge bg-danger">İade</span>' : (r.objType === 'T13' ? '<span class="badge bg-warning text-dark">Taslak</span>' : '<span class="badge bg-success">Fatura</span>');
                h += '<td>' + tipRozet + (r.docType === 'S' ? ' <span class="badge bg-light text-dark border">Hizmet</span>' : '') + '</td>';
                h += '<td class="num">' + r.docNum + '</td><td>' + esc(r.tarih) + '</td><td>' + esc(r.cardCode) + '</td><td title="' + esc(r.cardName) + '">' + esc(r.cardName) + '</td>';
                var etiket = '';
                if (r.operasyon) etiket += '<span class="badge badge-op">Operasyon</span> ';
                if (r.grupIci) etiket += '<span class="badge badge-grup">Grup İçi</span>';
                if (r.haric) etiket += ' <span class="badge bg-secondary" title="' + esc(r.haricAciklama || '') + '">Hariç</span>';
                h += '<td>' + etiket + '</td>';
                h += '<td>' + esc(r.paraBirimi) + '</td><td class="num">' + fmt(r.orjNet) + '</td>';
                h += '<td class="num fw-bold">' + fmt(r.netTL) + '</td><td class="num">' + fmt(r.kdvTL) + '</td><td class="num">' + fmt(r.brutTL) + '</td>';
                h += '<td class="num">' + fmt(r.netUSD) + '</td><td class="num">' + fmt(r.netEUR) + '</td>';
                h += '<td class="num">' + fmt(r.kurUSD, 4) + '</td><td class="num">' + fmt(r.kurEUR, 4) + '</td>';
                h += '<td>' + esc(r.musteriGrubu) + '</td><td>' + esc(r.ulke) + '</td><td>' + esc(r.satisTemsilcisi) + '</td><td>' + esc(r.islemTipi) + '</td><td>' + esc(r.musteriBelgeNo) + '</td>';
                h += '<td class="text-center no-strike"><button class="btn btn-sm btn-outline-primary py-0 px-2" onclick="faturaDetay(\'' + r.objType + '\',' + r.docEntry + ')"><i class="fas fa-search"></i></button></td>';
                h += '</tr>';
            });
            if (!h) h = '<tr><td colspan="22" class="text-center text-muted py-4">Bu sekmede belge yok.</td></tr>';
            $('#tbody' + kanal + '_' + seg).html(h);
        }

        function segmentler(kanal) { return kanal === 'YI' ? sonVeri.yurtIci.segmentler : sonVeri.yurtDisi.segmentler; }

        function sirala(kanal, kolon) {
            var s = siralama[kanal];
            if (s.kolon === kolon) s.yon = -s.yon; else { s.kolon = kolon; s.yon = 1; }
            segmentler(kanal).forEach(function (sg) {
                $('#tbl' + kanal + '_' + sg.kod + ' thead').replaceWith(tabloBaslik(kanal));
                tabloSatirlariCiz(kanal, sg.kod, satirlariGetir(kanal));
            });
        }

        function tabloAra(kanal, seg, metin) {
            metin = (metin || '').toLowerCase();
            $('#tbody' + kanal + '_' + seg + ' tr').each(function () {
                var a = $(this).data('ara'); if (a === undefined) return;
                $(this).toggle(!metin || String(a).indexOf(metin) >= 0);
            });
        }

        function excelAktar(kanal, seg) {
            if (typeof XLSX === 'undefined') { toastr.error('Excel kütüphanesi yüklenmedi.'); return; }
            var satirlar = satirlariGetir(kanal).filter(function (x) { return x.segment === seg; });
            var veri = satirlar.map(function (r) {
                return {
                    'Onay': r.haric ? 'HARİÇ' : 'ONAYLI', 'Tip': r.belgeTipi, 'Belge No': r.docNum, 'Tarih': r.tarih, 'Cari Kodu': r.cardCode, 'Cari Adı': r.cardName,
                    'Operasyon': r.operasyon ? 'E' : '', 'Grup İçi': r.grupIci ? 'E' : '', 'PB': r.paraBirimi, 'Net (Belge PB)': r.orjNet,
                    'Net TL': r.netTL, 'KDV TL': r.kdvTL, 'Brüt TL': r.brutTL, 'Net USD': r.netUSD, 'Net EUR': r.netEUR, 'Kur USD': r.kurUSD, 'Kur EUR': r.kurEUR,
                    'Müşteri Grubu': r.musteriGrubu, 'Ülke': r.ulke, 'Temsilci': r.satisTemsilcisi, 'İşlem Tipi': r.islemTipi, 'Müşteri Ref.': r.musteriBelgeNo, 'Hariç Açıklama': r.haricAciklama || ''
                };
            });
            var wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(veri), (kanal + '_' + seg).substr(0, 30));
            XLSX.writeFile(wb, 'SatisOnay_' + kanal + '_' + seg + '_' + (sonVeri.donem || '') + '.xlsx');
        }

        // ------------------------------------------------------------------
        // FATURA BAZINDA ONAY / HARİÇ
        // ------------------------------------------------------------------
        function faturaOnayDegistir(kanal, objType, docEntry, chk) {
            var satirlar = satirlariGetir(kanal);
            var r = satirlar.find(function (x) { return x.objType === objType && x.docEntry === docEntry; });
            if (!r) return;
            var haric = !chk.checked;

            var gonder = function (aciklama) {
                $.ajax({
                    url: '/Rapor150/FaturaOnay', type: 'POST', contentType: 'application/json',
                    data: JSON.stringify({ Donem: sonDonem, Kanal: kanal, ObjType: objType, DocEntry: docEntry, DocNum: r.docNum, CardCode: r.cardCode, Haric: haric, Aciklama: aciklama || '' }),
                    success: function (res) {
                        if (!res.success) { toastr.error(res.message); chk.checked = !haric; return; }
                        r.haric = haric; r.haricAciklama = aciklama || ''; r.haricKullanici = res.kullanici; r.haricTarih = res.tarih;
                        sekmeYenile(kanal);
                        toastr.success(haric ? 'Belge bakiyeden düşüldü.' : 'Belge bakiyeye alındı.');
                    },
                    error: function () { toastr.error('Kaydedilemedi.'); chk.checked = !haric; }
                });
            };

            if (haric) {
                Swal.fire({
                    title: 'Belge bakiyeden düşülsün mü?',
                    html: '<div class="text-start small"><b>' + esc(r.belgeTipi) + ' ' + r.docNum + '</b> — ' + esc(r.cardName) + '<br>Net: ' + fmt(r.netTL) + ' ₺</div>',
                    input: 'text', inputPlaceholder: 'Neden onaylanmıyor? (isteğe bağlı)',
                    showCancelButton: true, confirmButtonText: 'Evet, hariç tut', cancelButtonText: 'Vazgeç', confirmButtonColor: '#d33'
                }).then(function (s) {
                    if (s.isConfirmed) gonder(s.value); else chk.checked = true;
                });
            } else gonder('');
        }

        function sekmeYenile(kanal) {
            var veri = kanal === 'YI' ? sonVeri.yurtIci : sonVeri.yurtDisi;
            var pane = $(kanal === 'YI' ? '#pane-yi' : '#pane-yd');
            var aktifHedef = pane.find('#altSekme' + kanal + ' .nav-link.active').data('bs-target');
            var kaydirma = pane.find('.tab-pane.active .table-wrapper').scrollTop();
            sekmeCiz(kanal, veri, sonVeri);
            if (aktifHedef) {
                var btn = pane.find('#altSekme' + kanal + ' .nav-link[data-bs-target="' + aktifHedef + '"]');
                if (btn.length) bootstrap.Tab.getOrCreateInstance(btn[0]).show();
            }
            pane.find('.tab-pane.active .table-wrapper').scrollTop(kaydirma);
            ozetCiz(sonVeri);
        }

        // ------------------------------------------------------------------
        // DÖNEM ONAYI
        // ------------------------------------------------------------------
        function donemOnayKutu(kanal, chk) {
            if (!chk.checked) return;
            chk.checked = false;
            donemOnay(kanal, true);
        }

        function donemOnay(kanal, onayli) {
            var veri = kanal === 'YI' ? sonVeri.yurtIci : sonVeri.yurtDisi;
            var t = toplamHesapla(veri.satirlar);
            var not = $('#txtOnayNot' + kanal).val() || '';
            var uyari = veriFiltresiz() ? '' : '<div class="alert alert-warning small py-1 mt-2">Filtre uygulu! Onaylanacak tutar yalnızca listelenen belgelerden hesaplanır.</div>';
            Swal.fire({
                title: onayli ? kanalAdi(kanal) + ' dönem onayı' : 'Onay geri alınsın mı?',
                html: '<div class="text-start small">' + sonVeri.donemAdi + '<br>Net TL: <b>' + fmt(t.netTL) + ' ₺</b><br>Net USD: <b>$ ' + fmt(t.netUSD) + '</b><br>Net EUR: <b>€ ' + fmt(t.netEUR) + '</b><br>' + (t.adet - t.haricAdet - t.grupAdet) + ' belge onaylı, ' + t.haricAdet + ' belge hariç, ' + t.grupAdet + ' grup içi belge bakiyeye dahil değil' + uyari + '</div>',
                icon: onayli ? 'question' : 'warning', showCancelButton: true,
                confirmButtonText: onayli ? 'Onaylıyorum' : 'Geri al', cancelButtonText: 'Vazgeç', confirmButtonColor: onayli ? '#2dce89' : '#d33'
            }).then(function (s) {
                if (!s.isConfirmed) return;
                $.ajax({
                    url: '/Rapor150/DonemOnay', type: 'POST', contentType: 'application/json',
                    data: JSON.stringify({ Donem: sonDonem, Kanal: kanal, Onayli: onayli, NetTL: t.netTL, NetUSD: t.netUSD, NetEUR: t.netEUR, FaturaSayisi: t.adet - t.haricAdet - t.grupAdet, HaricSayisi: t.haricAdet, Aciklama: not }),
                    success: function (res) {
                        if (!res.success) { toastr.error(res.message); return; }
                        toastr.success(onayli ? 'Dönem onaylandı.' : 'Onay geri alındı.');
                        raporCalistir();
                    },
                    error: function () { toastr.error('Kaydedilemedi.'); }
                });
            });
        }

        // ------------------------------------------------------------------
        // ÖZET / DASHBOARD
        // ------------------------------------------------------------------
        function ozetCiz(r) {
            var o = r.ozet;
            var byKod = {}; o.kanallar.forEach(function (k) { byKod[k.kod] = k; });
            var yi = byKod['YI'], yd = byKod['YD'], op = byKod['YI_OP'], grup = o.grupIciToplam, genel = byKod['GENEL'];
            var avr = byKod['YI_AVRASYA'], asia = byKod['YI_ASIA'], yiD = byKod['YI_DIGER'], drn = byKod['YD_DRN'], ydD = byKod['YD_DIGER'];

            var h = '<div class="row g-3 mb-3">';
            h += widget('bg-grad-primary', 'Yurt İçi NET (grup içi ve KDV hariç)', fmt(yi.netTL) + ' ₺', '$ ' + fmt(yi.netUSD) + ' | € ' + fmt(yi.netEUR) + ' | ' + yi.adet + ' belge', 'fa-home', brutYazi(yi));
            h += widget('bg-grad-info', 'Yurt Dışı / İhracat NET (grup içi hariç)', fmt(yd.netTL) + ' ₺', '$ ' + fmt(yd.netUSD) + ' | € ' + fmt(yd.netEUR) + ' | ' + yd.adet + ' belge', 'fa-globe', brutYazi(yd));
            h += widget('bg-grad-purple', 'Grup İçi (bakiyeye dahil değil)', fmt(grup.netTL) + ' ₺', '$ ' + fmt(grup.netUSD) + ' | € ' + fmt(grup.netEUR) + ' | ' + grup.adet + ' belge', 'fa-sitemap', 'Kendi şirketlerimize satış — hiçbir net toplama katılmaz');
            h += widget('bg-grad-dark', 'GENEL NET TOPLAM (grup içi hariç)', fmt(genel.netTL) + ' ₺', '$ ' + fmt(genel.netUSD) + ' | € ' + fmt(genel.netEUR) + ' | Hariç: ' + genel.haricAdet, 'fa-calculator', brutYazi(genel));
            h += '</div>';
            h += '<div class="row g-3 mb-3">';
            h += widget('bg-grad-primary', 'YI - Avrasya NET', fmt(avr.netTL) + ' ₺', '$ ' + fmt(avr.netUSD) + ' | ' + avr.adet + ' belge', 'fa-building', brutYazi(avr));
            h += widget('bg-grad-success', 'YI - Asia NET', fmt(asia.netTL) + ' ₺', '$ ' + fmt(asia.netUSD) + ' | ' + asia.adet + ' belge', 'fa-building', brutYazi(asia));
            h += widget('bg-grad-warning', 'YI - Operasyon (MO) NET', fmt(op.netTL) + ' ₺', '$ ' + fmt(op.netUSD) + ' | ' + op.adet + ' belge', 'fa-truck', brutYazi(op));
            h += widget('bg-grad-primary', 'YI - Diğer Satışlar NET', fmt(yiD.netTL) + ' ₺', '$ ' + fmt(yiD.netUSD) + ' | ' + yiD.adet + ' belge', 'fa-shopping-cart', brutYazi(yiD));
            h += widget('bg-grad-warning', 'YD - DRN NET', fmt(drn.netTL) + ' ₺', '$ ' + fmt(drn.netUSD) + ' | € ' + fmt(drn.netEUR) + ' | ' + drn.adet + ' belge', 'fa-building', brutYazi(drn));
            h += widget('bg-grad-info', 'YD - Diğer İhracat NET', fmt(ydD.netTL) + ' ₺', '$ ' + fmt(ydD.netUSD) + ' | € ' + fmt(ydD.netEUR) + ' | ' + ydD.adet + ' belge', 'fa-ship', brutYazi(ydD));
            h += '</div>';

            // Onay durumu
            h += '<div class="row g-3 mb-3">';
            [['YI', r.yurtIci.onay], ['YD', r.yurtDisi.onay]].forEach(function (p) {
                var k = p[0], on = p[1];
                h += '<div class="col-md-6"><div class="onay-kutu h-100 ' + (on.onayli ? 'onayli' : (on.acik ? '' : 'kapali')) + '">';
                h += '<div class="fw-bold"><i class="fas ' + (on.onayli ? 'fa-check-circle text-success' : 'fa-hourglass-half text-secondary') + ' me-1"></i>' + kanalAdi(k) + ' — ' + (on.onayli ? 'ONAYLANDI' : (on.acik ? 'ONAY BEKLİYOR' : 'Onay günü bekleniyor')) + '</div>';
                h += '<div class="small text-muted">Onay günü ' + esc(on.onayGunu) + ' (' + esc(on.onayGunuAdi) + ')' + (on.onayli ? ' | ' + esc(on.onaylayanKullanici) + ' — ' + esc(on.onayTarihi) + ' | ' + fmt(on.onayNetTL) + ' ₺' : '') + '</div>';
                h += '</div></div>';
            });
            h += '</div>';

            // Kırılım tablosu + grafikler
            h += '<div class="card card-dash mb-3"><div class="card-header-dash fw-bold text-primary"><i class="fas fa-layer-group me-2"></i>Kanal Kırılımı — NET; KDV, grup içi ve hariç tutulanlar düşülmüş</div><div class="table-wrapper" style="border:none;border-radius:0 0 10px 10px;max-height:none;">';
            h += '<table class="table-dash"><thead><tr><th>Kanal</th><th class="num">Fatura</th><th class="num">İade</th><th class="num">Taslak</th><th class="num">Hariç</th><th class="num">Net TL</th><th class="num">KDV TL</th><th class="num">Brüt TL</th><th class="num">Net USD</th><th class="num">Net EUR</th><th style="width:120px">Pay</th></tr></thead><tbody>';
            var genelTL = Math.abs(genel.netTL) || 1;
            o.kanallar.forEach(function (k) {
                var kalin = (k.kod === 'GENEL' || k.kod === 'YI' || k.kod === 'YD') ? ' fw-bold' : '';
                var girinti = (k.kod.indexOf('_') > 0) ? ' ps-4 text-muted' : '';
                if (k.grupDahil) girinti += ' fst-italic';
                var pay = k.kod === 'GENEL' ? 100 : Math.max(0, Math.min(100, Math.round(k.netTL / genelTL * 100)));
                h += '<tr class="' + (k.kod === 'GENEL' ? 'row-genel-toplam' : '') + '"><td class="' + kalin + girinti + '">' + esc(k.ad) + '</td><td class="num">' + k.faturaAdet + '</td><td class="num">' + k.iadeAdet + '</td><td class="num">' + (k.taslakAdet || 0) + '</td><td class="num">' + k.haricAdet + '</td>';
                h += '<td class="num' + kalin + '">' + fmt(k.netTL) + '</td><td class="num">' + fmt(k.kdvTL) + '</td><td class="num text-muted">' + fmt(k.brutTL) + '</td><td class="num">' + fmt(k.netUSD) + '</td><td class="num">' + fmt(k.netEUR) + '</td>';
                h += '<td><div class="kanal-bar"><div style="width:' + pay + '%;background:' + (k.kod === 'GENEL' ? '#212529' : (k.kod.indexOf('YD') === 0 ? '#11cdef' : '#4361ee')) + '"></div></div><div class="small text-muted">%' + pay + '</div></td></tr>';
            });
            h += '</tbody></table></div></div>';

            // Üç eşit kart: grafik | ilk 15 cari | para birimi
            h += '<div class="row g-3 mb-3">';
            h += '<div class="col-lg-4"><div class="card card-dash dash-kart"><div class="card-header-dash fw-bold text-primary"><i class="fas fa-chart-bar me-2"></i>Net TL Dağılımı</div><div class="dash-grafik"><canvas id="chartKanal"></canvas></div></div></div>';

            h += '<div class="col-lg-4"><div class="card card-dash dash-kart"><div class="card-header-dash fw-bold text-primary"><i class="fas fa-users me-2"></i>En Yüksek Ciro — İlk 15 Cari (grup içi hariç)</div><div class="dash-icerik table-wrapper">';
            h += '<table class="table-dash"><thead><tr><th>#</th><th>Cari</th><th class="num">Net TL</th><th class="num">Net USD</th></tr></thead><tbody>';
            o.topCariler.forEach(function (c, i) {
                var kanalNokta = c.kanal === 'YI' ? '<span class="badge bg-primary me-1" title="Yurt İçi">Yİ</span>' : '<span class="badge bg-info text-dark me-1" title="Yurt Dışı">YD</span>';
                h += '<tr><td>' + (i + 1) + '</td><td title="' + esc(c.cardCode + ' — ' + c.cardName + ' (' + c.adet + ' belge, € ' + fmt(c.netEUR) + ')') + '" style="max-width:170px;overflow:hidden;text-overflow:ellipsis;">' + kanalNokta + esc(c.cardName) + '</td><td class="num fw-bold">' + fmt(c.netTL) + '</td><td class="num">' + fmt(c.netUSD) + '</td></tr>';
            });
            if (!o.topCariler.length) h += '<tr><td colspan="4" class="text-center text-muted py-3">Veri yok</td></tr>';
            h += '</tbody></table></div></div></div>';

            h += '<div class="col-lg-4"><div class="card card-dash dash-kart"><div class="card-header-dash fw-bold text-primary"><i class="fas fa-coins me-2"></i>Belge Para Birimi Dağılımı</div>';
            h += '<div class="dash-grafik" style="flex:0 0 190px;"><canvas id="chartPB"></canvas></div>';
            h += '<div class="dash-icerik"><table class="table-dash"><thead><tr><th>PB</th><th class="num">Belge</th><th class="num">Net TL</th></tr></thead><tbody>';
            o.paraBirimleri.forEach(function (p) { h += '<tr><td>' + esc(p.paraBirimi) + '</td><td class="num">' + p.adet + '</td><td class="num">' + fmt(p.netTL) + '</td></tr>'; });
            h += '</tbody></table></div></div></div></div>';

            $('#pane-ozet').html(h);

            // Grafikler
            Object.keys(grafikler).forEach(function (k) { try { grafikler[k].destroy(); } catch (e) { } });
            grafikler = {};
            if (typeof Chart !== 'undefined') {
                grafikler.kanal = new Chart(document.getElementById('chartKanal'), {
                    type: 'bar',
                    data: {
                        labels: ['Avrasya', 'Asia', 'Operasyon', 'Diğer Satış', 'DRN', 'Diğer İhracat'],
                        datasets: [{ label: 'Net TL', data: [avr.netTL, asia.netTL, op.netTL, yiD.netTL, drn.netTL, ydD.netTL], backgroundColor: ['#1e88e5', '#2dce89', '#fd7e14', '#4361ee', '#e53950', '#11cdef'] }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { callbacks: { label: function (c) { return fmt(c.raw) + ' ₺'; } } } }, scales: { y: { ticks: { callback: function (v) { return fmt(v, 0); } } } } }
                });
                grafikler.pb = new Chart(document.getElementById('chartPB'), {
                    type: 'doughnut',
                    data: { labels: o.paraBirimleri.map(function (p) { return p.paraBirimi; }), datasets: [{ data: o.paraBirimleri.map(function (p) { return Math.abs(p.netTL); }), backgroundColor: ['#4361ee', '#2dce89', '#fb6340', '#11cdef', '#6f42c1', '#adb5bd'] }] },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right' }, tooltip: { callbacks: { label: function (c) { return c.label + ': ' + fmt(c.raw) + ' ₺'; } } } } }
                });
            }
        }

        // ------------------------------------------------------------------
        // FATURA DETAYI
        // ------------------------------------------------------------------
        function faturaDetay(objType, docEntry) {
            $('#detayBaslik').text('Belge Detayı');
            $('#detayIcerik').html('<div class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin me-1"></i>Yükleniyor...</div>');
            bootstrap.Modal.getOrCreateInstance(document.getElementById('detayModal')).show();
            $.getJSON('/Rapor150/FaturaDetay', { objType: objType, docEntry: docEntry }).done(function (r) {
                if (!r.success) { $('#detayIcerik').html('<div class="alert alert-danger">' + esc(r.message) + '</div>'); return; }
                var b = r.baslik;
                $('#detayBaslik').text((objType === '14' ? 'İade ' : (objType === 'T13' ? 'Taslak Fatura ' : 'Fatura ')) + b.DocNum + ' — ' + b.CardName);
                var h = '<div class="row g-2 small mb-3">';
                var alan = function (ad, v) { return '<div class="col-md-3"><div class="text-muted" style="font-size:.68rem;text-transform:uppercase">' + ad + '</div><div class="fw-bold">' + esc(v) + '</div></div>'; };
                h += alan('Belge No', b.DocNum) + alan('Tarih', tarihFmt(b.DocDate)) + alan('Vade', tarihFmt(b.DocDueDate)) + alan('Cari', b.CardCode + ' - ' + b.CardName);
                h += alan('Para Birimi', b.DocCur || 'TRY') + alan('Kur', fmt(b.DocRate, 4)) + alan('Net (TL)', fmt((b.DocTotal || 0) - (b.VatSum || 0))) + alan('KDV (TL)', fmt(b.VatSum));
                h += alan('Toplam (TL)', fmt(b.DocTotal)) + alan('Toplam (Belge PB)', fmt(b.DocTotalFC)) + alan('İskonto', fmt(b.DiscSum)) + alan('Temsilci', b.SlpName);
                h += alan('Müşteri Ref.', b.NumAtCard) + alan('İşlem Tipi', b.IslemTipi) + '<div class="col-md-6"><div class="text-muted" style="font-size:.68rem;text-transform:uppercase">Açıklama</div><div>' + esc(b.Comments) + '</div></div>';
                h += '</div>';
                h += '<div class="table-wrapper" style="max-height:420px"><table class="table-dash"><thead><tr><th>#</th><th>Kalem Kodu</th><th>Kalem Adı</th><th>Ürün Grubu</th><th>Depo</th><th class="num">Miktar</th><th>Birim</th><th class="num">Birim Fiyat</th><th class="num">İsk. %</th><th class="num">Net Birim</th><th class="num">Net TL</th><th class="num">KDV %</th><th class="num">KDV TL</th><th>PB</th><th class="num">Net (PB)</th></tr></thead><tbody>';
                var tNet = 0, tKdv = 0;
                r.kalemler.forEach(function (k) {
                    tNet += k.NetTL || 0; tKdv += k.KdvTL || 0;
                    h += '<tr><td>' + (k.LineNum + 1) + '</td><td>' + esc(k.ItemCode) + '</td><td>' + esc(k.KalemAdi) + '</td><td>' + esc(k.UrunGrubu) + '</td><td>' + esc(k.Depo) + '</td><td class="num">' + fmt(k.Miktar, 3) + '</td><td>' + esc(k.Birim) + '</td>';
                    h += '<td class="num">' + fmt(k.BirimFiyat, 4) + '</td><td class="num">' + fmt(k.Iskonto) + '</td><td class="num">' + fmt(k.NetBirimFiyat, 4) + '</td><td class="num fw-bold">' + fmt(k.NetTL) + '</td><td class="num">' + fmt(k.KdvOrani) + '</td><td class="num">' + fmt(k.KdvTL) + '</td><td>' + esc(k.ParaBirimi) + '</td><td class="num">' + fmt(k.NetFC) + '</td></tr>';
                });
                h += '</tbody><tfoot><tr><td colspan="10" class="text-end">TOPLAM</td><td class="num">' + fmt(tNet) + '</td><td></td><td class="num">' + fmt(tKdv) + '</td><td colspan="2"></td></tr></tfoot></table></div>';
                $('#detayIcerik').html(h);
            }).fail(function () { $('#detayIcerik').html('<div class="alert alert-danger">Detay alınamadı.</div>'); });
        }

        // ------------------------------------------------------------------
        // GRUP ŞİRKETLERİ
        // ------------------------------------------------------------------
        function grupListesiYukle() {
            $('#grupListe').html('<tr><td colspan="5" class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin"></i></td></tr>');
            $.getJSON('/Rapor150/GrupSirketleri').done(function (r) {
                if (!r.success) { toastr.error(r.message); return; }
                var h = '';
                r.liste.forEach(function (g) {
                    h += '<tr class="' + (g.aktif ? '' : 'text-muted') + '"><td>' + (g.tip === 'KOD' ? '<span class="badge bg-secondary">Kod</span>' : '<span class="badge bg-primary">Ad</span>') + '</td><td class="fw-bold">' + esc(g.deger) + '</td><td>' + esc(g.aciklama) + '</td>';
                    h += '<td class="text-center"><input type="checkbox" class="form-check-input" ' + (g.aktif ? 'checked' : '') + ' onchange="grupAktif(' + g.id + ', this.checked)"></td>';
                    h += '<td class="text-center"><button class="btn btn-sm btn-outline-danger py-0 px-2" onclick="grupSil(' + g.id + ', \'' + esc(g.deger).replace(/'/g, '&#39;') + '\')"><i class="fas fa-trash"></i></button></td></tr>';
                });
                $('#grupListe').html(h || '<tr><td colspan="5" class="text-center text-muted py-3">Liste boş.</td></tr>');
                var e = '';
                r.eslesen.forEach(function (c) { e += '<tr><td>' + esc(c.CardCode) + '</td><td>' + esc(c.CardName) + '</td><td>' + esc(c.Ulke) + '</td></tr>'; });
                $('#grupEslesen').html(e || '<tr><td colspan="3" class="text-center text-muted py-3">Eşleşen cari yok.</td></tr>');
                $('#grupEslesenAdet').text(r.eslesen.length);
            });
        }
        function grupAktif(id, aktif) {
            $.post('/Rapor150/GrupSirketAktif', { id: id, aktif: aktif }).done(function (r) { if (!r.success) toastr.error(r.message); else { toastr.success('Güncellendi.'); grupListesiYukle(); } });
        }
        function grupSil(id, ad) {
            Swal.fire({ title: ad + ' listeden çıkarılsın mı?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Çıkar', cancelButtonText: 'Vazgeç', confirmButtonColor: '#d33' }).then(function (s) {
                if (!s.isConfirmed) return;
                $.post('/Rapor150/GrupSirketSil', { id: id }).done(function (r) { if (!r.success) toastr.error(r.message); else { toastr.success('Çıkarıldı.'); grupListesiYukle(); } });
            });
        }

        // ------------------------------------------------------------------
        // ONAY GEÇMİŞİ
        // ------------------------------------------------------------------
        function onayGecmisiYukle() {
            $('#gecmisListe').html('<tr><td colspan="11" class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin"></i></td></tr>');
            $.getJSON('/Rapor150/OnayGecmisi').done(function (r) {
                if (!r.success) { toastr.error(r.message); return; }
                var h = '';
                r.liste.forEach(function (g) {
                    var d = String(g.Donem || '');
                    h += '<tr><td class="fw-bold">' + d.substr(4, 2) + '/' + d.substr(0, 4) + '</td><td>' + kanalAdi(g.Kanal) + '</td><td>' + (g.Onayli ? '<span class="badge bg-success">Onaylı</span>' : '<span class="badge bg-secondary">Geri alındı</span>') + '</td>';
                    h += '<td class="num">' + fmt(g.NetTL) + '</td><td class="num">' + fmt(g.NetUSD) + '</td><td class="num">' + fmt(g.NetEUR) + '</td><td class="num">' + (g.FaturaSayisi || 0) + '</td><td class="num">' + (g.HaricSayisi || 0) + '</td><td>' + esc(g.KullaniciKodu) + '</td><td>' + esc(g.IslemTarihi) + '</td><td>' + esc(g.Aciklama) + '</td></tr>';
                });
                $('#gecmisListe').html(h || '<tr><td colspan="11" class="text-center text-muted py-3">Henüz onay kaydı yok.</td></tr>');
            });
        }

        // ------------------------------------------------------------------
        // BAŞLANGIÇ
        // ------------------------------------------------------------------
        $(function () {
            $('#cbCariler').select2({ theme: 'bootstrap-5', placeholder: 'Cari seçin (boş = tümü)', allowClear: true, width: '100%' });
            $('#btnRunReport').on('click', raporCalistir);
            $('#txtAra').on('keydown', function (e) { if (e.key === 'Enter') raporCalistir(); });
            $('#txtDonem, #cbDocTur, #cbGrupIci, #cbOperasyon, #cbOnayDurumu, #chkFatura, #chkIade, #chkTaslak').on('change', raporCalistir);
            $('#btnClearFilters').on('click', function () {
                $('#txtDonem').val('@varsayilanDonem');
                $('#cbDocTur, #cbGrupIci, #cbOperasyon, #cbOnayDurumu').val('H');
                $('#chkFatura, #chkIade, #chkTaslak').prop('checked', true);
                $('#cbCariler').val(null).trigger('change');
                $('#txtAra').val('');
                raporCalistir();
            });
            $('#btnGrupSirketleri').on('click', function () { grupListesiYukle(); bootstrap.Modal.getOrCreateInstance(document.getElementById('grupModal')).show(); });
            $('#btnGrupEkle').on('click', function () {
                var deger = $('#grupDeger').val().trim();
                if (!deger) { toastr.warning('Desen / kod giriniz.'); return; }
                $.ajax({
                    url: '/Rapor150/GrupSirketEkle', type: 'POST', contentType: 'application/json',
                    data: JSON.stringify({ Tip: $('#grupTip').val(), Deger: deger, Aciklama: $('#grupAciklama').val() }),
                    success: function (r) { if (!r.success) toastr.error(r.message); else { toastr.success('Eklendi.'); $('#grupDeger, #grupAciklama').val(''); grupListesiYukle(); } }
                });
            });
            $('#grupModal').on('hidden.bs.modal', function () { if (sonVeri) raporCalistir(); });
            $('#btnOnayGecmisi').on('click', function () { onayGecmisiYukle(); bootstrap.Modal.getOrCreateInstance(document.getElementById('gecmisModal')).show(); });

            raporCalistir();
        });
    </script>
}
