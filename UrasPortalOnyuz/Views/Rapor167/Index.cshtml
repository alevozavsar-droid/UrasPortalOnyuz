@{
    ViewData["Title"] = "Gider Onay Ekranı";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool yetkili = (bool)(ViewBag.Yetkili ?? false);
}

<link href="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.css" rel="stylesheet" />

<style>
    .go-wrap { padding: 0 14px 30px; }
    .go-hero { background: linear-gradient(120deg, #4c1d95 0%, #7c3aed 55%, #a78bfa 100%); color: #fff; border-radius: 16px; padding: 16px 22px; margin: 14px 0 14px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; box-shadow: 0 10px 30px -12px rgba(124,58,237,.55); }
    .go-hero h1 { font-size: 1.25rem; font-weight: 700; margin: 0; }
    .go-hero p { margin: 3px 0 0; opacity: .92; font-size: .82rem; }
    .go-hero .go-rol { background: rgba(255,255,255,.18); padding: 8px 14px; border-radius: 10px; font-weight: 600; font-size: .86rem; }
    .go-tabs { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; align-items: center; }
    .go-tab { display: flex; align-items: center; gap: 8px; border: 1px solid #d7dce5; background: #fff; color: #475569; font-weight: 700; font-size: .88rem; padding: 9px 16px; border-radius: 11px 11px 0 0; cursor: pointer; }
    .go-tab .cnt { font-size: .72rem; background: #e2e8f0; color: #475569; border-radius: 20px; padding: 1px 9px; }
    .go-tab.active { background: #f5f3ff; border-color: #c4b5fd; color: #6d28d9; border-bottom-color: #f5f3ff; }
    .go-grid { display: grid; grid-template-columns: minmax(420px, 44fr) 56fr; gap: 12px; align-items: start; }
    @@media (max-width: 1100px) { .go-grid { grid-template-columns: 1fr; } }
    .go-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; box-shadow: 0 4px 14px -8px rgba(15,23,42,.15); overflow: hidden; }
    .go-card-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 14px; border-bottom: 1px solid #eef2f7; background: #f8fafc; font-weight: 700; font-size: .84rem; color: #334155; flex-wrap: wrap; }
    .go-listwrap { max-height: calc(100vh - 300px); overflow: auto; }
    table.go { width: 100%; border-collapse: collapse; font-size: .8rem; white-space: nowrap; }
    table.go thead th { position: sticky; top: 0; background: #f8fafc; color: #334155; font-weight: 700; font-size: .7rem; text-transform: uppercase; padding: 8px 10px; border-bottom: 2px solid #e2e8f0; text-align: left; z-index: 2; }
    table.go tbody td { padding: 7px 10px; border-bottom: 1px solid #f1f5f9; color: #1e293b; }
    table.go tbody tr { cursor: pointer; } table.go tbody tr:hover td { background: #faf5ff; } table.go tbody tr.aktif td { background: #ede9fe; }
    .txt-r { text-align: right; }
    .bd { display: inline-block; font-size: .66rem; font-weight: 700; padding: 2px 7px; border-radius: 20px; }
    .bd.bk { background: #fef3c7; color: #92400e; } .bd.on { background: #dcfce7; color: #166534; } .bd.rd { background: #fee2e2; color: #b91c1c; }
    .hcode { font-family: Consolas, monospace; font-weight: 700; color: #0f766e; }
    .go-empty { text-align: center; color: #94a3b8; padding: 40px 0; }
    .go-tabs2 { display: flex; gap: 4px; padding: 8px 10px 0; border-bottom: 1px solid #eef2f7; background: #fff; flex-wrap: wrap; }
    .go-tab2 { border: 1px solid transparent; border-bottom: none; background: transparent; color: #475569; font-weight: 700; font-size: .8rem; padding: 8px 14px; border-radius: 9px 9px 0 0; cursor: pointer; }
    .go-tab2.on { background: #f5f3ff; border-color: #c4b5fd; color: #6d28d9; }
    .go-pane { display: none; } .go-pane.on { display: block; }
    .go-kv { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 6px 14px; padding: 12px 14px; font-size: .8rem; }
    .go-kv div { display: flex; justify-content: space-between; gap: 8px; border-bottom: 1px dashed #eef2f7; padding: 3px 0; }
    .go-kv .k { color: #64748b; } .go-kv .v { font-weight: 600; color: #0f172a; text-align: right; }
    .go-sub { font-size: .74rem; font-weight: 700; color: #475569; text-transform: uppercase; padding: 10px 14px 4px; }
    .go-tbl { width: 100%; border-collapse: collapse; font-size: .78rem; }
    .go-tbl th { background: #f8fafc; text-align: left; padding: 6px 8px; border-bottom: 1px solid #e2e8f0; font-size: .68rem; text-transform: uppercase; color: #64748b; white-space: nowrap; }
    .go-tbl td { padding: 6px 8px; border-bottom: 1px solid #f1f5f9; }
    .go-tbl tr.secili td { background: #ede9fe; font-weight: 600; }
    .go-tbl tr.soluk td { color: #94a3b8; }
    .go-onay { padding: 12px 14px; border-top: 1px solid #eef2f7; background: #fafafa; display: grid; grid-template-columns: 1fr; gap: 8px; }
    .go-onay textarea { width: 100%; border: 1px solid #d7dce5; border-radius: 8px; padding: 8px 10px; font-size: .84rem; min-height: 70px; }
    .go-onay .btns { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .go-btn { border: none; border-radius: 9px; padding: 9px 16px; font-weight: 700; font-size: .84rem; cursor: pointer; }
    .go-btn.ok { background: #16a34a; color: #fff; } .go-btn.no { background: #fff; color: #b91c1c; border: 1px solid #fca5a5; }
    .kod-btn { display: inline-flex; align-items: center; gap: 8px; min-width: 260px; text-align: left; border: 1px solid #d7dce5; background: #fff; border-radius: 8px; padding: 6px 10px; cursor: pointer; font-family: inherit; }
    .kod-btn .k { font-family: Consolas, monospace; font-weight: 700; color: #1d4ed8; font-size: .78rem; } .kod-btn .a { font-size: .72rem; color: #475569; flex: 1; }
    .go-fbtn { border: 1px solid #d7dce5; background: #fff; color: #334155; border-radius: 8px; padding: 6px 12px; font-size: .78rem; font-weight: 600; cursor: pointer; text-decoration: none; }
    .go-fbtn.on, .go-fbtn:hover { background: #dc2626; border-color: #dc2626; color: #fff; }
    .go-arac { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; padding: 8px 12px; border-bottom: 1px solid #eef2f7; }
    .go-uyari { display: none; background: #fffbeb; border-bottom: 1px solid #fde68a; color: #92400e; font-size: .78rem; padding: 7px 12px; }
    #qnbCerceve { width: 100%; height: 1000px; border: 0; background: #e5e7eb; }
    .go-detay-bos { text-align: center; color: #94a3b8; padding: 70px 20px; font-size: .9rem; }
</style>

<div class="go-wrap">
    <div class="go-hero">
        <div>
            <h1><i class="fa-solid fa-clipboard-check"></i> Gider Onay Ekranı</h1>
            <p>Gider/Gelir Seçim ekranından size atanan belge satırları. Satırı, SAP detayını ve QNB fatura görüntüsünü inceleyip onay ya da red verin, açıklama yazın.</p>
        </div>
        <div class="go-rol"><i class="fa-solid fa-user"></i> @ViewBag.Kullanici @(yetkili ? "· tüm atamalar" : "· bana atananlar")</div>
    </div>

    <div class="go-tabs">
        <div class="go-tab active" data-d="BEKLIYOR"><i class="fa-solid fa-hourglass-half"></i> Bekleyen <span class="cnt" id="cntBEKLIYOR">0</span></div>
        <div class="go-tab" data-d="ONAYLANDI"><i class="fa-solid fa-check"></i> Onayladıklarım <span class="cnt" id="cntONAYLANDI">0</span></div>
        <div class="go-tab" data-d="RED"><i class="fa-solid fa-xmark"></i> Reddettiklerim <span class="cnt" id="cntRED">0</span></div>
        @if (yetkili)
        {
            <select id="fKullanici" style="margin-left:auto; border:1px solid #d7dce5; border-radius:8px; padding:7px 10px; font-size:.84rem;"><option value="">Tüm kullanıcılar</option></select>
        }
    </div>

    <div class="go-grid">
        <div class="go-card">
            <div class="go-card-head"><span><i class="fa-solid fa-list"></i> Atanan satırlar <span id="ozet" style="font-weight:500; color:#64748b;"></span></span></div>
            <div class="go-listwrap">
                <table class="go">
                    <thead><tr><th>Şirket</th><th>Belge</th><th>Tarih</th><th>Cari</th><th>Hesap</th><th class="txt-r">Tutar</th><th>Kod</th><th>Atayan</th></tr></thead>
                    <tbody id="liste"><tr><td colspan="8" class="go-empty">Yükleniyor...</td></tr></tbody>
                </table>
            </div>
        </div>

        <div class="go-card">
            <div class="go-card-head"><span id="detayBaslik"><i class="fa-solid fa-file-invoice"></i> Satır seçilmedi</span></div>
            <div class="go-tabs2" id="detayTabs" style="display:none;">
                <button class="go-tab2 on" data-p="sap"><i class="fa-solid fa-table-list"></i> SAP Detayı</button>
                <button class="go-tab2" data-p="qnb"><i class="fa-solid fa-file-invoice-dollar"></i> QNB Fatura Görüntüsü</button>
            </div>
            <div id="detayBos" class="go-detay-bos"><i class="fa-solid fa-hand-pointer fa-2x" style="margin-bottom:10px; display:block;"></i>Soldaki listeden bir satır seçin.</div>
            <div class="go-pane" id="paneSap"></div>
            <div class="go-pane" id="paneQnb">
                <div class="go-arac">
                    <button type="button" class="go-fbtn on" id="qnbHtml"><i class="fa-solid fa-file-invoice-dollar"></i> Gerçek Görüntü</button>
                    <button type="button" class="go-fbtn" id="qnbPdf"><i class="fa-solid fa-file-pdf"></i> PDF</button>
                    <a id="qnbYeni" class="go-fbtn" href="#" target="_blank"><i class="fa-solid fa-up-right-from-square"></i> Yeni sekmede aç</a>
                </div>
                <div class="go-uyari" id="qnbUyari"></div>
                <iframe id="qnbCerceve" src="about:blank"></iframe>
            </div>
            <div class="go-onay" id="onayAlan" style="display:none;">
                <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                    <span style="font-size:.78rem; color:#475569; font-weight:700;">Gider / gelir kodu (isteğe bağlı, onayla birlikte SAP satırına yazılır):</span>
                    <button type="button" class="kod-btn" id="onayKodBtn" data-kod=""><span class="a">Kod seç...</span><i class="fa-solid fa-chevron-down"></i></button>
                </div>
                <textarea id="onayAciklama" placeholder="Açıklama (zorunlu): satırı neden onaylıyor / reddediyorsunuz?"></textarea>
                <div class="btns">
                    <button class="go-btn ok" id="btnOnayla"><i class="fa-solid fa-check"></i> Onayla</button>
                    <button class="go-btn no" id="btnReddet"><i class="fa-solid fa-xmark"></i> Reddet</button>
                    <span id="onayBilgi" style="font-size:.76rem; color:#64748b;"></span>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.js"></script>
<script src="~/js/gg-kod-secici.js?v=1"></script>
<script>
    toastr.options = { positionClass: "toast-bottom-right", timeOut: 5000, progressBar: true };
    const YETKILI = @(yetkili ? "true" : "false");
    let LISTE = [], aktif = 'BEKLIYOR', secili = null, KODLAR = {};
    function esc(s) { return (s == null ? "" : String(s)).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])); }
    function fmt(n) { return (Number(n) || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
    function tarih(s) { if (!s) return ''; const d = new Date(s); return isNaN(d) ? esc(s) : d.toLocaleDateString('tr-TR') + ' ' + d.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }

    function yukle() {
        const k = document.getElementById('fKullanici') ? document.getElementById('fKullanici').value : '';
        fetch(`/Rapor167/Liste?kullanici=${encodeURIComponent(k)}`).then(r => r.json()).then(res => {
            if (!res.success) { toastr.error(res.message); return; }
            LISTE = res.data || [];
            if (res.kullanicilar && document.getElementById('fKullanici')) { const s = document.getElementById('fKullanici'); const eski = s.value; s.innerHTML = '<option value="">Tüm kullanıcılar</option>' + res.kullanicilar.map(x => `<option value="${esc(x.kod)}" ${x.kod === eski ? 'selected' : ''}>${esc(x.kod)} — ${esc(x.ad)}</option>`).join(''); }
            ['BEKLIYOR', 'ONAYLANDI', 'RED'].forEach(d => document.getElementById('cnt' + d).textContent = LISTE.filter(a => a.durum === d).length);
            render();
        }).catch(e => toastr.error('Yüklenemedi: ' + e));
    }
    function render() {
        const arr = LISTE.filter(a => a.durum === aktif);
        const tb = document.getElementById('liste');
        document.getElementById('ozet').textContent = `(${arr.length})`;
        if (!arr.length) { tb.innerHTML = '<tr><td colspan="8" class="go-empty">Kayıt yok.</td></tr>'; return; }
        tb.innerHTML = arr.map(a => `<tr data-id="${a.id}" class="${secili && secili.id === a.id ? 'aktif' : ''}">
            <td style="font-size:.72rem; color:#64748b;">${esc(a.sirketDb || a.dbKey)}</td><td><b>${esc(a.belgeNo)}</b><br><span style="font-size:.68rem; color:#64748b;">${esc(a.belgeTuru)}</span></td><td>${esc(a.tarih)}</td>
            <td><div style="max-width:200px; overflow:hidden; text-overflow:ellipsis;">${esc(a.cari)}</div></td><td><span class="hcode">${esc(a.hesapKodu)}</span><br><span style="font-size:.68rem; color:#64748b;">${esc(a.hesapAdi)}</span></td>
            <td class="txt-r">${fmt(a.tutar)}</td><td>${a.onayKod || a.kod ? '<span class="hcode">' + esc(a.onayKod || a.kod) + '</span>' : '<span class="bd rd">kod yok</span>'}</td>
            <td style="font-size:.72rem;">${esc(a.atayan)}<br><span style="color:#94a3b8;">${tarih(a.atamaTarihi)}</span>${a.atamaNotu ? '<br><i>' + esc(a.atamaNotu) + '</i>' : ''}</td>
        </tr>`).join('');
        tb.querySelectorAll('tr').forEach(tr => tr.addEventListener('click', () => sec(LISTE.find(x => x.id === parseInt(tr.dataset.id)))));
    }
    document.querySelectorAll('.go-tab').forEach(t => t.addEventListener('click', function () { document.querySelectorAll('.go-tab').forEach(x => x.classList.remove('active')); this.classList.add('active'); aktif = this.dataset.d; render(); }));
    if (document.getElementById('fKullanici')) document.getElementById('fKullanici').addEventListener('change', yukle);

    function tabAc(p) {
        document.querySelectorAll('.go-tab2').forEach(t => t.classList.toggle('on', t.dataset.p === p));
        document.getElementById('paneSap').classList.toggle('on', p === 'sap'); document.getElementById('paneQnb').classList.toggle('on', p === 'qnb');
        if (p === 'qnb' && window.qnbBekliyor) { const f = window.qnbBekliyor; window.qnbBekliyor = null; f(); }
    }
    document.querySelectorAll('.go-tab2').forEach(t => t.addEventListener('click', () => tabAc(t.dataset.p)));

    function sec(a) {
        if (!a) return; secili = a;
        document.querySelectorAll('#liste tr').forEach(tr => tr.classList.toggle('aktif', parseInt(tr.dataset.id) === a.id));
        document.getElementById('detayBos').style.display = 'none'; document.getElementById('detayTabs').style.display = 'flex';
        document.getElementById('detayBaslik').innerHTML = `<i class="fa-solid fa-file-invoice"></i> ${esc(a.belgeTuru)} <b>${esc(a.belgeNo)}</b> · ${esc(a.cari)} · <span class="hcode">${esc(a.hesapKodu)}</span>`;
        const dbq = a.dbKey ? '&db=' + encodeURIComponent(a.dbKey) : '';
        const paneSap = document.getElementById('paneSap');
        paneSap.innerHTML = '<div class="go-detay-bos"><i class="fa-solid fa-spinner fa-spin"></i> SAP detayı yükleniyor...</div>';
        tabAc('sap');
        const kv = (k, v) => `<div><span class="k">${k}</span><span class="v">${v == null || v === '' ? '—' : v}</span></div>`;
        fetch(`/Rapor163/BelgeDetay?transId=${a.transId}${dbq}`).then(r => r.json()).then(res => {
            if (!res.success) { paneSap.innerHTML = `<div class="go-detay-bos">${esc(res.message)}</div>`; return; }
            let h = `<div class="go-kv">${kv('Belge', esc(res.baslik) + ' ' + esc(res.belgeNo))}${kv('Tarih', esc(res.tarih))}${kv('Cari', esc(res.cari))}${kv('Atanan satır hesabı', '<span class="hcode">' + esc(a.hesapKodu) + '</span> ' + esc(a.hesapAdi))}${kv('Satır tutarı', fmt(a.tutar))}${kv('Mevcut kod', a.kod ? '<span class="hcode">' + esc(a.kod) + '</span>' : '<span style="color:#b91c1c">yok</span>')}${kv('Atayan', esc(a.atayan) + ' · ' + tarih(a.atamaTarihi))}${a.atamaNotu ? kv('Atama notu', esc(a.atamaNotu)) : ''}${a.durum !== 'BEKLIYOR' ? kv('Karar', esc(a.durum) + ' · ' + tarih(a.onayTarihi) + '<br><i>' + esc(a.onayAciklama) + '</i>') : ''}</div>`;
            if (res.kalemler && res.kalemler.length) h += `<div class="go-sub">Fatura kalemleri (${res.kalemler.length})</div><div style="overflow:auto;"><table class="go-tbl"><thead><tr><th>Kod</th><th>Kalem</th><th class="txt-r">Miktar</th><th class="txt-r">Birim Fiyat</th><th class="txt-r">Tutar</th><th>KDV</th><th>Hesap</th><th>Gider / Gelir Kodu</th></tr></thead><tbody>` + res.kalemler.map(k => `<tr class="${k.secilebilir === false ? 'soluk' : ''}"><td>${esc(k.kod)}</td><td>${esc(k.ad)}</td><td class="txt-r">${fmt(k.miktar)}</td><td class="txt-r">${fmt(k.birimFiyat)}</td><td class="txt-r">${fmt(k.tutar)}</td><td>${esc(k.kdvKodu || '')}</td><td>${k.hesapKodu ? '<span class="hcode">' + esc(k.hesapKodu) + '</span> ' + esc(k.hesapAdi) : '—'}</td><td>${k.ggKod ? '<span class="hcode">' + esc(k.ggKod) + '</span>' : (k.secilebilir === false ? '<span style="color:#94a3b8;">gerekmez</span>' : '<span class="bd rd">kod yok</span>')}</td></tr>`).join('') + '</tbody></table></div>';
            if (res.fisSatirlari && res.fisSatirlari.length) h += `<div class="go-sub">Yevmiye fişi — tüm satırlar (atanan satır vurgulu)</div><div style="overflow:auto;"><table class="go-tbl"><thead><tr><th>Hesap / Cari</th><th>Ad</th><th class="txt-r">Borç</th><th class="txt-r">Alacak</th><th>Açıklama</th><th>Kod</th></tr></thead><tbody>` + res.fisSatirlari.map(s => `<tr class="${s.lineId === a.lineId ? 'secili' : (s.secilebilir === false ? 'soluk' : '')}"><td class="hcode">${esc(s.cariKodu || s.hesapKodu)}</td><td>${esc(s.cariAdi || s.hesapAdi)}</td><td class="txt-r">${s.borc ? fmt(s.borc) : '—'}</td><td class="txt-r">${s.alacak ? fmt(s.alacak) : '—'}</td><td>${esc(s.aciklama)}</td><td>${s.ggKod ? '<span class="hcode">' + esc(s.ggKod) + '</span>' : ''}</td></tr>`).join('') + '</tbody></table></div>';
            paneSap.innerHTML = h;
        }).catch(e => { paneSap.innerHTML = `<div class="go-detay-bos">Hata: ${esc(e)}</div>`; });
        // QNB görüntüsü (sekmeye geçince kontrol edilir)
        const htmlUrl = `/Rapor163/FaturaGoruntu?transId=${a.transId}${dbq}`, pdfUrl = `/Rapor163/FaturaGoruntu?transId=${a.transId}&format=PDF${dbq}`;
        const c = document.getElementById('qnbCerceve'), uy = document.getElementById('qnbUyari'); c.removeAttribute('srcdoc'); c.src = 'about:blank'; uy.style.display = 'none';
        const goster = (url, btn) => { c.removeAttribute('srcdoc'); c.src = url; document.getElementById('qnbYeni').href = url; document.querySelectorAll('#paneQnb .go-fbtn').forEach(x => x.classList.remove('on')); if (btn) document.getElementById(btn).classList.add('on'); };
        document.getElementById('qnbHtml').onclick = () => goster(htmlUrl, 'qnbHtml'); document.getElementById('qnbPdf').onclick = () => goster(pdfUrl, 'qnbPdf');
        window.qnbBekliyor = () => {
            uy.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> QNB kontrol ediliyor...'; uy.style.display = 'block';
            fetch(`/Rapor163/FaturaGoruntuDurum?transId=${a.transId}${dbq}`).then(r => r.json()).then(d => {
                if (d && d.bulundu) { uy.style.display = 'none'; goster(htmlUrl, 'qnbHtml'); return; }
                uy.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> <b>QNB görüntüsü bulunamadı:</b> ' + esc((d && d.mesaj) || '') + (d && d.ipucu ? ' — ' + esc(d.ipucu) : ''); uy.style.display = 'block';
                c.srcdoc = '<div style="font-family:Segoe UI,Arial;padding:40px;color:#64748b;text-align:center">Belge görüntüsü QNB\'de bulunamadı (manuel yevmiye ya da e-belge değil).</div>';
            }).catch(() => { uy.innerHTML = 'QNB kontrolü yapılamadı.'; uy.style.display = 'block'; });
        };
        // Onay alanı
        document.getElementById('onayAlan').style.display = a.durum === 'BEKLIYOR' ? 'grid' : 'none';
        document.getElementById('onayAciklama').value = ''; document.getElementById('onayBilgi').textContent = '';
        kodButonu(a.kod || '');
        kodlariYukle(a.dbKey);
    }
    let KODLAR_DB = null, TUM_KODLAR = [];
    function kodButonu(kod) {
        const kb = document.getElementById('onayKodBtn'); kb.dataset.kod = kod || '';
        kb.innerHTML = kod ? `<span class="k">${esc(kod)}</span><span class="a">${esc(KODLAR[kod] || '')}</span><i class="fa-solid fa-chevron-down"></i>` : '<span class="a">Kod seç...</span><i class="fa-solid fa-chevron-down"></i>';
    }
    function kodlariYukle(dbKey) {
        if (KODLAR_DB === dbKey) return;
        fetch(`/Rapor164/Kodlar?db=${encodeURIComponent(dbKey || '')}`).then(r => r.json()).then(res => { if (res.success) { KODLAR_DB = dbKey; TUM_KODLAR = res.data || []; KODLAR = {}; TUM_KODLAR.forEach(k => KODLAR[k.kod] = k.ad); if (secili) kodButonu(document.getElementById('onayKodBtn').dataset.kod); } });
    }
    document.getElementById('onayKodBtn').addEventListener('click', function () {
        if (!secili) return;
        GGSecici.ac({ kodlar: TUM_KODLAR, tip: GGSecici.hesapTipi(secili.hesapKodu), secili: this.dataset.kod, baslik: 'Satır için kod', onSec: kod => kodButonu(kod || '') });
    });
    function karar(durum) {
        if (!secili) return;
        const aciklama = document.getElementById('onayAciklama').value.trim();
        if (!aciklama) { toastr.warning('Açıklama zorunlu.'); document.getElementById('onayAciklama').focus(); return; }
        const kod = durum === 'ONAYLANDI' ? document.getElementById('onayKodBtn').dataset.kod : '';
        fetch('/Rapor167/OnayVer', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: secili.id, durum, aciklama, kod }) })
            .then(r => r.json()).then(res => { if (res.success) { toastr.success(res.message); secili = null; document.getElementById('onayAlan').style.display = 'none'; yukle(); } else toastr.error(res.message, '', { timeOut: 9000 }); })
            .catch(e => toastr.error('Hata: ' + e));
    }
    document.getElementById('btnOnayla').addEventListener('click', () => karar('ONAYLANDI'));
    document.getElementById('btnReddet').addEventListener('click', () => karar('RED'));
    yukle();
</script>
