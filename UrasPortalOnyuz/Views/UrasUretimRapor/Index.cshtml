@{
    ViewData["Title"] = "Uras Üretim Raporları";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0 text-gray-800 fw-bold"><i class="fas fa-bar-chart me-2 text-primary"></i> Uras Üretim &ndash; Rapor Merkezi</h2>
</div>
<p class="text-muted mb-4">Üretim, hammadde tüketimi, parti yaşlandırma, silo ve lot sıra denetimi raporları.</p>

<div class="row g-3">
    <div class="col-12 col-md-6 col-xl-4">
        <a href="@Url.Action("StokYasi")" class="card dash-card text-decoration-none h-100 border-start border-4 border-warning">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-box bg-gradient-warning"><i class="fas fa-hourglass-half"></i></div>
                <div>
                    <div class="fw-bold text-dark">Parti Yaşlandırma</div>
                    <div class="text-muted small">Depodaki partilerin yaşı, süresi dolanlar, FIFO için en eski partiler.</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <a href="@Url.Action("Silo")" class="card dash-card text-decoration-none h-100 border-start border-4 border-info">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-box bg-gradient-info"><i class="fas fa-database"></i></div>
                <div>
                    <div class="fw-bold text-dark">Silo Raporu</div>
                    <div class="text-muted small">Silo bazlı dolum / tüketim / boşaltma özetleri ve hareket defteri.</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <a href="@Url.Action("HammaddeTuketim")" class="card dash-card text-decoration-none h-100 border-start border-4 border-danger">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-box bg-gradient-danger"><i class="fas fa-droplet"></i></div>
                <div>
                    <div class="fw-bold text-dark">Hammadde Tüketim</div>
                    <div class="text-muted small">Dönem bazlı hammadde tüketimi, parti ve ürün kırılımı, kaynak dağılımı.</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <a href="@Url.Action("LotSira")" class="card dash-card text-decoration-none h-100 border-start border-4 border-secondary">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-box bg-gradient-dark"><i class="fas fa-list-ol"></i></div>
                <div>
                    <div class="fw-bold text-dark">Lot Sıra Kontrol</div>
                    <div class="text-muted small">Kazan/lot numaralarında atlama, mükerrer, lotsuz emir ve sayaç uyumsuzluğu.</div>
                </div>
            </div>
        </a>
    </div>
</div>

<style>
    .dash-card { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: transform .15s ease, box-shadow .15s ease; }
    .dash-card:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(0,0,0,0.08); }
    .icon-box { width: 46px; height: 46px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
    .bg-gradient-warning { background: linear-gradient(45deg, #f6c23e, #dda20a); color: #fff; }
    .bg-gradient-info { background: linear-gradient(45deg, #36b9cc, #258391); color: #fff; }
    .bg-gradient-danger { background: linear-gradient(45deg, #e74a3b, #be2617); color: #fff; }
    .bg-gradient-dark { background: linear-gradient(45deg, #343a40, #1d2124); color: #fff; }
</style>
