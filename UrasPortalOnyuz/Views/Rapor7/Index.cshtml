        }

            .alert-success.show, .alert-danger.show {
                opacity: 1;
                transform: translateY(0);
            }

        .multi-select-options {
            display: none;
            position: absolute;
            background-color: var(--white-bg);
            min-width: fit-content;
            max-width: 350px;
            box-shadow: var(--shadow-medium);
            z-index: 9999; /* daha yüksek z-index */
