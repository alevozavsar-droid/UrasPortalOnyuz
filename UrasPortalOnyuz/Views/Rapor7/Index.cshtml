            padding: 10px;
            max-height: 350px;
            overflow-y: auto;
            left: 0;
            top: 100%;
            border: 1px solid var(--border-color);
            transform: translateY(10px);
            opacity: 0;
            transition: transform 0.3s ease-out, opacity 0.3s ease-out;
        }

        .multi-select-button {
            width: 100%;
            height: 40px;
            padding: 8px 12px;
            font-size: 0.95rem;
            line-height: 1.5;
            border: 1px solid var(--border-color);
            border-radius: 6px; /* Daha fazla yuvarlama */
            background-color: var(--white-bg);
            cursor: pointer;
            text-align: left;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s ease-in-out;
        }

            .multi-select-button:hover {
                border-color: var(--primary-color);
                box-shadow: 0 2px 8px rgba(0, 123, 255, 0.1);
            }

            .multi-select-button::after {
                display: inline-block;
                margin-left: 0.5em; /* Ok için daha fazla boşluk */
                vertical-align: middle;
                content: "";
                border-top: 0.3em solid var(--secondary-color); /* Ok rengini değiştirdik */
                border-right: 0.3em solid transparent;
                border-bottom: 0;
                border-left: 0.3em solid transparent;
                transition: transform 0.2s ease-in-out;
            }

            .multi-select-button[aria-expanded="true"]::after { /* Açıkken ok yönü değişsin */
                transform: rotate(180deg);
            }

        .multi-select-options.show {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }

        .multi-select-option {
            padding: 6px 0; /* Daha fazla dikey boşluk */
