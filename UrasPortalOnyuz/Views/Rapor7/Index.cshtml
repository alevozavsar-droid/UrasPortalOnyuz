@model List<WebApplication3.Models.StockMovementAnalysisViewModel>
@using WebApplication3.Models
@using Microsoft.AspNetCore.Http
@using System.Globalization

@{
    ViewData["Title"] = "Stok Hareket Analizi Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 1. KURAL: URL'den veya Cookie'den aktif şirketi okuyan değişken
    var currentDb = Context.Request.Query["db"].FirstOrDefault() ?? Context.Request.Cookies["AktifSirket"] ?? "";

    var currentSelectedDbKey = (string)ViewBag.SelectedDatabaseKey ?? "DefaultConnection";
    var currentSelectedDbDisplay = (string)ViewBag.CurrentDbDisplay ?? "URASKIMYA";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #007bff; /* Bootstrap primary */
            --secondary-color: #6c757d; /* Bootstrap secondary */
            --success-color: #28a745; /* Bootstrap success */
            --danger-color: #dc3545; /* Bootstrap danger */
            --info-color: #17a2b8; /* Bootstrap info */
            --light-bg: #f8f9fa; /* Açık gri arka plan */
            --white-bg: #ffffff; /* Beyaz kart arka planı */
            --border-color: #e0e0e0; /* Yumuşak kenarlık */
            --text-color: #333;
            --header-bg: #e9ecef; /* Başlıklar için hafif gri */
            --shadow-light: 0 2px 8px rgba(0,0,0,0.05);
            --shadow-medium: 0 4px 15px rgba(0,0,0,0.1);
        }

        body {
            background-color: var(--light-bg);
            font-family: 'Poppins', sans-serif; /* Daha modern bir font */
