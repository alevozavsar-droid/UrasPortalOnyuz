@{
    ViewData["Title"] = "Sigorta ve Kasko Poliçe Takibi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string onSekme = (string)ViewBag.Sekme ?? "policeler";
    string onPlaka = (string)ViewBag.Plaka ?? "";
    string onId = (string)ViewBag.Id ?? "";
    string onSirket = (string)ViewBag.Sirket ?? "";
    string onTur = (string)ViewBag.Tur ?? "";
    string ben = (string)ViewBag.Ben ?? "";
}
@*
    SİGORTA VE KASKO POLİÇE TAKİBİ — Yönetim › Şirket Dökümanları › Sigorta (İdari İşler › Araç ve Seyahat kısayolu). Tüm grup şirketlerinin poliçeleri: kasko, trafik, iş yeri, DASK,
    nakliyat, sorumluluk, makine kırılması, alacak, çevre, grup sağlık, ferdi kaza. Sekmeler: Poliçeler · 12 Aylık Taksit Takvimi (poliçe × ay; hücreden ödeme) · Araç Poliçeleri (plaka ×
    kasko / trafik) · Yenileme Takvimi · Yeni Poliçe (PDF yükleme, taksit planı) · Özet (tür / şirket / sigortacı). Çekmece: teminatlar, taksit planı (öde / geri al), hasarlar, dosyalar
    (poliçe PDF, dekont, zeyil yükleme), yenile, iptal, günlük. Veri: /Sigorta/Veri (Controllers/SigortaController.cs, Data/SigortaOrnek.cs) · betik: wwwroot/js/sigorta.js
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<style>
    .na.sg { --na-k: #0f766e; }
    .sg-pill { font-size: .66rem; font-weight: 700; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 3px 10px; } a.sg-pill { text-decoration: none; } a.sg-pill:hover { background: #ccfbf1; color: #134e4a; border-color: #99f6e4; }
    #sg .na-kpi { grid-template-columns: repeat(8, 1fr); } @@media (max-width: 1400px) { #sg .na-kpi { grid-template-columns: repeat(4, 1fr); } } #sg .na-kpi > div.aktif { outline: 2px solid var(--k, #0f766e); outline-offset: -1px; }
    .sg-filtre { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1.6fr auto; gap: 6px 8px; align-items: end; } @@media (max-width: 1300px) { .sg-filtre { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    .sg-filtre label, .sg-form label, .sg-ic label { display: block; font-size: .58rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 2px; }
    .sg-filtre .form-control, .sg-filtre .form-select, .sg-form .form-control, .sg-form .form-select, .sg-ic .form-control, .sg-ic .form-select { font-size: .72rem; padding: 3px 7px; height: 28px; }
    #sg .sg-tablo { font-size: .68rem; table-layout: fixed; width: 100%; }
    #sg .sg-tablo th { font-size: .56rem; padding: 5px 5px; white-space: normal; line-height: 1.15; vertical-align: middle; position: sticky; top: 0; z-index: 3; background: #f8fafc; box-shadow: 0 1px 0 #e2e8f0; }
    #sg .sg-tablo td { padding: 4px 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; vertical-align: middle; line-height: 1.2; border-bottom: 1px solid #e2e8f0; }
    #sg .sg-tablo td.sol { text-align: left !important; } #sg .sg-tablo td.para { font-variant-numeric: tabular-nums; text-align: right !important; font-weight: 700; }
    #sg .sg-tablo td small { display: block; font-size: .56rem; color: #64748b; font-weight: 500; line-height: 1.15; overflow: hidden; text-overflow: ellipsis; }
    #sg .sg-tablo tr.tik { cursor: pointer; } #sg .sg-tablo tr.tik:hover td { background: #f0fdfa; }
    #sg .sg-tablo tr.dolan td { background: #fef2f2; } #sg .sg-tablo tr.yaklasan td { background: #fffbeb; } #sg .sg-tablo tr.pasif td { background: #f8fafc; color: #94a3b8; } #sg .sg-tablo tr.geciken td { background: #fee2e2; }
    #sg .sg-tablo tr.ara td { background: #f1f5f9; font-weight: 800; border-top: 1px solid #cbd5e1; } #sg .sg-tablo tr.toplam td { font-weight: 800; background: #f8fafc; border-top: 2px solid var(--na-k); }
    .sg-rozet { display: inline-block; font-size: .58rem; font-weight: 800; border-radius: 4px; padding: 1px 6px; white-space: nowrap; } .sg-rozet.ok { background: #dcfce7; color: #166534; } .sg-rozet.uyar { background: #fef3c7; color: #92400e; } .sg-rozet.hata { background: #fee2e2; color: #991b1b; } .sg-rozet.bilgi { background: #dbeafe; color: #1e40af; } .sg-rozet.notr { background: #f1f5f9; color: #475569; } .sg-rozet.mor { background: #ede9fe; color: #5b21b6; }
    .sg-tur { display: inline-block; font-size: .56rem; font-weight: 800; border-radius: 4px; padding: 1px 6px; color: #fff; background: #64748b; white-space: nowrap; } .sg-tur.Kasko { background: #0f766e; } .sg-tur.Trafik { background: #1d4ed8; } .sg-tur.isyeri { background: #b45309; } .sg-tur.nakliyat { background: #7c3aed; } .sg-tur.sorumluluk { background: #be123c; } .sg-tur.saglik { background: #0369a1; }
    /* taksit ızgarası: poliçe × 12 ay; hücre tutar + durum rengi; tıklayınca öde */
    #sg .sg-taksit td { text-align: center !important; padding: 2px 3px; } .sg-t { display: block; font-size: .6rem; font-weight: 700; border-radius: 5px; padding: 2px 3px; line-height: 1.15; cursor: pointer; border: 1px solid transparent; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sg-t.odendi { background: #dcfce7; color: #166534; } .sg-t.bekliyor { background: #f1f5f9; color: #334155; } .sg-t.hafta { background: #dbeafe; color: #1e40af; } .sg-t.gecikti { background: #fee2e2; color: #991b1b; border-color: #fecaca; } .sg-t.yenileme { background: #ede9fe; color: #5b21b6; } .sg-t small { display: block; font-size: .52rem; font-weight: 600; opacity: .85; } .sg-t:hover { filter: brightness(.95); }
    #sg .btn-xs { font-size: .58rem; padding: 1px 6px; line-height: 1.3; }
    /* yenileme takvimi */
    .sg-takvim { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; } @@media (max-width: 1200px) { .sg-takvim { grid-template-columns: repeat(2, 1fr); } }
    .sg-ay { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 8px 10px; } .sg-ay.gecmis { border-color: #fecaca; background: #fef2f2; } .sg-ay .b { font-size: .72rem; font-weight: 800; color: #0f172a; display: flex; justify-content: space-between; } .sg-ay ul { list-style: none; margin: 4px 0 0; padding: 0; } .sg-ay li { font-size: .62rem; padding: 3px 0; border-top: 1px dashed #e2e8f0; cursor: pointer; line-height: 1.2; } .sg-ay li:hover { background: #f8fafc; } .sg-ay li small { display: block; color: #64748b; font-size: .56rem; }
    /* çekmece */
    .sg-drawer { position: fixed; top: 0; right: -860px; width: 820px; max-width: 97vw; height: 100vh; background: #fff; box-shadow: -8px 0 24px rgba(15,23,42,.18); z-index: 1060; transition: right .25s; overflow: auto; padding: 12px 14px; } .sg-drawer.acik { right: 0; }
    .main-content #sgDrawer { height: 100vh !important; max-height: 100vh !important; overflow: auto !important; }
    .sg-drawer-ust { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; position: sticky; top: 0; background: #fff; padding-bottom: 6px; border-bottom: 1px solid #e2e8f0; z-index: 2; flex-wrap: wrap; }
    .sg-perde { position: fixed; inset: 0; background: rgba(15,23,42,.35); z-index: 1055; display: none; } .sg-perde.acik { display: block; }
    .sg-ic { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px 8px; align-items: end; background: #f0fdfa; border: 1px solid #99f6e4; border-radius: 10px; padding: 8px 10px; } @@media (max-width: 900px) { .sg-ic { grid-template-columns: repeat(2, 1fr); } }
    .sg-form { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 6px 8px; align-items: end; } @@media (max-width: 1200px) { .sg-form { grid-template-columns: repeat(3, minmax(0, 1fr)); } } .sg-form .g2 { grid-column: span 2; } .sg-form .g3 { grid-column: span 3; } .sg-form .g6 { grid-column: span 6; }
    .sg-ilerleme { height: 8px; background: #e2e8f0; border-radius: 999px; overflow: hidden; } .sg-ilerleme i { display: block; height: 100%; background: #16a34a; }
    .sg-teminat { display: flex; flex-wrap: wrap; gap: 4px; } .sg-teminat span { font-size: .62rem; background: #f0fdfa; border: 1px solid #99f6e4; color: #134e4a; border-radius: 999px; padding: 2px 8px; }
</style>
}

<div class="container-fluid py-3 na sg" id="sg" data-sekme="@onSekme" data-plaka="@onPlaka" data-id="@onId" data-sirket="@onSirket" data-tur="@onTur">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-shield-halved"></i></span>Sigorta ve Kasko Poliçe Takibi</h4>
        <span class="sg-pill" id="sgKapsam">…</span>
        <a class="sg-pill" href="/AracBakim" target="_blank" rel="noopener"><i class="fas fa-car-wrench me-1"></i>Araç Bakım ve Onarım</a>
        <a class="sg-pill" href="/SirketDokuman/Sigorta" target="_blank" rel="noopener"><i class="fas fa-folder-tree me-1"></i>Şirket Dökümanları › Sigorta</a>
        <span class="sg-pill"><i class="fas fa-user me-1"></i>@ben</span>
        <span class="sub w-100">Tüm grup şirketlerinin sigorta ve kasko poliçeleri tek listede: poliçe detayları ve teminatlar, <b>poliçe PDF'i yüklenir</b>, <b>12 aylık taksit planı</b> poliçe × ay ızgarasında izlenir (hücreye tıklayınca taksit ödenir, dekont girilir); geciken taksitler kırmızı, bu hafta vadesi gelenler mavi. Bitişine 45 gün kalan poliçeler <b>Yenileme Yaklaşıyor</b>, dolanlar kırmızı; "Yenile" ile aynı konu ve teminatlarla yeni dönem poliçesi ve taksit planı açılır. Araç poliçeleri plaka ile Araç Bakım ekranına bağlıdır; hasar kayıtları poliçede tutulur.</span>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>

    <div class="na-kpi" id="sgKpi" data-dinamik="kapali"></div>

    <div class="na-sekme" id="sgSekmeler" data-dinamik="kapali">
        <button type="button" data-p="policeler" class="aktif"><i class="fas fa-list me-1"></i>Poliçeler <span class="n" id="sgN-policeler">0</span></button>
        <button type="button" data-p="taksit"><i class="fas fa-calendar-days me-1"></i>12 Aylık Taksit Takvimi <span class="n" id="sgN-taksit">0</span></button>
        <button type="button" data-p="araclar"><i class="fas fa-car me-1"></i>Araç Poliçeleri <span class="n" id="sgN-araclar">0</span></button>
        <button type="button" data-p="yenileme"><i class="fas fa-rotate me-1"></i>Yenileme Takvimi <span class="n" id="sgN-yenileme">0</span></button>
        <button type="button" data-p="yeni"><i class="fas fa-plus me-1"></i>Yeni Poliçe</button>
        <button type="button" data-p="ozet"><i class="fas fa-chart-pie me-1"></i>Özet</button>
    </div>

    <div class="na-panel aktif" data-p="policeler">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-list me-1"></i>Poliçe Listesi</span><span class="not" id="sgSayi"></span></div>
            <div class="na-kart-g">
                <div class="sg-filtre">
                    <div><label>Tür</label><select class="form-select" id="sgTurF"><option value="">Tümü</option></select></div>
                    <div><label>Sigortalı Şirket</label><select class="form-select" id="sgSirketF"><option value="">Tümü</option></select></div>
                    <div><label>Sigortacı</label><select class="form-select" id="sgSigortaciF"><option value="">Tümü</option></select></div>
                    <div><label>Durum</label><select class="form-select" id="sgDurumF"><option value="">Geçerli (Yenilenen / İptal Hariç)</option><option value="Aktif">Aktif</option><option value="Yenileme Yaklaşıyor">Yenileme Yaklaşıyor</option><option value="Süresi Doldu">Süresi Doldu</option><option value="geciken">Geciken Taksiti Olan</option><option value="hasarli">Hasar Kaydı Olan</option><option value="Yenilendi">Yenilendi (Eski Dönem)</option><option value="İptal">İptal</option></select></div>
                    <div><label>Plaka</label><select class="form-select" id="sgPlakaF"><option value="">Tümü</option></select></div>
                    <div><label>Ara</label><input class="form-control" id="sgAra" placeholder="Poliçe no, konu, sigortacı, plaka…" autocomplete="off"></div>
                    <div><label>&nbsp;</label><div class="d-flex gap-1"><button type="button" class="btn btn-light border btn-sm py-0" id="sgExcel" style="font-size:.66rem;height:28px"><i class="fas fa-file-excel me-1"></i>Excel</button><button type="button" class="btn btn-primary btn-sm py-0" id="sgYeniBtn" style="font-size:.66rem;height:28px"><i class="fas fa-plus me-1"></i>Yeni Poliçe</button></div></div>
                </div>
            </div>
            <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:64vh"><table class="na-tablo sg-tablo" id="sgTablo" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>

    <div class="na-panel" data-p="taksit">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-calendar-days me-1"></i>12 Aylık Taksit Takvimi · Poliçe × Ay</span><span class="not">yeşil ödendi · gri bekliyor · mavi bu hafta · kırmızı gecikti · mor yenileme ayı · hücreye tıklayınca taksit ödenir / poliçe açılır · süzgeçler Poliçeler sekmesinden</span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo sg-tablo sg-taksit" id="sgTaksitTablo" data-dinamik="kapali"><thead></thead><tbody></tbody><tfoot></tfoot></table></div></div>
        </div>
    </div>

    <div class="na-panel" data-p="araclar">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-car me-1"></i>Araç Poliçeleri · Kasko ve Trafik</span><span class="not">her araç için kasko / trafik bitişi, kalan gün, taksit durumu · satıra tıklayınca poliçe açılır</span></div>
            <div class="na-kart-g p-0"><div class="table-responsive" style="max-height:64vh"><table class="na-tablo sg-tablo" id="sgAracTablo" data-dinamik="kapali"><thead></thead><tbody></tbody></table></div></div>
        </div>
    </div>

    <div class="na-panel" data-p="yenileme">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-rotate me-1"></i>Yenileme Takvimi · Bitişi Yaklaşan Poliçeler</span><span class="d-flex gap-2 align-items-center"><span class="not">ay bazında · önce süresi dolmuşlar · tıklayınca poliçe açılır</span><select class="form-select" id="sgYenilemeAy" style="font-size:.66rem;height:24px;width:auto;padding:2px 20px 2px 6px"><option value="3">3 Ay</option><option value="6" selected>6 Ay</option><option value="12">12 Ay</option></select></span></div>
            <div class="na-kart-g"><div class="sg-takvim" id="sgYenileme"></div></div>
        </div>
    </div>

    <div class="na-panel" data-p="yeni">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-plus me-1"></i>Yeni Poliçe</span><span class="not">poliçe PDF'i yüklenir; taksit planı prim / taksit sayısına göre otomatik oluşur (ilk vade başlangıç + 5 gün)</span></div>
            <div class="na-kart-g">
                <form class="sg-form" id="sgForm" enctype="multipart/form-data" onsubmit="return false;">
                    <input type="hidden" id="ynId">
                    <div><label>Tür</label><select class="form-select" id="ynTur" name="Tur"></select></div>
                    <div><label>Sigortalı Şirket</label><select class="form-select" id="ynSirket" name="Sirket"></select></div>
                    <div><label>Araç (Kasko / Trafik)</label><select class="form-select" id="ynPlaka" name="Plaka"><option value="">—</option></select></div>
                    <div><label>Sigortacı</label><input class="form-control" id="ynSigortaci" name="Sigortaci" list="ynSigortacilar"><datalist id="ynSigortacilar"></datalist></div>
                    <div><label>Acente</label><input class="form-control" id="ynAcente" name="Acente" list="ynAcenteler"><datalist id="ynAcenteler"></datalist></div>
                    <div><label>Poliçe No</label><input class="form-control" id="ynNo" name="No" placeholder="boş = otomatik"></div>
                    <div class="g3"><label>Konu (Araç / Tesis / Kapsam)</label><input class="form-control" id="ynKonu" name="Konu"></div>
                    <div class="g3"><label>Riziko Adresi</label><input class="form-control" id="ynAdres" name="Adres"></div>
                    <div><label>Başlangıç</label><input type="date" class="form-control" id="ynBaslangic" name="Baslangic"></div>
                    <div><label>Bitiş</label><input type="date" class="form-control" id="ynBitis" name="Bitis"></div>
                    <div><label>Prim (₺)</label><input type="number" step="0.01" class="form-control" id="ynPrim" name="Prim"></div>
                    <div><label>Sigorta Bedeli (₺)</label><input type="number" step="1" class="form-control" id="ynBedel" name="SigortaBedeli"></div>
                    <div><label>Taksit Sayısı</label><select class="form-select" id="ynTaksit" name="TaksitSayisi"></select></div>
                    <div><label>Ödeme Yöntemi</label><select class="form-select" id="ynOdeme" name="OdemeYontemi"></select></div>
                    <div><label>İlk Taksit Vadesi</label><input type="date" class="form-control" id="ynIlkVade" name="IlkTaksitVadesi"></div>
                    <div><label>Muafiyet</label><input class="form-control" id="ynMuafiyet" name="Muafiyet"></div>
                    <div><label>Hasarsızlık Kademesi</label><input type="number" min="0" max="4" class="form-control" id="ynKademe" name="HasarsizlikKademesi"></div>
                    <div><label>Sorumlu</label><input class="form-control" id="ynSorumlu" name="Sorumlu" list="ynSorumlular"><datalist id="ynSorumlular"></datalist></div>
                    <div class="g2"><label>Poliçe Dosyası (PDF)</label><input type="file" class="form-control" id="ynDosya" name="dosya" accept=".pdf,.jpg,.jpeg,.png"></div>
                    <div class="g3"><label>Teminatlar (virgül ya da satır ile ayırın)</label><input class="form-control" id="ynTeminat" name="Teminatlar" placeholder="Çarpma, Hırsızlık, Yangın, Cam, İkame Araç…"></div>
                    <div class="g3"><label>Not</label><input class="form-control" id="ynNot" name="Not"></div>
                </form>
                <div class="text-muted mt-1" style="font-size:.64rem" id="ynPlan"></div>
                <div class="d-flex gap-2 align-items-center mt-2"><button type="button" class="btn btn-primary btn-sm" id="ynKaydet" style="font-size:.72rem"><i class="fas fa-floppy-disk me-1"></i>Kaydet</button><button type="button" class="btn btn-light border btn-sm" id="ynTemizle" style="font-size:.72rem">Temizle</button></div>
            </div>
        </div>
    </div>

    <div class="na-panel" data-p="ozet">
        <div class="row g-2">
            <div class="col-lg-4"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-tags me-1"></i>Tür Dağılımı</span></div><div class="na-kart-g p-0"><table class="na-tablo sg-tablo" id="sgOzetTur" data-dinamik="kapali"><thead><tr><th>Tür</th><th class="s">Poliçe</th><th class="s">Yıllık Prim (₺)</th></tr></thead><tbody></tbody></table></div></div></div>
            <div class="col-lg-4"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-building me-1"></i>Şirket Dağılımı</span></div><div class="na-kart-g p-0"><table class="na-tablo sg-tablo" id="sgOzetSirket" data-dinamik="kapali"><thead><tr><th>Şirket</th><th class="s">Poliçe</th><th class="s">Yıllık Prim (₺)</th><th class="s">Geciken</th></tr></thead><tbody></tbody></table></div></div></div>
            <div class="col-lg-4"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-umbrella me-1"></i>Sigortacı Dağılımı</span></div><div class="na-kart-g p-0"><table class="na-tablo sg-tablo" id="sgOzetSigortaci" data-dinamik="kapali"><thead><tr><th>Sigortacı</th><th class="s">Poliçe</th><th class="s">Yıllık Prim (₺)</th></tr></thead><tbody></tbody></table></div></div></div>
            <div class="col-12"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-chart-column me-1"></i>Önümüzdeki 12 Ay · Taksit Yükü ve Yenilemeler</span></div><div class="na-kart-g p-0"><table class="na-tablo sg-tablo" id="sgOzetAy" data-dinamik="kapali"><thead></thead><tbody></tbody></table></div></div></div>
        </div>
    </div>

    <div class="sg-perde" id="sgPerde"></div>
    <div class="sg-drawer" id="sgDrawer">
        <div class="sg-drawer-ust"><b id="sgDBaslik" style="font-size:.88rem"></b><span class="ms-auto"></span><button type="button" class="btn btn-light btn-sm py-0" id="sgDKapat" style="font-size:.66rem"><i class="fas fa-xmark"></i></button></div>
        <div id="sgDIc"></div>
    </div>
</div>
@section Scripts {
<script src="/js/sigorta.js?v=1"></script>
}
