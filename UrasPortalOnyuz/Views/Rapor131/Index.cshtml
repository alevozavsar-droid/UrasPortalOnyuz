@{
    ViewData["Title"] = "İthalat İşlemleri ve Satınalma Siparişi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var databases = (List<WebApplication3.Controllers.Rapor131Controller.DatabaseConfig>)ViewBag.Databases;
    var currentDbDisplay = (string)ViewBag.CurrentDbDisplay;
    var vendors = (List<WebApplication3.Controllers.Rapor131Controller.CustomerModel>)ViewBag.Vendors;
    var items = (List<WebApplication3.Controllers.Rapor131Controller.ItemModel>)ViewBag.Items;
    var accounts = (List<WebApplication3.Controllers.Rapor131Controller.GLAccountModel>)ViewBag.Accounts;
    var slps = (List<WebApplication3.Controllers.Rapor131Controller.SalesEmployeeModel>)ViewBag.SalesEmployees;
    var vatGroups = (List<WebApplication3.Controllers.Rapor131Controller.VatGroupModel>)ViewBag.VatGroups;
    var currencies = (List<string>)ViewBag.Currencies;
    var countries = (List<WebApplication3.Controllers.Rapor131Controller.CountryModel>)ViewBag.Countries;
    var states = (List<WebApplication3.Controllers.Rapor131Controller.StateModel>)ViewBag.States;
    var warehouses = (List<WebApplication3.Controllers.Rapor131Controller.WarehouseModel>)ViewBag.Warehouses; 
    var importFiles = (List<WebApplication3.Controllers.Rapor131Controller.ImportFileModel>)ViewBag.ImportFiles;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <style>
        :root { --form-bg: #ffffff; --border-soft: #e2e8f0; --primary-soft: #eff6ff; }
        
        .dashboard-section { border: 1px solid var(--border-soft); border-radius: 8px; margin-bottom: 1.5rem; background: var(--form-bg); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); transition: all 0.3s ease; }
        .dashboard-header { background: #f8fafc; padding: 1rem 1.5rem; border-bottom: 1px solid var(--border-soft); display: flex; justify-content: space-between; align-items: center; border-radius: 8px 8px 0 0; transition: background 0.2s; }
        .dashboard-header h5 { margin: 0; font-weight: 700; color: #1e293b; display: flex; align-items: center;}
        .dashboard-body { padding: 1.5rem; }
        
        /* Tam Ekran Modu İçin - Tablo Kayma ve Yarım Kalma Sorunu Çözümü (Flexbox) */
        .fullscreen-panel {
            position: fixed !important; top: 0 !important; left: 0 !important; width: 100% !important; height: 100% !important; /* zoom: vw/vh yerine % */
            z-index: 1050 !important; margin: 0 !important; border-radius: 0 !important; background: var(--form-bg);
            display: flex; flex-direction: column; overflow: hidden;
        }
        .fullscreen-panel .dashboard-body { flex-grow: 1; display: flex; flex-direction: column; overflow: hidden; padding-bottom: 0; }
        .fullscreen-panel form { display: flex; flex-direction: column; height: 100%; }
        .fullscreen-panel #orderTabsContent { flex-grow: 1; display: flex; flex-direction: column; min-height: 0; }
        .fullscreen-panel #lines-pane { flex-grow: 1; display: flex; flex-direction: column; min-height: 0; }
        .fullscreen-panel .table-responsive { flex-grow: 1; max-height: none !important; overflow-y: auto; border-bottom: 1px solid var(--border-soft); }
        
        .form-label { font-weight: 600; color: #475569; font-size: 0.85rem; margin-bottom: 0.3rem; }
        .table-modern { border-collapse: separate; border-spacing: 0; width: 100%; }
        .table-modern th { background-color: #f1f5f9; color: #475569; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; padding: 10px; border-bottom: 1px solid var(--border-soft); position: sticky; top: 0; z-index: 10;}
        .table-modern td { padding: 8px 10px; vertical-align: middle; border-bottom: 1px solid var(--border-soft); font-size: 0.85rem; }
        
        .table-input { border: 1px solid transparent; background: transparent; width: 100%; padding: 4px 8px; border-radius: 4px; transition: 0.2s; font-size: 0.85rem; }
        .table-input:focus, .table-input:hover { border-color: #cbd5e1; background: #fff; outline: none; }
        
        .select2-container--bootstrap-5 .select2-selection { font-size: 0.85rem; min-height: 34px; border-color: var(--border-soft); }
        
        .footer-totals-box { background: #f8fafc; border: 1px solid var(--border-soft); border-radius: 6px; padding: 1rem; width: 350px; float: right; height: 100%; }
        .footer-row { display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.85rem; color: #475569; }
        .footer-row.grand-total { font-weight: 700; font-size: 1rem; color: #0f172a; border-top: 1px solid var(--border-soft); padding-top: 0.5rem; margin-bottom: 0; }
        
        .action-bar { background: white; padding: 1rem 1.5rem; position: sticky; bottom: 0; z-index: 100; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 -4px 6px -1px rgba(0,0,0,0.05); margin-top: auto;}

        .view-mode .searchable-field, .view-mode textarea, .view-mode input { background-color: #f8fafc !important; cursor: not-allowed; pointer-events: none;}
        .find-mode .searchable-field { background-color: #fef9c3 !important; border-color: #fde047 !important; }
        
        /* VIEW modunda UDF ve Yorum alanlarının kilitlenmemesi için özel kural */
        .view-mode .editable-in-view { background-color: #fff !important; cursor: text !important; pointer-events: auto !important; border: 1px solid #94a3b8 !important; }

        .col-item, .col-service { display: none !important; }
        .table-mode-I .col-item { display: table-cell !important; }
        .table-mode-S .col-service { display: table-cell !important; }
        .view-mode .col-action, .find-mode .col-action { display: none !important; }
        
        /* Satınalma siparişi navigasyon butonları */
        .order-nav-group { margin-left: 1rem; }
    </style>
}

<div class="container-fluid py-4 pb-5 mb-5" id="mainContainer">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div class="d-flex align-items-center">
            <h4 class="mb-0 fw-bold text-dark"><i class="fas fa-ship text-primary me-2"></i>İthalat Yönetimi ve Sipariş</h4>
            <span class="badge bg-secondary fs-6 px-3 py-2 ms-3">@currentDbDisplay</span>
        </div>
    </div>

    <div id="loadingOverlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(255,255,255,0.8); z-index:9999; flex-direction:column; justify-content:center; align-items:center;">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
        <h5 class="mt-3 text-primary fw-bold">İşlem Yapılıyor...</h5>
    </div>

    <!-- 1. BÖLÜM: İTHALAT DOSYALARI (DASHBOARD) -->
    <div class="dashboard-section" id="importPanel">
        <div class="dashboard-header">
            <h5><i class="fas fa-folder-open text-warning me-2"></i>1. İthalat İşlemleri (Dosya Yönetimi)</h5>
            <div class="d-flex align-items-center">
                <button type="button" class="btn btn-sm btn-outline-secondary btn-fullscreen me-3" onclick="toggleFullscreen('importPanel')" title="Tam Ekran Göster/Kapat"><i class="fas fa-expand"></i></button>
                <i class="fas fa-chevron-down text-muted" data-bs-toggle="collapse" data-bs-target="#importDashboard" style="cursor:pointer;"></i>
            </div>
        </div>
        <div id="importDashboard" class="collapse show dashboard-body">
            <div class="d-flex justify-content-between mb-3">
                <h6 class="fw-bold text-muted">Mevcut İthalat Dosyaları</h6>
                <button type="button" class="btn btn-sm btn-primary fw-bold shadow-sm" id="btnOpenImportModal">
                    <i class="fas fa-plus me-1"></i> Yeni Dosya Aç
                </button>
            </div>
            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                <table class="table table-hover table-modern border mb-0" id="importTable">
                    <thead class="sticky-top">
                        <tr>
                            <th>Dosya No</th>
                            <th>Tedarikçi Kodu</th>
                            <th>Tedarikçi Adı</th>
                            <th>Defteri Kebir Kodu</th>
                            <th>Beyanname No (GTIP)</th>
                            <th>Durum</th>
                            <th class="text-end" style="width: 100px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="importTableBody">
                        @foreach(var file in importFiles)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@file.DosyaNo</td>
                                <td>@file.CardCode</td>
                                <td>@file.CardName</td>
                                <td>@file.AcctCode</td>
                                <td>@file.Gtip</td>
                                <td>
                                    @if(file.Durum == "Açık") { <span class="badge bg-success">Açık</span> }
                                    else { <span class="badge bg-secondary">@file.Durum</span> }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-light text-primary border" onclick="editImportFile(@file.DocEntry, '@file.DosyaNo', '@file.CardCode', '@file.AcctCode', '@file.Gtip', '@file.Durum')"><i class="fas fa-edit"></i></button>
                                    <button class="btn btn-sm btn-light text-danger border" onclick="deleteImportFile(@file.DocEntry)"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 2. BÖLÜM: SATINALMA SİPARİŞİ OLUŞTURMA -->
    <div class="dashboard-section" id="orderPanel">
        <div class="dashboard-header">
            <div class="d-flex align-items-center flex-wrap">
                <h5 class="mb-0">
                    <i class="fas fa-shopping-cart text-success me-2"></i>2. Satınalma Siparişi 
                    <span id="lblOrderDocNum" class="text-danger ms-2"></span>
                    <span id="lblOrderStatus" class="badge bg-info ms-2" style="font-size: 0.75rem; display:none;"></span>
                </h5>
                <!-- NAVİGASYON BUTONLARI BURAYA TAŞINDI -->
                <div class="btn-group shadow-sm border bg-white rounded order-nav-group" role="group">
                    <button type="button" class="btn btn-light btn-sm nav-btn" data-dir="first" title="İlk Kayıt"><i class="fas fa-fast-backward"></i></button>
                    <button type="button" class="btn btn-light btn-sm nav-btn" data-dir="prev" title="Önceki Kayıt"><i class="fas fa-step-backward"></i></button>
                    <button type="button" class="btn btn-light btn-sm nav-btn" data-dir="next" title="Sonraki Kayıt"><i class="fas fa-step-forward"></i></button>
                    <button type="button" class="btn btn-light btn-sm nav-btn" data-dir="last" title="Son Kayıt"><i class="fas fa-fast-forward"></i></button>
                    <button type="button" class="btn btn-light btn-sm" id="btnFindMode" title="Kayıt Bul"><i class="fas fa-search text-info"></i></button>
                    <button type="button" class="btn btn-light btn-sm text-success fw-bold" id="btnNewDoc" title="Yeni Kayıt Ekle"><i class="fas fa-plus"></i></button>
                </div>
            </div>
            
            <div class="d-flex align-items-center">
                <button type="button" class="btn btn-sm btn-outline-secondary btn-fullscreen me-3" onclick="toggleFullscreen('orderPanel')" title="Tam Ekran Göster/Kapat"><i class="fas fa-expand"></i></button>
                <i class="fas fa-chevron-down text-muted" data-bs-toggle="collapse" data-bs-target="#orderDashboard" style="cursor:pointer;"></i>
            </div>
        </div>
        <div id="orderDashboard" class="collapse show dashboard-body bg-light">
            <form id="orderForm">
                <div class="row g-4 mb-3 bg-white p-3 border rounded shadow-sm">
                    <div class="col-md-6">
                        <div class="row mb-3 align-items-center">
                            <label class="col-sm-4 form-label mb-0 text-muted">Satıcı <span class="text-danger">*</span></label>
                            <div class="col-sm-8">
                                <select id="CardCode" class="form-select select2-init searchable-field req-add">
                                    <option value="">Satıcı Seçiniz...</option>
                                    @foreach (var vendor in vendors)
                                    {
                                        <option value="@vendor.CardCode">@vendor.CardCode - @vendor.CardName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row mb-3 align-items-center">
                            <label class="col-sm-4 form-label mb-0 text-muted">Alıcı (Satınalmacı) <span class="text-danger">*</span></label>
                            <div class="col-sm-8">
                                <select id="SalesPersonCode" class="form-select select2-init searchable-field req-add">
                                    <option value="">Seçiniz...</option>
                                    @foreach (var slp in slps)
                                    {
                                        <option value="@slp.SlpCode">@slp.SlpName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row mb-3 align-items-center">
                            <label class="col-sm-4 form-label mb-0 text-muted">Para Birimi</label>
                            <div class="col-sm-4 pe-1">
                                <select id="CurrencyType" class="form-select form-select-sm searchable-field">
                                    <option value="BP">Muhatabın P.B.</option>
                                    <option value="LC">Ulusal P.B.</option>
                                </select>
                            </div>
                            <div class="col-sm-4 ps-1">
                                <select id="DocCurrency" class="form-select form-select-sm w-100 searchable-field">
                                    <option value="">Seçiniz</option>
                                    @foreach(var c in currencies) { <option value="@c">@c</option> }
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="row mb-2 align-items-center" id="divDocNumSearch" style="display: none;">
                            <label class="col-sm-4 form-label mb-0 text-md-end text-info fw-bold">Arama Belge No</label>
                            <div class="col-sm-8">
                                <input type="number" id="SearchDocNum" class="form-control form-control-sm border-info" placeholder="Bulmak için numara yazın" />
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center">
                            <label class="col-sm-4 form-label mb-0 text-md-end text-muted">Tarihler (Kayıt/Vade/Belge) <span class="text-danger">*</span></label>
                            <div class="col-sm-8 d-flex gap-1">
                                <input type="date" id="DocDate" class="form-control form-control-sm searchable-field req-add" title="Kayıt Tarihi" />
                                <input type="date" id="DocDueDate" class="form-control form-control-sm searchable-field req-add" title="Vade Tarihi" />
                                <input type="date" id="TaxDate" class="form-control form-control-sm searchable-field req-add" title="Belge Tarihi" />
                            </div>
                        </div>
                        
                        <div class="row mb-2 align-items-center">
                            <label class="col-sm-4 form-label mb-0 text-md-end text-primary">Sipariş Türü <span class="text-danger">*</span></label>
                            <div class="col-sm-8">
                                <select id="DocType" class="form-select form-select-sm fw-bold border-primary text-primary searchable-field req-add">
                                    <option value="I" selected>Kalem (Item)</option>
                                    <option value="S">Hizmet (Service)</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center">
                            <label class="col-sm-4 form-label mb-0 text-md-end text-primary">İşlem Tipi</label>
                            <div class="col-sm-8">
                                <select id="U_BE1_AKTAR" class="form-select form-select-sm searchable-field editable-in-view">
                                    <option value="">- Seçiniz -</option>
                                    <option value="X">X</option>
                                    <option value="R">R</option>
                                    <option value="Y">Y</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center">
                            <label class="col-sm-4 form-label mb-0 text-md-end text-primary">İthalat Dosya No</label>
                            <div class="col-sm-8">
                                <select id="U_BE1_AGENTNUM" class="form-select select2-init searchable-field editable-in-view">
                                    <option value="">- Dosya Seçiniz -</option>
                                    @foreach(var file in importFiles)
                                    {
                                        <option value="@file.DosyaNo">@file.DosyaNo (@file.CardName)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row mb-2 align-items-center mt-2">
                            <label class="col-sm-4 form-label mb-0 text-md-end text-muted">Belge Kuru</label>
                            <div class="col-sm-8">
                                <input type="text" id="ExchangeRate" class="form-control form-control-sm bg-light fw-bold" readonly value="1.0000" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SEKMELER (Satırlar ve Lojistik) -->
                <ul class="nav nav-tabs border-bottom-0 ps-3 flex-shrink-0" id="orderTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" id="lines-tab" data-toggle="tab" href="#lines-pane" role="tab">İçerikler (Satırlar)</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="logistics-tab" data-toggle="tab" href="#logistics-pane" role="tab">Lojistik Adresleri</a>
                    </li>
                </ul>

                <div class="tab-content border bg-white p-0" id="orderTabsContent">
                    <div class="tab-pane fade show active d-flex flex-column" id="lines-pane" role="tabpanel" style="height: 100%;">
                        <div class="p-2 bg-light border-bottom d-flex justify-content-between align-items-center flex-shrink-0" id="btnAddRowContainer">
                            <button type="button" class="btn btn-sm btn-info text-white fw-bold shadow-sm" id="btnOpenPRQModal">
                                <i class="fas fa-download me-1"></i> Açık Taleplerden Çek
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary bg-white fw-bold shadow-sm" id="btnAddRow">
                                <i class="fas fa-plus text-success me-1"></i> Satır Ekle
                            </button>
                        </div>
                        <div class="table-responsive flex-grow-1" style="min-height: 250px;">
                            <!-- table-mode-I sınıfı tabloya eklendi -->
                            <table class="table-modern border-0 table-mode-I" id="linesTable">
                                <thead>
                                    <tr>
                                        <th style="width: 40px;" class="text-center">#</th>
                                        <!-- Kalem Sütunları -->
                                        <th class="col-item" style="min-width: 200px;">Kalem No - Tanım <span class="text-danger">*</span></th>
                                        <th class="col-item" style="width: 120px;">Depo / Stok <span class="text-danger">*</span></th>
                                        
                                        <!-- Hizmet Sütunları -->
                                        <th class="col-service" style="min-width: 200px;">Hesap Kodu <span class="text-danger">*</span></th>
                                        <th class="col-service" style="width: 250px;">Tanım (Açıklama) <span class="text-danger">*</span></th>

                                        <!-- Ortak Sütunlar -->
                                        <th style="width: 110px;" class="text-end">Miktar <span class="text-danger">*</span></th>
                                        <th style="width: 150px;" class="text-end">Birim Fiyat & PB <span class="text-danger">*</span></th>
                                        <th style="width: 110px;">Vergi Kodu <span class="text-danger">*</span></th>
                                        <th style="width: 130px;" class="text-end">Top. (PB)</th>
                                        <th style="width: 130px;" class="text-end">Top. (TL)</th>
                                        <th style="width: 40px;" class="text-center col-action"><i class="fas fa-trash text-muted"></i></th>
                                    </tr>
                                </thead>
                                <tbody id="linesBody">
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="tab-pane fade p-4 flex-grow-1" id="logistics-pane" role="tabpanel" style="overflow-y:auto;">
                        <div class="row g-5">
                            <div class="col-md-6 address-box">
                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fas fa-map-marker-alt text-secondary me-2"></i>Sevkiyat Adresi</h6>
                                <select id="ShipToCode" class="form-select form-select-sm mb-3 searchable-field"><option value="">- Seçiniz -</option></select>
                                <div class="row g-2">
                                    <div class="col-12"><input type="text" id="ShipToStreet" class="form-control searchable-field" placeholder="Sokak / Adres" /></div>
                                    <div class="col-4"><input type="text" id="ShipToZipCode" class="form-control searchable-field" placeholder="Posta Kodu" /></div>
                                    <div class="col-4"><input type="text" id="ShipToCounty" class="form-control searchable-field" placeholder="İlçe" /></div>
                                    <div class="col-4"><input type="text" id="ShipToCity" class="form-control searchable-field" placeholder="İl" /></div>
                                    <div class="col-6">
                                        <select id="ShipToCountry" class="form-select select2-init searchable-field">
                                            <option value="">- Ülke -</option>
                                            @foreach (var c in countries) { <option value="@c.Code">@c.Name</option> }
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <select id="ShipToState" class="form-select select2-init searchable-field"><option value="">- Eyalet/İl -</option></select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 address-box">
                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fas fa-file-invoice text-secondary me-2"></i>Fatura Adresi</h6>
                                <select id="PayToCode" class="form-select form-select-sm mb-3 searchable-field"><option value="">- Seçiniz -</option></select>
                                <div class="row g-2">
                                    <div class="col-12"><input type="text" id="PayToStreet" class="form-control searchable-field" placeholder="Sokak / Adres" /></div>
                                    <div class="col-4"><input type="text" id="PayToZipCode" class="form-control searchable-field" placeholder="Posta Kodu" /></div>
                                    <div class="col-4"><input type="text" id="PayToCounty" class="form-control searchable-field" placeholder="İlçe" /></div>
                                    <div class="col-4"><input type="text" id="PayToCity" class="form-control searchable-field" placeholder="İl" /></div>
                                    <div class="col-6">
                                        <select id="PayToCountry" class="form-select select2-init searchable-field">
                                            <option value="">- Ülke -</option>
                                            @foreach (var c in countries) { <option value="@c.Code">@c.Name</option> }
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <select id="PayToState" class="form-select select2-init searchable-field"><option value="">- Eyalet/İl -</option></select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-3 flex-shrink-0" id="footerSection">
                    <div class="col-md-6">
                        <label class="form-label text-muted">Açıklamalar</label>
                        <textarea id="Comments" class="form-control bg-light shadow-sm editable-in-view" rows="4" style="resize:none;"></textarea>
                    </div>
                    <div class="col-md-6">
                        <div class="footer-totals-box shadow-sm border">
                            <div class="footer-row"><span>Net Toplam (TL)</span><span id="lblNetTotalLC">0,00 TRY</span></div>
                            <div class="footer-row"><span>Vergi (TL)</span><span id="lblTaxTotalLC">0,00 TRY</span></div>
                            <div class="footer-row grand-total mb-2"><span>Genel Toplam (TL)</span><span id="lblGrandTotalLC" class="text-success">0,00 TRY</span></div>
