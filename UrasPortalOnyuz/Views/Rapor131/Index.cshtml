@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        toastr.options = { positionClass: "toast-bottom-right", timeOut: "3000" };

        let currentBpCurrency = 'TRY'; 
        window.exchangeRates = { 'TRY': 1.0 }; 
        window.bpAddresses = []; 
        let currentMode = 'ADD'; 
        let isBindingData = false; 
        let isNavigating = false;
        let currentDocEntry = 0; 
        let loadedPRQs = []; 
        const allStates = @Html.Raw(Json.Serialize(states));

        const itemDict = {};
        @foreach(var item in items) {
            <text>itemDict['@item.ItemCode'] = '@item.ItemName.Replace("'", "\\'")';</text>
        }
        
        const accountDict = {};
        @foreach(var acc in accounts) {
            <text>accountDict['@acc.AcctCode'] = '@acc.AcctName.Replace("'", "\\'")';</text>
        }

        function formatNumber(num) { return num.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

        window.toggleFullscreen = function(panelId) {
            const panel = document.getElementById(panelId);
            if (panel.classList.contains('fullscreen-panel')) {
                panel.classList.remove('fullscreen-panel');
                document.body.style.overflow = '';
            } else {
                panel.classList.add('fullscreen-panel');
                document.body.style.overflow = 'hidden';
            }
        };

        window.editImportFile = function(docEntry, dosyaNo, cardCode, acctCode, gtip, durum) {
            $('#frmImportFile')[0].reset();
            $('#importModalTitle').html('<i class="fas fa-edit me-2"></i>İthalat Dosyası Güncelle');
            $('#imp_DocEntry').val(docEntry);
            $('#imp_DosyaNo').val(dosyaNo);
            $('#imp_CardCode').val(cardCode).trigger('change.select2');
            $('#imp_AcctCode').val(acctCode).trigger('change.select2');
            $('#imp_Gtip').val(gtip);
            $('#imp_Durum').val(durum);
            $('#divDurum').show();
            $('#importFileModal').modal('show');
        }

        window.deleteImportFile = function(docEntry) {
            Swal.fire({
                title: 'Emin misiniz?',
                text: "Bu ithalat dosyasını silmek istediğinize emin misiniz?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Evet, Sil!',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#loadingOverlay').css('display', 'flex');
                    $.post('/Rapor131/DeleteImportFile?docEntry=' + docEntry, function(res) {
                        if(res.success) {
                            toastr.success(res.message);
                            refreshImportDashboard(res.data);
                        } else { toastr.error(res.message); }
                    }).always(function() { $('#loadingOverlay').hide(); });
                }
            });
        }

        window.loadOrderDetailsFromId = function(docEntry) {
            if (isBindingData) return;
            $('#loadingOverlay').css('display', 'flex');
            $.get('/Rapor131/GetOrderDetails', { docEntry: docEntry }, function(res) {
                if(res.success) bindOrderToForm(res.data);
                else toastr.error(res.message);
            }).always(function() { $('#loadingOverlay').hide(); });
        }

        $(document).ready(function () {
            $('.select2-init').select2({ theme: 'bootstrap-5', dropdownParent: $('#mainContainer') });
            $('#imp_CardCode, #imp_AcctCode').select2({ theme: 'bootstrap-5', dropdownParent: $('#importFileModal') });
            
            toggleDocTypeColumns('I');
            setFormMode('ADD');
            fetchAllExchangeRates();
            
            $('#DocType').on('change', function() {
                if(isBindingData) return;
                toggleDocTypeColumns($(this).val());
                $('#linesBody').empty();
                addRow();
            });

            $('#orderTabs a').on('click', function (e) {
                e.preventDefault();
                $(this).tab('show'); 
                if($(this).attr('id') === 'lines-tab' && currentMode === 'ADD') {
                    $('#btnAddRowContainer').css('display', 'flex');
                } else {
                    $('#btnAddRowContainer').hide();
                }
            });

            $('#btnOpenImportModal').click(function() { 
                $('#frmImportFile')[0].reset(); 
                $('#importModalTitle').html('<i class="fas fa-folder-plus me-2"></i>Yeni İthalat Dosyası Aç');
                $('#imp_DocEntry').val('0'); 
                $('#divDurum').hide();
                $('#imp_CardCode, #imp_AcctCode').val('').trigger('change'); 
                $('#importFileModal').modal('show'); 
            });

            // HESAP AÇILIŞINDA SWEETALERT DONMA VE PREFIX (159) ÇÖZÜMÜ
            $('#btnNewGLAccount').click(function() {
                Swal.fire({
                    title: 'Ana Hesap Kodu',
                    text: 'Hangi ana hesap altında açılacak? (Örn: 159.02 veya 159.03 vb.)',
                    input: 'text',
                    inputValue: '159.',
                    showCancelButton: true,
                    confirmButtonText: 'Devam Et',
                    cancelButtonText: 'İptal',
                    preConfirm: (prefix) => {
                        if(!prefix || !prefix.startsWith('159')) { 
                            Swal.showValidationMessage('Geçerli bir ana hesap girin (159 ile başlamalı)!'); 
                            return false; 
                        }
                        return prefix;
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        let userPrefix = result.value;
                        $('#loadingOverlay').css('display', 'flex');

                        $.get('/Rapor131/GetNextImportAccount', { prefix: userPrefix }, function(res) {
                            $('#loadingOverlay').hide();
                            
                            if(res.success) {
                                Swal.fire({
                                    title: 'Yeni İthalat Hesabı Aç',
                                    html: `<b>Hesap Kodu:</b> ${res.nextAccountCode}<br><br>Bu hesap kodu için bir <b>Hesap Adı</b> giriniz:`,
                                    input: 'text',
                                    inputAttributes: { autocapitalize: 'off' },
                                    showCancelButton: true,
                                    confirmButtonText: 'Hesabı Aç',
                                    cancelButtonText: 'İptal',
                                    showLoaderOnConfirm: true,
                                    preConfirm: (accName) => {
                                        if(!accName) { Swal.showValidationMessage('Hesap adı boş olamaz!'); return false; }
                                        return $.ajax({
                                            url: '/Rapor131/CreateImportGLAccount', type: 'POST', contentType: 'application/json',
                                            data: JSON.stringify({ AcctCode: res.nextAccountCode, AcctName: accName, FatherNum: res.fatherNum })
                                        }).then(response => { if(!response.success) { throw new Error(response.message); } return response; })
                                        .catch(error => { Swal.showValidationMessage(`Hata: ${error.message}`); });
                                    },
                                    allowOutsideClick: () => !Swal.isLoading()
                                }).then((result2) => {
                                    if (result2.isConfirmed) {
                                        let newAcc = result2.value;
                                        let option = new Option(`${newAcc.acctCode} - ${newAcc.acctName}`, newAcc.acctCode, true, true);
                                        $('#imp_AcctCode').append(option).trigger('change');
                                        toastr.success("Defteri Kebir hesabı SAP'de başarıyla açıldı.");
                                    }
                                });
                            } else {
                                toastr.error(res.message || "Sıradaki hesap numarası bulunamadı.");
                            }
                        }).fail(function() {
                            $('#loadingOverlay').hide();
                            toastr.error("Sunucu ile iletişim kurulamadı.");
                        });
                    }
                });
            });

            $('#btnSaveImportFile').click(function() {
                let docEntry = parseInt($('#imp_DocEntry').val()) || 0;
                let dosyaNo = $('#imp_DosyaNo').val();
                let cardCode = $('#imp_CardCode').val();
                let cardName = $('#imp_CardCode option:selected').data('name');
                let acctCode = $('#imp_AcctCode').val();
                let gtip = $('#imp_Gtip').val();
                let durum = $('#imp_Durum').val();

                if(!dosyaNo || !cardCode || !acctCode) { toastr.warning("Lütfen zorunlu alanları doldurun."); return; }

                let payload = { DocEntry: docEntry, DosyaNo: dosyaNo, CardCode: cardCode, CardName: cardName, AcctCode: acctCode, Gtip: gtip, Durum: durum };
                let btn = $(this); btn.prop('disabled', true);
                
                let targetUrl = docEntry > 0 ? '/Rapor131/UpdateImportFile' : '/Rapor131/SaveImportFile';

                $.ajax({
                    url: targetUrl, type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
                    success: function(res) {
                        if(res.success) {
                            toastr.success(res.message);
                            $('#importFileModal').modal('hide');
                            refreshImportDashboard(res.data); 
                        } else { toastr.error(res.message); }
                    },
                    error: function() { toastr.error("Kayıt sırasında hata oluştu."); },
                    complete: function() { btn.prop('disabled', false); }
                });
            });

            $('#CardCode').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const cardCode = $(this).val();
                if(!cardCode) return;

                $.get('/Rapor131/GetVendorInfo', { cardCode: cardCode }, function(res) {
                    currentBpCurrency = res.currency;
                    $('#CurrencyType').val('BP'); $('#DocCurrency').val(currentBpCurrency);
                    const docRate = window.exchangeRates[currentBpCurrency] || 1.0;
                    $('#ExchangeRate').val(docRate.toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
                    triggerItemPriceUpdate(); 
                });

                $.get('/Rapor131/GetVendorAddresses', { cardCode: cardCode }, function(res) {
                    let shipHtml = '<option value="">- Seçiniz -</option>';
                    let payHtml = '<option value="">- Seçiniz -</option>';
                    window.bpAddresses = res; 
                    res.forEach(addr => {
                        if(addr.addressType === 'S') shipHtml += `<option value="${addr.addressName}">${addr.addressName}</option>`;
                        if(addr.addressType === 'B') payHtml += `<option value="${addr.addressName}">${addr.addressName}</option>`;
                    });
                    $('#ShipToCode').html(shipHtml); $('#PayToCode').html(payHtml);
                    if(res.find(a => a.addressType === 'S')) $('#ShipToCode').val(res.find(a => a.addressType === 'S').addressName).trigger('change');
                    if(res.find(a => a.addressType === 'B')) $('#PayToCode').val(res.find(a => a.addressType === 'B').addressName).trigger('change');
                });
            });

            $('#ShipToCountry').on('change', function() {
                if(!isBindingData) populateStates('ShipToCountry', 'ShipToState');
            });
            $('#PayToCountry').on('change', function() {
                if(!isBindingData) populateStates('PayToCountry', 'PayToState');
            });

            $('#ShipToCode').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const val = $(this).val();
                const addr = window.bpAddresses?.find(a => a.addressName === val && a.addressType === 'S');
                fillAddressComponent('ShipTo', addr);
            });

            $('#PayToCode').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const val = $(this).val();
                const addr = window.bpAddresses?.find(a => a.addressName === val && a.addressType === 'B');
                fillAddressComponent('PayTo', addr);
            });

            $('#CurrencyType').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const type = $(this).val();
                if(type === 'BP') { $('#DocCurrency').val(currentBpCurrency).prop('disabled', false); } 
                else if(type === 'LC') { $('#DocCurrency').val('TRY').prop('disabled', true); } 
                else if(type === 'SC') { $('#DocCurrency').val('TRY').prop('disabled', false); }
                const docRate = window.exchangeRates[$('#DocCurrency').val()] || 1.0;
                $('#ExchangeRate').val(docRate.toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
                calculateTotals();
            });

            $('#DocCurrency').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const docRate = window.exchangeRates[$(this).val() || 'TRY'] || 1.0;
                $('#ExchangeRate').val(docRate.toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
                calculateTotals();
            });

            $('#DocDate').on('change', function() { if(!isBindingData && currentMode === 'ADD') fetchAllExchangeRates(); });
            
            $('#btnAddRow').click(function () { if(currentMode === 'ADD') addRow(); });
            
            $(document).on('click', '.btn-remove-row', function () {
                if(currentMode !== 'ADD') return;
                $(this).closest('tr').find('select.select2-hidden-accessible').select2('destroy'); 
                $(this).closest('tr').remove(); updateRowIndexes(); calculateTotals();
            });

            $(document).on('input', '.input-qty, .input-price', function () { if(currentMode === 'ADD') calculateTotals(); });
            $(document).on('change', '.input-vat, .input-currency', function () { if(currentMode === 'ADD') calculateTotals(); });

            $(document).on('change', '.item-select', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const row = $(this).closest('tr'); const itemCode = $(this).val(); const cardCode = $('#CardCode').val();
                if(cardCode && itemCode) {
                    $.get('/Rapor131/GetItemPrice', { cardCode: cardCode, itemCode: itemCode }, function(res) {
                        row.find('.input-price').val(res.price > 0 ? res.price : 0);
                        row.find('.input-currency').val(res.currency || 'TRY'); 
                        row.find('.input-whs').val(res.dfltWH || '01').trigger('change');
                        calculateTotals();
                    });
                }
            });

            $(document).on('change', '.input-whs', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const row = $(this).closest('tr'); const itemCode = row.find('.item-select').val(); const whsCode = $(this).val();
                if (itemCode && whsCode) {
                    $.get('/Rapor131/GetItemStock', { itemCode: itemCode, whsCode: whsCode }, function(res) { row.find('.input-stock').text(formatNumber(res.onHand || 0)); });
                } else { row.find('.input-stock').text('0'); }
            });

            // SİPARİŞİ KAYDET (CREATE)
            $('#orderForm').submit(function (e) {
                e.preventDefault();
                if(currentMode === 'FIND') { SearchOrder(); return; }
                if(currentMode === 'VIEW') return;

                if (!$('#CardCode').val()) { toastr.warning("Satıcı seçiniz."); return; }
                if (!$('#DocDate').val() || !$('#DocDueDate').val() || !$('#TaxDate').val()) { toastr.warning("Tarihleri giriniz."); return; }
                
                const isService = $('#DocType').val() === 'S';
                const documentLines = [];
                let hasError = false;

                $('#linesBody tr').each(function (index) {
                    const qty = parseFloat($(this).find('.input-qty').val()) || 0;
                    const price = parseFloat($(this).find('.input-price').val()) || 0;
                    const lineCur = $(this).find('.input-currency').val();
                    const vatGroup = $(this).find('.input-vat').val();
                    
                    let baseTypeVal = $(this).find('.input-basetype').val();
                    let baseEntryVal = $(this).find('.input-baseentry').val();
                    let baseLineVal = $(this).find('.input-baseline').val();
                    
                    let bt = baseTypeVal ? parseInt(baseTypeVal) : null;
                    let be = baseEntryVal ? parseInt(baseEntryVal) : null;
                    let bl = baseLineVal ? parseInt(baseLineVal) : null;

                    if(isService) {
                        const accCode = $(this).find('.account-select').val();
                        const desc = $(this).find('.input-desc').val();
                        if(!accCode) { hasError = true; toastr.error(`${index+1}. satırda Hesap Kodu seçiniz.`); return false; }
                        if(!desc) { hasError = true; toastr.error(`${index+1}. satırda Açıklama giriniz.`); return false; }
                        documentLines.push({ AccountCode: accCode, ItemDescription: desc, Quantity: qty, UnitPrice: price, Currency: lineCur, VatGroup: vatGroup, BaseType: bt, BaseEntry: be, BaseLine: bl });
                    } else {
                        const itemCode = $(this).find('.item-select').val();
                        const whsCode = $(this).find('.input-whs').val(); 
                        if(!itemCode) { hasError = true; toastr.error(`${index+1}. satırda Kalem seçiniz.`); return false; }
                        if(qty <= 0) { hasError = true; toastr.error(`${index+1}. satır miktar 0 olamaz.`); return false; }
                        documentLines.push({ ItemCode: itemCode, WarehouseCode: whsCode, Quantity: qty, UnitPrice: price, Currency: lineCur, VatGroup: vatGroup, BaseType: bt, BaseEntry: be, BaseLine: bl });
                    }
                });

                if (hasError || documentLines.length === 0) return;

                let docRateStr = $('#ExchangeRate').val().replace(/\./g, '').replace(',', '.');
                
                const payload = {
                    DocType: $('#DocType').val(),
                    CardCode: $('#CardCode').val(),
                    DocDate: $('#DocDate').val(), DocDueDate: $('#DocDueDate').val(), TaxDate: $('#TaxDate').val(), 
                    SalesPersonCode: parseInt($('#SalesPersonCode').val()) || 0,
                    Comments: $('#Comments').val(),
                    DocCurrency: $('#DocCurrency').val() || 'TRY',
                    DocRate: parseFloat(docRateStr) || 1.0,
                    U_BE1_AKTAR: $('#U_BE1_AKTAR').val(), 
                    U_BE1_AGENTNUM: $('#U_BE1_AGENTNUM').val(),
                    PayToCode: $('#PayToCode').val(), ShipToCode: $('#ShipToCode').val(),
                    AddressExtension: {
                        ShipToStreet: $('#ShipToStreet').val(), ShipToZipCode: $('#ShipToZipCode').val(), ShipToCounty: $('#ShipToCounty').val(), ShipToCity: $('#ShipToCity').val(), ShipToState: $('#ShipToState').val(), ShipToCountry: $('#ShipToCountry').val(),
                        BillToStreet: $('#PayToStreet').val(), BillToZipCode: $('#PayToZipCode').val(), BillToCounty: $('#PayToCounty').val(), BillToCity: $('#PayToCity').val(), BillToState: $('#PayToState').val(), BillToCountry: $('#PayToCountry').val()
                    },
                    DocumentLines: documentLines
                };

                $('#loadingOverlay').css('display', 'flex');
                $.ajax({
                    url: '/Rapor131/CreateOrder', type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) { toastr.success(res.message); setTimeout(() => { window.location.reload(); }, 1500); } 
                        else { toastr.error(res.message); }
                    },
                    error: function (xhr) { toastr.error(xhr.responseJSON ? xhr.responseJSON.message : "Bağlantı hatası."); },
                    complete: function () { $('#loadingOverlay').hide(); }
                });
            });

            // SİPARİŞİ GÜNCELLE (UPDATE - UDF VE AÇIKLAMA)
            $('#btnUpdateOrder').click(function() {
                if(!currentDocEntry) return;

                let payload = {
                    DocEntry: currentDocEntry,
                    Comments: $('#Comments').val(),
                    U_BE1_AKTAR: $('#U_BE1_AKTAR').val(),
                    U_BE1_AGENTNUM: $('#U_BE1_AGENTNUM').val()
                };

                $('#loadingOverlay').css('display', 'flex');
                $.ajax({
                    url: '/Rapor131/UpdateOrder', type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) { toastr.success(res.message); } else { toastr.error(res.message); }
                    },
                    error: function (xhr) { toastr.error(xhr.responseJSON ? xhr.responseJSON.message : "Güncelleme hatası."); },
                    complete: function () { $('#loadingOverlay').hide(); }
                });
            });
            
            $('#btnCancel').click(function() { if(currentMode === 'VIEW' || currentMode === 'FIND') { setFormMode('ADD'); fetchAllExchangeRates(); } else { window.history.back(); } });
            
            // NAVİGASYON
            $('.nav-btn').click(function() {
                if (isBindingData || isNavigating) return;
                
                isNavigating = true; 
                $('#loadingOverlay').css('display', 'flex');
                
                $.get('/Rapor131/GetOrderNavigation', { currentDocEntry: currentDocEntry, direction: $(this).data('dir') }, function(res) {
                    if (res.success) {
                        bindOrderToForm(res.data);
                    } else { 
                        toastr.info(res.message || "Kayıt bulunamadı."); 
                    }
                }).always(function() { 
                    $('#loadingOverlay').hide(); 
                    isNavigating = false; 
                });
            });

            $('#btnNewDoc').click(function() { setFormMode('ADD'); fetchAllExchangeRates(); });
            $('#btnFindMode').click(function() { setFormMode('FIND'); });
            
            $('#btnCancelDocument').click(function() {
                if (!currentDocEntry) return;
                if (confirm("Bu belgeyi iptal etmek istediğinize emin misiniz?")) {
                    $('#loadingOverlay').css('display', 'flex');
                    $.post('/Rapor131/CancelOrder?docEntry=' + currentDocEntry, function(res) {
                        if (res.success) { toastr.success(res.message); setTimeout(() => { window.location.reload(); }, 1500); } else { toastr.error(res.message); }
                    }).always(function() { $('#loadingOverlay').hide(); });
                }
            });

            // AÇIK PRQ MODALINI AÇ
            $('#btnOpenPRQModal').click(function() {
                if(currentMode !== 'ADD') return;
                $('#txtPRQSearch').val('');
                $('#prqTableBody').html('<tr><td colspan="8" class="text-center text-muted py-4">Kayıtları listelemek için yukarıdan seçim yapın.</td></tr>');
                $('#chkAllPRQ').prop('checked', false);
                $('#prqModal').modal('show');
            });

            $('#chkAllPRQ').change(function() {
                $('.chk-prq').prop('checked', $(this).prop('checked'));
            });
        });

        function populateStates(countrySelectId, stateSelectId, selectedState = '') {
            const countryCode = $('#' + countrySelectId).val();
            const stateSelect = $('#' + stateSelectId);
            
            stateSelect.empty().append('<option value="">- Seçiniz -</option>');
            
            if(countryCode) {
                const filteredStates = allStates.filter(s => s.country === countryCode);
                filteredStates.forEach(s => {
                    stateSelect.append(`<option value="${s.code}">${s.name}</option>`);
                });
            }
            if(selectedState) {
                stateSelect.val(selectedState).trigger('change.select2');
            }
        }

        function fillAddressComponent(prefix, addr) {
            $(`#${prefix}Street`).val(addr ? addr.street : '');
            $(`#${prefix}StreetNo`).val(addr ? addr.streetNo : '');
            $(`#${prefix}Block`).val(addr ? addr.block : '');
            $(`#${prefix}ZipCode`).val(addr ? addr.zipCode : '');
            $(`#${prefix}County`).val(addr ? addr.county : '');
            $(`#${prefix}City`).val(addr ? addr.city : '');
            
            if(addr && addr.country) {
                $(`#${prefix}Country`).val(addr.country).trigger('change.select2');
                populateStates(`${prefix}Country`, `${prefix}State`, addr.state);
            } else {
                $(`#${prefix}Country`).val('').trigger('change.select2');
                $(`#${prefix}State`).empty().append('<option value="">- Seçiniz -</option>');
            }
        }

        function toggleDocTypeColumns(type) {
            $('#linesTable').removeClass('table-mode-I table-mode-S').addClass('table-mode-' + type);
        }

        function addRow() {
            const isService = $('#DocType').val() === 'S';
            const templateId = isService ? 'rowTemplateService' : 'rowTemplateItem';
            const $newRow = $($('#' + templateId).html());
            
            $('#linesBody').append($newRow);
            $newRow.find('select.req-add').select2({ theme: 'bootstrap-5', width: '100%', dropdownParent: $('#mainContainer') });
            updateRowIndexes();
        }

        function updateRowIndexes() { $('#linesBody tr').each(function (index) { $(this).find('.row-index').text(index + 1); }); }

        function refreshImportDashboard(dataList) {
            let html = '', optHtml = '<option value="">- Dosya Seçiniz -</option>';
            dataList.forEach(f => {
                let badge = f.durum === 'Açık' ? '<span class="badge bg-success">Açık</span>' : `<span class="badge bg-secondary">${f.durum}</span>`;
                html += `<tr>
                            <td class="fw-bold text-primary">${f.dosyaNo}</td>
                            <td>${f.cardCode}</td>
                            <td>${f.cardName}</td>
                            <td>${f.acctCode}</td>
                            <td>${f.gtip || ''}</td>
                            <td>${badge}</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-light text-primary border" onclick="editImportFile(${f.docEntry}, '${f.dosyaNo}', '${f.cardCode}', '${f.acctCode}', '${f.gtip || ''}', '${f.durum}')"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-sm btn-light text-danger border" onclick="deleteImportFile(${f.docEntry})"><i class="fas fa-trash"></i></button>
                            </td>
                         </tr>`;
                optHtml += `<option value="${f.dosyaNo}">${f.dosyaNo} (${f.cardName})</option>`;
            });
            $('#importTableBody').html(html);
            $('#U_BE1_AGENTNUM').html(optHtml).trigger('change');
        }

        function fetchAllExchangeRates() {
            if(currentMode !== 'ADD') return;
            $.get('/Rapor131/GetAllExchangeRates', { date: $('#DocDate').val() }, function(res) {
                window.exchangeRates = res;
                $('#ExchangeRate').val((window.exchangeRates[$('#DocCurrency').val() || 'TRY'] || 1.0).toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
                calculateTotals();
            });
        }

        function calculateTotals() {
            if(currentMode !== 'ADD') return;
            let netTotalLC = 0, taxTotalLC = 0;
            const docCurrency = $('#DocCurrency').val() || 'TRY';
            const docRate = parseFloat($('#ExchangeRate').val().replace(/\./g, '').replace(',', '.')) || 1.0;

            $('#linesBody tr').each(function () {
                const qty = parseFloat($(this).find('.input-qty').val()) || 0;
                const price = parseFloat($(this).find('.input-price').val()) || 0;
                const lineCur = $(this).find('.input-currency').val() || 'TRY';
                const vatRate = parseFloat($(this).find('.input-vat option:selected').data('rate')) || 0;
                
                const lineRate = window.exchangeRates[lineCur] || (lineCur === docCurrency ? docRate : 1.0);
                const lineNetFC = qty * price;
                const lineNetLC = lineNetFC * lineRate;
                const lineTaxLC = lineNetLC * (vatRate / 100);

                $(this).find('.line-total-fc').text(formatNumber(lineNetFC) + ' ' + lineCur);
                $(this).find('.line-total-lc').text(formatNumber(lineNetLC) + ' TRY');
                
                netTotalLC += lineNetLC; taxTotalLC += lineTaxLC;
            });

            $('#lblNetTotalLC').text(formatNumber(netTotalLC) + ' TRY');
            $('#lblTaxTotalLC').text(formatNumber(taxTotalLC) + ' TRY');
            $('#lblGrandTotalLC').text(formatNumber(netTotalLC + taxTotalLC) + ' TRY');
            $('#lblGrandTotalFC').text(formatNumber((docCurrency === 'TRY') ? (netTotalLC + taxTotalLC) : ((netTotalLC + taxTotalLC) / docRate)) + ' ' + docCurrency);
        }

        function resetTotals() { $('#lblNetTotalLC, #lblTaxTotalLC, #lblGrandTotalLC').text('0,00 TRY'); $('#lblGrandTotalFC').text('0,00'); }

        function triggerItemPriceUpdate() {
            if(currentMode !== 'ADD' || $('#DocType').val() === 'S') return;
            $('#linesBody tr').each(function() { const sel = $(this).find('.item-select'); if(sel.val()) sel.trigger('change'); });
        }

        function setFormMode(mode, docStatus = '', canceled = 'N') {
            currentMode = mode;
            $('#lblOrderDocNum').text('');
            $('#lblOrderStatus').hide();
            
            if (mode === 'VIEW') {
                $('#mainContainer').removeClass('find-mode').addClass('view-mode');
                $('.searchable-field:not(.editable-in-view), .table-input').prop('disabled', true);
                $('.editable-in-view').prop('disabled', false); 
                
                $('#btnAddRowContainer').hide();
                $('#btnSave, #divDocNumSearch').hide();
                $('#btnUpdateOrder').show(); 
                
                $('#btnCancel').text("Yeni Ekle").removeClass('btn-light').addClass('btn-primary text-white').prop('disabled', false);
                
                if (canceled === 'Y') {
                    $('#lblOrderStatus').removeClass('bg-success bg-info').addClass('bg-danger').text('İPTAL EDİLDİ').show();
                    $('#btnCancelDocument, #btnUpdateOrder').hide();
                    $('.editable-in-view').prop('disabled', true);
                } else if (docStatus === 'C') {
                    $('#lblOrderStatus').removeClass('bg-success bg-danger').addClass('bg-secondary').text('KAPALI').show();
                    $('#btnCancelDocument, #btnUpdateOrder').hide();
                    $('.editable-in-view').prop('disabled', true); 
                } else {
                    $('#lblOrderStatus').removeClass('bg-danger bg-secondary').addClass('bg-success').text('AÇIK').show();
                    $('#btnCancelDocument').show();
                }
            } 
            else if (mode === 'FIND') {
                $('#mainContainer').removeClass('view-mode').addClass('find-mode');
                $('.searchable-field').prop('disabled', false).val('').trigger('change.select2');
                $('#Comments').prop('disabled', true).val('');
                
                $('#divDocNumSearch').show(); $('#SearchDocNum').prop('disabled', false).val('').focus();
                $('#btnAddRowContainer').hide();
                $('#linesBody').empty(); resetTotals();
                
                $('#btnSave').show().text("Ara").removeClass('btn-success').addClass('btn-info text-white');
                $('#btnCancelDocument, #btnUpdateOrder').hide();
                $('#btnCancel').text("İptal").removeClass('btn-primary text-white').addClass('btn-light');
            }
            else { 
                $('#mainContainer').removeClass('view-mode find-mode');
                $('.searchable-field, #Comments').prop('disabled', false);
                $('#ExchangeRate').prop('readonly', true); 
                
                $('#btnAddRowContainer').css('display', 'flex');
                $('#btnSave').show().removeClass('btn-info text-white').addClass('btn-success').html('<i class="fas fa-save me-1"></i> SAP\'ye Ekle');
                $('#btnCancelDocument, #divDocNumSearch, #btnUpdateOrder').hide();
                $('#btnCancel').text("İptal").removeClass('btn-primary text-white').addClass('btn-light');
                
                isBindingData = true; currentDocEntry = 0;
                $('#orderForm')[0].reset();
                $('.searchable-field.select2-init').val('').trigger('change.select2');
                $('#DocType').val('I').trigger('change');
                
                const today = new Date().toISOString().split('T')[0];
                $('#DocDate, #TaxDate').val(today);
                let nw = new Date(); nw.setDate(nw.getDate() + 7); $('#DocDueDate').val(nw.toISOString().split('T')[0]);
                
                $('#linesBody').empty(); addRow(); calculateTotals();
                isBindingData = false;
            }
        }

        function bindOrderToForm(res) {
            isBindingData = true; 
            
            try {
                currentDocEntry = res.docEntry;
                $('#lblOrderDocNum').text(`#${res.docNum}`);
                
                $('#DocType').val(res.docType).trigger('change');
                toggleDocTypeColumns(res.docType);

                $('#CardCode').val(res.cardCode).trigger('change.select2');
                $('#SalesPersonCode').val(res.slpCode).trigger('change.select2');
                $('#DocDate').val(res.docDate); $('#DocDueDate').val(res.docDueDate); $('#TaxDate').val(res.taxDate);
                $('#U_BE1_AKTAR').val(res.u_BE1_AKTAR || res.U_BE1_AKTAR).trigger('change.select2');
                $('#U_BE1_AGENTNUM').val(res.u_BE1_AGENTNUM || res.U_BE1_AGENTNUM).trigger('change.select2');
                
                $('#Comments').val(res.comments);
                $('#DocCurrency').val(res.docCurrency);
                $('#ExchangeRate').val((res.docRate || 1.0).toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
                window.exchangeRates[res.docCurrency] = res.docRate || 1.0;
                
                let rowsHtml = ''; let netLC = 0, taxLC = 0;

                (res.lines || []).forEach((line, index) => {
                    let lineRate = window.exchangeRates[line.currency] || (line.currency === res.docCurrency ? res.docRate : 1.0);
                    let qty = line.quantity || 1;
                    let price = line.unitPrice || line.lineTotal || 0;
                    let lineNetFC = qty * price;
                    let lineNetLC = lineNetFC * lineRate;
                    
                    let vatObj = @Html.Raw(Json.Serialize(ViewBag.VatGroups));
                    let foundVat = vatObj.find(v => v.code === line.vatGroup);
                    let lineTaxLC = lineNetLC * ((foundVat ? foundVat.rate : 0) / 100);
                    
                    netLC += lineNetLC; taxLC += lineTaxLC;

                    let accName = line.accountName || accountDict[line.accountCode] || '';
                    let accDisplay = line.accountCode ? `${line.accountCode} - ${accName}` : '-';
                    let itemName = itemDict[line.itemCode] || '';

                    rowsHtml += `<tr>
                        <td class="text-center align-middle text-muted small fw-bold">${index + 1}</td>
                        
                        <td class="col-item align-middle fw-medium">
                            <input type="hidden" class="input-basetype" value="${line.baseType || ''}" />
                            <input type="hidden" class="input-baseentry" value="${line.baseEntry || ''}" />
                            <input type="hidden" class="input-baseline" value="${line.baseLine || ''}" />
                            ${line.itemCode || '-'} - ${itemName}
                        </td>
                        <td class="col-item align-middle">${line.warehouseCode || '-'}</td>
                        
                        <td class="col-service align-middle fw-medium">${accDisplay}</td>
                        <td class="col-service align-middle">${line.itemDescription || '-'}</td>
                        
                        <td class="align-middle text-end"><input type="text" class="table-input text-end" value="${qty}" disabled/></td>
                        <td class="text-end align-middle">${formatNumber(price)} ${line.currency}</td>
                        <td class="align-middle">${line.vatGroup || ''}</td>
                        <td class="text-end align-middle fw-bold text-secondary small">${formatNumber(lineNetFC)} ${line.currency}</td>
                        <td class="text-end align-middle fw-bold text-dark small">${formatNumber(lineNetLC)} TRY</td>
                        <td class="text-center align-middle col-action"></td>
                    </tr>`;
                });
                $('#linesBody').html(rowsHtml);

                let grandLC = netLC + taxLC;
                $('#lblNetTotalLC').text(formatNumber(netLC) + ' TRY');
                $('#lblTaxTotalLC').text(formatNumber(taxLC) + ' TRY');
                $('#lblGrandTotalLC').text(formatNumber(grandLC) + ' TRY');
                $('#lblGrandTotalFC').text(formatNumber((res.docCurrency === 'TRY') ? grandLC : (grandLC / (res.docRate || 1))) + ' ' + res.docCurrency);
                
                setFormMode('VIEW', res.docStatus, res.canceled); 
            } catch (err) {
                console.error("Binding sırasında hata:", err);
                toastr.error("Kayıt ekrana yazdırılırken bir hata oluştu.");
            } finally {
                isBindingData = false;
            }
        }

        function SearchOrder() {
            const payload = { DocNum: $('#SearchDocNum').val() ? parseInt($('#SearchDocNum').val()) : null, CardCode: $('#CardCode').val(), SlpCode: parseInt($('#SalesPersonCode').val()) || null, DocDate: $('#DocDate').val() || null, DocCurrency: $('#DocCurrency').val() };
            $('#loadingOverlay').css('display', 'flex');
            $.ajax({ url: '/Rapor131/FindOrder', type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success && res.data.length > 0) {
                        if (res.data.length === 1) loadOrderDetailsFromId(res.data[0].docEntry);
                        else {
                            let html = ''; 
                            res.data.forEach(r => {
                                let stBadge = r.canceled === 'Y' ? '<span class="badge bg-danger">İptal</span>' : (r.docStatus === 'C' ? '<span class="badge bg-secondary">Kapalı</span>' : '<span class="badge bg-success">Açık</span>');
                                html += `<tr style="cursor:pointer;" onclick="loadOrderAndCloseModal(${r.docEntry})"><td class="fw-bold text-primary">#${r.docNum}</td><td>${stBadge}</td><td>${r.cardCode}</td><td>${r.cardName}</td><td>${r.docDate}</td><td><span class="badge bg-light text-dark border">${r.docCurrency}</span></td></tr>`;
                            });
                            $('#searchResultsBody').html(html); $('#searchResultsModal').modal('show');
                        }
                    } else toastr.warning(res.message || "Kayıt bulunamadı.");
                },
                complete: function () { $('#loadingOverlay').hide(); }
            });
        }
        window.loadOrderAndCloseModal = function(entry) { $('#searchResultsModal').modal('hide'); loadOrderDetailsFromId(entry); }

        // --- PRQ (SATINALMA TALEPLERİ) FONKSİYONLARI ---
        window.fetchPRQs = function(empName) {
            if(!empName) { toastr.warning("Lütfen arama için bir isim girin."); return; }
            $('#prqTableBody').html('<tr><td colspan="8" class="text-center py-4"><i class="fas fa-spinner fa-spin text-primary fs-4"></i><br>Yükleniyor...</td></tr>');
            
            $.get('/Rapor131/GetOpenPurchaseRequests', { employeeName: empName }, function(res) {
                if(res.success && res.data.length > 0) {
                    loadedPRQs = res.data;
                    let html = '';
                    res.data.forEach((r, idx) => {
                        html += `<tr>
                                    <td><input type="checkbox" class="form-check-input chk-prq" data-idx="${idx}" /></td>
                                    <td>${r.employeeName || '-'}</td>
                                    <td class="fw-bold text-primary">${r.docNum}</td>
                                    <td>${r.docDate}</td>
                                    <td>${r.itemCode || '-'} <br> <small class="text-muted">${r.dscription || ''}</small></td>
                                    <td class="fw-bold text-end">${formatNumber(r.openQty)}</td>
                                    <td class="text-center">${r.currency || 'TRY'}</td>
                                    <td>${r.whsCode || '-'}</td>
                                 </tr>`;
                    });
                    $('#prqTableBody').html(html);
                } else {
                    $('#prqTableBody').html('<tr><td colspan="8" class="text-center text-danger py-4">Belirtilen çalışana ait açık talep bulunamadı.</td></tr>');
                }
            }).fail(function() {
                $('#prqTableBody').html('<tr><td colspan="8" class="text-center text-danger py-4">Veri çekilirken hata oluştu.</td></tr>');
            });
        }

        window.addSelectedPRQsToGrid = function() {
            let selectedIndexes = [];
            $('.chk-prq:checked').each(function() { selectedIndexes.push($(this).data('idx')); });
            
            if(selectedIndexes.length === 0) { toastr.warning("Siparişe eklemek için en az bir talep seçmelisiniz."); return; }
            
            if($('#DocType').val() !== 'I') {
                toastr.error("Talep aktarımı için Sipariş Türü 'Kalem (Item)' olmalıdır. Lütfen türü değiştirip tekrar deneyin.");
                return;
            }

            selectedIndexes.forEach(idx => {
                let prq = loadedPRQs[idx];
                
                const $newRow = $($('#rowTemplateItem').html());
                $('#linesBody').append($newRow);
                
                // Base Type (147 = PRQ) bilgileri
                $newRow.find('.input-basetype').val(147);
                $newRow.find('.input-baseentry').val(prq.docEntry);
                $newRow.find('.input-baseline').val(prq.lineNum);
                
                if(prq.itemCode) { $newRow.find('.item-select').val(prq.itemCode); }
                if(prq.whsCode) { $newRow.find('.input-whs').val(prq.whsCode); }
                $newRow.find('.input-qty').val(prq.openQty);
                if(prq.price > 0) $newRow.find('.input-price').val(prq.price);
                if(prq.currency) $newRow.find('.input-currency').val(prq.currency);

                $newRow.find('select.req-add').select2({ theme: 'bootstrap-5', width: '100%', dropdownParent: $('#mainContainer') });
                $newRow.find('.item-select').trigger('change');
            });

            updateRowIndexes();
            $('#prqModal').modal('hide');
            toastr.success(`${selectedIndexes.length} adet kalem başarıyla eklendi. Fiyatları kontrol ediniz.`);
        }
    </script>
}