@section Scripts {
    <script>
        function token() { return $('input[name="__RequestVerificationToken"]').first().val(); }

        function bildir(ok, mesaj) {
            if (window.toastr) { toastr.options = { positionClass: 'toast-bottom-right', timeOut: 6000 }; ok ? toastr.success(mesaj) : toastr.error(mesaj); }
            else { alert(mesaj); }
        }

        function kacis(s) { return $('<div>').text(s == null ? '' : s).html(); }

        // Konsolide görünümde her taslak kendi şirketinden okunur/işlenir: tüm çağrılara db=... eklenir.
        var aktifDb = '';
        function dbAyarla(db) { aktifDb = db || ''; }
        function dbEk(url) { if (!aktifDb) return url; return url + (url.indexOf('?') >= 0 ? '&' : '?') + 'db=' + encodeURIComponent(aktifDb); }

        // ---------------- FATURA NO KONTROLÜ + MAİL ----------------
        function faturaNoKontrolJs(no) {
            no = (no || '').trim();
            if (!no) return { ok: false, mesaj: 'Fatura numarası (Belge Referansı) boş.' };
            if (no.indexOf(' ') >= 0) return { ok: false, mesaj: 'Fatura numarasında boşluk var.' };
            if (no.length !== 16) return { ok: false, mesaj: 'Fatura numarası 16 karakter olmalı, ' + no.length + ' karakter girilmiş (' + (no.length > 16 ? (no.length - 16) + ' fazla' : (16 - no.length) + ' eksik') + ').' };
            if (!/^[A-Z0-9]{3}\d{4}\d{9}$/.test(no)) return { ok: false, mesaj: 'Biçim hatalı: 3 harf/rakam seri + 4 haneli yıl + 9 haneli sıra olmalı.' };
            return { ok: true, mesaj: 'Biçim uygun.' };
        }

        var mailDocEntry = 0;
        function mailAc(docEntry, db) {
            if (db !== undefined) dbAyarla(db);
            mailDocEntry = docEntry;
            $('#mailAdresListesi').html('<span class="text-muted small"><i class="fas fa-spinner fa-spin me-1"></i>adresler aranıyor...</span>');
            $('#mailKontrol').removeClass('alert-danger alert-success').addClass('alert-secondary').text('...');
            $('#mailEkAlici').val('');
            new bootstrap.Modal(document.getElementById('mailModal')).show();
            $.getJSON(dbEk('/OnayEkrani/MailAdresleri'), { docEntry: docEntry }, function (r) {
                if (!r.success) { $('#mailAdresListesi').html('<span class="text-danger small">' + kacis(r.message) + '</span>'); return; }
                $('#mailBaslikCari').text(r.cardName);
                $('#mailKontrol').removeClass('alert-secondary alert-danger alert-success').addClass(r.kontrol.ok ? 'alert-success' : 'alert-danger')
                    .html('<i class="fas ' + (r.kontrol.ok ? 'fa-check-circle' : 'fa-triangle-exclamation') + ' me-1"></i>Fatura no: <b>' + kacis(r.numAtCard || '(boş)') + '</b> — ' + kacis(r.kontrol.mesaj));
                var h = '';
                (r.adresler || []).forEach(function (a, i) {
                    h += '<label class="border rounded px-2 py-1 small bg-white" style="cursor:pointer"><input type="checkbox" class="form-check-input me-1 mail-alici" value="' + kacis(a.mail) + '" ' + (i === 0 ? 'checked' : '') + '>' + kacis(a.mail) + ' <span class="text-muted">· ' + kacis(a.kaynak) + '</span></label>';
                });
                $('#mailAdresListesi').html(h || '<span class="text-muted small">Cari kartında, notlarında ve ilgili kişilerinde e-posta bulunamadı; ek alıcı alanına yazın.</span>');
                if (!$('#mailKendi').val()) $('#mailKendi').val(r.kullaniciMail || '');
                $('#mailKonu').val(r.konu || '');
                $('#mailGovde').val(r.govde || '');
            });
        }

        function mailGonder() {
            var alicilar = $('#mailAdresListesi .mail-alici:checked').map(function () { return this.value; }).get();
            ($('#mailEkAlici').val() || '').split(/[,;\s]+/).forEach(function (a) { if (a && a.indexOf('@@') > 0) alicilar.push(a.trim()); });
            if (!alicilar.length) { Swal.fire('Alıcı yok', 'En az bir alıcı işaretleyin ya da ek alıcı yazın.', 'warning'); return; }
            var btn = $('#mailGonderBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Gönderiliyor');
            $.ajax({
                url: dbEk('/OnayEkrani/FaturaNoBildir'), type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ DocEntry: mailDocEntry, Alicilar: alicilar, KendiMail: $('#mailKendi').val(), Konu: $('#mailKonu').val(), Govde: $('#mailGovde').val() }),
                success: function (r) {
                    btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i>Gönder');
                    if (!r.success) { Swal.fire('Gönderilemedi', r.message, 'error'); return; }
                    bootstrap.Modal.getInstance(document.getElementById('mailModal')).hide();
                    Swal.fire({ icon: 'success', title: 'Gönderildi', text: r.message, timer: 2500, showConfirmButton: false });
                },
                error: function () { btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i>Gönder'); Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); }
            });
        }

        // ---------------- ÖNİZLEME (PDF belge görünümü + SAP ekleri) ----------------
        function onizlemeAc(docEntry, docNum, objType, db) {
            if (db !== undefined) dbAyarla(db);
            var belgeUrl = dbEk('/OnayEkrani/Onizleme?docEntry=' + docEntry);
            var qnbUrl = dbEk('/OnayEkrani/QnbGoruntu?docEntry=' + docEntry);
            var qnbPdfUrl = dbEk('/OnayEkrani/QnbGoruntu?docEntry=' + docEntry + '&format=PDF');
            // Gelen e-Fatura yalnızca satıcı faturası / satıcı iadesinde vardır; orada QNB görüntüsü varsayılandır.
            var qnbVar = (objType === '18' || objType === '19');

            function goster(url, etiket, btn) {
                $('#onizlemeBaslik').text('Taslak No: ' + (docNum || docEntry) + ' — ' + etiket);
                $('#onizlemeYeniSekme').attr('href', url);
                $('#onizlemeCerceve').attr('src', url);
                $('#onizlemeArac .btn').removeClass('active');
                if (btn) $(btn).addClass('active');
            }

            $('#onizlemeQnbBtn, #onizlemeQnbPdfBtn').toggle(qnbVar);
            $('#onizlemeQnbBtn').off('click').on('click', function () { goster(qnbUrl, 'QNB Gerçek Görüntü', this); });
            $('#onizlemeQnbPdfBtn').off('click').on('click', function () { goster(qnbPdfUrl, 'QNB PDF', this); });
            $('#onizlemeBelgeBtn').off('click').on('click', function () { goster(belgeUrl, 'SAP Taslak Görünümü', this); });

            $('#onizlemeUyari').hide().text('');
            if (qnbVar) {
                // Önce QNB'de belge var mı bakılır; yoksa pencere hata sayfasında takılmaz,
                // SAP taslak görünümü açılır ve neden üstte yazılır.
                $('#onizlemeBaslik').text('Taslak No: ' + (docNum || docEntry) + ' — QNB kontrol ediliyor...');
                $('#onizlemeCerceve').attr('src', 'about:blank');
                $.getJSON(dbEk('/OnayEkrani/QnbGoruntuDurum'), { docEntry: docEntry }, function (d) {
                    if (d && d.bulundu) { goster(qnbUrl, 'QNB Gerçek Görüntü', '#onizlemeQnbBtn'); return; }
                    goster(belgeUrl, 'SAP Taslak Görünümü', '#onizlemeBelgeBtn');
                    $('#onizlemeUyari').html('<i class="fas fa-triangle-exclamation me-1"></i><b>QNB görüntüsü bulunamadı:</b> ' + kacis((d && d.mesaj) || 'bilinmeyen neden') + (d && d.ipucu ? ' <span class="text-muted">— ' + kacis(d.ipucu) + '</span>' : '')).show();
                }).fail(function () {
                    goster(belgeUrl, 'SAP Taslak Görünümü', '#onizlemeBelgeBtn');
                    $('#onizlemeUyari').html('<i class="fas fa-triangle-exclamation me-1"></i>QNB kontrolü yapılamadı, SAP taslak görünümü gösteriliyor.').show();
                });
            }
            else goster(belgeUrl, 'SAP Taslak Görünümü', '#onizlemeBelgeBtn');
            $('#onizlemeEkler').html('<span class="text-muted small">yükleniyor...</span>');
            new bootstrap.Modal(document.getElementById('onizlemeModal')).show();

            $.getJSON(dbEk('/OnayEkrani/Ekler'), { docEntry: docEntry }, function (res) {
                if (!res.success) { $('#onizlemeEkler').html('<span class="text-danger small">' + kacis(res.message) + '</span>'); return; }
                if (!res.ekler.length) { $('#onizlemeEkler').html('<span class="text-muted small">Bu taslakta ekli dosya yok.</span>'); return; }
                var h = '';
                res.ekler.forEach(function (e) {
                    var url = dbEk('/OnayEkrani/EkGoster?docEntry=' + docEntry + '&line=' + e.line);
                    var ikon = e.uzanti === 'pdf' ? 'fa-file-pdf text-danger' : (/^(png|jpg|jpeg|gif|bmp|webp)$/.test(e.uzanti) ? 'fa-file-image text-success' : 'fa-file text-secondary');
                    if (!e.mevcut) {
                        h += '<span class="btn btn-sm btn-outline-secondary disabled" title="Dosyaya sunucudan erişilemiyor"><i class="fas ' + ikon + ' me-1"></i>' + kacis(e.ad) + ' <i class="fas fa-triangle-exclamation text-warning ms-1"></i></span>';
                    } else if (e.goruntulenebilir) {
                        h += '<button type="button" class="btn btn-sm btn-outline-dark ek-btn" data-url="' + url + '" data-ad="' + kacis(e.ad) + '"><i class="fas ' + ikon + ' me-1"></i>' + kacis(e.ad) + '</button>';
                    } else {
                        h += '<a class="btn btn-sm btn-outline-dark" href="' + url + '" target="_blank"><i class="fas ' + ikon + ' me-1"></i>' + kacis(e.ad) + ' <i class="fas fa-download ms-1"></i></a>';
                    }
                });
                $('#onizlemeEkler').html(h);
                $('#onizlemeEkler .ek-btn').on('click', function () {
                    var url = $(this).data('url'), ad = $(this).data('ad');
                    $('#onizlemeBaslik').text('Taslak No: ' + (docNum || docEntry) + ' — Ek: ' + ad);
                    $('#onizlemeYeniSekme').attr('href', url);
                    $('#onizlemeCerceve').attr('src', url);
                    $('#onizlemeArac .btn').removeClass('active');
                    $(this).addClass('active');
                });
            });
        }
        $('#onizlemeModal').on('hidden.bs.modal', function () { $('#onizlemeCerceve').attr('src', 'about:blank'); });

        $(document).ready(function () {
            $('.modal').each(function () {
                var $m = $(this);
                if (!$m.parent().is('body')) $m.appendTo('body');
            });
            suz();

            if ($('.sekme-cubugu').length) {
                var kayitli = null;
                try { kayitli = sessionStorage.getItem('onaySekme'); } catch (e) { }
                if (kayitli && $('.sekme-panel[data-panel="' + kayitli + '"]').length) sekmeAc(kayitli);
                gecmisSuz();
            }
        });

        /* ---------- Sekmeler (yonetici) ---------- */
        function sekmeAc(ad) {
            $('.sekme-cubugu .nav-link').removeClass('active');
            $('.sekme-cubugu .nav-link[data-sekme="' + ad + '"]').addClass('active');
            $('.sekme-panel').addClass('d-none');
            $('.sekme-panel[data-panel="' + ad + '"]').removeClass('d-none');
            try { sessionStorage.setItem('onaySekme', ad); } catch (e) { }
        }

        function gecmisSuz() {
            var q = ($('#gArama').val() || '').toLocaleLowerCase('tr-TR');
            var gorunen = 0;

            $('#gecmisGovde tr').each(function () {
                var uygun = !q || ('' + $(this).data('ara')).indexOf(q) > -1;
                $(this).toggle(uygun);
                if (uygun) gorunen++;
            });

            $('#gBilgi').text(gorunen + ' kayıt gösteriliyor');
        }

        function suz() {
            var q = ($('#fArama').val() || '').toLocaleLowerCase('tr-TR');
            var gorunen = 0;

            $('#liste .taslak').each(function () {
                var uygun = !q || ('' + $(this).data('ara')).indexOf(q) > -1;
                $(this).toggle(uygun);
                if (uygun) gorunen++;
            });

            $('#sonucYok').toggleClass('d-none', gorunen > 0 || $('#liste .taslak').length === 0);
            $('#sonucBilgi').text(gorunen + ' taslak gösteriliyor');
        }

        /* ---------- Detay ---------- */
        function detayAc(docEntry, db) {
            if (db !== undefined) dbAyarla(db);
            $('#detayGovde').html('<div class="text-center py-5 text-muted"><i class="fas fa-spinner fa-spin fa-2x"></i></div>');
            new bootstrap.Modal(document.getElementById('detayModal')).show();

            $.getJSON(dbEk('/OnayEkrani/Detay'), { docEntry: docEntry }, function (res) {
                if (!res.success) { $('#detayGovde').html('<div class="alert alert-danger">' + kacis(res.message) + '</div>'); return; }

                var b = res.baslik;
                $('#detayBaslik').text(b.belgeTipi + ' - Taslak No: ' + b.docNum);

                var h = '<div class="det-grid">';
                h += satir('Cari Kodu', b.cardCode) + satir('Cari Adı', b.cardName);
                h += satir('Belge Tarihi', b.docDate) + satir('Vade Tarihi', b.docDueDate);
                h += satir('KDV Tarihi', b.taxDate) + satir('Oluşturma', b.createDate);
                h += satir('Belge Referansı', b.numAtCard) + satir('Para Birimi', b.paraBirimi);
                if (b.objType === '18' || b.objType === '19') {
                    var fnk = faturaNoKontrolJs(b.numAtCard);
                    if (!fnk.ok) h += '<div class="alert alert-danger py-2 mt-2 d-flex justify-content-between align-items-center" style="font-size:.8rem;"><span><i class="fas fa-triangle-exclamation me-1"></i><b>Fatura numarası hatalı:</b> ' + kacis(fnk.mesaj) + '</span>'
                                    + '<button class="btn btn-sm btn-warning" onclick="mailAc(' + b.docEntry + ')"><i class="fas fa-envelope me-1"></i>İlgililere bildir</button></div>';
                }
                h += satir('Onay Kime Düştü', b.sahipAdi + ' (personel #' + b.ownerCode + ')');
                h += '</div>';

                if (b.yonetici && !b.benimMi) {
                    h += '<div class="alert alert-warning py-2 mt-2" style="font-size:.8rem;">'
                       + '<i class="fas fa-user-shield me-1"></i>Bu taslağın onayı <b>' + kacis(b.sahipAdi)
                       + '</b> kişisine düşmüş. Yönetici olarak vekaleten işlem yapabilirsiniz; '
                       + 'işlem geçmişine sizin kullanıcı kodunuz yazılır.</div>';
                }

                if (b.comments) {
                    h += '<div class="mt-2 p-3" style="background:var(--bg-subtle,#f8fafc); border-radius:10px; font-size:.83rem; white-space:pre-wrap;">'
                       + '<b>Açıklama:</b><br/>' + kacis(b.comments) + '</div>';
                }

                h += '<div class="bolum-baslik">Satırlar (' + res.satirlar.length + ')</div>';
                h += '<div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">'
                   + '<thead><tr><th>#</th><th>Kalem</th><th>Açıklama</th><th class="text-end">Miktar</th><th>Birim</th>'
                   + '<th class="text-end">Fiyat</th><th class="text-end">İsk.%</th><th class="text-end">Tutar</th>'
                   + '<th class="text-end">KDV%</th><th>Depo</th><th>Muhasebe Hesabı</th></tr></thead><tbody>';

                res.satirlar.forEach(function (l) {
                    h += '<tr>'
                       + '<td>' + kacis(l.lineNum + 1) + '</td>'
                       + '<td class="fw-semibold">' + kacis(l.itemCode) + '</td>'
                       + '<td>' + kacis(l.dscription) + '</td>'
                       + '<td class="text-end">' + kacis(l.miktar) + '</td>'
                       + '<td>' + kacis(l.unitMsr) + '</td>'
                       + '<td class="text-end">' + kacis(l.fiyat) + '</td>'
                       + '<td class="text-end">' + kacis(l.iskonto) + '</td>'
                       + '<td class="text-end fw-bold">' + kacis(l.tutar) + '</td>'
                       + '<td class="text-end">' + kacis(l.kdv) + '</td>'
                       + '<td>' + kacis(l.whsCode) + '</td>'
                       + '<td style="font-size:11.5px;">' + kacis(l.hesap) + '</td>'
                       + '</tr>';
                });

                h += '</tbody><tfoot>'
                   + '<tr><td colspan="7" class="text-end fw-bold">ARA TOPLAM</td><td class="text-end fw-bold">' + kacis(b.araToplam) + '</td><td colspan="3"></td></tr>'
                   + '<tr><td colspan="7" class="text-end fw-bold">KDV</td><td class="text-end fw-bold">' + kacis(b.vatSum) + '</td><td colspan="3"></td></tr>'
                   + '<tr class="table-primary"><td colspan="7" class="text-end fw-bold">GENEL TOPLAM</td><td class="text-end fw-bold">' + kacis(b.docTotal) + '</td><td colspan="3"></td></tr>'
                   + '</tfoot></table></div>';

                h += '<div class="d-flex justify-content-end gap-2 mt-3">'
                   + '<button class="btn btn-outline-primary" onclick="onizlemeAc(' + b.docEntry + ', ' + b.docNum + ', \'' + kacis(b.objType) + '\')"><i class="fas fa-file-pdf me-1"></i>Önizleme</button>'
                   + '<button class="btn btn-outline-danger" onclick="reddetAc(' + b.docEntry + ', \'' + kacis(b.cardName) + '\')"><i class="fas fa-xmark me-1"></i>Reddet</button>'
                   + '<button class="btn btn-success" onclick="onaylaAc(' + b.docEntry + ', \'' + kacis(b.cardName) + '\', \'' + kacis(b.docTotal) + '\')"><i class="fas fa-check me-1"></i>Onayla</button>'
                   + '</div>';

                $('#detayGovde').html(h);
            }).fail(function () { $('#detayGovde').html('<div class="alert alert-danger">Detay alınamadı.</div>'); });
        }

        function satir(k, v) {
            return '<div class="det-satir"><div class="k">' + k + '</div><div class="v">' + (v ? kacis(v) : '-') + '</div></div>';
        }

        /* ---------- Onay ---------- */
        function onaylaAc(docEntry, cari, tutar, db) {
            if (db !== undefined) dbAyarla(db);
            $('#onayDocEntry').val(docEntry);
            $('#onayNotu').val('');
            $('#onayMetin').html('<b>' + kacis(cari) + '</b> adına <b>' + kacis(tutar) + '</b> tutarındaki taslak belge onaylanacak.');
            bootstrap.Modal.getInstance(document.getElementById('detayModal'))?.hide();
            new bootstrap.Modal(document.getElementById('onayModal')).show();
        }

        function onayla() {
            var $btn = $('#btnOnayla').prop('disabled', true)
                .html('<i class="fas fa-spinner fa-spin me-2"></i>SAP\'ye gönderiliyor...');

            $.post(dbEk('/OnayEkrani/Onayla'), {
                docEntry: $('#onayDocEntry').val(),
                onayNotu: $('#onayNotu').val(),
                __RequestVerificationToken: token()
            }, function (res) {
                bildir(res.success, res.message);
                if (res.success) { setTimeout(function () { location.reload(); }, 1200); }
                else { $btn.prop('disabled', false).html('<i class="fas fa-check me-2"></i>Onayla ve Belgeyi Oluştur'); }
            }).fail(function () {
                bildir(false, 'Sunucuya ulaşılamadı.');
                $btn.prop('disabled', false).html('<i class="fas fa-check me-2"></i>Onayla ve Belgeyi Oluştur');
            });
        }

        /* ---------- Ret ---------- */
        function reddetAc(docEntry, cari, db) {
            if (db !== undefined) dbAyarla(db);
            $('#retDocEntry').val(docEntry);
            $('#retNedeni').val('');
            $('#retMetin').html('<b>' + kacis(cari) + '</b> adına düzenlenen taslak reddedilecek.');
            bootstrap.Modal.getInstance(document.getElementById('detayModal'))?.hide();
            new bootstrap.Modal(document.getElementById('retModal')).show();
        }

        function reddet() {
            var neden = $('#retNedeni').val();
            if (!neden || !neden.trim()) { bildir(false, 'Ret nedeni zorunludur.'); return; }

            var $btn = $('#btnReddet').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>İşleniyor...');

            $.post(dbEk('/OnayEkrani/Reddet'), {
                docEntry: $('#retDocEntry').val(),
                retNedeni: neden,
                __RequestVerificationToken: token()
            }, function (res) {
                bildir(res.success, res.message);
                if (res.success) { setTimeout(function () { location.reload(); }, 1000); }
                else { $btn.prop('disabled', false).html('<i class="fas fa-xmark me-2"></i>Reddet'); }
            }).fail(function () {
                bildir(false, 'Sunucuya ulaşılamadı.');
                $btn.prop('disabled', false).html('<i class="fas fa-xmark me-2"></i>Reddet');
            });
        }
    </script>
}
