@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Şirket parametresini URL'ye eklemek için değişken tanımlıyoruz.
            const currentDbParam = '@currentDb';
            const dbQueryString = currentDbParam ? `?db=${currentDbParam}` : '';

            // Toastr Ayarları
            toastr.options = { "closeButton": true, "progressBar": true, "positionClass": "toast-top-right", "timeOut": "5000" };
            
            const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const tableBody = document.querySelector('#belgeTable tbody');
            const kpiSelectedTotalSpan = document.getElementById('kpiSelectedTotal');
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            let isMoveActionInProgress = false;

            const adjustTextareaHeight = (textareaElement) => {
                if (!textareaElement) return;
                textareaElement.style.height = 'auto';
                textareaElement.style.height = (textareaElement.scrollHeight) + 'px';
            };

            function calculateSelectedTotal() {
                const totalAmounts = {};
                const selectedRows = document.querySelectorAll('#belgeTable tbody tr.selected');

                selectedRows.forEach(row => {
                    if (row.style.display !== 'none') {
                        const amountText = row.dataset.kalantutar;
                        const currency = row.dataset.parabirimi || 'BİLİNMEYEN';
                        const amount = parseFloat(amountText);
                        if (!isNaN(amount)) {
                            if (totalAmounts[currency]) totalAmounts[currency] += amount;
                            else totalAmounts[currency] = amount;
                        }
                    }
                });

                let resultText = '';
                const currencyKeys = Object.keys(totalAmounts);
                if (currencyKeys.length === 0) resultText = '0.00';
                else {
                    currencyKeys.sort((a, b) => totalAmounts[b] - totalAmounts[a]);
                    resultText = currencyKeys.map(currency => {
                        const formattedAmount = totalAmounts[currency].toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        return `<span class="fw-bold">${formattedAmount} <small class="text-muted ms-1">${currency}</small></span>`;
                    }).join('<br>');
                }
                kpiSelectedTotalSpan.innerHTML = resultText;
            }

            function updateSelectAllCheckboxState() {
                if (!selectAllCheckbox) return;
                const visibleRows = Array.from(tableBody.querySelectorAll('tr')).filter(row => row.style.display !== 'none');
                const visibleCheckboxes = visibleRows.map(row => row.querySelector('.row-selector'));
                if (visibleCheckboxes.length > 0) {
                    const allChecked = visibleCheckboxes.every(checkbox => checkbox.checked);
                    const anyChecked = visibleCheckboxes.some(checkbox => checkbox.checked);
                    selectAllCheckbox.checked = allChecked;
                    selectAllCheckbox.indeterminate = !allChecked && anyChecked;
                } else {
                    selectAllCheckbox.checked = false;
                    selectAllCheckbox.indeterminate = false;
                }
            }

            function updateRowIndices() {
                const rows = Array.from(tableBody.children);
                rows.forEach((row, index) => {
                    row.cells[0].textContent = (index + 1).toString();
                    row.dataset.order = (index + 1).toString();
                });
            }

            function performMove(direction) {
                if (isMoveActionInProgress) return;
                isMoveActionInProgress = true;

                const selectedRows = Array.from(tableBody.querySelectorAll('tr.selected')).filter(row => row.style.display !== 'none');

                if (selectedRows.length === 0) {
                    toastr.warning('Lütfen taşımak istediğiniz satır(lar)ı seçin.');
                    isMoveActionInProgress = false;
                    return;
                }

                if (direction === 'up') {
                    for (const row of selectedRows) {
                        let prev = row.previousElementSibling;
                        while(prev && prev.style.display === 'none') { prev = prev.previousElementSibling; }
                        if (prev && !prev.classList.contains('selected')) { $(row).insertBefore(prev); }
                    }
                } else if (direction === 'down') {
                    for (let i = selectedRows.length - 1; i >= 0; i--) {
                        const row = selectedRows[i];
                        let next = row.nextElementSibling;
                        while(next && next.style.display === 'none') { next = next.nextElementSibling; }
                        if (next && !next.classList.contains('selected')) { $(row).insertAfter(next); }
                    }
                } else if (direction === 'top') {
                    selectedRows.forEach(row => $(tableBody).prepend(row));
                } else if (direction === 'bottom') {
                    selectedRows.forEach(row => $(tableBody).append(row));
                }

                updateRowIndices();
                isMoveActionInProgress = false;
                calculateSelectedTotal();
                toastr.success('Sıralama güncellendi. Kaydetmek için "Sıra Kaydet" butonuna basın.');
            }

            function initializeYuzdeCalculations() {
                document.querySelectorAll('.yuzde-input').forEach(input => {
                    input.addEventListener('input', function() { calculateAndSetYuzdeliTutar(this.closest('tr')); });
                    calculateAndSetYuzdeliTutar(input.closest('tr'));
                });
            }

            function calculateAndSetYuzdeliTutar(row) {
                const yuzdeInput = row.querySelector('.yuzde-input');
                const kalanTutar = parseFloat(row.dataset.kalantutar);
                const yuzdeliTutarDisplay = row.querySelector('.yuzdeli-tutar-display');
                const yuzdeliTutarHiddenInput = row.querySelector('.yuzdeli-tutar-hidden-input');

                if (!yuzdeInput || isNaN(kalanTutar)) return;

                let yuzde = parseFloat(yuzdeInput.value);
                if (isNaN(yuzde) || yuzde < 0) yuzde = 0; else if (yuzde > 100) yuzde = 100;

                let yuzdeliTutar = 0;
                yuzdeliTutar = kalanTutar * (yuzde / 100);

                if (yuzdeliTutarDisplay) yuzdeliTutarDisplay.textContent = yuzdeliTutar.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                if (yuzdeliTutarHiddenInput) yuzdeliTutarHiddenInput.value = yuzdeliTutar.toLocaleString('en-US', { useGrouping: false, minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            // ================== Event Listeners ==================
            $('#loadingOverlay').hide();

            document.querySelectorAll('.note-textarea').forEach(textarea => {
                textarea.addEventListener('input', () => adjustTextareaHeight(textarea));
                textarea.addEventListener('focus', function () { this.style.height = '60px'; this.style.position = 'absolute'; this.style.zIndex = '10'; this.style.width = '200px'; this.style.boxShadow = '0 4px 6px rgba(0,0,0,0.1)'; });
                textarea.addEventListener('blur', function () { this.style.height = '24px'; this.style.position = 'static'; this.style.width = '100%'; this.style.boxShadow = 'none'; });
            });

            $('#moveUpBtn').on('click', () => performMove('up'));
            $('#moveDownBtn').on('click', () => performMove('down'));
            $('#moveToTopBtn').on('click', () => performMove('top'));
            $('#moveToBottomBtn').on('click', () => performMove('bottom'));

            $('#saveOrderBtn').on('click', async function () {
                if (isMoveActionInProgress) return;
                isMoveActionInProgress = true;

                const rows = Array.from(tableBody.querySelectorAll('tr'));
                const updatedOrder = [];

                rows.forEach((row, index) => {
                    const objType = row.dataset.objtype;
                    const docEntry = row.dataset.docentry;
                    const docNum = row.dataset.docnum;
                    if (docEntry && objType) {
                        updatedOrder.push({ DocEntry: parseInt(docEntry), ObjType: objType, DocNum: docNum, U_BE1_SIRA: index + 1 });
                    }
                });

                if (updatedOrder.length === 0) { toastr.error("Kaydedilecek veri yok."); isMoveActionInProgress = false; return; }
                $('#loadingOverlay').show();

                try {
                    const response = await fetch('/Rapor/GuncelleSira' + dbQueryString, { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken }, body: JSON.stringify(updatedOrder) });
                    if (response.ok) {
                        const result = await response.json();
                        toastr.success(result.message);
                        location.reload();
                    } else toastr.error('Hata oluştu.');
                } catch (e) { toastr.error('Ağ hatası.'); } finally { isMoveActionInProgress = false; $('#loadingOverlay').hide(); }
            });

            if (selectAllCheckbox) {
                selectAllCheckbox.addEventListener('change', function () {
                    const isChecked = this.checked;
                    document.querySelectorAll('#belgeTable tbody tr').forEach(row => {
                        if (row.style.display !== 'none') {
                            const cb = row.querySelector('.row-selector');
                            if (cb) { cb.checked = isChecked; row.classList.toggle('selected', isChecked); }
                        }
                    });
                    calculateSelectedTotal();
                });
            }

            if (tableBody) {
                tableBody.addEventListener('change', function(event) {
                    if (event.target.classList.contains('row-selector')) {
                        const row = event.target.closest('tr');
                        row.classList.toggle('selected', event.target.checked);
                        calculateSelectedTotal();
                        updateSelectAllCheckboxState();
                    }
                });

                tableBody.addEventListener('click', function(event) {
                    const target = event.target;
                    if ($(target).closest('.bootstrap-select').length || target.matches('input, textarea, select, button, a, .delete-row-btn, .delete-row-btn i')) return;

                    const row = target.closest('tr');
                    if(!row) return;

                    const cb = row.querySelector('.row-selector');
                    if (cb) {
                        cb.checked = !cb.checked;
                        row.classList.toggle('selected', cb.checked);
                        calculateSelectedTotal();
                        updateSelectAllCheckboxState();
                    }
                });
            }

            $(document).on('click', '.delete-row-btn', function (e) {
                e.stopPropagation();
                const docEntry = $(this).data('docentry');
                
                Swal.fire({
                    title: 'Emin misiniz?',
                    text: `Bu kaydı silmek istediğinize emin misiniz? (${docEntry})`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: 'Evet, Sil!',
                    cancelButtonText: 'İptal'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("Sil", "Rapor")' + dbQueryString, 
                            type: 'POST',
                            data: { __RequestVerificationToken: antiForgeryToken, belgeTipi: 'Manuel', docEntry: docEntry },
                            success: function (res) { if(res.success) { toastr.success(res.message); location.reload(); } else toastr.error(res.message); }
                        });
                    }
                });
            });

            function filterTable() {
                const filters = {};
                $('.filter-select-bs').each(function () {
                    const colKey = $(this).closest('th').data('column');
                    const vals = $(this).val();
                    if (vals && vals.length > 0) filters[colKey] = vals.map(v => v.toLowerCase().trim());
                });

                const headers = Array.from(document.querySelectorAll('thead tr.main-header-row th'));
                const headerMap = new Map(headers.map((h, i) => [h.dataset.column, i]));

                document.querySelectorAll('#belgeTable tbody tr').forEach(row => {
                    let isVisible = true;
                    for (const key in filters) {
                        const idx = headerMap.get(key);
                        if (idx !== undefined) {
                            const cell = row.cells[idx];
                            let txt = (cell.textContent || '').toLowerCase().trim();
                            const inp = cell.querySelector('input, textarea');
                            if(inp) txt = inp.value.toLowerCase().trim();
                            if (!filters[key].some(v => txt.includes(v))) { isVisible = false; break; }
                        }
                    }
                    row.style.display = isVisible ? '' : 'none';
                });
                updateRowIndices();
                calculateSelectedTotal();
                updateSelectAllCheckboxState();
            }

            // Selectpicker Başlatma
            if ($.fn.selectpicker) {
                $('.filter-select-bs').selectpicker({ liveSearch: true, actionsBox: true, width: '100%' }).on('changed.bs.select', filterTable);
            }

            const togglePlanCols = document.getElementById('togglePlanColumns');
            if (togglePlanCols) {
                togglePlanCols.addEventListener('change', function () {
                    const isChecked = this.checked;
                    const columns = document.querySelectorAll('.toggle-plan-col');
                    columns.forEach(col => {
                        if (isChecked) { col.classList.remove('d-none'); } 
                        else { col.classList.add('d-none'); }
                    });
                });
            }

            // NAKİT AKIŞA GÖNDER Modal Açma
            $('#btnNakitAkisaGonder').click(function() {
                const selectedRows = $('#belgeTable tbody tr.selected').filter(function() { return this.style.display !== 'none'; });
                if (selectedRows.length === 0) {
                    Swal.fire('Uyarı', 'Lütfen Nakit Akışa (Rapor 79) aktarılacak satırları seçin.', 'info');
                    return;
                }
                $('#nakitAkisSeciliSayi').text(selectedRows.length);
                $('#nakitAkisHedefFirma').val('');
                $('#nakitAkisGonderModal').modal('show');
            });

            // NAKİT AKIŞA GÖNDER Onay
            $('#btnNakitAkisOnayla').click(async function() {
                const hedefDb = $('#nakitAkisHedefFirma').val();
                if(!hedefDb) { toastr.error('Lütfen hedef firmayı seçin.'); return; }

                const selectedRows = $('#belgeTable tbody tr.selected').filter(function() { return this.style.display !== 'none'; });
                let dataToSend = [];

                selectedRows.each(function() {
                    const row = $(this);
                    const kurum = row.data('suppliername');
                    const urunHizmet = row.find('td[data-column="OdemeNedeni"]').text().trim() || row.find('td[data-column="OdemePlaniNotu"] select, td[data-column="OdemePlaniNotu"] textarea').val() || "SAP'den Aktarıldı";
                    const planlananTarih = row.find('.date-input').val(); 
                    const paraBirimi = row.data('parabirimi');
                    
                    const tutar = parseFloat(row.data('kalantutar')) || 0; 
                    const tutarTl = parseFloat(row.data('gunceltltutar')) || 0; 
                    
                    const dynamicTutar = parseFloat(row.find('.yuzdeli-tutar-hidden-input').val()) || tutar;
                    const rate = (tutar > 0 && tutarTl > 0) ? (tutarTl / tutar) : 1;
                    const finalTutarTL = dynamicTutar * rate;

                    const odemeYontemi = row.find('td[data-column="OdemeSekli"]').text().trim();
                    const bagliBelgeTipi = row.data('belge-tipi');
                    const bagliDocEntry = row.data('docentry');

                    dataToSend.push({
                        Kurum: kurum,
                        UrunHizmet: urunHizmet,
                        PlanlananTarih: planlananTarih || null,
                        ParaBirimi: paraBirimi,
                        Tutar: dynamicTutar,
                        TutarTL: finalTutarTL,
                        OdemeYontemi: odemeYontemi,
                        BagliBelgeTipi: bagliBelgeTipi,
                        BagliDocEntry: parseInt(bagliDocEntry) || 0
                    });
                });

                const payload = { HedefFirmaDb: hedefDb, Kalemler: dataToSend };
                const btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Aktarılıyor...');

                try {
                    const response = await fetch('/Rapor/NakitAkisaGonder' + dbQueryString, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken },
                        body: JSON.stringify(payload)
                    });
                    const res = await response.json();
                    if(res.success) {
                        toastr.success(res.message);
                        $('#nakitAkisGonderModal').modal('hide');
                    } else {
                        toastr.error(res.message);
                    }
                } catch(e) {
                    toastr.error('Ağ hatası oluştu.');
                } finally {
                    btn.prop('disabled', false).html('<i class="fas fa-check me-1"></i> Aktar');
                }
            });

            // ONAY MODAL İŞLEMLERİ
            $('#showApprovalModalBtn').on('click', function () {
                fetchApprovalDocuments();
                $('#approvalModal').modal('show');
            });

            async function fetchApprovalDocuments() {
                const approvalModalBody = document.getElementById('approvalModalBody');
                approvalModalBody.innerHTML = '<p class="text-center text-muted"><div class="spinner-border text-warning" role="status"></div><span class="ms-2">Yükleniyor...</span></p>';
                try {
                    const response = await fetch('@Url.Action("OnayBekleyenler", "Rapor")' + dbQueryString, { method: 'GET', headers: { 'Accept': 'application/json' } });
                    const result = await response.json();
                    if (result.success && result.data && result.data.length > 0) renderApprovalTable(result.data);
                    else approvalModalBody.innerHTML = '<div class="alert alert-info py-2 m-0 border-0 shadow-sm" role="alert"><i class="fas fa-info-circle me-2"></i> Onay bekleyen belge bulunamadı.</div>';
                } catch (error) {
                    approvalModalBody.innerHTML = `<div class="alert alert-danger py-2 m-0 border-0 shadow-sm" role="alert"><i class="fas fa-exclamation-triangle me-2"></i> Hata: ${error.message}</div>`;
                }
            }

            function renderApprovalTable(data) {
                let tableHtml = `<div class="table-responsive"><table class="table table-hover table-sm align-middle mb-0" style="font-size:12px;"><thead style="background-color: #f8fafc;"><tr><th class="text-muted fw-bold">Belge No</th><th class="text-muted fw-bold">Tedarikçi</th><th class="text-muted fw-bold">Tutar</th><th class="text-muted fw-bold">PB</th><th class="text-muted fw-bold">Plan Tar.</th><th class="text-muted fw-bold">Nedeni</th><th class="text-muted fw-bold">Talep Eden</th><th class="text-muted fw-bold">İşlem</th></tr></thead><tbody>`;
                data.forEach(item => {
                    const odeplanTarihi = item.odeplanTarihi ? new Date(item.odeplanTarihi).toLocaleDateString('tr-TR') : '-';
                    tableHtml += `<tr>
                                    <td class="fw-bold">${item.docNum || '-'}</td>
                                    <td>${item.tedarikciAlacakli || '-'}</td>
                                    <td class="fw-bold text-dark">${(item.tutar || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2 })}</td>
                                    <td><span class="badge-soft-primary">${item.paraBirimi || '-'}</span></td>
                                    <td>${odeplanTarihi}</td>
                                    <td>${item.odemeNedeni || '-'}</td>
                                    <td><i class="fas fa-user-circle text-muted me-1"></i> ${item.sahip || '-'}</td>
                                    <td>
                                        <button type="button" class="btn btn-success btn-sm onayla-btn p-1 px-2" data-docentry="${item.docEntry}"><i class="fas fa-check"></i></button> 
                                        <button type="button" class="btn btn-danger btn-sm reddet-btn p-1 px-2" data-docentry="${item.docEntry}"><i class="fas fa-times"></i></button>
                                    </td>
                                  </tr>`;
                });
                tableHtml += `</tbody></table></div>`;
                document.getElementById('approvalModalBody').innerHTML = tableHtml;
            }

            $(document).on('click', '#approvalModalBody .onayla-btn, #approvalModalBody .reddet-btn', async function () {
                const docEntry = $(this).data('docentry');
                const islem = $(this).hasClass('onayla-btn') ? 'onayla' : 'reddet';
                const actionText = islem === 'onayla' ? 'Onaylamak' : 'Reddetmek';
                const confirmColor = islem === 'onayla' ? '#10b981' : '#ef4444';

                Swal.fire({
                    title: 'Emin misiniz?',
                    text: `Bu işlemi ${actionText} istediğinize emin misiniz?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: confirmColor,
                    cancelButtonColor: '#64748b',
                    confirmButtonText: `Evet, ${actionText}!`,
                    cancelButtonText: 'İptal'
                }).then(async (result) => {
                    if (result.isConfirmed) {
                        try {
                            const formData = new URLSearchParams();
                            formData.append('docEntry', docEntry);
                            formData.append('islem', islem);
                            formData.append('__RequestVerificationToken', antiForgeryToken);
                            const response = await fetch('@Url.Action("OnayReddet", "Rapor")' + dbQueryString, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' }, body: formData.toString() });
                            const result = await response.json();
                            if(result.success) { toastr.success(result.message); fetchApprovalDocuments(); location.reload(); } else toastr.error(result.message);
                        } catch (e) { toastr.error('Hata oluştu.'); }
                    }
                });
            });

            // Başlangıç tetikleyicileri
            updateSelectAllCheckboxState();
            calculateSelectedTotal();
            initializeYuzdeCalculations();
        });
    
        // =================================================================
        // SÜTUN SIRALAMA
        // Başlıklarda .sortable-column sınıfı ve fa-sort ikonu vardı ama
        // hiçbir tıklama bağlanmamıştı; ikonlar süs gibi duruyordu.
        // Tür başlıktaki data-type ile, yoksa hücre içeriğinden anlaşılır.
        // =================================================================
        (function belgeTablosunuSirala() {
            var tablo = document.getElementById('belgeTable');
            if (!tablo) return;

            var govde = tablo.querySelector('tbody');
            if (!govde) return;

            function metin(hucre) {
                if (!hucre) return '';
                var alan = hucre.querySelector('input, select, textarea');
                var d = alan ? (alan.value || '') : (hucre.innerText || '');
                return d.trim();
            }

            function sayiyaCevir(d) {
                // tr-TR: binlik ".", ondalik ","
                var t = d.replace(/[^0-9.,-]/g, '').replace(/\./g, '').replace(',', '.');
                var s = parseFloat(t);
                return isNaN(s) ? null : s;
            }

            function tariheCevir(d) {
                var p = d.match(/^(\d{2})[.\/](\d{2})[.\/](\d{4})$/);
                if (p) return new Date(+p[3], +p[2] - 1, +p[1]).getTime();
                var t = Date.parse(d);
                return isNaN(t) ? null : t;
            }

            // Sütunun türünü örnekleyerek bul
            function turBul(baslik, indeks) {
                var belirtilen = baslik.getAttribute('data-type');
                if (belirtilen) return belirtilen;

                var satirlar = Array.prototype.slice.call(govde.rows, 0, 25);
                var sayi = 0, tarih = 0, dolu = 0;

                satirlar.forEach(function (r) {
                    var d = metin(r.cells[indeks]);
                    if (!d) return;
                    dolu++;
                    if (tariheCevir(d) !== null && /\d{2}[.\/]\d{2}[.\/]\d{4}/.test(d)) tarih++;
                    else if (sayiyaCevir(d) !== null) sayi++;
                });

                if (!dolu) return 'text';
                if (tarih / dolu > 0.6) return 'date';
                if (sayi / dolu > 0.6) return 'number';
                return 'text';
            }

            var basliklar = tablo.querySelectorAll('thead th.sortable-column');

            basliklar.forEach(function (baslik) {
                baslik.addEventListener('click', function () {
                    var indeks = Array.prototype.indexOf.call(baslik.parentElement.children, baslik);
                    var tur = turBul(baslik, indeks);
                    var artan = baslik.dataset.yon !== 'asc';

                    // Diğer başlıkların ikonlarını sıfırla
                    basliklar.forEach(function (b) {
                        if (b === baslik) return;
                        delete b.dataset.yon;
                        var i = b.querySelector('i');
                        if (i) i.className = 'fas fa-sort text-muted ms-1';
                    });

                    baslik.dataset.yon = artan ? 'asc' : 'desc';
                    var ikon = baslik.querySelector('i');
                    if (ikon) ikon.className = (artan ? 'fas fa-sort-up' : 'fas fa-sort-down') + ' text-primary ms-1';

                    // Ara başlık / toplam gibi satırlar (colspan) yerinde kalsın
                    var satirlar = Array.prototype.filter.call(govde.rows, function (r) {
                        return !r.querySelector('td[colspan]');
                    });

                    satirlar.sort(function (a, b) {
                        var x = metin(a.cells[indeks]), y = metin(b.cells[indeks]);

                        if (tur === 'number') {
                            var sx = sayiyaCevir(x), sy = sayiyaCevir(y);
                            if (sx === null && sy === null) return 0;
                            if (sx === null) return 1;      // boşlar sona
                            if (sy === null) return -1;
                            return artan ? sx - sy : sy - sx;
                        }

                        if (tur === 'date') {
                            var tx = tariheCevir(x), ty = tariheCevir(y);
                            if (tx === null && ty === null) return 0;
                            if (tx === null) return 1;
                            if (ty === null) return -1;
                            return artan ? tx - ty : ty - tx;
                        }

                        if (!x && !y) return 0;
                        if (!x) return 1;
                        if (!y) return -1;
                        return artan ? x.localeCompare(y, 'tr') : y.localeCompare(x, 'tr');
                    });

                    // Satırlar taşınır; gizli/seçili durumları kendileriyle gelir.
                    satirlar.forEach(function (r) { govde.appendChild(r); });
                });
            });
        })();

    </script>
}