@model IEnumerable<WebApplication3.Models.BelgeViewModel>

<div class="container-fluid">
    <!-- Veritabanı Seçimi Üst Kısımda -->
    <div class="card mb-4" style="background-color: #f8f9fa;">
        <div class="card-body">
            <form method="post" asp-action="Guncelle" id="dbSelectionForm">
                <div class="form-group row align-items-center">
                    <label for="dbSelect" class="col-md-2 col-form-label font-weight-bold">Veritabanı Seçiniz:</label>
                    <div class="col-md-4">
                        <select id="dbSelect" name="dbSelection" class="form-control">
                            <option value="DefaultConnection">Test_URS_2504</option>
                            <option value="DefaultConnection1">AsiaAktarim2905</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary">Yükle</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tablo Kısmı -->
    <form method="post" asp-action="Guncelle" id="mainForm">
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="thead-dark">
                    <tr>
                        <th>Hafta</th>
                        <th>Tarih Aralığı</th>
                        <th>Order Tarihi</th>
                        <th>Tedarikçi</th>
                        <th>Belge No</th>
                        <th>Fatura No</th>
                        <th>Ödeme Plan Tarihi</th>
                        <th>Ödeme Plan Notu</th>
                        <th>Ödeme Nedeni</th>
                        <th>Mutabakat</th>
                        <th>Vade Tarihi</th>
                        <th>Gerçekleşen Ödeme</th>
                        <th>Gün Farkı</th>
                        <th>Tutar</th>
                        <th>Ödenen</th>
                        <th>Para Birimi</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var belge in Model)
                    {
                        <tr>
                            <td>@belge.Hafta</td>
                            <td>@belge.TarihAraligi</td>
                            <td>@belge.OrderDate?.ToString("dd.MM.yyyy")</td>
                            <td>@belge.TedarikciAlacakli</td>
                            <td>@belge.DocNum</td>
                            <td>@belge.FaturaNo</td>
                            <td>
                                <input type="date" name="OdeplanTarihi_@belge.DocNum"
                                       value="@(belge.OdeplanTarihi?.ToString("yyyy-MM-dd") ?? "")"
                                       class="form-control" />
                            </td>
                            <td>
                                <input type="text" name="OdeplanNot_@belge.DocNum" value="@belge.OdeplanNot" class="form-control" />
                            </td>
                            <td>@belge.OdemeNedeni</td>
                            <td>@belge.MutabakatDurumu</td>
                            <td>@belge.VadeTarihi?.ToString("dd.MM.yyyy")</td>
                            <td>@belge.GerceklesenOdemeTarihi?.ToString("dd.MM.yyyy")</td>
                            <td>@belge.GunFarki</td>
                            @*<td>@(belge.Tutar?.ToString("N2") ?? "-")</td>
                            <td>@(belge.OdenenTutar?.ToString("N2") ?? "-")</td>*@
                            <td>@belge.ParaBirimi</td>
                            <td>
                                <button type="submit" name="DocNum" value="@belge.DocNum" class="btn btn-primary btn-sm">Güncelle</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('button[name="DocNum"]').forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault(); // Form gönderimini durdur
                const docNum = this.value;
                const form = document.getElementById('mainForm');

                // Önceki gizli inputları temizle
                form.querySelectorAll('input[name="DocNum"], input[name="OdeplanTarihi"], input[name="OdeplanNot"]').forEach(el => el.remove());

                // Gerekli inputları seç
                const tarihInput = form.querySelector(`input[name="OdeplanTarihi_${docNum}"]`);
                const notInput = form.querySelector(`input[name="OdeplanNot_${docNum}"]`);

                // Gizli inputlar oluştur
                form.appendChild(createHiddenInput("DocNum", docNum));
                form.appendChild(createHiddenInput("OdeplanTarihi", tarihInput ? tarihInput.value : ""));
                form.appendChild(createHiddenInput("OdeplanNot", notInput ? notInput.value : ""));

                form.submit(); // Formu gönder
            });
        });

        function createHiddenInput(name, value) {
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = name;
            input.value = value;
            return input;
        }
    </script>
}

<style>
    .table th {
        white-space: nowrap;
        position: sticky;
        top: 0;
        background-color: #343a40;
        color: white;
    }

    .table-responsive {
        max-height: 80vh;
        overflow-y: auto;
    }
</style>
