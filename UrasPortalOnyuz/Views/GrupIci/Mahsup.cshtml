                        <div class="table-responsive"><table class="na-tablo" id="mhKontrolTablo" data-dinamik="kapali"><thead><tr><th>Mahsup No</th><th>Tip</th><th>Şirket</th><th class="s">Tutar</th><th>Simülasyon</th><th>ERP Kaydı</th><th>İç Mutabakat</th><th>Kontrol</th></tr></thead><tbody></tbody></table></div>
                    </div>
