        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-filter me-1"></i>Filtreler</span><span class="d-flex gap-1"><button type="button" class="btn btn-light btn-sm py-0" id="mhRaporBuAy" style="font-size:.66rem">Bu ay</button><button type="button" class="btn btn-light btn-sm py-0" id="mhRaporTemizle" style="font-size:.66rem">Temizle</button><button type="button" class="btn btn-light btn-sm py-0" id="mhRaporExcel" style="font-size:.66rem"><i class="fas fa-file-excel me-1"></i>Rapor Excel</button><button type="button" class="btn btn-light btn-sm py-0" id="mhDetayExcel" style="font-size:.66rem"><i class="fas fa-file-excel me-1"></i>Detay Excel</button></span></div>
            <div class="na-kart-g">
                <div class="mh-filtre">
                    <div><label>Tarih Türü / Aralık</label><div class="d-flex gap-1"><select class="form-select" id="mhRfTarihTuru" style="max-width:110px"><option value="tarih">Mahsup</option><option value="kayitTarihi">Kayıt</option><option value="olusturma">Oluşturma</option><option value="onay">Onay</option><option value="muhasebe">Muhasebe</option></select><input class="form-control" type="date" id="mhRf1"><input class="form-control" type="date" id="mhRf2"></div></div>
                    <div><label>Şirket / Karşı Şirket</label><select class="form-select" id="mhRfSirket" multiple></select></div>
                    <div><label>Cari / Hesap (kod, unvan, hesap)</label><input class="form-control" id="mhRfCari" placeholder="Borç / alacak cari"></div>
                    <div><label>Belge (tür, no, referans)</label><input class="form-control" id="mhRfBelge" placeholder="SF-, AF-, AV-, referans"></div>
                    <div><label>Mahsup No / Neden / PB</label><div class="d-flex gap-1"><input class="form-control" id="mhRfNo" placeholder="MHS-"><select class="form-select" id="mhRfPb"><option value="">PB</option><option>TRY</option><option>USD</option><option>EUR</option></select></div></div>
                    <div><label>Mahsup Türü</label><select class="form-select" id="mhRfTur" multiple></select></div>
                    <div><label>Durum</label><select class="form-select" id="mhRfDurum" multiple></select></div>
                    <div><label>Muhasebe / Kontrol Durumu</label><div class="d-flex gap-1"><select class="form-select" id="mhRfMuh"><option value="">Muhasebe</option><option>Başlamadı</option><option>Mutabakat Oluştu</option><option>Muhasebeleşti</option><option>Kısmi</option><option>Hata</option><option>Ters Kayıt</option></select><select class="form-select" id="mhRfKontrol"><option value="">Kontrol</option></select></div></div>
                    <div><label>Kullanıcı (oluşturan / onaylayan / muhasebeleştiren)</label><input class="form-control" id="mhRfKisi" placeholder="Ad"></div>
                </div>
                <div class="na-mini" id="mhRaporSayi"></div>
                <div class="table-responsive"><table class="na-tablo" id="mhRaporTablo" data-dinamik="kapali"><thead><tr><th>Mahsup No</th><th>Tarih</th><th>Şirket / Karşı</th><th>Tür</th><th>Borç Cari</th><th>Alacak Cari</th><th class="s">Borç Seçilen</th><th class="s">Alacak Seçilen</th><th class="s">Mahsup Tutarı</th><th class="s">Kur Farkı</th><th class="s">Yuvarlama</th><th class="s">Belge</th><th>Tam/Kısmi</th><th class="s">Sonrası Açık</th><th>PB</th><th>Onay</th><th>Muhasebe</th><th>Kontrol</th><th>ERP Ref</th><th>Oluşturan</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div>
            </div>
        </div>
    </div>

    @* ================= SEKME 3 — MAHSUP MUHASEBE KONTROLÜ (§7) ================= *@
