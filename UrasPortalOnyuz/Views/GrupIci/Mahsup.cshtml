                <div class="na-kart-g">
                    <div class="na-filtre"><input class="form-control" id="mhListeAra" placeholder="Mahsup no, cari, belge…"><select class="form-select" id="mhListeDurum"><option value="">Durum: Tümü</option></select><select class="form-select" id="mhListeTur"><option value="">Tür: Tümü</option></select><span class="ms-auto na-mini" id="mhListeSayi"></span></div>
                    <div class="table-responsive"><table class="na-tablo" id="mhListe" data-dinamik="kapali"><thead><tr><th>Mahsup No</th><th>Tarih</th><th>Şirket / Karşı</th><th>Tür</th><th>Borç Cari</th><th>Alacak Cari</th><th class="s">Mahsup Tutarı</th><th class="s">Kur Farkı</th><th class="s">Belge</th><th>Kapama</th><th>Durum</th><th>Muhasebe</th><th>Kontrol</th></tr></thead><tbody></tbody></table></div>
                </div></div>
