                            <div class="na-kart-g">
                                <div class="mh-arac"><label class="mb-0">Otomatik eşleştirme</label><select class="form-select" id="mhYontem"></select><button type="button" class="btn btn-light btn-sm py-0" id="mhOtoEslestir" style="font-size:.68rem"><i class="fas fa-wand-magic-sparkles me-1"></i>Otomatik Eşleştir</button><button type="button" class="btn btn-light btn-sm py-0" id="mhSeciliMahsup" style="font-size:.68rem" title="Seçili borç / alacak kalemleri için tutarlardan dağılım oluşturur"><i class="fas fa-link me-1"></i>Seçili Kalemleri Mahsup Et</button><button type="button" class="btn btn-light btn-sm py-0" id="mhEslestirmeTemizle" style="font-size:.68rem"><i class="fas fa-eraser me-1"></i>Eşleştirmeyi Temizle</button><span class="ms-auto" id="mhEsitlik"></span></div>
                                <div class="table-responsive"><table class="mh-tablo" id="mhDagilim" data-dinamik="kapali" style="min-width:0"><thead><tr><th>Dağılım ID</th><th>Borç Belgesi</th><th>Alacak Belgesi</th><th class="s g">Mahsup Tutarı</th><th>PB</th><th class="s h">TL</th><th class="s h">Kur Farkı</th><th>Durum</th></tr></thead><tbody><tr><td colspan="8" class="na-bos">Kalem seçip tutar girince dağılım otomatik kurulur; N-N için tutarları burada düzenleyebilirsiniz.</td></tr></tbody><tfoot></tfoot></table></div>
                            </div>
                        </div>
                        @* ---- ALT: SİMÜLASYON (§5) ---- *@
