        <div class="na-kpi" id="mhKontrolKpi" data-dinamik="kapali"></div>
        <div class="row g-2">
            <div class="col-lg-7">
                <div class="na-kart">
                    <div class="na-kart-b"><span><i class="fas fa-file-invoice me-1"></i>Muhasebe Kontrol Listesi (§7.1)</span><span class="d-flex gap-1 align-items-center"><span class="not" id="mhKontrolSayi"></span><button type="button" class="btn btn-light btn-sm py-0" id="mhKontrolHepsi" style="font-size:.66rem"><i class="fas fa-rotate me-1"></i>Tümünü kontrol et</button><button type="button" class="btn btn-light btn-sm py-0" id="mhKontrolExcel" style="font-size:.66rem"><i class="fas fa-file-excel me-1"></i>Excel</button></span></div>
