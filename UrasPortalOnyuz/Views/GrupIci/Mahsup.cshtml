                <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo" id="mhOnayListe" data-dinamik="kapali"><thead><tr><th>Mahsup No</th><th>Şirket</th><th>Tür</th><th>Borç → Alacak</th><th class="s">Mahsup Tutarı</th><th>Bekleyen Adım</th><th>Onaycı</th><th>Neden</th><th>Hızlı İşlem</th></tr></thead><tbody></tbody></table></div></div></div>
        </div>
