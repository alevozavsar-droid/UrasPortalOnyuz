                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-code-compare me-1"></i>Beklenen – Gerçekleşen Muhasebe Kaydı (§7.2)</span><span class="not" id="mhKarsNo">listeden işlem seçin</span></div><div class="na-kart-g" id="mhKarsilastirma"><div class="na-bos">Kontrol listesinden bir işlem seçin.</div></div></div>
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-building me-1"></i>Grup Şirketleri Arası Mirror Kontrolü (§7.6)</span></div><div class="na-kart-g" id="mhMirror"><div class="na-bos">—</div></div></div>
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-list-check me-1"></i>Otomatik Kontrol Kuralları (§7.4)</span></div><div class="na-kart-g"><ol class="mb-0 ps-3 mh-legend" id="mhKontrolKurallar"></ol></div></div>
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-table me-1"></i>Hesap Eşleme Tablosu (§8)</span><span class="not">MAHSUP_HESAP_ESLEME · Mali İşler yönetir</span></div><div class="na-kart-g p-0"><div class="table-responsive" style="max-height:260px"><table class="na-tablo" id="mhEsleme" data-dinamik="kapali" style="font-size:.64rem"><thead><tr><th>#</th><th>Şirket</th><th>Tür</th><th>Hesap Rolü</th><th>PB</th><th>Hesap</th><th>BP</th><th>Geçerlilik</th><th>Aktif</th></tr></thead><tbody></tbody></table></div></div></div>
            </div>
        </div>
    </div>

    <div class="mh-perde" id="mhPerde"></div>
    <div class="mh-drawer" id="mhDrawer"><div class="mh-drawer-ust"><b id="mhDrawerBaslik" style="font-size:.85rem">Detay</b><button type="button" class="btn btn-light btn-sm py-0 ms-auto" id="mhDrawerAc" style="font-size:.66rem"><i class="fas fa-up-right-from-square me-1"></i>İşlem ekranında aç</button><button type="button" class="btn btn-light btn-sm py-0" id="mhDrawerKapat" style="font-size:.66rem"><i class="fas fa-xmark"></i></button></div><div id="mhDrawerIc"></div></div>
</div>

