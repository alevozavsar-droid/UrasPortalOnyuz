@model List<WebApplication3.Controllers.Rapor63ViewModel>
@using WebApplication3.Models

@{
    ViewData["Title"] = "OINM - Stok Hareket Denetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 1. KURAL: URL'den veya Cookie'den aktif şirketi okuyan değişken
    var currentDb = Context.Request.Query["db"].FirstOrDefault() ?? Context.Request.Cookies["AktifSirket"] ?? "";

    var currentSelectedDbDisplay = (string)ViewBag.CurrentDbDisplay ?? "Bilinmiyor";
    var modelData = Model ?? new List<WebApplication3.Controllers.Rapor63ViewModel>();

    var topGirenMiktar = modelData.Sum(x => x.GirenMiktar);
    var topGirisTutar = modelData.Sum(x => x.GirisTutari);
    var topCikanMiktar = modelData.Sum(x => x.CikanMiktar);
    var topCikisTutar = modelData.Sum(x => x.CikisTutari);
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, sans-serif;
            background-color: #f8f9fa;
            font-size: 0.80rem;
            overflow-y: hidden;
        }

        .container-fluid {
            padding: 4px 10px !important;
        }

        .form-control, .btn, .form-select {
            font-size: 11px;
            padding: 2px 6px;
            height: 28px;
        }

        /* --- SELECT2 EXCEL STİLİ --- */
        .select2-container--bootstrap-5 .select2-selection--multiple {
            min-height: 28px !important;
            height: 28px !important;
            font-size: 11px;
            padding: 0 4px;
            display: flex;
            align-items: center;
            overflow: hidden !important; 
        }

        .select2-selection__choice {
            display: none !important;
        }

        .select2-search--inline, .select2-search__field {
            margin: 0 !important;
            height: 24px !important;
        }

        .table-container {
            height: calc(100vh - 150px); /* Ana sayfaya dön butonu için yükseklik revize edildi */
            overflow: auto;
            border: 1px solid #dee2e6;
            background-color: white;
            margin-top: 5px;
        }

        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

        th, td {
            padding: 3px 4px !important;
            font-size: 11px !important;
            border: 1px solid #ddd;
            vertical-align: middle;
            color: #212529;
        }

        thead {
            position: sticky;
            top: 0;
            z-index: 10;
        }

        thead tr th {
            background-color: #2e4053;
            color: white;
            text-align: center;
            white-space: nowrap;
        }

        .nowrap-col {
            white-space: nowrap;
        }

        .wrap-text {
            white-space: normal !important;
            word-wrap: break-word;
            min-width: 120px;
            max-width: 250px;
        }

        .num {
            text-align: right;
            font-family: 'Consolas', monospace;
            font-weight: 700;
            white-space: nowrap;
        }

        tfoot tr {
            position: sticky;
            bottom: 0;
            z-index: 20;
            background-color: #dee2e6;
        }

        tfoot td {
            background-color: #dee2e6 !important;
            font-weight: bold;
            border-top: 2px solid #555;
        }
    </style>
}

@* 2. KURAL: Güvenlik (CSRF) - Yetkisiz veri işlemlerini engellemek için eklendi *@
@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-body p-2">
            <form asp-controller="Rapor63" asp-action="Index" method="get" id="raporForm">
                
                @* 1. KURAL: GET formuna şirket bilgisini ekleyen gizli input *@
                <input type="hidden" name="db" value="@currentDb" />

                <div class="row g-1 align-items-end">
                    <div class="col-auto">
                        <h6 class="m-0 fw-bold text-dark"><i class="fas fa-cubes me-2"></i>OINM Stok <span class="text-secondary small">(@currentSelectedDbDisplay)</span></h6>
                    </div>

                    <div class="col-auto ms-auto">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text fw-bold py-0">Başlangıç</span>
                            <input type="date" class="form-control" name="startDate" value="@ViewBag.StartDate">
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text fw-bold py-0">Bitiş</span>
                            <input type="date" class="form-control" name="endDate" value="@ViewBag.EndDate">
                        </div>
                    </div>

                    <div class="col-auto" style="min-width: 200px; max-width: 250px;">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text py-0"><i class="fas fa-box"></i></span>
                            <select class="form-select" name="selectedItems" id="itemSelect" multiple="multiple">
                                @if (ViewBag.ItemList != null)
                                {
                                    foreach (var item in (List<SelectListItem>)ViewBag.ItemList)
                                    {
                                        var isSelected = ViewBag.SelectedItems != null && ((List<string>)ViewBag.SelectedItems).Contains(item.Value);
                                        <option value="@item.Value" selected="@(isSelected ? "selected" : null)">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-auto">
                        <button type="submit" class="btn btn-dark w-100 fw-bold">Listele</button>
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-success w-100 fw-bold" id="exportToExcelButton">
                            <i class="fas fa-file-excel"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="table-container">
        @if (modelData.Any())
        {
            <table class="table table-bordered table-striped mb-0">
                <thead>
                    <tr>
                        <th>Malzeme Kodu</th>
                        <th>Malzeme Adı</th>
                        <th>Birim</th>
                        <th>İşlem Tar.</th>
                        <th>Belge Tar.</th>
                        <th>İade</th>
                        <th>Süreç</th>
                        <th>Hareket</th>
                        <th>Ref No</th>
                        <th>Belge No</th>
                        <th>Giren Mik.</th>
                        <th>Giriş Fiyat</th>
                        <th>Giriş Tutar</th>
                        <th>Anlaş. Döviz</th>
                        <th>Çıkan Mik.</th>
                        <th>Sipariş No</th>
                        <th>Satış Mik.</th>
                        <th>Fat. Mik.</th>
                        <th>Çıkış Fiyat</th>
                        <th>Çıkış Tutar</th>
                        <th>Envanter</th>
                        <th>Cari Tipi</th>
                        <th>Cari Kodu</th>
                        <th>Cari Adı</th>
                        <th>Depo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in modelData)
                    {
                        <tr>
                            <td class="fw-bold nowrap-col">@item.MalzemeKodu</td>
                            <td class="wrap-text">@item.MalzemeAdi</td>
                            <td class="text-center nowrap-col">@item.BirimCinsi</td>
                            <td class="text-center nowrap-col">@item.IslemTarihi.ToString("dd.MM.yyyy")</td>
                            <td class="text-center nowrap-col">@item.BelgeTarihi.ToString("dd.MM.yyyy")</td>
                            <td class="text-center text-danger fw-bold nowrap-col">@item.Iade</td>
                            <td class="wrap-text small">@item.SurecAciklamasi</td>
                            <td class="text-center nowrap-col">@item.StokHareketSekli</td>
                            <td class="nowrap-col">@item.BelgeRefNo</td>
                            <td class="nowrap-col">@item.BelgeNo</td>
                            <td class="num text-success">@item.GirenMiktar.ToString("N2")</td>
                            <td class="num">@item.GirisFiyati.ToString("N2")</td>
                            <td class="num text-success">@item.GirisTutari.ToString("N2")</td>
                            <td class="text-center text-primary fw-bold nowrap-col" style="font-size:10px;">@item.AnlasilanDoviz</td>
                            <td class="num text-danger">@item.CikanMiktar.ToString("N2")</td>
                            <td class="text-center nowrap-col">@((item.SiparisNo == 0) ? "" : item.SiparisNo.ToString())</td>
                            <td class="num">@item.SatisMiktar.ToString("N2")</td>
                            <td class="num">@item.FaturalanmisMiktar.ToString("N2")</td>
                            <td class="num">@item.CikisFiyati.ToString("N2")</td>
                            <td class="num text-danger">@item.CikisTutari.ToString("N2")</td>
                            <td class="num fw-bold">@item.Envanter.ToString("N2")</td>
                            <td class="nowrap-col" style="font-size:10px;">@item.CariTipiAciklamasi</td>
                            <td class="nowrap-col">@item.CariKodu</td>
                            <td class="wrap-text">@item.CariAdi</td>
                            <td class="text-center nowrap-col">@item.DepoKodu</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="10" class="text-end"><strong>TOPLAMLAR:</strong></td>
                        <td class="num">@topGirenMiktar.ToString("N2")</td>
                        <td></td>
                        <td class="num">@topGirisTutar.ToString("N2")</td>
                        <td></td>
                        <td class="num">@topCikanMiktar.ToString("N2")</td>
                        <td colspan="4"></td>
                        <td class="num">@topCikisTutar.ToString("N2")</td>
                        <td colspan="5"></td>
                    </tr>
                </tfoot>
            </table>
        }
        else
        {
            <div class="alert alert-warning m-3 text-center">Veri bulunamadı.</div>
        }
    </div>

    @* 4. KURAL: UI/UX Standartlarına uygun şık, db parametreli Ana Sayfa butonu *@
    <div class="mt-3 mb-2 text-center">
        <a asp-controller="Home" asp-action="Index" asp-route-db="@currentDb" class="btn btn-outline-secondary fw-bold shadow-sm">
            <i class="fas fa-home me-2"></i> Ana Sayfaya Dön
        </a>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            var $itemSelect = $('#itemSelect');

            $itemSelect.select2({
                theme: 'bootstrap-5',
                placeholder: "Malzeme Seçiniz",
                allowClear: true,
                width: '100%',
                closeOnSelect: false
            });

            function updateSelectionText() {
                var count = $itemSelect.val() ? $itemSelect.val().length : 0;
                var $rendered = $('.select2-selection__rendered');
                if (count > 0) {
                    $rendered.html('<span class="text-primary fw-bold">' + count + ' Malzeme Seçildi</span>');
                }
            }

            $itemSelect.on('change', updateSelectionText);
            updateSelectionText(); 

            $('#exportToExcelButton').on('click', function () {
                var startDate = $('input[name="startDate"]').val();
                var endDate = $('input[name="endDate"]').val();
                var selectedItems = $itemSelect.val();

                // 1. KURAL: Şirket bilgisini Razor'dan garanti şekilde exportUrl'e bağlıyoruz
                var exportUrl = '@Url.Action("ExportToExcel", "Rapor63")' + 
                                '?startDate=' + startDate + 
                                '&endDate=' + endDate + 
                                '&db=' + encodeURIComponent('@currentDb');

                if (selectedItems && selectedItems.length > 0) {
                    selectedItems.forEach(function(item) { 
                        exportUrl += '&selectedItems=' + encodeURIComponent(item); 
                    });
                }
                
                window.location.href = exportUrl;
            });
        });
    </script>
}