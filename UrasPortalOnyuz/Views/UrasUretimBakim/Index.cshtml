@{
    ViewData["Title"] = "Arıza & Bakım";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0 text-gray-800 fw-bold"><i class="fas fa-screwdriver-wrench me-2 text-primary"></i> Arıza &amp; Bakım İzleme</h2>
    <button class="btn btn-primary btn-sm" onclick="yeniArizaAc()"><i class="fas fa-plus me-1"></i>Yeni Arıza / Bakım</button>
</div>
<div class="alert alert-info py-2 small mb-3">
    <i class="fas fa-circle-info me-1"></i> Tüm kayıt/güncelleme/silme işlemleri SAP Service Layer üzerinden yapılır (URASKIMYA, üstteki şirket seçiciden bağımsız).
    Checklist şablon yönetimi var, saha cevap girişi yok (canlı şema doğrulaması bekliyor).
</div>

<ul class="nav nav-tabs mb-3" id="bakimTab">
    <li class="nav-item"><button class="nav-link active" data-tab="ozet" onclick="sekmeSec('ozet')">Özet</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="arizalar" onclick="sekmeSec('arizalar')">Arıza / Bakım Kayıtları</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="periyodik" onclick="sekmeSec('periyodik')">Periyodik Bakım Planı</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="makineler" onclick="sekmeSec('makineler')">Makineler</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="analiz" onclick="sekmeSec('analiz')">Analiz</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="tanimlar" onclick="sekmeSec('tanimlar')">Personel / Kodlar / Kataloglar</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="ayarlar" onclick="sekmeSec('ayarlar')">Ayarlar</button></li>
</ul>

<!-- ÖZET -->
<div id="tab-ozet" class="bakim-tab">
    <div id="ozetYukleniyor" class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm me-2"></span>Yükleniyor…</div>
    <div class="row g-3" id="ozetKartlari" style="display:none;"></div>
</div>

<!-- ARIZALAR -->
<div id="tab-arizalar" class="bakim-tab" style="display:none;">
    <div class="card dash-card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-bold">Durum</label>
                    <select id="fDurum" class="form-select form-select-sm" onchange="arizalariYukle()">
                        <option value="Acik" selected>Açık</option><option value="Kapali">Kapalı</option><option value="Tumu">Tümü</option>
                        <option value="Beklemede">Beklemede</option><option value="Atandi">Atandı</option><option value="DevamEdiyor">Devam Ediyor</option><option value="OnayBekliyor">Onay Bekliyor</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-bold">Tip</label>
                    <select id="fTip" class="form-select form-select-sm" onchange="arizalariYukle()"><option value="">Tümü</option><option value="ARIZA">Arıza</option><option value="BAKIM">Bakım</option><option value="PLANLI">Planlı</option></select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-bold">Öncelik</label>
                    <select id="fOncelik" class="form-select form-select-sm" onchange="arizalariYukle()"><option value="">Tümü</option><option value="Acil">Acil</option><option value="Yuksek">Yüksek</option><option value="Normal">Normal</option></select>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold">Makine</label>
                    <select id="fResCode" class="form-select form-select-sm" onchange="arizalariYukle()"><option value="">Tümü</option></select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-bold">Ara</label>
                    <input type="text" id="fAra" class="form-control form-control-sm" placeholder="Arıza no, makine, açıklama…" oninput="aramaDegisti()">
                </div>
            </div>
        </div>
    </div>
    <div id="arizaYukleniyor" class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm me-2"></span>Yükleniyor…</div>
    <div class="table-responsive" style="display:none;" id="arizaTabloKutu">
        <table class="table table-hover table-custom mb-0">
            <thead><tr><th>No</th><th>Tip</th><th>Durum</th><th>Öncelik</th><th>Makine</th><th>Atanan</th><th>Bildirim</th><th class="text-end">Süre</th><th class="text-end">Tutar</th><th></th></tr></thead>
            <tbody id="tbodyArizalar"></tbody>
        </table>
    </div>
</div>

<!-- PERİYODİK BAKIM -->
<div id="tab-periyodik" class="bakim-tab" style="display:none;">
    <div class="d-flex justify-content-end mb-2">
        <button class="btn btn-outline-primary btn-sm" onclick="yeniPeriyodikAc()"><i class="fas fa-plus me-1"></i>Yeni Planlı Bakım</button>
    </div>
    <div id="periyodikYukleniyor" class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm me-2"></span>Yükleniyor…</div>
    <div class="table-responsive" style="display:none;" id="periyodikTabloKutu">
        <table class="table table-hover table-custom mb-0">
            <thead><tr><th>Makine</th><th>Bakım İşlemi</th><th>Planlanan Tarih</th><th class="text-end">Kalan Gün</th><th>Öncelik</th><th>Durum</th><th></th></tr></thead>
            <tbody id="tbodyPeriyodik"></tbody>
        </table>
    </div>
</div>

<!-- MAKİNELER -->
<div id="tab-makineler" class="bakim-tab" style="display:none;">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <input type="text" id="fMakineAra" class="form-control form-control-sm" style="max-width:280px" placeholder="Makine ara…" oninput="cizMakineler()">
        <button class="btn btn-outline-primary btn-sm" onclick="makineDuzenleAc(null)"><i class="fas fa-plus me-1"></i>Yeni Makine</button>
    </div>
    <div id="makineYukleniyor" class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm me-2"></span>Yükleniyor…</div>
    <div class="row g-3" id="makineKartlari"></div>
</div>

<!-- ANALİZ -->
<div id="tab-analiz" class="bakim-tab" style="display:none;">
    <div class="card dash-card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-6 col-md-3"><label class="form-label small fw-bold">Başlangıç</label><input type="date" id="aBas" class="form-control form-control-sm"></div>
                <div class="col-6 col-md-3"><label class="form-label small fw-bold">Bitiş</label><input type="date" id="aBit" class="form-control form-control-sm"></div>
                <div class="col-12 col-md-3"><button class="btn btn-primary btn-sm" onclick="analizYukle()"><i class="fas fa-rotate me-1"></i>Getir</button></div>
            </div>
        </div>
    </div>
    <div id="analizYukleniyor" class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm me-2"></span>Yükleniyor…</div>
    <div id="analizIcerik" style="display:none;">
        <div class="row g-3 mb-3" id="analizKpi"></div>
        <div class="row g-3 mb-3">
            <div class="col-12 col-xl-7">
                <div class="card dash-card h-100"><div class="card-header bg-white fw-bold small text-uppercase text-muted">Aylık Arıza / Bakım</div><div class="card-body"><div id="chartAylik" style="min-height:260px;"></div></div></div>
            </div>
            <div class="col-12 col-xl-5">
                <div class="card dash-card h-100"><div class="card-header bg-white fw-bold small text-uppercase text-muted">Kategoriye Göre Arıza</div><div class="card-body"><div id="chartKategori" style="min-height:260px;"></div></div></div>
            </div>
        </div>
        <div class="card dash-card">
            <div class="card-header bg-white fw-bold small text-uppercase text-muted">Makine Bazlı</div>
            <div class="table-responsive">
                <table class="table table-hover table-custom mb-0">
                    <thead><tr><th>Makine</th><th class="text-end">Arıza</th><th class="text-end">Bakım</th><th class="text-end">Duruş (dk)</th><th class="text-end">MTTR (dk)</th><th class="text-end">Tutar</th></tr></thead>
                    <tbody id="tbodyAnalizMakine"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- PERSONEL / KODLAR / KATALOGLAR -->
<div id="tab-tanimlar" class="bakim-tab" style="display:none;">
    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="card dash-card">
                <div class="card-header bg-white fw-bold small text-uppercase text-muted d-flex justify-content-between align-items-center">
                    Bakım Personeli
                    <button class="btn btn-outline-primary btn-sm py-0" onclick="personelDuzenleAc(null)"><i class="fas fa-plus"></i></button>
                </div>
                <div class="table-responsive"><table class="table table-hover table-custom mb-0">
                    <thead><tr><th>Ad</th><th>Tip</th><th>Uzmanlık</th><th class="text-end">Açık İş</th><th></th></tr></thead>
                    <tbody id="tbodyPersonel"></tbody>
                </table></div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card dash-card">
                <div class="card-header bg-white fw-bold small text-uppercase text-muted d-flex justify-content-between align-items-center">
                    Arıza/Bakım Kodları
                    <button class="btn btn-outline-primary btn-sm py-0" onclick="kodDuzenleAc(null)"><i class="fas fa-plus"></i></button>
                </div>
                <div class="table-responsive"><table class="table table-hover table-custom mb-0">
                    <thead><tr><th>Tip</th><th>Ad</th><th>Açıklama</th><th></th></tr></thead>
                    <tbody id="tbodyKodlar"></tbody>
                </table></div>
            </div>
        </div>
        <div class="col-12">
            <div class="card dash-card">
                <div class="card-header bg-white fw-bold small text-uppercase text-muted d-flex justify-content-between align-items-center">
                    Bakım İşlem Kataloğu (periyodik bakım tanımları)
                    <button class="btn btn-outline-primary btn-sm py-0" onclick="bakimIslemDuzenleAc(null)"><i class="fas fa-plus"></i></button>
                </div>
                <div class="table-responsive"><table class="table table-hover table-custom mb-0">
                    <thead><tr><th>İşlem</th><th>Periyot</th><th>Makine Türü</th><th>Bakım Tipi</th><th class="text-end">Süre</th><th>Malzeme</th><th></th></tr></thead>
                    <tbody id="tbodyBakimIslem"></tbody>
                </table></div>
            </div>
        </div>
        <div class="col-12">
            <div class="card dash-card">
                <div class="card-header bg-white fw-bold small text-uppercase text-muted d-flex justify-content-between align-items-center">
                    Checklist Şablonları
                    <button class="btn btn-outline-primary btn-sm py-0" onclick="checklistDuzenleAc(null)"><i class="fas fa-plus"></i></button>
                </div>
                <div class="table-responsive"><table class="table table-hover table-custom mb-0">
                    <thead><tr><th>Makine Türü</th><th>Tip</th><th>İşlem</th><th class="text-end">Soru Sayısı</th><th>Durum</th><th></th></tr></thead>
                    <tbody id="tbodyChecklist"></tbody>
                </table></div>
            </div>
        </div>
        <div class="col-12">
            <div class="card dash-card">
                <div class="card-header bg-white fw-bold small text-uppercase text-muted">Malzeme Ara (Stok)</div>
                <div class="card-body">
                    <input type="text" id="fMlzAra" class="form-control form-control-sm mb-2" style="max-width:320px" placeholder="Kalem kodu / adı…" oninput="malzemeAramaDegisti()">
                    <div class="table-responsive"><table class="table table-sm table-custom mb-0">
                        <thead><tr><th>Kod</th><th>Ad</th><th class="text-end">Stok</th><th>Depo</th></tr></thead>
                        <tbody id="tbodyMalzeme"></tbody>
                    </table></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- AYARLAR -->
<div id="tab-ayarlar" class="bakim-tab" style="display:none;">
    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="card dash-card">
                <div class="card-header bg-white fw-bold small text-uppercase text-muted">Genel Ayarlar</div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-6"><label class="form-label small fw-bold">Arıza Kod Öneki</label><input type="text" id="ayArizaOnek" class="form-control form-control-sm"></div>
                        <div class="col-6"><label class="form-label small fw-bold">Bakım Kod Öneki</label><input type="text" id="ayBakimOnek" class="form-control form-control-sm"></div>
                        <div class="col-6"><label class="form-label small fw-bold">Mesai Başlangıç</label><input type="text" id="ayMesaiBas" class="form-control form-control-sm" placeholder="08:00"></div>
                        <div class="col-6"><label class="form-label small fw-bold">Mesai Bitiş</label><input type="text" id="ayMesaiBit" class="form-control form-control-sm" placeholder="18:00"></div>
                        <div class="col-6"><label class="form-label small fw-bold">Hatırlatma Günü</label><input type="number" id="ayHatirlatmaGun" class="form-control form-control-sm"></div>
                        <div class="col-6"><label class="form-label small fw-bold">Para Birimi</label><input type="text" id="ayParaBirimi" class="form-control form-control-sm"></div>
                        <div class="col-12"><label class="form-label small fw-bold">Varsayılan Depo</label><input type="text" id="ayVarsayilanDepo" class="form-control form-control-sm"></div>
                        <div class="col-6"><div class="form-check form-switch mt-2"><input class="form-check-input" type="checkbox" id="ayOnayZorunlu"><label class="form-check-label small" for="ayOnayZorunlu">Onay zorunlu</label></div></div>
                        <div class="col-6"><div class="form-check form-switch mt-2"><input class="form-check-input" type="checkbox" id="ayOnayDisServis"><label class="form-check-label small" for="ayOnayDisServis">Dış servis onayı</label></div></div>
                        <div class="col-6"><label class="form-label small fw-bold">Onay Tutar Eşiği</label><input type="number" id="ayOnayTutar" class="form-control form-control-sm"></div>
                        <div class="col-12"><label class="form-label small fw-bold">Ek Hatırlatma E-postaları (; ile ayır)</label><input type="text" id="ayHatirlatmaMail" class="form-control form-control-sm"></div>
                    </div>
                </div>
                <div class="card-footer bg-white d-flex gap-2">
                    <button class="btn btn-primary btn-sm" onclick="ayarlarKaydet()"><i class="fas fa-check me-1"></i>Kaydet</button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="hatirlatmaGonderTiklandi()"><i class="fas fa-bell me-1"></i>Hatırlatma Gönder</button>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card dash-card mb-3">
                <div class="card-header bg-white fw-bold small text-uppercase text-muted">Test Maili</div>
                <div class="card-body">
                    <div class="input-group input-group-sm">
                        <input type="email" id="testMailAdres" class="form-control" placeholder="kullanici@@ornek.local">
                        <button class="btn btn-outline-primary" onclick="testMailGonder()"><i class="fas fa-paper-plane me-1"></i>Gönder</button>
                    </div>
                </div>
            </div>
            <div class="card dash-card">
                <div class="card-header bg-white fw-bold small text-uppercase text-muted d-flex justify-content-between align-items-center">
                    Mail Alıcıları
                    <button class="btn btn-outline-primary btn-sm py-0" onclick="mailAliciDuzenleAc(null)"><i class="fas fa-plus"></i></button>
                </div>
                <div class="table-responsive"><table class="table table-hover table-custom mb-0">
                    <thead><tr><th>Olay</th><th>E-posta</th><th>Durum</th><th></th></tr></thead>
                    <tbody id="tbodyMailAlici"></tbody>
                </table></div>
            </div>
        </div>
    </div>
</div>

<!-- ARIZA DETAY MODAL -->
<div class="modal fade" id="detayModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="detayBaslik">Kayıt Detayı</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body" id="detayIcerik"><div class="text-center py-4"><span class="spinner-border"></span></div></div>
        </div>
    </div>
</div>

<!-- YENİ ARIZA / BAKIM MODAL -->
<div class="modal fade" id="yeniArizaModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Yeni Arıza / Bakım Bildirimi</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label small fw-bold">Tip</label>
                        <select id="yaTip" class="form-select form-select-sm"><option value="ARIZA">Arıza</option><option value="PLANLI">Planlı Bakım</option></select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Öncelik</label>
                        <select id="yaOncelik" class="form-select form-select-sm"><option value="Normal">Normal</option><option value="Yuksek">Yüksek</option><option value="Acil">Acil</option></select>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">Makine *</label>
                        <select id="yaResCode" class="form-select form-select-sm"><option value="">Seçin…</option></select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Kategori</label>
                        <input type="text" id="yaKategori" class="form-control form-control-sm">
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Neden</label>
                        <input type="text" id="yaNeden" class="form-control form-control-sm">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">Açıklama *</label>
                        <textarea id="yaAciklama" class="form-control form-control-sm" rows="3"></textarea>
                    </div>
                    <div class="col-6">
                        <div class="form-check form-switch mt-2"><input class="form-check-input" type="checkbox" id="yaUretimDurdu"><label class="form-check-label small" for="yaUretimDurdu">Üretim durdu</label></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                <button class="btn btn-primary btn-sm" onclick="yeniArizaKaydet()"><i class="fas fa-check me-1"></i>Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- YENİ PLANLI (PERİYODİK) BAKIM MODAL -->
<div class="modal fade" id="periyodikModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Yeni Planlı Bakım</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label small fw-bold">Makine *</label>
                        <select id="pbResCode" class="form-select form-select-sm"><option value="">Seçin…</option></select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Bakım İşlemi (periyot) *</label>
                        <select id="pbBkmPeriodEntry" class="form-select form-select-sm"><option value="">Seçin…</option></select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Planlanan Tarih</label>
                        <input type="date" id="pbPlanlananTarih" class="form-control form-control-sm">
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Periyot (Gün) — boşsa kataloğun periyodu kullanılır</label>
                        <input type="number" id="pbBakimGun" class="form-control form-control-sm" value="0">
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Tonaj</label>
                        <input type="number" id="pbTonaj" class="form-control form-control-sm" value="0">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">Açıklama</label>
                        <input type="text" id="pbAciklama" class="form-control form-control-sm">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                <button class="btn btn-primary btn-sm" onclick="periyodikKaydetTiklandi()"><i class="fas fa-check me-1"></i>Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- DURUŞ KAYDET MODAL -->
<div class="modal fade" id="durusModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Duruş Kaydı</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="drDocEntry">
                <div class="row g-2">
                    <div class="col-12"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="drUretimDurdu"><label class="form-check-label small fw-bold" for="drUretimDurdu">Üretim durdu / duruyor</label></div></div>
                    <div class="col-6"><label class="form-label small fw-bold">Duruş Başlangıcı</label><input type="datetime-local" id="drBas" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small fw-bold">Duruş Bitişi (devam ediyorsa boş bırakın)</label><input type="datetime-local" id="drBit" class="form-control form-control-sm"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                <button class="btn btn-primary btn-sm" onclick="durusKaydetTiklandi()"><i class="fas fa-check me-1"></i>Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- MAKİNE DÜZENLE MODAL -->
<div class="modal fade" id="makineModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="makineModalBaslik">Makine</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
