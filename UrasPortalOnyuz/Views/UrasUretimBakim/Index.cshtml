    // ================= BAKIM İŞLEM KATALOĞU (CRUD) =================
    function biMalzemeSatiriEkle(m) {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td><input type="text" class="form-control form-control-sm biItemCode" value="${m ? m.ItemCode : ''}"></td>
            <td><input type="text" class="form-control form-control-sm biItemName" value="${m ? (m.ItemName || '') : ''}"></td>
            <td><input type="number" class="form-control form-control-sm biQuantity" value="${m ? m.Quantity : 0}"></td>
            <td><input type="text" class="form-control form-control-sm biItemUom" value="${m ? (m.ItemUom || '') : ''}"></td>
            <td><button class="btn btn-sm btn-link p-0 text-danger" onclick="this.closest('tr').remove()"><i class="fas fa-times"></i></button></td>`;
        document.getElementById('biMalzemeSatirlari').appendChild(tr);
    }

    function bakimIslemDuzenleAc(docEntry) {
        const b = docEntry ? bakimIslemCache.find(x => x.DocEntry === docEntry) : null;
        document.getElementById('biDocEntry').value = b ? b.DocEntry : 0;
        document.getElementById('biIslemAdi').value = b ? b.IslemAdi : '';
        document.getElementById('biGun').value = b ? b.Gun : 0;
        document.getElementById('biTonaj').value = b ? b.Tonaj : 0;
        document.getElementById('biSure').value = b ? b.TahminiSureDk : 0;
        document.getElementById('biMakineTuru').value = b ? (b.MakineTuru || '') : '';
        document.getElementById('biBakimTipi').value = b ? (b.BakimTipi || '') : '';
        document.getElementById('biIcDis').value = b ? b.IcDis : 'I';
        document.getElementById('biTalimat').value = b ? (b.Talimat || '') : '';
        document.getElementById('biAktif').checked = b ? (b.Aktif === 'Y') : true;
        document.getElementById('biMalzemeSatirlari').innerHTML = '';
        (b?.Malzemeler || []).forEach(m => biMalzemeSatiriEkle(m));
        document.getElementById('biSilBtn').style.display = b ? '' : 'none';
        new bootstrap.Modal(document.getElementById('bakimIslemModal')).show();
    }

    async function bakimIslemKaydetTiklandi() {
        const islemAdi = document.getElementById('biIslemAdi').value.trim();
        if (!islemAdi) { alert('İşlem adı zorunludur.'); return; }
        const malzemeler = [...document.querySelectorAll('#biMalzemeSatirlari tr')].map(tr => ({
            ItemCode: tr.querySelector('.biItemCode').value.trim(), ItemName: tr.querySelector('.biItemName').value.trim(),
            Quantity: parseFloat(tr.querySelector('.biQuantity').value || '0'), ItemUom: tr.querySelector('.biItemUom').value.trim()
        })).filter(m => m.ItemCode);
        const istek = {
            DocEntry: parseInt(document.getElementById('biDocEntry').value || '0', 10), IslemAdi: islemAdi,
            Gun: parseInt(document.getElementById('biGun').value || '0', 10), Tonaj: parseFloat(document.getElementById('biTonaj').value || '0'),
            TahminiSureDk: parseInt(document.getElementById('biSure').value || '0', 10), MakineTuru: document.getElementById('biMakineTuru').value,
            BakimTipi: document.getElementById('biBakimTipi').value, IcDis: document.getElementById('biIcDis').value, Talimat: document.getElementById('biTalimat').value,
            Aktif: document.getElementById('biAktif').checked, Malzemeler: malzemeler
        };
        const res = await fetch('/UrasUretimBakim/BakimIslemKaydet', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(istek) }).then(r => r.json());
        if (!res.success) { alert('Kaydedilemedi: ' + res.message); return; }
        bootstrap.Modal.getInstance(document.getElementById('bakimIslemModal')).hide();
        bakimIslemCache = []; tanimlariYukle();
    }

    async function bakimIslemSilTiklandi() {
        const docEntry = document.getElementById('biDocEntry').value;
        if (!docEntry || docEntry === '0' || !confirm('Bu bakım işlemini silmek istediğinize emin misiniz?')) return;
        const fd = new FormData(); fd.append('docEntry', docEntry);
        const res = await fetch('/UrasUretimBakim/BakimIslemSil', { method: 'POST', body: fd }).then(r => r.json());
        if (!res.success) { alert('Silinemedi: ' + res.message); return; }
        bootstrap.Modal.getInstance(document.getElementById('bakimIslemModal')).hide();
        bakimIslemCache = []; tanimlariYukle();
    }

    // ================= CHECKLİST ŞABLONLARI (CRUD) =================
    function ckSoruEkle(s) {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td><input type="number" class="form-control form-control-sm ckOrder" value="${s ? s.Sira : 0}"></td>
            <td><input type="text" class="form-control form-control-sm ckQuestion" value="${s ? (s.Question || '').replace(/"/g, '&quot;') : ''}"></td>
            <td class="text-center"><input type="checkbox" class="form-check-input ckZorunlu" ${s && s.Zorunlu === 'Y' ? 'checked' : ''}></td>
            <td><button class="btn btn-sm btn-link p-0 text-danger" onclick="this.closest('tr').remove()"><i class="fas fa-times"></i></button></td>`;
        document.getElementById('ckSorular').appendChild(tr);
    }

    function ckIslemSelectDoldur(secili) {
        const sel = document.getElementById('ckIslemEntry');
        sel.innerHTML = '<option value="">—</option>' + bakimIslemCache.map(b => `<option value="${b.DocEntry}" ${secili === b.DocEntry ? 'selected' : ''}>${b.IslemAdi}</option>`).join('');
    }

    function checklistDuzenleAc(docEntry) {
        const c = docEntry ? checklistCache.find(x => x.DocEntry === docEntry) : null;
        document.getElementById('ckDocEntry').value = c ? c.DocEntry : 0;
        document.getElementById('ckResCode').value = c ? c.ResCode : '';
        document.getElementById('ckTip').value = c ? c.Tip : 'ARIZA';
        ckIslemSelectDoldur(c ? c.IslemEntry : null);
        document.getElementById('ckAktif').checked = c ? (c.Active === 'Y') : true;
        document.getElementById('ckSorular').innerHTML = '';
        (c?.Items || []).forEach(s => ckSoruEkle(s));
        document.getElementById('ckSilBtn').style.display = c ? '' : 'none';
        new bootstrap.Modal(document.getElementById('checklistModal')).show();
    }

    async function checklistKaydetTiklandi() {
        const resCode = document.getElementById('ckResCode').value.trim();
        if (!resCode) { alert('Makine türü zorunludur.'); return; }
        const sorular = [...document.querySelectorAll('#ckSorular tr')].map(tr => ({
            Order: parseInt(tr.querySelector('.ckOrder').value || '0', 10), Question: tr.querySelector('.ckQuestion').value.trim(), Zorunlu: tr.querySelector('.ckZorunlu').checked
        })).filter(s => s.Question);
        if (sorular.length === 0) { alert('En az bir soru girin.'); return; }
        const islemEntry = document.getElementById('ckIslemEntry').value;
        const istek = {
            DocEntry: parseInt(document.getElementById('ckDocEntry').value || '0', 10), ResCode: resCode, Tip: document.getElementById('ckTip').value,
            IslemEntry: islemEntry ? parseInt(islemEntry, 10) : null, Aktif: document.getElementById('ckAktif').checked, Sorular: sorular
        };
        const res = await fetch('/UrasUretimBakim/ChecklistSablonKaydet', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(istek) }).then(r => r.json());
        if (!res.success) { alert('Kaydedilemedi: ' + res.message); return; }
        bootstrap.Modal.getInstance(document.getElementById('checklistModal')).hide();
        checklistCache = []; tanimlariYukle();
    }

    async function checklistSilTiklandi() {
        const docEntry = document.getElementById('ckDocEntry').value;
        if (!docEntry || docEntry === '0' || !confirm('Bu checklist şablonunu silmek istediğinize emin misiniz?')) return;
        const fd = new FormData(); fd.append('docEntry', docEntry);
        const res = await fetch('/UrasUretimBakim/ChecklistSablonSil', { method: 'POST', body: fd }).then(r => r.json());
        if (!res.success) { alert('Silinemedi: ' + res.message); return; }
        bootstrap.Modal.getInstance(document.getElementById('checklistModal')).hide();
        checklistCache = []; tanimlariYukle();
    }

    // ================= AYARLAR =================
    async function ayarlarYukle() {
        const [aRes, mRes] = await Promise.all([
            fetch('/UrasUretimBakim/GetAyar').then(r => r.json()),
            fetch('/UrasUretimBakim/GetMailAlicilar').then(r => r.json())
        ]);
        if (aRes.success) {
            const a = aRes.data;
            document.getElementById('ayArizaOnek').value = a.ArizaOnek || '';
            document.getElementById('ayBakimOnek').value = a.BakimOnek || '';
            document.getElementById('ayMesaiBas').value = a.MesaiBas || '';
            document.getElementById('ayMesaiBit').value = a.MesaiBit || '';
            document.getElementById('ayHatirlatmaGun').value = a.HatirlatmaGun || 7;
            document.getElementById('ayParaBirimi').value = a.ParaBirimi || '';
            document.getElementById('ayVarsayilanDepo').value = a.VarsayilanDepo || '';
            document.getElementById('ayOnayZorunlu').checked = !!a.OnayZorunlu;
            document.getElementById('ayOnayDisServis').checked = !!a.OnayDisServis;
            document.getElementById('ayOnayTutar').value = a.OnayTutar || 0;
        }
        if (mRes.success) {
            mailAliciCache = mRes.data;
            document.getElementById('tbodyMailAlici').innerHTML = mailAliciCache.map(m => `<tr>
                <td>${m.Olay}</td><td>${m.Email}</td><td><span class="rozet ${m.Aktif === 'Y' ? 'rozet-yesil' : 'rozet-gri'}">${m.Aktif === 'Y' ? 'Aktif' : 'Pasif'}</span></td>
                <td class="text-end"><button class="btn btn-sm btn-link p-0 text-muted me-2" onclick='mailAliciDuzenleAc(${JSON.stringify(m.Code)})'><i class="fas fa-pen"></i></button><button class="btn btn-sm btn-link p-0 text-danger" onclick='mailAliciSilTiklandi(${JSON.stringify(m.Code)})'><i class="fas fa-trash"></i></button></td></tr>`).join('') || '<tr><td colspan="4" class="text-center text-muted py-3">Mail alıcısı yok.</td></tr>';
        }
        document.getElementById('tab-ayarlar').dataset.yuklendi = '1';
    }

    async function ayarlarKaydet() {
        const istek = {
            ArizaOnek: document.getElementById('ayArizaOnek').value, BakimOnek: document.getElementById('ayBakimOnek').value,
            MesaiBas: document.getElementById('ayMesaiBas').value, MesaiBit: document.getElementById('ayMesaiBit').value,
            HatirlatmaGun: parseInt(document.getElementById('ayHatirlatmaGun').value || '7', 10), ParaBirimi: document.getElementById('ayParaBirimi').value,
            VarsayilanDepo: document.getElementById('ayVarsayilanDepo').value, OnayZorunlu: document.getElementById('ayOnayZorunlu').checked,
            OnayDisServis: document.getElementById('ayOnayDisServis').checked, OnayTutar: parseFloat(document.getElementById('ayOnayTutar').value || '0'),
            HatirlatmaMail: document.getElementById('ayHatirlatmaMail').value
        };
        const res = await fetch('/UrasUretimBakim/AyarKaydet', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(istek) }).then(r => r.json());
        alert(res.success ? 'Ayarlar kaydedildi.' : 'Kaydedilemedi: ' + res.message);
    }

    async function hatirlatmaGonderTiklandi() {
        if (!confirm('Yaklaşan/gecikmiş periyodik bakımlar için tanımlı mail alıcılarına hatırlatma göndermek istiyor musunuz?')) return;
        const res = await fetch('/UrasUretimBakim/HatirlatmaGonder', { method: 'POST' }).then(r => r.json());
        alert(res.message);
    }

    async function testMailGonder() {
        const email = document.getElementById('testMailAdres').value.trim();
        if (!email) { alert('E-posta girin.'); return; }
        const fd = new FormData(); fd.append('email', email);
        const res = await fetch('/UrasUretimBakim/TestMail', { method: 'POST', body: fd }).then(r => r.json());
        alert(res.message);
    }

    // ================= MAIL ALICILARI (CRUD) =================
    function mailAliciDuzenleAc(code) {
        const m = code ? mailAliciCache.find(x => x.Code === code) : null;
        document.getElementById('maCode').value = m ? m.Code : '';
        document.getElementById('maOlay').value = m ? m.Olay : 'HATIRLATMA';
        document.getElementById('maEmail').value = m ? m.Email : '';
        document.getElementById('maAktif').checked = m ? (m.Aktif === 'Y') : true;
        new bootstrap.Modal(document.getElementById('mailAliciModal')).show();
    }

    async function mailAliciKaydetTiklandi() {
        const email = document.getElementById('maEmail').value.trim();
        if (!email || email.indexOf('@@') < 0) { alert('Geçerli bir e-posta girin.'); return; }
        const istek = { Code: document.getElementById('maCode').value, Olay: document.getElementById('maOlay').value, Email: email, Aktif: document.getElementById('maAktif').checked };
        const res = await fetch('/UrasUretimBakim/MailAliciKaydet', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(istek) }).then(r => r.json());
        if (!res.success) { alert('Kaydedilemedi: ' + res.message); return; }
        bootstrap.Modal.getInstance(document.getElementById('mailAliciModal')).hide();
        ayarlarYukle();
    }

    async function mailAliciSilTiklandi(code) {
        if (!confirm('Bu mail alıcısını silmek istediğinize emin misiniz?')) return;
        const fd = new FormData(); fd.append('code', code);
        const res = await fetch('/UrasUretimBakim/MailAliciSil', { method: 'POST', body: fd }).then(r => r.json());
        if (!res.success) { alert('Silinemedi: ' + res.message); return; }
        ayarlarYukle();
    }

    // ================= BELGE / DOSYA YÖNETİMİ =================
    function belgeSatirlariCiz(liste, konteynerId) {
        document.getElementById(konteynerId).innerHTML = liste.map(b => `<tr>
            <td>${b.DosyaAdi}</td><td>${b.BelgeTuru || '—'}</td><td class="text-muted small">${b.Yukleyen || ''} ${b.Zaman || ''}</td>
            <td class="text-end">
                <a class="btn btn-sm btn-link p-0 me-2" href="/UrasUretimBakim/BelgeIndir?code=${encodeURIComponent(b.Code)}" target="_blank" title="Görüntüle"><i class="fas fa-eye"></i></a>
                <a class="btn btn-sm btn-link p-0 me-2" href="/UrasUretimBakim/BelgeIndir?code=${encodeURIComponent(b.Code)}&indir=true" title="İndir"><i class="fas fa-download"></i></a>
                <button class="btn btn-sm btn-link p-0 text-danger" onclick='belgeSilTiklandi(${JSON.stringify(b.Code)})'><i class="fas fa-trash"></i></button>
            </td></tr>`).join('') || '<tr><td colspan="4" class="text-center text-muted py-2">Belge yok.</td></tr>';
    }

    async function belgeleriYukle(docEntry, makineKod, konteynerId) {
        const qs = new URLSearchParams({ docEntry: docEntry || 0, makineKod: makineKod || '' });
        const res = await fetch('/UrasUretimBakim/GetBelgeler?' + qs.toString()).then(r => r.json());
        if (res.success) belgeSatirlariCiz(res.data, konteynerId);
    }

    async function belgeYukleTiklandi(inputId, docEntry, makineKod, konteynerId) {
        const input = document.getElementById(inputId);
        if (!input.files || !input.files[0]) { alert('Dosya seçin.'); return; }
        const fd = new FormData();
        fd.append('dosya', input.files[0]);
        fd.append('docEntry', docEntry || 0);
        fd.append('makineKod', makineKod || '');
        const res = await fetch('/UrasUretimBakim/BelgeYukle', { method: 'POST', body: fd }).then(r => r.json());
        if (!res.success) { alert('Yüklenemedi: ' + res.message); return; }
        input.value = '';
        belgeleriYukle(docEntry, makineKod, konteynerId);
    }

    async function belgeSilTiklandi(code) {
        if (!confirm('Bu belgeyi silmek istediğinize emin misiniz?')) return;
        const fd = new FormData(); fd.append('code', code);
        const res = await fetch('/UrasUretimBakim/BelgeSil', { method: 'POST', body: fd }).then(r => r.json());
        if (!res.success) { alert('Silinemedi: ' + res.message); return; }
        if (window.__belgeYenile) window.__belgeYenile();
    }

    // ================= PDF / MAIL =================
    async function raporMailGonder(docEntry) {
        const alici = prompt('Rapor gönderilecek e-posta adresi:');
        if (!alici) return;
        const fd = new FormData(); fd.append('docEntry', docEntry); fd.append('alici', alici);
        const res = await fetch('/UrasUretimBakim/RaporMail', { method: 'POST', body: fd }).then(r => r.json());
        alert(res.message);
    }

    ozetYukle();
</script>
