@model List<WebApplication3.Models.Arac>

@{
    ViewData["Title"] = "Araç Envanteri Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-car me-2"></i> Araç Envanteri Yönetimi</h2>
        <a asp-action="AracEkle" asp-controller="Rapor54" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Yeni Araç Ekle
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-striped" id="araclarTable">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.First().Plaka)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Marka)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Model)</th>
                    <th>@Html.DisplayNameFor(model => model.First().ModelYili)</th>
                    <th>@Html.DisplayNameFor(model => model.First().AracTipi)</th>
                    <th>@Html.DisplayNameFor(model => model.First().AktifMi)</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Plaka)</td>
                        <td>@Html.DisplayFor(modelItem => item.Marka)</td>
                        <td>@Html.DisplayFor(modelItem => item.Model)</td>
                        <td>@Html.DisplayFor(modelItem => item.ModelYili)</td>
                        <td>@Html.DisplayFor(modelItem => item.AracTipi)</td>
                        <td>
                            @if (item.AktifMi)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Pasif</span>
                            }
                        </td>
                        <td style="width: 150px;">
                            <a asp-action="AracDuzenle" asp-controller="Rapor54" asp-route-id="@item.AracID" class="btn btn-sm btn-info text-white me-1">Düzenle</a>
                            <form asp-action="AracSil" asp-controller="Rapor54" asp-route-id="@item.AracID" method="post" style="display:inline;" onsubmit="return confirm('Bu aracı silmek/pasifleştirmek istediğinizden emin misiniz?');">
                                <button type="submit" class="btn btn-sm btn-danger">Sil/Pasifleştir</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#araclarTable').DataTable({
                "language": {   // dış dil dosyası yerine gömülü Türkçe (yükleme hatası uyarısı veriyordu)
                    "search": "Ara:", "lengthMenu": "_MENU_ kayıt göster", "info": "_TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor",
                    "infoEmpty": "Kayıt yok", "infoFiltered": "(_MAX_ kayıt içinden süzüldü)", "zeroRecords": "Eşleşen kayıt bulunamadı", "emptyTable": "Tabloda veri yok",
                    "paginate": { "first": "İlk", "last": "Son", "next": "Sonraki", "previous": "Önceki" }
                }
            });
        });
    </script>
}