@model WebApplication3.Models.AracAtama

@{
    ViewData["Title"] = "Atamayı Sonlandır";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-minus-circle me-2"></i> Atamayı Sonlandır</h2>
    <hr />
    <div class="alert alert-warning">
        **@Model.Arac.Plaka** plakalı aracın **@Model.Personel.AdSoyad** personeline olan aktif atamasını sonlandırıyorsunuz.
    </div>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="AtamaSonlandir" asp-controller="Rapor54" asp-route-atamaId="@Model.AtamaID" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="AtamaID" />

                <dl class="row mb-4 bg-light p-3 rounded">
                    <dt class="col-sm-4">Başlangıç Tarihi:</dt>
                    <dd class="col-sm-8">@Model.BaslangicTarihi.ToString("dd.MM.yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Başlangıç KM:</dt>
                    <dd class="col-sm-8">@Model.BaslangicKM.ToString("N0")</dd>
                </dl>

                <div class="mb-3">
                    <label asp-for="BitisKM" class="form-label"></label>
                    <input asp-for="BitisKM" class="form-control" type="number" />
                    <span asp-validation-for="BitisKM" class="text-danger"></span>
                    <small class="form-text text-muted">Araç iade edildiğindeki güncel kilometre bilgisini giriniz.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">Bitiş Tarihi:</label>
                    <input class="form-control" value="@DateTime.Now.ToString("dd.MM.yyyy HH:mm")" disabled />
                    <small class="form-text text-muted">Bitiş tarihi, kaydetme anındaki sistem saati olarak kaydedilecektir.</small>
                </div>

                <button type="submit" class="btn btn-danger">Atamayı Sonlandır ve Kaydet</button>
                <a asp-action="Index" asp-controller="Rapor54" class="btn btn-secondary">İptal</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}