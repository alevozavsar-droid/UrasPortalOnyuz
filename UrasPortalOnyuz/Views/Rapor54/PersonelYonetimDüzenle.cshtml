@model WebApplication3.Models.Personel

@{
    ViewData["Title"] = "Personel Düzenle: " + Model.AdSoyad;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-edit me-2"></i> Personel Düzenle: @Model.AdSoyad</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="PersonelDuzenle" asp-controller="Rapor54" asp-route-id="@Model.PersonelID" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="PersonelID" />

                <div class="mb-3">
                    <label asp-for="AdSoyad" class="form-label"></label>
                    <input asp-for="AdSoyad" class="form-control" />
                    <span asp-validation-for="AdSoyad" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SicilNo" class="form-label"></label>
                    <input asp-for="SicilNo" class="form-control" />
                    <span asp-validation-for="SicilNo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Departman" class="form-label"></label>
                    <input asp-for="Departman" class="form-control" />
                    <span asp-validation-for="Departman" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="AktifCalisanMi" class="form-check-input" />
                    <label asp-for="AktifCalisanMi" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-success">Kaydet</button>
                <a asp-action="PersonelIndex" asp-controller="Rapor54" class="btn btn-secondary">İptal</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}