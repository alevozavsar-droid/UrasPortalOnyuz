@model List<WebApplication3.Models.Personel>

@{
    ViewData["Title"] = "Personel Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-users me-2"></i> Personel Yönetimi</h2>
        <a asp-action="PersonelEkle" asp-controller="Rapor54" class="btn btn-primary">
            <i class="fas fa-user-plus me-1"></i> Yeni Personel Ekle
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-striped" id="personelTable">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.First().AdSoyad)</th>
                    <th>@Html.DisplayNameFor(model => model.First().SicilNo)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Departman)</th>
                    <th>@Html.DisplayNameFor(model => model.First().AktifCalisanMi)</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.AdSoyad)</td>
                        <td>@Html.DisplayFor(modelItem => item.SicilNo)</td>
                        <td>@Html.DisplayFor(modelItem => item.Departman)</td>
                        <td>
                            @if (item.AktifCalisanMi)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Pasif</span>
                            }
                        </td>
                        <td style="width: 150px;">
                            <a asp-action="PersonelDuzenle" asp-controller="Rapor54" asp-route-id="@item.PersonelID" class="btn btn-sm btn-info text-white me-1">Düzenle</a>
                            <form asp-action="PersonelPasiflestir" asp-controller="Rapor54" asp-route-id="@item.PersonelID" method="post" style="display:inline;" onsubmit="return confirm('Bu personeli pasifleştirmek istediğinizden emin misiniz?');">
                                <button type="submit" class="btn btn-sm btn-danger">Pasifleştir</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#personelTable').DataTable({
                "language": {   // dış dil dosyası yerine gömülü Türkçe (yükleme hatası uyarısı veriyordu)
                    "search": "Ara:", "lengthMenu": "_MENU_ kayıt göster", "info": "_TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor",
                    "infoEmpty": "Kayıt yok", "infoFiltered": "(_MAX_ kayıt içinden süzüldü)", "zeroRecords": "Eşleşen kayıt bulunamadı", "emptyTable": "Tabloda veri yok",
                    "paginate": { "first": "İlk", "last": "Son", "next": "Sonraki", "previous": "Önceki" }
                }
            });
        });
    </script>
}