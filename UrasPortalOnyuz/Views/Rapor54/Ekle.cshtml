@model WebApplication3.Models.Arac

@{
    ViewData["Title"] = "Yeni Araç Ekle";
}

<h3>Yeni Araç Kaydı</h3>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="AracEkle" asp-controller="Rapor54" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Plaka" class="form-label"></label>
                <input asp-for="Plaka" class="form-control" />
                <span asp-validation-for="Plaka" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Marka" class="form-label"></label>
                <input asp-for="Marka" class="form-control" />
                <span asp-validation-for="Marka" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="AktifMi" class="form-check-input" />
                <label asp-for="AktifMi" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="AraclarIndex" class="btn btn-secondary">Geri Dön</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}