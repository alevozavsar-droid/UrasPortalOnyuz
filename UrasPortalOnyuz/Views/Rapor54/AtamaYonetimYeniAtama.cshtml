@model WebApplication3.Models.YeniAtamaViewModel

@{
    ViewData["Title"] = "Yeni Araç Ataması Yap";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-exchange-alt me-2"></i> Yeni Araç Ataması</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="YeniAtama" asp-controller="Rapor54" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="SecilenAracID" class="form-label"></label>
                    <select asp-for="SecilenAracID" class="form-select" asp-items="Model.AracSecenekleri">
                        <option value="">-- Araç Seçiniz --</option>
                    </select>
                    <span asp-validation-for="SecilenAracID" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SecilenPersonelID" class="form-label"></label>
                    <select asp-for="SecilenPersonelID" class="form-select" asp-items="Model.PersonelSecenekleri">
                        <option value="">-- Personel Seçiniz --</option>
                    </select>
                    <span asp-validation-for="SecilenPersonelID" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BaslangicTarihi" class="form-label"></label>
                    <input asp-for="BaslangicTarihi" class="form-control" type="datetime-local" />
                    <span asp-validation-for="BaslangicTarihi" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BaslangicKM" class="form-label"></label>
                    <input asp-for="BaslangicKM" class="form-control" type="number" />
                    <span asp-validation-for="BaslangicKM" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Aciklama" class="form-label"></label>
                    <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Aciklama" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success">Atamayı Başlat</button>
                <a asp-action="Index" asp-controller="Rapor54" class="btn btn-secondary">İptal</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}