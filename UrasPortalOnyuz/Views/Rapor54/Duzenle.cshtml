@model WebApplication3.Models.Arac

@{
    ViewData["Title"] = "Araç Düzenle: " + Model.Plaka;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-edit me-2"></i> Araç Düzenle: @Model.Plaka</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="AracDuzenle" asp-controller="Rapor54" asp-route-id="@Model.AracID" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="AracID" />

                <div class="mb-3">
                    <label asp-for="Plaka" class="form-label"></label>
                    <input asp-for="Plaka" class="form-control" />
                    <span asp-validation-for="Plaka" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Marka" class="form-label"></label>
                    <input asp-for="Marka" class="form-control" />
                    <span asp-validation-for="Marka" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Model" class="form-label"></label>
                    <input asp-for="Model" class="form-control" />
                    <span asp-validation-for="Model" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ModelYili" class="form-label"></label>
                    <input asp-for="ModelYili" class="form-control" />
                    <span asp-validation-for="ModelYili" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SaseNo" class="form-label"></label>
                    <input asp-for="SaseNo" class="form-control" />
                    <span asp-validation-for="SaseNo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AracTipi" class="form-label"></label>
                    <input asp-for="AracTipi" class="form-control" />
                    <span asp-validation-for="AracTipi" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="AktifMi" class="form-check-input" />
                    <label asp-for="AktifMi" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-success">Kaydet</button>
                <a asp-action="AraclarIndex" asp-controller="Rapor54" class="btn btn-secondary">İptal</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}