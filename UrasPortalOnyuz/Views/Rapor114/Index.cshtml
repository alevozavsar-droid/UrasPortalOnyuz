        // ===================== BELGE ZİNCİRİ: BAZ BELGE / SONRAKİ BELGE =====================
        const EKRAN = { ctrl: 'Rapor114', objType: 18, ad: 'Satınalma Faturası' };
        // SAP'ye doğrudan ekleme izni (yalnızca IT02); sunucu da ayrıca denetler
        const SAP_EKLE_IZNI = @(sapEkleyebilir ? "true" : "false");
        const BAZ_TIPLERI = [{"type": 22, "name": "Satınalma Siparişi"}, {"type": 20, "name": "Satınalma Mal Girişi"}];
        const SONRAKI_BELGELER = [{"type": 19, "name": "Satınalma İade Faturası", "ctrl": "Rapor116"}];
        window.aktifBazBelge = null;

        function sonrakiBelgeLinkleri(docEntry, cls) {
            return SONRAKI_BELGELER.map(n => `<a class="${cls}" href="/${n.ctrl}?baseType=${EKRAN.objType}&baseEntry=${docEntry}"><i class="fas fa-arrow-right me-1"></i>${n.name} Oluştur</a>`).join('');
