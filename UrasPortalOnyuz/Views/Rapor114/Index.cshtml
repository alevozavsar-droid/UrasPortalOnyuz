            </div>
            <input type="hidden" class="input-qty" value="1" />
            <input type="hidden" class="input-sec-multiplier" value="0" />
        </td>
        <td>
            <select class="form-select form-select-sm table-input input-vat req-add">
                <option value="">İşlem Tipi Seç</option>
                @foreach(var vat in vatGroups)
                {
                    <option value="@vat.Code" data-rate="@vat.Rate">@vat.Code (@vat.Rate.ToString("0")%)</option>
                }
            </select>
        </td>
        <td class="align-middle text-center">
            <select class="form-select form-select-sm table-input input-wt" style="font-size:0.78rem; padding:2px 4px; min-height:26px;" title="Stopaj vergisine tabi mi?">
                <option value="N">Hayır</option>
                <option value="Y">Evet</option>
            </select>
        </td>
        <td class="align-middle"><div class="d-flex gap-1 align-items-center"><div style="flex:1; min-width:0;"><select class="form-select form-select-sm table-input input-gider" title="Gider / gelir kodu (U_BE1_GIDER): 6'lı-7'li hesaplara giden satırlarda zorunlu"><option value="">- kod seç -</option></select></div><button type="button" class="btn btn-sm btn-outline-primary btn-gg-sec" tabindex="-1" title="Listeden seç: ana grup › alt grup › kalem"><i class="fa-solid fa-list-ul"></i></button></div></td>
        <td class="text-end align-middle fw-bold text-secondary line-total-fc small">0,00</td>
        <td class="text-end align-middle fw-bold text-dark line-total-lc small">0,00</td>
        <td class="text-center align-middle del-cell">
            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-row p-1 border-0" title="Sil"><i class="fas fa-times fs-6"></i></button>
        </td>
    </tr>
</template>

<datalist id="giderListesi"></datalist>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/gg-kod-secici.js?v=1"></script>
    <script src="~/js/baz-belge-ek.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_GiderKodTalep")
    
    <script>
        toastr.options = { positionClass: "toast-bottom-right", timeOut: "3000" };

        let currentBpCurrency = 'TRY'; 
        window.exchangeRates = { 'TRY': 1.0 }; 
        window.bpAddresses = []; 
        
        let currentMode = 'ADD'; 
        let isBindingData = false; 
        let currentDocEntry = 0; 

        const allMuafCodes = @Html.Raw(Json.Serialize(ViewBag.MuafCodes ?? new List<WebApplication3.Controllers.Rapor114Controller.MuafCodeModel>()));
        const allStates = @Html.Raw(Json.Serialize(states));
        let allDrivers = @Html.Raw(Json.Serialize(drivers)); 

        const itemDict = {};
        @foreach(var item in items) {
            <text>itemDict['@item.ItemCode'] = '@item.ItemName.Replace("'", "\\'")';</text>
        }

        function formatNumber(num) {
            return num.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        $('#orderTabs a').on('click', function (e) {
            e.preventDefault();
            $(this).tab('show'); 
            if($(this).attr('id') === 'lines-tab' && currentMode === 'ADD') {
                $('#btnAddRowContainer').show();
            } else {
                $('#btnAddRowContainer').hide();
            }
        });

        $('#DriverListSelect').on('change', function() {
            if(isBindingData || currentMode !== 'ADD') return;
            const docEntry = $(this).val();
            if(docEntry) {
                const driver = allDrivers.find(d => d.docEntry === docEntry);
                if(driver) {
                    $('#U_BE1_SRCNAME').val(driver.name);
                    $('#U_BE1_SRCPLAKA').val(driver.plate);
                    $('#U_BE1_SRCTITLE').val(driver.title);
                    $('#U_BE1_SRCVKN').val(driver.vkn);
                    $('#U_BE1_SRCKVKK').val(driver.kvkk);
                    $('#U_BE1_FIRMANO').val(driver.firmaNo);
                    $('#U_BE1_SRCTEL').val(driver.tel);
                }
            } else {
                $('#U_BE1_SRCNAME, #U_BE1_SRCPLAKA, #U_BE1_SRCTITLE, #U_BE1_SRCVKN, #U_BE1_SRCKVKK, #U_BE1_FIRMANO, #U_BE1_SRCTEL').val('');
            }
        });

        $('#btnOpenNewDriverModal').click(function() {
            if(currentMode !== 'ADD') return;
            $('#frmNewDriver')[0].reset();
            $('#newDriverModal').modal('show');
        });

        $('#btnSaveNewDriver').click(function() {
            const name = $('#nd_Name').val();
            const plate = $('#nd_Plate').val();
            const vkn = $('#nd_VKN').val();
            
            if(!name || !plate || !vkn) {
                toastr.warning("Ad/Soyad, Plaka ve TC/VKN alanları zorunludur.");
                return;
            }

            const payload = {
                Name: name,
                Plate: plate,
                Title: $('#nd_Title').val(),
                VKN: vkn,
                KVKK: $('#nd_KVKK').is(':checked') ? 'E' : 'H',
                FirmaNo: $('#nd_FirmaNo').val(),
                Tel: $('#nd_Tel').val()
            };

            const btn = $(this);
            btn.prop('disabled', true).text('Kaydediliyor...');

            $.ajax({
                url: '/Rapor114/AddDriver',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    if(res.success) {
                        toastr.success("Şoför sisteme eklendi ve seçildi.");
                        allDrivers.unshift(res.data); 
                        
                        const newOption = new Option(`${res.data.name} (${res.data.plate})`, res.data.docEntry, true, true);
                        $('#DriverListSelect').append(newOption).trigger('change');
                        
                        $('#newDriverModal').modal('hide');
                    } else {
                        toastr.error(res.message);
                    }
                },
                error: function() {
                    toastr.error("Sunucu bağlantı hatası.");
                },
                complete: function() {
                    btn.prop('disabled', false).text('Kaydet & Seç');
                }
            });
        });

        function populateStates(countrySelectId, stateSelectId, selectedState = '') {
            const countryCode = $('#' + countrySelectId).val();
            const stateSelect = $('#' + stateSelectId);
            
            stateSelect.empty().append('<option value="">- Seçiniz -</option>');
            
            if(countryCode) {
                const filteredStates = allStates.filter(s => s.country === countryCode);
                filteredStates.forEach(s => {
                    stateSelect.append(`<option value="${s.code}">${s.name}</option>`);
                });
            }
            if(selectedState) {
                stateSelect.val(selectedState).trigger('change.select2');
            }
        }

        function fillAddressComponent(prefix, addr) {
            $(`#${prefix}Street`).val(addr ? addr.street : '');
            $(`#${prefix}StreetNo`).val(addr ? addr.streetNo : '');
            $(`#${prefix}Block`).val(addr ? addr.block : '');
            $(`#${prefix}ZipCode`).val(addr ? addr.zipCode : '');
            $(`#${prefix}County`).val(addr ? addr.county : '');
            $(`#${prefix}City`).val(addr ? addr.city : '');
            
            if(addr && addr.country) {
                $(`#${prefix}Country`).val(addr.country).trigger('change.select2');
                populateStates(`${prefix}Country`, `${prefix}State`, addr.state);
            } else {
                $(`#${prefix}Country`).val('').trigger('change.select2');
                $(`#${prefix}State`).empty().append('<option value="">- Seçiniz -</option>');
            }
        }

        $('#ShipToCountry').on('change', function() {
            if(!isBindingData) populateStates('ShipToCountry', 'ShipToState');
        });
        $('#PayToCountry').on('change', function() {
            if(!isBindingData) populateStates('PayToCountry', 'PayToState');
        });

        function setFormMode(mode) {
            currentMode = mode;
            $('#nextDocsGroup').hide(); $('#baseDocBadge').hide(); window.aktifBazBelge = null;
            
            if (mode === 'VIEW') {
                $('#mainContainer').removeClass('find-mode').addClass('view-mode');
                $('.searchable-field').prop('disabled', true);
                $('#Comments').prop('disabled', true);
                $('.req-add').prop('required', false);

                $('#DocNum').val(currentDocEntry).prop('disabled', true);

                $('#btnAddRowContainer, .del-cell, #colDelIcon').hide();
                $('#btnSave').hide();
                $('#btnTaslak').hide();
                $('#btnYevmiye').show().html('<i class="fas fa-book me-1"></i>Yevmiye Kaydı');
                $('#btnOpenNewDriverModal').hide();
                $('#btnCancel').text("Yeni Ekle").removeClass('btn-light').addClass('btn-primary text-white').prop('disabled', false);
                
                $('#divDocNumSearch').hide();
                $('#tabsCard, #footerSection').show();
            } 
            else if (mode === 'FIND') {
                $('#mainContainer').removeClass('view-mode').addClass('find-mode');
                
                $('.searchable-field').prop('disabled', false).val('');
                $('#CardCode').val('').trigger('change.select2');
                $('#SalesPersonCode').val('').trigger('change.select2');
                $('#OwnerCode').val('').trigger('change.select2');
                $('#U_BE1_SEND').val(''); 
                $('#U_BE1_MUAFCODE').empty().append('<option value="">- Muafiyet Kodu -</option>').prop('disabled', false); 
                $('#DriverListSelect').val('').trigger('change.select2');
                $('#U_BE1_SRCNAME, #U_BE1_SRCPLAKA, #U_BE1_SRCTITLE, #U_BE1_SRCVKN, #U_BE1_SRCKVKK, #U_BE1_FIRMANO, #U_BE1_SRCTEL').val('');

                $('#ShipToCode, #PayToCode').empty().append('<option value="">- Seçiniz -</option>');
                fillAddressComponent('ShipTo', null);
                fillAddressComponent('PayTo', null);

                $('#divDocNumSearch').show();
                $('#SearchDocNum').prop('disabled', false).val('').focus();
                $('#ExchangeRate').val('');
                $('#Comments').prop('disabled', true).val('');
                
                $('.req-add').prop('required', false);

                $('#btnAddRowContainer, .del-cell, #colDelIcon').hide();
                $('#tabsCard, #footerSection').hide(); 

                $('#btnTaslak').hide();
                $('#btnSave').prop('disabled', false).attr('title', '');   // Ara herkes için aktif
                $('#btnSave').show().text("Ara").removeClass('btn-warning').addClass('btn-info text-white').html('<i class="fas fa-search me-2"></i>Ara');
                $('#btnYevmiye').hide();
                $('#btnOpenNewDriverModal').hide(); 
                $('#btnCancel').text("İptal").removeClass('btn-primary text-white').addClass('btn-light').prop('disabled', false);
                $('#pageTitle').html('<i class="fas fa-search text-info me-2"></i>Kayıt Bul');
                
                $('#linesBody').empty(); 
                resetTotals();
            }
            else { 
                $('#mainContainer').removeClass('view-mode find-mode');
                
                $('.searchable-field').prop('disabled', false);
                $('#Comments').prop('disabled', false).val('');
                $('.req-add').prop('required', true);

                $('#DocNum').val('').prop('disabled', true);
                $('#ExchangeRate').prop('readonly', true); 

                if($('#lines-tab').hasClass('active')) $('#btnAddRowContainer').show();
                
                $('.del-cell, #colDelIcon').show();
                $('#tabsCard, #footerSection').show();
                $('#btnOpenNewDriverModal').show(); 
                
                $('#btnTaslak').show();
                $('#btnSave').show().removeClass('btn-info text-white').addClass('btn-success').html('SAP\'ye Ekle')
                    .prop('disabled', !SAP_EKLE_IZNI).attr('title', SAP_EKLE_IZNI ? '' : 'SAP\'ye doğrudan ekleme yalnızca IT02 kullanıcısına açıktır; Taslak Olarak Kaydet kullanın');
                $('#btnYevmiye').show().html('<i class="fas fa-book me-1"></i>Yevmiye Önizleme');
                $('#btnCancel').text("İptal").removeClass('btn-primary text-white').addClass('btn-light');
                $('#divDocNumSearch').hide();
                
                $('#pageTitle').html('<i class="fas fa-file-invoice-dollar text-success me-2"></i>Satınalma Faturası Oluştur');
                currentDocEntry = 0;
                
                isBindingData = true;
                $('#purchaseInvoiceForm')[0].reset();
                $('#CardCode').val('').trigger('change.select2');
                $('#SalesPersonCode').val('').trigger('change.select2');
                $('#OwnerCode').val('').trigger('change.select2');
                $('#DriverListSelect').val('').trigger('change.select2');
                $('#U_BE1_SRCNAME, #U_BE1_SRCPLAKA, #U_BE1_SRCTITLE, #U_BE1_SRCVKN, #U_BE1_SRCKVKK, #U_BE1_FIRMANO, #U_BE1_SRCTEL').val('');
                
                $('#U_BE1_SEND').val('1').trigger('change'); 

                $('#DocCurrency').val('');
                $('#U_BE1_AKTAR').val('');
                if (!$('#DocType').val()) $('#DocType').val('I');
                faturaTuruUygula($('#DocType').val(), true);

                $('#ShipToCode, #PayToCode').empty().append('<option value="">- Seçiniz -</option>');
                fillAddressComponent('ShipTo', null);
                fillAddressComponent('PayTo', null);
                window.bpAddresses = [];
                
                const today = new Date().toISOString().split('T')[0];
                $('#DocDate').val(today);
                $('#TaxDate').val(today);
                let nextWeek = new Date(); nextWeek.setDate(nextWeek.getDate() + 7);
                $('#DocDueDate').val(nextWeek.toISOString().split('T')[0]);
                
                addRow();
                calculateTotals();
                isBindingData = false;
            }
        }

        function loadPurchaseInvoiceDetailsFromId(docEntry) {
            $('#loadingOverlay').css('display', 'flex');
            $.get('/Rapor114/GetPurchaseInvoiceDetails', { docEntry: docEntry }, function(res) {
                if(res && res.success && res.data) {
                    bindPurchaseInvoiceToForm(res.data);
                } else {
                    toastr.error(res.message || "Satınalma Faturası detayları alınamadı.");
                }
            }).fail(function() {
                toastr.error("Kayıt çekilirken hata oluştu.");
            }).always(function() {
                $('#loadingOverlay').hide();
            });
        }

        // Belge durumu rozeti: acik / kapali / iptal (OINV/OPCH.DocStatus + CANCELED)
        function belgeDurumRozeti(res) {
            var c = (res.canceled || 'N'), st = (res.docStatus || 'O'), h;
            if (c === 'Y') h = '<span class="badge bg-danger ms-2 align-middle" title="Belge iptal edildi">\u0130ptal Edildi</span>';
            else if (c === 'C') h = '<span class="badge bg-secondary ms-2 align-middle" title="Bu belge bir iptal belgesidir">\u0130ptal Belgesi</span>';
            else if (st === 'C') h = '<span class="badge bg-dark ms-2 align-middle" title="Belge kapali">Kapal\u0131</span>';
            else h = '<span class="badge bg-success ms-2 align-middle" title="Belge acik">A\u00e7\u0131k</span>';
            $('#pageTitle').append(h);
        }
        function bindPurchaseInvoiceToForm(res) {
            isBindingData = true; 
            currentDocEntry = res.docEntry;
            
            $('#pageTitle').html(`<i class="fas fa-file-alt text-primary me-2"></i>Satınalma Faturası Görüntüle (No: ${res.docNum})`); belgeDurumRozeti(res);
            
            $('#CardCode').val(res.cardCode).trigger('change.select2');
            $('#SalesPersonCode').val(res.slpCode).trigger('change.select2');
            $('#OwnerCode').val(res.ownerCode > 0 ? res.ownerCode : '').trigger('change.select2');
            $('#DocDate').val(res.docDate);
            $('#NumAtCard').val(res.numAtCard || '');
            $('#DocDueDate').val(res.docDueDate);
            $('#TaxDate').val(res.taxDate);
            $('#U_BE1_AKTAR').val(res.u_BE1_AKTAR || res.U_BE1_AKTAR);
            
            let sendType = res.u_BE1_SEND || res.U_BE1_SEND;
            $('#U_BE1_SEND').val(sendType).trigger('change');
            
            let muaf = res.u_BE1_MUAFCODE || res.U_BE1_MUAFCODE;
            if(muaf) {
                $('#U_BE1_MUAFCODE').html(`<option value="${muaf}">${muaf}</option>`).val(muaf);
            }

            $('#ShipToCode').html(`<option value="${res.shipToCode}">${res.shipToCode}</option>`).val(res.shipToCode);
            $('#PayToCode').html(`<option value="${res.payToCode}">${res.payToCode}</option>`).val(res.payToCode);
            
            if(res.addressExtension) {
                fillAddressComponent('ShipTo', {
                    street: res.addressExtension.shipToStreet, streetNo: res.addressExtension.shipToStreetNo,
                    block: res.addressExtension.shipToBlock, zipCode: res.addressExtension.shipToZipCode,
                    city: res.addressExtension.shipToCity, county: res.addressExtension.shipToCounty,
                    state: res.addressExtension.shipToState, country: res.addressExtension.shipToCountry
                });
                fillAddressComponent('PayTo', {
                    street: res.addressExtension.billToStreet, streetNo: res.addressExtension.billToStreetNo,
                    block: res.addressExtension.billToBlock, zipCode: res.addressExtension.billToZipCode,
                    city: res.addressExtension.billToCity, county: res.addressExtension.billToCounty,
                    state: res.addressExtension.billToState, country: res.addressExtension.billToCountry
                });
            } else {
                fillAddressComponent('ShipTo', null);
                fillAddressComponent('PayTo', null);
            }

            $('#DriverListSelect').val('').trigger('change.select2');
            $('#U_BE1_SRCNAME, #U_BE1_SRCPLAKA, #U_BE1_SRCTITLE, #U_BE1_SRCVKN, #U_BE1_SRCKVKK, #U_BE1_FIRMANO, #U_BE1_SRCTEL').val('');

            $('#Comments').val(res.comments);
            $('#DocCurrency').val(res.docCurrency);
            $('#ExchangeRate').val(res.docRate.toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
            
            window.exchangeRates[res.docCurrency] = res.docRate;
            
            let rowsHtml = '';
            let netLC = 0, taxLC = 0;
            const hizmetGoruntule = (res.docType === 'S');
            $('#DocType').val(hizmetGoruntule ? 'S' : 'I');
            faturaTuruUygula(hizmetGoruntule ? 'S' : 'I', false);

            res.lines.forEach((line, index) => {
                let itemName = itemDict[line.itemCode] || '';
                let lineRate = window.exchangeRates[line.currency] || (line.currency === res.docCurrency ? res.docRate : 1.0);

                let secQty = line.quantity * line.secUnitMultiplier;
                let lineNetFC = line.quantity * line.unitPrice;
                let lineNetLC = lineNetFC * lineRate;
                if (hizmetGoruntule) {
                    // Hizmet satırı: tutar belge dövizinde; TL karşılığı belge kuruyla
                    lineNetFC = line.lineTotal || 0;
                    lineNetLC = lineNetFC * (res.docCurrency === 'TRY' ? 1 : (res.docRate || 1));
                }

                let vatObj = @Html.Raw(Json.Serialize(ViewBag.VatGroups));
                let foundVat = vatObj.find(v => v.code === line.vatGroup);
                let vRate = foundVat ? foundVat.rate : 0;
                let lineTaxLC = lineNetLC * (vRate / 100);

                netLC += lineNetLC;
                taxLC += lineTaxLC;

                if (hizmetGoruntule) {
                    rowsHtml += `
                <tr class="hizmet-satiri">
                    <td class="text-center align-middle text-muted small fw-bold">${index + 1}</td>
                    <td class="align-middle fw-medium"><span class="text-primary fw-bold">${line.accountCode || ''}</span> ${line.accountName || ''}</td>
                    <td class="align-middle">${line.description || ''}</td>
                    <td class="text-end align-middle">${formatNumber(lineNetFC)} ${res.docCurrency}</td>
                    <td class="align-middle">${line.vatGroup}</td>
                    <td class="align-middle text-center">${(line.wtLiable === true || line.wtLiable === 'Y') ? '<span class="badge bg-warning text-dark">Evet</span>' : '<span class="text-muted small">Hayır</span>'}</td>
                    <td class="align-middle small">${ggAd(line.gider)}</td>
                    <td class="text-end align-middle fw-bold text-secondary small">${formatNumber(lineNetFC)} ${res.docCurrency}</td>
                    <td class="text-end align-middle fw-bold text-dark small">${formatNumber(lineNetLC)} TRY</td>
                </tr>`;
                    return;
                }

                rowsHtml += `
                <tr>
                    <td class="text-center align-middle text-muted small fw-bold">${index + 1}</td>
                    <td class="align-middle fw-medium">${line.itemCode} - ${itemName}</td>
                    <td class="align-middle">
                        <select class="form-select form-select-sm table-input input-whs" disabled style="font-size: 0.8rem; padding: 2px 4px; min-height:26px;">
                            <option value="${line.warehouseCode}">${line.warehouseCode}</option>
                        </select>
                        <div class="small text-muted mt-1" style="font-size:0.75rem;">Stok: -</div>
                    </td>
                    <td class="align-middle text-end">
                        <input type="text" class="table-input text-end fw-medium" value="${line.quantity}" readonly />
                        <div class="small text-muted mt-1" style="font-size:0.75rem;">
                            <span class="fw-bold text-dark">${formatNumber(secQty)}</span> ${line.secUnitName || ''}
                        </div>
                    </td>
                    <td class="text-end align-middle">${formatNumber(line.unitPrice)} ${line.currency}</td>
                    <td class="align-middle">${line.vatGroup}</td>
                    <td class="align-middle text-center">${(line.wtLiable === true || line.wtLiable === 'Y') ? '<span class="badge bg-warning text-dark">Evet</span>' : '<span class="text-muted small">Hayır</span>'}</td>
                    <td class="align-middle small"><span class="text-primary fw-bold">${line.accountCode || ''}</span> ${line.accountName || ''}</td>
                    <td class="align-middle small">${ggAd(line.gider)}</td>
                    <td class="text-end align-middle fw-bold text-secondary small">${formatNumber(lineNetFC)} ${line.currency}</td>
                    <td class="text-end align-middle fw-bold text-dark small">${formatNumber(lineNetLC)} TRY</td>
                </tr>`;
            });
            
            $('#linesBody').html(rowsHtml);

            const wtSumLC = res.wtSum || 0;   // kayıtlı belgede SAP'nin hesapladığı stopaj
            let grandLC = netLC + taxLC - wtSumLC;
            let docGrandFC = (res.docCurrency === 'TRY') ? grandLC : (grandLC / res.docRate);

            $('#lblNetTotalLC').text(formatNumber(netLC) + ' TRY');
            $('#lblTaxTotalLC').text(formatNumber(taxLC) + ' TRY');
            $('#lblStopajTotalLC').text((wtSumLC > 0 ? '-' : '') + formatNumber(wtSumLC) + ' TRY');
            $('#rowStopajTotal').toggleClass('fw-bold', wtSumLC > 0);
            $('#lblGrandTotalLC').text(formatNumber(grandLC) + ' TRY');
            $('#lblGrandTotalFC').text(formatNumber(docGrandFC) + ' ' + res.docCurrency);
            
            setFormMode('VIEW');
            nextDocsGoster(res.docEntry);
            isBindingData = false;
        }

        function populateSearchResults(list) {
            let html = '';
            list.forEach(row => {
                html += `
                <tr onclick="loadPurchaseInvoiceAndCloseModal(${row.docEntry})">
                    <td class="fw-bold">${row.docNum}</td>
                    <td>${row.cardCode}</td>
                    <td class="text-truncate" style="max-width: 200px;">${row.cardName || ''}</td>
                    <td>${row.docDate}</td>
                    <td><span class="badge bg-secondary">${row.docCurrency}</span></td>
                </tr>`;
            });
            $('#searchResultsBody').html(html);
            $('#searchResultsModal').modal('show');
        }

        window.loadPurchaseInvoiceAndCloseModal = function(docEntry) {
            $('#searchResultsModal').modal('hide');
            loadPurchaseInvoiceDetailsFromId(docEntry);
        }

        $('.nav-btn').click(function() {
            if (isBindingData) return;
            const dir = $(this).data('dir');
            
            $('#loadingOverlay').css('display', 'flex');
            
            $.get('/Rapor114/GetPurchaseInvoiceNavigation', { currentDocEntry: currentDocEntry, direction: dir }, function(res) {
                if(res && res.success && res.data) {
                    bindPurchaseInvoiceToForm(res.data);
                } else {
                    toastr.info("Bu yönde başka kayıt bulunmuyor.");
                }
            }).fail(function() {
                toastr.error("Kayıt çekilirken hata oluştu.");
            }).always(function() {
                $('#loadingOverlay').hide();
            });
        });

        $('#btnNewDoc').click(function() {
            setFormMode('ADD');
            fetchAllExchangeRates();
        });

        // ---- BELGEYİ ÇOĞALT ----------------------------------------------------
        // Görüntülenen belgenin birebir kopyasını YENİ KAYIT olarak forma getirir; SAP'ye hiçbir şey gönderilmez.
        // Baz belge kopyalama altyapısı (bindBaseDocToForm) yeniden kullanılır; baz bağları (BaseType/Entry/Line)
        // temizlenir, tarihler bugüne çekilir, referans no boşaltılır. Kullanıcı kontrol edip "SAP'ye Ekle" ile kaydeder.
        $('#btnCogalt').click(function () {
            if (currentMode !== 'VIEW' || !currentDocEntry) { toastr.warning('Önce çoğaltılacak belgeyi açın (Kayıt Bul veya gezinme okları).'); return; }
            const kaynakEntry = currentDocEntry;
            $('#loadingOverlay').css('display', 'flex');
            $.get('/Rapor114/GetPurchaseInvoiceDetails', { docEntry: kaynakEntry }, function (res) {
                if (!res || !res.success || !res.data) { toastr.error((res && res.message) || 'Belge detayları alınamadı.'); return; }
                const veri = res.data, kaynakNo = veri.docNum;
                (veri.lines || []).forEach(function (l) { l.baseType = null; l.baseEntry = null; l.baseLine = null; });
                $('#nextDocsGroup').hide();
                bindBaseDocToForm(veri, null, null, '');
                toastr.clear();
                window.aktifBazBelge = null;
                $('#baseDocBadge').hide();
                $('#CardCode').prop('disabled', false);
                $('#linesBody tr').removeAttr('data-btype data-bentry data-bline title').removeClass('table-warning');
                // Birebir kopya: tarihler, fatura no, kur, sahip, fatura tipi / muafiyet, sofor, stopaj kodu ve satir stopaj isaretleri kaynak belgeden;
                // formda olmayan kullanici tanimli alanlar kayit sirasinda sunucuda ayni kaynaktan kopyalanir (wwwroot/js/baz-belge-ek.js).
                $.get('/Rapor114/KopyaEk', { docEntry: kaynakEntry }).done(function (r2) { if (r2 && r2.ek) { bazEkKopya(r2.ek, '/Rapor114', kaynakEntry); calculateTotals(); } });
                $('#pageTitle').html('<i class="fas fa-copy text-warning me-2"></i>Satınalma Faturası Oluştur <span class="badge bg-warning text-dark align-middle">' + kaynakNo + ' kopyası</span>');
                calculateTotals();
                toastr.success(kaynakNo + " numaralı belge çoğaltıldı. Kontrol edip <b>SAP'ye Ekle</b> düğmesiyle kaydedin.", '', { timeOut: 9000, enableHtml: true });
            }).fail(function () { toastr.error('Kayıt çekilirken hata oluştu.'); })
              .always(function () { $('#loadingOverlay').hide(); });
        });
        $('#btnFindMode').click(function() {
            setFormMode('FIND');
        });

        function fetchAllExchangeRates() {
            if(currentMode !== 'ADD') return;
            const date = $('#DocDate').val();
            $.get('/Rapor114/GetAllExchangeRates', { date: date }, function(res) {
                window.exchangeRates = res;
                const docCur = $('#DocCurrency').val() || 'TRY';
                const docRate = window.exchangeRates[docCur] || 1.0;
                $('#ExchangeRate').val(docRate.toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
                calculateTotals();
            });
        }

        function triggerItemPriceUpdate() {
            if(currentMode !== 'ADD') return;
            $('#linesBody tr').each(function() {
                const itemSelect = $(this).find('.item-select');
                if(itemSelect.val()) itemSelect.trigger('change'); 
            });
        }

        $(document).ready(function () {
            $('.select2-init').select2({ theme: 'bootstrap-5', width: '100%' });
            
            setFormMode('ADD');
            fetchAllExchangeRates();
            bazBelgeBaslat();

            $('#U_BE1_SEND').on('change', function() {
                if(isBindingData) return; 

                const sendType = $(this).find("option:selected").text(); 
                const muafSelect = $('#U_BE1_MUAFCODE');
                
                muafSelect.empty();
                muafSelect.append('<option value="">- Muafiyet Kodu -</option>');

                if(currentMode === 'ADD' && (sendType.includes("SATIS") || sendType.includes("IADE") || sendType === "")) {
                    muafSelect.prop('disabled', true).prop('required', false);
                    return;
                }
                
                if (currentMode === 'ADD') {
                    muafSelect.prop('disabled', false).prop('required', true);
                }

                let targetType = "";
                if(sendType.includes("ISTISNA")) targetType = "ISTISNA";
                else if(sendType.includes("OZELMATRAH")) targetType = "OZELMATRAH";
                else if(sendType.includes("TEVKIFAT")) targetType = "TEVKIFAT";
                else if(sendType.includes("IHRACKAYITLI")) targetType = "IHRACKAYITLI";

                if(targetType !== "") {
                    const filteredCodes = allMuafCodes.filter(c => c.type === targetType);
                    filteredCodes.forEach(c => {
                        muafSelect.append(`<option value="${c.code}">${c.code} - ${c.name}</option>`);
                    });
                }
            });

            $('#CardCode').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const cardCode = $(this).val();
                if(!cardCode) return;

                $.get('/Rapor114/GetCustomerInfo', { cardCode: cardCode }, function(res) {
                    currentBpCurrency = res.currency;
                    // Vade: carinin ödeme koşulu (OCTG) → belge tarihi + ay + gün (ay sonu koşulunda ay sonuna)
                    window.cariVade = { gun: res.vadeGun || 0, ay: res.vadeAy || 0, aySonu: !!res.vadeAySonu, ad: res.vadeAd || '' };
                    vadeHesapla();
                    $('#CurrencyType').val('BP');
                    $('#DocCurrency').val(currentBpCurrency);

                    const docRate = window.exchangeRates[currentBpCurrency] || 1.0;
                    $('#ExchangeRate').val(docRate.toLocaleString('tr-TR', { minimumFractionDigits: 4 }));

                    // Stopaj: carinin WTLiable durumuna göre satır varsayılanı (kullanıcı satır bazında değiştirebilir)
                    window.cariWTLiable = (res.wtLiable === 'Y');
                    $('#linesBody tr .input-wt').val(window.cariWTLiable ? 'Y' : 'N');

                    // Stopaj kodu listesi: yalnızca bu muhatabın kartında tanımlı kodlar (CRD4)
                    var kodlar = res.wtCodes || [];
                    var opts = '<option value="">- Seçiniz -</option>';
                    kodlar.forEach(function(k){ opts += `<option value="${k.code}">${k.code} - ${k.name}</option>`; });
                    $('#StopajKodu').html(opts);
                    // Varsayılan: muhatabın varsayılan kodu, yoksa tek kod varsa o
                    var sec = '';
                    if (res.defWtCode && kodlar.some(k => k.code === res.defWtCode)) sec = res.defWtCode;
                    else if (kodlar.length === 1) sec = kodlar[0].code;
                    $('#StopajKodu').val(sec);

                    stopajDurumGuncelle();

                    triggerItemPriceUpdate();
                });

                $.get('/Rapor114/GetCustomerAddresses', { cardCode: cardCode }, function(res) {
                    let shipHtml = '<option value="">- Seçiniz -</option>';
                    let payHtml = '<option value="">- Seçiniz -</option>';
                    window.bpAddresses = res; 

                    res.forEach(addr => {
                        if(addr.addressType === 'S') shipHtml += `<option value="${addr.addressName}">${addr.addressName}</option>`;
                        if(addr.addressType === 'B') payHtml += `<option value="${addr.addressName}">${addr.addressName}</option>`;
                    });

                    $('#ShipToCode').html(shipHtml);
                    $('#PayToCode').html(payHtml);
                    
                    if(res.find(a => a.addressType === 'S')) $('#ShipToCode').val(res.find(a => a.addressType === 'S').addressName).trigger('change');
                    if(res.find(a => a.addressType === 'B')) $('#PayToCode').val(res.find(a => a.addressType === 'B').addressName).trigger('change');
                });
            });

            $('#ShipToCode').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const val = $(this).val();
                const addr = window.bpAddresses?.find(a => a.addressName === val && a.addressType === 'S');
                fillAddressComponent('ShipTo', addr);
            });

            $('#PayToCode').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const val = $(this).val();
                const addr = window.bpAddresses?.find(a => a.addressName === val && a.addressType === 'B');
                fillAddressComponent('PayTo', addr);
            });

            $('#CurrencyType').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const type = $(this).val();
                if(type === 'BP') {
                    $('#DocCurrency').val(currentBpCurrency).prop('disabled', false);
                } else if(type === 'LC') {
                    $('#DocCurrency').val('TRY').prop('disabled', true);
                } else if(type === 'SC') {
                    $('#DocCurrency').val('TRY').prop('disabled', false); 
                }
                
                const docCur = $('#DocCurrency').val();
                const docRate = window.exchangeRates[docCur] || 1.0;
                $('#ExchangeRate').val(docRate.toLocaleString('tr-TR', { minimumFractionDigits: 4 }));

                calculateTotals();
            });

            $('#DocCurrency').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const docCur = $(this).val() || 'TRY';
                const docRate = window.exchangeRates[docCur] || 1.0;
                $('#ExchangeRate').val(docRate.toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
                calculateTotals();
            });

            function vadeHesapla() {
                if (!window.cariVade || currentMode !== 'ADD') return;
                const bas = $('#DocDate').val(); if (!bas) return;
                const d = new Date(bas + 'T00:00:00');
                if (window.cariVade.ay) d.setMonth(d.getMonth() + window.cariVade.ay);
                if (window.cariVade.aySonu) { d.setMonth(d.getMonth() + 1); d.setDate(0); }
                if (window.cariVade.gun) d.setDate(d.getDate() + window.cariVade.gun);
                const yyyy = d.getFullYear(), mm = String(d.getMonth() + 1).padStart(2, '0'), dd = String(d.getDate()).padStart(2, '0');
                $('#DocDueDate').val(`${yyyy}-${mm}-${dd}`);
            }
            $('#DocDate').on('change', function() { vadeHesapla(); });
            $('#DocDate').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                fetchAllExchangeRates(); 
            });

            $('#btnAddRow').click(function () { 
                if(currentMode !== 'ADD') return;
                addRow(); 
            });

            // Fatura türü değişince satırlar o türe göre yeniden kurulur
            $('#DocType').on('change', function () {
                if (isBindingData || currentMode !== 'ADD') return;
                faturaTuruUygula($(this).val(), true);
                addRow();
                calculateTotals();
            });

            $(document).on('click', '.btn-remove-row', function () {
                if(currentMode !== 'ADD') return;
                $(this).closest('tr').find('.item-select, .acct-select, .input-acct-item, .input-gider').select2('destroy');
                $(this).closest('tr').remove();
                updateRowIndexes();
                calculateTotals();
            });

            $(document).on('input', '.input-qty, .input-price', function () { if(currentMode === 'ADD') calculateTotals(); });
            $(document).on('change', '.input-vat, .input-currency', function () { if(currentMode === 'ADD') calculateTotals(); });

            $(document).on('change', '.item-select', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                
                const row = $(this).closest('tr');
                const itemCode = $(this).val();
                const cardCode = $('#CardCode').val();
                
                const priceInput = row.find('.input-price');
                const curInput = row.find('.input-currency');
                const whsInput = row.find('.input-whs');
                const stockInput = row.find('.input-stock');
                const secNameInput = row.find('.input-sec-name');
                const multiplierInput = row.find('.input-sec-multiplier');

                if(cardCode && itemCode) {
                    $.get('/Rapor114/GetItemPrice', { cardCode: cardCode, itemCode: itemCode }, function(res) {
                        if(res) {
                            priceInput.val(res.price > 0 ? res.price : 0);
                            curInput.val(res.currency || 'TRY'); 
                            secNameInput.text(res.secUnitName || '');
                            multiplierInput.val(res.secUnitMultiplier || 0);
                            
                            if(res.dfltWH) {
                                whsInput.val(res.dfltWH).trigger('change');
                            } else {
                                whsInput.val('01').trigger('change');
                            }
                        } else {
                            priceInput.val(0);
                            curInput.val('TRY');
                            stockInput.text('0');
                            multiplierInput.val(0);
                            whsInput.val('01').trigger('change');
                        }
                        calculateTotals();
                    });
                }
            });

            $(document).on('change', '.input-whs', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                
                const row = $(this).closest('tr');
                const itemCode = row.find('.item-select').val();
                const whsCode = $(this).val();
                const stockInput = row.find('.input-stock');
                
                if (itemCode && whsCode) {
                    $.get('/Rapor114/GetItemStock', { itemCode: itemCode, whsCode: whsCode }, function(res) {
                        stockInput.text(formatNumber(res.onHand || 0));
                    });
                } else {
                    stockInput.text('0');
                }
            });

            $('#purchaseInvoiceForm').submit(function (e) {
                e.preventDefault();
                
                if(currentMode === 'FIND') {
                    const searchPayload = {
                        DocNum: $('#SearchDocNum').val() ? parseInt($('#SearchDocNum').val()) : null,
                        CardCode: $('#CardCode').val(),
                        SlpCode: $('#SalesPersonCode').val() ? parseInt($('#SalesPersonCode').val()) : null,
                        DocDate: $('#DocDate').val() || null, 
                        DocDueDate: $('#DocDueDate').val() || null,
                        TaxDate: $('#TaxDate').val() || null,
                        U_BE1_AKTAR: $('#U_BE1_AKTAR').val(),
                        U_BE1_SEND: $('#U_BE1_SEND').val(),
                        U_BE1_MUAFCODE: $('#U_BE1_MUAFCODE').val(),
                        NumAtCard: ($('#NumAtCard').val() || '').trim() || null,
                        DocType: $('#DocType').val() || null,
                        DocCurrency: $('#DocCurrency').val()
                    };
                    
                    $('#loadingOverlay').css('display', 'flex');
                    
                    $.ajax({
                        url: '/Rapor114/FindPurchaseInvoice',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(searchPayload),
                        success: function (res) {
                            if (res.success && res.data && res.data.length > 0) {
                                if (res.data.length === 1) {
                                    loadPurchaseInvoiceDetailsFromId(res.data[0].docEntry);
                                } else {
                                    populateSearchResults(res.data);
                                }
                            } else {
                                toastr.warning(res.message || "Kayıt bulunamadı.");
                            }
                        },
                        error: function () { toastr.error("Arama sırasında hata oluştu."); },
                        complete: function () { $('#loadingOverlay').hide(); window.taslakKaydet = false; }
                    });
                    
                    return;
                }
                
                if(currentMode === 'VIEW') return;

                // Stopaja tabi satır varsa ÖNCE carinin kartındaki stopaj kodları sorulur; seçim yapılınca gönderim devam eder
                if (stopajTabiSatirVar() && !window.stopajOnaylandi) {
                    stopajKoduSor(function () { window.stopajOnaylandi = true; $('#purchaseInvoiceForm').trigger('submit'); });
                    return;
                }
                window.stopajOnaylandi = false;

                // SAP'ye doğrudan ekleme yalnızca IT02; diğerleri taslak kaydeder
                if (window.taslakKaydet !== true && !SAP_EKLE_IZNI) {
                    toastr.warning("SAP'ye doğrudan ekleme yalnızca IT02 kullanıcısına açıktır. Lütfen \"Taslak Olarak Kaydet\" kullanın.", '', { timeOut: 7000 });
                    return;
                }

                // Zorunlu başlık alanları: cari, satınalma çalışanı, sahip, işlem tipi, tarihler
                const cardCode = $('#CardCode').val();
                if (($('#NumAtCard').val() || '').trim().length > 16) { toastr.warning('Fatura No en fazla 16 karakter olabilir (ör. ABC2026000000123).'); $('#NumAtCard').focus(); return; }
                if (!cardCode) { toastr.warning("Lütfen tedarikçi / müşteri seçiniz."); return; }
                if (!$('#OwnerCode').val()) { toastr.warning("Lütfen belge sahibini (çalışan) seçiniz."); return; }
                if (!$('#U_BE1_AKTAR').val()) { toastr.warning("Lütfen işlem tipini seçiniz."); $('#U_BE1_AKTAR').focus(); return; }
                if (!$('#DocDate').val() || !$('#DocDueDate').val() || !$('#TaxDate').val()) { toastr.warning("Lütfen kayıt, vade ve belge tarihlerini eksiksiz giriniz."); return; }

                // Nakliye (şoför/plaka) ve lojistik (adres) bilgileri zorunlu değil; boşsa SAP carinin varsayılan adreslerini kullanır
                const hizmetFaturasi = faturaTuru() === 'S';

                const documentLines = [];
                let hasError = false;

                $('#linesBody tr').each(function (index) {
                    const itemCode = $(this).find('.item-select').val();
                    const qty = parseFloat($(this).find('.input-qty').val()) || 0;
                    const price = parseFloat($(this).find('.input-price').val()) || 0;
                    const lineCur = $(this).find('.input-currency').val();
                    const vatGroup = $(this).find('.input-vat').val();
                    const whsCode = $(this).find('.input-whs').val();

                    if (hizmetFaturasi) {
                        // Hizmet satırı: hesap + açıklama + tutar (belge dövizinde)
                        const acct = $(this).find('.acct-select').val();
                        if (!acct) { hasError = true; toastr.error(`${index + 1}. satırda hesap seçiniz.`); return false; }
                        if (price <= 0) { hasError = true; toastr.error(`${index + 1}. satır için tutar 0'dan büyük olmalıdır.`); return false; }
                        if (!vatGroup) { hasError = true; toastr.error(`${index + 1}. satır için işlem tipi (KDV) seçiniz.`); return false; }
                        documentLines.push({
                            AccountCode: acct,
                            Description: ($(this).find('.input-desc').val() || '').trim(),
                            LineTotal: price,
                            Currency: lineCur,
                            VatGroup: vatGroup,
                        Gider: ($(this).find('.input-gider').val() || '').trim(),
                            WTLiable: ($(this).find('.input-wt').val() === 'Y'),
                            BaseType: $(this).attr('data-btype') ? parseInt($(this).attr('data-btype')) : null,
                            BaseEntry: $(this).attr('data-bentry') ? parseInt($(this).attr('data-bentry')) : null,
                            BaseLine: $(this).attr('data-bline') !== undefined ? parseInt($(this).attr('data-bline')) : null,
                            KopyaSatir: $(this).attr('data-kline') !== undefined ? parseInt($(this).attr('data-kline')) : null
                        });
                        return;
                    }

                    if (!itemCode) { hasError = true; toastr.error(`${index + 1}. satırda kalem seçiniz.`); return false; }
                    if (!whsCode) { hasError = true; toastr.error(`${index + 1}. satır için depo seçiniz.`); return false; }
                    if (qty <= 0) { hasError = true; toastr.error(`${index + 1}. satır için miktar 0'dan büyük olmalıdır.`); return false; }
                    if (price <= 0) { hasError = true; toastr.error(`${index + 1}. satır için geçerli bir fiyat giriniz.`); return false; }
                    if (!vatGroup) { hasError = true; toastr.error(`${index + 1}. satır için işlem tipi (KDV) seçiniz.`); return false; }

                    documentLines.push({
                        ItemCode: itemCode,
                        Quantity: qty,
                        UnitPrice: price,
                        Currency: lineCur,
                        VatGroup: vatGroup,
                        Gider: ($(this).find('.input-gider').val() || '').trim(),
                        WarehouseCode: whsCode,
                        AccountCode: ($(this).find('.input-acct-item').val() || '').trim(),
                        WTLiable: ($(this).find('.input-wt').val() === 'Y'),
                        BaseType: $(this).attr('data-btype') ? parseInt($(this).attr('data-btype')) : null,
                        BaseEntry: $(this).attr('data-bentry') ? parseInt($(this).attr('data-bentry')) : null,
                        BaseLine: $(this).attr('data-bline') !== undefined ? parseInt($(this).attr('data-bline')) : null,
                            KopyaSatir: $(this).attr('data-kline') !== undefined ? parseInt($(this).attr('data-kline')) : null
                    });
                });

                if (hasError) {
                    $('#lines-tab').tab('show');
                    return;
                }

                if (documentLines.length === 0) {
                    toastr.warning("Satınalma Faturasına en az bir kalem ekleyiniz.");
                    $('#lines-tab').tab('show');
                    return;
                }

                // Stopaj: tabi satır varsa belge stopaj kodu zorunlu
                const stopajTabiVar = documentLines.some(l => l.WTLiable);
                const stopajKodu = $('#StopajKodu').val();
                if (stopajTabiVar && !stopajKodu) {
                    toastr.error("En az bir satır stopaja tabi. Lütfen belge için 'Stopaj Kodu' seçiniz.");
                    $('#lines-tab').tab('show');
                    $('#StopajKodu').focus();
                    return;
                }

                const docCur = $('#DocCurrency').val() || 'TRY';
                let docRateStr = $('#ExchangeRate').val().replace(/\./g, '').replace(',', '.');
                let docRate = parseFloat(docRateStr) || 1.0;

                const payload = {
                    DocType: faturaTuru(),
                    CardCode: cardCode,
                    DocDate: $('#DocDate').val(),
                    DocDueDate: $('#DocDueDate').val(),
                    TaxDate: $('#TaxDate').val(), 
                    SalesPersonCode: parseInt($('#SalesPersonCode').val()) || 0,   // boşsa NaN -> null olup model bağlamayı bozuyordu
                    OwnerCode: $('#OwnerCode').val() ? parseInt($('#OwnerCode').val()) : null,
                    Taslak: window.taslakKaydet === true,
                    KopyaKaynak: window.kopyaKaynak || null,
                    Comments: $('#Comments').val(),
                    NumAtCard: ($('#NumAtCard').val() || '').trim() || null,
                    DocCurrency: docCur,
                    DocRate: docRate,
                    U_BE1_AKTAR: $('#U_BE1_AKTAR').val(), 
                    U_BE1_SEND: $('#U_BE1_SEND').val(),
                    U_BE1_MUAFCODE: $('#U_BE1_MUAFCODE').val(),
                    
                    U_BE1_SOFORSECIMI: $('#DriverListSelect').val(),
                    U_BE1_SOFORADSOYAD: $('#U_BE1_SRCNAME').val(),
                    U_BE1_ARACPLAKASI: $('#U_BE1_SRCPLAKA').val(),
                    U_BE1_SOFORUNVANI: $('#U_BE1_SRCTITLE').val(),
                    U_BE1_SOFORKIMLIK: $('#U_BE1_SRCVKN').val(),
                    U_BE1_SOFORTEL: $('#U_BE1_SRCTEL').val(),
                    U_BE1_FRMNO: $('#U_BE1_FIRMANO').val(),
                    
                    PayToCode: $('#PayToCode').val(),
                    ShipToCode: $('#ShipToCode').val(),
                    WTCode: stopajKodu,
                    AddressExtension: {
                        ShipToStreet: $('#ShipToStreet').val(),
                        ShipToStreetNo: $('#ShipToStreetNo').val(),
                        ShipToBlock: $('#ShipToBlock').val(),
                        ShipToZipCode: $('#ShipToZipCode').val(),
                        ShipToCity: $('#ShipToCity').val(),
                        ShipToCounty: $('#ShipToCounty').val(),
                        ShipToState: $('#ShipToState').val(),
                        ShipToCountry: $('#ShipToCountry').val(),
                        
                        BillToStreet: $('#PayToStreet').val(),
                        BillToStreetNo: $('#PayToStreetNo').val(),
                        BillToBlock: $('#PayToBlock').val(),
                        BillToZipCode: $('#PayToZipCode').val(),
                        BillToCity: $('#PayToCity').val(),
                        BillToCounty: $('#PayToCounty').val(),
                        BillToState: $('#PayToState').val(),
                        BillToCountry: $('#PayToCountry').val()
                    },
                    DocumentLines: documentLines
                };

                $('#loadingOverlay').css('display', 'flex');

                $.ajax({
                    url: '/Rapor114/CreatePurchaseInvoice',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            kayitSonrasi(res); 
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function (xhr) {
                        const errMsg = xhr.responseJSON ? xhr.responseJSON.message : "Bağlantı hatası.";
                        toastr.error(errMsg);
                    },
                    complete: function () { $('#loadingOverlay').hide(); window.taslakKaydet = false; }
                });
            });
            
            $('#btnCancel').click(function() {
                if(currentMode === 'VIEW' || currentMode === 'FIND') {
                    setFormMode('ADD');
                    fetchAllExchangeRates();
                } else {
                    window.history.back();
                }
            });
