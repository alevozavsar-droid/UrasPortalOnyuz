        function loadBaseDocument(baseEntry, baseType) {
            $('#loadingOverlay').css('display', 'flex');
            $.get('/Rapor114/GetBaseDocument', { baseEntry: baseEntry, baseType: baseType }, function (res) {
                if (res && res.success && res.data) { bindBaseDocToForm(res.data, res.baseType, res.baseEntry, res.baseTypeName); bazEkSatir(res.ek, res.baseEntry); bazEkBaslik(res.ek, '/Rapor114'); calculateTotals(); }
                else toastr.error(res.message || 'Baz belge alınamadı.', '', { timeOut: 8000 });
            }).fail(() => toastr.error('Baz belge çekilirken hata oluştu.')).always(() => $('#loadingOverlay').hide());
        }
        function bindBaseDocToForm(d, baseType, baseEntry, baseTypeName) {
            if (currentMode !== 'ADD') setFormMode('ADD');
            isBindingData = true;
            window.aktifBazBelge = { type: baseType, entry: baseEntry, docNum: d.docNum, name: baseTypeName };

            $('#CardCode').val(d.cardCode).trigger('change.select2');
            $('#SalesPersonCode').val(d.slpCode > 0 ? d.slpCode : '').trigger('change.select2');
            const today = new Date().toISOString().split('T')[0];
            $('#DocDate').val(today); $('#TaxDate').val(today);
            if (d.docDueDate && d.docDueDate >= today) $('#DocDueDate').val(d.docDueDate);
            $('#U_BE1_AKTAR').val(d.u_BE1_AKTAR || d.U_BE1_AKTAR || '');
            $('#CurrencyType').val('BP');
            $('#DocCurrency').val(d.docCurrency || 'TRY');
            const rate = window.exchangeRates[d.docCurrency] || d.docRate || 1.0;
            $('#ExchangeRate').val(rate.toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
            $('#Comments').val(d.comments || '');
            $('#NumAtCard').val(d.numAtCard || '');   // SAP de baz belgeden tedarikçi ref. no'yu taşır

            // Fatura tipi / muafiyet ve şoför: change tetiklenmeli, bu yüzden geçici olarak bağlama modu kapatılır
            isBindingData = false;
            $('#U_BE1_SEND').val(d.u_BE1_SEND || d.U_BE1_SEND || '1').trigger('change');
            const muaf = d.u_BE1_MUAFCODE || d.U_BE1_MUAFCODE;
            if (muaf) $('#U_BE1_MUAFCODE').val(muaf);
            const sofor = d.u_BE1_SOFORSECIMI || d.U_BE1_SOFORSECIMI || '';
            if (sofor && allDrivers.find(x => x.docEntry === sofor)) {
                $('#DriverListSelect').val(sofor).trigger('change');
            } else {
                $('#DriverListSelect').val('').trigger('change.select2');
                $('#U_BE1_SRCNAME').val(d.u_BE1_SOFORADSOYAD || ''); $('#U_BE1_SRCPLAKA').val(d.u_BE1_ARACPLAKASI || '');
                $('#U_BE1_SRCTITLE').val(d.u_BE1_SOFORUNVANI || ''); $('#U_BE1_SRCVKN').val(d.u_BE1_SOFORKIMLIK || '');
                $('#U_BE1_SRCTEL').val(d.u_BE1_SOFORTEL || ''); $('#U_BE1_FIRMANO').val(d.u_BE1_FRMNO || '');
            }
            isBindingData = true;

            // Adresler: cari adres listesi + baz belgedeki adres kodları/metinleri
            $.get('/Rapor114/GetCustomerAddresses', { cardCode: d.cardCode }, function (res) {
                window.bpAddresses = res || [];
                let shipHtml = '<option value="">- Seçiniz -</option>', payHtml = '<option value="">- Seçiniz -</option>';
                (res || []).forEach(a => {
                    if (a.addressType === 'S') shipHtml += `<option value="${a.addressName}">${a.addressName}</option>`;
                    if (a.addressType === 'B') payHtml += `<option value="${a.addressName}">${a.addressName}</option>`;
                });
                $('#ShipToCode').html(shipHtml).val(d.shipToCode || '');
                $('#PayToCode').html(payHtml).val(d.payToCode || '');
            });
            const ae = d.addressExtension || {};
            fillAddressComponent('ShipTo', { street: ae.shipToStreet, streetNo: ae.shipToStreetNo, block: ae.shipToBlock, zipCode: ae.shipToZipCode, city: ae.shipToCity, county: ae.shipToCounty, state: ae.shipToState, country: ae.shipToCountry });
            fillAddressComponent('PayTo', { street: ae.billToStreet, streetNo: ae.billToStreetNo, block: ae.billToBlock, zipCode: ae.billToZipCode, city: ae.billToCity, county: ae.billToCounty, state: ae.billToState, country: ae.billToCountry });

            // Satırlar: baz belgenin açık satırları, BaseType/BaseEntry/BaseLine ile.
            // Baz belge hizmet tipiyse fatura da hizmet tipi olur (hesap + açıklama + açık tutar).
            const bazHizmet = (d.docType === 'S');
            $('#DocType').val(bazHizmet ? 'S' : 'I');
            faturaTuruUygula(bazHizmet ? 'S' : 'I', true);
            window.bazSatirlariEkle = function (d, baseTypeName, bazHizmet) {
            (d.lines || []).forEach(line => {
                addRow();
                const $tr = $('#linesBody tr').last();
                if (bazHizmet) {
                    const $acct = $tr.find('.acct-select');
                    if (line.accountCode && !$acct.find(`option[value="${line.accountCode}"]`).length)
                        $acct.append(new Option(`${line.accountCode} - ${line.accountName || ''}`, line.accountCode));
                    $acct.val(line.accountCode || '').trigger('change.select2');
                    $tr.find('.input-desc').val(line.description || '');
                    $tr.find('.input-price').val(line.lineTotal || 0);
                    ggKodSec($tr.find('.input-gider'), line.gider);
                    $tr.find('.input-currency').val(d.docCurrency || 'TRY');
                    if (line.vatGroup) $tr.find('.input-vat').val(line.vatGroup);
                    $tr.attr('data-btype', line.baseType).attr('data-bentry', line.baseEntry).attr('data-bline', line.baseLine)
                       .attr('title', `Baz: ${baseTypeName} ${d.docNum} / satır ${line.baseLine + 1}`).addClass('table-warning');
                    return;
                }
                const $item = $tr.find('.item-select');
                if (!$item.find(`option[value="${line.itemCode}"]`).length)
                    $item.append(new Option(`${line.itemCode} - ${itemDict[line.itemCode] || ''}`, line.itemCode));
                $item.val(line.itemCode).trigger('change.select2');
                if (line.warehouseCode) $tr.find('.input-whs').val(line.warehouseCode);
                $tr.find('.input-qty').val(line.quantity);
                $tr.find('.input-price').val(line.unitPrice);
                if (line.accountCode) {
                    const $acctItem = $tr.find('.input-acct-item');
                    if (!$acctItem.find(`option[value="${line.accountCode}"]`).length)
                        $acctItem.append(new Option(`${line.accountCode} - ${line.accountName || ''}`, line.accountCode));
                    $acctItem.val(line.accountCode).data('manual', true).trigger('change.select2');
                }
                ggKodSec($tr.find('.input-gider'), line.gider);
                if (line.currency) $tr.find('.input-currency').val(line.currency);
                if (line.vatGroup) $tr.find('.input-vat').val(line.vatGroup);
                $tr.find('.input-sec-name').text(line.secUnitName || '');
                $tr.find('.input-sec-multiplier').val(line.secUnitMultiplier || 0);
                $tr.attr('data-btype', line.baseType).attr('data-bentry', line.baseEntry).attr('data-bline', line.baseLine)
                   .attr('title', `Baz: ${baseTypeName} ${d.docNum} / satır ${line.baseLine + 1}`).addClass('table-warning');
            });
            };
            bazSatirlariEkle(d, baseTypeName, bazHizmet);
            isBindingData = false;
            $('#linesBody tr .input-whs').trigger('change');
            $('#CardCode').prop('disabled', true);
            $('#baseDocBadge').html(`<i class="fas fa-link me-1"></i>Baz: ${baseTypeName} No ${d.docNum}`).show();
            calculateTotals();
            $('#lines-tab').tab('show');
            toastr.info(`${baseTypeName} ${d.docNum} açık satırları kopyalandı. Kaydedince SAP'de bu belgeye bağlanır.`);
        }
        function kayitSonrasi(res) {
            if (res.taslak) { toastr.success(res.message, '', { timeOut: 7000 }); setTimeout(() => { window.location.reload(); }, 3000); return; }
            toastr.success(res.message);
            if (!res.docEntry || !SONRAKI_BELGELER.length) { setTimeout(() => { window.location.reload(); }, 2000); return; }
            $('#afterSaveMsg').text(res.message);
            $('#afterSaveLinks').html(sonrakiBelgeLinkleri(res.docEntry, 'btn btn-primary fw-bold'));
            $('#afterSaveModal').modal('show');
        }
        $('#btnAfterSaveNew').click(() => window.location.reload());

        // Baz belge seçme penceresi
        $('#btnBaseDoc').click(function () {
            if (currentMode !== 'ADD') { setFormMode('ADD'); fetchAllExchangeRates(); }
            const sel = $('#baseDocType'); sel.empty();
            BAZ_TIPLERI.forEach(b => sel.append(`<option value="${b.type}">${b.name}</option>`));
            $('#baseDocCard').val($('#CardCode').val() || '');
            bazBelgeleriListele();
            $('#baseDocModal').modal('show');
        });
        $('#baseDocType').on('change', bazBelgeleriListele);
        $('#btnBaseDocRefresh').on('click', bazBelgeleriListele);
        function bazBelgeleriListele() {
            const bt = parseInt($('#baseDocType').val()) || 0;
            if (!bt) return;
            $('#baseDocBody').html('<tr><td colspan="7" class="text-center text-muted py-3">Yükleniyor...</td></tr>');
            $.get('/Rapor114/GetOpenBaseDocuments', { cardCode: $('#baseDocCard').val() || '', baseType: bt }, function (res) {
                if (!res.success) { $('#baseDocBody').html(`<tr><td colspan="7" class="text-danger p-3">${res.message}</td></tr>`); return; }
                if (!res.data.length) { $('#baseDocBody').html('<tr><td colspan="7" class="text-center text-muted py-3">Açık satırı olan belge yok.</td></tr>'); return; }
                $('#baseDocBody').html(res.data.map(r => `<tr style="cursor:pointer" onclick="bazBelgeSec(${r.docEntry}, ${bt})">
                    <td onclick="event.stopPropagation()"><input type="checkbox" class="form-check-input bazSec" value="${r.docEntry}" data-card="${r.cardCode}" data-no="${r.docNum}"></td>
                    <td class="fw-bold">${r.docNum}</td><td>${r.docDate}</td><td>${r.cardCode}</td>
                    <td class="text-truncate" style="max-width:240px">${r.cardName || ''}</td>
                    <td class="text-end">${formatNumber(r.docTotal)}</td><td><span class="badge bg-secondary">${r.docCurrency || ''}</span></td></tr>`).join(''));
            });
        }
        window.bazBelgeSec = function (docEntry, baseType) { $('#baseDocModal').modal('hide'); loadBaseDocument(docEntry, baseType); };
        // ---- Coklu baz belge: isaretlenen belgelerin acik satirlari tek belgede birlesir (her satir kendi BaseEntry/BaseLine'iyla) ----
        $(document).on('change', '#bazHepsi', function () { $('#baseDocBody .bazSec').prop('checked', this.checked).trigger('change'); });
        $(document).on('change', '.bazSec', function () { $('#bazSecSayi').text($('#baseDocBody .bazSec:checked').length); });
        window.bazBelgeleriGetir = function () {
            const bt = parseInt($('#baseDocType').val()) || 0;
            const secili = $('#baseDocBody .bazSec:checked').map(function () { return { entry: parseInt(this.value), card: $(this).data('card'), no: $(this).data('no') }; }).get();
            if (!secili.length) { toastr.warning('Önce listeden belge işaretleyin.'); return; }
            if (new Set(secili.map(s => String(s.card))).size > 1) { toastr.error('Seçilen belgeler aynı cariye ait olmalı; SAP tek belgede farklı carileri birleştirmez.'); return; }
            if (secili.length === 1) { bazBelgeSec(secili[0].entry, bt); return; }
            $('#baseDocModal').modal('hide');
            const tipAd = (BAZ_TIPLERI.find(b => b.type === bt) || {}).name || 'Baz belge';
            $('#loadingOverlay').css('display', 'flex');
            let i = 0, ilkTip = null; const nolar = [], hatalar = [];
            const bitir = function () {
                $('#loadingOverlay').hide();
                isBindingData = false;
                $('#linesBody tr .input-whs').trigger('change');
                window.aktifBazBelgeler = secili.map(s => s.entry);
                $('#baseDocBadge').html('<i class="fas fa-link me-1"></i>Baz: ' + tipAd + ' No ' + nolar.join(', ')).show();
                calculateTotals();
                if (hatalar.length) toastr.warning('Alınamayan belgeler: ' + hatalar.join(', '), '', { timeOut: 10000 });
                toastr.success(nolar.length + ' belgenin açık satırları birleştirildi (' + $('#linesBody tr').length + ' satır). Kaydedince her satır kendi baz belgesine bağlanır.', '', { timeOut: 8000 });
            };
            const sonraki = function () {
                if (i >= secili.length) { bitir(); return; }
                const s = secili[i++];
                $.ajax({ url: '/Rapor114/GetBaseDocument', data: { baseEntry: s.entry, baseType: bt }, timeout: 90000 })
                    .done(function (res) {
                        if (!(res && res.success && res.data)) { hatalar.push(s.no || s.entry); sonraki(); return; }
                        const d = res.data;
                        try {
                            if (nolar.length === 0) { bindBaseDocToForm(d, bt, s.entry, tipAd); ilkTip = d.docType === 'S' ? 'S' : 'I'; bazEkSatir(res.ek, s.entry); bazEkBaslik(res.ek, '/Rapor114'); }
                            else if ((d.docType === 'S' ? 'S' : 'I') !== ilkTip) { hatalar.push((s.no || s.entry) + ' (belge türü farklı: kalem/hizmet karışmaz)'); sonraki(); return; }
                            else { isBindingData = true; bazSatirlariEkle(d, tipAd, d.docType === 'S'); isBindingData = false; bazEkSatir(res.ek, s.entry); }
                            nolar.push(d.docNum);
                        } catch (e) { console.error(e); hatalar.push((s.no || s.entry) + ': ' + (e && e.message ? e.message : e)); }
                        sonraki();
                    })
                    .fail(function () { hatalar.push(s.no || s.entry); sonraki(); });
            };
            sonraki();
        };

        // ===================== YEVMİYE KAYDI ÖNİZLEME =====================
        // Ekleme modunda: formdaki satırlardan SAP'ye gitmeden fiş tahmini (SQL hesap belirleme).
        // Görüntüleme modunda: belgenin SAP'deki gerçek yevmiye fişi.
        function yevmiyePayload() {
            const documentLines = [];
            const hizmet = faturaTuru() === 'S';
            $('#linesBody tr').each(function () {
                const itemCode = $(this).find('.item-select').val();
                const qty = parseFloat($(this).find('.input-qty').val()) || 0;
                const price = parseFloat($(this).find('.input-price').val()) || 0;
                if (hizmet) {
                    const acct = $(this).find('.acct-select').val();
                    if (!acct || price <= 0) return;
                    documentLines.push({
                        AccountCode: acct, Description: $(this).find('.input-desc').val() || '', LineTotal: price,
                        VatGroup: $(this).find('.input-vat').val() || null, WTLiable: ($(this).find('.input-wt').val() === 'Y'),
                        BaseType: $(this).attr('data-btype') ? parseInt($(this).attr('data-btype')) : null,
                        BaseEntry: $(this).attr('data-bentry') ? parseInt($(this).attr('data-bentry')) : null,
                        BaseLine: $(this).attr('data-bline') !== undefined ? parseInt($(this).attr('data-bline')) : null,
                            KopyaSatir: $(this).attr('data-kline') !== undefined ? parseInt($(this).attr('data-kline')) : null
                    });
                    return;
                }
                if (!itemCode || qty <= 0) return;
                documentLines.push({
                    ItemCode: itemCode, Quantity: qty, UnitPrice: price,
                    Currency: $(this).find('.input-currency').val() || 'TRY',
                    VatGroup: $(this).find('.input-vat').val() || null,
                    WarehouseCode: $(this).find('.input-whs').val() || '01',
                    AccountCode: ($(this).find('.input-acct-item').val() || '').trim(),
                    WTLiable: ($(this).find('.input-wt').val() === 'Y'),
                    BaseType: $(this).attr('data-btype') ? parseInt($(this).attr('data-btype')) : null,
                    BaseEntry: $(this).attr('data-bentry') ? parseInt($(this).attr('data-bentry')) : null,
                    BaseLine: $(this).attr('data-bline') !== undefined ? parseInt($(this).attr('data-bline')) : null,
                            KopyaSatir: $(this).attr('data-kline') !== undefined ? parseInt($(this).attr('data-kline')) : null
                });
            });
            const today = new Date().toISOString().split('T')[0];
            const docRateStr = ($('#ExchangeRate').val() || '').replace(/\./g, '').replace(',', '.');
            return {
                DocType: faturaTuru(),
                CardCode: $('#CardCode').val(),
                DocDate: $('#DocDate').val() || today, DocDueDate: $('#DocDueDate').val() || today, TaxDate: $('#TaxDate').val() || today,
                SalesPersonCode: parseInt($('#SalesPersonCode').val()) || 0,
                DocCurrency: $('#DocCurrency').val() || 'TRY', DocRate: parseFloat(docRateStr) || 1.0,
                WTCode: $('#StopajKodu').val() || null, NumAtCard: $('#NumAtCard').val() || null,
                DocumentLines: documentLines
            };
        }
        function yevmiyeGoster(res) {
            if (!res || !res.success) { toastr.warning((res && res.message) || 'Yevmiye kaydı alınamadı.'); return; }
            const fc = res.dovizli ? (res.docCur || '') : '';
            $('#yevmiyeModal .fc-col').toggle(!!res.dovizli);
            $('#yevmiyeBadge').text(res.onizleme ? 'ÖNİZLEME — SAP\'ye kaydedilmedi' : ('SAP kaydı · Fiş No ' + res.transId))
                .removeClass('bg-warning bg-success text-dark text-white').addClass(res.onizleme ? 'bg-warning text-dark' : 'bg-success text-white');
            $('#yevmiyeBody').html((res.satirlar || []).map(s => `<tr>
                <td class="fw-bold ${s.hesapKodu === '?' ? 'text-danger' : 'text-primary'}">${s.hesapKodu}</td>
                <td>${s.hesapAdi || ''}</td>
                <td class="text-end">${s.borc ? formatNumber(s.borc) : ''}</td>
                <td class="text-end">${s.alacak ? formatNumber(s.alacak) : ''}</td>
                <td class="text-end fc-col">${s.fcBorc ? formatNumber(s.fcBorc) + ' ' + fc : ''}</td>
                <td class="text-end fc-col">${s.fcAlacak ? formatNumber(s.fcAlacak) + ' ' + fc : ''}</td>
                <td class="small text-muted">${s.aciklama || ''}</td></tr>`).join(''));
            $('#yevmiyeModal .fc-col').toggle(!!res.dovizli);
            $('#yevmiyeTB').text(formatNumber(res.toplamBorc || 0) + ' TL');
            $('#yevmiyeTA').text(formatNumber(res.toplamAlacak || 0) + ' TL');
            $('#yevmiyeUyari').html((res.uyarilar || []).length
                ? `<div class="alert alert-warning py-2 small mb-2"><i class="fas fa-exclamation-triangle me-1"></i>${res.uyarilar.map(u => `<div>${u}</div>`).join('')}</div>` : '');
            $('#yevmiyeOzet').html(res.ozet
                ? `Net <b>${formatNumber(res.ozet.net)}</b> · KDV <b>${formatNumber(res.ozet.kdv)}</b>${res.ozet.stopaj ? ` · Stopaj <b>-${formatNumber(res.ozet.stopaj)}</b>` : ''} · Cari alacak <b>${formatNumber(res.ozet.toplam)}</b> TL`
                : (res.dovizli ? `Belge dövizi ${res.docCur}, kur ${res.docRate}` : ''));
            $('#yevmiyeNot').text(res.onizleme
                ? 'Önizleme; hesaplar carinin kontrol hesabı, KDV grubu tanımları, stopaj kodu ve SAP hesap belirleme kurallarından tahmin edilir. Kesin kayıt SAP\'ye ekleyince oluşur.'
                : 'SAP\'de oluşmuş gerçek yevmiye fişi.');
            $('#yevmiyeModal').modal('show');
        }
        $('#btnYevmiye').click(function () {
            if (currentMode === 'VIEW' && currentDocEntry) {
                $('#loadingOverlay').css('display', 'flex');
                $.get('/Rapor114/YevmiyeGercek', { docEntry: currentDocEntry }, yevmiyeGoster)
                    .fail(() => toastr.error('Yevmiye kaydı alınamadı.')).always(() => $('#loadingOverlay').hide());
                return;
            }
            // Stopaja tabi satır varsa önce carinin stopaj kodu sorulur; seçilen kodla önizleme yapılır
            stopajKoduSor(function () {
                const p = yevmiyePayload();
                if (!p.CardCode) { toastr.warning('Önce tedarikçi seçiniz.'); return; }
                if (!p.DocumentLines.length) { toastr.warning('Önizleme için en az bir kalem satırı (kalem + miktar) giriniz.'); $('#lines-tab').tab('show'); return; }
                $('#loadingOverlay').css('display', 'flex');
                $.ajax({
                    url: '/Rapor114/YevmiyeOnizleme', type: 'POST', contentType: 'application/json', data: JSON.stringify(p),
                    success: yevmiyeGoster,
                    error: xhr => toastr.error(xhr.responseJSON ? xhr.responseJSON.message : 'Bağlantı hatası.'),
                    complete: () => $('#loadingOverlay').hide()
                });
            });
        });

        // ===================== STOPAJ KODU SEÇİMİ (carinin kartındaki kodlar) =====================
        function stopajTabiSatirVar() {
            return $('#linesBody tr .input-wt').filter(function () { return $(this).val() === 'Y'; }).length > 0;
        }
        // Stopaja tabi satır yoksa hemen devam eder; varsa carinin CRD4 kodlarını listeler, seçilince #StopajKodu'na yazıp devam eder.
        function stopajKoduSor(devam) {
            if (!stopajTabiSatirVar()) { devam(null); return; }
            const card = $('#CardCode').val();
            if (!card) { toastr.warning('Önce tedarikçi / müşteri seçiniz.'); return; }
            $.get('/Rapor114/GetCariStopajKodlari', { cardCode: card }).done(function (res) {
                if (!res || !res.success) { toastr.error((res && res.message) || 'Cari stopaj kodları alınamadı.'); return; }
                if (!res.data || !res.data.length) {
                    toastr.error('Bu carinin SAP kartında işaretli stopaj (tevkifat) kodu yok. Önce cari kartında "Stopaj Vergisi" kodlarını tanımlayın.', '', { timeOut: 10000 });
                    return;
                }
                const secili = $('#StopajKodu').val();
                $('#stopajSecListe').html(res.data.map(function (k, i) {
                    const isaretli = secili ? (secili === k.code) : (i === 0);
                    return `<label class="list-group-item d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" class="form-check-input mt-0" name="stopajSec" value="${k.code}" ${isaretli ? 'checked' : ''}>
                        <span><b>${k.code}</b> - ${k.name}</span>
                        <span class="badge bg-warning text-dark ms-auto">%${k.rate}</span></label>`;
                }).join(''));
                window.stopajSecVeri = res.data;
                $('#stopajSecCari').text(card);
                window.stopajSecDevam = devam;
                $('#stopajSecModal').modal('show');
            }).fail(function () { toastr.error('Cari stopaj kodları alınamadı (bağlantı).'); });
        }
        $('#btnStopajSecOnay').click(function () {
            const v = $('input[name="stopajSec"]:checked').val();
            if (!v) { toastr.warning('Bir stopaj kodu seçiniz.'); return; }
            if (!$('#StopajKodu option[value="' + v + '"]').length) $('#StopajKodu').append(new Option(v, v));
            const secKod = (window.stopajSecVeri || []).find(function (x) { return x.code === v; });
            if (secKod) $('#StopajKodu option[value="' + v + '"]').attr('data-rate', secKod.rate).attr('data-type', secKod.type || '');
            $('#StopajKodu').val(v).prop('disabled', false);
            calculateTotals();
            $('#stopajSecModal').modal('hide');
            const d = window.stopajSecDevam; window.stopajSecDevam = null;
            if (typeof d === 'function') d(v);
        });
        $('#stopajSecModal').on('hidden.bs.modal', function () { window.stopajSecDevam = null; });

        // Kodlar Rapor164 kataloğundan (seçili şirketin ekiyle) yüklenir: 7'li hesap → GİDER (GDR), 6'lı → GELİR (GLR); teşvik/istisna da listelenir.
        window.GG_KODLAR = []; window.GG_AD = {};
        function ggEsc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;'); }
        function ggKodlariYukle() {
            $.getJSON('/Rapor164/Kodlar', function (res) {
                if (!res || !res.success) { toastr.warning((res && res.message) || 'Gider/gelir kodları alınamadı.'); return; }
                window.GG_KODLAR = res.data || []; window.GG_AD = {};
                window.GG_KODLAR.forEach(function (k) { window.GG_AD[k.kod] = k.ad; window.GG_AD[k.kokKod] = k.ad; });
                if (res.uyari) toastr.warning(res.uyari, '', { timeOut: 12000 });
                $('#linesBody tr .input-gider').each(function () { var v = $(this).val(); ggOptgroups($(this)); ggKodSeciciKur($(this)); if (v) ggKodSec($(this), v); });
            }).fail(function () { toastr.warning('Gider/gelir kod kataloğuna ulaşılamadı.'); });
        }
        function ggOptgroups($sel, tip) {
            if (!$sel.length || $sel.find('optgroup').length || !window.GG_KODLAR.length) return;
            tip = tip || $sel.attr('data-tip') || '';   // satırın hesabına göre: GELIR → yalnızca gelir kodları, GIDER → yalnızca gider kodları (+ teşvik)
            var grp = function (t, ad) { if (tip && t !== tip && t !== 'TIS') return ''; var g = window.GG_KODLAR.filter(function (k) { return k.tip === t; }); if (!g.length) return ''; return '<optgroup label="' + ad + '">' + g.map(function (k) { return '<option value="' + ggEsc(k.kod) + '">' + ggEsc(k.kod) + ' — ' + ggEsc(k.ad) + '</option>'; }).join('') + '</optgroup>'; };
            $sel.append(grp('GIDER', 'GİDER') + grp('GELIR', 'GELİR') + grp('TIS', 'TEŞVİK / İSTİSNA'));
        }
        // Satırın hesabına göre kod listesi: tip GELIR/GIDER → liste daraltılır; hesap 6/7 değilse kod kutusu kapatılır ("kod gerekmez").
        function ggSatirTipiAyarla($tr, tip, hesap) {
            var $sel = $tr.find('.input-gider'); if (!$sel.length) return;
            tip = tip || ''; hesap = hesap || '';
            var mevcut = $sel.val() || '';
            $sel.attr('data-tip', tip).attr('data-hesap', hesap);
            if ($sel.hasClass('select2-hidden-accessible')) $sel.select2('destroy');
            $sel.find('optgroup').remove();
            ggOptgroups($sel, tip);
            var gerekmez = !!hesap && !tip;
            var yerTutucu = gerekmez ? ('kod gerekmez (' + hesap + ')') : (tip === 'GELIR' ? '- gelir kodu seç -' : tip === 'GIDER' ? '- gider kodu seç -' : '- kod seç -');
            $sel.attr('title', hesap ? ('Satırın hesabı ' + hesap + (gerekmez ? ': gider/gelir kodu gerekmez' : (tip === 'GELIR' ? ': GELİR (GLR) kodu zorunlu' : ': GİDER (GDR) kodu zorunlu'))) : 'Gider / gelir kodu');
            if (gerekmez || (mevcut && !$sel.find('option[value="' + mevcut + '"]').length)) mevcut = '';
            $sel.val(mevcut);
            $sel.prop('disabled', gerekmez);
            $sel.select2({ theme: 'bootstrap-5', width: '100%', placeholder: yerTutucu, allowClear: true, dropdownAutoWidth: true });
            if (!mevcut && !gerekmez && window.GG_SABIT && window.GG_SABIT.kod && (!tip || window.GG_SABIT.tip === tip) && (typeof currentMode === 'undefined' || currentMode === 'ADD')) ggKodSec($sel, window.GG_SABIT.kod);
            $tr.find('.btn-gg-sec').prop('disabled', gerekmez);
        }
        function ggKodSeciciKur($sel) {
            if (!$sel.length) return;
            ggOptgroups($sel);
            if (!$sel.hasClass('select2-hidden-accessible')) $sel.select2({ theme: 'bootstrap-5', width: '100%', placeholder: '- kod seç -', allowClear: true, dropdownAutoWidth: true });
            if (window.GG_SABIT && !$sel.val() && (typeof currentMode === 'undefined' || currentMode === 'ADD')) ggKodSec($sel, window.GG_SABIT.kod);
        }
        function ggKodSec($sel, kod) {
            kod = (kod || '').trim(); if (!$sel.length) return; ggOptgroups($sel);
            if (kod && !$sel.find('option[value="' + kod + '"]').length) $sel.append(new Option(kod + (window.GG_AD[kod] ? ' — ' + window.GG_AD[kod] : ''), kod));
            $sel.val(kod || '').trigger('change.select2');
        }
        function ggAd(kod) { kod = (kod || '').trim(); if (!kod) return ''; var ad = window.GG_AD[kod] || window.GG_AD[kod.split('.').slice(0, 4).join('.')]; return '<span class="fw-bold text-primary">' + ggEsc(kod) + '</span>' + (ad ? ' <span class="text-muted">' + ggEsc(ad) + '</span>' : ''); }

        // ===================== SATIRIN HESABINA GÖRE KOD LİSTESİ =====================
        // Kalem / hesap / depo / cari değişince satırın arkasındaki hesap sunucudan sorulur (HesapBelirleme):
        // 6'lı gelir hesabı → yalnızca gelir kodları, 7'li ya da (-) 6'lı → yalnızca gider kodları, diğer → kod gerekmez.
        var ggHesapIstek = {};
        function ggSatirHesabiSor($tr) {
            var $sel = $tr.find('.input-gider'); if (!$sel.length) return;
            if (faturaTuru() === 'S') {
                var acct = $tr.find('.acct-select').val() || '';
                ggSatirTipiAyarla($tr, acct ? GGSecici.hesapTipi(acct) : '', acct);
                return;
            }
            var item = $tr.find('.item-select').val() || '';
            if (!item) { ggSatirTipiAyarla($tr, '', ''); return; }
            var anahtar = $tr.index();
            var istek = $.getJSON('/Rapor114/SatirHesabi', { itemCode: item, whsCode: $tr.find('.input-whs').val() || '', cardCode: $('#CardCode').val() || '', vatGroup: $tr.find('.input-vat').val() || '', docDate: $('#DocDate').val() || '', baseType: $tr.attr('data-btype') || '', baseEntry: $tr.attr('data-bentry') || '', baseLine: $tr.attr('data-bline') || '' });
            ggHesapIstek[anahtar] = istek;
            istek.done(function (res) {
                if (ggHesapIstek[anahtar] !== istek) return;
                if (res && res.success) {
                    ggSatirTipiAyarla($tr, res.tip || '', res.hesap || '');
                    // Kullanıcı satırda hesabı elle değiştirmediyse, otomatik belirlenen hesabı öneri olarak yazar.
                    // Sunucu "hesap" olarak görünen kodu (FormatCode) döner; dropdown'un value'su ise AcctCode'dur,
                    // bu yüzden seçenek metninden (FormatCode - Ad) eşleşen AcctCode bulunur.
                    var $acctItem = $tr.find('.input-acct-item');
                    if ($acctItem.length && !$acctItem.data('manual')) {
                        var yeniDeger = '';
                        if (res.hesap) {
                            // Hesap listesi sunucudan arandığı için seçenek yerelde yoktur; AcctCode ile tek seçenek eklenir.
                            yeniDeger = res.hesapKodu || res.hesap;
                            if (!$acctItem.find('option[value="' + yeniDeger + '"]').length)
                                $acctItem.append(new Option(res.hesap + (res.hesapAdi ? ' - ' + res.hesapAdi : ''), yeniDeger));
                        }
                        $acctItem.val(yeniDeger).trigger('change.select2');
                    }
                }
            });
        }
        // Hesap kutusunu kullanıcı elle değiştirirse otomatik öneriler bu satırın hesabının üzerine yazılmaz;
        // kalem değişince öneri tekrar geçerli olsun diye bayrak sıfırlanır.
        $('#linesBody').on('change', '.input-acct-item', function () { $(this).data('manual', true); });
        $('#linesBody').on('change', '.item-select', function () { $(this).closest('tr').find('.input-acct-item').removeData('manual'); });
        $('#linesBody').on('change', '.item-select, .acct-select, .input-whs', function () { if (isBindingData) return; ggSatirHesabiSor($(this).closest('tr')); });
        $('#CardCode').on('change', function () { if (isBindingData || currentMode !== 'ADD') return; $('#linesBody tr').each(function () { ggSatirHesabiSor($(this)); }); });

        // ===================== SABİT CARİ KODU =====================        // Cari seçilince (Rapor163 › Sabit Cariler) tanımlı sabit kod varsa boş gider/gelir kutularına otomatik yazılır.
        window.GG_SABIT = null;
        function ggSabitUygula() {
            if (!window.GG_SABIT || (typeof currentMode !== 'undefined' && currentMode !== 'ADD')) return;
            $('#linesBody tr .input-gider').each(function () { if (!$(this).val()) ggKodSec($(this), window.GG_SABIT.kod); });
        }
        $('#CardCode').on('change', function () {
            const cc = $(this).val(); window.GG_SABIT = null;
            if (!cc || (typeof currentMode !== 'undefined' && currentMode !== 'ADD')) return;
            $.getJSON('/Rapor164/SabitKod', { cardCode: cc, tip: 'GIDER' }, function (res) {
                if (res && res.success && res.kod) { window.GG_SABIT = res; ggSabitUygula(); toastr.info('Sabit cari: satırlara ' + res.kod + ' (' + (res.ad || '') + ') yazıldı.', '', { timeOut: 6000 }); }
            });
        });

        // ===================== GİDER KOLONU (U_BE1_GIDER) =====================        // Hesap ekstresindeki gibi: sayfa açılınca alan yoksa Service Layer ile otomatik açılır;
        // mevcut gider değerleri satırdaki öneri listesine (datalist) dolar.
        window.giderAlaniHazir = false;
        $.ajax({ url: '/Rapor114/GiderAlaniniHazirla', type: 'POST' }).done(function (res) {
            if (!res || !res.success) { toastr.warning((res && res.message) || 'Gider alanı kontrol edilemedi.', '', { timeOut: 9000 }); return; }
            window.giderAlaniHazir = true;
            if (res.olusturuldu) toastr.info('"Gider" satır alanı (U_BE1_GIDER) SAP\'de Service Layer ile otomatik açıldı.', '', { timeOut: 9000 });
            ggKodlariYukle();
        }).fail(function () { toastr.warning('Gider alanı kontrol edilemedi (bağlantı).'); });

        // Taslak olarak kaydet: aynı form gönderimi; sunucu SL Drafts'a yazar (belge/fiş oluşmaz)
        window.taslakKaydet = false;
        $('#btnTaslak').click(function () {
            if (currentMode !== 'ADD') return;
            window.taslakKaydet = true;
            $(this).closest('form').trigger('submit');
        });

        // ===================== FATURA TÜRÜ: KALEM (I) / HİZMET (S) =====================
        const THEAD_ITEM = $('#linesTable thead').html();
        const THEAD_SERVICE = `<tr>
            <th style="width: 40px;" class="text-center">#</th>
            <th style="min-width: 240px;">Hesap <span class="text-danger">*</span></th>
            <th style="min-width: 160px;">Açıklama</th>
            <th style="width: 170px;" class="text-end">Tutar & PB <span class="text-danger">*</span></th>
            <th style="width: 110px;">Vergi Kodu <span class="text-danger">*</span></th>
            <th style="width: 90px;" class="text-center">Stopaj</th>
            <th style="min-width: 240px;" title="Gider / gelir kodu (satır alanı U_BE1_GIDER); 6'lı-7'li hesaplara giden satırlarda zorunlu">Gider / Gelir Kodu</th><th style="min-width: 150px;" class="text-end">Top. (PB)</th>
            <th style="min-width: 150px;" class="text-end">Top. (TL)</th>
            <th style="width: 40px;" class="text-center" id="colDelIcon"><i class="fas fa-trash text-muted"></i></th>
        </tr>`;
        function faturaTuru() { return $('#DocType').val() === 'S' ? 'S' : 'I'; }
        // Tablo başlığını türe göre kurar; satirlariTemizle=true ise mevcut satırları siler (tür değişimi / yeni belge)
        function faturaTuruUygula(tur, satirlariTemizle) {
            const hizmet = (tur === 'S');
            $('#linesTable thead').html(hizmet ? THEAD_SERVICE : THEAD_ITEM);
            $('#btnAddRowText').text(hizmet ? 'Hizmet Satırı Ekle' : 'Kalem Ekle');
            if (satirlariTemizle) {
                $('#linesBody tr').find('.item-select, .acct-select, .input-acct-item').each(function () { try { $(this).select2('destroy'); } catch (e) { } });
                $('#linesBody').empty();
            }
            if (currentMode !== 'ADD') $('#colDelIcon').hide();
        }

        // Satır seçicileri: liste sayfaya gömülmez, yazdıkça sunucudan aranır (select2 ajax). Seçili değer için yalnızca
        // tek <option> bulunur; bindBaseDocToForm / çoğaltma / SatirHesabi eksik seçeneği kendileri ekler.
        function uzakSecici($sel, url, yerTutucu) {
            if (!$sel.length) return;
            $sel.select2({
                theme: 'bootstrap-5', width: '100%', placeholder: yerTutucu, minimumInputLength: 1,
                language: { inputTooShort: function () { return 'Aramak için yazın...'; }, searching: function () { return 'Aranıyor...'; }, noResults: function () { return 'Sonuç bulunamadı'; } },
                ajax: { url: url, dataType: 'json', delay: 200, data: function (p) { return { q: p.term }; }, processResults: function (d) { return { results: d.results || [] }; }, cache: true }
            });
        }
        function satirSecicileriKur($tr) {
            uzakSecici($tr.find('.item-select'), '/Rapor114/KalemAra', 'Kalem seçin / yazarak arayın');
            uzakSecici($tr.find('.acct-select'), '/Rapor114/HesapAra', 'Hesap seçin / yazarak arayın');
            uzakSecici($tr.find('.input-acct-item'), '/Rapor114/HesapAra', 'Otomatik belirlenecek...');
        }
        function addRow() {
            const template = document.getElementById(faturaTuru() === 'S' ? 'rowTemplateService' : 'rowTemplate').innerHTML;
            const $newRow = $(template);
            $('#linesBody').append($newRow);

            satirSecicileriKur($newRow);
            ggKodSeciciKur($newRow.find('.input-gider'));

            $newRow.find('.input-whs').val('01');
            $newRow.find('.input-vat').val('P01');   // varsayılan vergi kodu (değiştirilebilir)
            // Hizmet satırında tutar belge dövizinde girilir
            if (faturaTuru() === 'S') $newRow.find('.input-currency').val($('#DocCurrency').val() || 'TRY');
            
            // Satınalma işlemleri için varsayılan vergi kodunu atıyoruz. (Genelde Input - I ile başlar)
            if($newRow.find('.input-vat option[value="I01"]').length > 0) {
                $newRow.find('.input-vat').val('I01');
            } else if($newRow.find('.input-vat option[value="I18"]').length > 0) {
                $newRow.find('.input-vat').val('I18');
            }

            // Yeni satırın stopaj varsayılanı: carinin WTLiable durumundan gelir
            $newRow.find('.input-wt').val(window.cariWTLiable ? 'Y' : 'N');

            updateRowIndexes();
            stopajDurumGuncelle();
        }

        // Herhangi bir satır stopaja tabi ise belge stopaj kodu aktif/zorunlu olur.
        function stopajDurumGuncelle() {
            var tabiVar = $('#linesBody tr .input-wt').filter(function(){ return $(this).val() === 'Y'; }).length > 0;
            $('#StopajKodu').prop('disabled', !tabiVar);
            $('#stopajKoduWrap').css('opacity', tabiVar ? '1' : '0.55');
            if (!tabiVar) $('#StopajKodu').val('');
        }
        $(document).on('change', '.input-wt', function(){ if(currentMode==='ADD') { stopajDurumGuncelle(); calculateTotals(); } });
        $('#StopajKodu').on('change', function(){ if(currentMode==='ADD') calculateTotals(); });

        function updateRowIndexes() {
            $('#linesBody tr').each(function (index) { $(this).find('.row-index').text(index + 1); });
        }

        function resetTotals() {
            $('#lblNetTotalLC').text('0,00 TRY');
            $('#lblTaxTotalLC').text('0,00 TRY');
            $('#lblStopajTotalLC').text('0,00 TRY');
            $('#lblGrandTotalLC').text('0,00 TRY');
            $('#lblGrandTotalFC').text('0,00');
        }

        function calculateTotals() {
            if(currentMode !== 'ADD') return;
            
            let netTotalLC = 0, taxTotalLC = 0, stopajTotalLC = 0;
            // Seçili stopaj kodunun oranı/tipi (V = KDV tevkifatı: baz satır KDV'si; diğer: satır neti)
            const $stopajSecim = $('#StopajKodu option:selected');
            const stopajOran = parseFloat($stopajSecim.attr('data-rate')) || 0;
            const stopajTip = ($stopajSecim.attr('data-type') || '').toString().trim().toUpperCase();
            const docCurrency = $('#DocCurrency').val() || 'TRY';
            
            let docRateStr = $('#ExchangeRate').val();
            let docRate = 1.0;
            if(docRateStr) docRate = parseFloat(docRateStr.replace(/\./g, '').replace(',', '.')) || 1.0;

            $('#linesBody tr').each(function () {
                const qty = parseFloat($(this).find('.input-qty').val()) || 0;
                const price = parseFloat($(this).find('.input-price').val()) || 0;
                const lineCur = $(this).find('.input-currency').val() || 'TRY';
                const vatRate = parseFloat($(this).find('.input-vat option:selected').data('rate')) || 0;
                
                const secMultiplier = parseFloat($(this).find('.input-sec-multiplier').val()) || 0;
                const secTotal = qty * secMultiplier;
                $(this).find('.input-sec-total').text(formatNumber(secTotal));

                const lineRate = window.exchangeRates[lineCur] || (lineCur === docCurrency ? docRate : 1.0);
                
                const lineNetFC = qty * price;
                const lineNetLC = lineNetFC * lineRate;
                const lineTaxLC = lineNetLC * (vatRate / 100);

                $(this).find('.line-total-fc').text(formatNumber(lineNetFC) + ' ' + lineCur);
                $(this).find('.line-total-lc').text(formatNumber(lineNetLC) + ' TRY');
                
                netTotalLC += lineNetLC; 
                taxTotalLC += lineTaxLC;
                if ($(this).find('.input-wt').val() === 'Y' && stopajOran > 0)
                    stopajTotalLC += (stopajTip === 'V' ? lineTaxLC : lineNetLC) * (stopajOran / 100);
            });

            stopajTotalLC = Math.round(stopajTotalLC * 100) / 100;
            const grandTotalLC = netTotalLC + taxTotalLC - stopajTotalLC;   // SAP belge toplamı stopaj düşülmüş tutardır
            const docGrandTotalFC = (docCurrency === 'TRY') ? grandTotalLC : (grandTotalLC / docRate);

            $('#lblNetTotalLC').text(formatNumber(netTotalLC) + ' TRY');
            $('#lblTaxTotalLC').text(formatNumber(taxTotalLC) + ' TRY');
            $('#lblStopajTotalLC').text((stopajTotalLC > 0 ? '-' : '') + formatNumber(stopajTotalLC) + ' TRY');
            $('#rowStopajTotal').toggleClass('fw-bold', stopajTotalLC > 0);
            $('#lblGrandTotalLC').text(formatNumber(grandTotalLC) + ' TRY');
            
            $('#lblGrandTotalFC').text(formatNumber(docGrandTotalFC) + ' ' + docCurrency);
        }
    </script>
}