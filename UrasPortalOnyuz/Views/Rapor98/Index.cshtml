@model WebApplication3.Controllers.Rapor98ViewModel
@{
    ViewData["Title"] = "Aktarım Veri Denetimi (SELVİ KİMYA)";
    string selectedCompany = ViewBag.SelectedCompany ?? "SELVI";
    string targetDbSuffix = ViewBag.TargetDbSuffix ?? "_AS";
    
    // Stok Belge Kontrol için formdan gelen Yıl/Ay değerleri
    int selectedYear = ViewBag.SelectedYear ?? DateTime.Now.Year;
    int selectedMonth = ViewBag.SelectedMonth ?? DateTime.Now.Month;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    body { background-color: #f4f6f9; overflow-x: hidden; }
    .dash-card { border-radius: 12px; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: transform 0.2s; background: white; }
    .icon-box { width: 48px; height: 48px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 22px; }
    .bg-gradient-primary { background: linear-gradient(45deg, #4e73df, #224abe); color: white; }
    .bg-gradient-success { background: linear-gradient(45deg, #1cc88a, #13855c); color: white; }
    .bg-gradient-warning { background: linear-gradient(45deg, #f6c23e, #dda20a); color: white; }
    .bg-gradient-danger { background: linear-gradient(45deg, #e74a3b, #be2617); color: white; }
    .bg-gradient-dark { background: linear-gradient(45deg, #343a40, #1d2124); color: white; }
    .bg-gradient-purple { background: linear-gradient(45deg, #6f42c1, #4e2b8c); color: white; }
    .bg-gradient-info { background: linear-gradient(45deg, #36b9cc, #258391); color: white; }
    
    .table-custom th { background-color: #f8f9fc; text-transform: uppercase; font-size: 12px; color: #858796; border-bottom: 2px solid #e3e6f0; }
    .table-custom td { vertical-align: middle; font-size: 13px; color: #5a5c69; }
    
    /* Sekme stilleri (Yan yana dizilmesi için güncellendi) */
    .nav-pills-custom {
        display: flex;
        flex-wrap: wrap;
        gap: 8px; /* Sekmeler arasına boşluk */
    }
    .nav-pills-custom .nav-link { 
        color: #5a5c69; 
        font-weight: 600; 
        border-radius: 20px; 
        padding: 8px 16px; 
        margin-right: 0;
        transition: all 0.2s ease-in-out;
        background-color: transparent;
        border: 1px solid transparent;
        cursor: pointer;
        font-size: 0.9rem;
    }
    .nav-pills-custom .nav-link:hover { background-color: #e3e6f0; }
    .nav-pills-custom .nav-link.active { background-color: #212529; color: white; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    
    .filter-bar { background-color: #f8f9fc; border-bottom: 1px solid #e3e6f0; padding: 10px 15px; border-radius: 12px 12px 0 0; }
    .btn-filter, .btn-stok-filter, .btn-fiyat-filter { font-weight: 600; border-radius: 20px; font-size: 12px; padding: 6px 16px; transition: all 0.2s; }
    
    .full-page-table { max-height: calc(100vh - 310px); overflow-y: auto; }
    .loading-overlay { display: none; text-align: center; padding: 40px; }
    .initial-load-msg { display:flex; flex-direction:column; align-items:center; justify-content:center; padding: 60px 0; color: #858796; }

    /* ==================================================================
       MODERN GÖRÜNÜM KATMANI (portalın yeni tasarım dili)
       Yukarıdaki kurallar korunur, buradakiler üzerine yazar.
       ================================================================== */
    body { background-color: var(--bg-main, #f4f6fb); }

    .dash-card {
        background: var(--bg-card, #fff);
        border: 1px solid var(--border-color, #e8ecf4);
        border-radius: var(--r-lg, 18px);
        box-shadow: var(--shadow-sm, 0 2px 6px rgba(0,0,0,.04));
        transition: transform .2s ease, box-shadow .2s ease;
    }
    .dash-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md, 0 8px 20px rgba(0,0,0,.08)); }

    /* KPI kutuları */
    .icon-box {
        width: 46px; height: 46px; border-radius: 14px;
        font-size: 19px; box-shadow: 0 6px 14px rgba(0,0,0,.14);
    }
    .bg-gradient-primary { background: linear-gradient(135deg,#009ef7,#6366f1); }
    .bg-gradient-success { background: linear-gradient(135deg,#10b981,#059669); }
    .bg-gradient-warning { background: linear-gradient(135deg,#f59e0b,#d97706); }
    .bg-gradient-danger  { background: linear-gradient(135deg,#f43f5e,#be123c); }
    .bg-gradient-dark    { background: linear-gradient(135deg,#0f172a,#334155); }
    .bg-gradient-purple  { background: linear-gradient(135deg,#8b5cf6,#6366f1); }
    .bg-gradient-info    { background: linear-gradient(135deg,#06b6d4,#0891b2); }

    /* Hap sekmeler */
    .nav-pills-custom { gap: 8px; }
    .nav-pills-custom .nav-link {
        border: 1px solid var(--border-color, #e8ecf4);
        border-radius: 999px;
        background: var(--bg-card, #fff);
        color: var(--text-secondary, #64748b);
        font-size: .82rem; font-weight: 700;
        padding: .45rem 1.1rem;
    }
    .nav-pills-custom .nav-link:hover {
        background: var(--metro-primary-light, #eef7ff);
        color: var(--metro-primary, #009ef7);
        border-color: color-mix(in srgb, var(--metro-primary, #009ef7) 34%, transparent);
    }
    .nav-pills-custom .nav-link.active {
        background: linear-gradient(135deg,#009ef7,#6366f1);
        color: #fff; border-color: transparent;
        box-shadow: 0 5px 14px rgba(0,158,247,.28);
    }
    /* Sekme üzerindeki sayaç rozetleri */
    .nav-pills-custom .nav-link .badge {
        border-radius: 999px; font-weight: 800; font-size: .62rem;
    }
    .nav-pills-custom .nav-link.active .badge {
        background: rgba(255,255,255,.24) !important; color: #fff !important;
    }

    /* Filtre çubuğu */
    .filter-bar {
        background: var(--bg-card, #fff);
        border: 1px solid var(--border-color, #e8ecf4);
        border-bottom: 1px solid var(--border-color, #e8ecf4);
        border-radius: var(--r-lg, 18px) var(--r-lg, 18px) 0 0;
        padding: 12px 16px;
        display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
    }
    .filter-bar .form-control, .filter-bar .form-select {
        height: 36px; border-radius: 10px; font-size: .82rem;
    }
    .btn-filter, .btn-stok-filter, .btn-fiyat-filter { border-radius: 999px; }
    .btn { border-radius: 10px; font-weight: 600; }

    /* Tablolar */
    .table-custom { font-size: .8rem; }
    .table-custom thead th {
        position: sticky; top: 0; z-index: 2;
        background: var(--bg-subtle, #f8fafc);
        color: var(--text-secondary, #64748b);
        font-size: .66rem; font-weight: 800; letter-spacing: .06em;
        border-bottom: 2px solid var(--border-color, #e8ecf4);
        white-space: nowrap;
    }
    .table-custom td {
        font-size: .8rem;
        color: var(--text-primary, #2b3445);
        border-color: var(--border-color, #eef2f7);
    }
    .table-custom tbody tr { transition: background .12s ease; }
    .table-custom tbody tr:hover { background: var(--metro-primary-light, #eef7ff); }

    .full-page-table {
        max-height: calc(100vh - 300px);
        overflow: auto;
        border-radius: 0 0 var(--r-lg, 18px) var(--r-lg, 18px);
    }
    .full-page-table::-webkit-scrollbar { width: 9px; height: 9px; }
    .full-page-table::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 8px; }

    /* Boş / yükleniyor durumları */
    .initial-load-msg, .loading-overlay { color: var(--text-secondary, #94a3b8); }
    .initial-load-msg i, .loading-overlay i { opacity: .3; }

    /* Rozetler */
    .badge { font-weight: 700; letter-spacing: .01em; }

    [data-theme="dark"] .table-custom thead th { background: #1f2937; }

    /* Alis/Satis: sorunlu satir vurgusu */
    #tbody-alis-satis tr.as-satir[data-sorunlu="1"] { background-color: rgba(244, 63, 94, .10); }
    #tbody-alis-satis tr.as-satir:hover { background-color: var(--metro-primary-light, #eef7ff); }

    /* Stok akis semasi */
    .akis-zincir { font-size: .82rem; line-height: 1.7; }
    .akis-satir { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .akis-kaynak { min-width: 210px; font-weight: 600; color: var(--text-primary, #2b3445); }
    .akis-ok { color: var(--metro-primary, #009ef7); font-weight: 800; letter-spacing: -1px; }
    .akis-hedef { font-weight: 600; color: #0f766e; }
    .akis-not { padding-left: 14px; font-size: .74rem; color: var(--text-secondary, #94a3b8); }
    .akis-dal { color: #f59e0b; margin-right: 4px; }
    .akis-ters { padding-left: 26px; border-left: 2px dashed #cbd5e1; margin-left: 6px; }
</style>

<!-- Tam Sayfa Loader Animasyonu (Sadece POST işlemlerinde) -->
<div id="pageLoader" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(255,255,255,0.7); z-index:9999; text-align:center; padding-top:20%;">
    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Yükleniyor...</span>
    </div>
    <h4 class="mt-2 text-primary fw-bold">İşlem Yapılıyor Lütfen Bekleyin...</h4>
</div>

