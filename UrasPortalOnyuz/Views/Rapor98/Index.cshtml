                             mNedeni.includes("⚠️") ? `<span class="badge bg-warning text-dark shadow-sm px-2 py-1">${mNedeni}</span>` :
                             mNedeni.includes("✏️") ? `<span class="badge bg-info text-dark shadow-sm px-2 py-1">${mNedeni}</span>` :
                             `<span class="badge bg-secondary text-white shadow-sm px-2 py-1">${mNedeni}</span>`;

                html += `<tr>
                    <td class="fw-bold text-success">${m.hedefYevmiyeNo}</td>
                    <td>${m.kaynakYevmiyeNo ? `<span class="badge bg-secondary">${m.kaynakYevmiyeNo}</span>` : `<span class="text-muted">-</span>`}</td>
                    <td>${m.tarih}</td>
                    <td class="small">${m.aciklama}</td>
                    <td><span class="badge bg-dark"><i class="fas fa-user-edit me-1"></i> ${m.ekleyenGuncelleyen}</span></td>
                    <td class="text-end fw-bold">${m.tutar.toLocaleString(undefined, {minimumFractionDigits: 2})}</td>
                    <td>${mBadge}</td>
                </tr>`;
            });
        }
        else if (tab === 'eksik') {
            $('#action-buttons-eksik').show();
            $('#card-eksik').text(data.length.toLocaleString());
            data.forEach(item => {
                let neden = item.neden || '';
                let nClass = 'text-danger';
                let nIcon = 'fa-circle-exclamation';

                if (neden.indexOf('bekliyor') > -1 || neden.indexOf('beklemede') > -1) { nClass = 'text-warning'; nIcon = 'fa-hourglass-half'; }
                else if (neden.indexOf('dönemi kilitli') > -1 || neden.indexOf('askıya') > -1) { nClass = 'text-warning'; nIcon = 'fa-lock'; }
                else if (neden.indexOf('elle kuyruktan') > -1 || neden.indexOf('atlamış') > -1) { nClass = 'text-secondary'; nIcon = 'fa-user-check'; }
                else if (neden.indexOf('Bağ kopmuş') > -1)     { nClass = 'text-dark';   nIcon = 'fa-link-slash'; }
                else if (neden.indexOf('hiç eklenmemiş') > -1) { nClass = 'text-danger'; nIcon = 'fa-ghost'; }

                html += `<tr>
                    <td><input type="checkbox" class="chk-eksik" value="${item.kaynakYevmiyeNo}"></td>
                    <td class="fw-bold" style="color: #6f42c1;">${item.kaynakYevmiyeNo}</td>
                    <td><span class="badge bg-dark">${item.kaynakBelgeNo}</span></td>
                    <td>${item.tarih}</td>
                    <td><span class="badge bg-secondary">${item.belgeTipi}</span></td>
                    <td class="small fw-semibold ${nClass}">
                        ${eksikDurumRozet(item.durumKod)}
                        <i class="fas ${nIcon} me-1"></i>${neden}
                        ${eksikHamHata(item.hamHata, neden)}
                    </td>
                    <td class="small text-muted">${item.aciklama}</td>
                </tr>`;
            });
        }
        else if (tab === 'isaret-degismis') {
            data.forEach(item => {
                let isaret = item.kaynakIsaret
                    ? `<span class="badge ${item.kaynakIsaret === 'X' ? 'bg-danger' : 'bg-secondary'}">${item.kaynakIsaret}</span>`
                    : `<span class="badge bg-dark">yok</span>`;
                html += `<tr>
                    <td class="fw-bold text-dark">${item.hedefYevmiyeNo}</td>
                    <td class="fw-bold text-primary">${item.kaynakYevmiyeNo}</td>
                    <td><span class="badge bg-dark">${item.kaynakBelgeNo}</span></td>
                    <td>${item.tarih}</td>
                    <td><span class="badge bg-secondary">${item.belgeTipi || '-'}</span></td>
                    <td>${isaret}</td>
                    <td class="small fw-semibold text-warning-emphasis"><i class="fas fa-flag me-1"></i>${item.neden}</td>
                    <td class="text-end fw-bold">${(item.tutar || 0).toLocaleString(undefined, {minimumFractionDigits: 2})} ₺</td>
                    <td class="small">${item.hedefOlusturma}</td>
                    <td class="small text-muted">${item.aciklama}</td>
                </tr>`;
            });
        }
        else if (tab === 'kapali-donem') {
            data.forEach(item => {
                let donem = item.donemDurum === 'Y'
                    ? `<span class="badge bg-danger"><i class="fas fa-lock me-1"></i>${item.donemKodu} Kilitli</span>`
                    : `<span class="badge bg-warning text-dark"><i class="fas fa-lock me-1"></i>${item.donemKodu} Kapanış dönemi</span>`;
                let hedef = item.hedefYevmiyeNo
                    ? `<span class="badge bg-success">Hedefte var (${item.hedefYevmiyeNo})</span> <span class="small text-muted">güncellenemez</span>`
                    : `<span class="badge bg-danger">Hedefte yok</span> <span class="small text-danger fw-semibold">dönem açılmadan aktarılamaz</span>`;
                html += `<tr>
                    <td class="fw-bold text-danger">${item.kaynakYevmiyeNo}</td>
                    <td><span class="badge bg-dark">${item.kaynakBelgeNo}</span></td>
                    <td>${item.tarih}</td>
                    <td><span class="badge bg-secondary">${item.belgeTipi}</span></td>
                    <td>${donem}</td>
                    <td class="text-end fw-bold">${(item.tutar || 0).toLocaleString(undefined, {minimumFractionDigits: 2})} ₺</td>
                    <td class="small text-muted">${item.aciklama}</td>
                </tr>`;
            });
        }
        else if (tab === 'iptal') {
            $('#btn-sync-iptal').show();
            $('#card-iptal').text(data.length.toLocaleString());
            data.forEach(item => {
                let kIptal = item.kaynakIptalDurum == 'Y' ? `<span class="badge bg-danger">İptal Edilmiş (Y)</span>` : `<span class="badge bg-success">Aktif</span>`;
                let hIptal = item.hedefIptalDurum == 'Y' ? `<span class="badge bg-danger">İptal Edilmiş (Y)</span>` : 
                             !item.hedefIptalDurum ? `<span class="badge bg-success">Aktif (Boş)</span>` : `<span class="badge bg-secondary">${item.hedefIptalDurum}</span>`;
                
                html += `<tr>
                    <td class="fw-bold text-primary">${item.kaynakYevmiyeNo}</td>
                    <td><span class="badge bg-dark">${item.kaynakBelgeNo}</span></td>
                    <td class="fw-bold text-dark">${item.hedefYevmiyeNo}</td>
                    <td><span class="badge bg-dark">${item.hedefBelgeNo}</span></td>
                    <td>${item.tarih}</td>
                    <td class="small fw-semibold">
                        <div class="text-danger"><i class="fas fa-circle-exclamation me-1"></i>${item.neden || ''}</div>
                        ${iptalEngelMetni(item)}
                    </td>
                    <td class="small text-muted">${item.aciklama}</td>
                    <td class="text-center">${kIptal}</td>
                    <td class="text-center border-start">${hIptal}</td>
                </tr>`;
            });
        }
        else if (tab === 'mukerrer') {
            $('#btn-cancel-mukerrer').show();
            let prevKey = '';
            data.forEach(item => {
                let rowCls = (item.kaynakYevmiyeNo == prevKey) ? "bg-light" : "border-top border-danger border-2"; 
                prevKey = item.kaynakYevmiyeNo;
                
                html += `<tr class="${rowCls}">
                    <td class="fw-bold text-danger">${item.kaynakYevmiyeNo}</td>
                    <td><span class="badge bg-danger px-2 fs-6">${item.hedefYevmiyeNo}</span></td>
                    <td><span class="badge bg-dark">${item.olusanBelgeNo}</span></td>
                    <td>${item.tarih}</td>
                    <td class="small">${item.aciklama}</td>
                    <td class="text-end fw-bold">${item.tutar.toLocaleString(undefined, {minimumFractionDigits: 2})} ₺</td>
                </tr>`;
            });
        }
        else if (tab === 'yoksayilan') {
            $('#btn-unignore').show();
            data.forEach(item => {
                html += `<tr>
                    <td><input type="checkbox" class="chk-yoksay" value="${item.kaynakYevmiyeNo}"></td>
                    <td class="fw-bold text-secondary">${item.kaynakYevmiyeNo}</td>
                    <td><span class="badge bg-dark">${item.kaynakBelgeNo}</span></td>
                    <td>${item.tarih}</td>
                    <td class="small">${item.aciklama}</td>
                    <td class="text-muted"><i class="far fa-clock me-1"></i>${item.eklenmeTarihi}</td>
                </tr>`;
            });
        }
        
        tbody.html(html);
    }

    // =====================================================================
    // TABLO FİLTRELEME İŞLEMLERİ
    // =====================================================================
    function filterTable(status, btnElement) {
        var buttons = document.querySelectorAll('.btn-filter');
        buttons.forEach(b => {
            b.className = 'btn btn-filter ' + (
                b.innerText.includes('Tümü') ? 'btn-outline-dark text-dark' : 
                b.innerText.includes('Hatalar') ? 'btn-outline-danger text-danger' : 
                b.innerText.includes('Kayıplar') ? 'btn-outline-dark text-dark' : 
                b.innerText.includes('Uyarılar') ? 'btn-outline-warning text-dark border-warning' : 'btn-outline-warning text-dark'
            );
        });
        
        if(status === 'all') btnElement.className = 'btn btn-dark btn-filter text-white';
        else if(status === 'E') btnElement.className = 'btn btn-danger btn-filter text-white';
        else if(status === 'M') btnElement.className = 'btn btn-dark btn-filter text-white';
        else if(status === 'W') btnElement.className = 'btn btn-warning btn-filter text-dark border-warning';
        else if(status === 'P') btnElement.className = 'btn btn-warning btn-filter text-dark';

        var rows = document.querySelectorAll('.queue-row');
        rows.forEach(row => {
            if (status === 'all' || row.getAttribute('data-status') === status) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function filterStokTable(tip, btnElement) {
        var buttons = document.querySelectorAll('.btn-stok-filter');
        buttons.forEach(b => {
            b.className = 'btn btn-stok-filter ' + (
                b.innerText.includes('Tümü') ? 'btn-outline-dark text-dark' : 
                b.innerText.includes('Akmayanlar') ? 'btn-outline-danger text-danger' : 
                'btn-outline-warning text-dark border-warning'
            );
        });

        if(tip === 'all') btnElement.className = 'btn btn-dark btn-stok-filter text-white';
        else if(tip === 'AKMAMIS') btnElement.className = 'btn btn-danger btn-stok-filter text-white';
        else if(tip === 'MUKERRER') btnElement.className = 'btn btn-warning btn-stok-filter text-dark border-warning';

        var rows = document.querySelectorAll('.stok-row');
        rows.forEach(row => {
            if (tip === 'all' || row.getAttribute('data-stok-tip') === tip) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function filterFiyatTable(tip, btnElement) {
        var buttons = document.querySelectorAll('.btn-fiyat-filter');
        buttons.forEach(b => {
            b.className = 'btn btn-fiyat-filter ' + (
                b.innerText.includes('Tümü') ? 'btn-outline-dark text-dark' : 
                b.innerText.includes('Akmayanlar') ? 'btn-outline-danger text-danger' : 
                b.innerText.includes('Fiyat') ? 'btn-outline-warning text-dark border-warning' :
                b.innerText.includes('Tutar') ? 'btn-outline-warning text-dark border-warning' :
                'btn-outline-info text-dark border-info'
            );
        });

        if(tip === 'all') btnElement.className = 'btn btn-dark btn-fiyat-filter text-white';
        else if(tip === '❌') btnElement.className = 'btn btn-danger btn-fiyat-filter text-white';
        else if(tip === 'Fiyat' || tip === 'Tutar') btnElement.className = 'btn btn-warning btn-fiyat-filter text-dark border-warning';
        else if(tip === 'Para') btnElement.className = 'btn btn-info btn-fiyat-filter text-white';

        var rows = document.querySelectorAll('.fiyat-row');
        rows.forEach(row => {
            var hataNedeni = row.getAttribute('data-fiyat-tip') || "";
            if (tip === 'all' || hataNedeni.includes(tip)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    // =====================================================================
    // OTOMATİK İŞLEMLER VE AKSİYON BUTONLARI (POST)
    // =====================================================================

    function stokFazlalikIptal() {
        var yil = $('#selectYil').val() || new Date().getFullYear();
        var ay = $('#selectAy').val() || (new Date().getMonth() + 1);
        if(!confirm("Seçili dönem (" + yil + "-" + ay + ") için hedef veritabanındaki fazlalık belgelerin açıklama (U_BE1_FRMADI) alanına otomatik olarak 'İPTAL' yazılacaktır. Onaylıyor musunuz?")) return;
        
        showLoader();
        $.ajax({
            url: '@Url.Action("FazlaliklaraIptalYaz", "Rapor98")?yil=' + yil + '&ay=' + ay,
            type: 'POST',
            success: function(res) {
                alert(res.message);
                if(res.success) { location.reload(); } else { $('#pageLoader').hide(); }
            },
            error: function() { alert('Sunucu hatası!'); $('#pageLoader').hide(); }
        });
    }

    function stokIptalEsitle() {
        var yil = $('#selectYil').val() || new Date().getFullYear();
        var ay = $('#selectAy').val() || (new Date().getMonth() + 1);
        if(!confirm("Seçili dönem (" + yil + "-" + ay + ") için ana sistemde iptal edilmiş ancak hedefte 'İPTAL' yazmayan belgeler otomatik olarak bulunup eşitlenecektir. Onaylıyor musunuz?")) return;
        
        showLoader();
        $.ajax({
            url: '@Url.Action("IptalleriEsitleStok", "Rapor98")?yil=' + yil + '&ay=' + ay,
            type: 'POST',
            success: function(res) {
                alert(res.message);
                if(res.success) { location.reload(); } else { $('#pageLoader').hide(); }
            },
            error: function() { alert('Sunucu hatası!'); $('#pageLoader').hide(); }
        });
    }

    function stokEksikKuyruga() {
        var yil = $('#selectYil').val() || new Date().getFullYear();
        var ay = $('#selectAy').val() || (new Date().getMonth() + 1);
        if(!confirm("Seçili dönem (" + yil + "-" + ay + ") için ana sistemde olan ancak hedefte hiç izi bulunmayan (akmamış) belgeler otomatik olarak tespit edilip robot kuyruğuna eklenecektir. Onaylıyor musunuz?")) return;
        
        showLoader();
        $.ajax({
            url: '@Url.Action("EksikleriKuyrugaItStok", "Rapor98")?yil=' + yil + '&ay=' + ay,
            type: 'POST',
            success: function(res) {
                alert(res.message);
                if(res.success) { location.reload(); } else { $('#pageLoader').hide(); }
            },
            error: function() { alert('Sunucu hatası!'); $('#pageLoader').hide(); }
        });
    }

    function retrySingle(id) {
        var btn = document.getElementById('btn-retry-' + id);
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
        btn.disabled = true;
        $.ajax({
            url: '@Url.Action("TekrarKuyrugaEkle", "Rapor98")', 
            type: 'POST', 
            data: { id: id },
            success: function (res) {
                if (res.success) {
                    var badge = document.getElementById('status-badge-' + id);
                    badge.className = 'badge bg-warning text-dark px-2 py-1';
                    badge.innerHTML = '<i class="fas fa-hourglass-half me-1"></i> Bekliyor';
                    var row = document.getElementById('row-' + id);
                    row.setAttribute('data-status', 'P');
                    btn.remove(); 
                } else {
                    alert(res.message); btn.innerHTML = '<i class="fas fa-redo-alt"></i>'; btn.disabled = false;
                }
            },
            error: function () { alert('Sunucuya ulaşılamadı!'); btn.innerHTML = '<i class="fas fa-redo-alt"></i>'; btn.disabled = false; }
        });
    }

    function retryAllErrors() {
        if (!confirm("Tüm GERÇEK hatalı kayıtları tekrar kuyruğa alıp robotu tetiklemek istediğinize emin misiniz?")) return;
        showLoader();
        $.post('@Url.Action("TumHatalilariKuyrugaEkle", "Rapor98")', function(res){ if(res.success) { alert(res.message); location.reload(); } else { alert("Hata: " + res.message); $('#pageLoader').hide(); } }).fail(function(){ alert('Sunucu hatası!'); $('#pageLoader').hide(); });
    }

    function retryAllMissing() {
        if (!confirm("Karşıya geçmemiş KAYIP (M) kayıtları tekrar kuyruğa alıp robotu tetiklemek istediğinize emin misiniz?")) return;
        showLoader();
        $.post('@Url.Action("TumKayiplariKuyrugaEkle", "Rapor98")', function(res){ if(res.success) { alert(res.message); location.reload(); } else { alert("Hata: " + res.message); $('#pageLoader').hide(); } }).fail(function(){ alert('Sunucu hatası!'); $('#pageLoader').hide(); });
    }

    function forceAddMissing() {
        if (!confirm("Sisteme hiç girmemiş olan EKSİK (Kaçak) kayıtları zorla kuyruğa almak istediğinize emin misiniz?")) return;
        showLoader();
        $.post('@Url.Action("TumEksikleriKuyrugaEkle", "Rapor98")', function(res){ if(res.success) { alert(res.message); location.reload(); } else { alert("Hata: " + res.message); $('#pageLoader').hide(); } }).fail(function(){ alert('Sunucu hatası!'); $('#pageLoader').hide(); });
    }

    function fixBrokenLinks() {
        if (!confirm("Hedefte U_SrcTransId alanı boş kalan kayıtları SQL üzerinden eşleştirip onarmak istediğinize emin misiniz?")) return;
        showLoader();
        $.post('@Url.Action("KopanBaglariLehimle", "Rapor98")', function(res){ if(res.success) { alert(res.message); location.reload(); } else { alert("Hata: " + res.message); $('#pageLoader').hide(); } }).fail(function(){ alert('Sunucu hatası!'); $('#pageLoader').hide(); });
    }
    
    function syncIptalStatus() {
        if (!confirm("Kaynak veritabanındaki iptal durumlarını okuyup hedef veritabanını buna göre güncellemek istediğinize emin misiniz?")) return;
        showLoader();
        $.post('@Url.Action("IptalDurumlariniEsitle", "Rapor98")', function(res){ if(res.success) { alert(res.message); location.reload(); } else { alert("Hata: " + res.message); $('#pageLoader').hide(); } }).fail(function(){ alert('Sunucu hatası!'); $('#pageLoader').hide(); });
    }

    function cancelDuplicates() {
        if (!confirm("Hedef veritabanındaki mükerrer yevmiyelerden sadece ilki bırakılıp diğer kopyaların U_BE1_YEVIPTAL alanına 'Y' yazılacaktır. Onaylıyor musunuz?")) return;
        showLoader();
        $.post('@Url.Action("FazlaliklariIptalEt", "Rapor98")', function(res){ if(res.success) { alert(res.message); location.reload(); } else { alert("Hata: " + res.message); $('#pageLoader').hide(); } }).fail(function(){ alert('Sunucu hatası!'); $('#pageLoader').hide(); });
    }

    function getSelectedEksikler() { return $('.chk-eksik:checked').map(function() { return this.value; }).get(); }

    function yoksaySecilenEksikler() {
        var ids = getSelectedEksikler();
        if (ids.length === 0) return alert("Lütfen yoksaymak için en az bir kayıt seçin!");
        if (!confirm(ids.length + " adet kaydı yoksaymak istediğinize emin misiniz? Bu kayıtlar artık hiçbir raporda görünmeyecek.")) return;

        showLoader();
        $.ajax({
            url: '@Url.Action("SecilenleriYoksay", "Rapor98")', type: 'POST', contentType: 'application/json', data: JSON.stringify(ids),
            success: function (res) { if(res.success) { alert(res.message); location.reload(); } else { alert("Hata: " + res.message); $('#pageLoader').hide(); } },
            error: function () { alert('Sunucu hatası!'); $('#pageLoader').hide(); }
        });
    }

    function kuyrugaItSecilenEksikler() {
        var ids = getSelectedEksikler();
        if (ids.length === 0) return alert("Lütfen kuyruğa itmek için en az bir kayıt seçin!");
        if (!confirm(ids.length + " adet kaydı kuyruğa itmek istediğinize emin misiniz?")) return;

        showLoader();
        $.ajax({
            url: '@Url.Action("SecilenEksikleriKuyrugaEkle", "Rapor98")', type: 'POST', contentType: 'application/json', data: JSON.stringify(ids),
            success: function (res) { if(res.success) { alert(res.message); location.reload(); } else { alert("Hata: " + res.message); $('#pageLoader').hide(); } },
            error: function () { alert('Sunucu hatası!'); $('#pageLoader').hide(); }
        });
    }

    function getSelectedYoksayilanlar() { return $('.chk-yoksay:checked').map(function() { return this.value; }).get(); }

    function yoksaymaktanCikar() {
        var ids = getSelectedYoksayilanlar();
        if (ids.length === 0) return alert("Lütfen geri almak (aktifleştirmek) için en az bir kayıt seçin!");
        if (!confirm(ids.length + " adet kaydı yoksayılanlar listesinden çıkarmak istediğinize emin misiniz?")) return;

        showLoader();
        $.ajax({
            url: '@Url.Action("YoksaymaktanCikar", "Rapor98")', type: 'POST', contentType: 'application/json', data: JSON.stringify(ids),
            success: function (res) { if(res.success) { alert(res.message); location.reload(); } else { alert("Hata: " + res.message); $('#pageLoader').hide(); } },
            error: function () { alert('Sunucu hatası!'); $('#pageLoader').hide(); }
        });
    }
