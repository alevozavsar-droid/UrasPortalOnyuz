<div class="modal fade" id="bankModal" tabindex="-1" aria-labelledby="bankModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold" id="bankModalLabel"><i class="fas fa-university text-primary me-2"></i>Banka Hesabı Bilgileri</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="bankModalIndex" />
        
        <div class="row mb-2">
            <div class="col-md-3"><label class="form-label mt-2">Ülke</label></div>
            <div class="col-md-9">
                <select class="form-select select2-init" id="bank_Country" style="width: 100%;"></select>
            </div>
        </div>
        
        <div class="row mb-2">
            <div class="col-md-3"><label class="form-label mt-2 text-primary">Banka Kodu</label></div>
            <div class="col-md-9">
                <select class="form-select" id="bank_BankCode" style="width: 100%;">
                    <option value="">Önce Ülke Seçiniz...</option>
                </select>
            </div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3"><label class="form-label mt-2">Hesap No</label></div>
            <div class="col-md-9"><input type="text" class="form-control" id="bank_AccountNo"></div>
        </div>
        <div class="row mb-2">
            <div class="col-md-3"><label class="form-label mt-2">Hesap Adı</label></div>
            <div class="col-md-9"><input type="text" class="form-control" id="bank_AccountName"></div>
        </div>
        <div class="row mb-2">
            <div class="col-md-3"><label class="form-label mt-2">Şube</label></div>
            <div class="col-md-9"><input type="text" class="form-control" id="bank_Branch"></div>
        </div>
        <div class="row mb-2">
            <div class="col-md-3"><label class="form-label mt-2">IBAN</label></div>
            <div class="col-md-9"><input type="text" class="form-control fw-bold border-success" id="bank_IBAN"></div>
        </div>
        <div class="row mb-2">
            <div class="col-md-3"><label class="form-label mt-2">BIC/SWIFT</label></div>
            <div class="col-md-9"><input type="text" class="form-control" id="bank_BICSwiftCode"></div>
        </div>
      </div>
      <div class="modal-footer bg-light border-top-0">
        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">İptal</button>
        <button type="button" class="btn btn-primary px-4 fw-bold" id="btnSaveBank">Listeye Ekle / Güncelle</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    <script>
        let isNewMode = false;
        let currentAddresses = [];
        let addressesModified = false;
        let currentBanks = [];
        
        window.addNewAddress = function(type) {
            let addrName = prompt("Yeni adres için benzersiz bir ad girin (Örn: Merkez, Depo):");
            if(addrName) {
                addressesModified = true;
                currentAddresses.push({
                    lineNum: null, 
                    addressName: addrName, 
                    addressType: type, 
                    street: '', 
                    block: '', 
                    zipCode: '', 
                    city: '', 
                    county: '', 
                    country: 'TR', 
                    state: ''
                });
                renderAddressLists();
                $(`.list-group-item-action[data-idx="${currentAddresses.length - 1}"]`).click();
            }
        };

        function renderAddressLists() {
            $('#listFatura, #listSevkiyat').empty();
            currentAddresses.forEach((a, index) => {
                let icon = a.addressType === 'B' ? 'fa-file-invoice' : 'fa-truck';
                let li = `<li class="list-group-item list-group-item-action cursor-pointer" data-idx="${index}">
                            <i class="fas ${icon} me-2 opacity-50"></i>${a.addressName}
                          </li>`;
                if(a.addressType === 'B') $('#listFatura').append(li);
                else $('#listSevkiyat').append(li);
            });
        }

        function syncCurrentAddressForm() {
            let idx = $('#det_AddrIndex').val();
            if ($('#addressFormCard').is(':visible') && idx !== "") {
                addressesModified = true;
                currentAddresses[idx].addressName = $('#det_AddrName').val();
                currentAddresses[idx].street = $('#det_Street').val();
                currentAddresses[idx].block = $('#det_Block').val();
                currentAddresses[idx].zipCode = $('#det_Zip').val();
                currentAddresses[idx].county = $('#det_County').val();
                currentAddresses[idx].country = $('#det_Country').val();
                currentAddresses[idx].state = $('#det_State').val(); 
                currentAddresses[idx].city = $('#det_State option:selected').text();
                return true;
            }
            return false;
        }

        window.openBankModal = function(idx = "") {
            $('#bankModalIndex').val(idx);
            
            if(idx === "") {
                $('#bank_AccountNo, #bank_AccountName, #bank_Branch, #bank_IBAN, #bank_BICSwiftCode').val('');
                $('#bank_BankCode').data('target-val', ''); // Hedef bankayı temizle
                $('#bank_Country').val('TR').trigger('change'); 
            } else {
                let b = currentBanks[idx];
                $('#bank_AccountNo').val(b.accountNo);
                $('#bank_AccountName').val(b.accountName);
                $('#bank_Branch').val(b.branch);
                $('#bank_IBAN').val(b.iban);
                $('#bank_BICSwiftCode').val(b.bicSwiftCode);
                
                // Seçili banka kodunu değişkende tut, AJAX bitince seçecek
                $('#bank_BankCode').data('target-val', b.bankCode);
                $('#bank_Country').val(b.country).trigger('change'); 
            }
            $('#bankModal').modal('show');
        }

        $('#btnSaveBank').on('click', function() {
            let idx = $('#bankModalIndex').val();
            let b = {
                bankCode: $('#bank_BankCode').val(),
                country: $('#bank_Country').val(),
                accountNo: $('#bank_AccountNo').val(),
                accountName: $('#bank_AccountName').val(),
                branch: $('#bank_Branch').val(),
                iban: $('#bank_IBAN').val(),
                bicSwiftCode: $('#bank_BICSwiftCode').val()
            };

            if (!b.bankCode) { toastr.warning("Banka kodu seçmelisiniz!"); return; }

            if(idx === "") { currentBanks.push(b); } 
            else { currentBanks[idx] = b; }

            renderBankList();
            $('#bankModal').modal('hide');
        });

        function renderBankList() {
            $('#listBanks').empty();
            currentBanks.forEach((b, i) => {
                $('#listBanks').append(`
                    <tr>
                        <td>${b.bankCode}</td>
                        <td>${b.country}</td>
                        <td>${b.accountNo}</td>
                        <td>${b.accountName}</td>
                        <td>${b.branch}</td>
                        <td class="fw-bold">${b.iban}</td>
                        <td>${b.bicSwiftCode}</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-1 me-1" onclick="openBankModal(${i})"><i class="fas fa-edit"></i></button>
                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" onclick="removeBank(${i})"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                `);
            });
        }

        $(document).ready(function() {
            toastr.options = { "closeButton": true, "progressBar": true, "positionClass": "toast-bottom-right", "timeOut": "4000" };
            
            // Tüm select2'ler init ediliyor
            $('.select2-init').select2({ theme: 'bootstrap-5', width: '100%' });
            
            // Banka Kodu Select2 (Modal içinde doğru çalışması için dropdownParent ataması)
            $('#bank_BankCode').select2({
                theme: 'bootstrap-5', 
                width: '100%',
                dropdownParent: $('#bankModal')
            });

            $.get('/Rapor97/GetCountries', function(res) {
                $('#det_Country, #bank_Country').empty().append('<option value="">Seçiniz...</option>');
                res.forEach(c => { 
                    let opt = `<option value="${c.code}">${c.name}</option>`;
                    $('#det_Country').append(opt); 
                    $('#bank_Country').append(opt);
                });
            });

            // Adres Ülke Değişimi
            $('#det_Country').on('change', function() {
                const cCode = $(this).val();
                $('#det_State').empty().append('<option value="">Yükleniyor...</option>');
                if(cCode) {
                    $.get('/Rapor97/GetStates?countryCode=' + cCode, function(res) {
                        $('#det_State').empty().append('<option value="">İl Seçiniz...</option>');
                        res.forEach(s => { $('#det_State').append(`<option value="${s.code}">${s.name}</option>`); });
                        let activeIdx = $('#det_AddrIndex').val();
                        if(activeIdx !== "") {
                            let savedState = currentAddresses[activeIdx].state;
                            if(savedState) { $('#det_State').val(savedState).trigger('change.select2'); }
                        }
                    });
                }
            });

            // YENİ: Banka Modalındaki Ülke Değişimi (İlgili ülkenin bankalarını getirir)
            $('#bank_Country').on('change', function() {
                const cCode = $(this).val();
                $('#bank_BankCode').empty().append('<option value="">Yükleniyor...</option>');
                
                if(cCode) {
                    $.get('/Rapor97/GetBanks?countryCode=' + cCode, function(res) {
                        $('#bank_BankCode').empty().append('<option value="">Banka Seçiniz...</option>');
                        
                        if(Array.isArray(res)) {
                            res.forEach(b => { 
                                // SWIFT kodunu option'un data attribute'una koyuyoruz ki seçilince otomatik dolsun
                                let opt = `<option value="${b.code}" data-swift="${b.swift}">${b.code} - ${b.name}</option>`;
                                $('#bank_BankCode').append(opt); 
                            });
                        } else if(res.error) {
                            toastr.error("Banka listesi alınamadı: " + res.error);
                        }
                        
                        // Edit modundaysak hedef bankayı seç
                        let targetVal = $('#bank_BankCode').data('target-val');
                        if(targetVal) {
                            $('#bank_BankCode').val(targetVal).trigger('change.select2');
                            $('#bank_BankCode').data('target-val', ''); // Temizle
                        }
                    }).fail(function() {
                        toastr.error("Banka listesi çekilirken sunucu hatası oluştu.");
                    });
                } else {
                    $('#bank_BankCode').empty().append('<option value="">Önce Ülke Seçiniz...</option>');
                }
            });

            // YENİ: Banka Seçildiğinde SWIFT (BIC) kutusunu otomatik doldurma
            $('#bank_BankCode').on('change', function() {
                let selectedOption = $(this).find('option:selected');
                let swift = selectedOption.data('swift');
                
                // Eğer bankanın swift kodu varsa ve kutu boşsa otomatik doldur
                if(swift && $('#bank_BICSwiftCode').val() === '') {
                    $('#bank_BICSwiftCode').val(swift);
                }
            });

            $('#bpTab .nav-link').on('click', function (e) {
                e.preventDefault(); 
                $('#bpTab .nav-link').removeClass('active');
                $(this).addClass('active');
                var target = $(this).attr('href') || $(this).attr('data-bs-target');
                $('.tab-content .tab-pane').removeClass('show active');
                $(target).addClass('show active');
            });

            function clearForm() {
                $('input[type="text"]:not(#form_Balance, #form_DNotesBal, #form_OrdersBal, #form_OprCount, #form_CardCode), input[type="number"], input[type="email"], input[type="password"], input[type="date"], textarea').val('');
                $('#form_Balance, #form_DNotesBal, #form_OrdersBal').val('0,00');
                $('#form_OprCount').text('0');
                $('input[type="checkbox"]').prop('checked', false);
                $('#rdoEtkin').prop('checked', true);
                $('#rdoFatherP').prop('checked', true);
                $('#form_DebPayAcct').val('').trigger('change.select2');
                $('#form_CardCode').prop('readonly', false);
                currentAddresses = [];
                currentBanks = []; 
                addressesModified = false;
                renderAddressLists();
                renderBankList();
                $('#addressFormCard').hide();
                $('#addressEmptyMsg').show();
            }

            $('#btnNewBP').on('click', function() {
                const type = $('#newBpType').val(); 
                
                $.get('/Rapor97/GetBPCodePrefixes?cardType=' + type, function(res) {
                    if (res.success) {
                        $('#modalPrefixSelect').empty(); 
                        res.prefixes.forEach(p => { $('#modalPrefixSelect').append(new Option(p, p, false, false)); });
                        $('#modalPrefixSelect').select2({
                            theme: 'bootstrap-5', tags: true, dropdownParent: $('#prefixModal'), placeholder: "Seçiniz veya yeni yazınız...", allowClear: true
                        });
                        $('#prefixModal').modal('show');
                    } else { toastr.error("Önek listesi sunucudan alınamadı."); }
                }).fail(function() { toastr.error("Sunucuya bağlanılamadı."); });
            });

            // ---- MUTABAKAT HESABI OTOMATIK ACMA (Talep 30) -------------------
            //
            // Kullanici ust hesabi seciyor (120.01, 336.01 ...), sistem o ustun
            // altindaki sıradaki kirilimi Service Layer ile aciyor, mutabakat
            // hesabi tikini isaretliyor ve kodu bu forma dolduruyor.

            function mhSiradakiKod(ust, sonKod) {
                if (!sonKod) return ust + '.0001';
                var i = sonKod.lastIndexOf('.');
                var kuyruk = i < 0 ? sonKod : sonKod.substring(i + 1);
                if (!/^\d+$/.test(kuyruk)) return ust + '.0001';
                var yeni = String(parseInt(kuyruk, 10) + 1);
                while (yeni.length < kuyruk.length) yeni = '0' + yeni;
                return ust + '.' + yeni;
            }

            function mhOnizlemeyiTazele() {
                var s = $('#mhUst').find('option:selected');
                var ust = s.val();
                if (!ust) { $('#mhOnizleme').addClass('d-none'); return; }
                $('#mhKod').text(mhSiradakiKod(ust, s.data('son') || ''));
                $('#mhOnizleme').removeClass('d-none');
            }

            $('#btnYeniMutabakat').on('click', function () {
                var tip = $('#newBpType').val() || 'C';

                $('#mhAd').val($('#form_CardName').val() || '');
                $('#mhOnizleme').addClass('d-none');
                $('#mhUst').empty();

                $.get('/Rapor97/UstHesaplar?cardType=' + tip, function (res) {
                    if (!res.success) { toastr.error(res.message || 'Üst hesap listesi alınamadı.'); return; }
                    if (!res.liste || res.liste.length === 0) {
                        toastr.warning('Bu şirkette uygun üst hesap bulunamadı.'); return;
                    }

                    res.liste.forEach(function (h) {
                        var o = new Option(h.kod + ' - ' + h.ad, h.kod, false, false);
                        $(o).data('son', h.sonKod || '');
                        $('#mhUst').append(o);
                    });

                    $('#mhUst').select2({
                        theme: 'bootstrap-5', dropdownParent: $('#mutabakatModal'),
                        placeholder: 'Üst hesap seçiniz...'
                    });
                    $('#mhUst').off('change.mh').on('change.mh', mhOnizlemeyiTazele);

                    mhOnizlemeyiTazele();
                    $('#mutabakatModal').modal('show');
                }).fail(function () { toastr.error('Sunucuya bağlanılamadı.'); });
            });

            $('#btnMutabakatOlustur').on('click', function () {
                var ust = $('#mhUst').val();
                var ad = ($('#mhAd').val() || '').trim();

                if (!ust) { toastr.warning('Lütfen bir üst hesap seçin.'); return; }
                if (!ad) { toastr.warning('Hesap adı boş olamaz.'); return; }

                var dugme = $(this);
                dugme.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Açılıyor...');

                $.ajax({
                    url: '/Rapor97/MutabakatHesabiAc',
                    type: 'POST', contentType: 'application/json',
                    data: JSON.stringify({ UstHesap: ust, Ad: ad }),
                    success: function (res) {
                        if (!res.success) { toastr.error(res.message || 'Hesap açılamadı.'); return; }

                        // Yeni hesabi listeye ekleyip forma sec
                        if ($('#form_DebPayAcct').find("option[value='" + res.kod + "']").length === 0) {
                            $('#form_DebPayAcct').append(new Option(res.etiket, res.kod, false, false));
                        }
                        $('#form_DebPayAcct').val(res.kod).trigger('change.select2');

                        $('#mutabakatModal').modal('hide');
                        toastr.success(res.message, "", { timeOut: 9000 });

                        // Hesap acmak cariyi KAYDETMEZ. Kullanici burada durup
                        // "kayit tamam" sanmasin diye kaydet dugmesini one cikariyoruz.
                        var $kaydet = $('#btnUpdateBP');
                        $kaydet[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
                        $kaydet.addClass('border border-3 border-warning');
                        setTimeout(function () { $kaydet.removeClass('border border-3 border-warning'); }, 6000);
                    },
                    error: function (x) { toastr.error('Sunucu hatası: ' + (x.responseText || x.statusText)); },
                    complete: function () {
                        dugme.prop('disabled', false).html('<i class="fas fa-check me-1"></i>Oluştur');
                    }
                });
            });

            $('#btnConfirmPrefix').on('click', function() {
                let selectedPrefix = $('#modalPrefixSelect').val();
                if (selectedPrefix && selectedPrefix.trim() !== "") {
                    selectedPrefix = selectedPrefix.trim().toUpperCase(); 
                    const type = $('#newBpType').val();
                    isNewMode = true;
                    $('#bpSelect').val(null).trigger('change.select2');
                    clearForm();
                    $('#form_CardCode').val("Hesaplanıyor...").prop('readonly', true);
                    $('#prefixModal').modal('hide'); 
                    
                    $.get('/Rapor97/GetNextBPCode?prefix=' + encodeURIComponent(selectedPrefix) + '&cardType=' + type, function(res2) {
                        if(res2.success) { $('#form_CardCode').val(res2.code); } 
                        else { toastr.error("Kod hesaplanırken bir hata oluştu!"); $('#form_CardCode').val(""); }
                    });
                    
                    $('#btnUpdateBP').removeClass('btn-primary').addClass('btn-success').html('<i class="fas fa-check-circle me-2"></i>Yeni Olarak Kaydet');
                    $('#bpTab .nav-link').first().trigger('click');
                    $('#yeniKayitUyarisi').removeClass('d-none');

                    toastr.info(
                        "Yeni kayıt moduna geçildi, cari kodu ayrıldı. Cari HENÜZ oluşmadı - " +
                        "bilgileri doldurup <b>Yeni Olarak Kaydet</b> düğmesine basın.",
                        "", { timeOut: 10000, enableHtml: true });
                } else { toastr.warning("Lütfen bir önek seçin veya yazın!"); }
            });

            $('#bpSelect').on('change', function() {
                const cardCode = $(this).val();
                if (!cardCode) return;
                isNewMode = false;
                addressesModified = false;
                $('#form_CardCode').prop('readonly', true);
                $('#btnUpdateBP').removeClass('btn-success').addClass('btn-primary').html('<i class="fas fa-cloud-upload-alt me-2"></i>SAP\'ye Güncelle');
                
                $.get('/Rapor97/GetBPDetails', { cardCode: cardCode }).done(function(res) {
                    if (res.success) {
                        const d = res.data;
                        $('#form_CardCode').val(d.cardCode); $('#form_CardName').val(d.cardName); $('#form_CardFName').val(d.cardFName);
                        $('#form_GroupCode').val(d.groupCode); $('#form_Currency').val(d.currency); $('#form_LicTradNum').val(d.licTradNum);
                        $('#form_Balance').val(d.balance.toLocaleString('tr-TR', { minimumFractionDigits: 2 }));
                        $('#form_DNotesBal').val(d.dNotesBal.toLocaleString('tr-TR', { minimumFractionDigits: 2 }));
                        $('#form_OrdersBal').val(d.ordersBal.toLocaleString('tr-TR', { minimumFractionDigits: 2 }));
                        $('#form_OprCount').text(d.oprCount); $('#form_Phone1').val(d.phone1); $('#form_Phone2').val(d.phone2);
                        $('#form_Cellular').val(d.cellular); $('#form_Fax').val(d.fax); $('#form_Email').val(d.email);
                        $('#form_IntrntSite').val(d.intrntSite); $('#form_ShipType').val(d.shipType); $('#form_Password').val(d.password);
                        $('#form_Indicator').val(d.indicator); $('#form_ProjectCod').val(d.projectCod); $('#form_CmpPrivate').val(d.cmpPrivate);
                        $('#form_AliasName').val(d.aliasName); $('#form_CntctPrsn').val(d.cntctPrsn); $('#form_AddID').val(d.addID);
                        $('#form_VatIdUnCmp').val(d.vatIdUnCmp); $('#form_Notes').val(d.notes); $('#form_SlpCode').val(d.slpCode);
                        $('#form_AgentCode').val(d.agentCode); $('#form_ChannlBP').val(d.channlBP); $('#form_DfTcnician').val(d.dfTcnician);
                        $('#form_Territory').val(d.territory); $('#form_LangCode').val(d.langCode); $('#form_GlblLocNum').val(d.glblLocNum);
                        
                        $('#form_BlockComm').prop('checked', d.blockComm === 'Y');
                        if(d.validFor === 'Y') $('#rdoEtkin').prop('checked', true); else $('#rdoEtkinDegil').prop('checked', true);
                        $('#form_ValidFrom').val(d.validFrom); $('#form_ValidTo').val(d.validTo);
                        $('#form_FrozenFrom').val(d.frozenFrom); $('#form_FrozenTo').val(d.frozenTo);
                        $('#form_GroupNum').val(d.groupNum); $('#form_IntrstRate').val(d.intrstRate); $('#form_ListNum').val(d.listNum);
                        $('#form_Discount').val(d.discount); $('#form_CreditLine').val(d.creditLine); $('#form_DebtLine').val(d.debtLine);
                        $('#form_DunTerm').val(d.dunTerm); 

                        currentBanks = d.bpBankAccounts || [];
                        renderBankList();

                        $('#form_CreditCard').val(d.creditCard); $('#form_CrCardNum').val(d.crCardNum);
                        $('#form_CardValid').val(d.cardValid); $('#form_OwnerIdNum').val(d.ownerIdNum); $('#form_AvrageLate').val(d.avrageLate);
                        $('#form_PartDelivr').prop('checked', d.partDelivr === 'Y');
                        $('#form_FatherCard').val(d.fatherCard); 
                        if(d.fatherType === 'P') $('#rdoFatherP').prop('checked', true); else $('#rdoFatherD').prop('checked', true);
                        if(d.debPayAcct) { $('#form_DebPayAcct').val(d.debPayAcct).trigger('change.select2'); } else { $('#form_DebPayAcct').val('').trigger('change.select2'); }
                        $('#form_DpmClear').val(d.dpmClear); $('#form_DpmIntAct').val(d.dpmIntAct); $('#form_BlockDunn').prop('checked', d.blockDunn === 'Y');
                        $('#form_DunnLevel').val(d.dunnLevel); $('#form_DunnDate').val(d.dunnDate); $('#form_PlngGroup').val(d.plngGroup);
                        $('#form_Affiliate').prop('checked', d.affiliate === 'Y');
                        
                        currentAddresses = d.addresses || [];
                        renderAddressLists();
                        $('#addressFormCard').hide();
                        $('#addressEmptyMsg').show();
                    }
                });
            });

            $(document).on('click', '.list-group-item-action', function() {
                syncCurrentAddressForm();
                $('.list-group-item-action').removeClass('active');
                $(this).addClass('active');
                let idx = $(this).data('idx');
                let a = currentAddresses[idx];
                $('#addressEmptyMsg').hide();
                $('#addressFormCard').show();
                $('#det_AddrIndex').val(idx); $('#det_AddrType').val(a.addressType); $('#det_AddrName').val(a.addressName);
                $('#det_Street').val(a.street); $('#det_Block').val(a.block); $('#det_Zip').val(a.zipCode); $('#det_County').val(a.county);
                let c = a.country || 'TR';
                $('#det_Country').val(c).trigger('change');
            });

            $('#btnUpdateBP').on('click', function() {
                if (!$('#form_CardCode').val()) { toastr.warning("Lütfen işlem yapılacak cari kodu giriniz."); return; }

                syncCurrentAddressForm();

                const payload = {
                    IsNew: isNewMode,
                    CardType: $('#newBpType').val() || 'C',
                    AddressesModified: addressesModified,
                    CardCode: $('#form_CardCode').val(), CardName: $('#form_CardName').val(), CardFName: $('#form_CardFName').val(),
                    GroupCode: parseInt($('#form_GroupCode').val() || -1), Currency: $('#form_Currency').val(), LicTradNum: $('#form_LicTradNum').val(),
                    Phone1: $('#form_Phone1').val(), Phone2: $('#form_Phone2').val(), Cellular: $('#form_Cellular').val(),
                    Fax: $('#form_Fax').val(), Email: $('#form_Email').val(), IntrntSite: $('#form_IntrntSite').val(),
                    ShipType: parseInt($('#form_ShipType').val() || 0), Password: $('#form_Password').val(), Indicator: $('#form_Indicator').val(),
                    ProjectCod: $('#form_ProjectCod').val(), CmpPrivate: parseInt($('#form_CmpPrivate').val() || 1), AliasName: $('#form_AliasName').val(),
                    CntctPrsn: $('#form_CntctPrsn').val(), AddID: $('#form_AddID').val(), VatIdUnCmp: $('#form_VatIdUnCmp').val(), Notes: $('#form_Notes').val(),
                    SlpCode: parseInt($('#form_SlpCode').val() || -1), AgentCode: $('#form_AgentCode').val(), ChannlBP: $('#form_ChannlBP').val(),
                    DfTcnician: parseInt($('#form_DfTcnician').val() || 0), Territory: parseInt($('#form_Territory').val() || 0), LangCode: parseInt($('#form_LangCode').val() || 0),
                    GlblLocNum: $('#form_GlblLocNum').val(), BlockComm: $('#form_BlockComm').is(':checked') ? 'Y' : 'N',
                    ValidFor: $('#rdoEtkin').is(':checked') ? 'Y' : 'N', ValidFrom: $('#form_ValidFrom').val(), ValidTo: $('#form_ValidTo').val(),
                    FrozenFor: $('#rdoEtkinDegil').is(':checked') ? 'Y' : 'N', FrozenFrom: $('#form_FrozenFrom').val(), FrozenTo: $('#form_FrozenTo').val(),
                    GroupNum: parseInt($('#form_GroupNum').val() || -1), IntrstRate: parseFloat($('#form_IntrstRate').val() || 0), ListNum: parseInt($('#form_ListNum').val() || 0),
                    Discount: parseFloat($('#form_Discount').val() || 0), CreditLine: parseFloat($('#form_CreditLine').val() || 0), DebtLine: parseFloat($('#form_DebtLine').val() || 0),
                    DunTerm: $('#form_DunTerm').val(), BPBankAccounts: currentBanks, CreditCard: $('#form_CreditCard').val(), CrCardNum: $('#form_CrCardNum').val(),
                    CardValid: $('#form_CardValid').val(), OwnerIdNum: $('#form_OwnerIdNum').val(), AvrageLate: parseInt($('#form_AvrageLate').val() || 0),
                    PartDelivr: $('#form_PartDelivr').is(':checked') ? 'Y' : 'N', FatherCard: $('#form_FatherCard').val(), FatherType: $('#rdoFatherP').is(':checked') ? 'P' : 'D',
                    DebPayAcct: $('#form_DebPayAcct').val(), DpmClear: $('#form_DpmClear').val(), DpmIntAct: $('#form_DpmIntAct').val(),
                    BlockDunn: $('#form_BlockDunn').is(':checked') ? 'Y' : 'N', DunnLevel: parseInt($('#form_DunnLevel').val() || 0), DunnDate: $('#form_DunnDate').val(),
                    PlngGroup: $('#form_PlngGroup').val(), Affiliate: $('#form_Affiliate').is(':checked') ? 'Y' : 'N', Addresses: currentAddresses
                };

                const $btn = $(this);
                const originalText = $btn.html();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>İşlem Yapılıyor...');

                $.ajax({
                    url: '/Rapor97/UpdateBP',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(res) {
                        if(res.success) {
                            $('#yeniKayitUyarisi').addClass('d-none');
                            toastr.success(res.message);
                            if(isNewMode) { setTimeout(() => location.reload(), 1500); }
                            else { addressesModified = false; renderAddressLists(); }
                        } else { toastr.error("SAP Kayıt Hatası: " + res.message, "", {timeOut: 6000}); }
                    },
                    error: function(xhr) {
                        // Sunucudan gelen govdeyi de goster: sessiz basarisizlik olmasin.
                        var ayrinti = (xhr.responseText || '').substring(0, 500) || xhr.statusText;
                        toastr.error("Sunucu Hatası (" + xhr.status + "): " + ayrinti, "", { timeOut: 12000 });
                        console.error('UpdateBP hatası', xhr.status, xhr.responseText);
                    },
                    complete: function() { $btn.prop('disabled', false).html(originalText); }
                });
            });
        });
    </script>
}