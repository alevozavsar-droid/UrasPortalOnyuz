@{
    ViewData["Title"] = "Muhatap Ana Verileri Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var customers = ViewBag.Customers as List<WebApplication3.Controllers.Rapor97Controller.CustomerModel> ?? new List<WebApplication3.Controllers.Rapor97Controller.CustomerModel>();
    var groups = ViewBag.Groups as List<WebApplication3.Controllers.Rapor97Controller.LookupModel> ?? new List<WebApplication3.Controllers.Rapor97Controller.LookupModel>();
    var salesPersons = ViewBag.SalesPersons as List<WebApplication3.Controllers.Rapor97Controller.LookupModel> ?? new List<WebApplication3.Controllers.Rapor97Controller.LookupModel>();
    var paymentTerms = ViewBag.PaymentTerms as List<WebApplication3.Controllers.Rapor97Controller.LookupModel> ?? new List<WebApplication3.Controllers.Rapor97Controller.LookupModel>();
    
    var controlAccounts = ViewBag.ControlAccounts as List<WebApplication3.Controllers.Rapor97Controller.LookupModel> ?? new List<WebApplication3.Controllers.Rapor97Controller.LookupModel>();
    var errorMessage = ViewBag.ErrorMessage as string;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    
    <style>
        body { background-color: var(--bg-main, #f4f7f6); font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; font-size: 0.85rem; color: #2c3e50; }
        .bp-card { background: var(--bg-card, #ffffff); border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); margin-bottom: 25px; overflow: hidden; border: 1px solid var(--border-color, #e9ecef); }
        .header-bg { background: linear-gradient(90deg, #f39c12, #e67e22); height: 6px; width: 100%; }
        .header-section { padding: 25px; background: var(--bg-subtle, #fafbfc); border-bottom: 1px solid var(--border-color, #edf2f7); }
        .bal-field { text-align: right; font-weight: 700; background: var(--bg-card, #fff) !important; color: #e74c3c; font-size: 1.1rem; }
        .form-label { font-weight: 600; color: var(--text-secondary, #5c6a77); margin-bottom: 4px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; }
        .form-control, .form-select { border-radius: 6px; padding: 6px 12px; font-size: 0.85rem; border: 1px solid var(--border-color, #cfd9e0); transition: all 0.2s ease-in-out; background-color: var(--bg-subtle, #fbfcfd); }
        .form-control:focus, .form-select:focus { border-color: #f39c12; box-shadow: 0 0 0 3px rgba(243, 156, 18, 0.15); background-color: var(--bg-card, #fff); }
        .form-control[readonly] { background-color: #eef2f5; color: #6c7a89; cursor: not-allowed; }
        .nav-tabs { border-bottom: 2px solid var(--border-color, #edf2f7); padding: 0 20px; background: var(--bg-card, #fff); }
        .nav-tabs .nav-link { color: #7f8c8d; font-weight: 600; padding: 12px 20px; border: none; border-bottom: 3px solid transparent; margin-bottom: -2px; transition: all 0.3s; }
        .nav-tabs .nav-link:hover { color: #f39c12; }
        .nav-tabs .nav-link.active { color: #2c3e50; border-bottom: 3px solid #f39c12; background: transparent; }
        .tab-content { padding: 25px; background: var(--bg-card, #fff); }
        .address-list { border-radius: 8px; overflow: hidden; border: 1px solid var(--border-color, #edf2f7); }
        .list-group-item.active { background-color: #f39c12; border-color: #f39c12; color: #fff !important; }
        .list-group-item { border-left: none; border-right: none; transition: background 0.2s; cursor: pointer; }
        .list-group-item:hover:not(.active) { background-color: #fdf3e5; }
        .row-compact > [class^="col-"] { padding-right: 15px; padding-left: 15px; margin-bottom: 12px; }
        hr { border-color: #edf2f7; margin: 20px 0; }
        .select2-container--bootstrap-5 .select2-dropdown { z-index: 1060; }
    </style>
}

<div class="container-fluid px-4 py-4">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow-sm border-0 mb-3 rounded-3">
            <i class="fas fa-exclamation-triangle me-2"></i><strong>Hata:</strong> @errorMessage
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="w-50 shadow-sm rounded-3">
            <select id="bpSelect" class="form-select select2-init">
                <option value="">-- Müşteri / Satıcı Ara ve Seç --</option>
                @foreach (var c in customers)
                {
                    <option value="@c.CardCode">@c.CardCode - @c.CardName</option>
                }
            </select>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <select id="newBpType" class="form-select border-success text-success fw-bold" style="width: auto;">
                <option value="C">Yeni Müşteri Aç</option>
                <option value="S">Yeni Tedarikçi Aç</option>
            </select>
            <button class="btn btn-success fw-bold px-4 rounded-pill shadow-sm" id="btnNewBP"
                    title="Yeni kayıt moduna geçer ve cari kodu atar. Kayıt, sağdaki düğmeyle yapılır.">
                <i class="fas fa-plus me-2"></i>Yeni Kayda Başla
            </button>
            <span id="yeniKayitUyarisi" class="badge bg-warning text-dark d-none" style="font-weight:600;">
                <i class="fas fa-triangle-exclamation me-1"></i>Kaydedilmedi
            </span>
            <button class="btn btn-primary fw-bold px-4 rounded-pill shadow-sm" id="btnUpdateBP">
                <i class="fas fa-cloud-upload-alt me-2"></i>SAP'ye Gönder / Güncelle
            </button>
        </div>
    </div>

    <div class="bp-card">
        <div class="header-bg"></div>
        
        <div class="header-section row row-compact align-items-end">
            <div class="col-xl-2 col-lg-3 col-md-4">
                <label class="form-label text-primary">Muhatap Kodu</label>
                <input type="text" class="form-control fw-bold" id="form_CardCode" readonly placeholder="Otomatik Üretilecek">
            </div>
            <div class="col-xl-4 col-lg-5 col-md-8">
                <label class="form-label">Muhatap Adı</label>
                <input type="text" class="form-control fw-bold" id="form_CardName" placeholder="Firma adını giriniz">
            </div>
            <div class="col-xl-2 col-lg-4 col-md-6 offset-xl-1">
                <label class="form-label text-danger">Hesap Bakiyesi</label>
                <input type="text" class="form-control bal-field" id="form_Balance" readonly value="0,00">
            </div>
            
            <div class="w-100 m-0 p-0"></div> 
            
            <div class="col-xl-2 col-lg-3 col-md-4">
                <label class="form-label">Grup</label>
                <select class="form-select" id="form_GroupCode">
                    @foreach(var g in groups) { <option value="@g.Id">@g.Name</option> }
                </select>
            </div>
            <div class="col-xl-4 col-lg-5 col-md-8">
                <label class="form-label">Yabancı Ad (İngilizce vb.)</label>
                <input type="text" class="form-control" id="form_CardFName">
            </div>
            <div class="col-xl-2 col-lg-4 col-md-6 offset-xl-1">
                <label class="form-label text-muted">Açık Teslimatlar</label>
                <input type="text" class="form-control bal-field text-muted fs-6" id="form_DNotesBal" readonly value="0,00">
            </div>

            <div class="w-100 m-0 p-0"></div> 
            
            <div class="col-xl-2 col-lg-3 col-md-4">
                <label class="form-label">Para Birimi</label>
                <select class="form-select" id="form_Currency">
                    <option value="##">Tüm para birimleri</option>
                    <option value="TRY">TRY</option>
                    <option value="USD">USD</option>
                    <option value="EUR">EUR</option>
                </select>
            </div>
            <div class="col-xl-4 col-lg-5 col-md-8">
                <label class="form-label">TCKN / VKN</label>
                <input type="text" class="form-control fw-bold" id="form_LicTradNum" placeholder="10 veya 11 Haneli Vergi/TC No">
            </div>
            <div class="col-xl-2 col-lg-4 col-md-6 offset-xl-1">
                <label class="form-label text-muted">Açık Siparişler</label>
                <div class="input-group">
                    <input type="text" class="form-control bal-field text-muted fs-6" id="form_OrdersBal" readonly value="0,00">
                    <span class="input-group-text bg-light text-muted" id="form_OprCount" title="Açık Fırsatlar">0</span>
                </div>
            </div>
        </div>

        <ul class="nav nav-tabs" id="bpTab" role="tablist">
            <li class="nav-item"><a class="nav-link active" data-bs-target="#tabGenel" href="#tabGenel"><i class="fas fa-info-circle me-1"></i> Genel</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-target="#tabAdres" href="#tabAdres"><i class="fas fa-map-marker-alt me-1"></i> Adresler</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-target="#tabOdemeK" href="#tabOdemeK"><i class="fas fa-file-invoice-dollar me-1"></i> Ödeme Koşulları</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-target="#tabMuhasebe" href="#tabMuhasebe"><i class="fas fa-calculator me-1"></i> Muhasebe</a></li>
        </ul>

        <div class="tab-content" id="bpTabContent">
            
            <div class="tab-pane fade show active" id="tabGenel">
                <div class="row">
                    <div class="col-xl-5 col-lg-6 border-end pe-lg-5">
                        <div class="row align-items-center mb-2"><div class="col-4"><label class="form-label mb-0">Telefon 1</label></div><div class="col-8"><input type="text" class="form-control" id="form_Phone1"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-4"><label class="form-label mb-0">Telefon 2</label></div><div class="col-8"><input type="text" class="form-control" id="form_Phone2"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-4"><label class="form-label mb-0">Cep Telefonu</label></div><div class="col-8"><input type="text" class="form-control" id="form_Cellular"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-4"><label class="form-label mb-0">Faks</label></div><div class="col-8"><input type="text" class="form-control" id="form_Fax"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-4"><label class="form-label mb-0">E-Posta</label></div><div class="col-8"><input type="email" class="form-control" id="form_Email"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-4"><label class="form-label mb-0">Web Sitesi</label></div><div class="col-8"><input type="text" class="form-control" id="form_IntrntSite"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-4"><label class="form-label mb-0">Sevkiyat Türü</label></div><div class="col-8"><select class="form-select" id="form_ShipType"><option value="0">-Tanımsız-</option></select></div></div>
                        <div class="row align-items-center mb-2"><div class="col-4"><label class="form-label mb-0">Parola</label></div><div class="col-8"><input type="password" class="form-control" id="form_Password"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-4"><label class="form-label mb-0">Faktoring Göst.</label></div><div class="col-8"><input type="text" class="form-control" id="form_Indicator"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-4"><label class="form-label mb-0">Proje Kodu</label></div><div class="col-8"><input type="text" class="form-control" id="form_ProjectCod"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-4"><label class="form-label mb-0">İş Türü</label></div><div class="col-8"><select class="form-select" id="form_CmpPrivate"><option value="1">Şirket</option><option value="2">Şahıs</option><option value="3">Çalışan</option></select></div></div>
                        <div class="row align-items-center mb-4"><div class="col-4"><label class="form-label mb-0">Takma Ad</label></div><div class="col-8"><input type="text" class="form-control" id="form_AliasName"></div></div>

                        <div class="p-3 bg-light rounded-3 border">
                            <div class="form-check form-check-inline mb-2">
                                <input class="form-check-input" type="radio" name="rdoStatus" id="rdoEtkin" value="Y" checked>
                                <label class="form-check-label fw-bold text-success" for="rdoEtkin">Etkin</label>
                            </div>
                            <div class="row g-2 align-items-center mt-1">
                                <div class="col-auto"><label class="form-label mb-0">Başlangıç:</label></div><div class="col"><input type="date" class="form-control form-control-sm" id="form_ValidFrom"></div>
                                <div class="col-auto"><label class="form-label mb-0">Bitiş:</label></div><div class="col"><input type="date" class="form-control form-control-sm" id="form_ValidTo"></div>
                            </div>
                            <hr class="my-3"/>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="rdoStatus" id="rdoEtkinDegil" value="N">
                                <label class="form-check-label fw-bold text-danger" for="rdoEtkinDegil">Etkin Değil</label>
                            </div>
                            <div class="row g-2 align-items-center mt-1">
                                <div class="col-auto"><label class="form-label mb-0">Başlangıç:</label></div><div class="col"><input type="date" class="form-control form-control-sm" id="form_FrozenFrom"></div>
                                <div class="col-auto"><label class="form-label mb-0">Bitiş:</label></div><div class="col"><input type="date" class="form-control form-control-sm" id="form_FrozenTo"></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-7 col-lg-6 ps-lg-5 mt-4 mt-lg-0">
                        <div class="row align-items-center mb-2"><div class="col-xl-3 col-4"><label class="form-label mb-0">İlgili Kişi</label></div><div class="col-xl-9 col-8"><input type="text" class="form-control" id="form_CntctPrsn"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-xl-3 col-4"><label class="form-label mb-0 text-primary">Vergi Dairesi</label></div><div class="col-xl-9 col-8"><input type="text" class="form-control" id="form_AddID"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-xl-3 col-4"><label class="form-label mb-0">Vergi No.</label></div><div class="col-xl-9 col-8"><input type="text" class="form-control" id="form_VatIdUnCmp"></div></div>
                        <div class="row align-items-start mb-3 mt-3"><div class="col-xl-3 col-4"><label class="form-label mt-1">Açıklamalar</label></div><div class="col-xl-9 col-8"><textarea class="form-control" id="form_Notes" rows="4"></textarea></div></div>
                        <div class="row align-items-center mb-2"><div class="col-xl-3 col-4"><label class="form-label mb-0">Satış Çalışanı</label></div>
                            <div class="col-xl-9 col-8">
                                <select class="form-select" id="form_SlpCode">
                                    <option value="-1">-Satış çalışanı yok-</option>
                                    @foreach(var s in salesPersons) { <option value="@s.Id">@s.Name</option> }
                                </select>
                            </div>
                        </div>
                        <div class="row align-items-center mb-2"><div class="col-xl-3 col-4"><label class="form-label mb-0">İşleyen</label></div><div class="col-xl-9 col-8"><input type="text" class="form-control" id="form_AgentCode"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-xl-3 col-4"><label class="form-label mb-0">Kanal Kodu</label></div><div class="col-xl-9 col-8"><input type="text" class="form-control" id="form_ChannlBP"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-xl-3 col-4"><label class="form-label mb-0">Teknisyen</label></div><div class="col-xl-9 col-8"><input type="number" class="form-control" id="form_DfTcnician"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-xl-3 col-4"><label class="form-label mb-0">Bölge</label></div><div class="col-xl-9 col-8"><input type="number" class="form-control" id="form_Territory"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-xl-3 col-4"><label class="form-label mb-0">Dil</label></div><div class="col-xl-9 col-8"><select class="form-select" id="form_LangCode"><option value="0">Türkçe (Turkish)</option><option value="3">İngilizce (English)</option></select></div></div>
                        <div class="row align-items-center mb-4"><div class="col-xl-3 col-4"><label class="form-label mb-0">GLN</label></div><div class="col-xl-9 col-8"><input type="text" class="form-control" id="form_GlblLocNum"></div></div>
                        <div class="row mt-3">
                            <div class="col-12 offset-xl-3 offset-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="form_BlockComm" value="Y">
                                    <label class="form-check-label text-muted" for="form_BlockComm">Pazarlama içeriğini göndermeyi bloke et</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="tabAdres">
                <div class="row">
                    <div class="col-md-4 col-lg-3 border-end pe-4">
                        <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                            <div><i class="fas fa-file-invoice text-primary me-2"></i><span class="fw-bold text-uppercase fs-6">Fatura Adresi</span></div>
                            <button class="btn btn-sm btn-outline-primary py-0 px-2" onclick="addNewAddress('B')" title="Yeni Fatura Adresi Ekle"><i class="fas fa-plus"></i></button>
                        </div>
                        <ul class="list-group address-list mb-4 shadow-sm" id="listFatura"></ul>
                        
                        <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                            <div><i class="fas fa-truck text-success me-2"></i><span class="fw-bold text-uppercase fs-6">Sevkiyat Adresi</span></div>
                            <button class="btn btn-sm btn-outline-success py-0 px-2" onclick="addNewAddress('S')" title="Yeni Sevkiyat Adresi Ekle"><i class="fas fa-plus"></i></button>
                        </div>
                        <ul class="list-group address-list shadow-sm" id="listSevkiyat"></ul>
                    </div>
                    
                    <div class="col-md-8 col-lg-9 ps-4" id="addressDetailArea">
                        <div id="addressEmptyMsg" class="alert alert-info border-0 shadow-sm rounded-3 py-3 mb-4">
                            <i class="fas fa-info-circle me-2 fs-5 align-middle"></i>
                            Adres düzenlemek için soldan bir adres seçin veya '+' butonuna tıklayarak yeni adres ekleyin.
                        </div>
                        
                        <div class="card border-0 shadow-sm rounded-3" id="addressFormCard" style="display:none;">
                            <div class="card-header bg-light fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-edit me-2"></i>Adres Düzenle</span>
                            </div>
                            <div class="card-body">
                                <input type="hidden" id="det_AddrIndex" />
                                <input type="hidden" id="det_AddrType" />
                                
                                <div class="row mb-2">
                                    <div class="col-md-3"><label class="form-label mt-2">Adres Tanıtıcısı</label></div>
                                    <div class="col-md-9"><input type="text" class="form-control fw-bold border-primary" id="det_AddrName" placeholder="Örn: Merkez, Depo..."></div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-md-3"><label class="form-label mt-2">Sokak / Mahalle</label></div>
                                    <div class="col-md-9"><input type="text" class="form-control" id="det_Street"></div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-md-3"><label class="form-label mt-2">Bina / Blok / No</label></div>
                                    <div class="col-md-9"><input type="text" class="form-control" id="det_Block"></div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-md-3"><label class="form-label mt-2">Posta Kodu</label></div>
                                    <div class="col-md-3"><input type="text" class="form-control" id="det_Zip"></div>
                                    
                                    <div class="col-md-2 text-end"><label class="form-label mt-2">İlçe</label></div>
                                    <div class="col-md-4"><input type="text" class="form-control" id="det_County"></div>
                                </div>
                                <hr />
                                <div class="row mb-2">
                                    <div class="col-md-3"><label class="form-label mt-2 text-danger">Ülke</label></div>
                                    <div class="col-md-9">
                                        <select class="form-select select2-init" id="det_Country"></select>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-md-3"><label class="form-label mt-2 text-danger">İl / Bölge</label></div>
                                    <div class="col-md-9">
                                        <select class="form-select select2-init" id="det_State">
                                            <option value="">Önce Ülke Seçiniz...</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="tabOdemeK">
                <div class="row">
                    <div class="col-xl-5 col-lg-6 border-end pe-lg-5">
                        <div class="row align-items-center mb-3"><div class="col-5"><label class="form-label text-warning fw-bold mb-0">Ödeme Koşulları</label></div><div class="col-7"><select class="form-select fw-bold border-warning" id="form_GroupNum"><option value="-1">Seçiniz</option>@foreach(var p in paymentTerms) { <option value="@p.Id">@p.Name</option> }</select></div></div>
                        <div class="row align-items-center mb-2"><div class="col-5"><label class="form-label mb-0">Gecikme Faizi %</label></div><div class="col-7"><input type="number" step="0.01" class="form-control" id="form_IntrstRate"></div></div>
                        <hr/>
                        <div class="row align-items-center mb-2"><div class="col-5"><label class="form-label mb-0">Fiyat Listesi</label></div><div class="col-7"><input type="number" class="form-control" id="form_ListNum" placeholder="Liste No (Örn: 1)"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-5"><label class="form-label mb-0">Toplam İndirim %</label></div><div class="col-7"><input type="number" step="0.01" class="form-control" id="form_Discount"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-5"><label class="form-label mb-0">Kredi Limiti</label></div><div class="col-7"><input type="number" step="0.01" class="form-control text-end text-danger fw-bold" id="form_CreditLine"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-5"><label class="form-label mb-0">Taahhüt Limiti</label></div><div class="col-7"><input type="number" step="0.01" class="form-control text-end text-danger fw-bold" id="form_DebtLine"></div></div>
                        <div class="row align-items-center mb-4"><div class="col-5"><label class="form-label mb-0">İhtar Koşulu</label></div><div class="col-7"><input type="text" class="form-control" id="form_DunTerm"></div></div>
                    </div>

                    <div class="col-xl-7 col-lg-6 ps-lg-5 mt-4 mt-lg-0">
                        <div class="row align-items-center mb-2"><div class="col-xl-3 col-4"><label class="form-label mb-0">Kredi Kartı Türü</label></div><div class="col-xl-9 col-8"><input type="text" class="form-control" id="form_CreditCard"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-xl-3 col-4"><label class="form-label mb-0">Kredi Kartı No</label></div><div class="col-xl-9 col-8"><input type="text" class="form-control" id="form_CrCardNum"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-xl-3 col-4"><label class="form-label mb-0">Geçerlilik Sonu</label></div><div class="col-xl-4 col-6"><input type="date" class="form-control" id="form_CardValid"></div></div>
                        <div class="row align-items-center mb-2"><div class="col-xl-3 col-4"><label class="form-label mb-0">Tanıtıcı Numarası</label></div><div class="col-xl-9 col-8"><input type="text" class="form-control" id="form_OwnerIdNum"></div></div>
                        <div class="row align-items-center mb-4"><div class="col-xl-3 col-4"><label class="form-label mb-0">Ortalama Gecikme (Gün)</label></div><div class="col-xl-3 col-4"><input type="number" class="form-control text-center" id="form_AvrageLate"></div></div>
                        
                        <div class="mt-5 p-4 border rounded-3 bg-light shadow-sm">
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="form_PartDelivr" value="Y" style="transform: scale(1.2); margin-right: 10px;">
                                <label class="form-check-label fw-bold">Satış siparişinin kısmi teslimatına izin ver</label>
                            </div>
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="form_EdrsFromBP" value="Y" style="transform: scale(1.2); margin-right: 10px;">
                                <label class="form-check-label fw-bold text-muted">Bu muhatabın çekleri ciro edilebilir (Salt Okunur)</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="form_EdrsToBP" value="Y" style="transform: scale(1.2); margin-right: 10px;">
                                <label class="form-check-label fw-bold text-muted">Bu muhatap ciro edilen çekleri kabul ediyor (Salt Okunur)</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 mt-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                <span class="fw-bold text-primary"><i class="fas fa-university me-2"></i>Muhatap Banka Hesapları (Kurulum)</span>
                                <button type="button" class="btn btn-sm btn-primary" onclick="openBankModal()"><i class="fas fa-plus"></i> Banka Ekle</button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover table-sm bg-white" id="tblBanks">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Banka Kodu</th>
                                            <th>Ülke</th>
                                            <th>Hesap No</th>
                                            <th>Banka Hesap Adı</th>
                                            <th>Şube</th>
                                            <th>IBAN</th>
                                            <th>BIC/SWIFT</th>
                                            <th class="text-center">İşlem</th>
                                        </tr>
                                    </thead>
                                    <tbody id="listBanks">
                                        </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="tab-pane fade" id="tabMuhasebe">
                <div class="row">
                    <div class="col-xl-7 col-lg-9 border-end pe-lg-5">
                        <div class="row align-items-center mb-4 p-3 bg-light rounded-3 border">
                            <div class="col-xl-3 col-4"><label class="form-label fw-bold mb-0 text-primary">Konsolidasyon Muhatabı</label></div>
                            <div class="col-xl-5 col-4"><input type="text" class="form-control border-primary" id="form_FatherCard" placeholder="Cari Kod"></div>
                            <div class="col-xl-4 col-4">
                                <div class="form-check form-check-inline mt-1"><input class="form-check-input" type="radio" name="rdoFather" id="rdoFatherP" value="P" checked><label class="form-check-label" for="rdoFatherP">Ödeme</label></div>
                                <div class="form-check form-check-inline mt-1"><input class="form-check-input" type="radio" name="rdoFather" id="rdoFatherD" value="D"><label class="form-check-label" for="rdoFatherD">Teslimat</label></div>
                            </div>
                        </div>

                        <div class="row align-items-center mb-3">
                            <div class="col-xl-3 col-4"><label class="form-label fw-bold mb-0 text-success">Mutabakat Hesabı</label></div>
                            <div class="col-xl-7 col-6">
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-book"></i></span>
                                    <select class="form-select fw-bold border-success select2-init" id="form_DebPayAcct">
                                        <option value="">Seçiniz...</option>
                                        @foreach(var act in controlAccounts) { 
                                            <option value="@act.Code">@act.Name</option> 
                                        }
                                    </select>
                                    <button class="btn btn-success" type="button" id="btnYeniMutabakat"
                                            title="Üst hesabı seç, sıradaki kırılımı otomatik açayım">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="row align-items-center mb-2"><div class="col-xl-3 col-4"><label class="form-label mb-0">Peşinat Mahsuplaştırma Hsb.</label></div><div class="col-xl-5 col-6"><input type="text" class="form-control" id="form_DpmClear"></div></div>
                        <div class="row align-items-center mb-5"><div class="col-xl-3 col-4"><label class="form-label mb-0">Peşinat Ara Hesabı</label></div><div class="col-xl-5 col-6"><input type="text" class="form-control" id="form_DpmIntAct"></div></div>

                        <hr/>
                        <div class="form-check form-switch mb-3"><input class="form-check-input text-danger" type="checkbox" id="form_BlockDunn" value="Y" style="transform: scale(1.2); margin-right: 10px;"><label class="form-check-label fw-bold text-danger">İhtar Mektuplarını Bloke Et</label></div>
                        <div class="row align-items-center mb-2"><div class="col-xl-3 col-4"><label class="form-label mb-0">İhtar Düzeyi</label></div><div class="col-xl-3 col-4"><input type="number" class="form-control text-center" id="form_DunnLevel"></div></div>
                        <div class="row align-items-center mb-4"><div class="col-xl-3 col-4"><label class="form-label mb-0">İhtar Tarihi</label></div><div class="col-xl-3 col-4"><input type="date" class="form-control" id="form_DunnDate"></div></div>
                        <div class="row align-items-center mb-3 mt-4"><div class="col-xl-3 col-4"><label class="form-label mb-0">Planlama Grubu</label></div><div class="col-xl-5 col-6"><input type="text" class="form-control" id="form_PlngGroup"></div></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" id="form_Affiliate" value="Y"><label class="form-check-label fw-bold text-muted">Bağlı Firma (Affiliate)</label></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

