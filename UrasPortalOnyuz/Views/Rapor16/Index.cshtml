                    const countrySelect = $('#countrySelect');
                    countrySelect.empty();
                    countrySelect.append('<option value="">Ülke Seçin...</option>');
                    if (data && data.length > 0) {
                        $.each(data, function (index, country) {
                            countrySelect.append('<option value="' + country.code + '">' + country.name + '</option>');
                        });
                        if ('@Model.CountryCode') {
                            countrySelect.val('@Model.CountryCode');
                        }
                    } else {
                        countrySelect.append('<option value="">Veri bulunamadı</option>');
                    }
                },
                error: function (error) {
                    console.log("Ülke verileri yüklenirken hata oluştu: ", error.responseText);
                    const countrySelect = $('#countrySelect');
                    countrySelect.html('<option value="">Hata oluştu</option>');
                }
            });

            // Ay ve Para Birimi seçicilerini yükle
            if ('@Model.Month') {
                $('#monthSelect').val('@Model.Month');
            }
            if ('@Model.Currency') {
                $('#currencySelect').val('@Model.Currency');
            }

            // Sayfa yüklendiğinde en son Euro/USD paritesini çek
            $.ajax({
                url: '/Rapor16/GetLatestEuroUsdParity' + dbQueryString,
                type: 'GET',
                success: function (data) {
                    if (data.parity > 0) {
                        $('#pariteEuroUsd').val(data.parity.toFixed(4));
                        updateAllCosts();
                    } else {
                        $('#pariteEuroUsd').val('0');
                    }
                },
                error: function (error) {
                    console.log("Parite verisi çekilirken hata oluştu:", error.responseText);
                    $('#pariteEuroUsd').val('0');
                }
            });

            let allProducts = [];

            $.ajax({
                url: '/Rapor16/GetProducts' + dbQueryString,
                type: 'GET',
                success: function (data) {
                    allProducts = data;
                    const tableBody = $('#productTableBody');
                    tableBody.empty();
                    // Load saved data if available
                    const savedDetails = @Html.Raw(Json.Serialize(Model.Details));
                    if (savedDetails && savedDetails.length > 0) {
                        savedDetails.forEach(detail => addRow(detail));
                    } else {
                        addRow();
                    }
                },
                error: function (error) {
                    console.log("Ürün verileri yüklenirken hata oluştu: ", error.responseText);
                    const tableBody = $('#productTableBody');
                    tableBody.append('<tr><td colspan="18" class="text-center">Ürün verisi bulunamadı.</td></tr>');
                }
