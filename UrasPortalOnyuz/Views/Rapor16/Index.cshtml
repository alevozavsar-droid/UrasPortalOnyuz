            // Kaydedilmiş raporları yükle
            loadSavedReports();

            function loadSavedReports() {
                $.ajax({
                    url: '/Rapor16/GetSavedReports' + dbQueryString,
                    type: 'GET',
                    success: function (data) {
                        const savedReportsBody = $('#savedReportsBody');
                        savedReportsBody.empty();
                        if (data && data.length > 0) {
                            $.each(data, function (index, report) {
                                const newRow = `
                                    <tr class="report-row" data-docentry="${report.docEntry}">
                                        <td>${report.docNum}</td>
                                        <td>${report.customer}</td>
                                        <td>${report.createDate}</td>
                                    </tr>
                                `;
                                savedReportsBody.append(newRow);
                            });
                        } else {
                            savedReportsBody.append('<tr><td colspan="3" class="text-center">Henüz kaydedilmiş rapor bulunamadı.</td></tr>');
                        }
                    },
                    error: function (error) {
                        console.log("Kaydedilmiş raporlar yüklenirken hata oluştu: ", error.responseText);
                        $('#savedReportsBody').html('<tr><td colspan="3" class="text-center">Hata oluştu</td></tr>');
                    }
                });
            }

            $('#savedReportsBody').on('click', '.report-row', function () {
                const docEntry = $(this).data('docentry');
                window.location.href = '@Url.Action("Index", "Rapor16")' + dbQueryString + (dbQueryString ? '&' : '?') + 'docEntry=' + docEntry;
            });

            function addRow(data = null) {
                const tableBody = $('#productTableBody');
                const rowCount = tableBody.find('tr').length + 1;
                const productSelectOptions = allProducts.map(p => `<option value="${p.itemCode}">${p.itemName}</option>`).join('');

                const newRow = `
                    <tr>
                        <td>${rowCount}</td>
                        <td><input type="text" class="form-control counter-type-input" placeholder="Counter Type" value="${data ? data.counterType : ''}" /></td>
                        <td>
                            <select class="form-select product-select">
                                <option value="">Ürün Seçin...</option>
                                ${productSelectOptions}
                            </select>
                        </td>
                        <td><input type="number" step="0.001" class="form-control kazan-ici-usd-input" value="${data ? data.kazanIciUsd : ''}" /></td>
                        <td><input type="number" step="0.001" class="form-control kazan-ici-eur-input" value="${data ? data.kazanIciEur : ''}" /></td>
                        <td><input type="number" step="0.001" class="form-control karlilik-orani-input" value="${data ? data.karlilikOrani : ''}" /></td>
                        <td><input type="number" step="0.001" class="form-control karlilik-yuzdesi-input" value="${data ? data.karlilikYuzdesi : ''}" /></td>
                        <td><input type="number" step="0.001" class="form-control ambalaj-ibc-input" value="${data ? data.ambalajIbc : ''}" /></td>
                        <td><input type="number" step="0.001" class="form-control ambalaj-drums-input" value="${data ? data.ambalajDrums : ''}" /></td>
                        <td><input type="number" step="0.001" class="form-control ambalaj-bulk-input" value="${data ? data.ambalajBulk : ''}" /></td>
                        <td><input type="number" step="0.001" class="form-control indirim-input" value="${data ? data.indirim : ''}" /></td>
                        <td><input type="number" step="0.001" class="form-control kar-input" value="${data ? data.kar : ''}" /></td>
                        <td><input type="number" step="0.001" class="form-control komisyon-input" value="${data ? data.komisyon : ''}" /></td>
                        <td><input type="text" class="form-control vade-input" value="${data ? data.vade : ''}" /></td>
                        <td><input type="number" step="0.001" class="form-control exw-masraf-input" value="${data ? data.exwMasraf : ''}" readonly/></td>
                        <td><input type="number" step="0.001" class="form-control exw-ibc-usd-kg-input" value="${data ? data.exwIbcUsdKg : ''}" readonly /></td>
                        <td><input type="number" step="0.001" class="form-control exw-drums-usd-kg-input" value="${data ? data.exwDrumsUsdKg : ''}" readonly /></td>
                        <td><input type="number" step="0.001" class="form-control fob-ibc-usd-kg-input" value="${data ? data.fobIbcUsdKg : ''}" readonly /></td>
                        <td><input type="number" step="0.001" class="form-control fob-drums-usd-kg-input" value="${data ? data.fobDrumsUsdKg : ''}" readonly /></td>
                    </tr>
                `;
                tableBody.append(newRow);

                if (data) {
                    const newRowObj = tableBody.find('tr').last();
                    newRowObj.find('.product-select').val(data.itemCode);
                }
            }


            $('#addRow').on('click', function () {
                addRow();
            });

            $('#deleteRow').on('click', function () {
                const tableBody = $('#productTableBody');
                if (tableBody.find('tr').length > 1) {
                    tableBody.find('tr').last().remove();
                }
            });

            $('#productTableBody').on('input', '.kazan-ici-usd-input', function () {
                const row = $(this).closest('tr');
                const usdValue = parseFloat($(this).val()) || 0;
                const parity = parseFloat($('#pariteEuroUsd').val()) || 0;
                const kazanIciEurInput = row.find('.kazan-ici-eur-input');

                if (parity > 0) {
                    const euroValue = usdValue / parity;
                    kazanIciEurInput.val(euroValue.toFixed(3));
                } else {
                    kazanIciEurInput.val('0.000');
                }
                hesaplaKarlilikYuzdesi(row);
                updateTableRowCalculations(row);
            });

            $('#productTableBody').on('input', '.kazan-ici-eur-input', function () {
                const row = $(this).closest('tr');
                const eurValue = parseFloat($(this).val()) || 0;
                const parity = parseFloat($('#pariteEuroUsd').val()) || 0;
                const kazanIciUsdInput = row.find('.kazan-ici-usd-input');

                if (parity > 0) {
                    const usdValue = eurValue * parity;
                    kazanIciUsdInput.val(usdValue.toFixed(3));
                } else {
                    kazanIciUsdInput.val('0.000');
                }
                hesaplaKarlilikYuzdesi(row);
                updateTableRowCalculations(row);
            });

            $('#currencySelect').on('change', function () {
                $('#productTableBody tr').each(function () {
                    const row = $(this);
                    const currentCurrency = $('#currencySelect').val();
                    const kazanIciUsdInput = row.find('.kazan-ici-usd-input');
                    const kazanIciEurInput = row.find('.kazan-ici-eur-input');
                    const parity = parseFloat($('#pariteEuroUsd').val()) || 0;
                    const usdValue = parseFloat(kazanIciUsdInput.val()) || 0;
                    const eurValue = parseFloat(kazanIciEurInput.val()) || 0;

                    if (currentCurrency === 'EUR' && parity > 0) {
                        const newEuroValue = usdValue / parity;
                        kazanIciEurInput.val(newEuroValue.toFixed(3));
                    } else if (currentCurrency === 'USD' && parity > 0) {
                        const newUsdValue = eurValue * parity;
                        kazanIciUsdInput.val(newUsdValue.toFixed(3));
                    }
                    hesaplaKarlilikYuzdesi(row);
                    updateTableRowCalculations(row);
                });

                updateAllCosts();
            });

            $('#productTableBody').on('input', '.karlilik-orani-input', function () {
                const row = $(this).closest('tr');
                hesaplaKarlilikYuzdesi(row);
                updateTableRowCalculations(row);
            });

            // Diğer input değişikliklerinde de hesaplama fonksiyonunu çağır
            $('#productTableBody').on('input', '.ambalaj-ibc-input, .indirim-input, .kar-input, .vade-input, .komisyon-input, .ambalaj-drums-input, .ambalaj-bulk-input', function () {
                const row = $(this).closest('tr');
                updateTableRowCalculations(row);
            });


            $('#productTableBody').on('change', '.product-select', function () {
                const selectedItemCode = $(this).val();
                const row = $(this).closest('tr');
                const kazanIciUsdInput = row.find('.kazan-ici-usd-input');
                const kazanIciEurInput = row.find('.kazan-ici-eur-input');

                // Update the hidden product name for saving
                const itemName = $(this).find('option:selected').text();
                row.data('itemname', itemName);

                if (selectedItemCode) {
                    $.ajax({
                        url: '/Rapor16/GetProductCost' + dbQueryString,
                        type: 'GET',
                        data: { itemCode: selectedItemCode },
                        success: function (data) {
                            if (data && data.totalCost) {
                                kazanIciUsdInput.val(data.totalCost);
                                const parity = parseFloat($('#pariteEuroUsd').val());
                                const usdValue = parseFloat(data.totalCost);
                                if (!isNaN(parity) && !isNaN(usdValue) && parity > 0) {
                                    const euroValue = usdValue / parity;
                                    kazanIciEurInput.val(euroValue.toFixed(3));
                                } else {
                                    kazanIciEurInput.val('0.000');
                                }
                            } else {
                                kazanIciUsdInput.val('0.000');
                                kazanIciEurInput.val('0.000');
                            }
                            hesaplaKarlilikYuzdesi(row);
                            updateTableRowCalculations(row);
                        },
                        error: function (error) {
                            console.log("Ürün maliyeti çekilirken hata oluştu:", error.responseText);
                            kazanIciUsdInput.val('0.000');
                            kazanIciEurInput.val('0.000');
                            hesaplaKarlilikYuzdesi(row);
                            updateTableRowCalculations(row);
                        }
                    });
                } else {
                    kazanIciUsdInput.val('0.000');
                    kazanIciEurInput.val('0.000');
                    hesaplaKarlilikYuzdesi(row);
                    updateTableRowCalculations(row);
                }
            });

            function hesaplaKarlilikYuzdesi(row) {
                const currency = $('#currencySelect').val();
                let kazanIciMaliyet = 0;
                const karlilikOrani = parseFloat(row.find('.karlilik-orani-input').val()) || 0;
                const karlilikYuzdesiInput = row.find('.karlilik-yuzdesi-input');

                if (currency === 'USD') {
                    kazanIciMaliyet = parseFloat(row.find('.kazan-ici-usd-input').val()) || 0;
                } else if (currency === 'EUR') {
                    kazanIciMaliyet = parseFloat(row.find('.kazan-ici-eur-input').val()) || 0;
                }

                if (kazanIciMaliyet > 0) {
                    const yuzde = (karlilikOrani / kazanIciMaliyet) * 100;
                    karlilikYuzdesiInput.val(yuzde.toFixed(3));
                } else {
                    karlilikYuzdesiInput.val('0.000');
                }
            }

            function updateCosts(prefix) {
                const parity = parseFloat($('#pariteEuroUsd').val()) || 1;
                const inputsUsd = $(`.${prefix}-cost-input-usd`);
                const totalUsdInput = $(`#${prefix}ToplamUsd`);
                const totalEurInput = $(`#${prefix}ToplamEur`);

                let totalUsd = 0;
                inputsUsd.each(function () {
                    const value = parseFloat($(this).val()) || 0;
                    totalUsd += value;
                    const euroInput = $(`#${$(this).attr('id').replace('Usd', 'Eur')}`);
                    if (parity > 0) {
                        euroInput.val((value / parity).toFixed(3));
                    } else {
                        euroInput.val('0.000');
                    }
                });
                totalUsdInput.val(totalUsd.toFixed(3));
                if (parity > 0) {
                    totalEurInput.val((totalUsd / parity).toFixed(3));
                } else {
                    totalEurInput.val('0.000');
                }
            }

            function updatePerTonCosts() {
                const parity = parseFloat($('#pariteEuroUsd').val()) || 1;
                const exwToplamUsd = parseFloat($('#exworkToplamUsd').val()) || 0;
                const fobToplamUsd = parseFloat($('#fobToplamUsd').val()) || 0;
                const flexiToplamUsd = parseFloat($('#flexiToplamUsd').val()) || 0;

                const tonajIbc = parseFloat($('#tonajIbc').val()) || 0;
                const tonajDrums = parseFloat($('#tonajDrums').val()) || 0;
                const tonajBulk = parseFloat($('#tonajBulk').val()) || 0;
                const toplamTonaj = tonajIbc + tonajDrums + tonajBulk;

                const exwIbcMasrafUsd = tonajIbc > 0 ? exwToplamUsd / tonajIbc : 0;
                const exwDrumsMasrafUsd = tonajDrums > 0 ? exwToplamUsd / tonajDrums : 0;
                const exwBulkMasrafUsd = tonajBulk > 0 ? exwToplamUsd / tonajBulk : 0;

                $('#exworkIbcMasrafUsd').val(exwIbcMasrafUsd.toFixed(3));
                $('#exworkIbcMasrafEur').val((exwIbcMasrafUsd / parity).toFixed(3));
                $('#exworkDrumsMasrafUsd').val(exwDrumsMasrafUsd.toFixed(3));
                $('#exworkDrumsMasrafEur').val((exwDrumsMasrafUsd / parity).toFixed(3));
                $('#exworkBulkMasrafUsd').val(exwBulkMasrafUsd.toFixed(3));
                $('#exworkBulkMasrafEur').val((exwBulkMasrafUsd / parity).toFixed(3));

                const fobIbcMasrafUsd = tonajIbc > 0 ? fobToplamUsd / tonajIbc : 0;
                const fobDrumsMasrafUsd = tonajDrums > 0 ? fobToplamUsd / tonajDrums : 0;
                const fobBulkMasrafUsd = tonajBulk > 0 ? fobToplamUsd / tonajBulk : 0;

                $('#fobIbcMasrafUsd').val(fobIbcMasrafUsd.toFixed(3));
                $('#fobIbcMasrafEur').val((fobIbcMasrafUsd / parity).toFixed(3));
                $('#fobDrumsMasrafUsd').val(fobDrumsMasrafUsd.toFixed(3));
                $('#fobDrumsMasrafEur').val((fobDrumsMasrafUsd / parity).toFixed(3));
                $('#fobBulkMasrafUsd').val(fobBulkMasrafUsd.toFixed(3));
                $('#fobBulkMasrafEur').val((fobBulkMasrafUsd / parity).toFixed(3));

                const flexiMasrafUsd = toplamTonaj > 0 ? flexiToplamUsd / toplamTonaj : 0;
                $('#flexiMasrafUsd').val(flexiMasrafUsd.toFixed(3));
                $('#flexiMasrafEur').val((flexiMasrafUsd / parity).toFixed(3));

                $('#productTableBody tr').each(function () {
                    const row = $(this);
                    updateTableRowCalculations(row);
                });
            }

            function updateTableRowCalculations(row) {
                const currency = $('#currencySelect').val();
                const parity = parseFloat($('#pariteEuroUsd').val()) || 1;

                let kazanIciMaliyet = 0;
                if (currency === 'USD') {
                    kazanIciMaliyet = parseFloat(row.find('.kazan-ici-usd-input').val()) || 0;
                } else if (currency === 'EUR') {
                    kazanIciMaliyet = parseFloat(row.find('.kazan-ici-eur-input').val()) || 0;
                }

                const karlilikOrani = parseFloat(row.find('.karlilik-orani-input').val()) || 0;
                const ambalajIbc = parseFloat(row.find('.ambalaj-ibc-input').val()) || 0;
                const ambalajDrums = parseFloat(row.find('.ambalaj-drums-input').val()) || 0;
                const ambalajBulk = parseFloat(row.find('.ambalaj-bulk-input').val()) || 0;
                const indirim = parseFloat(row.find('.indirim-input').val()) || 0;
                const kar = parseFloat(row.find('.kar-input').val()) || 0;
                const komisyon = parseFloat(row.find('.komisyon-input').val()) || 0;
                const vade = parseFloat(row.find('.vade-input').val()) || 0;
                const exwMasraf = parseFloat($('#exworkIbcMasrafUsd').val()) || 0;
                const fobMasraf = parseFloat($('#fobIbcMasrafUsd').val()) || 0;

                // EXW IBC USD/KG
                let exwIbcUsdKg = (kazanIciMaliyet + karlilikOrani + ambalajIbc + vade + exwMasraf + komisyon) - indirim + kar;
                if (currency === 'EUR' && parity > 0) {
                    exwIbcUsdKg = (kazanIciMaliyet * parity + karlilikOrani * parity + ambalajIbc * parity + vade * parity + exwMasraf * parity + komisyon * parity) - indirim * parity + kar * parity;
                }
                row.find('.exw-ibc-usd-kg-input').val(exwIbcUsdKg.toFixed(3));

                // EXW DRUMS USD/KG
                let exwDrumsUsdKg = (kazanIciMaliyet + karlilikOrani + ambalajDrums + vade + exwMasraf + komisyon) - indirim + kar;
                if (currency === 'EUR' && parity > 0) {
                    exwDrumsUsdKg = (kazanIciMaliyet * parity + karlilikOrani * parity + ambalajDrums * parity + vade * parity + exwMasraf * parity + komisyon * parity) - indirim * parity + kar * parity;
                }
                row.find('.exw-drums-usd-kg-input').val(exwDrumsUsdKg.toFixed(3));

                // FOB IBC USD/KG
                let fobIbcUsdKg = (kazanIciMaliyet + karlilikOrani + ambalajIbc + vade + fobMasraf + komisyon) - indirim + kar;
                if (currency === 'EUR' && parity > 0) {
                    fobIbcUsdKg = (kazanIciMaliyet * parity + karlilikOrani * parity + ambalajIbc * parity + vade * parity + fobMasraf * parity + komisyon * parity) - indirim * parity + kar * parity;
                }
                row.find('.fob-ibc-usd-kg-input').val(fobIbcUsdKg.toFixed(3));

                // FOB DRUMS USD/KG
                let fobDrumsUsdKg = (kazanIciMaliyet + karlilikOrani + ambalajDrums + vade + fobMasraf + komisyon) - indirim + kar;
                if (currency === 'EUR' && parity > 0) {
                    fobDrumsUsdKg = (kazanIciMaliyet * parity + karlilikOrani * parity + ambalajDrums * parity + vade * parity + fobMasraf * parity + komisyon * parity) - indirim * parity + kar * parity;
                }
                row.find('.fob-drums-usd-kg-input').val(fobDrumsUsdKg.toFixed(3));
            }

            function updateAllCosts() {
                updateCosts('exwork');
                updateCosts('fob');
                updateCosts('flexi');
                updatePerTonCosts();
            }

            // Parite değiştiğinde tüm masrafları yeniden hesapla
            $('#pariteEuroUsd').on('input', function () {
                updateAllCosts();
            });

            // Masraf inputlarına event listener ekle
            $('.exwork-cost-input-usd, .fob-cost-input-usd, .flexi-cost-input-usd').on('input', () => updateAllCosts());
            $('.tonaj-input').on('input', () => updatePerTonCosts());
            $('#productTableBody').on('input', '.counter-type-input', () => updatePerTonCosts());

            // Save functionality
