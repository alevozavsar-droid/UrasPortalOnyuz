@model WebApplication3.Models.AlvFiyatViewModel

@{
    ViewData["Title"] = "ALV Fiyat";
    var months = new List<string> { "Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık" };
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Aktif şirketi URL veya Cookie'den alıyoruz ki işlemler sırasında kaybolmasın.
    var currentDb = Context.Request.Query["db"].ToString();
    if (string.IsNullOrEmpty(currentDb))
    {
        currentDb = Context.Request.Cookies["SelectedDatabase"];
    }
}

<style>
    /* Genel Yazı ve Satır Yüksekliği Ayarları */
    html, body {
        font-size: 0.8rem;
        line-height: 1.2;
        background-color: #f0f2f5;
    }

    /* Modern Kart Stili */
    .card.modern {
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        padding: 30px;
        background-color: #fff;
    }

    /* Üst Alan Form Grupları */
    .header-form-group {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        height: 100%;
    }

    .form-group label {
        font-weight: 600;
        color: #555;
        margin-bottom: 5px;
    }

    /* Form Kontrol ve Seçim Kutuları */
    .form-control, .form-select {
        border-radius: 8px;
        border: 1px solid #ddd;
        transition: border-color 0.3s ease;
        flex-grow: 1;
        height: 22px;
        font-size: 0.65rem;
    }

    .customer-select {
        min-width: 180px;
    }

    .country-select {
        min-width: 150px;
    }

    .form-control:focus, .form-select:focus {
        border-color: #007bff;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
    }

    /* Tablo ve Hücre Ölçüleri */
    .table-responsive {
        border: 1px solid #e9ecef;
        border-radius: 12px;
        overflow-x: auto;
    }

    .table {
        line-height: 1.1; /* Genel tablo satır yüksekliği */
    }

        .table thead th {
            background-color: #f8f9fa;
            color: #495057;
            font-weight: 600;
            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
            height: 40px;
            font-size: 0.65rem;
            line-height: 1.2; /* Tablo başlıkları için satır yüksekliği */
        }

        .table tbody td {
            vertical-align: middle;
            height: 25px;
            font-size: 0.7rem;
            line-height: 1.1; /* Tablo hücreleri için satır yüksekliği */
        }

    /* Butonlar */
    .btn-primary, .btn-secondary {
        border-radius: 25px;
        padding: 10px 25px;
    }

    /* Başlık Stili */
    .section-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #007bff;
    }

    /* Yeni CSS: Para birimi vurgusu */
    .active-currency-column {
        background-color: #e6f7ff !important;
        font-weight: bold;
    }

    /* Yeni CSS: USD ve EUR sembolleri için */
    .currency-symbol {
        background-color: #e9ecef;
        border: 1px solid #ddd;
        border-radius: 8px 0 0 8px;
        padding: 0.375rem 0.75rem;
        font-size: 0.65rem;
        color: #6c757d;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .input-group > .form-control {
        border-radius: 0 8px 8px 0 !important;
    }

    .report-row {
        cursor: pointer;
    }

        .report-row:hover {
            background-color: #f0f2f5;
        }
</style>

