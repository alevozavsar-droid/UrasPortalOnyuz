        const row = $(this);
        const itemCode = row.find('.product-select').val();
        if (itemCode) {
            model.Details.push({
                ItemCode: itemCode,
                ItemName: row.find('.product-select option:selected').text(),
                CounterType: row.find('.counter-type-input').val(),
                KazanIciUsd: parseFloat(row.find('.kazan-ici-usd-input').val()) || 0,
                KazanIciEur: parseFloat(row.find('.kazan-ici-eur-input').val()) || 0,
                KarlilikOrani: parseFloat(row.find('.karlilik-orani-input').val()) || 0,
                KarlilikYuzdesi: parseFloat(row.find('.karlilik-yuzdesi-input').val()) || 0,
                AmbalajIbc: parseFloat(row.find('.ambalaj-ibc-input').val()) || 0,
                AmbalajDrums: parseFloat(row.find('.ambalaj-drums-input').val()) || 0,
                AmbalajBulk: parseFloat(row.find('.ambalaj-bulk-input').val()) || 0,
                Indirim: parseFloat(row.find('.indirim-input').val()) || 0,
                Kar: parseFloat(row.find('.kar-input').val()) || 0,
                Komisyon: parseFloat(row.find('.komisyon-input').val()) || 0,
                Vade: row.find('.vade-input').val(),
                ExwMasraf: parseFloat(row.find('.exw-masraf-input').val()) || 0,
                ExwIbcUsdKg: parseFloat(row.find('.exw-ibc-usd-kg-input').val()) || 0,
                ExwDrumsUsdKg: parseFloat(row.find('.exw-drums-usd-kg-input').val()) || 0,
                FobIbcUsdKg: parseFloat(row.find('.fob-ibc-usd-kg-input').val()) || 0,
                FobDrumsUsdKg: parseFloat(row.find('.fob-drums-usd-kg-input').val()) || 0
            });
        }
    });

    // Asıl SaveData metodunu çağırın
    $.ajax({
        url: '/Rapor16/SaveData' + dbQueryString, 
        type: 'POST',
        contentType: 'application/json',
        headers: { 'RequestVerificationToken': antiForgeryToken }, // CSRF Token Eklendi
        data: JSON.stringify(model),
        success: function (response) {
            if (response.success) {
                alert('Veriler başarıyla kaydedildi!');
                window.location.href = '/Rapor16/Index' + dbQueryString + (dbQueryString ? '&' : '?') + 'docEntry=' + response.docEntry;
            } else {
                alert('Hata: ' + response.error);
            }
        },
        error: function (error) {
            alert('Kaydetme işlemi sırasında bir hata oluştu.');
            console.log("Kaydetme hatası: ", error.responseText);
        }
    });
});

            // Sayfa yüklendiğinde masrafları ilk kez hesapla
            updateAllCosts();
        });
    </script>
}