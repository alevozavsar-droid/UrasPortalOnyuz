@section Scripts {
    <script>

        $(document).ready(function () {
            // Şirket parametresini ve güvenlik tokenını JavaScript değişkenine alalım
            const dbParam = '@currentDb';
            const dbQueryString = dbParam ? `?db=${dbParam}` : '';
            const antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();

            // Müşterileri AJAX ile yükle
            $.ajax({
                url: '/Rapor16/GetCustomers' + dbQueryString,
                type: 'GET',
                success: function (data) {
                    const customerSelect = $('#customerSelect');
                    customerSelect.empty();
                    customerSelect.append('<option value="">Müşteri Seçin...</option>');
                    if (data && data.length > 0) {
                        $.each(data, function (index, customer) {
                            customerSelect.append('<option value="' + customer.cardCode + '">' + customer.cardName + '</option>');
                        });
                        // Load saved data if available
                        if ('@Model.CustomerCode') {
                            customerSelect.val('@Model.CustomerCode');
                        }
                    } else {
                        customerSelect.append('<option value="">Veri bulunamadı</option>');
                    }
                },
                error: function (error) {
                    console.log("Müşteri verileri yüklenirken hata oluştu: ", error.responseText);
                    const customerSelect = $('#customerSelect');
                    customerSelect.html('<option value="">Hata oluştu</option>');
                }
