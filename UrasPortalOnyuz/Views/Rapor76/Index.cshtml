@* @model List<WebApplication3.Controllers.Rapor76ViewModel>
@{
    ViewData["Title"] = "Tahsilat & Risk Takip Raporu";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <form method="get" class="d-flex align-items-center">
            <label class="me-2 fw-bold">Şirket/Veritabanı:</label>
            <select name="db" class="form-select w-auto me-2" onchange="this.form.submit()">
                @foreach (var db in ViewBag.Databases)
                {
                    if (ViewBag.SelectedDatabaseKey == db.Key)
                    {
                        <option value="@db.Key" selected>@db.Display</option>
                    }
                    else
                    {
                        <option value="@db.Key">@db.Display</option>
                    }
                }
            </select>
            <span class="badge bg-primary fs-6">Seçili: @ViewBag.CurrentDbDisplay</span>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    <div class="table-responsive" style="max-height: 75vh; overflow-y: auto;">
        <table class="table table-bordered table-striped table-hover table-sm" style="font-size: 0.80rem; white-space: nowrap;">
            <thead class="table-dark" style="position: sticky; top: 0; z-index: 10;">
                <tr>
                    <th>İşlem</th>
                    <th>Şirket</th>
                    <th>Müşteri Ünvanı</th>
                    <th>Şehir/Ülke</th>
                    <th>Satış Temsilcisi</th>
                    <th>En Son Teslimat Tarihi</th>
                    <th>Son Arama Tarihi</th>
                    <th>Son Tahsilat Tarihi</th>
                    <th>Vadesi Geçmiş Bakiye (X)</th>
                    <th>En Eski Fatura (X)</th>
                    <th>Ortalama Vade Bilgisi (X)</th>
                    <th>Vadesi Geçmiş Bakiye (R)</th>
                    <th>En Eski Fatura (R)</th>
                    <th>Ortalama Vade Bilgisi (R)</th>
                    <th>Vadesi Geçmiş Bakiye Toplamı</th>
                    <th>Vadesi Gelecek Bakiye (X)</th>
                    <th>Vadesi Gelecek Bakiye (R)</th>
                    <th>Toplam Bakiye (X)</th>
                    <th>Toplam Bakiye (R)</th>
                    <th>Genel Bakiye Toplamı (X) + (R)</th>
                    <th>Muhattap Adı-Soyadı</th>
                    <th>İletişim Numarası 1</th>
                    <th>İletişim Numarası 2</th>
                    <th>Mail Adresi 1</th>
                    <th>Mail Adresi 2</th>
                    <th>Arama Sonucu</th>
                    <th>Tahsilat & Risk Takip Durumu</th>
                    <th>Ekstre Gönderildi mi?</th>
                    <th>Ekstre Gönderim Tarihi</th>
                    <th>Ekstre Kanalı</th>
                    <th>Planlanan Ödeme Tarihi</th>
                    <th>Planlanan Ödeme Tutarı</th>
                    <th>Vade Farkı Oranı (Aylık %)</th>
                    <th>Vade Farkı Tutarı (X)</th>
                    <th>Vade Farkı Tutarı (R)</th>
                    <th>Vade Farkı Toplamı (X) + (R)</th>
                    <th>Planlanan Ödeme Gerçekleşme Durumu</th>
                    <th>Ekstre İndir</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center">
                            <button class="btn btn-sm btn-warning fw-bold text-dark" 
                                    onclick="openNotesModal('@item.CardCode', '@item.MusteriUnvani.Replace("'", "\\'")')">
                                Notlar <span class="badge bg-danger" id="badge-@item.CardCode">@item.NoteCount</span>
                            </button>
                        </td>
                        <td>@item.Sirket</td>
                        <td>@item.MusteriUnvani</td>
                        <td>@item.SehirUlke</td>
                        <td>@item.SatisTemsilcisi</td>
                        <td>@item.EnSonTeslimatTarihi</td>
                        <td>@item.SonAramaTarihi</td>
                        <td>@item.SonTahsilatTarihi</td>
                        <td class="text-end">@item.VadesiGecmisBakiyeX.ToString("N2")</td>
                        <td>@item.EnEskiFaturaX</td>
                        <td class="text-end">@item.OrtalamaVadeBilgisiX.ToString("N0")</td>
                        <td class="text-end">@item.VadesiGecmisBakiyeR.ToString("N2")</td>
                        <td>@item.EnEskiFaturaR</td>
                        <td class="text-end">@item.OrtalamaVadeBilgisiR.ToString("N0")</td>
                        <td class="text-end fw-bold text-danger">@item.VadesiGecmisBakiyeToplami.ToString("N2")</td>
                        <td class="text-end">@item.VadesiGelecekBakiyeX.ToString("N2")</td>
                        <td class="text-end">@item.VadesiGelecekBakiyeR.ToString("N2")</td>
                        <td class="text-end">@item.ToplamBakiyeX.ToString("N2")</td>
                        <td class="text-end">@item.ToplamBakiyeR.ToString("N2")</td>
                        <td class="text-end fw-bold">@item.GenelBakiyeToplami.ToString("N2")</td>
                        <td>@item.MuhattapAdSoyad</td>
                        <td>@item.IletisimNumarasi1</td>
                        <td>@item.IletisimNumarasi2</td>
                        <td>@item.MailAdresi1</td>
                        <td>@item.MailAdresi2</td>
                        <td>@item.AramaSonucu</td>
                        <td>@item.TahsilatRiskTakipDurumu</td>
                        <td>@item.EkstreGonderildiMi</td>
                        <td>@item.EkstreGonderimTarihi</td>
                        <td>@item.EkstreKanali</td>
                        <td>@item.PlanlananOdemeTarihi</td>
                        <td class="text-end">@item.PlanlananOdemeTutari.ToString("N2")</td>
                        <td class="text-end">@item.VadeFarkiOrani.ToString("N2")</td>
                        <td class="text-end">@item.VadeFarkiTutariX.ToString("N2")</td>
                        <td class="text-end">@item.VadeFarkiTutariR.ToString("N2")</td>
                        <td class="text-end">@item.VadeFarkiToplami.ToString("N2")</td>
                        <td>@item.PlanlananOdemeGerceklesmeDurumu</td>
                        <td>@item.EkstreIndir</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="notesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold" id="notesModalTitle">Müşteri Notları</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalCardCode" />
                
                <div class="mb-3 border p-3 bg-light rounded">
                    <label class="form-label fw-bold text-primary"><i class="fas fa-plus-circle"></i> Yeni Not Ekle</label>
                    <textarea class="form-control" id="newNoteText" rows="3" placeholder="Görüşme detaylarını buraya yazın..."></textarea>
                    <button class="btn btn-success mt-2 w-100 fw-bold" onclick="saveNote()">Notu Kaydet</button>
                </div>
                
                <h6 class="fw-bold mt-4 border-bottom pb-2">Geçmiş Notlar</h6>
                <div id="notesLoading" class="text-center d-none">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p>Notlar yükleniyor...</p>
                </div>
                <div id="existingNotesContainer" style="max-height: 300px; overflow-y: auto;">
                    </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Modal'ı Aç ve Notları Yükle
        function openNotesModal(cardCode, cardName) {
            document.getElementById("modalCardCode").value = cardCode;
            document.getElementById("notesModalTitle").innerText = cardName + " (" + cardCode + ") Notları";
            document.getElementById("newNoteText").value = "";
            
            var modal = new bootstrap.Modal(document.getElementById('notesModal'));
            modal.show();

            // Önceki Notları AJAX ile çek
            loadNotes(cardCode);
        }

        // Müşteri Notlarını Veritabanından Asenkron Çeker
        function loadNotes(cardCode) {
            var container = document.getElementById("existingNotesContainer");
            var loading = document.getElementById("notesLoading");
            
            container.innerHTML = "";
            loading.classList.remove("d-none");

            fetch(`/Rapor76/GetNotes?cardCode=${cardCode}`)
                .then(response => response.json())
                .then(data => {
                    loading.classList.add("d-none");
                    
                    if(data.length === 0) {
                        container.innerHTML = "<div class='alert alert-secondary'>Bu müşteriye ait henüz bir not bulunmuyor.</div>";
                        return;
                    }

                    // Notları Listele
                    data.forEach(note => {
                        let dateObj = new Date(note.eklemeTarihi);
                        let formattedDate = dateObj.toLocaleDateString("tr-TR") + " " + dateObj.toLocaleTimeString("tr-TR", {hour: '2-digit', minute:'2-digit'});
                        
                        let html = `
                            <div class="card mb-2 border-start border-4 border-warning shadow-sm">
                                <div class="card-body py-2">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <small class="fw-bold text-primary"><i class="fas fa-user"></i> ${note.kullaniciKodu}</small>
                                        <small class="text-muted"><i class="fas fa-calendar-alt"></i> ${formattedDate}</small>
                                    </div>
                                    <p class="mb-1 text-dark" style="font-size:0.9rem;">${note.kisaNot}</p>
                                    <div class="text-end">
                                        <button class="btn btn-sm btn-outline-danger py-0" style="font-size:0.75rem;" onclick="deleteNote(${note.noteId}, '${cardCode}')">Sil</button>
                                    </div>
                                </div>
                            </div>
                        `;
                        container.innerHTML += html;
                    });
                    
                    // Tablodaki Not sayısını Canlı Olarak Güncelle
                    document.getElementById(`badge-${cardCode}`).innerText = data.length;
                })
                .catch(err => {
                    loading.classList.add("d-none");
                    container.innerHTML = "<div class='alert alert-danger'>Notlar yüklenirken bir hata oluştu.</div>";
                });
        }

        // Yeni Not Kaydet
        function saveNote() {
            var cardCode = document.getElementById("modalCardCode").value;
            var noteText = document.getElementById("newNoteText").value;

            if (noteText.trim() === "") {
                alert("Lütfen bir not yazın.");
                return;
            }

            fetch('/Rapor76/AddNote', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ CardCode: cardCode, Note: noteText })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById("newNoteText").value = "";
                    loadNotes(cardCode); // Eklendikten sonra listeyi tekrar çek
                } else {
                    alert("Hata: " + data.message);
                }
            })
            .catch(error => {
                alert("Sistemsel bir hata oluştu.");
            });
        }

        // Notu Sil
        function deleteNote(noteId, cardCode) {
            if (!confirm("Bu notu silmek istediğinize emin misiniz?")) return;

            fetch('/Rapor76/DeleteNote', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ NoteId: noteId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    loadNotes(cardCode); // Silindikten sonra listeyi güncelle
                } else {
                    alert("Silinemedi: " + data.message);
                }
            });
        }
    </script>
} *@