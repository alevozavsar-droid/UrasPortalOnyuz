                $('#btnSave').show().text("Ara").removeClass('btn-warning').addClass('btn-info text-white').html('<i class="fas fa-search me-2"></i>Ara');
                
                $('#btnCancelDocument').hide();
                $('#btnCopyToContainer').hide();
                $('#btnRelMap').hide();
                $('#btnOpenOrders').hide();
                
                $('#btnOpenNewDriverModal').hide(); 
                $('#btnCancel').text("İptal").removeClass('btn-primary text-white').addClass('btn-light').prop('disabled', false);
                $('#pageTitle').html('<i class="fas fa-search text-info me-2"></i>Kayıt Bul');
                
                $('#linesBody').empty(); 
                resetTotals();
