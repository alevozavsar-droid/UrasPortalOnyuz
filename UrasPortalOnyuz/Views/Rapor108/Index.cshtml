                addRow();
                calculateTotals();
                isBindingData = false;
            }
        }

        // ==========================================
        // 4. API ÇAĞRILARI VE VERİ YÜKLEME
        // ==========================================
        function loadBaseDocument(baseEntry, baseType) {
            $('#loadingOverlay').css('display', 'flex');
            
            $.get('/Rapor108/GetBaseDocument', { baseEntry: baseEntry, baseType: baseType }, function(res) {
                if(res && res.success && res.data) {
                    setFormMode('ADD'); 
                    isBindingData = true; 
                    
                    let cCode = res.data.cardCode;
                    let optionExists = false;
                    
                    $('#CardCode option').each(function() {
                        if (this.value.toLowerCase() === cCode.toLowerCase()) {
                            optionExists = true;
                            cCode = this.value; 
                            return false; 
                        }
                    });

                    if (!optionExists) {
                        $('#CardCode').append(new Option(cCode + " (Listede Yok/Pasif)", cCode, true, true));
                    }
                    $('#CardCode').val(cCode).trigger('change');
                    
                    $('#SalesPersonCode').val(res.data.slpCode).trigger('change');
                    
                    $('#OrderComments').val(res.data.orderComments);
                    $('#DeliveryComments').val(res.data.deliveryComments);
                    $('#InvoiceComments').val(res.data.invoiceComments);
                    $('#DeliveryDescFlag').prop('checked', res.data.u_BE1_DESPATCHDESC === 'Y');
                    
                    $('#DocCurrency').val(res.data.docCurrency);
                    $('#ExchangeRate').val(res.data.docRate.toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
                    
                    $('#U_BE1_AKTAR').val(res.data.u_BE1_AKTAR || res.data.U_BE1_AKTAR);
                    let sendType = res.data.u_BE1_SEND || res.data.U_BE1_SEND;
                    $('#U_BE1_SEND').val(sendType).trigger('change');
                    
                    let muaf = res.data.u_BE1_MUAFCODE || res.data.U_BE1_MUAFCODE;
                    if(muaf) {
                        $('#U_BE1_MUAFCODE').html(`<option value="${muaf}">${muaf}</option>`).val(muaf);
                    }

                    $('#ShipToCode').html(`<option value="${res.data.shipToCode}">${res.data.shipToCode}</option>`).val(res.data.shipToCode);
                    $('#PayToCode').html(`<option value="${res.data.payToCode}">${res.data.payToCode}</option>`).val(res.data.payToCode);
                    
                    if(res.data.addressExtension) {
                        fillAddressComponent('ShipTo', {
                            street: res.data.addressExtension.shipToStreet, streetNo: res.data.addressExtension.shipToStreetNo,
                            block: res.data.addressExtension.shipToBlock, zipCode: res.data.addressExtension.shipToZipCode,
                            city: res.data.addressExtension.shipToCity, county: res.data.addressExtension.shipToCounty,
                            state: res.data.addressExtension.shipToState, country: res.data.addressExtension.shipToCountry
                        });
                        fillAddressComponent('PayTo', {
                            street: res.data.addressExtension.billToStreet, streetNo: res.data.addressExtension.billToStreetNo,
                            block: res.data.addressExtension.billToBlock, zipCode: res.data.addressExtension.billToZipCode,
                            city: res.data.addressExtension.billToCity, county: res.data.addressExtension.billToCounty,
                            state: res.data.addressExtension.billToState, country: res.data.addressExtension.billToCountry
                        });
                    }

                    $('#DriverListSelect').val(res.data.u_BE1_SOFORSECIMI || res.data.U_BE1_SOFORSECIMI || '').trigger('change.select2');
                    $('#U_BE1_SRCNAME').val(res.data.u_BE1_SRCNAME || res.data.U_BE1_SRCNAME || '');
                    $('#U_BE1_SRCPLAKA').val(res.data.u_BE1_SRCPLAKA || res.data.U_BE1_SRCPLAKA || '');
                    $('#U_BE1_SRCTITLE').val(res.data.u_BE1_SRCTITLE || res.data.U_BE1_SRCTITLE || '');
                    $('#U_BE1_SRCVKN').val(res.data.u_BE1_SRCVKN || res.data.U_BE1_SRCVKN || '');
                    $('#U_BE1_SRCKVKK').val(res.data.u_BE1_SRCKVKK || res.data.U_BE1_SRCKVKK || '');
                    $('#U_BE1_FIRMANO').val(res.data.u_BE1_FIRMANO || res.data.U_BE1_FIRMANO || '');
                    $('#U_BE1_SRCTEL').val(res.data.u_BE1_SRCTEL || res.data.U_BE1_SRCTEL || '');
                    
                    $('#U_BE1_NAKLIYETARIHI').val(res.data.u_BE1_NAKLIYETARIHI || res.data.U_BE1_NAKLIYETARIHI || '');
                    $('#U_BE1_NAKLIYESAATI').val(res.data.u_BE1_NAKLIYESAATI || res.data.U_BE1_NAKLIYESAATI || '');

                    const today = new Date().toISOString().split('T')[0];
                    $('#DocDate, #DocDueDate, #TaxDate').val(today);

                    $('#linesBody').empty();
                    let rowsHtml = '';
                    
                    res.data.lines.forEach((line, index) => {
                        let itemName = itemDict[line.itemCode] || '';
                        rowsHtml += `
                        <tr data-btype="${line.baseType || ''}" data-bentry="${line.baseEntry || ''}" data-bline="${line.baseLine ?? ''}">
                            <td class="text-center align-middle row-index text-muted small fw-bold">${index + 1}</td>
                            <td>
                                <select class="form-select item-select req-add">
                                    <option value="${line.itemCode}" selected>${line.itemCode} - ${itemName}</option>
                                </select>
                            </td>
                            <td class="align-middle">
                                <select class="form-select form-select-sm table-input input-whs req-add" style="font-size: 0.8rem; padding: 2px 4px; min-height:26px;">
                                    <option value="${line.warehouseCode}" selected>${line.warehouseCode}</option>
                                </select>
                                <div class="small text-muted mt-1" style="font-size:0.75rem;">Stok: -</div>
                            </td>
                            <td class="align-middle text-end">
                                <input type="number" class="table-input text-end input-qty fw-medium req-add" value="${line.quantity}" min="0.01" step="0.01" />
                                <div class="small text-muted mt-1" style="font-size:0.75rem;">
                                    <span class="input-sec-total fw-bold text-dark">0</span> <span class="input-sec-name">${line.secUnitName || ''}</span>
                                </div>
                                <input type="hidden" class="input-sec-multiplier" value="${line.secUnitMultiplier || 0}" />
                            </td>
                            <td>
                                <div class="input-group input-group-sm">
                                    <input type="number" class="form-control text-end input-price fw-medium req-add" value="${line.unitPrice}" step="0.0001" />
                                    <input type="text" class="form-control input-currency text-center fw-bold text-muted px-1 req-add" value="${line.currency}" readonly style="max-width: 65px;" />
                                </div>
                            </td>
                            <td>
                                <select class="form-select form-select-sm table-input input-vat req-add">
                                    <option value="${line.vatGroup}" data-rate="0" selected>${line.vatGroup}</option>
                                </select>
                            </td>
                            <td class="text-end align-middle fw-bold text-secondary line-total-fc small">0,00</td>
                            <td class="text-end align-middle fw-bold text-dark line-total-lc small">0,00</td>
                            <td class="text-center align-middle del-cell">
                                <button type="button" class="btn btn-sm btn-outline-danger btn-remove-row p-1 border-0" title="Sil"><i class="fas fa-trash fs-6"></i></button>
                            </td>
                        </tr>`;
                    });
                    
                    $('#linesBody').html(rowsHtml);
                    
                    $('#linesBody tr').each(function() {
                        const itemSelect = $(this).find('.item-select');
                        const whsCode = $(this).find('.input-whs').val();
                        const stockInput = $(this).find('.input-stock');
                        const itemCode = itemSelect.val();
                        
                        itemSelect.select2({ 
                            theme: 'bootstrap-5', 
                            width: '100%',
                            placeholder: '- Kalem Seçin / Yazarak Arayın -',
                            minimumInputLength: 2,
                            ajax: {
                                url: '/Rapor108/SearchItems',
                                dataType: 'json',
                                delay: 250,
                                data: function (params) { return { q: params.term }; },
                                processResults: function (data) { return { results: data.results }; },
                                cache: true
                            },
                            templateResult: formatItemDropdown,
                            templateSelection: function(item) { return item.text || item.id; }
                        });
                        
                        if (itemCode && whsCode) {
                            $.get('/Rapor108/GetItemStock', { itemCode: itemCode, whsCode: whsCode }, function(res) {
                                stockInput.text(formatNumber(res.onHand || 0));
                            });
                        }
                    });
                    
                    calculateTotals();
                    isBindingData = false;

                    toastr.info("Temel belgeden kopyalandı. Lütfen kontrol edip kaydedin.");
                    
                } else {
                    toastr.error(res.message || "Veriler alınamadı.");
                    setFormMode('ADD');
                    addRow();
                }
            }).fail(function() {
                toastr.error("Bağlantı hatası.");
            }).always(function() {
                $('#loadingOverlay').hide();
            });
        }

        function loadDeliveryDetailsFromId(docEntry) {
            $('#loadingOverlay').css('display', 'flex');
            $.get('/Rapor108/GetDeliveryDetails', { docEntry: docEntry }, function(res) {
                if(res && res.success && res.data) {
                    bindDeliveryToForm(res.data);
                } else {
                    toastr.error(res.message || "Teslimat detayları alınamadı.");
                }
            }).fail(function() {
                toastr.error("Kayıt çekilirken hata oluştu.");
            }).always(function() {
                $('#loadingOverlay').hide();
            });
        }

        function bindDeliveryToForm(res) {
            isBindingData = true; 
            currentDocEntry = res.docEntry;
            
            $('#pageTitle').html(`<i class="fas fa-file-alt text-primary me-2"></i>Teslimat Görüntüle (No: ${res.docNum})`);
            
            $('#CardCode').val(res.cardCode).trigger('change.select2');
            $('#SalesPersonCode').val(res.slpCode).trigger('change.select2');
            $('#DocDate').val(res.docDate);
            $('#DocDueDate').val(res.docDueDate);
            $('#TaxDate').val(res.taxDate);
            $('#U_BE1_AKTAR').val(res.u_BE1_AKTAR || res.U_BE1_AKTAR);
            
            $('#OrderComments').val(res.orderComments);
            $('#DeliveryComments').val(res.deliveryComments);
            $('#InvoiceComments').val(res.invoiceComments);
            $('#DeliveryDescFlag').prop('checked', res.u_BE1_DESPATCHDESC === 'Y');

            let sendType = res.u_BE1_SEND || res.U_BE1_SEND;
            $('#U_BE1_SEND').val(sendType).trigger('change');
            
            let muaf = res.u_BE1_MUAFCODE || res.U_BE1_MUAFCODE;
            if(muaf) {
                $('#U_BE1_MUAFCODE').html(`<option value="${muaf}">${muaf}</option>`).val(muaf);
            }

            $('#ShipToCode').html(`<option value="${res.shipToCode}">${res.shipToCode}</option>`).val(res.shipToCode);
            $('#PayToCode').html(`<option value="${res.payToCode}">${res.payToCode}</option>`).val(res.payToCode);
            
            if(res.addressExtension) {
                fillAddressComponent('ShipTo', {
                    street: res.addressExtension.shipToStreet, streetNo: res.addressExtension.shipToStreetNo,
                    block: res.addressExtension.shipToBlock, zipCode: res.addressExtension.shipToZipCode,
                    city: res.addressExtension.shipToCity, county: res.addressExtension.shipToCounty,
                    state: res.addressExtension.shipToState, country: res.addressExtension.shipToCountry
                });
                fillAddressComponent('PayTo', {
                    street: res.addressExtension.billToStreet, streetNo: res.addressExtension.billToStreetNo,
                    block: res.addressExtension.billToBlock, zipCode: res.addressExtension.billToZipCode,
                    city: res.addressExtension.billToCity, county: res.addressExtension.billToCounty,
                    state: res.addressExtension.billToState, country: res.addressExtension.billToCountry
                });
            } else {
                fillAddressComponent('ShipTo', null);
                fillAddressComponent('PayTo', null);
            }

            $('#DriverListSelect').val(res.u_BE1_SOFORSECIMI || res.U_BE1_SOFORSECIMI || '').trigger('change.select2');
            $('#U_BE1_SRCNAME').val(res.u_BE1_SRCNAME || res.U_BE1_SRCNAME || '');
            $('#U_BE1_SRCPLAKA').val(res.u_BE1_SRCPLAKA || res.U_BE1_SRCPLAKA || '');
            $('#U_BE1_SRCTITLE').val(res.u_BE1_SRCTITLE || res.U_BE1_SRCTITLE || '');
            $('#U_BE1_SRCVKN').val(res.u_BE1_SRCVKN || res.U_BE1_SRCVKN || '');
            $('#U_BE1_SRCKVKK').val(res.u_BE1_SRCKVKK || res.U_BE1_SRCKVKK || '');
            $('#U_BE1_FIRMANO').val(res.u_BE1_FIRMANO || res.U_BE1_FIRMANO || '');
            $('#U_BE1_SRCTEL').val(res.u_BE1_SRCTEL || res.U_BE1_SRCTEL || '');
            
            $('#U_BE1_NAKLIYETARIHI').val(res.u_BE1_NAKLIYETARIHI || res.U_BE1_NAKLIYETARIHI || '');
            $('#U_BE1_NAKLIYESAATI').val(res.u_BE1_NAKLIYESAATI || res.U_BE1_NAKLIYESAATI || '');

            $('#DocCurrency').val(res.docCurrency);
            $('#ExchangeRate').val(res.docRate.toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
            
            window.exchangeRates[res.docCurrency] = res.docRate;

            $.get('/Rapor108/GetAllExchangeRates', { date: res.docDate }, function(rates) {
                window.exchangeRates = rates;
                if($('#USDRate').length) $('#USDRate').val((rates['USD'] || 0).toFixed(4));
                if($('#EURRate').length) $('#EURRate').val((rates['EUR'] || 0).toFixed(4));
                
                let rowsHtml = '';
                let netLC = 0, taxLC = 0;
                
                res.lines.forEach((line, index) => {
                    let itemName = itemDict[line.itemCode] || '';
                    let lineRate = window.exchangeRates[line.currency] || (line.currency === res.docCurrency ? res.docRate : 1.0);
                    
                    let secQty = line.quantity * line.secUnitMultiplier;
                    let lineNetFC = line.quantity * line.unitPrice;
                    let lineNetLC = lineNetFC * lineRate;
                    
                    let vatObj = @Html.Raw(Json.Serialize(ViewBag.VatGroups));
                    let foundVat = vatObj.find(v => v.code === line.vatGroup);
                    let vRate = foundVat ? foundVat.rate : 0;
                    let lineTaxLC = lineNetLC * (vRate / 100);

                    netLC += lineNetLC;
                    taxLC += lineTaxLC;

                    rowsHtml += `
                    <tr data-btype="${line.baseType || ''}" data-bentry="${line.baseEntry || ''}" data-bline="${line.baseLine ?? ''}">
                        <td class="text-center align-middle text-muted small fw-bold">${index + 1}</td>
                        <td class="align-middle fw-medium">${line.itemCode} - ${itemName}</td>
                        <td class="align-middle">
                            <select class="form-select form-select-sm table-input input-whs" disabled style="font-size: 0.8rem; padding: 2px 4px; min-height:26px;">
                                <option value="${line.warehouseCode}">${line.warehouseCode}</option>
                            </select>
                            <div class="small text-muted mt-1" style="font-size:0.75rem;">Stok: -</div>
                        </td>
                        <td class="align-middle text-end">
                            <input type="text" class="table-input text-end fw-medium" value="${line.quantity}" readonly />
                            <div class="small text-muted mt-1" style="font-size:0.75rem;">
                                <span class="fw-bold text-dark">${formatNumber(secQty)}</span> ${line.secUnitName || ''}
                            </div>
                        </td>
                        <td class="text-end align-middle">${formatNumber(line.unitPrice)} ${line.currency}</td>
                        <td class="align-middle">${line.vatGroup}</td>
                        <td class="text-end align-middle fw-bold text-secondary small">${formatNumber(lineNetFC)} ${line.currency}</td>
                        <td class="text-end align-middle fw-bold text-dark small">${formatNumber(lineNetLC)} TRY</td>
                    </tr>`;
                });
                
                $('#linesBody').html(rowsHtml);

                let grandLC = netLC + taxLC;
                let docGrandFC = (res.docCurrency === 'TRY') ? grandLC : (grandLC / res.docRate);

                $('#lblNetTotalLC').text(formatNumber(netLC) + ' TRY');
                $('#lblTaxTotalLC').text(formatNumber(taxLC) + ' TRY');
                $('#lblGrandTotalLC').text(formatNumber(grandLC) + ' TRY');
                $('#lblGrandTotalFC').text(formatNumber(docGrandFC) + ' ' + res.docCurrency);
                
                const isClosedDoc = (res.docStatus === 'C' || res.canceled === 'Y' || res.canceled === 'y');
                setFormMode('VIEW', isClosedDoc); 
                isBindingData = false;
            });
        }

        // ==========================================
        // 5. EVENT LISTENER (DOCUMENT.READY)
        // ==========================================
        $(document).ready(function () {
            
            $('.select2-init').select2({ theme: 'bootstrap-5', width: '100%' });
            
            const baseEntryStr = '@ViewBag.BaseEntry';
            const baseTypeStr = '@ViewBag.BaseType';
            const baseEntry = baseEntryStr ? parseInt(baseEntryStr) : 0;
            const baseType = baseTypeStr ? parseInt(baseTypeStr) : 0;

            if (baseEntry > 0 && baseType > 0) {
                loadBaseDocument(baseEntry, baseType);
            } else {
                setFormMode('ADD');
                fetchAllExchangeRates();
            }

            // --- Navigasyon Butonları ---
            $('.nav-btn').click(function() {
                if (isBindingData) return;
                const dir = $(this).data('dir');
                $('#loadingOverlay').css('display', 'flex');
                
                $.get('/Rapor108/GetDeliveryNavigation', { currentDocEntry: currentDocEntry, direction: dir }, function(res) {
                    if(res && res.success && res.data) {
                        bindDeliveryToForm(res.data);
                    } else {
                        toastr.info("Bu yönde başka kayıt bulunmuyor.");
                    }
                }).fail(function() {
                    toastr.error("Kayıt çekilirken hata oluştu.");
                }).always(function() {
                    $('#loadingOverlay').hide();
                });
            });

            // --- Üst Butonlar ---
            $('#btnNewDoc').click(function() { window.location.href = '/Rapor108/Index'; });
            $('#btnFindMode').click(function() { setFormMode('FIND'); });

            $('#btnCancelDocument').click(function() {
                if (!currentDocEntry || currentDocEntry <= 0) return;
                if (confirm("Bu teslimatı iptal etmek istediğinize emin misiniz? Bu işlem geri alınamaz.")) {
                    $('#loadingOverlay').css('display', 'flex');
                    $.post('/Rapor108/CancelDelivery?docEntry=' + currentDocEntry, function(res) {
                        if (res.success) {
                            toastr.success(res.message);
                            setTimeout(() => { window.location.reload(); }, 1500);
                        } else {
                            toastr.error(res.message);
                        }
                    }).fail(function(xhr) {
                        const errMsg = xhr.responseJSON ? xhr.responseJSON.message : "İptal işlemi sırasında hata oluştu.";
                        toastr.error(errMsg);
                    }).always(function() {
                        $('#loadingOverlay').hide();
                    });
                }
            });

            $('.copy-to-target').click(function(e) {
                e.preventDefault();
                if (!currentDocEntry || currentDocEntry <= 0) return;
                const targetController = $(this).data('target');
                const url = `/${targetController}?baseType=15&baseEntry=${currentDocEntry}`;
                window.location.href = url;
            });

            // --- Tab İşlemleri ---
            $('#orderTabs a').on('click', function (e) {
                e.preventDefault();
                $(this).tab('show'); 
                if($(this).attr('id') === 'lines-tab' && currentMode === 'ADD') {
                    $('#btnAddRowContainer').show();
                } else {
                    $('#btnAddRowContainer').hide();
                }
            });

            // --- Şoför Seçimi ve Kaydı ---
            $('#DriverListSelect').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const docEntry = $(this).val();
                if(docEntry) {
                    const driver = allDrivers.find(d => d.docEntry === docEntry);
                    if(driver) {
                        $('#U_BE1_SRCNAME').val(driver.name);
                        $('#U_BE1_SRCPLAKA').val(driver.plate);
                        $('#U_BE1_SRCTITLE').val(driver.title);
                        $('#U_BE1_SRCVKN').val(driver.vkn);
                        $('#U_BE1_SRCKVKK').val(driver.kvkk);
                        $('#U_BE1_FIRMANO').val(driver.firmaNo);
                        $('#U_BE1_SRCTEL').val(driver.tel);
                    }
                } else {
                    $('#U_BE1_SRCNAME, #U_BE1_SRCPLAKA, #U_BE1_SRCTITLE, #U_BE1_SRCVKN, #U_BE1_SRCKVKK, #U_BE1_FIRMANO, #U_BE1_SRCTEL').val('');
                }
            });

            $('#btnOpenNewDriverModal').click(function() {
                if(currentMode !== 'ADD') return;
                $('#frmNewDriver')[0].reset();
                $('#newDriverModal').modal('show');
            });

            $('#btnSaveNewDriver').click(function() {
                const name = $('#nd_Name').val();
                const plate = $('#nd_Plate').val();
                const vkn = $('#nd_VKN').val();
                if(!name || !plate || !vkn) { toastr.warning("Ad/Soyad, Plaka ve TC/VKN alanları zorunludur."); return; }

                const payload = {
                    Name: name, Plate: plate, Title: $('#nd_Title').val(), VKN: vkn,
                    KVKK: $('#nd_KVKK').is(':checked') ? 'E' : 'H', FirmaNo: $('#nd_FirmaNo').val(), Tel: $('#nd_Tel').val()
                };

                const btn = $(this);
                btn.prop('disabled', true).text('Kaydediliyor...');

                $.ajax({
                    url: '/Rapor108/AddDriver', type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
                    success: function(res) {
                        if(res.success) {
                            toastr.success("Şoför sisteme eklendi ve seçildi.");
                            allDrivers.unshift(res.data); 
                            const newOption = new Option(`${res.data.name} (${res.data.plate})`, res.data.docEntry, true, true);
                            $('#DriverListSelect').append(newOption).trigger('change');
                            $('#newDriverModal').modal('hide');
                        } else { toastr.error(res.message); }
                    },
                    error: function() { toastr.error("Sunucu bağlantı hatası."); },
                    complete: function() { btn.prop('disabled', false).text('Kaydet & Seç'); }
                });
            });

            // --- Adres Kopyalama ---
            $('#copyToPayTo').click(function(e) {
                e.preventDefault();
                $('#PayToStreet').val($('#ShipToStreet').val());
                $('#PayToStreetNo').val($('#ShipToStreetNo').val());
                $('#PayToBlock').val($('#ShipToBlock').val());
                $('#PayToZipCode').val($('#ShipToZipCode').val());
                $('#PayToCounty').val($('#ShipToCounty').val());
                $('#PayToCity').val($('#ShipToCity').val());
                let country = $('#ShipToCountry').val();
                $('#PayToCountry').val(country).trigger('change.select2');
                populateStates('PayToCountry', 'PayToState', $('#ShipToState').val());
            });

            $('#copyToShipTo').click(function(e) {
                e.preventDefault();
                $('#ShipToStreet').val($('#PayToStreet').val());
                $('#ShipToStreetNo').val($('#PayToStreetNo').val());
                $('#ShipToBlock').val($('#PayToBlock').val());
                $('#ShipToZipCode').val($('#PayToZipCode').val());
                $('#ShipToCounty').val($('#PayToCounty').val());
                $('#ShipToCity').val($('#PayToCity').val());
                let country = $('#PayToCountry').val();
                $('#ShipToCountry').val(country).trigger('change.select2');
                populateStates('ShipToCountry', 'ShipToState', $('#PayToState').val());
            });

            $('#ShipToCountry').on('change', function() { if(!isBindingData) populateStates('ShipToCountry', 'ShipToState'); });
            $('#PayToCountry').on('change', function() { if(!isBindingData) populateStates('PayToCountry', 'PayToState'); });

            // --- Fatura Tipi / Muafiyet ---
            $('#U_BE1_SEND').on('change', function() {
                if(isBindingData) return; 
                const sendType = $(this).find("option:selected").text(); 
                const muafSelect = $('#U_BE1_MUAFCODE');
                
                muafSelect.empty().append('<option value="">- Muafiyet Kodu -</option>');

                if(currentMode === 'ADD' && (sendType.includes("SATIS") || sendType.includes("IADE") || sendType === "")) {
                    muafSelect.prop('disabled', true).prop('required', false);
                    return;
                }
                if (currentMode === 'ADD') { muafSelect.prop('disabled', false).prop('required', true); }

                let targetType = "";
                if(sendType.includes("ISTISNA")) targetType = "ISTISNA";
                else if(sendType.includes("OZELMATRAH")) targetType = "OZELMATRAH";
                else if(sendType.includes("TEVKIFAT")) targetType = "TEVKIFAT";
                else if(sendType.includes("IHRACKAYITLI")) targetType = "IHRACKAYITLI";

                if(targetType !== "") {
                    const filteredCodes = allMuafCodes.filter(c => c.type === targetType);
                    filteredCodes.forEach(c => {
                        muafSelect.append(`<option value="${c.code}">${c.code} - ${c.name}</option>`);
                    });
                }
            });

            $('#U_BE1_AKTAR').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                if ($(this).val() === 'X') {
                    $('#linesBody tr').each(function() { $(this).find('.input-vat').val('S05'); });
                    calculateTotals();
                    toastr.info("İşlem Tipi 'X' seçildiği için vergi kodları S05 olarak güncellendi.");
                }
            });

            // --- Müşteri Seçimi ---
            $('#CardCode').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const cardCode = $(this).val();
                if(!cardCode) return;

                $.get('/Rapor108/GetCustomerInfo', { cardCode: cardCode }, function(res) {
                    currentBpCurrency = res.currency;
                    $('#CurrencyType').val('BP'); 
                    $('#DocCurrency').val(currentBpCurrency);
                    
                    const docRate = window.exchangeRates[currentBpCurrency] || 1.0;
                    $('#ExchangeRate').val(docRate.toLocaleString('tr-TR', { minimumFractionDigits: 4 }));

                    if(res.slpCode && res.slpCode !== -1) {
                        $('#SalesPersonCode').val(res.slpCode).trigger('change.select2');
                    }
                    triggerItemPriceUpdate(); 
                });

                $.get('/Rapor108/GetCustomerAddresses', { cardCode: cardCode }, function(res) {
                    let shipHtml = '<option value="">- Seçiniz -</option>';
                    let payHtml = '<option value="">- Seçiniz -</option>';
                    window.bpAddresses = res; 

                    res.forEach(addr => {
                        if(addr.addressType === 'S') shipHtml += `<option value="${addr.addressName}">${addr.addressName}</option>`;
                        if(addr.addressType === 'B') payHtml += `<option value="${addr.addressName}">${addr.addressName}</option>`;
                    });

                    $('#ShipToCode').html(shipHtml);
                    $('#PayToCode').html(payHtml);
                    
                    if(res.find(a => a.addressType === 'S')) $('#ShipToCode').val(res.find(a => a.addressType === 'S').addressName).trigger('change');
                    if(res.find(a => a.addressType === 'B')) $('#PayToCode').val(res.find(a => a.addressType === 'B').addressName).trigger('change');
                });
            });

            $('#ShipToCode').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const val = $(this).val();
                const addr = window.bpAddresses?.find(a => a.addressName === val && a.addressType === 'S');
                fillAddressComponent('ShipTo', addr);
            });

            $('#PayToCode').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const val = $(this).val();
                const addr = window.bpAddresses?.find(a => a.addressName === val && a.addressType === 'B');
                fillAddressComponent('PayTo', addr);
            });

            // --- Kur ve Tarih Değişimleri ---
            $('#CurrencyType').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const type = $(this).val();
                if(type === 'BP') { $('#DocCurrency').val(currentBpCurrency).prop('disabled', false); } 
                else if(type === 'LC') { $('#DocCurrency').val('TRY').prop('disabled', true); } 
                else if(type === 'SC') { $('#DocCurrency').val('TRY').prop('disabled', false); }
                
                const docCur = $('#DocCurrency').val();
                const docRate = window.exchangeRates[docCur] || 1.0;
                $('#ExchangeRate').val(docRate.toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
                calculateTotals();
            });

            $('#DocCurrency').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const docCur = $(this).val() || 'TRY';
                const docRate = window.exchangeRates[docCur] || 1.0;
                $('#ExchangeRate').val(docRate.toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
                calculateTotals();
            });

            $('#DocDate').on('change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                fetchAllExchangeRates(); 
            });

            $('#USDRate').on('input change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                window.exchangeRates['USD'] = parseFloat($(this).val()) || 0;
                if ($('#DocCurrency').val() === 'USD') $('#ExchangeRate').val(window.exchangeRates['USD'].toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
                calculateTotals();
            });

            $('#EURRate').on('input change', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                window.exchangeRates['EUR'] = parseFloat($(this).val()) || 0;
                if ($('#DocCurrency').val() === 'EUR') $('#ExchangeRate').val(window.exchangeRates['EUR'].toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
                calculateTotals();
            });

            // --- Satır İşlemleri ---
            $('#btnAddRow').click(function () { if(currentMode === 'ADD') addRow(); });

            $(document).on('click', '.btn-remove-row', function () {
                if(currentMode !== 'ADD') return;
                $(this).closest('tr').find('.item-select').select2('destroy'); 
                $(this).closest('tr').remove();
                updateRowIndexes();
                calculateTotals();
            });

            $(document).on('input', '.input-qty, .input-price', function () { if(currentMode === 'ADD') calculateTotals(); });
            $(document).on('change', '.input-vat, .input-currency', function () { if(currentMode === 'ADD') calculateTotals(); });

            $(document).on('change', '.item-select', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                
                const row = $(this).closest('tr');
                const itemCode = $(this).val();
                const cardCode = $('#CardCode').val();
                
                const priceInput = row.find('.input-price');
                const curInput = row.find('.input-currency');
                const whsInput = row.find('.input-whs');
                const stockInput = row.find('.input-stock');
                const secNameInput = row.find('.input-sec-name');
                const multiplierInput = row.find('.input-sec-multiplier');

                if (!itemCode) {
                    priceInput.val(0);
                    stockInput.text('0');
                    multiplierInput.val(0);
                    calculateTotals();
                    return;
                }

                if (!whsInput.val()) whsInput.val('01');
                whsInput.trigger('change'); 

                if(cardCode) {
                    $.get('/Rapor108/GetItemPrice', { cardCode: cardCode, itemCode: itemCode }, function(res) {
                        if(res) {
                            priceInput.val(res.price > 0 ? res.price : 0);
                            curInput.val(res.currency || 'TRY'); 
                            secNameInput.text(res.secUnitName || '');
                            multiplierInput.val(res.secUnitMultiplier || 0);
                            
                            if(res.dfltWH && res.dfltWH !== whsInput.val()) { whsInput.val(res.dfltWH).trigger('change'); }
                        } else {
                            priceInput.val(0); curInput.val('TRY'); multiplierInput.val(0);
                        }
                        calculateTotals();
                    });
                }
            });

            $(document).on('change', '.input-whs', function() {
                if(isBindingData || currentMode !== 'ADD') return;
                const row = $(this).closest('tr');
                const itemCode = row.find('.item-select').val();
                const whsCode = $(this).val();
                const stockInput = row.find('.input-stock');
                
                if (itemCode && whsCode) {
                    $.get('/Rapor108/GetItemStock', { itemCode: itemCode, whsCode: whsCode }, function(res) { stockInput.text(formatNumber(res.onHand || 0)); });
                } else {
                    stockInput.text('0');
                }
            });

            // --- Açık Siparişler Modal ---
            $('#btnOpenOrders').click(function() {
                if(currentMode !== 'ADD') return;
                const cardCode = $('#CardCode').val();
                if(!cardCode) { toastr.warning("Açık siparişleri görebilmek için önce müşteri seçmelisiniz."); return; }

                $('#loadingOverlay').css('display', 'flex');
                $.get('/Rapor108/GetOpenOrders', { cardCode: cardCode }, function(res) {
                    $('#loadingOverlay').hide();
                    if(res.success && res.data && res.data.length > 0) {
                        let html = '';
                        res.data.forEach(o => {
                            html += `<tr>
                                <td class="fw-bold">${o.docNum}</td>
                                <td>${o.docDate}</td>
                                <td>${o.docDueDate}</td>
                                <td class="text-end fw-bold text-success">${formatNumber(o.docTotal)} ${o.docCur}</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-primary" onclick="selectOpenOrder(${o.docEntry})">
                                        <i class="fas fa-hand-pointer me-1"></i>Seç
                                    </button>
                                </td>
                            </tr>`;
                        });
                        $('#openOrdersBody').html(html);
                        $('#openOrdersModal').modal('show');
                    } else {
                        toastr.info("Bu müşteriye ait aktarılabilecek açık sipariş bulunamadı.");
                    }
                }).fail(function() {
                    $('#loadingOverlay').hide();
                    toastr.error("Siparişler sorgulanırken hata oluştu.");
                });
            });

            // --- Bağlantı Haritası Modal ---
            $('#btnRelMap').click(function() {
                if(!currentDocEntry || currentDocEntry <= 0) return;
                
                $('#loadingOverlay').css('display', 'flex');
                $.get('/Rapor108/GetRelationshipMap', { docEntry: currentDocEntry }, function(res) {
                    $('#loadingOverlay').hide();
                    if(res.success && res.data) {
                        let html = '';
                        res.data.forEach(node => {
                            let icon = 'fa-file-alt'; let color = 'text-secondary'; let borderClass = 'border';
                            
                            if(node.docType === 'Sipariş') { icon = 'fa-cart-plus'; color = 'text-primary'; borderClass = 'border-primary'; }
                            if(node.docType === 'İrsaliye') { icon = 'fa-truck-loading'; color = 'text-warning'; borderClass = 'border-warning'; }
                            if(node.docType === 'Fatura') { icon = 'fa-file-invoice-dollar'; color = 'text-success'; borderClass = 'border-success'; }
                            if(node.docType === 'İade') { icon = 'fa-undo'; color = 'text-danger'; borderClass = 'border-danger'; }

                            let statusBadge = node.docStatus === 'Açık' ? 'bg-success' : 'bg-secondary';
                            let cancelBadge = node.canceled ? `<span class="badge bg-danger ms-1">${node.canceled}</span>` : '';
                            let linkLabel = node.linkType === 'Source' ? 'Kaynak Belge' : (node.linkType === 'Self' ? 'Geçerli Belge' : 'Hedef Belge');

                            html += `<li class="list-group-item d-flex justify-content-between align-items-center mb-2 rounded shadow-sm ${borderClass} border-2 border-top-0 border-bottom-0 border-end-0">
                                <div>
                                    <i class="fas ${icon} ${color} me-3 fs-4 align-middle"></i>
                                    <strong class="fs-6">${node.docType} No: ${node.docNum}</strong>
                                    <div class="small text-muted mt-1"><i class="far fa-calendar-alt me-1"></i>${node.docDate}</div>
                                </div>
                                <div class="text-end">
                                    <span class="badge ${statusBadge}">${node.docStatus}</span>
                                    ${cancelBadge}
                                    <div class="mt-1"><span class="badge bg-light text-dark border small">${linkLabel}</span></div>
                                </div>
                            </li>`;
                        });
                        $('#relMapBody').html(html);
                        $('#relationshipMapModal').modal('show');
                    } else { toastr.error(res.message || "Bağlantı haritası oluşturulamadı."); }
                }).fail(function() {
                    $('#loadingOverlay').hide();
                    toastr.error("Harita verisi çekilirken sunucu hatası oluştu.");
                });
            });

            // --- Form Gönderimi (Ara & Kaydet) ---
            $('#deliveryForm').submit(function (e) {
                e.preventDefault();
                
                if(currentMode === 'FIND') {
                    const searchPayload = {
                        DocNum: $('#SearchDocNum').val() ? parseInt($('#SearchDocNum').val()) : null,
                        CardCode: $('#CardCode').val(),
                        SlpCode: $('#SalesPersonCode').val() ? parseInt($('#SalesPersonCode').val()) : null,
                        DocDate: $('#DocDate').val() || null, 
                        DocDueDate: $('#DocDueDate').val() || null,
                        TaxDate: $('#TaxDate').val() || null,
                        U_BE1_AKTAR: $('#U_BE1_AKTAR').val(),
                        U_BE1_SEND: $('#U_BE1_SEND').val(),
                        U_BE1_MUAFCODE: $('#U_BE1_MUAFCODE').val(),
                        DocCurrency: $('#DocCurrency').val()
                    };
                    
                    $('#loadingOverlay').css('display', 'flex');
                    
                    $.ajax({
                        url: '/Rapor108/FindDelivery', type: 'POST', contentType: 'application/json', data: JSON.stringify(searchPayload),
                        success: function (res) {
                            if (res.success && res.data && res.data.length > 0) {
                                if (res.data.length === 1) { loadDeliveryDetailsFromId(res.data[0].docEntry); } 
                                else { populateSearchResults(res.data); }
                            } else { toastr.warning(res.message || "Kayıt bulunamadı."); }
                        },
                        error: function () { toastr.error("Arama sırasında hata oluştu."); },
                        complete: function () { $('#loadingOverlay').hide(); }
                    });
                    return;
                }
                
                if(currentMode === 'VIEW') return;

                const cardCode = $('#CardCode').val();
                if (!cardCode) { toastr.warning("Lütfen müşteri seçiniz."); return; }
                if (!$('#SalesPersonCode').val()) { toastr.warning("Lütfen satış temsilcisi seçiniz."); return; }
                if (!$('#DocDate').val() || !$('#DocDueDate').val() || !$('#TaxDate').val()) { toastr.warning("Lütfen tüm tarihleri eksiksiz giriniz."); return; }
                
                if (!$('#DriverListSelect').val()) { 
                    toastr.warning("Lütfen şoför seçiniz."); $('#transport-tab').tab('show'); return; 
                }

                if (!$('#U_BE1_SRCNAME').val() || !$('#U_BE1_SRCPLAKA').val() || !$('#U_BE1_SRCVKN').val()) {
                    toastr.warning("Seçilen şoförün Ad/Soyad, Plaka ve TC/VKN bilgileri eksik olamaz."); $('#transport-tab').tab('show'); return;
                }

                if (!$('#ShipToStreet').val() || !$('#ShipToCity').val() || !$('#ShipToCounty').val() || !$('#ShipToZipCode').val() || !$('#ShipToCountry').val()) {
                    toastr.warning("Sevkiyat adresi için Adres Satır 1, İl, İlçe, Posta Kodu ve Ülke alanları zorunludur."); $('#logistics-tab').tab('show'); return;
                }

                if (!$('#PayToStreet').val() || !$('#PayToCity').val() || !$('#PayToCounty').val() || !$('#PayToZipCode').val() || !$('#PayToCountry').val()) {
                    toastr.warning("Fatura adresi için Adres Satır 1, İl, İlçe, Posta Kodu ve Ülke alanları zorunludur."); $('#logistics-tab').tab('show'); return;
                }

                const documentLines = [];
                let hasError = false;

                $('#linesBody tr').each(function (index) {
                    const itemCode = $(this).find('.item-select').val();
                    const qty = parseFloat($(this).find('.input-qty').val()) || 0;
                    const price = parseFloat($(this).find('.input-price').val()) || 0;
                    const lineCur = $(this).find('.input-currency').val();
                    const vatGroup = $(this).find('.input-vat').val();
                    const whsCode = $(this).find('.input-whs').val(); 
                    
                    const bType = $(this).data('btype');
                    const bEntry = $(this).data('bentry');
                    const bLine = $(this).data('bline');

                    if (!itemCode) { hasError = true; toastr.error(`${index + 1}. satırda kalem seçiniz.`); return false; }
                    if (!whsCode) { hasError = true; toastr.error(`${index + 1}. satır için depo seçiniz.`); return false; }
                    if (qty <= 0) { hasError = true; toastr.error(`${index + 1}. satır için miktar 0'dan büyük olmalıdır.`); return false; }
                    if (price <= 0) { hasError = true; toastr.error(`${index + 1}. satır için geçerli bir fiyat giriniz.`); return false; }
                    if (!vatGroup) { hasError = true; toastr.error(`${index + 1}. satır için işlem tipi (KDV) seçiniz.`); return false; }

                    documentLines.push({ 
                        ItemCode: itemCode, Quantity: qty, UnitPrice: price, Currency: lineCur, 
                        VatGroup: vatGroup, WarehouseCode: whsCode,
                        BaseType: bType !== "" ? parseInt(bType) : null,
                        BaseEntry: bEntry !== "" ? parseInt(bEntry) : null,
                        BaseLine: bLine !== "" ? parseInt(bLine) : null
                    });
                });

                if (hasError) { $('#lines-tab').tab('show'); return; }
                if (documentLines.length === 0) { toastr.warning("Teslimata en az bir kalem ekleyiniz."); $('#lines-tab').tab('show'); return; }

                const docCur = $('#DocCurrency').val() || 'TRY';
                let docRateStr = $('#ExchangeRate').val().replace(/\./g, '').replace(',', '.');
                let docRate = parseFloat(docRateStr) || 1.0;

                const payload = {
                    CardCode: cardCode,
                    DocDate: $('#DocDate').val(), DocDueDate: $('#DocDueDate').val(), TaxDate: $('#TaxDate').val(), 
                    SalesPersonCode: parseInt($('#SalesPersonCode').val()),
                    DocCurrency: docCur, DocRate: docRate,
                    USDRate: parseFloat($('#USDRate').val()) || 0,
                    EURRate: parseFloat($('#EURRate').val()) || 0,
                    UpdateGlobalRates: $('#UpdateGlobalRates').is(':checked'),
                    U_BE1_AKTAR: $('#U_BE1_AKTAR').val(), U_BE1_SEND: $('#U_BE1_SEND').val(), U_BE1_MUAFCODE: $('#U_BE1_MUAFCODE').val(),
                    
                    OrderComments: $('#OrderComments').val(), OrderDescFlag: $('#OrderDescFlag').is(':checked') ? 'Y' : 'N',
                    DeliveryComments: $('#DeliveryComments').val(), DeliveryDescFlag: $('#DeliveryDescFlag').is(':checked') ? 'Y' : 'N',
                    InvoiceComments: $('#InvoiceComments').val(), InvoiceDescFlag: $('#InvoiceDescFlag').is(':checked') ? 'Y' : 'N',
                    
                    U_BE1_NAKLIYETARIHI: $('#U_BE1_NAKLIYETARIHI').val(), U_BE1_NAKLIYESAATI: $('#U_BE1_NAKLIYESAATI').val(),
                    U_BE1_SOFORSECIMI: $('#DriverListSelect').val(), U_BE1_SOFORADSOYAD: $('#U_BE1_SRCNAME').val(),
                    U_BE1_ARACPLAKASI: $('#U_BE1_SRCPLAKA').val(), U_BE1_SOFORUNVANI: $('#U_BE1_SRCTITLE').val(),
                    U_BE1_SOFORKIMLIK: $('#U_BE1_SRCVKN').val(), U_BE1_SOFORTEL: $('#U_BE1_SRCTEL').val(), U_BE1_FRMNO: $('#U_BE1_FIRMANO').val(),
                    
                    PayToCode: $('#PayToCode').val(), ShipToCode: $('#ShipToCode').val(),
                    AddressExtension: {
                        ShipToStreet: $('#ShipToStreet').val(), ShipToStreetNo: $('#ShipToStreetNo').val(),
                        ShipToBlock: $('#ShipToBlock').val(), ShipToZipCode: $('#ShipToZipCode').val(),
                        ShipToCity: $('#ShipToCity').val(), ShipToCounty: $('#ShipToCounty').val(),
                        ShipToState: $('#ShipToState').val(), ShipToCountry: $('#ShipToCountry').val(),
                        
                        BillToStreet: $('#PayToStreet').val(), BillToStreetNo: $('#PayToStreetNo').val(),
                        BillToBlock: $('#PayToBlock').val(), BillToZipCode: $('#PayToZipCode').val(),
                        BillToCity: $('#PayToCity').val(), BillToCounty: $('#PayToCounty').val(),
                        BillToState: $('#PayToState').val(), BillToCountry: $('#PayToCountry').val()
                    },
                    DocumentLines: documentLines
                };

                $('#loadingOverlay').css('display', 'flex');

                $.ajax({
                    url: '/Rapor108/CreateDelivery', type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            toastr.success(res.message);
                            setTimeout(() => { window.location.href = '/Rapor108/Index'; }, 2000); 
                        } else { toastr.error(res.message); }
                    },
                    error: function (xhr) {
                        const errMsg = xhr.responseJSON ? xhr.responseJSON.message : "Bağlantı hatası.";
                        toastr.error(errMsg);
                    },
                    complete: function () { $('#loadingOverlay').hide(); }
                });
            });
            
            $('#btnCancel').click(function() {
                if(currentMode === 'VIEW' || currentMode === 'FIND') {
                    setFormMode('ADD');
                    fetchAllExchangeRates();
                } else {
                    window.location.href = '/Rapor108/Index';
                }
            });
        });
    </script>
}