<template id="rowTemplate">
    <tr data-btype="" data-bentry="" data-bline="">
        <td class="text-center align-middle row-index text-muted small fw-bold">1</td>
        <td>
            <select class="form-select item-select req-add">
                <option value="">- Kalem Seçin / Yazarak Arayın -</option>
            </select>
        </td>
        <td class="align-middle">
            <select class="form-select form-select-sm table-input input-whs req-add" style="font-size: 0.8rem; padding: 2px 4px; min-height:26px;">
                <option value="">Depo Seç</option>
                @foreach (var whs in warehouses)
                {
                    if(whs.WhsCode == "01")
                    {
                        <option value="@whs.WhsCode" selected="selected">@whs.WhsCode</option>
                    }
                    else
                    {
                        <option value="@whs.WhsCode">@whs.WhsCode</option>
                    }
                }
            </select>
            <div class="small text-muted mt-1" style="font-size:0.75rem;">Stok: <span class="input-stock fw-bold text-dark">0</span></div>
        </td>
        <td class="align-middle text-end">
            <input type="number" class="table-input text-end input-qty fw-medium req-add" value="1" min="0.01" step="0.01" />
            <div class="small text-muted mt-1" style="font-size:0.75rem;">
                <span class="input-sec-total fw-bold text-dark">0</span> <span class="input-sec-name"></span>
            </div>
            <input type="hidden" class="input-sec-multiplier" value="0" />
        </td>
        <td>
            <div class="input-group input-group-sm">
                <input type="number" class="form-control text-end input-price fw-medium req-add" value="0.00" min="0" step="0.0001" />
                <select class="form-select input-currency text-center fw-bold text-muted px-1 req-add" style="max-width: 65px;">
                    @if(currencies != null)
                    {
                        foreach(var c in currencies)
                        {
                            <option value="@c">@c</option>
                        }
                    }
                </select>
            </div>
        </td>
        <td>
            <select class="form-select form-select-sm table-input input-vat req-add">
                <option value="">İşlem Tipi Seç</option>
                @foreach(var vat in vatGroups)
                {
                    if(vat.Code == "S01")
                    {
                        <option value="@vat.Code" data-rate="@vat.Rate" selected>@vat.Code (@vat.Rate.ToString("0")%)</option>
                    }
                    else
                    {
                        <option value="@vat.Code" data-rate="@vat.Rate">@vat.Code (@vat.Rate.ToString("0")%)</option>
                    }
                }
            </select>
        </td>
        <td class="text-end align-middle fw-bold text-secondary line-total-fc small">0,00</td>
        <td class="text-end align-middle fw-bold text-dark line-total-lc small">0,00</td>
        <td class="text-center align-middle del-cell">
            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-row p-1 border-0" title="Sil"><i class="fas fa-trash fs-6"></i></button>
        </td>
    </tr>
</template>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    <script>
        // ==========================================
        // 1. GLOBAL DEĞİŞKENLER VE AYARLAR
        // ==========================================
        toastr.options = { positionClass: "toast-bottom-right", timeOut: "3000" };

        let currentBpCurrency = 'TRY'; 
        window.exchangeRates = { 'TRY': 1.0 }; 
        window.bpAddresses = []; 
        
        let currentMode = 'ADD'; 
        let isBindingData = false; 
        let currentDocEntry = 0; 

        const allMuafCodes = @Html.Raw(Json.Serialize(ViewBag.MuafCodes ?? new List<WebApplication3.Controllers.Rapor108Controller.MuafCodeModel>()));
        const allStates = @Html.Raw(Json.Serialize(states));
        let allDrivers = @Html.Raw(Json.Serialize(drivers)); 

        const itemDict = {};
        @foreach(var item in items) {
            <text>itemDict['@item.ItemCode'] = '@item.ItemName.Replace("'", "\\'")';</text>
        }

        // ==========================================
        // 2. YARDIMCI (HELPER) FONKSİYONLAR
        // ==========================================
        function formatNumber(num) {
            return num.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function formatItemDropdown(item) {
            if (item.loading) { return item.text; }
            if (!item.id) { return item.text; }
            var stockInfo = item.stock || $(item.element).data('stock') || "Stok Yok";
            return $(
                '<div>' +
                '<div style="font-weight:600; color:#1e293b;">' + item.text + '</div>' +
                '<div style="font-size:0.8rem; color:#10b981; margin-top:2px;">' +
                '<i class="fas fa-boxes me-1"></i>' + stockInfo + 
                '</div>' +
                '</div>'
            );
        }

        function updateRowIndexes() {
            $('#linesBody tr').each(function (index) { $(this).find('.row-index').text(index + 1); });
        }

        function resetTotals() {
            $('#lblNetTotalLC').text('0,00 TRY');
            $('#lblTaxTotalLC').text('0,00 TRY');
            $('#lblGrandTotalLC').text('0,00 TRY');
            $('#lblGrandTotalFC').text('0,00');
        }

        function calculateTotals() {
            if(currentMode !== 'ADD') return;
            
            let netTotalLC = 0, taxTotalLC = 0;
            const docCurrency = $('#DocCurrency').val() || 'TRY';
            
            let docRateStr = $('#ExchangeRate').val();
            let docRate = 1.0;
            if(docRateStr) docRate = parseFloat(docRateStr.replace(/\./g, '').replace(',', '.')) || 1.0;

            $('#linesBody tr').each(function () {
                const qty = parseFloat($(this).find('.input-qty').val()) || 0;
                const price = parseFloat($(this).find('.input-price').val()) || 0;
                const lineCur = $(this).find('.input-currency').val() || 'TRY';
                const vatRate = parseFloat($(this).find('.input-vat option:selected').data('rate')) || 0;
                
                const secMultiplier = parseFloat($(this).find('.input-sec-multiplier').val()) || 0;
                const secTotal = qty * secMultiplier;
                $(this).find('.input-sec-total').text(formatNumber(secTotal));

                const lineRate = window.exchangeRates[lineCur] || (lineCur === docCurrency ? docRate : 1.0);
                const lineNetFC = qty * price;
                const lineNetLC = lineNetFC * lineRate;
                const lineTaxLC = lineNetLC * (vatRate / 100);

                $(this).find('.line-total-fc').text(formatNumber(lineNetFC) + ' ' + lineCur);
                $(this).find('.line-total-lc').text(formatNumber(lineNetLC) + ' TRY');
                
                netTotalLC += lineNetLC; 
                taxTotalLC += lineTaxLC;
            });

            const grandTotalLC = netTotalLC + taxTotalLC;
            const docGrandTotalFC = (docCurrency === 'TRY') ? grandTotalLC : (grandTotalLC / docRate);

            $('#lblNetTotalLC').text(formatNumber(netTotalLC) + ' TRY');
            $('#lblTaxTotalLC').text(formatNumber(taxTotalLC) + ' TRY');
            $('#lblGrandTotalLC').text(formatNumber(grandTotalLC) + ' TRY');
            $('#lblGrandTotalFC').text(formatNumber(docGrandTotalFC) + ' ' + docCurrency);
        }

        function addRow() {
            const template = document.getElementById('rowTemplate').innerHTML;
            const $newRow = $(template);
            $('#linesBody').append($newRow);
            
            $newRow.find('.item-select').select2({ 
                theme: 'bootstrap-5', 
                width: '100%',
                placeholder: '- Kalem Seçin / Yazarak Arayın -',
                minimumInputLength: 2,
                language: {
                    inputTooShort: function() { return "Aramak için en az 2 karakter girin..."; },
                    searching: function() { return "Aranıyor..."; },
                    noResults: function() { return "Sonuç bulunamadı"; }
                },
                ajax: {
                    url: '/Rapor108/SearchItems',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) { return { q: params.term }; },
                    processResults: function (data) { return { results: data.results }; },
                    cache: true
                },
                templateResult: formatItemDropdown,
                templateSelection: function(item) { return item.text || item.id; }
            });
            
            $newRow.find('.input-whs').val('01');
            
            if ($('#U_BE1_AKTAR').val() === 'X') {
                $newRow.find('.input-vat').val('S05');
            } else {
                $newRow.find('.input-vat').val('S01');
            }
            
            updateRowIndexes();
        }

        function fetchAllExchangeRates() {
            if(currentMode !== 'ADD') return;
            const date = $('#DocDate').val();
            $.get('/Rapor108/GetAllExchangeRates', { date: date }, function(res) {
                window.exchangeRates = res;
                const docCur = $('#DocCurrency').val() || 'TRY';
                const docRate = window.exchangeRates[docCur] || 1.0;
                $('#ExchangeRate').val(docRate.toLocaleString('tr-TR', { minimumFractionDigits: 4 }));
                
                if($('#USDRate').length) {
                    const usdRate = window.exchangeRates['USD'] || 0;
                    $('#USDRate').val(usdRate.toFixed(4));
                }
                if($('#EURRate').length) {
                    const eurRate = window.exchangeRates['EUR'] || 0;
                    $('#EURRate').val(eurRate.toFixed(4));
                }

                calculateTotals();
            });
        }

        function populateStates(countrySelectId, stateSelectId, selectedState = '') {
            const countryCode = $('#' + countrySelectId).val();
            const stateSelect = $('#' + stateSelectId);
            stateSelect.empty().append('<option value="">- Seçiniz -</option>');
            
            if(countryCode) {
                const filteredStates = allStates.filter(s => s.country === countryCode);
                filteredStates.forEach(s => {
                    stateSelect.append(`<option value="${s.code}">${s.name}</option>`);
                });
            }
            if(selectedState) {
                stateSelect.val(selectedState).trigger('change.select2');
            }
        }

        function fillAddressComponent(prefix, addr) {
            $(`#${prefix}Street`).val(addr ? addr.street : '');
            $(`#${prefix}StreetNo`).val(addr ? addr.streetNo : '');
            $(`#${prefix}Block`).val(addr ? addr.block : '');
            $(`#${prefix}ZipCode`).val(addr ? addr.zipCode : '');
            $(`#${prefix}County`).val(addr ? addr.county : '');
            $(`#${prefix}City`).val(addr ? addr.city : '');
            
            if(addr && addr.country) {
                $(`#${prefix}Country`).val(addr.country).trigger('change.select2');
                populateStates(`${prefix}Country`, `${prefix}State`, addr.state);
            } else {
                $(`#${prefix}Country`).val('').trigger('change.select2');
                $(`#${prefix}State`).empty().append('<option value="">- Seçiniz -</option>');
            }
        }

        function triggerItemPriceUpdate() {
            if(currentMode !== 'ADD') return;
            $('#linesBody tr').each(function() {
                const itemSelect = $(this).find('.item-select');
                if(itemSelect.val()) itemSelect.trigger('change'); 
            });
        }

        function populateSearchResults(list) {
            let html = '';
            list.forEach(row => {
                html += `
                <tr onclick="loadDeliveryAndCloseModal(${row.docEntry})">
                    <td class="fw-bold">${row.docNum}</td>
                    <td>${row.cardCode}</td>
                    <td class="text-truncate" style="max-width: 200px;">${row.cardName || ''}</td>
                    <td>${row.docDate}</td>
                    <td><span class="badge bg-secondary">${row.docCurrency}</span></td>
                </tr>`;
            });
            $('#searchResultsBody').html(html);
            $('#searchResultsModal').modal('show');
        }

        window.loadDeliveryAndCloseModal = function(docEntry) {
            $('#searchResultsModal').modal('hide');
            loadDeliveryDetailsFromId(docEntry);
        }

        window.selectOpenOrder = function(docEntry) {
            $('#openOrdersModal').modal('hide');
            loadBaseDocument(docEntry, 17); 
        }

        // ==========================================
        // 3. FORM MODU (ADD / VIEW / FIND) AYARLAYICI
        // ==========================================
        function setFormMode(mode, isClosed = false) {
            currentMode = mode;
            
            $('#pageTitle .badge.bg-danger').remove(); 
            $('#pageTitle .badge.bg-secondary').remove(); 
            $('#pageTitle .badge.bg-success').remove(); 
            
            if (mode === 'VIEW') {
                $('#mainContainer').removeClass('find-mode').addClass('view-mode');
                $('.searchable-field').prop('disabled', true);
                
                $('#OrderComments, #DeliveryComments, #InvoiceComments').prop('disabled', true);
                $('#UpdateGlobalRates').prop('disabled', true);
                $('#USDRate, #EURRate').prop('disabled', true);

                $('.req-add').prop('required', false);

                $('#DocNum').val(currentDocEntry).prop('disabled', true);

                $('#btnAddRowContainer, .del-cell, #colDelIcon').hide();
                $('#btnSave').hide();
                $('#btnOpenNewDriverModal').hide(); 
                
                $('#btnCancelDocument').show();
                $('#btnCopyToContainer').show();
                $('#btnRelMap').show();
                
                $('#btnCancel').text("Yeni Ekle").removeClass('btn-light').addClass('btn-primary text-white').prop('disabled', false);
                
                $('#divDocNumSearch').hide();
                $('#tabsCard, #footerSection').show();
                
                $('#btnOpenOrders').hide(); 

