            else { 
                $('#mainContainer').removeClass('view-mode find-mode');
                
                $('.searchable-field').prop('disabled', false);
                $('#USDRate, #EURRate').prop('disabled', false);
                $('#UpdateGlobalRates').prop('disabled', false);
                
                $('#OrderComments, #DeliveryComments, #InvoiceComments').prop('disabled', false).val('');
