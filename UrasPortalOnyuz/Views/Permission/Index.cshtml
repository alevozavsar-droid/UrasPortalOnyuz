@model Dictionary<string, List<WebApplication3.Models.AppMenu>>
@{
    ViewData["Title"] = "Sistem Yetki Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var roles = ViewBag.Roles as List<WebApplication3.Models.AppRole>;
    var databases = ViewBag.Databases as List<WebApplication3.Models.AppDatabase>;
    var kategoriler = ViewBag.Categories as List<string> ?? new List<string>();
    var baslikTanimlari = ViewBag.MenuCategories as List<WebApplication3.Models.AppMenuCategory>
                          ?? new List<WebApplication3.Models.AppMenuCategory>();

    string[] borderColors = { "primary", "warning", "success", "danger", "purple" };
    int colorIndex = 0;
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7fc; font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #2b3445; }
        
        .dashboard-card { background: #ffffff; border-radius: 12px; border: 1px solid #eef2f7; box-shadow: 0 2px 6px rgba(0,0,0,0.03); transition: all 0.3s ease; position: relative; overflow: hidden; }
        .hover-elevate:hover { transform: translateY(-4px); box-shadow: 0 8px 15px rgba(0,0,0,0.08); }
        
        .border-top-primary { border-top: 4px solid #3b82f6 !important; }
        .border-top-warning { border-top: 4px solid #f59e0b !important; }
        .border-top-danger { border-top: 4px solid #ef4444 !important; }
        .border-top-success { border-top: 4px solid #10b981 !important; }
        .border-top-purple { border-top: 4px solid #8b5cf6 !important; }
        .border-top-info { border-top: 4px solid #0dcaf0 !important; }

        .role-list-item { border: none; border-bottom: 1px solid #f1f5f9; padding: 15px 20px; transition: all 0.2s; cursor: pointer; display: flex; flex-direction: column; justify-content: center; }
        .role-list-item:last-child { border-bottom: none; }
        .role-list-item:hover { background-color: #f8fafc; padding-left: 25px; border-left: 3px solid #cbd5e1; }
        .role-list-item.active-role { background-color: #eff6ff; border-left: 4px solid #3b82f6; padding-left: 25px; box-shadow: inset 0 2px 4px rgba(0,0,0,0.02); }
        
        .role-code-badge { background-color: #e2e8f0; color: #475569; border-radius: 6px; padding: 4px 8px; font-weight: 700; font-size: 11px; }
        .active-role .role-code-badge { background-color: #3b82f6; color: #ffffff; }

        .category-title { font-size: 13px; font-weight: 800; color: #334155; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #f1f5f9; padding-bottom: 10px; margin-bottom: 15px; }
        
        .menu-item-row { padding: 8px 10px; border-radius: 6px; transition: background-color 0.2s; }
        .menu-item-row:hover { background-color: #f8fafc; }
        
        .form-check-input { cursor: pointer; border-color: #cbd5e1; }
        .form-check-label { cursor: pointer; font-size: 13px; font-weight: 600; color: #475569; margin-top: 3px; }
        
        /* ---- Kullanıcı yetkileri ---- */
        .yonetim-sekme .nav-link { border-radius: 10px; font-weight: 600; font-size: .86rem; color: #475569; padding: 9px 16px; margin-right: 6px; background: #fff; border: 1px solid #e2e8f0; }
        .yonetim-sekme .nav-link:hover { background: #eef7ff; color: #2563eb; }
        .yonetim-sekme .nav-link.active { background: linear-gradient(135deg,#3b82f6,#6366f1); color: #fff; border-color: transparent; box-shadow: 0 6px 14px rgba(59,130,246,.25); }
        .kisi-panel { padding: 0; overflow: hidden; }
        .kisi-liste { }
        .kisi-satir { display: flex; gap: 10px; align-items: center; padding: 10px 14px; border-bottom: 1px solid #f1f5f9; cursor: pointer; transition: background .15s; }
        .kisi-satir:hover { background: #f8fafc; }
        .kisi-satir.aktif { background: #eef7ff; box-shadow: inset 4px 0 0 #3b82f6; }
        .kisi-satir.kilitli { opacity: .75; background: #fafafa; }
        .kisi-altsekme { display: flex; background: #f1f5f9; border-radius: 9px; padding: 3px; gap: 3px; }
        .kisi-altsekme button { flex: 1; border: none; background: transparent; color: #475569; font-weight: 600; font-size: .76rem; padding: 5px 8px; border-radius: 7px; cursor: pointer; }
        .kisi-altsekme button .cnt { font-size: .66rem; background: #e2e8f0; color: #475569; border-radius: 20px; padding: 1px 7px; margin-left: 4px; }
        .kisi-altsekme button.active { background: #fff; color: #2563eb; box-shadow: 0 1px 4px rgba(15,23,42,.12); }
        .kisi-altsekme button[data-durum="pasif"].active { color: #b91c1c; }
        .kisi-altsekme button.active .cnt { background: #dbeafe; color: #1d4ed8; }
        .kisi-altsekme button[data-durum="pasif"].active .cnt { background: #fee2e2; color: #b91c1c; }
        .kisi-kilit { border: 1px solid #e2e8f0; background: #fff; color: #64748b; border-radius: 7px; font-size: .66rem; font-weight: 700; padding: 2px 7px; cursor: pointer; white-space: nowrap; flex: 0 0 auto; }
        .kisi-kilit:hover { border-color: #f59e0b; color: #b45309; background: #fffbeb; }
        .kisi-kilit.aktifle:hover { border-color: #16a34a; color: #15803d; background: #f0fdf4; }
        .kisi-avatar { width: 36px; height: 36px; border-radius: 50%; color: #fff; font-weight: 700; font-size: .8rem; display: flex; align-items: center; justify-content: center; flex: 0 0 36px; letter-spacing: .03em; }
        .kisi-avatar.buyuk { width: 48px; height: 48px; flex-basis: 48px; font-size: 1rem; }
        .kisi-kod { font-weight: 700; font-size: .84rem; color: #1e293b; }
        .kisi-yetki { background: #e2e8f0; color: #475569; border-radius: 6px; padding: 1px 7px; font-size: .68rem; font-weight: 700; }
        .kisi-ad { font-size: .76rem; color: #475569; }
        .kisi-alt { font-size: .7rem; color: #94a3b8; }
        .kisi-baslik { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; padding: 16px 20px; border-bottom: 1px solid #eef2f7; background: linear-gradient(180deg,#fbfcfe,#f5f7fb); position: sticky; top: 0; z-index: 3; }
        .kisi-bos { text-align: center; color: #94a3b8; padding: 90px 20px; }
        .kisi-bos i { font-size: 3rem; opacity: .35; }
        .kisi-bolum { margin-bottom: 18px; }
        .kisi-bolum-baslik { display: flex; justify-content: space-between; align-items: center; font-weight: 700; font-size: .86rem; color: #1e293b; margin-bottom: 8px; padding-bottom: 6px; border-bottom: 1px dashed #e2e8f0; }
        .kisi-bolum-baslik a { font-size: .74rem; font-weight: 600; text-decoration: none; }
        .kisi-chip { display: inline-flex; align-items: center; gap: 6px; border: 1px solid #e2e8f0; border-radius: 999px; padding: 4px 12px 4px 8px; font-size: .78rem; background: #fff; cursor: pointer; transition: all .15s; margin: 0; }
        .kisi-chip:has(input:checked) { background: #eef7ff; border-color: #3b82f6; color: #1d4ed8; font-weight: 600; }
        .kisi-chip input { margin: 0; }
        .kisi-kat-kart { border: 1px solid #e9eef5; border-radius: 12px; background: #fff; height: 100%; overflow: hidden; }
        .kisi-kat-baslik { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; background: #f8fafc; font-weight: 700; font-size: .78rem; color: #334155; cursor: pointer; border-bottom: 1px solid #eef2f7; }
        .kisi-kat-baslik:hover { background: #eef7ff; }
        .kisi-kat-sayac { font-size: .68rem; background: #e2e8f0; color: #475569; border-radius: 999px; padding: 1px 8px; font-weight: 600; }
        .kisi-kat-sayac.tam { background: #3b82f6; color: #fff; }
        .kisi-menu { display: flex; align-items: center; gap: 8px; padding: 5px 12px; font-size: .78rem; margin: 0; cursor: pointer; border-bottom: 1px solid #f6f8fb; }
        .kisi-menu:hover { background: #f8fafc; }
        .kisi-menu:has(input:checked) { background: #f0f7ff; color: #1d4ed8; font-weight: 600; }
        .kisi-menu input { margin: 0; }
        #kisiEditor { }
        
        .nav-tabs .nav-link { color: #64748b; font-size: 14px; border: none; border-bottom: 2px solid transparent; padding: 10px 20px; }
        .nav-tabs .nav-link:hover { border-color: #cbd5e1; }
        .nav-tabs .nav-link.active { color: #3b82f6; border-color: #3b82f6; background: transparent; font-weight: 700; }

        /* ==================================================================
           MODERN GÖRÜNÜM KATMANI (portalın yeni tasarım dili)
           ================================================================== */
        body { background-color: var(--bg-main, #f4f6fb); }

        .dashboard-card {
            border-radius: var(--r-lg, 18px);
            border: 1px solid var(--border-color, #e8ecf4);
            box-shadow: var(--shadow-sm);
        }

        /* Sekmeler: hap görünümü */
        .nav-tabs { border-bottom: none !important; gap: 8px; }
        .nav-tabs .nav-link {
            border: 1px solid var(--border-color, #e8ecf4) !important;
            border-radius: 999px !important;
            background: var(--bg-card, #fff);
            padding: .45rem 1.15rem !important;
            font-size: .84rem; font-weight: 600;
        }
        .nav-tabs .nav-link:hover { background: var(--metro-primary-light, #eef7ff); color: var(--metro-primary, #009ef7); }
        .nav-tabs .nav-link.active {
            background: linear-gradient(135deg,#009ef7,#6366f1) !important;
            color: #fff !important; border-color: transparent !important;
            box-shadow: 0 5px 14px rgba(0,158,247,.28);
        }

        /* Rol listesi */
        .role-list-item { padding: 12px 18px; border-radius: 12px; margin: 4px 8px; border-bottom: none; }
        .role-list-item:hover { background: var(--metro-primary-light, #eef7ff); padding-left: 22px; border-left: none; }
        .role-list-item.active-role {
            background: linear-gradient(135deg, rgba(0,158,247,.12), rgba(99,102,241,.12));
            border-left: 3px solid var(--metro-primary, #009ef7);
            box-shadow: none;
        }
        .role-code-badge { border-radius: 7px; font-size: 10.5px; letter-spacing: .04em; }
        .active-role .role-code-badge { background: linear-gradient(135deg,#009ef7,#6366f1); }

        /* Kategori kartları */
        .category-title {
            font-size: .72rem; letter-spacing: .08em;
            border-bottom: 2px solid var(--border-color, #eef2f7);
            display: flex; align-items: center; justify-content: space-between; gap: 8px;
        }
        .kategori-sayac {
            font-size: .65rem; font-weight: 800; padding: .15rem .5rem; border-radius: 999px;
            background: var(--metro-primary-light, #eef7ff); color: var(--metro-primary, #009ef7);
        }
        .menu-item-row { padding: 6px 8px; border-radius: 8px; }
        .menu-item-row:hover { background: var(--metro-primary-light, #eef7ff); }
        .form-check-label { font-size: 12.5px; }

        .menu-list { max-height: 320px; overflow-y: auto; padding-right: 4px; }
        .menu-list::-webkit-scrollbar { width: 8px; }
        .menu-list::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 8px; }

        /* Arama ve toplu seçim çubuğu */
        .yetki-arac-cubugu {
            background: var(--bg-card, #fff); border: 1px solid var(--border-color, #e8ecf4);
            border-radius: var(--r-lg, 18px); padding: 12px 14px; margin-bottom: 1rem;
            display: flex; gap: 10px; align-items: center; flex-wrap: wrap;
            box-shadow: var(--shadow-sm);
        }
        .yetki-arac-cubugu .form-control { height: 38px; border-radius: 10px; font-size: .84rem; }

        .kategori-gizli { display: none !important; }

        .btn { border-radius: 10px; font-weight: 600; }
        .text-purple { color: #8b5cf6 !important; }

        /* Rapor duzenleme kalemi: satirin uzerine gelince cikar */
        .menu-duzenle {
            opacity: 0; border: none; background: transparent; cursor: pointer;
            color: var(--text-secondary, #64748b); padding: 2px 6px; border-radius: 6px;
            font-size: .78rem; transition: opacity .15s ease, background .15s ease;
        }
        .menu-item-row:hover .menu-duzenle { opacity: 1; }
        .menu-duzenle:hover { background: var(--metro-primary-light, #eef7ff); color: var(--metro-primary, #009ef7); }

        .baslik-duzenle {
            border: none; background: transparent; cursor: pointer; padding: 0 4px;
            color: var(--text-secondary, #94a3b8); font-size: .7rem;
        }
        .baslik-duzenle:hover { color: var(--metro-primary, #009ef7); }

        .menu-sira {
            font-size: .62rem; font-weight: 800; color: var(--text-secondary, #94a3b8);
            min-width: 18px; text-align: right;
        }

        /* ---- Menu / sirket secim kutulari: net gorunur tik ---- */
        .menu-item-row { display: flex; align-items: center; gap: 10px; padding-left: 8px !important; }
        .menu-item-row .form-check-input {
            flex: 0 0 auto;
            width: 1.15rem; height: 1.15rem;
            margin: 0; float: none;
            border: 2px solid #b8c2d4; border-radius: 5px;
            background-color: #fff;
            cursor: pointer; transition: background-color .15s ease, border-color .15s ease;
        }
        .menu-item-row .form-check-input:hover { border-color: var(--metro-primary, #009ef7); }
        .menu-item-row .form-check-input:checked {
            background-color: var(--metro-primary, #009ef7);
            border-color: var(--metro-primary, #009ef7);
        }
        .menu-item-row .form-check-input:focus {
            box-shadow: 0 0 0 3px rgba(0,158,247,.22); border-color: var(--metro-primary, #009ef7);
        }
        .menu-item-row .form-check-label { margin: 0; flex: 1; min-width: 0; }
        .menu-item-row:has(.form-check-input:checked) {
            background: var(--metro-primary-light, #eef7ff);
        }
        .menu-item-row:has(.form-check-input:checked) .form-check-label {
            color: var(--metro-primary, #009ef7); font-weight: 700;
        }
    </style>
}

<div class="container-fluid py-4">
    @Html.AntiForgeryToken()
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-dark" style="letter-spacing: -0.5px;">Kullanıcı Yetki Yönetimi</h4>
            <span class="text-muted" style="font-size: 14px;">Her kullanıcının görebileceği raporlar ve şirketler kişi bazında tanımlanır.</span>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <!-- YENİ EKLENEN ŞİRKETLERİ SENKRONİZE ET BUTONU -->
            <button class="btn btn-outline-warning rounded-pill px-3 shadow-sm hover-elevate fw-bold bg-white" onclick="syncDatabases()">
                <i class="fas fa-sync me-1"></i> Şirketleri Çek
            </button>

            <!-- SAP KULLANICI YÖNETİMİ BUTONU -->
            <button class="btn btn-outline-success rounded-pill px-3 shadow-sm hover-elevate fw-bold bg-white" onclick="openSapUserModal()">
                <i class="fas fa-users-cog me-1"></i> SAP Kullanıcı
            </button>
            <button class="btn btn-outline-primary rounded-pill px-3 shadow-sm hover-elevate fw-bold bg-white" onclick="$('#addReportModal').modal('show')">
                <i class="fas fa-plus me-1"></i> Yeni Rapor
            </button>
        </div>
    </div>

    <!-- ================= SEKMELER ================= -->
    <ul class="nav nav-pills yonetim-sekme mb-3" id="permissionsTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="kisi-tab" data-bs-toggle="tab" data-bs-target="#kisi-pane" type="button" role="tab">
                <i class="fas fa-user-shield me-2"></i>Kullanıcı Yetkileri
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="rapor-tab" data-bs-toggle="tab" data-bs-target="#rapor-pane" type="button" role="tab">
                <i class="fas fa-eye me-2"></i>Rapor Bazlı Yetki
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="menus-tab" data-bs-toggle="tab" data-bs-target="#menus-pane" type="button" role="tab">
                <i class="fas fa-file-alt me-2"></i>Raporlar & Menüler
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="dbs-tab" data-bs-toggle="tab" data-bs-target="#dbs-pane" type="button" role="tab">
                <i class="fas fa-database me-2"></i>Şirketler
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="cats-tab" data-bs-toggle="tab" data-bs-target="#cats-pane" type="button" role="tab">
                <i class="fas fa-folder-tree me-2"></i>Menü Başlıkları
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="yeni-tab" data-bs-toggle="tab" data-bs-target="#yeni-pane" type="button" role="tab">
                <i class="fas fa-wand-magic-sparkles me-2"></i>Projeden Algılananlar
                <span id="yeniRaporRozet" class="badge bg-danger ms-1" style="display:none;">0</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="sistem-tab" data-bs-toggle="tab" data-bs-target="#sistem-pane" type="button" role="tab">
                <i class="fas fa-server me-2"></i>Sistem İşlemleri
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="wa-tab" data-bs-toggle="tab" data-bs-target="#wa-pane" type="button" role="tab">
                <i class="fab fa-whatsapp me-2"></i>WhatsApp
            </button>
        </li>
    </ul>

    <div class="tab-content" id="permissionsTabContent">

        <!-- ================= SİSTEM İŞLEMLERİ (Bakım Planla / Sistemi Kapat / Üretim Portalı) ================= -->
        <div class="tab-pane fade" id="sistem-pane" role="tabpanel">
            <div class="row g-3">
                <div class="col-xl-4 col-md-6">
                    <div class="dashboard-card hover-elevate p-4 h-100" style="border-top: 4px solid #f59e0b;">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-3" style="width:48px;height:48px;background:linear-gradient(135deg,#f59e0b,#f97316);color:#fff;font-size:1.25rem;"><i class="fas fa-tools"></i></span>
                            <div><h5 class="fw-bold mb-0">Bakım Planla</h5><small class="text-muted">Planlı bakım duyurusu ve sürüm notları</small></div>
                        </div>
                        <p class="text-muted" style="font-size:.85rem;">Tüm kullanıcılara üst şeritte geri sayımlı bakım uyarısı gösterir; sürüm notlarını son değişikliklerden otomatik doldurabilir. Aynı pencereden bakımı iptal edebilirsiniz.</p>
                        <button type="button" class="btn btn-warning fw-bold text-white w-100" onclick="if (typeof bakimPlaniOlustur === 'function') bakimPlaniOlustur(); else Swal.fire('Uyarı', 'Bu işlev bu sayfada yüklenmedi; sayfayı yenileyin.', 'warning');">
                            <i class="fas fa-tools me-1"></i> Bakım Planla / İptal Et
                        </button>
                    </div>
                </div>
                <div class="col-xl-4 col-md-6">
                    <div class="dashboard-card hover-elevate p-4 h-100" style="border-top: 4px solid #ef4444;">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-3" style="width:48px;height:48px;background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;font-size:1.25rem;"><i class="fas fa-power-off"></i></span>
                            <div><h5 class="fw-bold mb-0">Sistemi Kapat</h5><small class="text-muted">Acil durum: uygulamayı çevrim dışına al</small></div>
                        </div>
                        <p class="text-muted" style="font-size:.85rem;">Sunucuda <code>app_offline.htm</code> oluşturur; tüm kullanıcılar için site anında kapanır. Geri açmak için dosyanın sunucudan silinmesi gerekir. <b>Geri alınamaz, iki kez sorulur.</b></p>
                        <button type="button" class="btn btn-danger fw-bold w-100" onclick="if (typeof imhaEtProtokolu === 'function') imhaEtProtokolu(); else Swal.fire('Uyarı', 'Bu işlev bu sayfada yüklenmedi; sayfayı yenileyin.', 'warning');">
                            <i class="fas fa-skull-crossbones me-1"></i> Sistemi Kapat
                        </button>
                    </div>
                </div>
                <div class="col-xl-4 col-md-12">
                    <div class="dashboard-card hover-elevate p-4 h-100" style="border-top: 4px solid #2563eb;">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-3" style="width:48px;height:48px;background:linear-gradient(135deg,#2563eb,#0ea5e9);color:#fff;font-size:1.25rem;"><i class="fas fa-industry"></i></span>
                            <div><h5 class="fw-bold mb-0">Uras Üretim Portalı</h5><small class="text-muted">Giriş düğmesi ve ekran yetkileri</small></div>
                        </div>
                        <p class="text-muted mb-2" style="font-size:.85rem;">
                            Sol menüdeki <b>Uras Üretim Portalı</b> düğmesi, <b>Kullanıcı Yetkileri</b> sekmesinde <i>Uras Üretim: Portal › Uras Üretim Portalı (Giriş Düğmesi)</i> işaretli kullanıcılara görünür.
                            Portal içindeki ekranlar da aynı sekmedeki <i>Uras Üretim: …</i> başlıklarından kişi bazında verilir; verilmeyen ekran portal menüsünde çıkmaz ve adresten de açılamaz.
                        </p>
                        <a class="btn btn-outline-primary fw-bold w-100" href="/UrasUretim" target="_blank" rel="noopener"><i class="fas fa-arrow-up-right-from-square me-1"></i> Portalı Aç</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= WHATSAPP EKSTRE ASİSTANI ================= -->
        <div class="tab-pane fade" id="wa-pane" role="tabpanel">
            <div class="row g-3">
                <div class="col-xl-7">
                    <div class="dashboard-card p-4 h-100" style="border-top: 4px solid #25d366;">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-3" style="width:48px;height:48px;background:linear-gradient(135deg,#25d366,#128c7e);color:#fff;font-size:22px;"><i class="fab fa-whatsapp"></i></span>
                            <div><h5 class="fw-bold mb-0">WhatsApp Cari Ekstre Asistanı</h5><small class="text-muted">Satışçı şirket hattına cari adını yazar, ekstre PDF'i otomatik gelir</small></div>
                            <span class="ms-auto badge rounded-pill" id="waAnahtarRozet">…</span>
                        </div>
                        <p class="text-muted mb-3" style="font-size:.85rem;">Yalnızca aşağıdaki numaralar cevap alır. Her numara bir portal kullanıcısına bağlanır; o kullanıcının <b>şirket yetkileri</b> geçerlidir. Komutlar: <code>ekstre AKSA</code>, <code>şirket</code>, <code>tarih 2025</code>, <code>yardım</code>.</p>
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-md-3"><label class="form-label small fw-bold mb-1">Telefon</label><input id="waTelefon" class="form-control form-control-sm" placeholder="0532 123 45 67" /></div>
                            <div class="col-md-3"><label class="form-label small fw-bold mb-1">Portal kullanıcısı</label><select id="waKullanici" class="form-select form-select-sm"></select></div>
                            <div class="col-md-2"><label class="form-label small fw-bold mb-1">Ad</label><input id="waAd" class="form-control form-control-sm" placeholder="Ahmet" /></div>
                            <div class="col-md-2"><label class="form-label small fw-bold mb-1">Varsayılan şirket</label><select id="waSirket" class="form-select form-select-sm"><option value="">(ilk yetkili)</option></select></div>
                            <div class="col-md-1"><label class="form-label small fw-bold mb-1" title="WhatsApp kimliği (lid): numara çözülemezse asistanın cevabında yazar, buraya girilir">Kimlik</label><input id="waLid" class="form-control form-control-sm" placeholder="1802…" /></div>
                            <div class="col-md-1 d-grid"><button type="button" class="btn btn-sm btn-success fw-bold" id="waEkleBtn" title="Ekle / güncelle"><i class="fas fa-plus"></i></button></div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0" id="waTablo">
                                <thead class="table-light"><tr><th>Telefon</th><th>Kullanıcı</th><th>Ad</th><th>Varsayılan şirket</th><th>Aktif</th><th style="width:60px"></th></tr></thead>
                                <tbody><tr><td colspan="6" class="text-center text-muted py-3">yükleniyor…</td></tr></tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-xl-5">
                    <div class="dashboard-card p-4 h-100" style="border-top: 4px solid #0ea5e9;">
                        <h6 class="fw-bold mb-1"><i class="fas fa-vial me-2 text-info"></i>Deneme (köprü olmadan)</h6>
                        <p class="text-muted mb-2" style="font-size:.82rem;">Seçtiğin numaradan mesaj gelmiş gibi işler; cevabı ve PDF'i burada görürsün.</p>
                        <div class="row g-2 mb-2">
                            <div class="col-5"><select id="waSimTelefon" class="form-select form-select-sm"></select></div>
                            <div class="col-5"><input id="waSimMesaj" class="form-control form-control-sm" placeholder="ekstre AKSA" /></div>
                            <div class="col-2 d-grid"><button type="button" class="btn btn-sm btn-info text-white fw-bold" id="waSimBtn"><i class="fas fa-paper-plane"></i></button></div>
                        </div>
                        <div id="waSimCevap" class="border rounded-3 p-3 bg-light" style="min-height:120px;white-space:pre-wrap;font-size:.85rem;"><span class="text-muted">Cevap burada görünür.</span></div>
                        <h6 class="fw-bold mt-3 mb-1"><i class="fas fa-list me-2 text-secondary"></i>Son mesajlar</h6>
                        <div class="table-responsive" style="max-height:260px;overflow:auto;">
                            <table class="table table-sm mb-0" id="waLogTablo" style="font-size:.78rem;"><thead class="table-light"><tr><th>Zaman</th><th>Telefon</th><th>Mesaj</th><th>Cevap</th><th>PDF</th></tr></thead><tbody></tbody></table>
                        </div>
                        <div class="mt-3 small text-muted">Köprü kurulumu: <code>Tools\whatsapp-koprusu\README.md</code></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= KULLANICI YETKİLERİ ================= -->
        <div class="tab-pane fade show active" id="kisi-pane" role="tabpanel">
            <div class="row g-3">
                <div class="col-xl-3 col-lg-4">
                    <div class="dashboard-card kisi-panel">
                        <div class="p-3 border-bottom">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                                <input type="text" class="form-control border-start-0" id="kisiAra" placeholder="Kullanıcı ara..." onkeyup="kisiListesiCiz()">
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2" style="font-size:.72rem;">
                                <span class="text-muted" id="kisiSayac"></span>
                                <label class="text-muted mb-0" style="cursor:pointer"><input type="checkbox" id="kisiSadeceYetkili" class="form-check-input me-1" checked onchange="kisiListesiCiz()">Sadece yetki kodu olanlar</label>
                            </div>
                            @* Aktif / Pasif alt sekmeleri: pasif = SAP'de kilitli kullanıcı (giremez, atama listelerinde görünmez) *@
                            <div class="kisi-altsekme mt-2">
                                <button type="button" class="active" data-durum="aktif" onclick="kisiDurumSec('aktif')"><i class="fas fa-user-check me-1"></i>Aktif <span class="cnt" id="kisiCntAktif">0</span></button>
                                <button type="button" data-durum="pasif" onclick="kisiDurumSec('pasif')"><i class="fas fa-user-slash me-1"></i>Pasif <span class="cnt" id="kisiCntPasif">0</span></button>
                            </div>
                        </div>
                        <div id="kisiListe" class="kisi-liste"><div class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin"></i></div></div>
                    </div>
                </div>
                <div class="col-xl-9 col-lg-8">
                    <div class="dashboard-card kisi-panel">
                        <div id="kisiEditor">
                            <div class="kisi-bos">
                                <i class="fas fa-user-shield"></i>
                                <div class="fw-bold mt-2">Bir kullanıcı seçin</div>
                                <div class="text-muted small">Soldaki listeden kullanıcıyı seçince görebileceği raporlar ve şirketler burada düzenlenir.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= RAPOR BAZLI YETKİ ================= -->
        <div class="tab-pane fade" id="rapor-pane" role="tabpanel">
            <div class="row g-3">
                <div class="col-xl-3 col-lg-4">
                    <div class="dashboard-card kisi-panel">
                        <div class="p-3 border-bottom">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                                <input type="text" class="form-control border-start-0" id="rbRaporAra" placeholder="Rapor ara..." onkeyup="rbRaporListesiCiz()">
                            </div>
                            <div class="text-muted mt-2" style="font-size:.72rem;" id="rbRaporSayac"></div>
                        </div>
                        <div id="rbRaporListe" class="kisi-liste" style="max-height:72vh; overflow:auto;"></div>
                    </div>
                </div>
                <div class="col-xl-9 col-lg-8">
                    <div class="dashboard-card kisi-panel">
                        <div id="rbEditor">
                            <div class="kisi-bos">
                                <i class="fas fa-eye"></i>
                                <div class="fw-bold mt-2">Bir rapor seçin</div>
                                <div class="text-muted small">Soldaki listeden raporu seçince onu görebilen kullanıcılar burada listelenir; kullanıcı eklenir ya da çıkarılır.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

                    <!-- RAPOR VE MENÜLER SEKMESİ -->
                    <div class="tab-pane fade" id="menus-pane" role="tabpanel">

                        <div class="yetki-arac-cubugu">
                            <div class="input-group" style="width:280px;">
                                <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted" style="font-size:.78rem;"></i></span>
                                <input type="text" class="form-control border-start-0 ps-0" id="menuArama"
                                       placeholder="Rapor ara..." onkeyup="menuAra()">
                            </div>

                            <span class="ms-auto text-muted" style="font-size:.78rem;"><i class="fas fa-info-circle me-1"></i>Rapor adı, başlığı, ikonu ve sırası buradan düzenlenir; kimin göreceği "Kullanıcı Yetkileri" sekmesinde.</span>
                        </div>

                        <div class="row g-3">
                            @if (Model != null && Model.Any())
                            {
                                foreach (var category in Model)
                                {
                                    string cardBorderColor = borderColors[colorIndex % borderColors.Length];
                                    colorIndex++;

                                    string catIcon = category.Key.ToLower() switch
                                    {
                                        var k when k.Contains("finans") => "fas fa-coins text-warning",
                                        var k when k.Contains("satış") => "fas fa-shopping-cart text-primary",
                                        var k when k.Contains("muhasebe") => "fas fa-calculator text-success",
                                        var k when k.Contains("satınalma") => "fas fa-truck-loading text-purple",
                                        var k when k.Contains("üretim") => "fas fa-industry text-danger",
                                        var k when k.Contains("cari") => "fas fa-users text-info",
                                        var k when k.Contains("stok") => "fas fa-boxes text-secondary",
                                        var k when k.Contains("ithalat") || k.Contains("ihracat") => "fas fa-globe text-primary",
                                        _ => "fas fa-folder-open text-dark"
                                    };

                                    <div class="col-xl-4 col-md-6">
                                        <div class="dashboard-card border-top-@cardBorderColor hover-elevate p-4 h-100">
                                            <div class="category-title">
                                                <span>
                                                    <i class="@catIcon me-2"></i> @category.Key
                                                    <button type="button" class="baslik-duzenle"
                                                            title="Başlığı yeniden adlandır"
                                                            onclick="baslikDuzenle('@Html.Raw(Html.Encode(category.Key))')">
                                                        <i class="fas fa-pen"></i>
                                                    </button>
                                                </span>
                                                <span class="kategori-sayac">@category.Value.Count</span>
                                            </div>
                                            
                                            <div class="menu-list">
                                                @foreach (var menu in category.Value)
                                                {
                                                    <div class="form-check menu-item-row d-flex align-items-center" data-menu-id="@menu.Id">
                                                        <label class="form-check-label w-100 @(menu.IsActive ? "" : "text-muted text-decoration-line-through")" style="padding-left:2px;">
                                                            @menu.MenuTitle
                                                            @if (!menu.IsActive)
                                                            {
                                                                <span class="badge bg-secondary ms-1" style="font-size:.6rem;">GİZLİ</span>
                                                            }
                                                        </label>
                                                        <span class="menu-sira" title="Sıra">@menu.DisplayOrder</span>
                                                        <button type="button" class="menu-duzenle" title="Raporu düzenle"
                                                                data-id="@menu.Id" data-baslik="@menu.MenuTitle" data-kategori="@menu.Category" data-ikon="@menu.Icon" data-sira="@menu.DisplayOrder"
                                                                onclick="menuDuzenleBtn(this)">
                                                            <i class="fas fa-pen"></i>
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-12 text-center py-5">
                                    <i class="fas fa-box-open fa-3x text-muted mb-3 opacity-50"></i>
                                    <h5 class="text-muted">Henüz sistemde rapor bulunmuyor.</h5>
                                    <p class="text-muted">Lütfen önce İlk Kurulum (Seed) işlemini yapın veya Yeni Rapor Ekle butonunu kullanın.</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- ŞİRKET/VERİTABANI SEKMESİ -->
                    <div class="tab-pane fade" id="dbs-pane" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="dashboard-card border-top-info hover-elevate p-4">
                                    <div class="category-title text-info">
                                        <span><i class="fas fa-building me-2"></i> Erişilebilir Şirketler (Veritabanları)</span>
                                    </div>
                                    <div class="text-muted mb-3" style="font-size:.78rem;">
                                        Kullanıcıların hangi şirketleri göreceği "Kullanıcı Yetkileri" sekmesinden verilir. Buradaki <b>Görünen Ad</b>,
                                        şirket seçicisinde ve raporlarda gösterilen isimdir; veritabanı bağlantısı (DbKey) değişmez.
                                        <b>Önerilen Adları Doldur</b> tüm şirketlere okunaklı ad yazar (<code>_AS</code>/<code>_A.S</code> ve yıl taşıyanların sonuna <b>A.Ş.</b>);
                                        sonra istediğinizi satırdan elle değiştirebilirsiniz.
                                    </div>
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        <button type="button" class="btn btn-sm btn-primary" onclick="sirketAdlariniDoldur(false)"><i class="fas fa-wand-magic-sparkles me-1"></i> Önerilen Adları Doldur (tümü)</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="sirketAdlariniDoldur(true)" title="Yalnızca hâlâ ham veritabanı adı taşıyan şirketleri doldurur"><i class="fas fa-broom me-1"></i> Yalnızca Boşları Doldur</button>
                                        <input type="text" class="form-control form-control-sm ms-auto" style="max-width:240px;" placeholder="Şirket ara…" oninput="sirketAra(this.value)">
                                    </div>
                                    @{
                                        var tumSirketler = ViewBag.TumSirketler as List<WebApplication3.Models.AppDatabase> ?? new List<WebApplication3.Models.AppDatabase>();
                                        var sirketDbAdlari = ViewBag.SirketDbAdlari as Dictionary<string, string> ?? new Dictionary<string, string>();
                                    }
                                    @if (tumSirketler.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm align-middle" id="tblSirketler" style="font-size:.85rem;">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th style="width:26%;">Veritabanı</th>
                                                        <th style="width:34%;">Görünen Ad (seçicide böyle görünür)</th>
                                                        <th style="width:24%;">Öneri</th>
                                                        <th class="text-center" style="width:8%;">Seçicide</th>
                                                        <th style="width:8%;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var db in tumSirketler)
                                                    {
                                                        string dbAdi = sirketDbAdlari.TryGetValue(db.DbKey, out var _a) ? _a : "";
                                                        string oneri = WebApplication3.Controllers.PermissionController.SirketAdiOner(string.IsNullOrEmpty(dbAdi) ? db.Display : dbAdi);
                                                        <tr data-sirket-id="@db.Id" class="@(db.IsActive ? "" : "table-secondary opacity-75")">
                                                            <td>
                                                                <span class="fw-bold">@(string.IsNullOrEmpty(dbAdi) ? db.DbKey : dbAdi)</span>
                                                                <small class="d-block text-muted" style="font-size:10px;">@db.DbKey</small>
                                                            </td>
                                                            <td><input type="text" class="form-control form-control-sm sirket-ad" value="@db.Display" maxlength="100" onkeydown="if(event.key==='Enter'){sirketAdiKaydet(@db.Id);}"></td>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(oneri) && oneri != db.Display)
                                                                {
                                                                    <a href="javascript:void(0)" class="text-decoration-none" title="Öneriyi kutuya yaz" onclick="sirketOneriUygula(@db.Id, this.dataset.oneri)" data-oneri="@oneri"><i class="fas fa-arrow-left me-1 small"></i>@oneri</a>
                                                                }
                                                                else { <span class="text-success small"><i class="fas fa-check me-1"></i>Uygun</span> }
                                                            </td>
                                                            <td class="text-center">
                                                                <div class="form-check form-switch d-inline-block m-0">
                                                                    <input class="form-check-input" type="checkbox" @(db.IsActive ? "checked" : "") onchange="sirketAktifDegistir(@db.Id, this.checked)" title="Kapalıysa şirket seçicide görünmez (yetkiler silinmez)">
                                                                </div>
                                                            </td>
                                                            <td class="text-end"><button type="button" class="btn btn-sm btn-success" onclick="sirketAdiKaydet(@db.Id)" title="Görünen adı kaydet"><i class="fas fa-save"></i></button></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted">Şirket veritabanı bulunamadı. Lütfen "Şirketleri Çek" butonunu kullanarak yeni veritabanlarını aktarın.</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MENÜ BAŞLIKLARI SEKMESİ -->
                    <!-- PROJEDEN ALGILANAN RAPORLAR -->
                    <div class="tab-pane fade" id="yeni-pane" role="tabpanel">

                        <div class="alert alert-info border-0 d-flex align-items-start gap-2">
                            <i class="fas fa-circle-info mt-1"></i>
                            <div class="small">
                                Projede kodu bulunan ama <b>menüye hiç eklenmemiş</b> raporlar burada listelenir.
                                <br>
                                <b class="text-danger">Önemli:</b> Menüde kaydı olmayan bir rapor yetki denetiminden
                                geçmez; adresini bilen her kullanıcı açabilir. Buradan ekleyip yetkilendirin.
                            </div>
                        </div>

                        <div class="yetki-arac-cubugu">
                            <button type="button" class="btn btn-sm btn-primary" onclick="yeniRaporlariTara()">
                                <i class="fas fa-rotate me-1"></i>Projeyi Tara
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="yeniTumunuSec(true)">
                                <i class="fas fa-check-double me-1"></i>Tümünü Seç
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="yeniTumunuSec(false)">
                                <i class="fas fa-xmark me-1"></i>Seçimi Temizle
                            </button>
                            <button type="button" class="btn btn-sm btn-success fw-bold ms-auto" id="btnYeniEkle"
                                    onclick="yeniRaporlariEkle()" disabled>
                                <i class="fas fa-plus me-1"></i>Seçilenleri Menüye Ekle (<span id="yeniSecimSayisi">0</span>)
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:40px;"></th>
                                        <th style="width:150px;">Controller</th>
                                        <th style="width:150px;">Adres</th>
                                        <th>Menüde Görünecek Ad</th>
                                        <th style="width:230px;">Hangi Başlık Altına</th>
                                    </tr>
                                </thead>
                                <tbody id="tbody-yeni-raporlar">
                                    <tr><td colspan="5" class="text-center text-muted py-4">
                                        <i class="fas fa-hand-pointer me-1"></i>Projeyi Tara deyin
                                    </td></tr>
                                </tbody>
                            </table>
                        </div>

                        <datalist id="yeniKategoriListesi"></datalist>
                    </div>

                    <div class="tab-pane fade" id="cats-pane" role="tabpanel">
                        <div class="dashboard-card border-top-purple hover-elevate p-4">
                            <div class="category-title">
                                <span><i class="fas fa-folder-tree me-2 text-purple"></i> Sol Menüdeki Başlıklar</span>
                                <button type="button" class="btn btn-sm btn-primary" onclick="baslikEkle()">
                                    <i class="fas fa-plus me-1"></i> Yeni Başlık
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-dark ms-1" onclick="menuDuzeniUygula()" title="Başlıkları rapor/işlem ayrımıyla üst gruplar altında birleştirip sıralar; önce önizleme gösterir">
                                    <i class="fas fa-wand-magic-sparkles me-1"></i> Önerilen Düzeni Uygula
                                </button>
                            </div>

                            <div class="text-muted mb-3" style="font-size:.78rem;">
                                Buradaki ad, ikon ve sıra sol menüye doğrudan yansır. Sıra küçükten büyüğe dizilir.
                                Bir başlığın adını değiştirdiğinizde altındaki tüm raporlar da o adla taşınır.
                                <b>Üst Grup</b> yazılan başlıklar sol menüde o grubun altında toplanır (Üst Grup › Başlık › Rapor);
                                boş bırakılan başlık en üst seviyede görünür. Aynı üst grup adını birden çok başlığa yazmanız yeterlidir.
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" style="font-size:.85rem;">
                                    <thead style="background:var(--bg-subtle,#f8fafc);">
                                        <tr>
                                            <th style="width:60px;">Sıra</th>
                                            <th style="width:70px;">İkon</th>
                                            <th>Başlık</th>
                                            <th style="width:200px;">Üst Grup</th>
                                            <th style="width:110px;" class="text-center">Rapor</th>
                                            <th style="width:130px;" class="text-end">İşlem</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (baslikTanimlari.Any())
                                        {
                                            foreach (var b in baslikTanimlari)
                                            {
                                                var raporSayisi = Model != null && Model.ContainsKey(b.Name) ? Model[b.Name].Count : 0;
                                                var ikonSinifi = string.IsNullOrWhiteSpace(b.Icon) ? "fas fa-star text-warning" : b.Icon;
                                                <tr>
                                                    <td class="fw-bold text-muted">@b.DisplayOrder</td>
                                                    <td><i class="@ikonSinifi" style="font-size:1.1rem;"></i></td>
                                                    <td class="fw-bold">@b.Name</td>
                                                    <td>
                                                        @if (string.IsNullOrWhiteSpace(b.UstGrup))
                                                        {
                                                            <span class="text-muted" style="font-size:.75rem;">— (en üst seviye)</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-light text-dark border">@b.UstGrup</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="kategori-sayac">@raporSayisi</span>
                                                    </td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-primary"
                                                                onclick="baslikDuzenleModal(@b.Id, '@Html.Raw(Html.Encode(b.Name))', '@Html.Raw(Html.Encode(b.Icon))', @b.DisplayOrder, '@Html.Raw(Html.Encode(b.UstGrup))')">
                                                            <i class="fas fa-pen"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger"
                                                                onclick="baslikSil(@b.Id, '@Html.Raw(Html.Encode(b.Name))', @raporSayisi)">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="6" class="text-center text-muted py-4">Henüz başlık tanımı yok.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
</div>

