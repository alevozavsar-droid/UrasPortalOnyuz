@section Scripts {
    <script src="~/js/whatsapp-yonetim.js" asp-append-version="true"></script>
    <script>
        // ==========================================
        // KULLANICI (KİŞİ) BAZLI YETKİLER
        // ==========================================
        var TUM_MENULER = @Html.Raw(Json.Serialize((Model ?? new Dictionary<string, List<WebApplication3.Models.AppMenu>>()).Select(k => new { kategori = k.Key, menuler = k.Value.Select(m => new { id = m.Id, ad = m.MenuTitle, aktif = m.IsActive }).ToList() }).ToList()));
        var TUM_SIRKETLER = @Html.Raw(Json.Serialize((databases ?? new List<WebApplication3.Models.AppDatabase>()).Select(d => new { id = d.Id, ad = d.Display, key = d.DbKey }).ToList()));
        var kisiler = [];
        var seciliKisi = null;

        function kacisK(v) { return $('<div>').text(v == null ? '' : String(v)).html(); }
        function basHarf(k) {
            var ad = (k.adSoyad || k.userCode || '').trim().split(/\s+/);
            var h = (ad[0] ? ad[0][0] : '') + (ad[1] ? ad[1][0] : '');
            return (h || (k.userCode || '?').substr(0, 2)).toLocaleUpperCase('tr-TR');
        }
        function avatarRenk(kod) { var r = ['#4361ee', '#2dce89', '#fb6340', '#11cdef', '#8e54e9', '#f5a623', '#e53950']; var t = 0; for (var i = 0; i < (kod || '').length; i++) t += kod.charCodeAt(i); return r[t % r.length]; }
        function tamYetkiMi(k) { return k && (k.yetki === 'A' || k.yetki === 'S'); }

        function kisileriYukle(secilecek) {
            $.getJSON('/Permission/KisiListesi', function (r) {
                if (!r.success) { $('#kisiListe').html('<div class="alert alert-danger m-2 small">' + kacisK(r.message) + '</div>'); return; }
                kisiler = r.data || [];
                kisiListesiCiz();
                if (secilecek) kisiSec(secilecek);
            }).fail(function () { $('#kisiListe').html('<div class="alert alert-danger m-2 small">Kullanıcı listesi alınamadı.</div>'); });
        }

        var kisiDurum = 'aktif';   // alt sekme: aktif | pasif (SAP kilidi)
        function kisiDurumSec(d) { kisiDurum = d; $('.kisi-altsekme button').each(function () { $(this).toggleClass('active', $(this).data('durum') === d); }); kisiListesiCiz(); }

        function kisiListesiCiz() {
            var ara = ($('#kisiAra').val() || '').toLocaleLowerCase('tr-TR');
            var sadeceYetkili = $('#kisiSadeceYetkili').is(':checked');
            var h = '', gosterilen = 0, aktifSayi = 0, pasifSayi = 0;
            kisiler.forEach(function (k) {
                if (sadeceYetkili && !k.yetki) return;
                var metin = (k.userCode + ' ' + k.adSoyad + ' ' + k.yetki).toLocaleLowerCase('tr-TR');
                if (ara && metin.indexOf(ara) < 0) return;
                if (k.kilitli) pasifSayi++; else aktifSayi++;
                if ((kisiDurum === 'pasif') !== !!k.kilitli) return;
                gosterilen++;
                var tam = tamYetkiMi(k);
                var alt = tam ? '<span class="text-success">Tam yetki</span>' : (k.menuSayisi + ' rapor · ' + k.sirketSayisi + ' şirket');
                if (!tam && k.menuSayisi === 0 && k.sirketSayisi === 0) alt = '<span class="text-danger">Yetki tanımlı değil</span>';
                var kilitBtn = k.kilitli
                    ? '<button type="button" class="kisi-kilit aktifle" title="Aktife al: tekrar giriş yapabilir" onclick="event.stopPropagation(); kisiKilit(' + k.userId + ', \'' + kacisK(k.userCode) + '\', false)"><i class="fas fa-unlock"></i> Aktife al</button>'
                    : '<button type="button" class="kisi-kilit" title="Pasife çek: giriş yapamaz, atama listelerinde görünmez" onclick="event.stopPropagation(); kisiKilit(' + k.userId + ', \'' + kacisK(k.userCode) + '\', true)"><i class="fas fa-user-slash"></i> Pasife al</button>';
                h += '<div class="kisi-satir ' + (seciliKisi === k.userCode ? 'aktif' : '') + (k.kilitli ? ' kilitli' : '') + '" onclick="kisiSec(\'' + kacisK(k.userCode) + '\')">'
                   + '<div class="kisi-avatar" style="background:' + avatarRenk(k.userCode) + '">' + kacisK(basHarf(k)) + '</div>'
                   + '<div class="flex-grow-1 min-w-0"><div class="d-flex justify-content-between align-items-center gap-1"><span class="kisi-kod">' + kacisK(k.userCode) + '</span>'
                   + '<span class="d-flex align-items-center gap-1">' + (k.yetki ? '<span class="kisi-yetki">' + kacisK(k.yetki) + '</span>' : '') + kilitBtn + '</span></div>'
                   + '<div class="kisi-ad text-truncate">' + kacisK(k.adSoyad || '—') + '</div>'
                   + '<div class="kisi-alt">' + alt + (k.kilitli ? ' · <span class="text-danger">pasif</span>' : '') + '</div></div></div>';
            });
            $('#kisiCntAktif').text(aktifSayi); $('#kisiCntPasif').text(pasifSayi);
            $('#kisiSayac').text(gosterilen + ' kullanıcı');
            $('#kisiListe').html(h || '<div class="text-center text-muted py-4 small">' + (kisiDurum === 'pasif' ? 'Pasif kullanıcı yok.' : 'Kullanıcı bulunamadı.') + '</div>');
        }

        // Pasife çek / aktife al (SAP Locked). SAP Kullanıcı Yönetimi'ndeki uçla aynı; liste yenilenir.
        function kisiKilit(userId, kod, kilitle) {
            Swal.fire({
                title: kilitle ? kod + ' pasife alınsın mı?' : kod + ' aktife alınsın mı?',
                html: kilitle ? 'Kullanıcı SAP\'de kilitlenir: portala ve SAP\'ye giremez, Gider/Gelir atama listelerinde görünmez. İstediğinizde aktife alabilirsiniz.' : 'Kilit kaldırılır; kullanıcı tekrar giriş yapabilir ve listelerde görünür.',
                icon: 'question', showCancelButton: true, confirmButtonText: kilitle ? 'Pasife al' : 'Aktife al', cancelButtonText: 'Vazgeç', confirmButtonColor: kilitle ? '#f59e0b' : '#16a34a'
            }).then(function (s) {
                if (!s.isConfirmed) return;
                Swal.fire({ title: 'İşleniyor...', allowOutsideClick: false, didOpen: function () { Swal.showLoading(); } });
                $.post('/Permission/SetSapUserLocked', { internalKey: userId, kilitle: kilitle }, function (res) {
                    if (!res.success) { Swal.fire('Hata', res.message, 'error'); return; }
                    Swal.fire({ icon: 'success', title: 'Tamam', text: res.message, timer: 2200, showConfirmButton: false });
                    kisileriYukle(seciliKisi);
                }).fail(function () { Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); });
            });
        }

        function kisiSec(userCode) {
            seciliKisi = userCode;
            kisiListesiCiz();
            $('#kisiEditor').html('<div class="kisi-bos"><i class="fas fa-spinner fa-spin"></i></div>');
            $.getJSON('/Permission/KisiYetkileri', { userCode: userCode }, function (r) {
                if (!r.success) { $('#kisiEditor').html('<div class="alert alert-danger m-3">' + kacisK(r.message) + '</div>'); return; }
                kisiEditorCiz(r);
            });
        }

        function kisiEditorCiz(r) {
            var k = kisiler.find(function (x) { return x.userCode === r.userCode; }) || { adSoyad: '', yetki: '' };
            var tam = tamYetkiMi(k);
            var menuSet = {}; (r.menuIds || []).forEach(function (id) { menuSet[id] = true; });
            var dbSet = {}; (r.dbIds || []).forEach(function (id) { dbSet[id] = true; });

            var h = '<div class="kisi-baslik">';
            h += '<div class="d-flex align-items-center gap-3"><div class="kisi-avatar buyuk" style="background:' + avatarRenk(r.userCode) + '">' + kacisK(basHarf(k)) + '</div>'
               + '<div><div class="fw-bold fs-5 lh-1">' + kacisK(r.userCode) + '</div><div class="text-muted small mt-1">' + kacisK(k.adSoyad || '') + (k.yetki ? ' · SAP yetki kodu <b>' + kacisK(k.yetki) + '</b>' : '')
               + (r.guncelleme ? ' · son değişiklik ' + kacisK(r.guncelleyen) + ' ' + kacisK(r.guncelleme) : '') + '</div></div></div>';
            h += '<div class="d-flex gap-2 align-items-center flex-wrap">';
            h += '<div class="input-group input-group-sm" style="width:auto;"><select id="kisiKopyaKaynak" class="form-select form-select-sm" style="max-width:230px;"><option value="">Başka kullanıcıdan kopyala…</option>';
            kisiler.filter(function (x) { return x.userCode !== r.userCode && !tamYetkiMi(x) && (x.menuSayisi > 0 || x.sirketSayisi > 0); })
                   .forEach(function (x) { h += '<option value="' + kacisK(x.userCode) + '">' + kacisK(x.userCode) + ' — ' + kacisK(x.adSoyad || '') + ' (' + x.menuSayisi + ' rapor)</option>'; });
            h += '</select><button class="btn btn-outline-secondary" onclick="kisidenKopyala()" ' + (tam ? 'disabled' : '') + '><i class="fas fa-copy"></i></button></div>';
            h += '<button class="btn btn-sm btn-success fw-bold px-3" onclick="kisiKaydet()" ' + (tam ? 'disabled' : '') + '><i class="fas fa-save me-1"></i>Kaydet</button>';
            h += '</div></div>';

            h += '<div class="p-3">';
            if (tam) h += '<div class="alert alert-info py-2 small mb-3"><i class="fas fa-shield-halved me-1"></i>SAP yetki kodu <b>' + kacisK(k.yetki) + '</b> olan kullanıcı her raporu ve her şirketi görür; kişi bazlı seçim uygulanmaz.</div>';

            h += '<div class="kisi-bolum"><div class="kisi-bolum-baslik"><span><i class="fas fa-database me-2 text-info"></i>Şirketler <span class="text-muted fw-normal" id="kisiDbSayac"></span></span>'
               + '<span><a href="javascript:void(0)" onclick="kisiTumunuSec(\'kdb\', true)">tümü</a> · <a href="javascript:void(0)" onclick="kisiTumunuSec(\'kdb\', false)">hiçbiri</a></span></div>';
            h += '<div class="d-flex flex-wrap gap-2">';
            TUM_SIRKETLER.forEach(function (d) {
                h += '<label class="kisi-chip"><input type="checkbox" class="kdb" value="' + d.id + '" ' + (dbSet[d.id] ? 'checked' : '') + ' ' + (tam ? 'disabled' : '') + ' onchange="kisiSayaclar()"><span>' + kacisK(d.ad) + '</span></label>';
            });
            h += '</div></div>';

            h += '<div class="kisi-bolum"><div class="kisi-bolum-baslik"><span><i class="fas fa-file-alt me-2 text-primary"></i>Raporlar <span class="text-muted fw-normal" id="kisiMenuSayac"></span></span>'
               + '<span class="d-flex align-items-center gap-2"><input type="text" class="form-control form-control-sm" style="width:190px" placeholder="rapor ara..." oninput="kisiMenuAra(this.value)">'
               + '<a href="javascript:void(0)" onclick="kisiTumunuSec(\'kmenu\', true)">görünenleri seç</a> · <a href="javascript:void(0)" onclick="kisiTumunuSec(\'kmenu\', false)">kaldır</a></span></div>';
            h += '<div class="row g-2" id="kisiMenuAlan">';
            TUM_MENULER.forEach(function (kat) {
                h += '<div class="col-xl-4 col-md-6 kisi-kat"><div class="kisi-kat-kart">'
                   + '<div class="kisi-kat-baslik" onclick="kisiKategoriSec(this)" title="Kategorinin tamamını seç / kaldır"><span>' + kacisK(kat.kategori) + '</span><span class="kisi-kat-sayac"></span></div>';
                kat.menuler.forEach(function (m) {
                    h += '<label class="kisi-menu" data-ad="' + kacisK(m.ad).toLocaleLowerCase('tr-TR') + '"><input type="checkbox" class="kmenu" value="' + m.id + '" ' + (menuSet[m.id] ? 'checked' : '') + ' ' + (tam ? 'disabled' : '') + ' onchange="kisiSayaclar()">'
                       + '<span class="' + (m.aktif ? '' : 'text-muted text-decoration-line-through') + '">' + kacisK(m.ad) + '</span></label>';
                });
                h += '</div></div>';
            });
            h += '</div></div></div>';
            $('#kisiEditor').html(h);
            kisiSayaclar();
        }

        function kisiSayaclar() {
            $('#kisiMenuSayac').text('(' + $('#kisiEditor .kmenu:checked').length + ' / ' + $('#kisiEditor .kmenu').length + ')');
            $('#kisiDbSayac').text('(' + $('#kisiEditor .kdb:checked').length + ' / ' + $('#kisiEditor .kdb').length + ')');
            $('#kisiEditor .kisi-kat').each(function () {
                var t = $(this).find('.kmenu').length, c = $(this).find('.kmenu:checked').length;
                $(this).find('.kisi-kat-sayac').text(c + '/' + t).toggleClass('tam', t > 0 && c === t);
            });
        }
        function kisiTumunuSec(sinif, durum) {
            $('#kisiEditor .' + sinif + ':not(:disabled)').each(function () { if (sinif !== 'kmenu' || $(this).closest('.kisi-menu').is(':visible')) this.checked = durum; });
            kisiSayaclar();
        }
        function kisiKategoriSec(el) {
            var kutu = $(el).closest('.kisi-kat');
            var gorunen = kutu.find('.kmenu:not(:disabled)').filter(function () { return $(this).closest('.kisi-menu').is(':visible'); });
            var hepsi = gorunen.length > 0 && gorunen.filter(':checked').length === gorunen.length;
            gorunen.prop('checked', !hepsi);
            kisiSayaclar();
        }
        function kisiMenuAra(metin) {
            metin = (metin || '').toLocaleLowerCase('tr-TR');
            $('#kisiEditor .kisi-menu').each(function () { $(this).toggle(!metin || String($(this).data('ad')).indexOf(metin) >= 0); });
            $('#kisiEditor .kisi-kat').each(function () { $(this).toggle($(this).find('.kisi-menu:visible').length > 0); });
        }

        function kisiKaydet() {
            if (!seciliKisi) return;
            var menuIds = $('#kisiEditor .kmenu:checked').map(function () { return parseInt(this.value); }).get();
            var dbIds = $('#kisiEditor .kdb:checked').map(function () { return parseInt(this.value); }).get();
            $.ajax({
                url: '/Permission/KisiYetkileriKaydet', type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ UserCode: seciliKisi, MenuIds: menuIds, DbIds: dbIds }),
                success: function (r) {
                    if (!r.success) { Swal.fire('Hata', r.message, 'error'); return; }
                    Swal.fire({ icon: 'success', title: 'Kaydedildi', text: r.message, timer: 1500, showConfirmButton: false });
                    kisileriYukle(seciliKisi);
                },
                error: function () { Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); }
            });
        }

        function kisidenKopyala() {
            if (!seciliKisi) return;
            var kaynak = $('#kisiKopyaKaynak').val();
            if (!kaynak) { Swal.fire('Kaynak seçin', 'Yetkileri kopyalanacak kullanıcıyı listeden seçin.', 'info'); return; }
            Swal.fire({ title: 'Yetkiler kopyalansın mı?', html: '<b>' + kacisK(kaynak) + '</b> kullanıcısının rapor ve şirket yetkileri <b>' + kacisK(seciliKisi) + '</b> kullanıcısına kopyalanacak; mevcut seçimleri değişecek.', icon: 'question', showCancelButton: true, confirmButtonText: 'Kopyala', cancelButtonText: 'Vazgeç' })
                .then(function (s) {
                    if (!s.isConfirmed) return;
                    $.post('/Permission/KisidenKopyala', { userCode: seciliKisi, kaynakUserCode: kaynak }, function (r) {
                        if (!r.success) { Swal.fire('Hata', r.message, 'error'); return; }
                        Swal.fire({ icon: 'success', title: 'Kopyalandı', text: r.message, timer: 1800, showConfirmButton: false });
                        kisileriYukle(seciliKisi);
                    });
                });
        }

        $(function () { kisileriYukle(null); });

        // ====================================================================
        // RAPOR BAZLI YETKİ: raporu seç → kim görüyor, kullanıcı ekle / çıkar
        // ====================================================================
        var rbSeciliMenu = null, rbVeri = null;
        var RB_KAYNAK = {
            TAM: ['Tam yetki (A/S)', 'bg-success'],
            ACIK: ['Herkese açık ekran', 'bg-secondary'],
            KISI: ['Kişiye özel', 'bg-primary'],
            ROL: ['Rol şablonu', 'bg-info text-dark'],
            ROLVARSAYILAN: ['Rolünden (profili yok)', 'bg-warning text-dark']
        };

        function rbRaporListesiCiz() {
            var ara = ($('#rbRaporAra').val() || '').toLocaleLowerCase('tr-TR');
            var h = '', sayac = 0;
            TUM_MENULER.forEach(function (kat) {
                var satirlar = '';
                kat.menuler.forEach(function (m) {
                    if (ara && (m.ad + ' ' + kat.kategori).toLocaleLowerCase('tr-TR').indexOf(ara) < 0) return;
                    sayac++;
                    satirlar += '<div class="kisi-satir ' + (rbSeciliMenu === m.id ? 'aktif' : '') + '" onclick="rbRaporSec(' + m.id + ')">'
                        + '<div class="flex-grow-1 min-w-0"><div class="kisi-kod text-truncate ' + (m.aktif ? '' : 'text-muted text-decoration-line-through') + '">' + kacisK(m.ad) + '</div></div>'
                        + '<i class="fas fa-chevron-right text-muted" style="font-size:.7rem;"></i></div>';
                });
                if (satirlar) h += '<div class="px-3 pt-2 pb-1 text-uppercase fw-bold text-muted" style="font-size:.66rem; letter-spacing:.04em; background:#f8fafc;">' + kacisK(kat.kategori) + '</div>' + satirlar;
            });
            $('#rbRaporSayac').text(sayac + ' rapor');
            $('#rbRaporListe').html(h || '<div class="text-center text-muted py-4 small">Rapor bulunamadı.</div>');
        }

        function rbRaporSec(menuId) {
            rbSeciliMenu = menuId;
            rbRaporListesiCiz();
            $('#rbEditor').html('<div class="kisi-bos"><i class="fas fa-spinner fa-spin"></i></div>');
            $.getJSON('/Permission/RaporKullanicilari', { menuId: menuId }, function (r) {
                if (!r.success) { $('#rbEditor').html('<div class="alert alert-danger m-3">' + kacisK(r.message) + '</div>'); return; }
                rbVeri = r; rbEditorCiz();
            }).fail(function () { $('#rbEditor').html('<div class="alert alert-danger m-3">Sunucu ile iletişim kurulamadı.</div>'); });
        }

        function rbEditorCiz() {
            var r = rbVeri; if (!r) return;
            var h = '<div class="kisi-baslik">';
            h += '<div><div class="fw-bold fs-5 lh-1"><i class="fas fa-file-alt text-primary me-2"></i>' + kacisK(r.rapor.ad) + (r.rapor.aktif ? '' : ' <span class="badge bg-secondary">pasif</span>') + '</div>'
               + '<div class="text-muted small mt-1">' + kacisK(r.rapor.kategori || '') + ' · /' + kacisK(r.rapor.controller) + '/' + kacisK(r.rapor.action || 'Index')
               + (r.roller.length ? ' · Rol şablonları: ' + r.roller.map(function (x) { return '<span class="badge bg-light text-dark border">' + kacisK(x.roleCode) + '</span>'; }).join(' ') : ' · <span class="text-warning">hiçbir rol şablonunda yok</span>') + '</div></div>';
            h += '<div class="text-end"><div class="fw-bold fs-4 lh-1 text-primary">' + r.gorenler.length + '</div><div class="text-muted" style="font-size:.7rem;">kullanıcı görüyor</div></div>';
            h += '</div><div class="p-3">';

            if (r.herkeseAcik) h += '<div class="alert alert-info py-2 small mb-3"><i class="fas fa-info-circle me-1"></i>Bu ekran herkese açık; kullanıcı bazlı kısıtlanamaz.</div>';

            // Kullanıcı ekleme
            h += '<div class="kisi-bolum"><div class="kisi-bolum-baslik"><span><i class="fas fa-user-plus me-2 text-success"></i>Rapora kullanıcı ekle</span></div>';
            if (r.herkeseAcik) h += '<div class="text-muted small">Gerekmez; herkes görür.</div>';
            else if (!r.adaylar.length) h += '<div class="text-muted small">Eklenebilecek kullanıcı kalmadı; herkes görüyor.</div>';
            else {
                h += '<div class="d-flex gap-2 flex-wrap align-items-center"><input type="text" class="form-control form-control-sm" style="width:220px" id="rbAdayAra" placeholder="kod / ad ara..." oninput="rbAdaylariDoldur()">'
                   + '<select id="rbAday" class="form-select form-select-sm" style="max-width:380px;"></select>'
                   + '<button class="btn btn-sm btn-success fw-bold px-3" onclick="rbEkle()"><i class="fas fa-plus me-1"></i>Ekle</button>'
                   + '<span class="text-muted" style="font-size:.72rem;">Eklenen kullanıcı kişi bazlı profile geçer; diğer yetkileri korunur.</span></div>';
            }
            h += '</div>';

            // Görenler
            h += '<div class="kisi-bolum"><div class="kisi-bolum-baslik"><span><i class="fas fa-users me-2 text-primary"></i>Raporu görebilenler <span class="text-muted fw-normal">(' + r.gorenler.length + ')</span></span>'
               + '<input type="text" class="form-control form-control-sm" style="width:200px" placeholder="listede ara..." oninput="rbGorenAra(this.value)"></div>';
            if (!r.gorenler.length) h += '<div class="text-muted small py-3 text-center">Bu raporu henüz kimse görmüyor.</div>';
            else {
                h += '<div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0" id="rbGorenTablo"><thead class="table-light"><tr><th>Kullanıcı</th><th>Ad Soyad</th><th>SAP yetki</th><th>Nereden görüyor</th><th class="text-end"></th></tr></thead><tbody>';
                r.gorenler.forEach(function (u) {
                    var k = RB_KAYNAK[u.kaynak] || [u.kaynak, 'bg-light text-dark'];
                    var kaldirilabilir = u.kaynak !== 'TAM' && u.kaynak !== 'ACIK';
                    h += '<tr data-ara="' + kacisK((u.userCode + ' ' + u.adSoyad + ' ' + u.yetki).toLocaleLowerCase('tr-TR')) + '" class="' + (u.kilitli ? 'text-muted' : '') + '">'
                       + '<td><span class="kisi-avatar me-2" style="width:26px;height:26px;flex-basis:26px;font-size:.62rem;display:inline-flex;background:' + avatarRenk(u.userCode) + '">' + kacisK((u.userCode || '?').substr(0, 2).toLocaleUpperCase('tr-TR')) + '</span><b>' + kacisK(u.userCode) + '</b>' + (u.kilitli ? ' <span class="badge bg-danger">kilitli</span>' : '') + '</td>'
                       + '<td>' + kacisK(u.adSoyad || '—') + '</td>'
                       + '<td>' + (u.yetki ? '<span class="kisi-yetki">' + kacisK(u.yetki) + '</span>' : '—') + '</td>'
                       + '<td><span class="badge ' + k[1] + '">' + kacisK(k[0]) + '</span></td>'
                       + '<td class="text-end">' + (kaldirilabilir ? '<button class="btn btn-sm btn-outline-danger py-0" title="Bu raporu kullanıcıdan kaldır" onclick="rbKaldir(\'' + kacisK(u.userCode) + '\')"><i class="fas fa-times"></i></button>' : '<span class="text-muted" style="font-size:.7rem;">kaldırılamaz</span>') + '</td></tr>';
                });
                h += '</tbody></table></div>';
            }
            h += '</div></div>';
            $('#rbEditor').html(h);
            rbAdaylariDoldur();
        }

        function rbAdaylariDoldur() {
            var sel = $('#rbAday'); if (!sel.length || !rbVeri) return;
            var ara = ($('#rbAdayAra').val() || '').toLocaleLowerCase('tr-TR');
            var h = '', n = 0;
            rbVeri.adaylar.forEach(function (u) {
                var metin = (u.userCode + ' ' + u.adSoyad + ' ' + u.yetki).toLocaleLowerCase('tr-TR');
                if (ara && metin.indexOf(ara) < 0) return;
                n++;
                h += '<option value="' + kacisK(u.userCode) + '">' + kacisK(u.userCode) + ' — ' + kacisK(u.adSoyad || '') + (u.yetki ? ' (' + kacisK(u.yetki) + ')' : ' (yetki kodu yok)') + (u.kilitli ? ' · kilitli' : '') + '</option>';
            });
            sel.html(h || '<option value="">eşleşen kullanıcı yok</option>');
            sel.attr('size', 1);
            if (n) sel.prepend('<option value="" selected>' + n + ' kullanıcı — seçin…</option>');
        }
        function rbGorenAra(metin) {
            metin = (metin || '').toLocaleLowerCase('tr-TR');
            $('#rbGorenTablo tbody tr').each(function () { $(this).toggle(!metin || String($(this).data('ara')).indexOf(metin) >= 0); });
        }
        function rbAyarla(userCode, ver) {
            if (!rbSeciliMenu) return;
            $.post('/Permission/RaporKullaniciAyarla', { menuId: rbSeciliMenu, userCode: userCode, ver: ver }, function (r) {
                if (!r.success) { Swal.fire('Hata', r.message, 'error'); return; }
                Swal.fire({ icon: 'success', title: ver ? 'Eklendi' : 'Kaldırıldı', text: r.message, timer: 1600, showConfirmButton: false });
                rbRaporSec(rbSeciliMenu);
                kisileriYukle(seciliKisi);   // Kullanıcı Yetkileri sekmesindeki sayaçlar da güncellensin
            }).fail(function () { Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); });
        }
        function rbEkle() {
            var kod = $('#rbAday').val();
            if (!kod) { Swal.fire('Kullanıcı seçin', 'Rapora eklenecek kullanıcıyı listeden seçin.', 'info'); return; }
            rbAyarla(kod, true);
        }
        function rbKaldir(kod) {
            Swal.fire({ title: 'Rapor kaldırılsın mı?', html: '<b>' + kacisK(kod) + '</b> kullanıcısı artık <b>' + kacisK(rbVeri.rapor.ad) + '</b> raporunu göremeyecek.', icon: 'question', showCancelButton: true, confirmButtonText: 'Kaldır', cancelButtonText: 'Vazgeç', confirmButtonColor: '#dc3545' })
                .then(function (s) { if (s.isConfirmed) rbAyarla(kod, false); });
        }
        $(function () { rbRaporListesiCiz(); });
    </script>
    <script>
        // ---- Yetki ekranı yardımcıları (arama / toplu seçim / sayaç) ----
        // ==========================================
        // RAPOR (MENÜ) DÜZENLEME
        // ==========================================
        // Rapor adı / kategori tırnak içerebilir; değerler data-* özniteliklerinden okunur (onclick içine gömülmez).
        function menuDuzenleBtn(btn) {
            var d = btn.dataset;
            menuDuzenle(parseInt(d.id), d.baslik || '', d.kategori || '', d.ikon || '', parseInt(d.sira) || 0);
        }
        function menuDuzenle(id, baslik, kategori, ikon, sira) {
            $('#editMenuId').val(id);
            $('#editMenuTitle').val(baslik);
            $('#editMenuCategory').val(kategori);
            $('#editMenuIcon').val(ikon || '');
            $('#editMenuOrder').val(sira);
            // Pencere .table-container içinde kaldıysa (yığın bağlamı) body'ye taşı; aksi halde arka perdenin altında kalır.
            var el = document.getElementById('menuEditModal');
            if (el && el.parentElement !== document.body) document.body.appendChild(el);
            bootstrap.Modal.getOrCreateInstance(el).show();
        }

        function menuKaydet() {
            var baslik = ($('#editMenuTitle').val() || '').trim();
            if (!baslik) { Swal.fire('Eksik Bilgi', 'Rapor adı boş olamaz.', 'warning'); return; }

            var payload = {
                Id: parseInt($('#editMenuId').val()),
                MenuTitle: baslik,
                Category: ($('#editMenuCategory').val() || '').trim(),
                Icon: ($('#editMenuIcon').val() || '').trim(),
                DisplayOrder: parseInt($('#editMenuOrder').val()) || 0
            };

            $.ajax({
                url: '/Permission/UpdateMenu',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function (res) {
                    if (res.success) {
                        Swal.fire({ icon: 'success', title: 'Kaydedildi', text: res.message, timer: 1400, showConfirmButton: false })
                            .then(function () { location.reload(); });
                    } else {
                        Swal.fire('Hata', res.message, 'error');
                    }
                },
                error: function () { Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); }
            });
        }

        // ==========================================
        // RAPORU SILME / GIZLEME
        // ==========================================
        function menuSil() {
            var id = parseInt($('#editMenuId').val());
            var ad = ($('#editMenuTitle').val() || '').trim();
            if (!id) return;

            Swal.fire({
                icon: 'warning',
                title: 'Menüden silinsin mi?',
                html: '<b>' + ad + '</b> menüden kaldırılacak.<br><br>'
                    + 'Rol yetkileri ve kullanıcı favorileri de temizlenir.<br>'
                    + '<span class="text-danger small">Raporun kodu projede kalır; kaydı silinince '
                    + 'yetki denetiminden geçmez ve adresini bilen açabilir. '
                    + 'Sadece görünmesin istiyorsanız <b>Gizle</b> daha doğrudur.</span>',
                showCancelButton: true,
                confirmButtonText: 'Evet, sil',
                cancelButtonText: 'Vazgeç',
                confirmButtonColor: '#ef4444'
            }).then(function (sonuc) {
                if (!sonuc.isConfirmed) return;

                $.ajax({
                    url: '/Permission/DeleteMenu',
                    type: 'POST',
                    data: { id: id },
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function (res) {
                        if (res.success) {
                            Swal.fire({ icon: 'success', title: 'Silindi', text: res.message, timer: 1600, showConfirmButton: false })
                                .then(function () { location.reload(); });
                        } else {
                            Swal.fire('Hata', res.message, 'error');
                        }
                    },
                    error: function () { Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); }
                });
            });
        }

        function menuGizleAc() {
            var id = parseInt($('#editMenuId').val());
            if (!id) return;

            $.ajax({
                url: '/Permission/ToggleMenuActive',
                type: 'POST',
                data: { id: id },
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function (res) {
                    if (res.success) {
                        Swal.fire({ icon: 'success', title: 'Tamam', text: res.message, timer: 1600, showConfirmButton: false })
                            .then(function () { location.reload(); });
                    } else {
                        Swal.fire('Hata', res.message, 'error');
                    }
                },
                error: function () { Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); }
            });
        }

        // ==========================================
        // PROJEDEN ALGILANAN RAPORLAR
        // ==========================================
        var yeniRaporlar = [];

        function yeniSecimGuncelle() {
            var n = $('#tbody-yeni-raporlar .yeni-sec:checked').length;
            $('#yeniSecimSayisi').text(n);
            $('#btnYeniEkle').prop('disabled', n === 0);
        }

        function yeniTumunuSec(sec) {
            $('#tbody-yeni-raporlar .yeni-sec').prop('checked', sec);
            yeniSecimGuncelle();
        }

        function yeniRaporlariTara() {
            $('#tbody-yeni-raporlar').html('<tr><td colspan="5" class="text-center py-4">'
                + '<i class="fas fa-spinner fa-spin me-1"></i>Proje taranıyor...</td></tr>');

            $.getJSON('/Permission/GetUnregisteredReports', function (res) {
                if (!res || !res.success) {
                    $('#tbody-yeni-raporlar').html('<tr><td colspan="5" class="text-danger text-center py-4">'
                        + ((res && res.message) ? res.message : 'Tarama başarısız.') + '</td></tr>');
                    return;
                }

                yeniRaporlar = res.data || [];

                var secenekler = (res.kategoriler || []).map(function (k) {
                    return '<option value="' + k + '"></option>';
                }).join('');
                $('#yeniKategoriListesi').html(secenekler);

                $('#yeniRaporRozet').text(yeniRaporlar.length).toggle(yeniRaporlar.length > 0);

                if (!yeniRaporlar.length) {
                    $('#tbody-yeni-raporlar').html('<tr><td colspan="5" class="text-success text-center py-4 fw-bold">'
                        + '<i class="fas fa-circle-check me-1"></i>Menüye eklenmemiş rapor yok.</td></tr>');
                    yeniSecimGuncelle();
                    return;
                }

                var html = '';
                yeniRaporlar.forEach(function (r, i) {
                    html += '<tr>'
                          + '<td><input type="checkbox" class="form-check-input yeni-sec" data-idx="' + i + '" onclick="yeniSecimGuncelle()"></td>'
                          + '<td><span class="badge bg-dark">' + r.controllerName + '</span></td>'
                          + '<td><code class="small">' + r.rota + '</code></td>'
                          + '<td><input type="text" class="form-control form-control-sm yeni-ad" data-idx="' + i + '" value="'
                            + $('<div>').text(r.onerilenBaslik || r.controllerName).html() + '"></td>'
                          + '<td><input type="text" class="form-control form-control-sm yeni-kat" data-idx="' + i + '" list="yeniKategoriListesi" value="'
                            + $('<div>').text(r.onerilenKategori || '').html() + '" placeholder="Başlık seçin veya yazın"></td>'
                          + '</tr>';
                });

                $('#tbody-yeni-raporlar').html(html);
                yeniSecimGuncelle();
            }).fail(function () {
                $('#tbody-yeni-raporlar').html('<tr><td colspan="5" class="text-danger text-center py-4">'
                    + 'Sunucuya ulaşılamadı.</td></tr>');
            });
        }

        function yeniRaporlariEkle() {
            var paket = [];

            $('#tbody-yeni-raporlar .yeni-sec:checked').each(function () {
                var i = $(this).data('idx');
                var r = yeniRaporlar[i];
                if (!r) return;

                paket.push({
                    ControllerName: r.controllerName,
                    ActionName: r.actionName,
                    MenuTitle: ($('.yeni-ad[data-idx="' + i + '"]').val() || r.controllerName).trim(),
                    Category: ($('.yeni-kat[data-idx="' + i + '"]').val() || '').trim(),
                    Icon: 'fas fa-chart-line'
                });
            });

            if (!paket.length) return;

            $('#btnYeniEkle').prop('disabled', true);

            $.ajax({
                url: '/Permission/AddDetectedReports',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(paket),
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function (res) {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Eklendi',
                            html: res.message + '<br><span class="small text-muted">Rol yetkilerini vermeyi unutmayın.</span>'
                        }).then(function () { location.reload(); });
                    } else {
                        Swal.fire('Hata', res.message, 'error');
                        yeniSecimGuncelle();
                    }
                },
                error: function () {
                    Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error');
                    yeniSecimGuncelle();
                }
            });
        }

        // Sekmeye ilk girildiginde kendiliginden tara
        $(document).on('shown.bs.tab', '#yeni-tab', function () {
            if (!yeniRaporlar.length) yeniRaporlariTara();
        });

        function baslikDuzenle(eskiAd) {
            Swal.fire({
                title: 'Başlığı Yeniden Adlandır',
                input: 'text',
                inputValue: eskiAd,
                inputLabel: 'Bu başlık altındaki tüm raporlar yeni başlığa taşınır.',
                showCancelButton: true,
                confirmButtonText: 'Kaydet',
                cancelButtonText: 'Vazgeç',
                confirmButtonColor: '#3b82f6',
                inputValidator: function (deger) {
                    if (!deger || !deger.trim()) return 'Başlık adı boş olamaz.';
                }
            }).then(function (sonuc) {
                if (!sonuc.isConfirmed) return;

                $.post('/Permission/RenameCategory',
                    { eskiAd: eskiAd, yeniAd: sonuc.value.trim(), __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                    function (res) {
                        if (res.success) {
                            Swal.fire({ icon: 'success', title: 'Kaydedildi', text: res.message, timer: 1600, showConfirmButton: false })
                                .then(function () { location.reload(); });
                        } else {
                            Swal.fire('Hata', res.message, 'error');
                        }
                    }).fail(function () { Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); });
            });
        }

        // ==========================================
        // MENÜ BAŞLIKLARI
        // ==========================================
        function ikonOnizle() {
            var sinif = ($('#catIcon').val() || '').trim() || 'fas fa-star text-warning';
            $('#catIconPreview').attr('class', sinif);
        }

        function baslikEkle() {
            $('#catModalBaslik').text('Yeni Başlık');
            $('#catId').val(0);
            $('#catName').val('');
            $('#catIcon').val('');
            $('#catUstGrup').val('');
            $('#catOrder').val(0);
            ikonOnizle();
            new bootstrap.Modal(document.getElementById('catModal')).show();
        }

        function baslikDuzenleModal(id, ad, ikon, sira, ustGrup) {
            $('#catModalBaslik').text('Başlığı Düzenle');
            $('#catId').val(id);
            $('#catName').val(ad);
            $('#catIcon').val(ikon || '');
            $('#catUstGrup').val(ustGrup || '');
            $('#catOrder').val(sira);
            ikonOnizle();
            new bootstrap.Modal(document.getElementById('catModal')).show();
        }

        function baslikKaydet() {
            var ad = ($('#catName').val() || '').trim();
            if (!ad) { Swal.fire('Eksik Bilgi', 'Başlık adı boş olamaz.', 'warning'); return; }

            var payload = {
                Id: parseInt($('#catId').val()) || 0,
                Name: ad,
                Icon: ($('#catIcon').val() || '').trim(),
                UstGrup: ($('#catUstGrup').val() || '').trim(),
                DisplayOrder: parseInt($('#catOrder').val()) || 0
            };

            $.ajax({
                url: '/Permission/SaveCategory',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        Swal.fire({ icon: 'success', title: 'Kaydedildi', text: res.message, timer: 1600, showConfirmButton: false })
                            .then(function () { location.reload(); });
                    } else {
                        Swal.fire('Hata', res.message, 'error');
                    }
                },
                error: function () { Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); }
            });
        }

        function baslikSil(id, ad, raporSayisi) {
            // Icinde rapor yoksa dogrudan sil
            if (!raporSayisi) {
                Swal.fire({
                    title: 'Başlık silinsin mi?',
                    text: ad + ' başlığı kaldırılacak.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Evet, sil',
                    cancelButtonText: 'Vazgeç',
                    confirmButtonColor: '#ef4444'
                }).then(function (sonuc) {
                    if (sonuc.isConfirmed) baslikSilGonder(id, null);
                });
                return;
            }

            // Icinde rapor varsa once nereye tasinacagini soralim
            $.post('/Permission/DeleteCategory', { id: id }, function (res) {
                if (res.success) { location.reload(); return; }

                if (!res.tasimaGerekli) { Swal.fire('Hata', res.message, 'error'); return; }

                var secenekler = {};
                (res.secenekler || []).forEach(function (k) { secenekler[k] = k; });

                Swal.fire({
                    title: ad + ' silinsin mi?',
                    html: 'Bu başlıkta <b>' + res.raporSayisi + ' rapor</b> var.<br>'
                        + 'Silmeden önce hepsi seçtiğiniz başlığa taşınacak.',
                    icon: 'warning',
                    input: 'select',
                    inputOptions: secenekler,
                    inputPlaceholder: 'Raporlar hangi başlığa taşınsın?',
                    showCancelButton: true,
                    confirmButtonText: 'Taşı ve sil',
                    cancelButtonText: 'Vazgeç',
                    confirmButtonColor: '#ef4444',
                    inputValidator: function (deger) {
                        if (!deger) return 'Bir hedef başlık seçmelisiniz.';
                    }
                }).then(function (sonuc) {
                    if (sonuc.isConfirmed) baslikSilGonder(id, sonuc.value);
                });
            }).fail(function () { Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); });
        }

        function baslikSilGonder(id, hedefKategori) {
            $.post('/Permission/DeleteCategory', { id: id, hedefKategori: hedefKategori || '' }, function (res) {
                if (res.success) {
                    Swal.fire({ icon: 'success', title: 'Tamam', text: res.message, timer: 1800, showConfirmButton: false })
                        .then(function () { location.reload(); });
                } else {
                    Swal.fire('Hata', res.message, 'error');
                }
            }).fail(function () { Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); });
        }

        // ==========================================
        // ŞİRKETİN GÖRÜNEN ADI
        // ==========================================
        function sirketAdiDuzenle(id, mevcutAd, dbKey) {
            Swal.fire({
                title: 'Şirket Adını Değiştir',
                input: 'text',
                inputValue: mevcutAd,
                inputLabel: 'Üst menüdeki şirket seçicisinde bu ad görünür. Veritabanı: ' + dbKey,
                showCancelButton: true,
                confirmButtonText: 'Kaydet',
                cancelButtonText: 'Vazgeç',
                confirmButtonColor: '#3b82f6',
                inputValidator: function (deger) {
                    if (!deger || !deger.trim()) return 'Görünen ad boş olamaz.';
                }
            }).then(function (sonuc) {
                if (!sonuc.isConfirmed) return;

                $.post('/Permission/UpdateDatabaseDisplay',
                    { id: id, display: sonuc.value.trim(), __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                    function (res) {
                        if (res.success) {
                            Swal.fire({ icon: 'success', title: 'Kaydedildi', text: res.message, timer: 1600, showConfirmButton: false })
                                .then(function () { location.reload(); });
                        } else {
                            Swal.fire('Hata', res.message, 'error');
                        }
                    }).fail(function () { Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); });
            });
        }

        // Başlık yönetimi role bağlı değildir; o sekme açıkken alan kilidi kalkar.
        $(document).ready(function () {
            $('#cats-tab').on('shown.bs.tab', function () {
            });

            $('#menus-tab, #dbs-tab').on('shown.bs.tab', function () {
            });
        });

        function menuAra() {
            var q = (document.getElementById('menuArama').value || '').toLocaleLowerCase('tr-TR');

            document.querySelectorAll('#menus-pane .dashboard-card').forEach(function (kart) {
                var gorunenSatir = 0;

                kart.querySelectorAll('.menu-item-row').forEach(function (satir) {
                    var metin = (satir.textContent || '').toLocaleLowerCase('tr-TR');
                    var uygun = !q || metin.indexOf(q) > -1;
                    satir.style.display = uygun ? '' : 'none';
                    if (uygun) gorunenSatir++;
                });

                var kolon = kart.closest('[class*="col-"]');
                if (kolon) kolon.classList.toggle('kategori-gizli', gorunenSatir === 0);
            });
        }

    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

        // ==========================================
        // ŞİRKETLERİ OTOMATİK SENKRONİZE ETME JAVASCRIPT
        // ==========================================
        function syncDatabases() {
            Swal.fire({
                title: 'Şirketler Taranıyor...',
                text: 'appsettings.json üzerindeki yeni şirketler kontrol ediliyor.',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.get('/Permission/SyncDatabasesFromConfig', function (res) {
                if (res.success) {
                    Swal.fire('Başarılı!', res.message, 'success').then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire('Hata', res.message, 'error');
                }
            }).fail(function () {
                Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error');
            });
        }

        function saveNewReport() {
            const payload = {
                Category: $('#newCategory').val(),
                MenuTitle: $('#newMenuTitle').val().trim(),
                ControllerName: $('#newController').val().trim(),
                ActionName: $('#newAction').val().trim(),
                Icon: $('#newIcon').val().trim()
            };

            if (!payload.MenuTitle || !payload.ControllerName) {
                Swal.fire('Uyarı', 'Rapor Başlığı ve Controller Adı zorunludur.', 'warning');
                return;
            }

            Swal.fire({ title: 'Sisteme Ekleniyor...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

            $.ajax({
                url: '/Permission/AddNewReport',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        $('#addReportModal').modal('hide');
                        Swal.fire('Başarılı!', res.message, 'success').then(() => {
                            location.reload(); 
                        });
                    } else {
                        Swal.fire('Hata', res.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error');
                }
            });
        }

        // ==========================================
        // SAP KULLANICI YÖNETİMİ JAVASCRIPT
        // ==========================================
        function openSapUserModal() {
            $('#sapUserModal').modal('show');
            document.getElementById('list-tab').click(); 
            $('#sapUserSearchInput').val(''); 
            loadSapUsers();
        }

        function filterSapUsers() {
            let value = $('#sapUserSearchInput').val().toLowerCase();
            $("#sapUserTableBody tr").not('.sap-ayrac').filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        }

        function toggleSapUserLock(internalKey, code, kilitle) {
            Swal.fire({
                title: kilitle ? 'Pasife çekilsin mi?' : 'Aktife alınsın mı?',
                html: kilitle ? `<b>${code}</b> kullanıcısı SAP'de kilitlenir: portala ve SAP'ye giremez, Gider/Gelir atama listelerinde ve kullanıcı seçimlerinde görünmez. İstediğinizde tekrar aktife alabilirsiniz.` : `<b>${code}</b> kullanıcısının kilidi kaldırılır; tekrar giriş yapabilir ve listelerde görünür.`,
                icon: 'question', showCancelButton: true, confirmButtonText: kilitle ? 'Pasife çek' : 'Aktife al', cancelButtonText: 'Vazgeç', confirmButtonColor: kilitle ? '#f59e0b' : '#16a34a'
            }).then(function (s) {
                if (!s.isConfirmed) return;
                Swal.fire({ title: 'İşleniyor...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                $.post('/Permission/SetSapUserLocked', { internalKey: internalKey, kilitle: kilitle }, function (res) {
                    if (res.success) { Swal.fire({ icon: 'success', title: 'Tamam', text: res.message, timer: 2500, showConfirmButton: false }); loadSapUsers(); }
                    else Swal.fire('Hata', res.message, 'error');
                }).fail(function () { Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); });
            });
        }

        function deleteSapUser(internalKey, code) {
            Swal.fire({
                title: 'Kullanıcı silinsin mi?',
                html: `<b>${code}</b> SAP'den kalıcı olarak silinecek; portal yetki kayıtları da temizlenir.<br><small class="text-muted">SAP, daha önce giriş yapmış ya da belge oluşturmuş kullanıcının silinmesine izin vermez; o durumda "Pasife çek" kullanın.</small>`,
                icon: 'warning', showCancelButton: true, confirmButtonText: 'Sil', cancelButtonText: 'Vazgeç', confirmButtonColor: '#dc3545'
            }).then(function (s) {
                if (!s.isConfirmed) return;
                Swal.fire({ title: 'SAP Service Layer İşlemi Yapılıyor...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                $.post('/Permission/DeleteSapUser', { internalKey: internalKey }, function (res) {
                    if (res.success) { Swal.fire({ icon: 'success', title: 'Silindi', text: res.message, timer: 2500, showConfirmButton: false }); loadSapUsers(); }
                    else Swal.fire({ icon: 'error', title: 'Silinemedi', text: res.message, showCancelButton: true, confirmButtonText: 'Pasife çek', cancelButtonText: 'Kapat', confirmButtonColor: '#f59e0b' })
                        .then(function (t) { if (t.isConfirmed) toggleSapUserLock(internalKey, code, true); });
                }).fail(function () { Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); });
            });
        }

        // Diğer şirketteki kullanıcıyı URASKIMYA'da açmak için formu doldurur.
        function digerSirkettenAc(btn) {
            const d = btn.dataset;
            prepareNewSapUser();
            $('#sapUserCode').val(decodeURIComponent(d.code));
            $('#sapUserName').val(decodeURIComponent(d.name));
            $('#sapEmail').val(decodeURIComponent(d.email));
            $('#sapPassword').val(decodeURIComponent(d.pass));
            const yetki = decodeURIComponent(d.yetki);
            if (yetki && $('#sapAuthority option[value="' + yetki + '"]').length) $('#sapAuthority').val(yetki);
            if (!$('#sapAuthority').val()) $('#sapAuthority').focus();
        }

        function loadSapUsers() {
            $('#sapUserTableBody').html('<tr><td colspan="5" class="text-center py-3 text-muted"><i class="fas fa-spinner fa-spin me-2"></i>SAP\'den Kullanıcılar Yükleniyor...</td></tr>');
            
            $.get('/Permission/GetSapUsers', function(res) {
                if(res.success) {
                    let html = '';
                    res.data.forEach(u => {
                        let internalKey = u.InternalKey || u.internalKey || 0; 
                        let code = u.UserCode || u.userCode || 'Bilinmiyor';
                        let name = u.UserName || u.userName || '-';
                        let email = u.eMail || u.email || '';
                        let yetki = u.U_BE1_YETKI || u.u_BE1_YETKI || '';
                        let pass = u.U_BE1_PASSWORD || u.u_BE1_PASSWORD || '';
                        let kilitli = (u.Locked || u.locked || '') === 'tYES';

                        let yetkiBadge = yetki ? `<span class="badge bg-info text-dark">${yetki}</span>` : `<span class="badge bg-secondary">Yetki Yok</span>`;
                        if (kilitli) yetkiBadge += ' <span class="badge bg-danger" title="Pasif: SAP ve portala giremez, atama listelerinde görünmez">pasif</span>';
                        let passDisplay = pass ? `<span class="text-muted fw-bold">${pass}</span>` : `<span class="badge bg-light text-secondary border">Şifre Yok</span>`;
                        
                        let escapedUserName = name.replace(/'/g, "\\'");
                        let escapedEmail = email.replace(/'/g, "\\'");
                        let escapedPass = pass.replace(/'/g, "\\'");
                        
                        html += `
                            <tr class="${kilitli ? 'text-muted' : ''}" style="${kilitli ? 'background:#fafafa;' : ''}">
                                <td class="fw-bold">${code}</td>
                                <td>${name}</td>
                                <td>${passDisplay}</td>
                                <td>${yetkiBadge}</td>
                                <td class="text-center text-nowrap">
                                    <button class="btn btn-sm btn-light border" onclick="editSapUser(${internalKey}, '${code}', '${escapedUserName}', '${escapedEmail}', '${yetki}', '${escapedPass}')">
                                        <i class="fas fa-edit text-primary"></i> Düzenle
                                    </button>
                                    <button class="btn btn-sm ${kilitli ? 'btn-outline-success' : 'btn-outline-warning'}" title="${kilitli ? 'Aktife al' : 'Pasife çek: giriş yapamaz, atama listelerinde görünmez'}" onclick="toggleSapUserLock(${internalKey}, '${code}', ${kilitli ? 'false' : 'true'})">
                                        <i class="fas ${kilitli ? 'fa-unlock' : 'fa-user-slash'}"></i> ${kilitli ? 'Aktife al' : 'Pasife çek'}
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" title="SAP'den sil (SAP izin vermezse pasife çekin)" onclick="deleteSapUser(${internalKey}, '${code}')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        `;
                    });

                    // DİĞER ŞİRKETLERDEKİ KULLANICILAR (URASKIMYA'da kaydı yok).
                    // "URASKIMYA'da Aç" formu bu bilgilerle dolu açar; yönetici yetkiyi seçip kaydeder.
                    const digerler = res.digerler || [];
                    if (digerler.length) {
                        html += `<tr class="sap-ayrac"><td colspan="5" class="bg-light fw-bold text-secondary small py-2">
                                    <i class="fas fa-building me-1"></i> Diğer şirketlerdeki kullanıcılar (URASKIMYA'da yok) — ${digerler.length} kişi
                                 </td></tr>`;
                        digerler.forEach(u => {
                            let code = u.userCode || u.UserCode || '';
                            let name = u.userName || u.UserName || '';
                            let email = u.eMail || u.EMail || '';
                            let yetki = u.u_BE1_YETKI || u.U_BE1_YETKI || '';
                            let pass = u.u_BE1_PASSWORD || u.U_BE1_PASSWORD || '';
                            let sirketler = (u.sirketler || u.Sirketler || []).join(', ');
                            let tel = u.personelTel || u.PersonelTel || '';
                            html += `
                                <tr class="sap-diger" style="background:#fbfbff;">
                                    <td class="fw-bold">${code}<br><span class="badge bg-secondary" title="Bu kodun bulunduğu şirketler">${sirketler}</span></td>
                                    <td>${name || '-'}${email ? '<br><span class="text-muted small">' + email + '</span>' : ''}${tel ? '<br><span class="text-muted small">' + tel + '</span>' : ''}</td>
                                    <td>${pass ? '<span class="text-muted">' + pass + '</span>' : '<span class="badge bg-light text-secondary border">Şifre Yok</span>'}</td>
                                    <td>${yetki ? '<span class="badge bg-info text-dark">' + yetki + '</span>' : '<span class="badge bg-secondary">Yetki Yok</span>'}</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-success fw-bold" data-code="${encodeURIComponent(code)}" data-name="${encodeURIComponent(name)}" data-email="${encodeURIComponent(email)}" data-yetki="${encodeURIComponent(yetki)}" data-pass="${encodeURIComponent(pass)}" onclick="digerSirkettenAc(this)">
                                            <i class="fas fa-user-plus"></i> URASKIMYA'da Aç
                                        </button>
                                    </td>
                                </tr>`;
                        });
                    }
                    $('#sapUserTableBody').html(html);
                } else {
                    $('#sapUserTableBody').html(`<tr><td colspan="5" class="text-center text-danger">${res.message}</td></tr>`);
                }
            }).fail(function() {
                $('#sapUserTableBody').html('<tr><td colspan="5" class="text-center text-danger">Sunucu ile bağlantı koptu.</td></tr>');
            });
        }

        function prepareNewSapUser() {
            $('#sapIsEdit').val('0');
            $('#sapInternalKey').val('0'); 
            $('#sapUserCode').val('').prop('readonly', false);
            $('#sapUserName').val('');
            $('#sapEmail').val('');
            $('#sapPassword').val('');
            $('#sapAuthority').val('');
            
            document.getElementById('form-tab').click(); 
        }

        function editSapUser(internalKey, userCode, userName, email, auth, pass) {
            $('#sapIsEdit').val('1');
            $('#sapInternalKey').val(internalKey); 
            $('#sapUserCode').val(userCode).prop('readonly', true);
            $('#sapUserName').val(userName);
            $('#sapEmail').val(email);
            $('#sapPassword').val(pass); 
            $('#sapAuthority').val(auth);
            
            document.getElementById('form-tab').click(); 
        }

        function saveSapUser() {
            const isEdit = $('#sapIsEdit').val() === '1';
            const internalKey = $('#sapInternalKey').val(); 
            const userCode = $('#sapUserCode').val().trim();
            
            const payload = {
                UserCode: userCode,
                UserName: $('#sapUserName').val().trim(),
                eMail: $('#sapEmail').val().trim(),
                U_BE1_PASSWORD: $('#sapPassword').val().trim(),
                U_BE1_YETKI: $('#sapAuthority').val()
            };

            if (!payload.UserCode) {
                Swal.fire('Uyarı', 'Kullanıcı Kodu zorunludur!', 'warning');
                return;
            }

            const url = isEdit ? `/Permission/UpdateSapUser?internalKey=${internalKey}` : `/Permission/CreateSapUser`;

            Swal.fire({ title: 'SAP Service Layer İşlemi Yapılıyor...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        Swal.fire('Başarılı!', res.message, 'success').then(() => {
                            document.getElementById('list-tab').click(); 
                            loadSapUsers(); 
                        });
                    } else {
                        Swal.fire('Hata', res.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Hata', 'Sunucu ile iletişim hatası oluştu.', 'error');
                }
            });
        }

        /* ===== Önerilen modern menü düzeni (Menü Başlıkları sekmesi) ===== */
        function menuDuzeniUygula() {
            $.get('/Permission/MenuDuzeniOnizle', function (res) {
                if (!res || !res.success) { Swal.fire('Hata', (res && res.message) || 'Önizleme alınamadı.', 'error'); return; }
                var kac = (s) => $('<div>').text(s == null ? '' : String(s)).html();
                var gruplar = {};
                res.plan.forEach(function (p) { (gruplar[p.ustGrup] = gruplar[p.ustGrup] || []).push(p); });
                var html = '<div class="text-start" style="max-height:52vh;overflow:auto;font-size:.85rem;">';
                Object.keys(gruplar).forEach(function (g) {
                    html += '<div class="fw-bold mt-2 mb-1" style="color:#1d4ed8;"><i class="fas fa-folder me-1"></i>' + kac(g) + '</div><ul class="mb-1 ps-3">';
                    gruplar[g].forEach(function (p) {
                        var birlesen = p.kaynaklar.filter(function (k) { return k.ad.toLowerCase() !== p.hedef.toLowerCase(); }).map(function (k) { return kac(k.ad) + ' (' + k.adet + ')'; });
                        html += '<li><i class="' + kac(p.ikon) + ' me-1 text-muted"></i><b>' + kac(p.hedef) + '</b>'
                             + (birlesen.length ? ' <span class="text-muted">← ' + birlesen.join(', ') + '</span>' : '') + '</li>';
                    });
                    html += '</ul>';
                });
                if (res.planDisi && res.planDisi.length) html += '<div class="mt-2 small text-muted">Plan dışı başlıklar (sona alınır, silinmez): ' + res.planDisi.map(kac).join(', ') + '</div>';
                html += '</div><div class="small text-muted mt-2">Yalnızca başlık adı/sırası/ikonu ve üst grup değişir; raporlar ve kullanıcı yetkileri korunur. Tekrar çalıştırmak zararsızdır.</div>';
                Swal.fire({ title: 'Önerilen menü düzeni uygulansın mı?', html: html, width: 760, icon: 'question', showCancelButton: true, confirmButtonText: 'Evet, uygula', cancelButtonText: 'Vazgeç', confirmButtonColor: '#2563eb' })
                    .then(function (r) {
                        if (!r.isConfirmed) return;
                        $.ajax({ url: '/Permission/MenuDuzeniUygula', type: 'POST', headers: { 'RequestVerificationToken': $('#antiForgeryForm input[name="__RequestVerificationToken"]').val() || '' } })
                            .done(function (s) {
                                if (s && s.success) Swal.fire({ title: 'Uygulandı', html: '<div class="text-start small" style="max-height:40vh;overflow:auto;">' + (s.log || []).map(kac).join('<br>') + '</div>', icon: 'success' }).then(function () { location.reload(); });
                                else Swal.fire('Hata', (s && s.message) || 'Uygulanamadı.', 'error');
                            })
                            .fail(function (x) { Swal.fire('Hata', x.responseText || x.statusText, 'error'); });
                    });
            }).fail(function (x) { Swal.fire('Hata', x.responseText || x.statusText, 'error'); });
        }

        /* ===== Şirketler sekmesi: görünen ad / öneri / aktiflik ===== */
        function sirketSatir(id) { return $('#tblSirketler tr[data-sirket-id="' + id + '"]'); }
        function sirketAdiKaydet(id) {
            var kutu = sirketSatir(id).find('.sirket-ad');
            var ad = (kutu.val() || '').trim();
            if (!ad) { Swal.fire('Uyarı', 'Görünen ad boş olamaz.', 'warning'); return; }
            $.post('/Permission/UpdateDatabaseDisplay', { id: id, display: ad, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function (res) {
                if (res.success) { kutu.addClass('is-valid'); setTimeout(function () { kutu.removeClass('is-valid'); }, 1500); toastr && toastr.success ? toastr.success(res.message) : null; }
                else Swal.fire('Hata', res.message, 'error');
            }).fail(function () { Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); });
        }
        function sirketOneriUygula(id, oneri) { sirketSatir(id).find('.sirket-ad').val(oneri).focus(); }
        function sirketAktifDegistir(id, aktif) {
            $.post('/Permission/SirketAktifDegistir', { id: id, aktif: aktif, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function (res) {
                if (!res.success) { Swal.fire('Hata', res.message || 'Kaydedilemedi.', 'error'); return; }
                sirketSatir(id).toggleClass('table-secondary opacity-75', !aktif);
            }).fail(function () { Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); });
        }
        function sirketAdlariniDoldur(sadeceBos) {
            Swal.fire({
                title: sadeceBos ? 'Boş adlar doldurulsun mu?' : 'Tüm şirket adları doldurulsun mu?',
                html: sadeceBos ? 'Yalnızca hâlâ ham veritabanı adı taşıyan şirketlere önerilen ad yazılır.' : 'Tüm şirketlerin görünen adı önerilen adla <b>değiştirilir</b> (elle yazdıklarınız dâhil). Sonra tek tek düzeltebilirsiniz.',
                icon: 'question', showCancelButton: true, confirmButtonText: 'Evet, doldur', cancelButtonText: 'Vazgeç', confirmButtonColor: '#2563eb'
            }).then(function (r) {
                if (!r.isConfirmed) return;
                $.post('/Permission/SirketAdlariniDoldur', { sadeceBos: sadeceBos, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function (res) {
                    if (res.success) Swal.fire({ icon: 'success', title: 'Tamam', text: res.message, timer: 1500, showConfirmButton: false }).then(function () { location.reload(); });
                    else Swal.fire('Hata', res.message, 'error');
                }).fail(function () { Swal.fire('Hata', 'Sunucu ile iletişim kurulamadı.', 'error'); });
            });
        }
        function sirketAra(q) {
            q = (q || '').toLocaleLowerCase('tr-TR');
            $('#tblSirketler tbody tr').each(function () {
                var m = ($(this).find('td').first().text() + ' ' + $(this).find('.sirket-ad').val()).toLocaleLowerCase('tr-TR');
                $(this).toggle(!q || m.indexOf(q) >= 0);
            });
        }
    </script>
}