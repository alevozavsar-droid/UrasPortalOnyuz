@{
    ViewData["Title"] = "Otomatik Kapatma";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string onKod = (string)ViewBag.Kod ?? "";
}
@*
    OTOMATİK KAPATMA (eski adı: Mutabakat; "Otomatik Kapama" ekranı da buraya yönlenir). Amaç: açık faturalar ile faturayla eşleştirilmemiş ödeme / tahsilat / çek / senet hareketlerinin
    kapatılması — tüm carilerde tek tıkla otomatik (aynı para biriminde önce birebir tutar eşleşmesi, sonra en eski vadeli faturaya FIFO) ya da cari bazında fatura ve ödemeleri elle seçerek.
    Veri ve kurallar: Data/KapamaOrnek.cs · uçlar: Controllers/KapamaController.cs · betik: wwwroot/js/otomatik-kapatma.js · hareketler Cari Mutabakat (Data/MutabakatOrnek.cs) üzerinde kapanır.
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<link rel="stylesheet" href="/css/cari-islem.css?v=2" />
}
<div class="container-fluid py-3 na ci ok" id="ok" data-kod="@onKod">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-link"></i></span>Otomatik Kapatma</h4>
        <span style="font-size:.68rem;font-weight:700;color:#475569;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:999px;padding:3px 10px"><i class="fas fa-database me-1"></i>Cari Mutabakat Hareketleri · Tüm Cariler</span>
        <span class="sub w-100">Açık (kapanmamış) faturalar ile faturayla <b>eşleştirilmemiş ödeme / tahsilat / çek / senet</b> hareketleri burada kapatılır. <b>Otomatik</b>: aynı para biriminde önce tutarı birebir eşleşen fatura–ödeme çiftleri, sonra kalan ödemeler en eski vadeli açık faturalara (FIFO) dağıtılır — tek cari için ya da <b>tüm carilerde tek tıkla</b>. <b>Elle</b>: cari detayında fatura ve ödemeleri seçip eşleştir, tutarı düzelt, kapat. Kapatılan tutarlar fatura ve ödemenin kalanından düşer, cari günlüğüne ve kapama kaydına yazılır.</span>
    </div>
    <div class="na-sekme" id="okSekmeler" data-dinamik="kapali">
        <button type="button" data-p="liste" class="aktif"><i class="fas fa-list me-1"></i>Cariler <span class="n" id="okN">0</span></button>
        <button type="button" data-p="detay"><i class="fas fa-arrows-left-right me-1"></i>Cari Eşleştirme <span class="n" id="okNDetay">—</span></button>
        <button type="button" data-p="kayit"><i class="fas fa-clock-rotate-left me-1"></i>Kapama Kayıtları <span class="n" id="okNKayit">0</span></button>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>
    <div class="ci-kpi" id="okKpi"></div>
    <div class="na-panel aktif" data-p="liste">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-filter me-1"></i>Filtreler</span><span class="d-flex gap-1 align-items-center">
                <button type="button" class="btn btn-light btn-sm py-0" id="okTemizle" style="font-size:.66rem">Temizle</button>
                <button type="button" class="btn btn-outline-primary btn-sm py-0" id="okSeciliKapat" style="font-size:.66rem" disabled><i class="fas fa-check-double me-1"></i>Seçili Carilerde Otomatik Kapat</button>
                <button type="button" class="btn btn-primary btn-sm py-0" id="okTumKapat" style="font-size:.66rem"><i class="fas fa-bolt me-1"></i>Tüm Carilerde Otomatik Kapat</button></span></div>
            <div class="na-kart-g">
                <div id="okSuzgec"></div>
                <div class="ci-filtre">
                    <div><label>Kapama Durumu</label><select class="form-select" id="okDurum"><option value="">Tümü</option><option>Kapatılabilir</option><option>Ödeme Bekliyor</option><option>Yalnız Açık Fatura</option><option>Temiz</option></select></div>
                    <div><label>Para Birimi</label><select class="form-select" id="okPb"><option value="">Tümü</option><option>TL</option><option>USD</option><option>EUR</option></select></div>
                    <div><label>Sırala</label><select class="form-select" id="okSirala"><option value="kap">Kapatılabilir (Büyükten)</option><option value="fat">Açık Fatura</option><option value="ode">Açık Ödeme</option><option value="bakiye">Bakiye</option><option value="kod">Cari Kodu</option></select></div>
                    <div class="ms-auto na-mini" id="okSayi"></div>
                </div>
                <div class="table-responsive"><table class="na-tablo ci-liste" id="okTablo" data-dinamik="kapali"><thead><tr><th class="s"><input type="checkbox" id="okHepsi" title="Kapatılabilir carilerin tümünü seç"></th><th>Cari</th><th>Tip · Sınıf</th><th>Şirket · Temsilci</th><th class="e">Bakiye (TL)</th><th class="e">Açık Fatura</th><th class="e">Eşleşmemiş Ödeme</th><th class="e">Kapatılabilir (TL)</th><th class="s">Öneri</th><th>Durum</th><th>Risk · Limit</th><th>Son Kapama</th><th></th></tr></thead><tbody></tbody><tfoot></tfoot></table></div>
            </div>
        </div>
    </div>
    <div class="na-panel" data-p="detay">
        <div class="row g-2">
            <div class="col-lg-9">
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-user-tie me-1"></i>Cari</span><span class="d-flex gap-1 align-items-center"><input class="form-control" id="okCariAra" placeholder="Kod ya da ad ile ara…" style="width:180px;font-size:.66rem;height:24px"><select class="form-select" id="okCari" style="width:300px;font-size:.66rem;height:24px;padding:0 20px 0 6px"><option value="">Seçiniz…</option></select></span></div>
                    <div class="na-kart-g"><div id="okCariOzet" class="na-mini"><span class="text-muted">Listeden ya da yukarıdan bir cari seçin.</span></div></div></div>
                <div class="row g-2">
                    <div class="col-xl-6"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-file-invoice me-1"></i>Açık Faturalar <span class="n" id="okNFat">0</span></span><span class="not" id="okFatSec">seçili: 0</span></div><div class="na-kart-g p-0"><div class="table-responsive" style="max-height:360px"><table class="na-tablo ci-liste" id="okFaturalar" data-dinamik="kapali"><thead><tr><th class="s"><input type="checkbox" id="okFatHepsi"></th><th>Belge</th><th>Tarih</th><th>Vade</th><th class="s">Gecikme</th><th class="s">Tip</th><th class="e">Tutar</th><th class="e">Kalan</th></tr></thead><tbody><tr><td colspan="8" class="na-bos">Cari seçin.</td></tr></tbody></table></div></div></div></div>
                    <div class="col-xl-6"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-money-bill-transfer me-1"></i>Eşleştirilmemiş Ödeme / Tahsilat / Çek <span class="n" id="okNOde">0</span></span><span class="not" id="okOdeSec">seçili: 0</span></div><div class="na-kart-g p-0"><div class="table-responsive" style="max-height:360px"><table class="na-tablo ci-liste" id="okOdemeler" data-dinamik="kapali"><thead><tr><th class="s"><input type="checkbox" id="okOdeHepsi"></th><th>Belge</th><th>Tarih</th><th>Belge Tipi</th><th class="s">Tip</th><th class="e">Tutar</th><th class="e">Kalan</th></tr></thead><tbody><tr><td colspan="7" class="na-bos">Cari seçin.</td></tr></tbody></table></div></div></div></div>
                </div>
                <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-arrows-left-right me-1"></i>Eşleştirme Listesi <span class="n" id="okNCift">0</span></span><span class="d-flex gap-1">
                    <button type="button" class="btn btn-light btn-sm py-0" id="okOner" style="font-size:.64rem" title="Seçili fatura ve ödemeler için (seçim yoksa tümü) birebir + FIFO önerisi"><i class="fas fa-wand-magic-sparkles me-1"></i>Otomatik Eşleştir</button>
                    <button type="button" class="btn btn-light btn-sm py-0" id="okElle" style="font-size:.64rem" title="Bir fatura ve bir ödeme seçip ekle (tutar = küçük olan kalan)"><i class="fas fa-hand-pointer me-1"></i>Seçileni Eşle</button>
                    <button type="button" class="btn btn-light btn-sm py-0" id="okCiftTemizle" style="font-size:.64rem">Listeyi Boşalt</button></span></div>
                    <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="okCiftler" data-dinamik="kapali"><thead><tr><th>Fatura</th><th></th><th>Ödeme / Tahsilat</th><th class="s">PB</th><th class="e">Tutar</th><th class="s">Yöntem</th><th></th></tr></thead><tbody><tr><td colspan="7" class="na-bos">Önce "Otomatik Eşleştir" ya da fatura + ödeme seçip "Seçileni Eşle".</td></tr></tbody><tfoot></tfoot></table></div></div></div>
            </div>
            <div class="col-lg-3">
                <div class="na-kart ci-yan"><div class="na-kart-b"><span><i class="fas fa-calculator me-1"></i>Kapama Özeti</span></div>
                    <div class="na-kart-g">
                        <div class="ci-ozet" id="okOzet"></div>
                        <div class="d-grid gap-1 mt-2">
                            <button type="button" class="btn btn-primary btn-sm" id="okKapat" disabled><i class="fas fa-link me-1"></i>Eşleşmeleri Kapat</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="okCariOto" disabled><i class="fas fa-bolt me-1"></i>Bu Caride Otomatik Kapat</button>
                            <a class="btn btn-light btn-sm" id="okEkstre" href="#" target="_blank" rel="noopener"><i class="fas fa-file-invoice me-1"></i>Cari Ekstre</a>
                        </div>
                        <div class="ci-rehber"><div><b>Birebir:</b> tutarı tam eşleşen fatura–ödeme çifti.</div><div><b>FIFO:</b> kalan ödeme en eski vadeli faturadan başlayarak dağıtılır.</div><div><b>Elle:</b> bir fatura + bir ödeme seçilir; tutar düzenlenebilir.</div><div>Para birimi farklı belgeler eşleştirilmez.</div></div>
                        <div class="mt-2" id="okCariLog"></div>
                    </div></div>
            </div>
        </div>
    </div>
    <div class="na-panel" data-p="kayit">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-clock-rotate-left me-1"></i>Kapama Kayıtları</span><span class="d-flex gap-1 align-items-center"><input class="form-control" id="okKayitAra" placeholder="Cari, belge…" style="width:200px;font-size:.66rem;height:24px"><button type="button" class="btn btn-light btn-sm py-0" id="okKayitExcel" style="font-size:.66rem"><i class="fas fa-file-excel me-1"></i>Excel</button></span></div>
            <div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="okKayitlar" data-dinamik="kapali"><thead><tr><th>Zaman</th><th>Cari</th><th class="s">Mod</th><th class="s">Eşleşme</th><th class="e">Toplam (TL)</th><th>Özet</th><th>Eşleşmeler</th><th>Kim</th></tr></thead><tbody></tbody></table></div></div></div>
    </div>
</div>
@section Scripts {
<script src="/js/cari-suzgec.js?v=1"></script>
<script src="/js/otomatik-kapatma.js?v=2"></script>
}
