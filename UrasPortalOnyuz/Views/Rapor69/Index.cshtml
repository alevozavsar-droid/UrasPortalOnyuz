@model WebApplication3.Models.Rapor69ViewModel

@{
    ViewData["Title"] = "İthalat Cari Hareketleri";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 1. KURAL: URL'den veya Cookie'den aktif şirketi okuyan değişken
    var currentDb = Context.Request.Query["db"].FirstOrDefault() ?? Context.Request.Cookies["AktifSirket"] ?? "";

    var currentSelectedDbDisplay = (string)ViewBag.CurrentDbDisplay ?? "Bilinmiyor";
    var errorMessage = ViewBag.ErrorMessage as string;

    // Sekmeler (Tabs) için sayaçları hesaplıyoruz
    int emptyCount = Model?.Satirlar?.Count(x => string.IsNullOrEmpty(x.IthalatDosyaNo)) ?? 0;
    int assignedCount = Model?.Satirlar?.Count(x => !string.IsNullOrEmpty(x.IthalatDosyaNo)) ?? 0;
    int totalCount = Model?.Satirlar?.Count() ?? 0;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, sans-serif;
            background-color: #f8f9fa;
            font-size: 0.85rem;
        }

        .table-container {
            height: calc(100vh - 200px); /* Tabların ve geri dön butonunun sığması için optimize edildi */
            overflow: auto;
            border: 1px solid #dee2e6;
            background-color: white;
            border-top: none; /* Tab ile birleşik görünsün diye */
        }

        thead th {
            position: sticky;
            top: 0;
            background-color: #2e4053;
            color: white;
            z-index: 10;
            text-align: center;
        }

        td {
            vertical-align: middle !important;
            padding: 4px 8px !important;
        }

        .select2-container--bootstrap-5 .select2-selection {
            font-size: 0.8rem;
            min-height: 26px;
        }

        /* İthalat için biraz farklı başlık rengi */
        .card-header-custom {
            color: #0d6efd;
        }

        /* Özel Tab Tasarımı */
        .nav-tabs .nav-link {
            font-weight: bold;
            color: #495057;
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-bottom: none;
            margin-right: 2px;
            cursor: pointer;
        }
        .nav-tabs .nav-link.active {
            color: #0d6efd;
            background-color: #fff;
            border-top: 3px solid #0d6efd;
        }
    </style>
}

@* 2. KURAL: Güvenlik (CSRF) - Yetkisiz veri işlemlerini ve POST isteklerini engellemek için eklendi *@
@Html.AntiForgeryToken()

<div class="container-fluid p-3">

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow-sm" role="alert">
            <h4 class="alert-heading"><i class="fas fa-ban"></i> Modül Kapalı</h4>
            <p>@errorMessage</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body p-2">
                <form asp-controller="Rapor69" asp-action="Index" method="get">
                    
                    @* 1. KURAL: GET formuna şirket bilgisini ekleyen gizli input *@
                    <input type="hidden" name="db" value="@currentDb" />

                    <div class="row g-2 align-items-center">
                        <div class="col-auto">
                            <h6 class="m-0 fw-bold card-header-custom">
                                <i class="fas fa-ship me-2"></i>İthalat Dosya Atama
                                <small class="text-secondary">(@currentSelectedDbDisplay)</small>
                            </h6>
                        </div>
                        <div class="col-auto ms-auto">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text fw-bold">Tarih</span>
                                <input type="date" class="form-control" name="startDate" value="@ViewBag.StartDate">
                                <input type="date" class="form-control" name="endDate" value="@ViewBag.EndDate">
                                <button type="submit" class="btn btn-primary">Listele</button>
                            </div>
                        </div>
                        <div class="col-auto">
                            @* 1. KURAL: Excel indirme linkine db parametresi eklendi *@
                            <a href="@Url.Action("ExportToExcel", "Rapor69", new { startDate = ViewBag.StartDate, endDate = ViewBag.EndDate, db = currentDb })" class="btn btn-success btn-sm">
                                <i class="fas fa-file-excel"></i> Excel
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @if (Model != null && Model.Satirlar.Any())
        {
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <a class="nav-link active tab-filter" data-filter="empty">
                        <i class="fas fa-hourglass-half text-warning"></i> Bekleyenler (Atanmamış) 
                        <span class="badge bg-warning text-dark ms-1" id="count-empty">@emptyCount</span>
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link tab-filter" data-filter="assigned">
                        <i class="fas fa-check-circle text-success"></i> Tamamlananlar (Atanmış) 
                        <span class="badge bg-success ms-1" id="count-assigned">@assignedCount</span>
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link tab-filter" data-filter="all">
                        <i class="fas fa-list text-primary"></i> Tümü 
                        <span class="badge bg-primary ms-1" id="count-all">@totalCount</span>
                    </a>
                </li>
            </ul>

            <div class="table-container shadow-sm">
                <table class="table table-bordered table-striped table-hover mb-0" id="mainTable">
                    <thead>
                        <tr>
                            <th>Cari Kodu</th>
                            <th>Cari Adı</th>
                            <th>Yevmiye No</th>
                            <th>Belge No</th>
                            <th>Belge Tarihi</th>
                            <th>Vade Tarihi</th>
                            <th style="min-width: 250px; background-color: #e8f8f5; color: #000;">İthalat Dosya No (Güncelle)</th>
                            <th>Para Birimi</th>
                            <th>Tutar (Borç)</th>
                            <th>Tutar (Döviz)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Satirlar)
                        {
                            // Satırın boş mu dolu mu olduğunu tutan class ataması
                            string statusClass = string.IsNullOrEmpty(item.IthalatDosyaNo) ? "status-empty" : "status-assigned";

                            <tr class="row-item @statusClass">
                                <td class="fw-bold">@item.CardCode</td>
                                <td>@item.CardName</td>
                                <td class="text-center">@item.TransId</td>
                                <td>@item.Ref1</td>
                                <td class="text-center">@item.TaxDate.ToString("dd.MM.yyyy")</td>
                                <td class="text-center">@item.DueDate.ToString("dd.MM.yyyy")</td>

                                <td style="background-color: #f0fff4;">
                                    <select class="form-select form-select-sm dosya-select" data-transid="@item.TransId">
                                        <option value="">Seçiniz...</option>
                                        @if (Model.DosyaListesi != null)
                                        {
                                            foreach (var dosya in Model.DosyaListesi)
                                            {
                                                var isSelected = dosya.DosyaNo == item.IthalatDosyaNo;

                                                <option value="@dosya.DosyaNo" selected="@(isSelected ? "selected" : null)">
                                                    @dosya.DosyaNo - @dosya.CariAdi - @dosya.AcctCode - @dosya.AcctName
                                                </option>
                                            }
                                        }
                                    </select>
                                </td>

                                <td class="text-center">@item.ParaBirimi</td>
                                <td class="text-end fw-bold text-danger">@item.TutarUlusal.ToString("N2")</td>
                                <td class="text-end text-danger">@item.TutarDoviz.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning m-3 text-center shadow-sm">
                Belirtilen kriterlere uygun veri bulunamadı.
            </div>
        }
    }

    @* 4. KURAL: UI/UX Standartlarına uygun şık, db parametreli Ana Sayfa butonu *@
    <div class="mt-4 mb-2 text-center">
        <a asp-controller="Home" asp-action="Index" asp-route-db="@currentDb" class="btn btn-outline-secondary fw-bold shadow-sm">
            <i class="fas fa-home me-2"></i> Ana Sayfaya Dön
        </a>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    @if (string.IsNullOrEmpty(errorMessage))
    {
        <script>
            // 1. KURAL İÇİN JS DEĞİŞKENİ: Aktif Şirketi JavaScript tarafında hafızaya alıyoruz
            const activeDbCode = '@currentDb';
            
            // 2. KURAL İÇİN JS DEĞİŞKENİ: CSRF Güvenlik tokenı
            const csrfToken = $('input[name="__RequestVerificationToken"]').val();

            $(document).ready(function () {
                
                // 1. Select2 Başlatma
                $('.dosya-select').select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    placeholder: "Dosya Seçin",
                    allowClear: true
                });

                // 2. Sekmelere Tıklanınca Tabloyu Filtreleme
                function applyFilter(filterType) {
                    if (filterType === 'all') {
                        $('.row-item').show();
                    } else if (filterType === 'empty') {
                        $('.row-item').hide();
                        $('.status-empty').show();
                    } else if (filterType === 'assigned') {
                        $('.row-item').hide();
                        $('.status-assigned').show();
                    }
                }

                // Sayfa ilk yüklendiğinde varsayılan olarak "empty" (Bekleyenler) sekmesi aktif
                applyFilter('empty');

                $('.tab-filter').click(function () {
                    $('.tab-filter').removeClass('active');
                    $(this).addClass('active');
                    
                    var filter = $(this).data('filter');
                    applyFilter(filter);
                });

                // 3. Sayıları Güncelleme Fonksiyonu
                function updateCounts() {
                    var emptyCount = $('.status-empty').length;
                    var assignedCount = $('.status-assigned').length;
                    var allCount = $('.row-item').length;

                    $('#count-empty').text(emptyCount);
                    $('#count-assigned').text(assignedCount);
                    $('#count-all').text(allCount);
                }

                // 4. Dropdown Değişince AJAX ile Veri Kaydetme ve Satırı İlgili Sekmeye Taşıma
                $('.dosya-select').on('change', function () {
                    var selectElem = $(this);
                    var tr = selectElem.closest('tr');
                    var transId = selectElem.data('transid');
                    var selectedValue = selectElem.val();

                    toastr.options = { "positionClass": "toast-bottom-right", "timeOut": "2000" };

                    $.ajax({
                        // 1. KURAL: URL sonuna ?db= eklenerek POST işleminde şirket kaybetme sorunu çözüldü
                        url: '@Url.Action("UpdateDosyaNo", "Rapor69")?db=' + activeDbCode,
                        type: 'POST',
                        // 2. KURAL: Güvenlik Token'ı (CSRF) header üzerinden sunucuya iletiliyor
                        headers: {
                            "RequestVerificationToken": csrfToken
                        },
                        data: {
                            transId: transId,
                            dosyaNo: selectedValue
                        },
                        success: function (response) {
                            if (response.success) {
                                toastr.success('İthalat dosya no güncellendi.');

                                // Sınıfı güncelle
                                if (selectedValue) {
                                    tr.removeClass('status-empty').addClass('status-assigned');
                                } else {
                                    tr.removeClass('status-assigned').addClass('status-empty');
                                }

                                // Sayıları hemen güncelle
                                updateCounts();

                                // Aktif sekmeye göre satırı ekrandan gizle 
                                // (Kullanıcı "Bekleyenler"deyse ve atama yaptıysa satır kaybolur)
                                var currentFilter = $('.tab-filter.active').data('filter');
                                if (currentFilter === 'empty' && selectedValue) {
                                    tr.fadeOut(300);
                                } else if (currentFilter === 'assigned' && !selectedValue) {
                                    tr.fadeOut(300);
                                }
                            } else {
                                toastr.error('Hata: ' + response.message);
                            }
                        },
                        error: function () {
                            toastr.error('Sunucu hatası.');
                        }
                    });
                });

            });
        </script>
    }
}