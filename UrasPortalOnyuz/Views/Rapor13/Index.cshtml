                </div>
            </div>
        </div>

        <div class="table-container">
            <table class="table table-bordered table-striped table-hover rapor-tablo" id="rapor13Table">
                <thead>
                    <tr>
                        <th style="width: 30px;"><input type="checkbox" id="selectAllCheckbox"></th>
                        <th data-column="0" data-sort-type="text" class="has-filter">
                            <span class="filter-title">İhracat Dosya Numarası <i class="fas fa-sort sort-icon"></i></span>
                            <input type="text" class="form-control filter-input" placeholder="Filtrele..." data-column="0">
                        </th>
                        <th data-column="1" data-sort-type="text" class="has-filter">
                            <span class="filter-title">Müşteri Temsilcisi <i class="fas fa-sort sort-icon"></i></span>
                            <div class="multi-select-dropdown">
                                <button type="button" class="multi-select-button" data-column="1" aria-expanded="false">Tümü</button>
                                <div class="multi-select-options" data-column="1">
                                    <input type="text" class="multi-select-search-input" placeholder="Ara...">
                                    <div class="multi-select-header">
                                        <input type="checkbox" class="select-all-options-in-filter">
                                        <label>(Tümünü Seç)</label>
                                    </div>
                                    @foreach (var item in musteriTemsilcisiList)
                                    {
                                        <div class="multi-select-option">
