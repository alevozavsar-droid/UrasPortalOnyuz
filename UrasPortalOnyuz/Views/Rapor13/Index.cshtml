                                    @foreach (var item in belgeTuruList)
                                    {
                                        <div class="multi-select-option">
                                            <input type="checkbox" value="@item.ToLower()">
                                            <label>@item</label>
                                        </div>
                                    }
                                    <div class="multi-select-actions">
                                        <button type="button" class="btn btn-primary apply-filter-btn">Tamam</button>
                                        <button type="button" class="btn btn-secondary cancel-filter-btn">İptal</button>
                                    </div>
                                </div>
                            </div>
                        </th>
                        <th data-column="25" data-sort-type="number" class="has-filter">
                            <span class="filter-title">Satış Sipariş No <i class="fas fa-sort sort-icon"></i></span>
                            <input type="text" class="form-control filter-input" placeholder="Filtrele..." data-column="25">
                        </th>
                        <th data-column="26" data-sort-type="text" class="has-filter">
                            <span class="filter-title">Fatura Ayı <i class="fas fa-sort sort-icon"></i></span>
                            <div class="multi-select-dropdown">
                                <button type="button" class="multi-select-button" data-column="26" aria-expanded="false">Tümü</button>
                                <div class="multi-select-options" data-column="26">
                                    <input type="text" class="multi-select-search-input" placeholder="Ara...">
                                    <div class="multi-select-header">
                                        <input type="checkbox" class="select-all-options-in-filter">
                                        <label>(Tümünü Seç)</label>
                                    </div>
                                    @foreach (var item in faturaAyiList)
                                    {
                                        <div class="multi-select-option">
                                            <input type="checkbox" value="@item.ToLower()">
                                            <label>@item</label>
                                        </div>
                                    }
                                    <div class="multi-select-actions">
                                        <button type="button" class="btn btn-primary apply-filter-btn">Tamam</button>
                                        <button type="button" class="btn btn-secondary cancel-filter-btn">İptal</button>
                                    </div>
                                </div>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-gumruk-tutari="@item.GumrukBeyannameTutari" data-kalan-odeme-tutari="@item.KalanOdemeTutari">
                            <td><input type="checkbox" class="row-checkbox"></td>
                            <td>@Html.DisplayFor(modelItem => item.IhracatDosyaNumarasi)</td>
                            <td>@Html.DisplayFor(modelItem => item.MusteriTemsilcisi)</td>
                            <td>@Html.DisplayFor(modelItem => item.SirketAdi)</td>
                            <td>@Html.DisplayFor(modelItem => item.FaturaNo)</td>
                            <td>@Html.DisplayFor(modelItem => item.MusteriFirmaAdi)</td>
                            <td>@Html.DisplayFor(modelItem => item.Ulke)</td>
                            <td>@Html.DisplayFor(modelItem => item.GumrukBeyannameIntacTarihi)</td>
                            <td>@Html.DisplayFor(modelItem => item.TaahhutDolumTarihi)</td>
                            <td>@Html.DisplayFor(modelItem => item.KalanGunSayisi)</td>
                            <td>@Html.DisplayFor(modelItem => item.GumrukBeyannameNumarasi)</td>
                            <td>@Html.DisplayFor(modelItem => item.GumrukBeyannameTutari)</td>
                            <td>@Html.DisplayFor(modelItem => item.OdemeYontemi)</td>
                            <td>@Html.DisplayFor(modelItem => item.OdemeTarihi1)</td>
                            <td>@Html.DisplayFor(modelItem => item.OdemeTutari1)</td>
                            <td>@Html.DisplayFor(modelItem => item.OdemeTarihi2)</td>
                            <td>@Html.DisplayFor(modelItem => item.OdemeTutari2)</td>
                            <td>@Html.DisplayFor(modelItem => item.OdemeTarihi3)</td>
                            <td>@Html.DisplayFor(modelItem => item.OdemeTutari3)</td>
                            <td>@Html.DisplayFor(modelItem => item.OdemeTarihi4)</td>
                            <td>@Html.DisplayFor(modelItem => item.OdemeTutari4)</td>
                            <td>@Html.DisplayFor(modelItem => item.OdemeGelecekBanka)</td>
                            <td>@Html.DisplayFor(modelItem => item.KalanOdemeTutari)</td>
                            <td>@Html.DisplayFor(modelItem => item.FaturaVadeTarihi)</td>
                            <td>@Html.DisplayFor(modelItem => item.VadeyeGoreGecikme)</td>
                            <td>@Html.DisplayFor(modelItem => item.BelgeTuru)</td>
                            <td>@Html.DisplayFor(modelItem => item.SatisSiparisNo)</td>
                            <td>@Html.DisplayFor(modelItem => item.FaturaAyi)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-center mt-2" id="pagination-info">
            Toplam Kayıt: <strong>@ViewBag.TotalRecords</strong>
        </div>
    }
    else
    {
        <p>Gösterilecek veri bulunamadı.</p>
    }
</div>

<div>
    <a asp-action="Index" asp-controller="Home" asp-route-db="@currentDb" class="btn btn-outline-secondary fw-bold shadow-sm ms-3 mt-3">
        <i class="fas fa-arrow-left me-2"></i> Ana Sayfaya Dön
    </a>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            // Aktif veritabanı parametresini değişkene alıyoruz (Filtre temizle butonu için)
            const currentDbParam = '@currentDb';

            const table = document.getElementById('rapor13Table');
            const tableBody = table.querySelector('tbody');
            const tableHeaders = table.querySelectorAll('th[data-column]');
            const filterInputs = document.querySelectorAll('.filter-input');
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            const alertContainer = document.getElementById('alertContainer');
            const clearAllFiltersBtn = document.getElementById('clearAllFiltersBtn');
            const multiSelectDropdowns = document.querySelectorAll('.multi-select-dropdown');
            const totalSummaryContainer = document.getElementById('selectedRowSummary');
            const totalCustomsAmountSpan = document.getElementById('totalCustomsAmount');
            const totalRemainingAmountSpan = document.getElementById('totalRemainingAmount');

            const allOriginalRows = Array.from(tableBody.querySelectorAll('tr'));
            let currentlyFilteredRows = [...allOriginalRows];

            const multiSelectFilterStates = {};
            const initialMultiSelectValues = {};

            let currentSortColumn = -1;
            let currentSortDirection = 'none';

            function updateHeaderIcons() {
                tableHeaders.forEach(th => {
                    const icon = th.querySelector('.sort-icon');
                    if (icon && th.dataset.sortType) {
                        icon.classList.remove('fa-sort-up', 'fa-sort-down', 'fa-sort');
                        const columnIndex = parseInt(th.dataset.column);
                        if (columnIndex === currentSortColumn) {
                            if (currentSortDirection === 'asc') {
                                icon.classList.add('fa-sort-up');
                            } else if (currentSortDirection === 'desc') {
                                icon.classList.add('fa-sort-down');
                            } else {
                                icon.classList.add('fa-sort');
                            }
                        } else {
                            icon.classList.add('fa-sort');
                        }
                    } else if (icon) {
                        icon.classList.add('fa-sort');
                    }
                });
            }

            function applyFiltersAndSort() {
                const filters = [];
                filterInputs.forEach(input => {
                    const columnIndex = parseInt(input.dataset.column);
                    const filterValue = input.value.toLowerCase().trim();
                    if (filterValue) {
                        filters.push({ column: columnIndex, value: filterValue, type: 'input' });
                    }
                });

                for (const colIndex in multiSelectFilterStates) {
                    const selectedValues = multiSelectFilterStates[colIndex];
                    if (selectedValues && selectedValues.length > 0) {
                        filters.push({ column: parseInt(colIndex), values: selectedValues, type: 'multi-select' });
                    }
                }

                let filteredRows = allOriginalRows.filter(row => {
                    let isVisible = true;
                    for (const filter of filters) {
                        const actualCellIndex = filter.column + 1;
                        const cell = row.cells[actualCellIndex];
                        if (cell) {
                            let cellText = (cell.textContent || cell.innerText).toLowerCase().trim();

                            if (filter.type === 'input') {
                                if (!cellText.includes(filter.value)) {
                                    isVisible = false;
                                    break;
                                }
                            } else if (filter.type === 'multi-select') {
                                if (!filter.values.includes(cellText)) {
                                    isVisible = false;
                                    break;
                                }
                            }
                        }
                    }
                    return isVisible;
                });

                if (currentSortColumn !== -1 && currentSortDirection !== 'none') {
                    filteredRows.sort((rowA, rowB) => {
                        const sortCellIndex = currentSortColumn + 1;
                        const cellA = rowA.cells[sortCellIndex].textContent.trim();
                        const cellB = rowB.cells[sortCellIndex].textContent.trim();
                        const sortType = table.querySelector(`th[data-column="${currentSortColumn}"]`).dataset.sortType;

                        let comparison = 0;
                        if (sortType === 'number') {
                            const parseNumber = (str) => {
                                if (!str) return NaN;
                                const cleanStr = str.replace(/[^0-9,.]/g, '').replace(',', '.');
                                const parsed = parseFloat(cleanStr);
                                return isNaN(parsed) ? 0 : parsed;
                            };
                            const valA = parseNumber(cellA);
                            const valB = parseNumber(cellB);
                            comparison = (isNaN(valA) ? (isNaN(valB) ? 0 : 1) : (isNaN(valB) ? -1 : valA - valB));
                        } else if (sortType === 'date') {
                            const parseDate = (dateString) => {
                                if (!dateString) return null;
                                const parts = dateString.split('.');
                                if (parts.length === 3) {
                                    return new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));
                                }
                                return null;
                            };
                            const dateA = parseDate(cellA);
                            const dateB = parseDate(cellB);
                            if (dateA === null && dateB === null) comparison = 0;
                            else if (dateA === null) comparison = 1;
                            else if (dateB === null) comparison = -1;
                            else comparison = dateA.getTime() - dateB.getTime();
                        } else {
                            comparison = cellA.localeCompare(cellB, 'tr', { sensitivity: 'base' });
                        }
                        return currentSortDirection === 'asc' ? comparison : -comparison;
                    });
                }

                currentlyFilteredRows = filteredRows;
                while (tableBody.firstChild) {
                    tableBody.removeChild(tableBody.firstChild);
                }
                currentlyFilteredRows.forEach(row => {
                    tableBody.appendChild(row);
                });
                updateSelectAllCheckboxState();
                updateHeaderIcons();
                updatePaginationInfo();
                updateTotalSummary();
            }

            function updatePaginationInfo() {
                const totalRecords = currentlyFilteredRows.length;
                document.getElementById('pagination-info').innerHTML = `Toplam Kayıt: <strong>${totalRecords}</strong>`;
            }

            function updateTotalSummary() {
                let totalCustomsAmount = 0;
                let totalRemainingAmount = 0;
                let anyChecked = false;

                const parseNumericValue = (str) => {
                    if (!str) return 0;

                    // Metinden para birimi sembollerini, harfleri ve boşlukları temizle.
                    const cleanStr = str.replace(/[^\d.,]/g, '');

                    // Sayının son ayıracını kontrol et.
                    const lastCommaIndex = cleanStr.lastIndexOf(',');
                    const lastDotIndex = cleanStr.lastIndexOf('.');

                    let formattedStr = cleanStr;

                    // Eğer son ayraç virgüldür ve ondan sonra nokta yoksa (Türkçe format)
                    if (lastCommaIndex > lastDotIndex) {
                        // Binlik ayıracı olan noktaları kaldır, ondalık ayıracı olan virgülü noktaya çevir.
                        formattedStr = cleanStr.replace(/\./g, '').replace(',', '.');
                    } else {
                        // Eğer son ayraç noktadır veya sadece nokta varsa (Amerikan formatı)
                        // Binlik ayıracı olan virgülleri kaldır.
                        formattedStr = cleanStr.replace(/,/g, '');
                    }

                    const parsed = parseFloat(formattedStr);
                    return isNaN(parsed) ? 0 : parsed;
                };

                currentlyFilteredRows.forEach(row => {
                    const checkbox = row.querySelector('.row-checkbox');
                    if (checkbox && checkbox.checked) {
                        anyChecked = true;
                        // Gümrük Beyanname Tutarı (11. kolon)
                        const customsAmountText = row.cells[11].textContent;
                        // Kalan Ödeme Tutarı (22. kolon)
                        const remainingAmountText = row.cells[22].textContent;

                        totalCustomsAmount += parseNumericValue(customsAmountText);
                        totalRemainingAmount += parseNumericValue(remainingAmountText);
                    }
                });

                if (anyChecked) {
                    totalCustomsAmountSpan.textContent = totalCustomsAmount.toFixed(2);
                    totalRemainingAmountSpan.textContent = totalRemainingAmount.toFixed(2);
                    totalSummaryContainer.classList.remove('d-none');
                } else {
                    totalSummaryContainer.classList.add('d-none');
                }
            }

            selectAllCheckbox.addEventListener('change', function () {
                currentlyFilteredRows.forEach(row => {
                    const checkbox = row.querySelector('.row-checkbox');
                    if (checkbox) {
                        checkbox.checked = this.checked;
                    }
                });
                updateSelectAllCheckboxState();
                updateTotalSummary();
            });

            tableBody.addEventListener('change', function (event) {
                if (event.target.classList.contains('row-checkbox')) {
                    updateSelectAllCheckboxState();
                    updateTotalSummary();
                }
            });

            function updateSelectAllCheckboxState() {
                const visibleCheckboxes = currentlyFilteredRows.map(row => row.querySelector('.row-checkbox')).filter(Boolean);
                if (visibleCheckboxes.length === 0) {
                    selectAllCheckbox.checked = false;
                    selectAllCheckbox.indeterminate = false;
                    return;
                }
                const allSelected = visibleCheckboxes.every(checkbox => checkbox.checked);
                const anySelected = visibleCheckboxes.some(checkbox => checkbox.checked);
                if (allSelected) {
                    selectAllCheckbox.checked = true;
                    selectAllCheckbox.indeterminate = false;
                } else if (anySelected) {
                    selectAllCheckbox.checked = false;
                    selectAllCheckbox.indeterminate = true;
                } else {
                    selectAllCheckbox.checked = false;
                    selectAllCheckbox.indeterminate = false;
                }
            }

            filterInputs.forEach(input => {
                input.addEventListener('keyup', () => {
                    applyFiltersAndSort();
                });
            });

            tableHeaders.forEach(header => {
                header.addEventListener('click', function (event) {
                    if (event.target.closest('.multi-select-dropdown') || event.target.classList.contains('filter-input') || event.target.type === 'checkbox') {
                        return;
                    }

                    if (!this.dataset.sortType) {
                        return;
                    }

                    const columnIndex = parseInt(this.dataset.column);
                    if (isNaN(columnIndex)) {
                        return;
                    }

                    if (currentSortColumn !== columnIndex) {
                        currentSortColumn = columnIndex;
                        currentSortDirection = 'asc';
                    } else if (currentSortDirection === 'asc') {
                        currentSortDirection = 'desc';
                    } else if (currentSortDirection === 'desc') {
                        currentSortDirection = 'none';
                        currentSortColumn = -1;
                    }
                    applyFiltersAndSort();
                });
            });

            function showAlert(message, type) {
                const alertDiv = document.createElement('div');
                alertDiv.classList.add('alert', `alert-${type}`, 'alert-dismissible', 'fade');
                alertDiv.setAttribute('role', 'alert');
                alertDiv.innerHTML = `${message}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>`;
                alertContainer.innerHTML = '';
                alertContainer.appendChild(alertDiv);

                setTimeout(() => {
                    alertDiv.classList.add('show');
                }, 10);

                setTimeout(() => {
                    const bootstrapAlert = bootstrap.Alert.getInstance(alertDiv);
                    if (bootstrapAlert) {
                        bootstrapAlert.dispose();
                    } else {
                        alertDiv.remove();
                    }
                }, 5000);
            }

            multiSelectDropdowns.forEach(dropdown => {
                const button = dropdown.querySelector('.multi-select-button');
                const optionsContainer = dropdown.querySelector('.multi-select-options');
                const searchInput = optionsContainer.querySelector('.multi-select-search-input');
                const selectAllInFilterCheckbox = optionsContainer.querySelector('.select-all-options-in-filter');
                const optionCheckboxes = optionsContainer.querySelectorAll('.multi-select-option input[type="checkbox"]');
                const applyBtn = optionsContainer.querySelector('.apply-filter-btn');
                const cancelBtn = optionsContainer.querySelector('.cancel-filter-btn');
                const columnIndex = parseInt(button.dataset.column);

                if (!multiSelectFilterStates[columnIndex]) {
                    multiSelectFilterStates[columnIndex] = [];
                }

                button.addEventListener('click', (e) => {
                    e.stopPropagation();

                    // Konumlandırma için TH (tablo başlığı) elementinin koordinatlarını kullan
                    const th = button.closest('th');
                    const rect = th.getBoundingClientRect();

                    optionsContainer.style.top = `${rect.bottom + window.scrollY}px`;
                    optionsContainer.style.left = `${rect.left + window.scrollX}px`;

                    // Ekranın sağ kenarından taşma kontrolü
                    const rightEdge = window.innerWidth;
                    const dropdownRight = optionsContainer.getBoundingClientRect().right;
                    if (dropdownRight > rightEdge) {
                        optionsContainer.style.left = `${rect.left + window.scrollX - (dropdownRight - rightEdge) - 20}px`;
                    }

                    document.querySelectorAll('.multi-select-options.show').forEach(otherOptions => {
                        if (otherOptions !== optionsContainer) {
                            otherOptions.classList.remove('show');
                            const otherButton = otherOptions.closest('.multi-select-dropdown').querySelector('.multi-select-button');
                            if (otherButton) otherButton.setAttribute('aria-expanded', 'false');
                        }
                    });

                    optionsContainer.classList.toggle('show');
                    button.setAttribute('aria-expanded', optionsContainer.classList.contains('show'));

                    if (optionsContainer.classList.contains('show')) {
                        initialMultiSelectValues[columnIndex] = Array.from(optionCheckboxes).filter(cb => cb.checked).map(cb => cb.value.toLowerCase());
                        searchInput.value = '';
                        optionsContainer.querySelectorAll('.multi-select-option').forEach(option => {
                            option.style.display = 'flex';
                        });
                        updateSelectAllInFilterCheckboxState(optionsContainer);
                    }
                });

                searchInput.addEventListener('keyup', (e) => {
                    const searchText = e.target.value.toLowerCase().trim();
                    optionsContainer.querySelectorAll('.multi-select-option').forEach(option => {
                        const label = option.querySelector('label');
                        const isMatch = label.textContent.toLowerCase().includes(searchText);
                        option.style.display = isMatch ? 'flex' : 'none';
                    });
                    updateSelectAllInFilterCheckboxState(optionsContainer);
                });

                selectAllInFilterCheckbox.addEventListener('change', function () {
                    const isChecked = this.checked;
                    optionsContainer.querySelectorAll('.multi-select-option').forEach(option => {
                        if (option.style.display !== 'none') {
                            option.querySelector('input[type="checkbox"]').checked = isChecked;
                        }
                    });
                });

                optionCheckboxes.forEach(cb => {
                    cb.addEventListener('change', () => {
                        updateSelectAllInFilterCheckboxState(optionsContainer);
                    });
                });

                function updateSelectAllInFilterCheckboxState(optionsContainerElement) {
                    const visibleOptionCheckboxes = Array.from(optionsContainerElement.querySelectorAll('.multi-select-option input[type="checkbox"]')).filter(cb => cb.closest('.multi-select-option').style.display !== 'none');
                    const selectAllCb = optionsContainerElement.querySelector('.select-all-options-in-filter');
                    if (visibleOptionCheckboxes.length === 0) {
                        selectAllCb.checked = false;
                        selectAllCb.indeterminate = false;
                        return;
                    }
                    const allVisibleChecked = visibleOptionCheckboxes.every(cb => cb.checked);
                    const anyVisibleChecked = visibleOptionCheckboxes.some(cb => cb.checked);
                    if (allVisibleChecked) {
                        selectAllCb.checked = true;
                        selectAllCb.indeterminate = false;
                    } else if (anyVisibleChecked) {
                        selectAllCb.checked = false;
                        selectAllCb.indeterminate = true;
                    } else {
                        selectAllCb.checked = false;
                        selectAllCb.indeterminate = false;
                    }
                }

                applyBtn.addEventListener('click', () => {
                    const selectedValues = Array.from(optionsContainer.querySelectorAll('.multi-select-option input[type="checkbox"]'))
                        .filter(cb => cb.checked)
                        .map(cb => cb.value);
                    multiSelectFilterStates[columnIndex] = selectedValues;
                    optionsContainer.classList.remove('show');
                    button.setAttribute('aria-expanded', 'false');

                    if (selectedValues.length === 0) {
                        button.textContent = "Tümü";
                    } else if (selectedValues.length === 1) {
                        const selectedLabel = Array.from(optionsContainer.querySelectorAll('.multi-select-option input[type="checkbox"]'))
                            .find(cb => cb.checked)
                            .nextElementSibling.textContent;
                        button.textContent = selectedLabel;
                    } else {
                        button.textContent = `${selectedValues.length} Seçili`;
                    }
                    applyFiltersAndSort();
                });

                cancelBtn.addEventListener('click', () => {
                    optionCheckboxes.forEach(cb => {
                        const originalState = initialMultiSelectValues[columnIndex] && initialMultiSelectValues[columnIndex].includes(cb.value.toLowerCase());
                        cb.checked = originalState;
                    });
                    optionsContainer.classList.remove('show');
                    button.setAttribute('aria-expanded', 'false');

                    const originalSelectedCount = initialMultiSelectValues[columnIndex] ? initialMultiSelectValues[columnIndex].length : 0;
                    if (originalSelectedCount === 0) {
                        button.textContent = "Tümü";
                    } else if (originalSelectedCount === 1) {
                        const originalValue = initialMultiSelectValues[columnIndex][0];
                        const originalOption = Array.from(optionsContainer.querySelectorAll('.multi-select-option')).find(opt => opt.querySelector('input[type="checkbox"]').value === originalValue);
                        button.textContent = originalOption ? originalOption.querySelector('label').textContent : "Tümü";
                    } else {
                        button.textContent = `${originalSelectedCount} Seçili`;
                    }
                    updateSelectAllInFilterCheckboxState(optionsContainer);
                    applyFiltersAndSort();
                });
            });

            document.addEventListener('click', function (e) {
                document.querySelectorAll('.multi-select-dropdown').forEach(dropdown => {
                    const optionsContainer = dropdown.querySelector('.multi-select-options');
                    const button = dropdown.querySelector('.multi-select-button');
                    if (optionsContainer.classList.contains('show') && !dropdown.contains(e.target)) {
                        optionsContainer.classList.remove('show');
                        button.setAttribute('aria-expanded', 'false');
                        applyFiltersAndSort();
                    }
                });
            });

            clearAllFiltersBtn.addEventListener('click', function () {
                let currentUrl = window.location.href;
                let baseUrl = currentUrl.split('?')[0];
                let params = new URLSearchParams(currentUrl.split('?')[1]);
                let newUrl = baseUrl;
                if (currentDbParam) {
                    newUrl += `?db=${currentDbParam}`;
                }
                window.location.href = newUrl;
            });

            applyFiltersAndSort();
            updateTotalSummary();
        });
    </script>
}