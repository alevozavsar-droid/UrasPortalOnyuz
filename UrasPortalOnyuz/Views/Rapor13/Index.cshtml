@model List<WebApplication3.Models.ExportFileTrackingViewModel>
@using WebApplication3.Models
@using System.Globalization

@{
    ViewData["Title"] = "İhracat Dosya Takip Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Modeli ve listeleri tanımlama - Sunucu taraflı veri hazırlığı
    var musteriTemsilcisiList = Model?.Select(x => x.MusteriTemsilcisi).Where(x => !string.IsNullOrEmpty(x)).Distinct().OrderBy(x => x).ToList();
    var ulkeList = Model?.Select(x => x.Ulke).Where(x => !string.IsNullOrEmpty(x)).Distinct().OrderBy(x => x).ToList();
    var odemeYontemiList = Model?.Select(x => x.OdemeYontemi).Where(x => !string.IsNullOrEmpty(x)).Distinct().OrderBy(x => x).ToList();
    var belgeTuruList = Model?.Select(x => x.BelgeTuru).Where(x => !string.IsNullOrEmpty(x)).Distinct().OrderBy(x => x).ToList();
    var faturaAyiList = Model?.Select(x => x.FaturaAyi).Where(x => !string.IsNullOrEmpty(x)).Distinct().OrderBy(x => x).ToList();

    // Aktif Veritabanını (Şirketi) URL veya Cookie'den alıyoruz ki javascript fonksiyonlarında ve linklerde kaybolmasın
    var currentDb = Context.Request.Query["db"].ToString();
    if (string.IsNullOrEmpty(currentDb))
    {
        currentDb = Context.Request.Cookies["SelectedDatabase"] ?? "DefaultConnection";
    }
    
    var currentSelectedDbDisplay = (string)ViewBag.CurrentDbDisplay ?? "URASKIMYA";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #007bff;
            --secondary-color: #6c757d;
            --success-color: #28a745;
            --danger-color: #dc3545;
            --info-color: #17a2b8;
            --light-bg: #f8f9fa;
            --white-bg: #ffffff;
            --border-color: #e0e0e0;
            --text-color: #333;
            --header-bg: #e9ecef;
            --shadow-light: 0 2px 8px rgba(0, 0, 0, 0.05);
            --shadow-medium: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        a
        /* GENEL SAYFA VE FONT AYARLARI */
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            font-size: 0.8rem;
        }

        body {
            background-color: var(--light-bg);
            font-family: 'Poppins', sans-serif;
            color: var(--text-color);
            line-height: 1.2;
        }

        /* Üst ve alt boşlukları kaldırmak için container'ı sıfırla */
        .container.mt-4 {
            max-width: 100%;
            padding: 0;
            margin-top: 0;
        }

        /* Buton ve özet alanının olduğu divin stilini ayarla - Üstteki boşluğu sıfırla ve arka planı kaldır */
        .mb-3.d-flex.justify-content-between.align-items-center {
            margin-top: 0 !important; /* Üst boşluğu tamamen kaldırmak için */
            margin-bottom: 0 !important; /* Alt boşluğu tamamen kaldırmak için */
            padding: 0; /* İç boşluğu kaldır */
            background-color: transparent; /* Arka plan rengini kaldır */
            border: none;
            box-shadow: none;
        }

        /* Butonun boyutunu daha da küçült */
        #clearAllFiltersBtn {
            padding: 3px 8px; /* Daha küçük padding */
            font-size: 0.7rem; /* Daha küçük font boyutu */
            border-radius: 4px;
        }

        h1, h2, h3, h4, h5, h6 {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 1rem; /* Başlıklar için boşluğu azalt */
        }

        .table-container {
            overflow-x: auto;
            /* Üst boşluğu sıfırlayın veya azaltın */
            margin-top: 5px; /* Butonun hemen altında başlaması için boşluk ayarı */
            max-height: calc(100vh - 80px); /* Gerekirse bu değeri ekran yüksekliğine göre ayarla */
            overflow-y: auto;
            position: relative;
            border-radius: 0;
            box-shadow: none;
            background-color: var(--white-bg);
            border: none;
        }

        /* Bu kısım ana layout dosyasında tanımlı olduğu için burada tekrar edilmemeli. */
        /* table {
            width: 100%;
            border-collapse: collapse;
        } */

        th {
            background-color: var(--header-bg);
            color: #495057;
            padding: 0 12px;
            height: 40px;
            font-size: 0.65rem;
            line-height: 1.2;
            text-align: left;
            white-space: nowrap;
            cursor: pointer;
            font-weight: 600;
            border-bottom: 2px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 20;
        }

            th.has-filter {
                padding-top: 5px;
                padding-bottom: 5px;
            }

            th .filter-title {
                display: block;
            }

            th .sort-icon {
                margin-left: 8px;
                font-size: 0.9em;
                vertical-align: middle;
                display: inline-block;
                opacity: 0.6;
                transition: opacity 0.2s ease-in-out;
            }

            th:hover .sort-icon {
                opacity: 1;
            }

            th:first-child {
                border-top-left-radius: 10px;
            }

            th:last-child {
                border-top-right-radius: 10px;
            }

        td {
            padding: 0 12px;
            height: 25px;
            font-size: 0.7rem;
            line-height: 1.1;
            vertical-align: middle;
            border-bottom: 1px solid #f2f2f2;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .table-hover tbody tr:hover {
            background-color: #f0f8ff;
            cursor: pointer;
        }

        .table-hover tbody tr.selected {
            background-color: #e0f2f7;
            border-left: 5px solid var(--primary-color);
            transition: background-color 0.2s ease-in-out, border-left 0.2s ease-in-out;
        }

        /* CHECKBOX SÜTUNU */
        th:nth-child(1), td:nth-child(1) {
            min-width: 50px;
            width: 50px;
            text-align: center;
        }

            td:nth-child(1) input[type="checkbox"] {
                transform: scale(1.2);
            }

        /* FİLTRE VE ÇOKLU SEÇİM AYARLARI */
        .filter-input, .multi-select-button {
            width: 100%;
            height: 22px;
            padding: 2px 8px;
            font-size: 0.65rem;
            line-height: 1.2;
            box-sizing: border-box;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            background-color: var(--white-bg);
            transition: all 0.2s ease-in-out;
            margin-top: 5px;
        }

            .filter-input:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
                outline: none;
            }

        .multi-select-button {
            cursor: pointer;
            text-align: left;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .multi-select-button:hover {
                border-color: var(--primary-color);
                box-shadow: 0 2px 8px rgba(0, 123, 255, 0.1);
            }

            .multi-select-button::after {
                display: inline-block;
                margin-left: 0.5em;
                vertical-align: middle;
                content: "";
                border-top: 0.3em solid var(--secondary-color);
                border-right: 0.3em solid transparent;
                border-bottom: 0;
                border-left: 0.3em solid transparent;
                transition: transform 0.2s ease-in-out;
            }

            .multi-select-button[aria-expanded="true"]::after {
                transform: rotate(180deg);
            }

        /* Açılır menülerin konumlandırma stili */
        .multi-select-options {
            display: none;
            position: fixed;
            background-color: var(--white-bg);
            box-shadow: var(--shadow-medium);
            z-index: 9999;
            border-radius: 8px;
            padding: 10px;
            max-height: 350px;
            overflow-y: auto;
            border: 1px solid var(--border-color);
        }

            .multi-select-options.show {
                display: block;
            }

        .multi-select-option {
            padding: 6px 0;
            display: flex;
            align-items: center;
            transition: background-color 0.1s ease-in-out;
            cursor: pointer;
        }

            .multi-select-option:hover {
                background-color: #f8f8f8;
            }

            .multi-select-option label {
                margin-left: 8px;
                margin-bottom: 0;
                cursor: pointer;
                font-weight: 400;
                flex-grow: 1;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .multi-select-option input[type="checkbox"] {
                margin-right: 0;
                cursor: pointer;
                flex-shrink: 0;
                transform: scale(1.1);
            }

        .multi-select-header {
            padding-bottom: 8px;
            margin-bottom: 8px;
            border-bottom: 1px solid #e0e0e0;
            display: flex;
            align-items: center;
        }

            .multi-select-header label {
                font-weight: 600;
            }

        .multi-select-search-input {
            width: 100%;
            padding: 8px 12px;
            margin-bottom: 10px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            box-sizing: border-box;
        }

        .multi-select-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 15px;
            border-top: 1px solid #e0e0e0;
            padding-top: 10px;
        }

            .multi-select-actions button {
                padding: 8px 15px;
                border-radius: 6px;
                cursor: pointer;
                font-size: 0.9em;
                font-weight: 500;
                transition: all 0.2s ease-in-out;
            }

            .multi-select-actions .btn-primary {
                background-color: var(--primary-color);
                color: white;
                border: 1px solid var(--primary-color);
            }

                .multi-select-actions .btn-primary:hover {
                    background-color: #0056b3;
                    border-color: #0056b3;
                }

            .multi-select-actions .btn-secondary {
                background-color: var(--secondary-color);
                color: white;
                border: 1px solid var(--secondary-color);
            }

                .multi-select-actions .btn-secondary:hover {
                    background-color: #5a6268;
                    border-color: #5a6268;
                }

        .alert-success, .alert-danger {
            margin-top: 1.5rem;
            padding: 1rem 1.5rem;
            border-radius: 8px;
            text-align: center;
            font-size: 1.05rem;
            font-weight: 500;
            opacity: 0;
            transform: translateY(-20px);
            transition: opacity 0.3s ease-out, transform 0.3s ease-out;
        }

            .alert-success.show, .alert-danger.show {
                opacity: 1;
                transform: translateY(0);
            }

        /* Yeni Stil: Toplam Tutar Alanı */
        .total-summary-container {
            margin-top: 1rem;
            padding: 15px 20px;
            border-radius: 8px;
            background-color: #e9f5ff;
            border: 1px solid #cce5ff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.9rem;
            font-weight: 500;
            color: #004085;
            box-shadow: var(--shadow-light);
        }

        .total-summary-item {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .total-summary-label {
            font-size: 0.8rem;
            color: #555;
            margin-bottom: 5px;
        }

        .total-summary-value {
            font-size: 1.1rem;
            font-weight: 700;
        }
    </style>
}

<div class="container mt-4">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.ErrorMessage
        </div>
    }

    <div id="alertContainer" class="mt-3"></div>

    @if (Model != null && Model.Any())
    {
        <div class="mb-3 d-flex justify-content-between align-items-center">
            <button id="clearAllFiltersBtn" class="btn btn-warning">Tüm Filtreleri Temizle</button>
