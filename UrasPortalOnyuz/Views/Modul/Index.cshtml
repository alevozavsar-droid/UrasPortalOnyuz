@model WebApplication3.Data.KmModul
@{
    // Modül sayfası — Grup ERP Portalı'ndaki modul.html'in bu portala uyarlanmış hali.
    // Menü verisi /Modul/Yapi.js'ten gelir; kabuk (_Layout) sekme dışındayken bunu zaten yükler,
    // sekme (iframe) içinde açıldığında burada yüklenir.
    bool sekmeIcinde = Context.Request.Query.ContainsKey("_sekme");
}
@section Styles {
    <link rel="stylesheet" href="~/css/kurumsal-modul.css" asp-append-version="true" />
}

<div class="km-modul" id="kmModul" data-key="@Model.Key" data-yol="@ViewBag.Yol">
    <aside class="km-side" aria-label="@Model.Ad menüsü"><div class="km-side-ic" id="kmSide"></div></aside>
    <section class="km-content" id="kmIcerik">
        <div class="km-empty">Yükleniyor…</div>
    </section>
</div>

@section Scripts {
    @if (sekmeIcinde)
    {
        <script src="~/Modul/Yapi.js" asp-append-version="true"></script>
    }
    <script src="~/js/kurumsal-modul.js" asp-append-version="true"></script>
}
