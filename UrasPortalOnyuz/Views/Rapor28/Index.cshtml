@section Scripts {
    <script src="~/js/mizan-secim.js" asp-append-version="true"></script>
    <!-- jQuery ve Bootstrap Layout'tan geldiği için çıkarıldı -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>

    <script>
        const currentDbParam = '@currentDb';
        const startDate = '@startDateValue';
        const endDate = '@endDateValue';
        const cultureInfo = new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const allHesapList = @Html.Raw(JsonSerializer.Serialize(hesapList.ToDictionary(h => h.HesapKodu, h => h.HesapAdi)));

        // --- SIRALAMA (SORTING) MANTIĞI EKLENDİ ---
        let currentSortCol = -1;
        let currentSortDir = 'asc';

        function sortTable(colIndex, isNumeric, thElement) {
            const tbody = document.querySelector('#mizanTable tbody');
            if (!tbody) return;

            if (currentSortCol === colIndex) {
                currentSortDir = currentSortDir === 'asc' ? 'desc' : 'asc';
            } else {
                currentSortCol = colIndex;
                currentSortDir = 'asc';
            }

            document.querySelectorAll('#mizanTable th i.sort-icon').forEach(icon => {
                icon.className = 'fas fa-sort sort-icon ms-1 text-muted';
            });
            const activeIcon = thElement.querySelector('i.sort-icon');
            if (activeIcon) {
                activeIcon.className = currentSortDir === 'asc' ? 'fas fa-sort-up sort-icon ms-1 text-dark' : 'fas fa-sort-down sort-icon ms-1 text-dark';
            }

            const rows = Array.from(tbody.querySelectorAll('tr'));
            let chunks = [];
            let currentChunk = [];
            let currentParent = null;

            // Kardeş detay satırlarını aynı "parent" etrafında kümele
            rows.forEach(row => {
                if (row.classList.contains('separator-row')) {
                    if (currentChunk.length > 0) {
                        chunks.push({ parent: currentParent, rows: currentChunk });
                        currentChunk = [];
                    }
                    chunks.push({ isSeparator: true, row: row });
                    currentParent = null;
                    return;
                }

                const parentCode = row.getAttribute('data-parent') || "ROOT";

                if (parentCode !== currentParent) {
                    if (currentChunk.length > 0) {
                        chunks.push({ parent: currentParent, rows: currentChunk });
                    }
                    currentChunk = [row];
                    currentParent = parentCode;
                } else {
                    currentChunk.push(row);
                }
            });
            if (currentChunk.length > 0) {
                chunks.push({ parent: currentParent, rows: currentChunk });
            }

            // Oluşan kardeş bloklarını kendi içlerinde sırala (Gruplar arası hiyerarşi BAZILMAZ)
            chunks.forEach(chunk => {
                if (chunk.isSeparator || chunk.rows.length <= 1) return; 

                chunk.rows.sort((a, b) => {
                    const cellA = a.children[colIndex].innerText.trim();
                    const cellB = b.children[colIndex].innerText.trim();

                    let valA, valB;
                    if (isNumeric) {
                        valA = parseFloat(cellA.replace(/\./g, '').replace(',', '.')) || 0;
                        valB = parseFloat(cellB.replace(/\./g, '').replace(',', '.')) || 0;
                    } else {
                        valA = cellA.toLowerCase();
                        valB = cellB.toLowerCase();
                    }

                    if (valA < valB) return currentSortDir === 'asc' ? -1 : 1;
                    if (valA > valB) return currentSortDir === 'asc' ? 1 : -1;
                    return 0;
                });
            });

            // Sıralı Kardeş Bloklarını Tabloya Geri Yapıştır
            tbody.innerHTML = '';
            chunks.forEach(chunk => {
                if (chunk.isSeparator) {
                    tbody.appendChild(chunk.row);
                } else {
                    chunk.rows.forEach(r => tbody.appendChild(r));
                }
            });
        }

         function loadMuavinRecords(hesapKodu, btnAktarimTipleri, bakiyeTipi) {
    const detailHeader = $('#muavinDetailHeader');
    const tableBody = $('#muavinTableBody');
    const isDovizli = bakiyeTipi === 'Doviz';
    const tableColspan = isDovizli ? 11 : 8;

    tableBody.html(`<tr><td colspan="${tableColspan}" class="text-center p-3"><div class="spinner-border spinner-border-sm text-primary" role="status"></div><div class="mt-1 text-muted small">Yükleniyor...</div></td></tr>`);

    const headerRow = `<tr>
        <th style="width:10%">TARİH</th>
        <th style="width:8%">YEV. NO</th>
        <th style="width:5%">TÜR</th>
        <th style="width:10%">REF</th>
        <th>AÇIKLAMA</th>
        <th style="width:5%">TİP</th>
        ${isDovizli ? '<th class="text-center" style="width:5%">DÖVİZ</th>' : ''}
        <th class="text-end text-muted" style="width:10%">BORÇ (TL)</th>
        <th class="text-end text-muted" style="width:10%">ALACAK (TL)</th>
        ${isDovizli ? '<th class="text-end" style="width:10%">BORÇ (D)</th><th class="text-end" style="width:10%">ALACAK (D)</th>' : ''}
    </tr>`;
    $('#muavinModal .muavin-table thead').html(headerRow);

    // DİKKAT: Verileri doğrudan ekrandaki filtre alanlarından anlık olarak okuyoruz.
    var seciliMizanTuru = $('input[name="mizanHesaplamaTuru"]:checked').val() || 'SAP';
    var seciliStartDate = $('#startDate').val() || startDate;
    var seciliEndDate = $('#endDate').val() || endDate;
    
    // Eğer İşlem Tipi dropdown'ı varsa oradan al, yoksa butondaki datayı kullan
    var seciliAktarimTipi = $('#aktarimTipi').val();
    if (!seciliAktarimTipi || seciliAktarimTipi.length === 0) {
        seciliAktarimTipi = btnAktarimTipleri && btnAktarimTipleri.length > 0 ? btnAktarimTipleri : ['BOS'];
    }

    $.ajax({
        url: `@Url.Action("GetMuavinDetay", "Rapor28")`,
        type: 'GET',
        traditional: true, // <--- C# TARAFINDA LİSTELERİN DOĞRU OKUNMASI İÇİN EN KRİTİK AYAR BURASI!
        data: {
            startDate: seciliStartDate,
            endDate: seciliEndDate,
            aktarimTipi: seciliAktarimTipi,
            hesapKodu: hesapKodu,
            mizanHesaplamaTuru: seciliMizanTuru,
            db: currentDbParam
        },
        success: function (response) {
            tableBody.empty();
            let dataList = [];
            if (response.data) dataList = response.data;
            else if (Array.isArray(response)) dataList = response;

            if (dataList.length > 0) {
                const hesapAdiText = (response.hesapAdi) ? response.hesapAdi : (allHesapList[hesapKodu] || '');

                detailHeader.html(`
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-primary fw-bold"><i class="fas fa-file-invoice me-1"></i>${hesapKodu}</span>
                            <span class="text-dark ms-2 fw-bold">${hesapAdiText}</span>
                        </div>
                        <span class="badge bg-primary">${moment(seciliStartDate).format('DD.MM.YYYY')} - ${moment(seciliEndDate).format('DD.MM.YYYY')}</span>
                    </div>
                `);

                let totalTLBorc = 0; let totalTLAlacak = 0;
                let totalDovizBorc = 0; let totalDovizAlacak = 0;

                dataList.forEach(item => {
                    const tlBorc = item.tlBorc || item.TLBorc || 0;
                    const tlAlacak = item.tlAlacak || item.TLAlacak || 0;
                    const dovizBorc = item.dovizBorc || item.DovizBorc || 0;
                    const dovizAlacak = item.dovizAlacak || item.DovizAlacak || 0;

                    const tarihRaw = item.tarih || item.Tarih || item.RefDate;
                    const formattedDate = moment(tarihRaw).isValid() ? moment(tarihRaw).format('DD.MM.YYYY') : '-';
                    const yevmiyeNo = item.yevmiyeNo || item.YevmiyeNo || item.TransId || '';
                    const islemTuru = item.islemTuru || item.IslemTuru || '';
                    const muhatap = item.muhatapHesap || item.MuhatapHesap || '-';
                    const aciklama = item.aciklama || item.Aciklama || item.Memo || '';
                    const aktTip = item.aktarimTipi || item.AktarimTipi || '-';
                    const dovizCinsi = item.dovizCinsi || item.DovizCinsi || '';

                    totalTLBorc += tlBorc; totalTLAlacak += tlAlacak;
                    totalDovizBorc += dovizBorc; totalDovizAlacak += dovizAlacak;

                    let row = `<tr>
                        <td>${formattedDate}</td>
                        <td>${yevmiyeNo}</td>
                        <td><span class="badge bg-light text-dark border border-secondary" style="font-weight:normal;">${islemTuru}</span></td>
                        <td class="small text-muted">${muhatap}</td>
                        <td class="text-truncate" style="max-width: 200px;" title="${aciklama}">${aciklama}</td>
                        <td class="text-center"><small>${aktTip}</small></td>`;

                    if(isDovizli) {
                        row += `<td class="text-center small">${dovizCinsi}</td>`;
                    }

                    row += `<td class="num-cell ${tlBorc > 0 ? 'text-debt' : 'text-muted'}">${tlBorc > 0 ? cultureInfo.format(tlBorc) : '-'}</td>
                            <td class="num-cell ${tlAlacak > 0 ? 'text-credit' : 'text-muted'}">${tlAlacak > 0 ? cultureInfo.format(tlAlacak) : '-'}</td>`;

                    if (isDovizli) {
                        row += `<td class="num-cell ${dovizBorc > 0 ? 'text-debt' : 'text-muted'}">${dovizBorc > 0 ? cultureInfo.format(dovizBorc) : '-'}</td>
                                <td class="num-cell ${dovizAlacak > 0 ? 'text-credit' : 'text-muted'}">${dovizAlacak > 0 ? cultureInfo.format(dovizAlacak) : '-'}</td>`;
                    }
                    row += `</tr>`;
                    tableBody.append(row);
                });

                let totalRow = `<tr class="table-light fw-bold border-top">
                    <td colspan="${isDovizli ? 7 : 6}" class="text-end">TOPLAM</td>`;

                totalRow += `<td class="num-cell text-debt">${cultureInfo.format(totalTLBorc)}</td>
                             <td class="num-cell text-credit">${cultureInfo.format(totalTLAlacak)}</td>`;

                if (isDovizli) {
                    totalRow += `<td class="num-cell text-debt">${cultureInfo.format(totalDovizBorc)}</td>
                                 <td class="num-cell text-credit">${cultureInfo.format(totalDovizAlacak)}</td>`;
                }
                totalRow += `</tr>`;
                tableBody.append(totalRow);

            } else {
                tableBody.html(`<tr><td colspan="${tableColspan}" class="text-center py-3 text-muted">Kayıt bulunamadı.</td></tr>`);
            }
        },
        error: function (xhr) {
            tableBody.html(`<tr><td colspan="${tableColspan}" class="text-center text-danger py-2">Hata oluştu: Sunucu ile iletişim kurulamadı.</td></tr>`);
        }
    });
}

        $(document).ready(function () {
            // Raporla: sunucu çalışırken perde göster (geri tuşuyla dönüşte perde kalmasın diye pageshow'da gizlenir)
            $('#filterForm').on('submit', function () { $('#mzYukleniyor').css('display', 'flex'); });
            window.addEventListener('pageshow', function () { $('#mzYukleniyor').hide(); });

            initializeSelect2WithButtons('#anaHesap', 'Ana Hesap');
            initializeSelect2WithButtons('#hesapKodlari', 'Detay Hesap');

            if (!@islemTipiHaric.ToString().ToLower()) {
                initializeSelect2WithButtons('#aktarimTipi', 'İşlem Tipi');
            }

             $('#anaHesap').on('select2:select', function () {
                    if ($('#hesapKodlari').val().length > 0) $('#hesapKodlari').val(null).trigger('change');
                    $('#kebirMizan').prop('checked', false);
            });
            $('#hesapKodlari').on('select2:select', function () {
                    if ($('#anaHesap').val().length > 0) $('#anaHesap').val(null).trigger('change');
                    $('#kebirMizan').prop('checked', false);
            });
             $('#kebirMizan').on('change', function () {
                if ($(this).is(':checked')) {
                    if ($('#anaHesap').val().length > 0) $('#anaHesap').val(null).trigger('change');
                    if ($('#hesapKodlari').val().length > 0) $('#hesapKodlari').val(null).trigger('change');
                }
            });

            // Başlık Tıklama Sıralama Event Listener
            document.querySelectorAll('#mizanTable th.sortable').forEach(th => {
                th.addEventListener('click', function () {
                    const colIndex = this.cellIndex;
                    const isNumeric = this.getAttribute('data-type') === 'numeric';
                    sortTable(colIndex, isNumeric, this);
                });
            });

            // Muavin Detay
            $(document).on('click', '.btn-detail', function () {
                const btn = $(this);
                let aktarimTipleri = [];
                try {
                    const rawData = btn.attr('data-aktarim-tipleri');
                    if(rawData) aktarimTipleri = JSON.parse(rawData);
                } catch (e) { console.error(e); }
                loadMuavinRecords(btn.data('hesapkodu'), aktarimTipleri, btn.data('bakiye-tipi'));
            });

            $('#btnKiyasla').on('click', function () {
                const modal = new bootstrap.Modal(document.getElementById('kiyaslamaModal'));
                modal.show();
                const tbody = $('#kiyaslamaTableBody');
                
                tbody.html(`
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="spinner-border text-warning mb-2" role="status"></div>
                            <h6 class="text-muted">Mizanlar kıyaslanıyor, lütfen bekleyin...</h6>
                        </td>
                    </tr>
                `);

                let aktarimTipleri = $('#aktarimTipi').val() || [];

                $.ajax({
                    url: '@Url.Action("GetKiyaslamaRaporu", "Rapor28")',
                    type: 'GET',
                    data: {
                        startDate: $('#startDate').val(),
                        endDate: $('#endDate').val(),
                        aktarimTipi: aktarimTipleri,
                        db: currentDbParam
                    },
                    success: function (res) {
                        tbody.empty();
                        if (res.success && res.data && res.data.length > 0) {
                            res.data.forEach(item => {
                                
                                let sapBak = item.sapBorc - item.sapAlacak;
                                let webBak = item.webBorc - item.webAlacak;
                                let fark = sapBak - webBak;

                                let html = `<tr class="table-warning border-bottom border-warning">
                                    <td class="fw-bold">${item.hesapKodu}</td>
                                    <td class="fw-bold">${item.hesapAdi}</td>
                                    <td class="text-end num-cell">${cultureInfo.format(sapBak)}</td>
                                    <td class="text-end num-cell">${cultureInfo.format(webBak)}</td>
                                    <td class="text-end num-cell text-danger fw-bold">${cultureInfo.format(fark)}</td>
                                </tr>`;

                                if (item.detaylar && item.detaylar.length > 0) {
                                    html += `<tr><td colspan="5" class="p-0 border-0">
                                        <table class="table table-sm inner-table m-0">
                                            <thead>
                                                <tr>
                                                    <th style="width:10%">Tarih</th>
                                                    <th style="width:10%">Yevmiye No</th>
                                                    <th style="width:10%">Satır No</th>
                                                    <th>Açıklama</th>
                                                    <th class="text-end" style="width:12%">SAP Bakiye</th>
                                                    <th class="text-end" style="width:12%">Web Bakiye</th>
                                                    <th class="text-danger" style="width:20%">Fark Nedeni</th>
                                                </tr>
                                            </thead>
                                            <tbody>`;
                                    item.detaylar.forEach(det => {
                                        let dtSapBak = det.sapBorc - det.sapAlacak;
                                        let dtWebBak = det.webBorc - det.webAlacak;
                                        html += `<tr>
                                            <td>${det.tarih}</td>
                                            <td>${det.yevmiyeNo}</td>
                                            <td>${det.satirNo}</td>
                                            <td class="text-truncate" style="max-width:200px;" title="${det.aciklama || '-'}">${det.aciklama || '-'}</td>
                                            <td class="text-end num-cell">${cultureInfo.format(dtSapBak)}</td>
                                            <td class="text-end num-cell">${cultureInfo.format(dtWebBak)}</td>
                                            <td class="text-danger fw-bold">${det.neden}</td>
                                        </tr>`;
                                    });
                                    html += `</tbody></table></td></tr>`;
                                }
                                tbody.append(html);
                            });
                        } else if (res.success) {
                            tbody.html(`
                                <tr>
                                    <td colspan="5" class="text-center text-success py-5">
                                        <i class="fas fa-check-circle fa-3x mb-3"></i>
                                        <h5>Tebrikler!</h5>
                                        <p class="text-muted">SAP ve Web Mizanları arasında hiçbir fark bulunamadı.</p>
                                    </td>
                                </tr>
                            `);
                        } else {
                            tbody.html(`<tr><td colspan="5" class="text-center text-danger py-4 fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>Hata: ${res.message}</td></tr>`);
                        }
                    },
                    error: function () {
                        tbody.html('<tr><td colspan="5" class="text-center text-danger py-4 fw-bold"><i class="fas fa-wifi me-2"></i>Sunucu ile iletişim kurulamadı.</td></tr>');
                    }
                });
            });
        });
    </script>
}