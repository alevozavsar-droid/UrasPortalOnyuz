@model List<WebApplication3.Models.OrderTrackingViewModel>
@using System.Globalization
@using WebApplication3.Models
@using Newtonsoft.Json
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Xsrf

@{
    ViewData["Title"] = "İhracat Sipariş Takip Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Aktif Veritabanını (Şirketi) URL veya Cookie'den alıyoruz ki linklerde ve formlarda kaybolmasın
    var currentDb = Context.Request.Query["db"].ToString();
    if (string.IsNullOrEmpty(currentDb))
    {
        currentDb = Context.Request.Cookies["SelectedDatabase"];
    }

    // Mevcut kullanıcı adını alın ve küçük harfe çevirin.
    var currentUsername = User.Identity.Name?.ToLower();

    // YETKİLENDİRME KONTROLÜ: Sadece it02 ve ykb kullanıcıları için finansal alanlar
    var isFinanceUser = currentUsername == "it02" || currentUsername == "ykb";

    // Modellerdeki tüm alanları (Finansal alanlar dahil) JSON serializasyonu
    var reportDataJson = Model != null ? JsonConvert.SerializeObject(Model, new JsonSerializerSettings { DateFormatString = "yyyy-MM-dd" }) : "[]";

    // Filtre listeleri
    var distinctValues = new Dictionary<string, List<string>>();
    if (Model != null)
    {
        distinctValues["SiparisAlanFirma"] = Model.Where(m => !string.IsNullOrEmpty(m.SiparisAlanFirma)).Select(m => m.SiparisAlanFirma).Distinct().OrderBy(s => s).ToList();
        distinctValues["FaturaKesilenFirma"] = Model.Where(m => !string.IsNullOrEmpty(m.FaturaKesilenFirma)).Select(m => m.FaturaKesilenFirma).Distinct().OrderBy(s => s).ToList();
        distinctValues["FaturaNo"] = Model.Where(m => m.FaturaNo.HasValue).Select(m => m.FaturaNo.Value.ToString()).Distinct().OrderBy(s => s).ToList();
        distinctValues["TeklifNo"] = Model.Where(m => m.TeklifNo.HasValue).Select(m => m.TeklifNo.Value.ToString()).Distinct().OrderBy(s => s).ToList();
        distinctValues["MusteriAdi"] = Model.Where(m => !string.IsNullOrEmpty(m.MusteriAdi)).Select(m => m.MusteriAdi).Distinct().OrderBy(s => s).ToList();
        distinctValues["Ulke"] = Model.Where(m => !string.IsNullOrEmpty(m.Ulke)).Select(m => m.Ulke).Distinct().OrderBy(s => s).ToList();
        distinctValues["PlanlananHafta"] = Model.Where(m => !string.IsNullOrEmpty(m.PlanlananHafta)).Select(m => m.PlanlananHafta).Distinct().OrderBy(s => s).ToList();
        distinctValues["SatisSorumlusu"] = Model.Where(m => !string.IsNullOrEmpty(m.SatisSorumlusu)).Select(m => m.SatisSorumlusu).Distinct().OrderBy(s => s).ToList();
        distinctValues["UrunKodu"] = Model.Where(m => !string.IsNullOrEmpty(m.UrunKodu)).Select(m => m.UrunKodu).Distinct().OrderBy(s => s).ToList();
        distinctValues["UrunModeli"] = Model.Where(m => !string.IsNullOrEmpty(m.UrunModeli)).Select(m => m.UrunModeli).Distinct().OrderBy(s => s).ToList();
        distinctValues["SiparisDurumu"] = Model.Where(m => !string.IsNullOrEmpty(m.SiparisDurumu)).Select(m => m.SiparisDurumu).Distinct().OrderBy(s => s).ToList();
        distinctValues["Durum"] = Model.Where(m => !string.IsNullOrEmpty(m.Durum)).Select(m => m.Durum).Distinct().OrderBy(s => s).ToList();
        distinctValues["NakliyePlani"] = Model.Where(m => !string.IsNullOrEmpty(m.NakliyePlani)).Select(m => m.NakliyePlani).Distinct().OrderBy(s => s).ToList();
        distinctValues["TeslimatDurumu"] = Model.Where(m => !string.IsNullOrEmpty(m.TeslimatDurumu)).Select(m => m.TeslimatDurumu).Distinct().OrderBy(s => s).ToList();
        distinctValues["IhracatDosyaNo"] = Model.Where(m => !string.IsNullOrEmpty(m.IhracatDosyaNo)).Select(m => m.IhracatDosyaNo).Distinct().OrderBy(s => s).ToList();
    }

    var currentSelectedDbDisplay = (string)ViewBag.CurrentDbDisplay ?? "URSMAKINE";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/css/bootstrap-select.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <style>
        :root {
            --primary-color: #0d6efd;
            --secondary-color: #6c757d;
            --success-color: #198754;
            --danger-color: #dc3545;
            --warning-color: #ffc107;
            --info-color: #0dcaf0;
            --light-bg: #f8f9fa;
            --dark-text: black;
            --border-color: #d0d0d0;
            --header-bg: #212529;
            --header-text: #ffffff;
            --box-shadow-light: 0 0 8px rgba(0, 0, 0, 0.08);
            --box-shadow-medium: 0 2px 3px rgba(0, 0, 0, 0.06);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 12px;
            background-color: var(--light-bg);
            color: var(--dark-text);
        }

        .main-content {
            margin-top: 0 !important;
            padding-top: 0 !important;
            font-size: 1.15em;
            padding: 8px;
            background-color: #ffffff;
            border-radius: 6px;
            box-shadow: var(--box-shadow-light);
            position: relative;
        }

        .container-fluid.py-4 {
            padding-top: 5px;
            padding-bottom: 10px;
            padding-left: 5px;
            padding-right: 5px;
        }

        .database-info {
            background-color: var(--info-color);
            color: #ffffff;
            padding: 4px 8px;
            border-radius: 4px;
            margin-bottom: 6px;
            font-weight: bold;
            display: flex;
            align-items: center;
            font-size: 0.96em;
            line-height: 1.1;
        }

            .database-info .fas {
                margin-right: 4px;
            }

        .sticky-toolbar {
            position: sticky;
            top: 0;
            background-color: #ffffff;
            z-index: 1000;
            padding: 8px 12px;
            border-bottom: 1px solid var(--border-color);
            margin-top: 0px !important;
            margin-bottom: 6px;
            box-shadow: var(--box-shadow-medium);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: nowrap;
            gap: 10px;
        }

            .sticky-toolbar .total-amount-display {
                font-size: 0.96em;
                font-weight: bold;
                color: var(--primary-color);
                margin-left: 5px !important;
                margin-right: 4px !important;
                white-space: nowrap;
            }

        .table-container {
            overflow-x: auto;
            position: relative;
            border-radius: 6px;
            box-shadow: var(--box-shadow-medium);
            background-color: #ffffff;
            margin-top: 6px;
            border: 1px solid var(--border-color);
        }

        .rapor-tablo {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 0.84em;
            color: var(--dark-text);
            table-layout: fixed;
            min-width: 2500px; /* Yeni kolonlara göre ayarlandı */
        }

            .rapor-tablo thead {
                position: sticky;
                top: 0;
                z-index: 101;
                background-color: #ffffff;
            }

                .rapor-tablo thead .main-header-row th {
                    background-color: var(--header-bg);
                    color: var(--header-text);
                    padding: 4px 3px;
                    text-align: center;
                    white-space: nowrap;
                    font-weight: 700;
                    border-bottom: 2px solid var(--border-color);
                    height: auto;
                    line-height: 1.3;
                }

                .rapor-tablo thead .filter-row th {
                    padding: 2px 3px;
                    height: 30px;
                    line-height: normal;
                    vertical-align: top;
                    white-space: nowrap;
                    background-color: #ffffff;
                    border-bottom: 1px solid var(--border-color);
                }

            .rapor-tablo th,
            .rapor-tablo td {
                padding: 1px;
                vertical-align: middle;
                border-right: 1px solid var(--border-color);
            }

                .rapor-tablo th:last-child,
                .rapor-tablo td:last-child {
                    border-right: none;
                }

            .rapor-tablo td {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                height: 25px;
                line-height: 25px;
                border-bottom: 1px solid var(--border-color);
            }

                /* DÜZENLENEBİLİR ALAN STİLİ */
                .rapor-tablo td.editable-field {
                    cursor: pointer;
                }

                    .rapor-tablo td.editable-field:hover {
                        background-color: #f0f0f0;
                    }

        .editable-input {
            padding: 1px 3px !important;
            height: 23px !important;
            font-size: 0.9em !important;
            border: 1px solid var(--primary-color) !important;
            box-shadow: 0 0 5px rgba(13, 110, 253, 0.5) !important;
        }

        /* Tüm checkbox hücreleri için ortak özellikler */
        .rapor-tablo th.checkbox-column,
        .rapor-tablo td.checkbox-column {
            min-width: 28px !important;
            max-width: 28px !important;
            width: 28px !important;
            text-align: center !important;
            padding: 0 !important;
            vertical-align: middle !important;
            overflow: visible;
        }

        .rapor-tablo td.checkbox-column {
            display: flex;
            align-items: center;
            justify-content: flex-end; 
            height: 27px; 
        }

        .rapor-tablo th.checkbox-column input {
            display: block;
            margin-left: auto; 
            margin-right: 5px; 
        }

        .filter-row th .form-control,
        .filter-row th .bootstrap-select .btn {
            width: 100% !important;
            box-sizing: border-box !important;
            height: 28px !important;
            line-height: normal !important;
            padding: 2px 5px !important;
            font-size: 0.85em !important;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
        }

        .table-hover tbody tr:hover {
            background-color: var(--light-bg);
        }

        .table-success {
            background-color: #d1e7dd !important;
        }

        .table-danger {
            background-color: #f8d7da !important;
        }

        .table-warning {
            background-color: #fff3cd !important;
        }
    </style>
}

<div class="container-fluid py-4">
    @Html.AntiForgeryToken()

    <div class="row g-0">
        <div class="col-md-12">
            <div class="main-report-box">

                <div class="sticky-toolbar">
                    <div class="d-flex align-items-center">
                        <span class="me-2 total-amount-display">Seçilen Toplam TL Tutarı:</span>
                        <strong id="totalSelectedTlAmount" class="text-primary">0,00 TL</strong>
                    </div>
                    <div class="database-info">
                        <i class="fas fa-database"></i>
                        Veritabanı: <strong>@currentSelectedDbDisplay</strong>
                    </div>
                    <button id="clearAllFiltersBtn" class="btn btn-warning btn-sm">
                        <i class="fas fa-eraser"></i> Filtreleri Temizle
                    </button>
                </div>

                <div id="alertContainer" class="mt-3"></div>

                <div class="table-container">
                    <table class="table table-bordered table-striped table-hover rapor-tablo" id="rapor18Table">
                        <thead>
                            <tr class="main-header-row">
                                <th class="checkbox-column no-drag" data-column="Checkbox">
                                    <input type="checkbox" id="selectAllCheckbox" class="form-check-input" />
                                </th>
                                <th class="sortable-column" data-column="SiparisAlanFirma" title="Sip. Alan Firma" data-sort-type="text">Sip. Alan Firma <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="FaturaKesilenFirma" title="Fat. Kesilen Firma" data-sort-type="text">Fat. Kesilen Firma <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="SiparisNo" title="Sipariş No" data-sort-type="number">Sipariş No <i class="fas fa-sort float-end"></i></th>

                                <th class="sortable-column" data-column="FaturaNo" title="Fatura No" data-sort-type="number">Fatura No <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="TeklifNo" title="Teklif No" data-sort-type="number">Teklif No <i class="fas fa-sort float-end"></i></th>

                                @* Finansal Alanlar (Sadece it02 ve ykb) *@
                                @if (isFinanceUser)
                                {
                                    <th class="sortable-column" data-column="FaturaTutari" title="Fatura Tutarı" data-sort-type="number">Fatura Tutarı <i class="fas fa-sort float-end"></i></th>
                                    <th class="sortable-column editable-header" data-column="OnOdemeTarihi" title="Ön Ödeme Tarihi" data-sort-type="date">Ön Ödeme Tarihi <i class="fas fa-sort float-end"></i></th>
                                    <th class="sortable-column" data-column="TahsilatTutari" title="Tahsilat Tutarı" data-sort-type="number">Tahsilat Tutarı <i class="fas fa-sort float-end"></i></th>
                                    <th class="sortable-column" data-column="KalanBakiyeYuzde" title="Kalan Bakiye %" data-sort-type="number">Kalan Bakiye % <i class="fas fa-sort float-end"></i></th>
                                }

                                <th class="sortable-column" data-column="MusteriAdi" title="Müşteri Adı" data-sort-type="text">Müşteri Adı <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="Ulke" title="Ülke" data-sort-type="text">Ülke <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="SiparisTarihi" title="Sipariş Tarihi" data-sort-type="date">Sipariş Tarihi <i class="fas fa-sort float-end"></i></th>

                                @if (!isFinanceUser)
                                {
                                    <th class="sortable-column" data-column="OnOdemeTarihi" title="Ön Ödeme Tarihi" data-sort-type="date">Ön Ödeme Tarihi <i class="fas fa-sort float-end"></i></th>
                                }

                                <th class="sortable-column editable-header" data-column="PlanlananTeslimTarihi" title="Planlanan Teslim Tarihi" data-sort-type="date">Planlanan Teslim Tarihi <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column editable-header" data-column="PlanlananHafta" title="Planlanan Hafta" data-sort-type="text">Planlanan Hafta <i class="fas fa-sort float-end"></i></th>

                                <th class="sortable-column" data-column="SiparisTeslimatSuresi" title="Sip.-Plan. Tes. Süresi" data-sort-type="number">Sip.-Plan. Tes. Süresi <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="SatisSorumlusu" title="Satış Sorumlusu" data-sort-type="text">Satış Sorumlusu <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="UrunKodu" title="Ürün Kodu" data-sort-type="text">Ürün Kodu <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="UrunModeli" title="Ürün Modeli" data-sort-type="text">Ürün Modeli <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column editable-header" data-column="SiparisDurumu" title="Sip. Durumu" data-sort-type="text">Sip. Durumu <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column editable-header" data-column="UretimBaslangicTarihi" title="Üretim Baş. Tar." data-sort-type="date">Üretim Baş. Tar. <i class="fas fa-sort float-end"></i></th>

                                <th class="sortable-column editable-header" data-column="PlanlananBitisTarihi" title="Plan. Bitiş Tar." data-sort-type="date">Plan. Bitiş Tar. <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column editable-header" data-column="GerceklesenBitisTarihi" title="Gerçek. Bitiş Tar." data-sort-type="date">Gerçek. Bitiş Tar. <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="Stokta" title="Stokta" data-sort-type="number">Stokta <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="Ihtiyac" title="İhtiyaç" data-sort-type="number">İhtiyaç <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column editable-header" data-column="Durum" title="Durum" data-sort-type="text">Durum <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column editable-header" data-column="NakliyePlani" title="Nakliye Planı" data-sort-type="text">Nakliye Planı <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column editable-header" data-column="FabrikaCikisTarihi" title="Fabrika Çıkış Tar." data-sort-type="date">Fabrika Çıkış Tar. <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column editable-header" data-column="TeslimatDurumu" title="Teslimat Durumu" data-sort-type="text">Teslimat Durumu <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column editable-header" data-column="AnlasilanBeyannameTarihi" title="Anl. Bey. Tar." data-sort-type="date">Anl. Bey. Tar. <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column editable-header" data-column="NavlunYuklemeTarihi" title="Navlun Yük. Tar." data-sort-type="date">Navlun Yük. Tar. <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column editable-header" data-column="TahminiMusteriTeslimatTarihi" title="Tah. Müş. Tes. Tar." data-sort-type="date">Tah. Müş. Tes. Tar. <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column editable-header" data-column="PlanlananKurulumTarihi" title="Plan. Kur. Tar." data-sort-type="date">Plan. Kur. Tar. <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column editable-header" data-column="Not" title="Not" data-sort-type="text">Not <i class="fas fa-sort float-end"></i></th>
                                <th class="sortable-column" data-column="IhracatDosyaNo" title="İhr. Dosya No" data-sort-type="text">İhr. Dosya No <i class="fas fa-sort float-end"></i></th>
                            </tr>
                            <tr class="filter-row">
                                <th data-column="Checkbox"></th>
                                <th data-column="SiparisAlanFirma">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Sip. Alan Firma">
                                        @if (distinctValues.ContainsKey("SiparisAlanFirma"))
                                        {
                                            foreach (var item in distinctValues["SiparisAlanFirma"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="FaturaKesilenFirma">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Fat. Kesilen Firma">
                                        @if (distinctValues.ContainsKey("FaturaKesilenFirma"))
                                        {
                                            foreach (var item in distinctValues["FaturaKesilenFirma"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="SiparisNo"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>

                                <th data-column="FaturaNo">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Fatura No">
                                        @if (distinctValues.ContainsKey("FaturaNo"))
                                        {
                                            foreach (var item in distinctValues["FaturaNo"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="TeklifNo">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Teklif No">
                                        @if (distinctValues.ContainsKey("TeklifNo"))
                                        {
                                            foreach (var item in distinctValues["TeklifNo"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>

                                @* Finansal Filtreler (Sadece it02 ve ykb) *@
                                @if (isFinanceUser)
                                {
                                    <th data-column="FaturaTutari"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                                    <th data-column="OnOdemeTarihi"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                                    <th data-column="TahsilatTutari"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                                    <th data-column="KalanBakiyeYuzde"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                                }

                                <th data-column="MusteriAdi">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Müşteri Adı">
                                        @if (distinctValues.ContainsKey("MusteriAdi"))
                                        {
                                            foreach (var item in distinctValues["MusteriAdi"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="Ulke">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Ülke">
                                        @if (distinctValues.ContainsKey("Ulke"))
                                        {
                                            foreach (var item in distinctValues["Ulke"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="SiparisTarihi"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>

                                @if (!isFinanceUser)
                                {
                                    <th data-column="OnOdemeTarihi"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                                }

                                <th data-column="PlanlananTeslimTarihi"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                                <th data-column="PlanlananHafta">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Planlanan Hafta">
                                        @if (distinctValues.ContainsKey("PlanlananHafta"))
                                        {
                                            foreach (var item in distinctValues["PlanlananHafta"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>

                                <th data-column="SiparisTeslimatSuresi"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                                <th data-column="SatisSorumlusu">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Satış Sorumlusu">
