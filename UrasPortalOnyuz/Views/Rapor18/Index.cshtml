</div>

@section Scripts {

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // Aktif veritabanı parametresini JS değişkenine alıyoruz
            const currentDbParam = '@currentDb';
            const dbQueryString = currentDbParam ? `?db=${currentDbParam}` : '';

            const allReportData = @Html.Raw(reportDataJson);
            const table = document.getElementById('rapor18Table');
            const tableBody = table.querySelector('tbody');
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            const totalSelectedTlAmountSpan = document.getElementById('totalSelectedTlAmount');
            const clearAllFiltersBtn = document.getElementById('clearAllFiltersBtn');
            const packingListModal = new bootstrap.Modal(document.getElementById('packingListModal'));
            const savePackingListBtn = document.getElementById('savePackingListBtn');

            let currentlyFilteredRows = [...allReportData];
            let currentSortColumn = null;
            let currentSortDirection = 'none';
            const xsrfToken = '@Xsrf.GetAndStoreTokens(ViewContext.HttpContext).RequestToken';

            // KULLANICI YETKİSİ JS'YE TAŞINIYOR
            const isFinanceUser = @(isFinanceUser.ToString().ToLower());

            // Modeldeki tüm alanları (görünür/gizli) içerir
            const columnMappings = {
                'Checkbox': null,
                'SiparisAlanFirma': 'SiparisAlanFirma',
                'FaturaKesilenFirma': 'FaturaKesilenFirma',
                'SiparisNo': 'SiparisNo',
                'FaturaNo': 'FaturaNo',
                'TeklifNo': 'TeklifNo',

                'FaturaTutari': 'FaturaTutari',
                'TahsilatTutari': 'TahsilatTutari',
                'KalanBakiyeYuzde': 'KalanBakiyeYuzde',
                'OnOdemeTarihi': 'OnOdemeTarihi', // Finansal alan olarak da ele alınır

                'MusteriAdi': 'MusteriAdi',
                'Ulke': 'Ulke',
                'SiparisTarihi': 'SiparisTarihi',

                'PlanlananTeslimTarihi': 'PlanlananTeslimTarihi',
                'PlanlananHafta': 'PlanlananHafta',
                'SiparisTeslimatSuresi': 'SiparisTeslimatSuresi',
                'SatisSorumlusu': 'SatisSorumlusu',
                'UrunKodu': 'UrunKodu',
                'UrunModeli': 'UrunModeli',
                'SiparisDurumu': 'SiparisDurumu',
                'UretimBaslangicTarihi': 'UretimBaslangicTarihi',
                'PlanlananBitisTarihi': 'PlanlananBitisTarihi',
                'GerceklesenBitisTarihi': 'GerceklesenBitisTarihi',
                'Stokta': 'Stokta',
                'Ihtiyac': 'Ihtiyac',
                'Durum': 'Durum',
                'NakliyePlani': 'NakliyePlani',
                'FabrikaCikisTarihi': 'FabrikaCikisTarihi',
                'TeslimatDurumu': 'TeslimatDurumu',
                'AnlasilanBeyannameTarihi': 'AnlasilanBeyannameTarihi',
                'NavlunYuklemeTarihi': 'NavlunYuklemeTarihi',
                'TahminiMusteriTeslimatTarihi': 'TahminiMusteriTeslimatTarihi',
                'PlanlananKurulumTarihi': 'PlanlananKurulumTarihi',
                'Not': 'Not',
                'IhracatDosyaNo': 'IhracatDosyaNo'
            };

            // ====================================================================
            // YARDIMCI FONKSİYONLAR
            // ====================================================================

            function updatePaginationInfo(totalCount) {
                const totalRecordsSpan = document.getElementById('totalRecords');
                if (totalRecordsSpan) {
                    totalRecordsSpan.textContent = totalCount;
                }
                const pageLinks = document.getElementById('page-links');
                if (pageLinks) {
                    pageLinks.innerHTML = '';
                }
            }

            function showAlert(message, type) {
                toastr[type](message);
            }

            function getInitialColumnConfig() {
                // Sadece HTML'de GÖRÜNÜR olan kolonları alır
                const headers = Array.from(table.querySelectorAll('thead .main-header-row th'));
                return headers.map((header, index) => ({
                    originalIndex: index,
                    newIndex: index,
                    visible: header.style.display !== 'none', // Razor'da gizlenen başlıkları atlamak için
                    columnName: header.dataset.column || 'Unknown'
                }));
            }

            function calculateSelectedTotal() {
                let totalAmount = 0;
                document.querySelectorAll('#rapor18Table tbody tr input.row-selector:checked').forEach(checkbox => {
                    const tlValue = parseFloat(checkbox.dataset.tlValue);
                    if (!isNaN(tlValue)) {
                        totalAmount += tlValue;
                    }
                });
                totalSelectedTlAmountSpan.textContent = totalAmount.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' TL';
            }

            function updateSelectAllCheckboxState() {
                if (!selectAllCheckbox) return;
                const visibleCheckboxes = document.querySelectorAll('#rapor18Table tbody tr:not([style*="display: none"]) .row-selector');
                if (visibleCheckboxes.length > 0) {
                    const allChecked = Array.from(visibleCheckboxes).every(checkbox => checkbox.checked);
                    const anyChecked = Array.from(visibleCheckboxes).some(checkbox => checkbox.checked);
                    selectAllCheckbox.checked = allChecked;
                    selectAllCheckbox.indeterminate = !allChecked && anyChecked;
                } else {
                    selectAllCheckbox.checked = false;
                    selectAllCheckbox.indeterminate = false;
                }
            }


            function renderTable(data) {
                tableBody.innerHTML = '';
                const visibleColumns = window.currentColumnConfig || getInitialColumnConfig();
                const visibleColumnsCount = visibleColumns.length;

                if (data.length === 0) {
                    tableBody.innerHTML = `<tr><td colspan="${visibleColumnsCount}" class="text-center">Gösterilecek veri bulunamadı.</td></tr>`;
                    updatePaginationInfo(0);
                    return;
                }

                const frag = document.createDocumentFragment();

                data.forEach(item => {
                    const row = document.createElement('tr');
                    row.dataset.ihracatDosyaNo = item.IhracatDosyaNo || '';
                    const rowClass = item.Durum ? {
                        'Ödendi': 'table-success',
                        'Gecikti': 'table-danger',
                        'Kısmi Ödeme Vadesi Geçti': 'table-warning'
                    }[item.Durum?.trim()] || '' : '';
                    row.className = rowClass;

                    visibleColumns.forEach(col => {
                        const cell = document.createElement('td');
                        let content = '';
                        let value = item[col.columnName];
                        cell.dataset.column = col.columnName;

                        if (col.columnName === 'Checkbox') {
                            cell.className = 'checkbox-column d-flex align-items-center justify-content-center';
                            cell.style.height = '25px';
                            const checkbox = document.createElement('input');
                            checkbox.type = 'checkbox';
                            checkbox.className = 'form-check-input row-selector';
                            checkbox.dataset.tlValue = item.FaturaTutari || 0;
                            cell.appendChild(checkbox);
                        } else if (col.columnName === 'FaturaNo') {
                            // Fatura No Link (Packing List için)
                            if (value) {
                                const link = document.createElement('a');
                                link.href = '#';
                                link.textContent = value;
                                link.title = `Packing List Oluştur/Düzenle: ${value}`;
                                link.dataset.ihracatDosyaNo = item.IhracatDosyaNo;
                                link.dataset.faturaNo = value;
                                link.classList.add('packing-list-link');
                                cell.appendChild(link);
                                cell.style.textAlign = 'center';
                            } else {
                                cell.textContent = '-';
                            }
                        } else if (col.columnName === 'TeklifNo') {
                            // Teklif No Link (Proforma için)
                            if (value) {
                                const link = document.createElement('a');
                                link.href = `/Rapor18/ProformaFatura/${value}${dbQueryString}`;
                                link.target = '_blank';
                                link.textContent = value;
                                cell.appendChild(link);
                                cell.style.textAlign = 'center';
                            } else {
                                cell.textContent = '';
                            }
                        } else if (['FaturaTutari', 'TahsilatTutari'].includes(col.columnName)) {
                            // Finansal Tutar Alanları (Sadece it02/ykb için görünür)
                            if(isFinanceUser) {
                                content = value?.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) ?? '';
                                cell.textContent = content;
                                cell.style.textAlign = 'right';
                            } else {
                                cell.textContent = '-'; // Yetkisiz kullanıcılar için boş bırak
                            }
                        } else if (col.columnName === 'KalanBakiyeYuzde') {
                            // Yüzde Alanı (Sadece it02/ykb için görünür)
                            if(isFinanceUser) {
                                content = value !== null && value !== undefined ? value.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' %' : '';
                                cell.textContent = content;
                                cell.style.textAlign = 'center';
                            } else {
                                cell.textContent = '-';
                            }
                        } else if (col.columnName.includes('Tarihi')) {
                            // Tarih Alanları (Düzenlenebilir)
                            content = value ? new Date(value).toLocaleDateString('tr-TR') : '';
                            cell.textContent = content;

                            const fieldNameMapping = {
                                'OnOdemeTarihi': 'U_BE1_ONTAR',
                                'PlanlananTeslimTarihi': 'U_BE_PLTT',
                                'UretimBaslangicTarihi': 'U_BE1_URBT',
                                'PlanlananBitisTarihi': 'U_BE1_PLBT',
                                'GerceklesenBitisTarihi': 'U_BE1_GBT',
                                'FabrikaCikisTarihi': 'U_BE1_FBRKT',
                                'AnlasilanBeyannameTarihi': 'U_BE1_ABT',
                                'NavlunYuklemeTarihi': 'U_U_BE1_NYT',
                                'TahminiMusteriTeslimatTarihi': 'U_BE1_TMT',
                                'PlanlananKurulumTarihi': 'U_BE1_KRLTAR'
                            };

                            const fieldName = fieldNameMapping[col.columnName];

                            // OnOdemeTarihi sadece finans kullanıcıları için düzenlenebilir. Diğer alanlar herkes için.
                            if (fieldName === 'U_BE1_ONTAR') {
                                if (isFinanceUser) {
                                    cell.classList.add('editable-field');
                                    cell.dataset.fieldName = fieldName;
                                    cell.dataset.type = 'date';
                                }
                            } else if (fieldName) {
                                cell.classList.add('editable-field');
                                cell.dataset.fieldName = fieldName;
                                cell.dataset.type = 'date';
                            }

                        } else if (['Stokta', 'Ihtiyac', 'SiparisTeslimatSuresi'].includes(col.columnName)) {
                            // Sayısal Alanlar
                            content = value?.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) ?? '';
                            cell.textContent = content;
                            cell.style.textAlign = 'right';
                        } else if (['PlanlananHafta', 'SiparisDurumu', 'Durum', 'NakliyePlani', 'TeslimatDurumu', 'Not'].includes(col.columnName)) {
                            // Düzenlenebilir Metin/Durum Alanları
                            const fieldName = {
                                'PlanlananHafta': 'U_be1_planhafta',
                                'SiparisDurumu': 'U_BE1_SIPDUR',
                                'Durum': 'U_BE1_DRM',
                                'NakliyePlani': 'U_BE1_NKLP',
                                'TeslimatDurumu': 'U_BE1_TSLMD',
                                'Not': 'U_BE1_NOT'
                            }[col.columnName];

                            if (fieldName) {
                                cell.classList.add('editable-field');
                                cell.dataset.fieldName = fieldName;
                                cell.dataset.type = 'text';
                                content = value || '';
                                cell.textContent = content;
                            }
                        } else {
                            // Diğer Zorunlu Alanlar
                            content = value || '';
                            cell.textContent = content;
                        }

                        row.appendChild(cell);
                    });

                    frag.appendChild(row);
                });
                tableBody.appendChild(frag);
                updatePaginationInfo(data.length);
                calculateSelectedTotal();
                updateSelectAllCheckboxState();
                setupEditableFields(); // Tabloyu render ettikten sonra düzenlenebilir alanları tekrar kur
            }

            function filterTableAndRender() {
                 // Filtreleme ve sıralama mantığı
                const filters = {};
                $('.filter-select-bs').each(function () {
                    const selectElement = $(this);
                    const columnKey = selectElement.closest('th').data('column');
                    const selectedValues = selectElement.val();
                    if (selectedValues && selectedValues.length > 0) {
                        filters[columnKey] = selectedValues.map(v => (v || '').toLowerCase().trim());
                    }
                });

                $('.filter-input').each(function () {
                    const inputElement = $(this);
                    const columnKey = inputElement.closest('th').data('column');
                    const filterValue = inputElement.val().toLowerCase().trim();
                    if (filterValue) {
                        filters[columnKey] = [filterValue];
                    }
                });

                let filteredData = allReportData.filter(item => {
                    let isMatch = true;
                    for (const column in filters) {
                        const filterValues = filters[column];
                        const propName = columnMappings[column];
                        let itemValue = item[propName];

                        // Değer formatlama ve filtreleme mantığı
                        if (itemValue === null || itemValue === undefined) itemValue = '';
                        else if (propName && propName.includes('Tarihi')) {
                            itemValue = itemValue.toString();
                            if (itemValue.includes('T')) itemValue = new Date(itemValue).toLocaleDateString('tr-TR');
                        } else if (typeof itemValue === 'number' && column !== 'KalanBakiyeYuzde') {
                            itemValue = itemValue.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        } else if (column === 'KalanBakiyeYuzde' && typeof itemValue === 'number') {
                             itemValue = itemValue.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' %';
                        } else {
                            itemValue = itemValue.toString();
                        }
                        itemValue = itemValue.toLowerCase().trim();

                        if (filterValues.length > 0 && !filterValues.some(val => itemValue.includes(val))) {
                            isMatch = false;
                            break;
                        }
                    }
                    return isMatch;
                });

                // Sıralama mantığı
                if (currentSortColumn && currentSortDirection !== 'none') {
                    const sortType = document.querySelector(`th[data-column="${currentSortColumn}"]`)?.dataset.sortType;
                    const propName = columnMappings[currentSortColumn];
                    filteredData.sort((itemA, itemB) => {
                         let valA = itemA[propName];
                         let valB = itemB[propName];
                         
                         let comparison = 0;
                         if (sortType === 'number') {
                            valA = parseFloat(valA?.toString().replace(',', '.')) || 0;
                            valB = parseFloat(valB?.toString().replace(',', '.')) || 0;
                            comparison = valA - valB;
                         } else if (sortType === 'date') {
                            const dateA = valA ? new Date(valA) : new Date(0);
                            const dateB = valB ? new Date(valB) : new Date(0);
                            comparison = dateA.getTime() - dateB.getTime();
                         } else {
                            comparison = (valA || '').localeCompare((valB || ''), 'tr', { sensitivity: 'base' });
                         }

                         return currentSortDirection === 'asc' ? comparison : -comparison;
                    });
                }

                currentlyFilteredRows = filteredData;
                renderTable(currentlyFilteredRows);
            }

            function setupEditableFields() {
                document.querySelectorAll('#rapor18Table tbody td.editable-field').forEach(cell => {
                    if (cell.dataset.listenerAdded) return;
                    cell.dataset.listenerAdded = 'true';

                    cell.addEventListener('click', function (event) {
                        if (event.target.tagName === 'INPUT' || event.target.tagName === 'TEXTAREA') {
                            return;
                        }

                        const originalText = this.textContent.trim();
                        const fieldName = this.dataset.fieldName;
                        const dataType = this.dataset.type;

                        // **GÜVENLİK KONTROLÜ:** OnOdemeTarihi (U_BE1_ONTAR) sadece finans kullanıcıları için düzenlenebilir.
                        if (fieldName === 'U_BE1_ONTAR' && !isFinanceUser) {
                            showAlert('Ön Ödeme Tarihi alanını düzenleme yetkiniz bulunmamaktadır.', 'warning');
                            return;
                        }

                        this.dataset.originalValue = originalText;
                        this.innerHTML = '';

                        let inputElement;

                        if (dataType === 'date') {
                            inputElement = document.createElement('input');
                            inputElement.type = 'date';
                            inputElement.className = 'form-control form-control-sm editable-input';

                            let dateValue = originalText.split('.');
                            if (dateValue.length === 3) {
                                inputElement.value = `${dateValue[2]}-${dateValue[1]}-${dateValue[0]}`;
                            } else {
                                inputElement.value = '';
                            }
                        } else if (fieldName === 'U_BE1_NOT') {
                            inputElement = document.createElement('textarea');
                            inputElement.className = 'form-control form-control-sm editable-input';
                            inputElement.value = originalText;
                            inputElement.rows = 2;
                        } else {
                            inputElement = document.createElement('input');
                            inputElement.type = 'text';
                            inputElement.className = 'form-control form-control-sm editable-input';
                            inputElement.value = originalText;
                        }

                        this.appendChild(inputElement);
                        inputElement.focus();

                        inputElement.addEventListener('blur', function () {
                            let newValue = this.value;

                            if (dataType === 'date' && !newValue) {
                                newValue = null;
                            }

                            if (newValue === originalText || (dataType !== 'date' && newValue === '')) {
                                restoreOriginalValue(cell, originalText, dataType);
                            } else {
                                saveChange(cell, newValue);
                            }
                        });

                        inputElement.addEventListener('keydown', function (e) {
                            if (e.key === 'Enter') {
                                e.preventDefault();
                                this.blur();
                            }
                        });
                    });
                });
            }

            function restoreOriginalValue(cell, value, type) {
                if (type === 'date' && value) {
                    const datePart = new Date(value);
                    if (!isNaN(datePart)) {
                        cell.textContent = datePart.toLocaleDateString('tr-TR');
                    } else {
                        cell.textContent = value;
                    }
                } else {
                    cell.textContent = value || '';
                }

                delete cell.dataset.originalValue;
            }

            async function saveChange(cell, newValue) {
                const ihracatDosyaNo = cell.closest('tr').dataset.ihracatDosyaNo;
                const fieldName = cell.dataset.fieldName;
                const dataType = cell.dataset.type;
                const originalValue = cell.dataset.originalValue;

                cell.textContent = 'Kaydediliyor...';
                cell.classList.add('table-warning');

                const dataToSend = {
                    IhracatDosyaNo: ihracatDosyaNo,
                    FieldName: fieldName,
                    FieldValue: newValue
                };

                try {
                    // API isteğine aktif şirket bilgisini db parametresi olarak ekliyoruz
                    const response = await fetch('/Rapor18/update' + dbQueryString, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': xsrfToken
                        },
                        body: JSON.stringify(dataToSend)
                    });

                    if (response.ok) {
                        const result = await response.json();
                        showAlert(result.message, 'success');
                        cell.classList.remove('table-warning');

                        const rowData = allReportData.find(d => d.IhracatDosyaNo === ihracatDosyaNo);
                        if (rowData) {
                             const propName = columnMappings[cell.dataset.column];
                             rowData[propName] = newValue;
                        }
                        filterTableAndRender();
                    } else {
                        const errorResult = await response.json().catch(() => ({ message: 'Bilinmeyen hata.' }));
                        showAlert(`Hata: ${errorResult.message}`, 'danger');
                        cell.classList.remove('table-warning');
                        restoreOriginalValue(cell, originalValue, dataType);
                    }
                } catch (error) {
                    console.error('Update operation failed:', error);
                    showAlert('Kaydetme işlemi başarısız oldu.', 'danger');
                    cell.classList.remove('table-warning');
                    restoreOriginalValue(cell, originalValue, dataType);
                }
            }


            function initializePage() {
                window.currentColumnConfig = getInitialColumnConfig().filter(c => c.visible);

                $('.filter-select-bs').selectpicker({
                    liveSearch: true,
                    actionsBox: true,
                    selectedTextFormat: 'count > 2',
                    width: '100%',
                    container: 'body'
                }).on('changed.bs.select', function () {
                    filterTableAndRender();
                });

                document.querySelectorAll('th.sortable-column').forEach(header => {
                    header.addEventListener('click', function () {
                        const columnKey = this.dataset.column;
                        let newSortDirection;

                        if (currentSortColumn === columnKey) {
                            if (currentSortDirection === 'asc') {
                                newSortDirection = 'desc';
                            } else if (currentSortDirection === 'desc') {
                                newSortDirection = 'none';
                                currentSortColumn = null;
                            } else {
                                newSortDirection = 'asc';
                            }
                        } else {
                            if (currentSortColumn !== null) {
                                const prevHeader = document.querySelector(`th.sortable-column[data-column="${currentSortColumn}"] i`);
                                if (prevHeader) {
                                    prevHeader.className = 'fas fa-sort float-end';
                                }
                            }
                            newSortDirection = 'asc';
                            currentSortColumn = columnKey;
                        }

                        currentSortDirection = newSortDirection;

                        document.querySelectorAll('th.sortable-column i').forEach(icon => icon.className = 'fas fa-sort float-end');
                        const sortIcon = this.querySelector('i');
                        if (sortIcon && currentSortDirection !== 'none') {
                            sortIcon.className = `fas fa-sort-${currentSortDirection === 'asc' ? 'up' : 'down'} float-end`;
                        } else if (sortIcon && currentSortDirection === 'none') {
                            sortIcon.className = 'fas fa-sort float-end';
                        }
                        
                        filterTableAndRender();
                    });
                });

                document.querySelectorAll('.filter-input').forEach(input => {
                    input.addEventListener('keyup', function () {
                        filterTableAndRender();
                    });
                });

                // "Tüm Filtreleri Temizle" Butonuna tıklanınca URL'deki db parametresini kaybetmemek için güncelledik.
                if (clearAllFiltersBtn) {
                    clearAllFiltersBtn.addEventListener('click', function () {
                        let currentUrl = window.location.href;
                        let baseUrl = currentUrl.split('?')[0];
                        let newUrl = baseUrl;
                        if (currentDbParam) {
                            newUrl += `?db=${currentDbParam}`;
                        }
                        window.location.href = newUrl;
                    });
                }

                renderTable(allReportData);
            }

            // Tümü Seç, Satır Checkbox ve Modal olayları buraya dahil edildi
            if (selectAllCheckbox) {
                selectAllCheckbox.addEventListener('change', function () {
                    const isChecked = this.checked;
                    document.querySelectorAll('#rapor18Table tbody tr input.row-selector').forEach(checkbox => {
                        checkbox.checked = isChecked;
                    });
                    calculateSelectedTotal();
                });
            }

            tableBody.addEventListener('change', function (event) {
                if (event.target.classList.contains('row-selector')) {
                    calculateSelectedTotal();
                    updateSelectAllCheckboxState();
                }
            });

            // Satır tıklandığında Checkbox'ı tetikle
            tableBody.addEventListener('click', function (event) {
                const target = event.target;
                
                // Eğer Editable Field (inline edit), A linki (Packing list/Proforma) veya Select picker ise satır seçimi yapma!
                if (target.classList.contains('editable-field') || target.closest('.editable-field') || target.tagName === 'A' || target.closest('.bootstrap-select') || target.tagName === 'INPUT') {
                    return;
                }

                const row = target.closest('tr');
                if (!row) return;

                const checkbox = row.querySelector('.row-selector');
                if (checkbox) {
                    checkbox.checked = !checkbox.checked;
                    calculateSelectedTotal();
                    updateSelectAllCheckboxState();
                }
            });

            initializePage();
        });
    </script>
}