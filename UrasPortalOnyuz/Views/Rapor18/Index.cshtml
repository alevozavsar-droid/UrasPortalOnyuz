                                <th data-column="GerceklesenBitisTarihi"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                                <th data-column="Stokta"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                                <th data-column="Ihtiyac"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                                <th data-column="Durum">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Durum">
                                        @if (distinctValues.ContainsKey("Durum"))
                                        {
                                            foreach (var item in distinctValues["Durum"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="NakliyePlani">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Nakliye Planı">
                                        @if (distinctValues.ContainsKey("NakliyePlani"))
                                        {
                                            foreach (var item in distinctValues["NakliyePlani"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="FabrikaCikisTarihi"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                                <th data-column="TeslimatDurumu">
                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="Teslimat Durumu">
                                        @if (distinctValues.ContainsKey("TeslimatDurumu"))
                                        {
                                            foreach (var item in distinctValues["TeslimatDurumu"])
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                    </select>
                                </th>
                                <th data-column="AnlasilanBeyannameTarihi"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                                <th data-column="NavlunYuklemeTarihi"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                                <th data-column="TahminiMusteriTeslimatTarihi"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                                <th data-column="PlanlananKurulumTarihi"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
                                <th data-column="Not"><input type="text" class="form-control form-control-sm filter-input" placeholder="Filtrele..."></th>
