                        <button type="submit" id="savePackingListBtn" class="btn btn-success"><i class="fas fa-save"></i> Kaydet ve PDF Oluştur</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    </div>
                </form>
            </div>
        </div>
