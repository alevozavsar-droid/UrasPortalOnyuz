                                    <select class="form-select form-select-sm filter-select-bs" multiple data-live-search="true" data-actions-box="true" data-selected-text-format="count > 2" data-width="100%" title="İhr. Dosya No">
                                        @if (distinctValues.ContainsKey("IhracatDosyaNo"))
