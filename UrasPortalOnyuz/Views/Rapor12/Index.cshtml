@using System.Globalization
@model dynamic

@{
    ViewData["Title"] = "Ciro Raporları";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Aktif Veritabanını (Şirketi) URL veya Cookie'den alıyoruz ki linklerde kaybolmasın
    var currentDb = Context.Request.Query["db"].ToString();
    if (string.IsNullOrEmpty(currentDb))
    {
        currentDb = Context.Request.Cookies["SelectedDatabase"];
    }

    // Varsayılan olarak Ciro
    string currentReportType = ViewBag.CurrentReportType ?? "Ciro";
    int currentReportYear = ViewBag.CurrentReportYear ?? 2025;

    // Sadece CiroDovizli metin tabanlı (HTML render edilir)
    bool isDovizli = currentReportType == "CiroDovizli";

    IEnumerable<dynamic> activeData = Model as IEnumerable<dynamic>;

    // Ciro Raporlarına Özel Tema Renkleri
    string themeColor = currentReportType switch
    {
        "Ciro" => "#c0392b",        // Kırmızı (TL)
        "CiroUSD" => "#16a085",     // Turkuaz (USD)
        "CiroEUR" => "#f39c12",     // Amber (EUR)
        "CiroDovizli" => "#34495e", // Koyu Lacivert (Karma Ciro)
        _ => "#2c3e50"
    };
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .page-container {
            position: relative !important;
            z-index: 1 !important;
            isolation: isolate;
        }

        .sidebar {
            z-index: 999999 !important;
        }

        .rapor-tablo th {
            background-color: var(--report-theme);
            color: white;
            padding: 12px 5px;
            text-align: center;
            position: sticky;
            top: 0;
            z-index: 10 !important;
            border: 1px solid rgba(255,255,255,0.1);
            box-shadow: 0 2px 2px -1px rgba(0, 0, 0, 0.4);
        }

        .selection-sum-row {
            background-color: #f1f2f6 !important;
            font-weight: bold;
            border-top: 2px solid var(--report-theme);
            position: sticky;
            bottom: 0;
            z-index: 10 !important;
        }

        :root {
            --report-theme: @themeColor;
            --report-theme-light: color-mix(in srgb, var(--report-theme), white 80%);
            --primary: #2c3e50;
            --hover-cell: #fff9c4;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: #f4f7f6;
            font-size: 12px;
        }

        .report-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            padding: 20px;
            margin-bottom: 30px;
            border-top: 5px solid var(--report-theme);
        }

        .nav-pills .nav-link {
            color: #555;
            font-weight: 600;
            border: 1px solid #dee2e6;
            margin-right: 5px;
            transition: all 0.3s;
            font-size: 11px;
            padding: 8px 12px;
        }

        .nav-pills .nav-link.active {
            background-color: var(--report-theme) !important;
            border-color: var(--report-theme);
            color: white;
            box-shadow: 0 4px 6px rgba(0,0,0,0.2);
        }

        .nav-pills .nav-link:hover:not(.active) {
            background-color: #eee;
        }

        .table-responsive {
            border-radius: 8px;
            overflow-x: auto; 
            border: 1px solid #dee2e6;
        }

        .rapor-tablo {
            margin-bottom: 0;
            width: 100%;
            border-collapse: collapse;
        }

        .rapor-tablo td {
            padding: 8px 10px;
            border: 1px solid #eee;
            vertical-align: middle;
        }

        .rapor-tablo tbody tr:hover td {
            background-color: var(--hover-cell) !important;
            color: #000;
        }

        .ciro-subtotal {
            background-color: var(--report-theme-light) !important;
            font-weight: bold;
            color: #000;
            border-top: 1px solid var(--report-theme);
            border-bottom: 1px solid var(--report-theme);
        }

        .ciro-grandtotal, .general-total-row {
            background-color: var(--report-theme) !important;
            color: white !important;
            font-weight: 900;
        }

        .numeric {
            text-align: right;
            font-family: 'Roboto Mono', monospace;
            white-space: nowrap;
        }

        .table-title {
            border-left: 5px solid var(--report-theme);
            padding-left: 10px;
            margin: 20px 0 15px 0;
            font-weight: bold;
            color: var(--report-theme);
            text-transform: uppercase;
            font-size: 1.1rem;
        }

        .badge-custom {
            font-size: 0.9rem;
            padding: 8px 15px;
            border-radius: 50px;
            background-color: var(--report-theme) !important;
            color: white;
        }

        .currency-cell {
            font-family: 'Consolas', monospace;
            font-size: 11px;
            white-space: pre-line;
            text-align: right;
            vertical-align: top;
        }

        .currency-line {
            display: block;
            border-bottom: 1px dashed #eee;
            padding: 2px 0;
        }

        .currency-line:last-child {
            border-bottom: none;
        }

        /* Detay Link Stilleri */
        .detail-link {
            color: inherit;
            text-decoration: none;
            border-bottom: 1px dashed rgba(0,0,0,0.3);
            transition: 0.2s;
            cursor: pointer;
            display: inline-block;
        }

        .detail-link:hover {
            color: var(--report-theme);
            border-bottom-color: var(--report-theme);
            background: rgba(0,0,0,0.05);
        }

        /* Kıyaslama (YoY) Kartları Stilleri */
        .summary-card { border-left: 4px solid; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
        .summary-card.success { border-left-color: #28a745; }
        .summary-card.danger { border-left-color: #dc3545; }

        /* Ana Tablo Hücre İçi Yüzdelik Rozet Stilleri */
        .yoy-badge {
            display: block;
            font-size: 0.70rem;
            padding: 2px 4px;
            border-radius: 4px;
            margin-top: 4px;
            font-weight: 700;
            letter-spacing: -0.3px;
            text-align: right;
            float: right;
            clear: both;
        }
        .yoy-up { background-color: rgba(40, 167, 69, 0.15); color: #28a745; }
        .yoy-down { background-color: rgba(220, 53, 69, 0.15); color: #dc3545; }
        .yoy-neutral { background-color: rgba(108, 117, 125, 0.15); color: #6c757d; }
    </style>
}

<div class="container-fluid py-3">
    <div class="report-card">

        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="mb-1 fw-bold" style="color: var(--report-theme)">
                    @if (isDovizli)
                    {
                        <i class="fas fa-globe"></i>
                    }
                    else if (currentReportType == "Ciro")
                    {
                        <i class="fas fa-lira-sign"></i>
                    }
                    else if (currentReportType == "CiroUSD")
                    {
                        <i class="fas fa-dollar-sign"></i>
                    }
                    else if (currentReportType == "CiroEUR")
                    {
                        <i class="fas fa-euro-sign"></i>
                    }

                    @(currentReportYear == 0 ? "TÜM YILLAR" : currentReportYear.ToString()) Ciro Analizi
                </h2>

                <div class="d-flex align-items-center gap-3 mt-2">
                    <span class="text-muted">Rapor Türü: <strong>@currentReportType.ToUpper()</strong></span>

                    <span class="text-muted border-start ps-3"></span>

                    <div class="btn-group shadow-sm" role="group" aria-label="Yıl Seçimi">
                        <a href="@Url.Action("Index", "Rapor12", new { reportType = currentReportType, year = 0, db = currentDb })"
                           class="btn @(currentReportYear == 0 ? "btn-primary" : "btn-outline-primary") fw-bold px-3">
                            <i class="fas fa-calendar-alt me-1"></i> TÜMÜ
                        </a>
                        <a href="@Url.Action("Index", "Rapor12", new { reportType = currentReportType, year = 2024, db = currentDb })"
                           class="btn @(currentReportYear == 2024 ? "btn-primary" : "btn-outline-primary") fw-bold px-3">
                            <i class="fas fa-calendar me-1"></i> 2024
                        </a>
                        <a href="@Url.Action("Index", "Rapor12", new { reportType = currentReportType, year = 2025, db = currentDb })"
                           class="btn @(currentReportYear == 2025 ? "btn-primary" : "btn-outline-primary") fw-bold px-3">
                            <i class="fas fa-calendar me-1"></i> 2025
                        </a>
                        <a href="@Url.Action("Index", "Rapor12", new { reportType = currentReportType, year = 2026, db = currentDb })"
                           class="btn @(currentReportYear == 2026 ? "btn-primary" : "btn-outline-primary") fw-bold px-3">
                            <i class="fas fa-calendar me-1"></i> 2026
                        </a>
                    </div>
                </div>
            </div>

            @if (!isDovizli)
            {
                <div class="d-flex gap-3">
                    <div class="badge badge-custom shadow-sm p-3">
                        <i class="fas fa-calculator me-2"></i>Seçili Toplam: <span id="sel-total" class="fs-6">0,00</span>
                    </div>
                </div>
            }
        </div>

        <ul class="nav nav-pills mb-4">
            <li class="nav-item"><a class="nav-link @(currentReportType == "Ciro" ? "active" : "")" href="@Url.Action("Index", "Rapor12", new { reportType = "Ciro", year = currentReportYear, db = currentDb })"><i class="fas fa-lira-sign me-1"></i> CİRO (TL)</a></li>
            <li class="nav-item"><a class="nav-link @(currentReportType == "CiroUSD" ? "active" : "")" href="@Url.Action("Index", "Rapor12", new { reportType = "CiroUSD", year = currentReportYear, db = currentDb })"><i class="fas fa-dollar-sign me-1"></i> CİRO (USD)</a></li>
            <li class="nav-item"><a class="nav-link @(currentReportType == "CiroEUR" ? "active" : "")" href="@Url.Action("Index", "Rapor12", new { reportType = "CiroEUR", year = currentReportYear, db = currentDb })"><i class="fas fa-euro-sign me-1"></i> CİRO (EUR)</a></li>
            <li class="nav-item"><a class="nav-link @(currentReportType == "CiroDovizli" ? "active" : "")" href="@Url.Action("Index", "Rapor12", new { reportType = "CiroDovizli", year = currentReportYear, db = currentDb })"><i class="fas fa-globe me-1"></i> CİRO (KARMA)</a></li>
        </ul>

        @if (activeData != null && activeData.Any())
        {
            // Grup İçi ve Bayiler olarak verileri ayırma (isDovizli kontrolü ile güvenli çekim)
            var grupIciData = new List<dynamic>();
            var bayilerData = new List<dynamic>();

            foreach (var item in activeData)
            {
                string aciklamaText = isDovizli ? (string)item.Aciklama : (string)item.IslemTipi;
                
                if (string.IsNullOrWhiteSpace(aciklamaText)) continue;

                string upperText = aciklamaText.ToUpper(new System.Globalization.CultureInfo("tr-TR"));

                // Eski tasarımda kalan ayırıcı başlığı tamamen yok ediyoruz
                if (upperText.Contains("***BAYİLER NET CİRO DETAYI***") || upperText.Contains("***BAYILER"))
                {
                    continue; 
                }

                // Asia, Avrasya ve Bayi isimleri taşıyanları bayi tablosuna gönderiyoruz
                if (upperText.Contains("ASIA") || upperText.Contains("AVRASYA") || upperText.Contains("BAYİ") || upperText.Contains("BAYI"))
                {
                    bayilerData.Add(item);
                }
                else
                {
                    grupIciData.Add(item);
                }
            }

            // ------------------ GRUP İÇİ TABLOSU ------------------
            @if (grupIciData.Any())
            {
                <h4 class="table-title">Grup İçi Ciro Detayı</h4>
                <div class="table-responsive mb-5">
                    <table class="table table-bordered rapor-tablo" id="main-table-grup">
                        <thead>
                            <tr>
                                @if (!isDovizli)
                                {
                                    <th style="width: 40px;" class="text-center">
                                        <input type="checkbox" class="select-all" data-target="main-table-grup" title="Hepsini Seç">
                                    </th>
                                }
                                <th style="min-width: 250px;">AÇIKLAMA / İŞLEM TİPİ</th>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <th>@DateTimeFormatInfo.CurrentInfo.GetMonthName(i).ToUpper()</th>
                                }
                                <th>TOPLAM</th>
                                @if (!isDovizli)
                                {
                                    <th>ORT.</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in grupIciData)
                            {
                                string aciklama = isDovizli ? (string)item.Aciklama : (string)item.IslemTipi;

                                string rowClass = "";
                                bool disableCheckbox = false;
                                bool isDetailable = true;

                                if (aciklama.Contains("GENEL TOPLAM") || aciklama.Contains("TOT_ALL"))
                                {
                                    rowClass = "general-total-row";
                                    disableCheckbox = true;
                                    isDetailable = false;
                                }
                                else if (aciklama.StartsWith("**"))
                                {
                                    rowClass = "ciro-subtotal";
                                    aciklama = aciklama.Replace("**", "").Trim();
                                    disableCheckbox = true;
                                    isDetailable = false;
                                }

                                <tr class="@rowClass">
                                    @if (!isDovizli)
                                    {
                                        <td class="text-center">
                                            @if (!disableCheckbox)
                                            {
                                                <input type="checkbox" class="row-checkbox">
                                            }
                                        </td>
                                    }

                                    <td class="fw-bold text-start">@aciklama</td>

                                    @if (isDovizli)
                                    {
                                        <td class="currency-cell" data-row="@aciklama" data-month="1">@Html.Raw(FormatCurrency(item.Ocak, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="2">@Html.Raw(FormatCurrency(item.Subat, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="3">@Html.Raw(FormatCurrency(item.Mart, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="4">@Html.Raw(FormatCurrency(item.Nisan, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="5">@Html.Raw(FormatCurrency(item.Mayis, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="6">@Html.Raw(FormatCurrency(item.Haziran, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="7">@Html.Raw(FormatCurrency(item.Temmuz, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="8">@Html.Raw(FormatCurrency(item.Agustos, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="9">@Html.Raw(FormatCurrency(item.Eylul, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="10">@Html.Raw(FormatCurrency(item.Ekim, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="11">@Html.Raw(FormatCurrency(item.Kasim, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="12">@Html.Raw(FormatCurrency(item.Aralik, isDetailable))</td>
                                        <td class="currency-cell fw-bold bg-light border-start border-2">@Html.Raw(FormatCurrency(item.Toplam, false))</td>
                                    }
                                    else
                                    {
                                        <td class="numeric col-m-1" data-val="@item.Ocak" data-row="@aciklama" data-month="1">
                                            @(isDetailable && item.Ocak != 0 ? Html.Raw($"<a class='detail-link'>{item.Ocak.ToString("N2")}</a>") : item.Ocak.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-2" data-val="@item.Subat" data-row="@aciklama" data-month="2">
                                            @(isDetailable && item.Subat != 0 ? Html.Raw($"<a class='detail-link'>{item.Subat.ToString("N2")}</a>") : item.Subat.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-3" data-val="@item.Mart" data-row="@aciklama" data-month="3">
                                            @(isDetailable && item.Mart != 0 ? Html.Raw($"<a class='detail-link'>{item.Mart.ToString("N2")}</a>") : item.Mart.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-4" data-val="@item.Nisan" data-row="@aciklama" data-month="4">
                                            @(isDetailable && item.Nisan != 0 ? Html.Raw($"<a class='detail-link'>{item.Nisan.ToString("N2")}</a>") : item.Nisan.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-5" data-val="@item.Mayis" data-row="@aciklama" data-month="5">
                                            @(isDetailable && item.Mayis != 0 ? Html.Raw($"<a class='detail-link'>{item.Mayis.ToString("N2")}</a>") : item.Mayis.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-6" data-val="@item.Haziran" data-row="@aciklama" data-month="6">
                                            @(isDetailable && item.Haziran != 0 ? Html.Raw($"<a class='detail-link'>{item.Haziran.ToString("N2")}</a>") : item.Haziran.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-7" data-val="@item.Temmuz" data-row="@aciklama" data-month="7">
                                            @(isDetailable && item.Temmuz != 0 ? Html.Raw($"<a class='detail-link'>{item.Temmuz.ToString("N2")}</a>") : item.Temmuz.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-8" data-val="@item.Agustos" data-row="@aciklama" data-month="8">
                                            @(isDetailable && item.Agustos != 0 ? Html.Raw($"<a class='detail-link'>{item.Agustos.ToString("N2")}</a>") : item.Agustos.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-9" data-val="@item.Eylul" data-row="@aciklama" data-month="9">
                                            @(isDetailable && item.Eylul != 0 ? Html.Raw($"<a class='detail-link'>{item.Eylul.ToString("N2")}</a>") : item.Eylul.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-10" data-val="@item.Ekim" data-row="@aciklama" data-month="10">
                                            @(isDetailable && item.Ekim != 0 ? Html.Raw($"<a class='detail-link'>{item.Ekim.ToString("N2")}</a>") : item.Ekim.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-11" data-val="@item.Kasim" data-row="@aciklama" data-month="11">
                                            @(isDetailable && item.Kasim != 0 ? Html.Raw($"<a class='detail-link'>{item.Kasim.ToString("N2")}</a>") : item.Kasim.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-12" data-val="@item.Aralik" data-row="@aciklama" data-month="12">
                                            @(isDetailable && item.Aralik != 0 ? Html.Raw($"<a class='detail-link'>{item.Aralik.ToString("N2")}</a>") : item.Aralik.ToString("N2"))
                                        </td>
                                        <td class="numeric fw-bold col-row-total" data-val="@item.Toplam" data-row="@aciklama">@item.Toplam.ToString("N2")</td>

                                        <td class="numeric text-muted small">@item.YillikOrtalama.ToString("N2")</td>
                                    }
                                </tr>
                            }
                        </tbody>

                        @if (!isDovizli)
                        {
                            <tfoot>
                                <tr class="selection-sum-row">
                                    <td colspan="2" class="text-center" style="color: var(--report-theme)">
                                        <i class="fas fa-calculator me-2"></i>GRUP İÇİ SEÇİLİ TOPLAM
                                    </td>
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <td class="numeric" id="sum-m-@i-grup">0,00</td>
                                    }
                                    <td class="numeric text-danger fs-6" id="sum-total-grup">0,00</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            }

            // ------------------ BAYİLER TABLOSU ------------------
            @if (bayilerData.Any())
            {
                <h4 class="table-title" style="margin-top:40px;">Bayiler Ciro Detayı</h4>
                <div class="table-responsive mb-5">
                    <table class="table table-bordered rapor-tablo" id="main-table-bayi">
                        <thead>
                            <tr>
                                @if (!isDovizli)
                                {
                                    <th style="width: 40px;" class="text-center">
                                        <input type="checkbox" class="select-all" data-target="main-table-bayi" title="Hepsini Seç">
                                    </th>
                                }
                                <th style="min-width: 250px;">AÇIKLAMA / İŞLEM TİPİ</th>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <th>@DateTimeFormatInfo.CurrentInfo.GetMonthName(i).ToUpper()</th>
                                }
                                <th>TOPLAM</th>
                                @if (!isDovizli)
                                {
                                    <th>ORT.</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in bayilerData)
                            {
                                string aciklama = isDovizli ? (string)item.Aciklama : (string)item.IslemTipi;

                                string rowClass = "";
                                bool disableCheckbox = false;
                                bool isDetailable = true;

                                if (aciklama.Contains("GENEL TOPLAM") || aciklama.Contains("TOT_ALL"))
                                {
                                    rowClass = "general-total-row";
                                    disableCheckbox = true;
                                    isDetailable = false;
                                }
                                else if (aciklama.StartsWith("**"))
                                {
                                    rowClass = "ciro-subtotal";
                                    aciklama = aciklama.Replace("**", "").Trim();
                                    disableCheckbox = true;
                                    isDetailable = false;
                                }

                                <tr class="@rowClass">
                                    @if (!isDovizli)
                                    {
                                        <td class="text-center">
                                            @if (!disableCheckbox)
                                            {
                                                <input type="checkbox" class="row-checkbox">
                                            }
                                        </td>
                                    }

                                    <td class="fw-bold text-start">@aciklama</td>

                                    @if (isDovizli)
                                    {
                                        <td class="currency-cell" data-row="@aciklama" data-month="1">@Html.Raw(FormatCurrency(item.Ocak, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="2">@Html.Raw(FormatCurrency(item.Subat, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="3">@Html.Raw(FormatCurrency(item.Mart, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="4">@Html.Raw(FormatCurrency(item.Nisan, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="5">@Html.Raw(FormatCurrency(item.Mayis, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="6">@Html.Raw(FormatCurrency(item.Haziran, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="7">@Html.Raw(FormatCurrency(item.Temmuz, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="8">@Html.Raw(FormatCurrency(item.Agustos, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="9">@Html.Raw(FormatCurrency(item.Eylul, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="10">@Html.Raw(FormatCurrency(item.Ekim, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="11">@Html.Raw(FormatCurrency(item.Kasim, isDetailable))</td>
                                        <td class="currency-cell" data-row="@aciklama" data-month="12">@Html.Raw(FormatCurrency(item.Aralik, isDetailable))</td>
                                        <td class="currency-cell fw-bold bg-light border-start border-2">@Html.Raw(FormatCurrency(item.Toplam, false))</td>
                                    }
