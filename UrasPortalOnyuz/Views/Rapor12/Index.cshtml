                                    {
                                        <td class="numeric col-m-1" data-val="@item.Ocak" data-row="@aciklama" data-month="1">
                                            @(isDetailable && item.Ocak != 0 ? Html.Raw($"<a class='detail-link'>{item.Ocak.ToString("N2")}</a>") : item.Ocak.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-2" data-val="@item.Subat" data-row="@aciklama" data-month="2">
                                            @(isDetailable && item.Subat != 0 ? Html.Raw($"<a class='detail-link'>{item.Subat.ToString("N2")}</a>") : item.Subat.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-3" data-val="@item.Mart" data-row="@aciklama" data-month="3">
                                            @(isDetailable && item.Mart != 0 ? Html.Raw($"<a class='detail-link'>{item.Mart.ToString("N2")}</a>") : item.Mart.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-4" data-val="@item.Nisan" data-row="@aciklama" data-month="4">
                                            @(isDetailable && item.Nisan != 0 ? Html.Raw($"<a class='detail-link'>{item.Nisan.ToString("N2")}</a>") : item.Nisan.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-5" data-val="@item.Mayis" data-row="@aciklama" data-month="5">
                                            @(isDetailable && item.Mayis != 0 ? Html.Raw($"<a class='detail-link'>{item.Mayis.ToString("N2")}</a>") : item.Mayis.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-6" data-val="@item.Haziran" data-row="@aciklama" data-month="6">
                                            @(isDetailable && item.Haziran != 0 ? Html.Raw($"<a class='detail-link'>{item.Haziran.ToString("N2")}</a>") : item.Haziran.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-7" data-val="@item.Temmuz" data-row="@aciklama" data-month="7">
                                            @(isDetailable && item.Temmuz != 0 ? Html.Raw($"<a class='detail-link'>{item.Temmuz.ToString("N2")}</a>") : item.Temmuz.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-8" data-val="@item.Agustos" data-row="@aciklama" data-month="8">
                                            @(isDetailable && item.Agustos != 0 ? Html.Raw($"<a class='detail-link'>{item.Agustos.ToString("N2")}</a>") : item.Agustos.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-9" data-val="@item.Eylul" data-row="@aciklama" data-month="9">
                                            @(isDetailable && item.Eylul != 0 ? Html.Raw($"<a class='detail-link'>{item.Eylul.ToString("N2")}</a>") : item.Eylul.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-10" data-val="@item.Ekim" data-row="@aciklama" data-month="10">
                                            @(isDetailable && item.Ekim != 0 ? Html.Raw($"<a class='detail-link'>{item.Ekim.ToString("N2")}</a>") : item.Ekim.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-11" data-val="@item.Kasim" data-row="@aciklama" data-month="11">
                                            @(isDetailable && item.Kasim != 0 ? Html.Raw($"<a class='detail-link'>{item.Kasim.ToString("N2")}</a>") : item.Kasim.ToString("N2"))
                                        </td>
                                        <td class="numeric col-m-12" data-val="@item.Aralik" data-row="@aciklama" data-month="12">
                                            @(isDetailable && item.Aralik != 0 ? Html.Raw($"<a class='detail-link'>{item.Aralik.ToString("N2")}</a>") : item.Aralik.ToString("N2"))
                                        </td>
                                        <td class="numeric fw-bold col-row-total" data-val="@item.Toplam" data-row="@aciklama">@item.Toplam.ToString("N2")</td>

                                        <td class="numeric text-muted small">@item.YillikOrtalama.ToString("N2")</td>
                                    }
                                </tr>
                            }
                        </tbody>

                        @if (!isDovizli)
                        {
                            <tfoot>
                                <tr class="selection-sum-row">
                                    <td colspan="2" class="text-center" style="color: var(--report-theme)">
                                        <i class="fas fa-calculator me-2"></i>BAYİ SEÇİLİ TOPLAMI
                                    </td>
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <td class="numeric" id="sum-m-@i-bayi">0,00</td>
                                    }
                                    <td class="numeric text-danger fs-6" id="sum-total-bayi">0,00</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            }
        }
        else
        {
            <div class="alert alert-warning text-center mt-5 p-4 shadow-sm">
                <i class="fas fa-exclamation-triangle fa-3x mb-3 text-warning"></i><br>
                <h5 class="fw-bold">Görüntülenecek veri bulunamadı.</h5>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="detailModal" tabindex="-1" role="dialog" aria-labelledby="detailModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header" style="background-color: var(--report-theme); color: white;">
                <h5 class="modal-title fw-bold" id="detailModalTitle">Ciro Detayı</h5>
                
                <button type="button" class="close btn-close btn-close-white" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close" style="color: white; opacity: 1; border: none; background: transparent; font-size: 1.8rem; line-height: 1;">
                    <span aria-hidden="true">&times;</span>
                </button>
                
            </div>
            <div class="modal-body" id="detailModalBody" style="background-color: #f8f9fa;">
                </div>
            <div class="modal-footer" style="background-color: #f8f9fa; border-top: 1px solid #ddd;">
                <button type="button" class="btn btn-secondary fw-bold" data-dismiss="modal" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@functions {
    public string FormatCurrency(object dataObj, bool isDetailable = true)
    {
        if (dataObj == null) return "-";
        string data = dataObj.ToString();
        if (string.IsNullOrEmpty(data) || data == "0.00 TL" || data == "0,00 TL") return "-";

        var lines = data.Split(new[] { '\n', '\r', '+' }, StringSplitOptions.RemoveEmptyEntries);
        string html = "";
        foreach (var line in lines)
        {
            if (!string.IsNullOrWhiteSpace(line))
            {
                if (isDetailable)
                {
                    html += $"<span class='currency-line'><a class='detail-link'>{line.Trim()}</a></span>";
                }
                else
                {
                    html += $"<span class='currency-line'>{line.Trim()}</span>";
                }
            }
        }
        return html;
    }
}

@section Scripts {

    <script>
        $(document).ready(function () {
            
            // Aktif veritabanı parametresini değişkene alıyoruz (API istekleri için)
            const currentDbParam = '@currentDb';

            $('#detailModal').appendTo("body");

            $(document).on("click", "[data-dismiss='modal'], [data-bs-dismiss='modal']", function () {
                $("#detailModal").modal('hide');
            });

            var jsCurrentReportType = "@currentReportType";
            var jsCurrentReportYear = @currentReportYear;
            var jsIsDovizli = @(isDovizli ? "true" : "false");

            // --- DETAY TIKLAMA VE YOY KIYASLAMA EKRANI ---
            $(document).on("click", ".detail-link", function (e) {
                e.preventDefault();
                let valText = $(this).text().trim();
                
                if (valText === "0,00" || valText === "-" || valText === "0.00" || valText === "") return;

                let $td = $(this).closest("td");
                let rowName = $td.attr("data-row");
                let month = $td.attr("data-month");

                if (!rowName || !month) return;

                $("#detailModalTitle").text(rowName + " (" + month + ". Ay " + jsCurrentReportYear + " Detayı)");
                $("#detailModalBody").html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><h5 class="mt-3">Kayıtlar ve Yıllık Kıyaslamalar Hesaplanıyor...</h5></div>');
                
                $("#detailModal").modal("show");

                // GetDetail İsteğine db parametresini ekliyoruz
                $.get("/Rapor12/GetDetail", { reportType: jsCurrentReportType, year: jsCurrentReportYear, month: month, rowName: rowName, db: currentDbParam }, function (res) {
                    if (res.success) {
                        let html = '';
                        let s = res.summary;

                        if (s && jsCurrentReportYear > 0) {
                            let tlIcon = s.diffTL >= 0 ? '<i class="fas fa-arrow-up"></i>' : '<i class="fas fa-arrow-down"></i>';
                            let tlColorHex = s.diffTL >= 0 ? '#28a745' : '#dc3545';
                            let tlSign = s.diffTL > 0 ? '+' : '';

                            let usdIcon = s.diffUSD >= 0 ? '<i class="fas fa-arrow-up"></i>' : '<i class="fas fa-arrow-down"></i>';
                            let usdColorHex = s.diffUSD >= 0 ? '#28a745' : '#dc3545';
                            let usdSign = s.diffUSD > 0 ? '+' : '';

                            html += `
                            <div class="row mb-4">
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <div class="card summary-card p-3 bg-white h-100" style="border-left-color: ${tlColorHex};">
                                        <div class="text-muted fw-bold mb-2"><i class="fas fa-lira-sign me-1"></i> TL Büyüme (Geçen Yıla Göre)</div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="small text-muted">${s.prevYear}: ${formatMoney(s.prevTL)} ₺</div>
                                                <div class="fw-bold fs-5">${s.currYear}: ${formatMoney(s.currTL)} ₺</div>
                                            </div>
                                            <div class="text-end">
                                                <div class="fw-bold fs-5" style="color: ${tlColorHex};">${tlSign}${formatMoney(s.diffTL)} ₺</div>
                                                <div class="badge fs-6 mt-1 px-2 py-1" style="background-color: ${tlColorHex}; color: white; border-radius: 4px;">
                                                    ${tlIcon} %${formatMoney(s.percTL)}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card summary-card p-3 bg-white h-100" style="border-left-color: ${usdColorHex};">
                                        <div class="text-muted fw-bold mb-2"><i class="fas fa-dollar-sign me-1"></i> Gerçek Büyüme (Günlük USD Kuru)</div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="small text-muted">${s.prevYear}: $${formatMoney(s.prevUSD)}</div>
                                                <div class="fw-bold fs-5">${s.currYear}: $${formatMoney(s.currUSD)}</div>
                                            </div>
                                            <div class="text-end">
                                                <div class="fw-bold fs-5" style="color: ${usdColorHex};">${usdSign}$${formatMoney(s.diffUSD)}</div>
                                                <div class="badge fs-6 mt-1 px-2 py-1" style="background-color: ${usdColorHex}; color: white; border-radius: 4px;">
                                                    ${usdIcon} %${formatMoney(s.percUSD)}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            `;
                        }

                        if (res.data.length === 0) {
                            html += '<div class="alert alert-info text-center mt-3">Bu ay için detay kaydı bulunamadı.</div>';
                            $("#detailModalBody").html(html);
                            return;
                        }

                        html += `
                            <h6 class="fw-bold mb-2 text-muted px-1"><i class="fas fa-list me-2"></i>Fatura Dökümü</h6>
                            <div class="table-responsive bg-white p-2 rounded border">
                                <table class="table table-striped table-hover table-sm m-0">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Şirket</th>
                                            <th>Tarih</th>
                                            <th>Belge No</th>
                                            <th>Cari Kodu</th>
                                            <th>Cari Adı</th>
                                            <th class="text-end">Tutar</th>
                                            <th>Döviz</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;

                        let totalAmount = 0;
                        $.each(res.data, function (i, item) {
                            totalAmount += item.tutar;
                            html += `
                                <tr>
                                    <td><span class="badge bg-secondary">${item.sirket}</span></td>
                                    <td>${item.tarih}</td>
                                    <td><strong>${item.belgeNo}</strong></td>
                                    <td>${item.cariKodu}</td>
                                    <td>${item.cariAdi}</td>
                                    <td class="text-end fw-bold">${formatMoney(item.tutar)}</td>
                                    <td>${item.paraBirimi}</td>
                                </tr>
                            `;
                        });

                        html += `
                                    </tbody>
                                    <tfoot class="table-group-divider">
                                        <tr class="table-primary">
                                            <td colspan="5" class="text-end fw-bold">TABLO TOPLAMI:</td>
                                            <td class="text-end fw-bold fs-6">${formatMoney(totalAmount)}</td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        `;
                        $("#detailModalBody").html(html);
                    } else {
                        $("#detailModalBody").html('<div class="alert alert-danger"><i class="fas fa-exclamation-circle me-2"></i>' + res.message + '</div>');
                    }
                }).fail(function () {
                    $("#detailModalBody").html('<div class="alert alert-danger"><i class="fas fa-wifi me-2"></i>Sunucuya bağlanırken bir hata oluştu.</div>');
                });
            });

            // =========================================================================
            // ANA TABLO HÜCRE İÇİ BÜYÜME (YoY) YÜZDELERİ - AJAX İLE YÜKLEME
            // =========================================================================
            if (!jsIsDovizli && jsCurrentReportYear > 0) {
                // GetPreviousYearData İsteğine db parametresini ekliyoruz
                $.get('/Rapor12/GetPreviousYearData', { reportType: jsCurrentReportType, currentYear: jsCurrentReportYear, db: currentDbParam }, function (res) {
                    if (res.success && res.data) {
                        
                        let prevDataMap = {};
                        res.data.forEach(item => {
                            let key = (item.islemTipi || item.aciklama || "").replace(/\*/g, "").trim();
                            if (key) prevDataMap[key] = item;
                        });

                        let monthProps = ['', 'ocak', 'subat', 'mart', 'nisan', 'mayis', 'haziran', 'temmuz', 'agustos', 'eylul', 'ekim', 'kasim', 'aralik'];

                        // Yalnızca TOPLAM yazan satırlar için YoY (Yüzdelik değişim) eklenecek
                        $(".rapor-tablo tbody tr").each(function () {
                            let $tr = $(this);
                            let rowNameRaw = $tr.find(".col-m-1").attr("data-row") || $tr.find(".col-row-total").attr("data-row");
                            if (!rowNameRaw) return; 

                            // Satır isminde "TOPLAM" geçiyorsa yüzdelikleri ekle (Alt toplamlar ve Genel Toplam)
                            let isTotalRow = rowNameRaw.toUpperCase().includes("TOPLAM");
                            
                            if (!isTotalRow) return;

                            let rowName = rowNameRaw.replace(/\*/g, "").trim();
                            let prevRow = prevDataMap[rowName];

                            if (prevRow) {
                                for (let i = 1; i <= 12; i++) {
                                    let $cell = $tr.find(".col-m-" + i);
                                    if ($cell.length > 0) {
                                        let currVal = parseFloat($cell.attr("data-val")) || 0;
                                        let prevVal = prevRow[monthProps[i]] || 0;
                                        injectPercentage($cell, currVal, prevVal);
                                    }
                                }

                                let $totalCell = $tr.find(".col-row-total");
                                if ($totalCell.length > 0) {
                                    let currTotal = parseFloat($totalCell.attr("data-val")) || 0;
                                    let prevTotal = prevRow.toplam || 0;
                                    injectPercentage($totalCell, currTotal, prevTotal);
                                }
                            }
                        });
                    }
                });
            }

            function injectPercentage($cell, currVal, prevVal) {
                if (currVal === 0 && prevVal === 0) return; 

                let perc = 0;
                if (prevVal === 0) {
                    perc = currVal > 0 ? 100 : -100;
                } else {
                    perc = ((currVal - prevVal) / Math.abs(prevVal)) * 100;
                }

                let badgeClass = perc > 0 ? 'yoy-up' : (perc < 0 ? 'yoy-down' : 'yoy-neutral');
                let icon = perc > 0 ? 'fa-arrow-up' : (perc < 0 ? 'fa-arrow-down' : 'fa-minus');
                let formattedPerc = Math.abs(perc).toLocaleString('tr-TR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

                let html = `<div class="yoy-badge ${badgeClass}"><i class="fas ${icon}"></i> %${formattedPerc}</div>`;
                $cell.append(html);
            }

            function formatMoney(val) {
                return val.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            // Alt Kisim Secili Satirlar Toplami - Grup ve Bayiler İçin Ayrı Hesaplanır
            if (!jsIsDovizli) {
                $(".select-all").change(function () {
                    let targetTable = "#" + $(this).data("target");
                    $(targetTable + " .row-checkbox").prop("checked", $(this).prop("checked"));
                    calculateGlobalSum();
                });

                $(document).on("change", ".row-checkbox", function () {
                    calculateGlobalSum();
                });

                function calculateGlobalSum() {
                    let grandTotal = 0;

                    // Grup İçi Toplam
                    if ($("#main-table-grup").length > 0) {
                        let grupMonthlySums = new Array(13).fill(0);
                        let grupSum = 0;
                        $("#main-table-grup .row-checkbox:checked").each(function () {
                            let $row = $(this).closest("tr");
                            for (let i = 1; i <= 12; i++) {
                                let valText = $row.find(".col-m-" + i).attr("data-val");
                                if (valText) grupMonthlySums[i] += parseLocaleNumber(valText); 
                            }
                            let rowTotalText = $row.find(".col-row-total").attr("data-val");
                            if (rowTotalText) grupSum += parseLocaleNumber(rowTotalText); 
                        });

                        for (let i = 1; i <= 12; i++) { 
                            $("#sum-m-" + i + "-grup").text(formatMoney(grupMonthlySums[i])); 
                        }
                        $("#sum-total-grup").text(formatMoney(grupSum));
                        grandTotal += grupSum;
                    }

                    // Bayiler Toplam
                    if ($("#main-table-bayi").length > 0) {
                        let bayiMonthlySums = new Array(13).fill(0);
                        let bayiSum = 0;
                        $("#main-table-bayi .row-checkbox:checked").each(function () {
                            let $row = $(this).closest("tr");
                            for (let i = 1; i <= 12; i++) {
                                let valText = $row.find(".col-m-" + i).attr("data-val");
                                if (valText) bayiMonthlySums[i] += parseLocaleNumber(valText); 
                            }
                            let rowTotalText = $row.find(".col-row-total").attr("data-val");
                            if (rowTotalText) bayiSum += parseLocaleNumber(rowTotalText); 
                        });

                        for (let i = 1; i <= 12; i++) { 
                            $("#sum-m-" + i + "-bayi").text(formatMoney(bayiMonthlySums[i])); 
                        }
                        $("#sum-total-bayi").text(formatMoney(bayiSum));
                        grandTotal += bayiSum;
                    }
                    
                    // Sağ Üst Köşe Genel Toplam
                    $("#sel-total").text(formatMoney(grandTotal));
                }

                function parseLocaleNumber(stringNumber) {
                    if (!stringNumber) return 0;
                    var cleaned = stringNumber.toString().replace(/\./g, '').replace(',', '.');
                    return parseFloat(cleaned) || 0;
                }
            }
        });
    </script>
}