    }
    #asistanButton:hover { transform: translateY(-3px) scale(1.05); }
    #asistanWindow { border-radius: var(--r-xl, 24px) !important; box-shadow: var(--shadow-lg) !important; overflow: hidden; }

    @@media (max-width: 767px) {
        .hero { padding: 1.4rem; }
        .hero-search { max-width: 100%; }
    }

</style>
<link rel="stylesheet" href="~/css/dashboard-komuta.css" asp-append-version="true" />

<div class="container-fluid py-2 px-xl-4">
    
    <!-- 1. KOMUTA MERKEZİ — karşılama -->
    <div class="hero">
        <span class="hero-orb a"></span>
        <span class="hero-orb b"></span>
        <canvas id="heroCanvas" class="hero-canvas" aria-hidden="true"></canvas>

        <div class="row align-items-center justify-content-between g-4 position-relative">
            <div class="col-xl-7 col-lg-6">
                <div class="d-flex align-items-center gap-3">
                    <div class="hero-avatar-ring"><div class="hero-avatar">@basHarfler</div></div>
                    <div>
                        <div class="hero-eyebrow"><span id="heroSaat" class="hero-saat">--:--:--</span> · @bugunMetni</div>
                        <h2 class="hero-title">@selamlama, <span>@displayName</span></h2>
                        <div class="hero-tagline" id="heroTagline"><span>Bugün hangi rapora bakıyoruz?</span></div>
                    </div>
                </div>

                <div class="chip-row">
                    <span class="chip"><i class="fas fa-building"></i> @currentDbDisplay</span>
                    <span class="chip"><i class="fas fa-chart-pie"></i> <b class="sayac" data-hedef="@totalAllowedReports">0</b>&nbsp;rapor</span>
                    <span class="chip"><i class="fas fa-layer-group"></i> <b class="sayac" data-hedef="@kategoriSayisi">0</b>&nbsp;kategori</span>
                </div>
            </div>

            <div class="col-xl-5 col-lg-6 d-flex flex-column align-items-lg-end gap-3">
                <div class="hero-search">
                    <i class="fas fa-search s-ico"></i>
                    <input type="text" id="dashboardSearch" autocomplete="off" placeholder="Rapor veya ekran arayın...">
                    <span class="s-hint">/</span>
                </div>
                <div class="hero-kpis">
                    <div class="hero-kpi"><i class="fas fa-money-check-alt"></i><div><b id="hk-portfoy">…</b><span>Portföy çek</span></div></div>
                    <div class="hero-kpi"><i class="fas fa-clipboard-list"></i><div><b id="hk-bekleyen">…</b><span>Bekleyen işlem</span></div></div>
                    <div class="hero-kpi"><i class="fas fa-percent"></i><div><b id="hk-kdv">…</b><span>KDV durumu</span></div></div>
                </div>
            </div>
        </div>

    </div>

    <!-- 2. ÜST GRAFİKLER (FATURA, AÇIK BELGE, KDV, CARİ, PORTFÖY) -->
    <div class="row g-4 mb-4" id="dashboardChartsTop">
        
        <!-- Fatura Analizi (Çizgi Grafik) -->
        <div class="col-xl-8 col-lg-12">
            <div class="dashboard-chart-card">
                <div class="chart-header">
                    <h3><i class="fas fa-chart-area"></i> Fatura & İrsaliye Analizi (Net)</h3>
                    <div class="badge badge-light-primary fw-bolder px-3 py-2" style="background:var(--metro-primary-light); color:var(--metro-primary)">Bu Yıl</div>
                </div>
                <div id="faturaChart"></div>
            </div>
        </div>

        <!-- Açık Belgeler (Donut Grafik) -->
        <div class="col-xl-4 col-lg-6">
            <div class="dashboard-chart-card">
                <div class="chart-header">
                    <h3><i class="fas fa-chart-pie"></i> Bekleyen Açık Belgeler</h3>
                </div>
                <div id="acikBelgeChart" class="d-flex justify-content-center mt-3"></div>
            </div>
        </div>

        <!-- KDV Durumu (Bar Grafik) -->
        <div class="col-xl-4 col-lg-6">
            <div class="dashboard-chart-card">
                <div class="chart-header">
                    <h3><i class="fas fa-percent"></i> KDV Durumu (Rpr 67)</h3>
                </div>
                <div id="kdvChart" class="mt-2"></div>
                <div class="text-center mt-2">
                    <span class="fw-bolder fs-5 text-primary" id="kdvNetText">Yükleniyor...</span>
                    <div class="text-muted small fw-bold">Özet Durum</div>
                </div>
            </div>
        </div>

        <!-- Aktif Cari & Portföy Çek (Radial & Widget Karma) -->
        <div class="col-xl-8 col-lg-12">
            <div class="row g-4 h-100">
                <div class="col-md-6">
                    <div class="dashboard-chart-card d-flex flex-column justify-content-center align-items-center">
                        <div class="chart-header w-100 mb-0">
                            <h3><i class="fas fa-users"></i> Aktif Cari (Son 1 Yıl)</h3>
                        </div>
                        <div id="cariRadialChart" class="w-100 d-flex justify-content-center mt-2"></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex flex-column gap-4 h-100">
                        <div class="dashboard-widget flex-fill">
                            <div class="widget-icon widget-warning"><i class="fas fa-money-check-alt"></i></div>
                            <div class="widget-info">
                                <h4 id="w-portfoy">Yükleniyor...</h4>
                                <span id="w-portfoy-title">Portföydeki Çek (Rpr 2)</span>
                            </div>
                        </div>
                        <div class="dashboard-widget flex-fill">
                            <div class="widget-icon widget-danger"><i class="fas fa-clipboard-list"></i></div>
                            <div class="widget-info">
                                <h4 id="w-bekleyen">Yükleniyor...</h4>
                                <span id="w-bekleyen-title">Bekleyen Cari Not (Rpr 133)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. DİNAMİK OLARAK GELEN TÜM RAPORLAR LİSTESİ -->
    <div class="section-head">
        <h4>Raporlar &amp; Hızlı Erişim</h4>
        <span class="line"></span>
        <span class="text-muted" style="font-size:.8rem; font-weight:600;">@totalAllowedReports ekran</span>
    </div>

    @if (Model != null && Model.RaporGruplari != null && Model.RaporGruplari.Any())
    {
        <div class="category-filters mt-4">
            <button class="category-pill active" data-group="all">Tümü</button>
            @foreach (var grup in Model.RaporGruplari.Keys)
            {
                <button class="category-pill" data-group="@grup">@grup</button>
            }
        </div>
    }

    <div id="reportsContainer">
        @if (Model != null && Model.RaporGruplari != null && Model.RaporGruplari.Any())
        {
            @foreach (var grup in Model.RaporGruplari)
            {
                string groupIcon = grup.Key switch
                {
                    "Finans" => "fa-coins", "Satış" => "fa-shopping-cart", "Muhasebe" => "fa-calculator",
                    "Cari Yönetimi" => "fa-users", "Satınalma" => "fa-truck-loading", "Üretim" => "fa-industry",
                    "İthalat/İhracat" => "fa-globe", "Stok & Ürün" => "fa-boxes", "Aktarım İşlemleri" => "fa-robot",
                    _ => "fa-folder-open"
                };

                <div class="report-group-section" data-group-name="@grup.Key">
                    <div class="group-header">
                        <i class="fas @groupIcon group-icon"></i>
                        <h5>@grup.Key</h5>
                    </div>
                    <div class="row g-4">
                        @foreach (var rapor in grup.Value)
                        {
                            <div class="col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-sm-12 report-item-col" style="animation-delay: @(new Random().Next(0, 4) * 0.1)s;">
                                <a href="@Url.Action(rapor.ActionName, rapor.ControllerName)" class="report-card" data-controller="@rapor.ControllerName">
                                    <span class="menu-rozet" data-controller="@rapor.ControllerName" hidden></span>
                                    <div class="card-icon-wrapper"><i class="@rapor.Icon"></i></div>
                                    <div class="card-content-wrapper">
                                        <div class="card-title">@rapor.MenuTitle</div>
                                        <div class="card-action">Hemen Görüntüle <i class="fas fa-arrow-right ms-2 mt-1 fs-8"></i></div>
                                    </div>
                                    <!-- Hover Preview Skeleton -->
                                    <div class="report-preview-tooltip">
                                        <div class="text-center text-primary fw-bolder mb-2 border-bottom border-primary pb-1" style="font-size:10px;">@rapor.MenuTitle Önizlemesi</div>
                                        <div class="skeleton-header">
                                            <div class="skeleton-col"></div><div class="skeleton-col"></div><div class="skeleton-col"></div>
                                        </div>
                                        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
                                        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
                                        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <div class="mb-4 mt-5">
                    <span class="fa-stack fa-4x text-muted">
                        <i class="fas fa-circle fa-stack-2x opacity-10"></i><i class="fas fa-lock fa-stack-1x opacity-50"></i>
                    </span>
                </div>
                <h3 class="text-muted fw-bold">Rapor Bulunamadı</h3>
                <p class="text-muted fs-5">Yetkiniz dahilinde görüntülenebilecek ekran bulunmuyor.</p>
            </div>
        }
    </div>

    <div id="noResultsMessage" class="text-center py-5 d-none">
        <div class="mb-4 mt-5">
            <span class="fa-stack fa-4x text-muted">
                <i class="fas fa-circle fa-stack-2x opacity-10"></i><i class="fas fa-search fa-stack-1x opacity-50"></i>
            </span>
        </div>
        <h3 class="text-muted fw-bold">Sonuç Bulunamadı</h3>
        <p class="text-muted fs-5">"<span id="searchTextDisplay" class="fw-bold" style="color:var(--text-primary)"></span>" aramasına uygun kayıt yok.</p>
        <button class="btn btn-primary mt-3 rounded-pill px-5 py-2 fw-bold" onclick="clearSearch()">Aramayı Temizle</button>
    </div>
</div>

<!-- Yapay Zeka Asistanı -->
<div id="asistanContainer">
    <button id="asistanButton" onclick="toggleAsistan()" title="Yapay Zeka Asistanı">
        <i class="fas fa-sparkles"></i>
    </button>

    <div id="asistanWindow">
        <div class="asistan-header">
            <h6><i class="fas fa-robot fs-5"></i> Finans AI Asistan</h6>
            <i class="fas fa-times" style="cursor:pointer; font-size:1.3rem;" onclick="toggleAsistan()"></i>
        </div>

        <div id="chatBox">
            <div class="msg msg-ai">
                <span class="ai-badge">ASİSTAN</span>
                Merhaba <b>@displayName</b>, raporlar ve veriler hakkında sormak istediğin bir şey var mı?
                <div class="suggested-questions">
                    <button class="suggested-btn" onclick="askQuick('En borçlu müşteri kim?')">Cari Analizi</button>
                    <button class="suggested-btn" onclick="askQuick('Bu haftaki ciro durumu nedir?')">Ciro Durumu</button>
                </div>
            </div>
        </div>

        <div class="asistan-input-area">
            <input type="text" id="txtSoru" class="asistan-input" placeholder="Yapay zekaya sorun..." onkeydown="if(event.key==='Enter') sendQuestion()">
            <button class="btn-send" onclick="sendQuestion()">
                <i class="fas fa-paper-plane fs-5"></i>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <!-- ApexCharts Library -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            
            /* --- GRAFİKLERİ BAŞLAT (BOS DURUM) --- */

            // 1. Fatura Grafiği (Line/Area)
            var faturaOptions = {
                series: [], // Veriler ajax ile gelecek
                chart: { height: 320, type: 'area', fontFamily: 'Inter, sans-serif', toolbar: { show: false }, dropShadow: { enabled: true, top: 10, left: 0, blur: 12, opacity: .16, color: '#2563eb' } },
                colors: ['#2563eb', '#0ea5e9'],
                dataLabels: { enabled: false },
                stroke: { curve: 'smooth', width: 3, lineCap: 'round' },
                markers: { size: 0, hover: { size: 6 } },
                tooltip: { theme: 'light' },
                xaxis: { categories: ["Oca", "Şub", "Mar", "Nis", "May", "Haz", "Tem", "Ağu", "Eyl", "Eki", "Kas", "Ara"], labels: { style: { colors: 'var(--text-secondary)' } }, axisBorder: { show: false } },
                yaxis: { labels: { style: { colors: 'var(--text-secondary)' }, formatter: function (value) { return value.toLocaleString('tr-TR') + " ₺"; } } },
                grid: { borderColor: 'var(--border-color)', strokeDashArray: 4 },
                fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.4, opacityTo: 0.05, stops: [0, 90, 100] } },
                legend: { position: 'top', horizontalAlign: 'right', labels: { colors: 'var(--text-primary)' } },
                noData: { text: 'Yükleniyor...', style: { color: 'var(--text-secondary)', fontSize: '15px' } }
            };
            var faturaChart = new ApexCharts(document.querySelector("#faturaChart"), faturaOptions);
            faturaChart.render();

            // 2. Açık Belgeler (Donut)
            var acikBelgeOptions = {
                series: [],
                chart: { type: 'donut', height: 280, fontFamily: 'Inter, sans-serif' },
                labels: [],
                colors: ['#0b3d91', '#2563eb', '#7dd3fc'],
                stroke: { show: true, width: 4, colors: ['#ffffff'] }, dataLabels: { enabled: false },
                legend: { position: 'bottom', labels: { colors: 'var(--text-primary)' }, markers: { radius: 4 } },
                plotOptions: { pie: { expandOnClick: false, donut: { size: '76%', labels: { show: true, name: { show: true, color: 'var(--text-secondary)', fontSize: '12px' }, value: { show: true, color: 'var(--text-primary)', fontSize: '22px', fontWeight: 800 }, total: { show: true, label: 'Toplam', color: 'var(--text-secondary)', fontWeight: 700 } } } } },
                noData: { text: 'Yükleniyor...', style: { color: 'var(--text-secondary)' } }
            };
            var acikBelgeChart = new ApexCharts(document.querySelector("#acikBelgeChart"), acikBelgeOptions);
            acikBelgeChart.render();

            // 3. KDV Durumu (Bar)
            var kdvOptions = {
                series: [{ name: 'KDV Tutar', data: [] }],
                chart: { type: 'bar', height: 230, fontFamily: 'Inter, sans-serif', toolbar: { show: false } },
                plotOptions: { bar: { borderRadius: 10, borderRadiusApplication: 'end', columnWidth: '38%', distributed: true } },
                colors: ['#94a3b8', '#2563eb', '#0b3d91'], // Devreden, İndirilecek, Hesaplanan
                dataLabels: { enabled: true, offsetY: -22, style: { fontSize: '11px', fontWeight: 700, colors: ['#334155'] }, background: { enabled: false }, formatter: function (v) { return (v / 1000).toLocaleString('tr-TR', { maximumFractionDigits: 0 }) + ' K'; } },
                legend: { show: false },
                xaxis: { categories: ['İndirilecek(191)', 'Hesaplanan(391)', 'Net KDV'], labels: { style: { colors: 'var(--text-secondary)', fontSize: '11px', fontWeight: 600 } }, axisBorder:{show:false} },
                yaxis: { labels: { show: false } }, // Rakamları üstte yazacağımız için y eksenini gizledik
                grid: { show: false },
                noData: { text: 'Yükleniyor...', style: { color: 'var(--text-secondary)' } }
            };
            var kdvChart = new ApexCharts(document.querySelector("#kdvChart"), kdvOptions);
            kdvChart.render();

            // 4. Aktif Cari (Radial Bar)
            var cariRadialOptions = {
                series: [0, 0],
                chart: { height: 280, type: 'radialBar', fontFamily: 'Inter, sans-serif' },
                plotOptions: {
                    radialBar: {
                        dataLabels: {
                            name: { fontSize: '14px', color: 'var(--text-secondary)' },
                            value: { fontSize: '20px', color: 'var(--text-primary)', fontWeight: 700, formatter: function (val) { return val } },
                            total: { show: true, label: 'Toplam', color: 'var(--text-primary)', formatter: function (w) { return w.globals.seriesTotals.reduce((a, b) => { return a + b }, 0) } }
                        }
                    }
                },
                labels: ['Müşteri', 'Tedarikçi'],
                colors: ['#2563eb', '#0ea5e9'],
                fill: { type: 'gradient', gradient: { shade: 'light', type: 'horizontal', shadeIntensity: .4, gradientToColors: ['#7dd3fc', '#93c5fd'], opacityFrom: 1, opacityTo: 1 } },
                stroke: { lineCap: 'round' }
            };
            var cariRadialChart = new ApexCharts(document.querySelector("#cariRadialChart"), cariRadialOptions);
            cariRadialChart.render();

            /* --- AJAX İLE VERİ ÇEKME VE GRAFİKLERİ DOLDURMA --- */
            fetch('/Home/GetDashboardData')
                .then(response => response.json())
                .then(data => {
                    if(data.success) {
                        // Örnek veri ucu (HomeController.GetDashboardData) düz alanlar döner: satisAylik, alimAylik, acikSiparis/Teslimat/Fatura,
                        // netKdv, hesaplananKdv, indirilecekKdv, aktifMusteri, aktifTedarikci, portfoyCekTutar/Adet, bekleyenIslem.
                        const para = v => (Number(v) || 0).toLocaleString('tr-TR', { maximumFractionDigits: 0 }) + ' ₺';

                        // 1. Fatura Grafiği Güncelle (Satış vs Alış)
                        faturaChart.updateSeries([
                            { name: 'Net Satış', data: data.satisAylik || [] },
                            { name: 'Net Alım', data: data.alimAylik || [] }
                        ]);

                        // 2. Açık Belgeler Güncelle
                        acikBelgeChart.updateOptions({
                            series: [data.acikSiparis || 0, data.acikTeslimat || 0, data.acikFatura || 0],
                            labels: ['Açık Sipariş', 'Açık Teslimat', 'Açık Fatura']
                        });

                        // 3. KDV Bar Grafiği
                        kdvChart.updateSeries([{ name: 'Tutar', data: [data.indirilecekKdv || 0, data.hesaplananKdv || 0, data.netKdv || 0] }]);
                        document.getElementById("kdvNetText").innerText = para(data.netKdv);
                        document.getElementById("kdvNetText").nextElementSibling.innerText = (data.netKdv || 0) >= 0 ? 'Ödenecek Net KDV' : 'Devreden KDV';

                        // 4. Cari Radial Bar Güncelle
                        cariRadialChart.updateSeries([Number(data.aktifMusteri) || 0, Number(data.aktifTedarikci) || 0]);

                        // 5. Normal Widget'ları Güncelle
                        document.getElementById("w-portfoy").innerText = para(data.portfoyCekTutar);
                        document.getElementById("w-portfoy-title").innerText = "Portföyde " + (data.portfoyCekAdet || 0) + " Çek (Rpr 2)";

                        document.getElementById("w-bekleyen").innerText = (data.bekleyenIslem || 0) + " İşlem";
                        document.getElementById("w-bekleyen-title").innerText = "Bekleyen Cari Not (Rpr 133)";

                    } else {
                        toastr.error(data.message || "Dashboard verileri alınamadı.");
                    }
                })
                .catch(error => console.error("Dashboard Fetch Hatası: ", error));


            /* --- KATEGORİ PİLL FİLTRELEME & ARAMA MANTIĞI --- */
            const categoryPills = document.querySelectorAll('.category-pill');
            const groupSections = document.querySelectorAll('.report-group-section');
            const searchInput = document.getElementById('dashboardSearch');
            const reportCols = document.querySelectorAll('.report-item-col');
            const noResultsMsg = document.getElementById('noResultsMessage');
            const reportsContainer = document.getElementById('reportsContainer');
            const dashChartsTop = document.getElementById('dashboardChartsTop');

            /* "/" tuşu ile arama kutusuna odaklan, Esc ile çık */
            document.addEventListener('keydown', function (e) {
                var aktif = document.activeElement;
                var yaziAlaninda = aktif && /^(INPUT|TEXTAREA|SELECT)$/.test(aktif.tagName || '');

                if (e.key === '/' && !yaziAlaninda && searchInput) {
                    e.preventDefault();
                    searchInput.focus();
                    searchInput.select();
                }
                if (e.key === 'Escape' && searchInput && aktif === searchInput) {
                    searchInput.blur();
                }
            });

            function toggleDashboardTop(show) {
                if(show) { dashChartsTop.style.display = ''; } 
                else { dashChartsTop.style.display = 'none'; }
            }

            categoryPills.forEach(pill => {
                pill.addEventListener('click', function() {
                    categoryPills.forEach(p => p.classList.remove('active'));
                    this.classList.add('active');
                    
                    const targetGroup = this.dataset.group;
                    if(searchInput) searchInput.value = '';

                    toggleDashboardTop(targetGroup === 'all');

                    groupSections.forEach(section => {
                        const sectionName = section.dataset.groupName;
                        if(targetGroup === 'all' || sectionName === targetGroup) {
                            section.style.display = '';
                            section.querySelectorAll('.report-item-col').forEach(col => col.style.display = '');
                        } else {
                            section.style.display = 'none';
                        }
                    });

                    reportsContainer.classList.remove('d-none');
                    noResultsMsg.classList.add('d-none');
                });
            });

            if (searchInput) {
                searchInput.addEventListener('keyup', function(e) {
                    const searchText = e.target.value.toLocaleLowerCase('tr-TR').trim();
                    let hasAnyResult = false;
                    
                    categoryPills.forEach(p => p.classList.remove('active'));
                    document.querySelector('.category-pill[data-group="all"]')?.classList.add('active');

                    toggleDashboardTop(searchText === "");

                    reportCols.forEach(col => {
                        const cardTitle = col.querySelector('.card-title').textContent.toLocaleLowerCase('tr-TR');
                        if (cardTitle.includes(searchText)) {
                            col.style.display = '';
                            hasAnyResult = true;
                        } else {
                            col.style.display = 'none';
                        }
                    });

                    groupSections.forEach(section => {
                        const visibleCards = section.querySelectorAll('.report-item-col:not([style*="display: none"])');
                        section.style.display = visibleCards.length > 0 ? '' : 'none';
                    });

                    if (!hasAnyResult && searchText !== "") {
                        reportsContainer.classList.add('d-none');
                        noResultsMsg.classList.remove('d-none');
                        document.getElementById('searchTextDisplay').textContent = e.target.value;
                    } else {
                        reportsContainer.classList.remove('d-none');
                        noResultsMsg.classList.add('d-none');
                    }
                });
            }
        });

        /* --- GLOBAL FONKSİYONLAR --- */
        function clearSearch() {
            const searchInput = document.getElementById('dashboardSearch');
            if (searchInput) { searchInput.value = ''; searchInput.dispatchEvent(new Event('keyup')); searchInput.focus(); }
        }

        /* --- ASİSTAN MANTIĞI --- */
        function toggleAsistan() {
            const win = document.getElementById('asistanWindow');
            if (win) {
                win.classList.toggle('active');
                if(win.classList.contains('active')) { setTimeout(() => { const input = document.getElementById('txtSoru'); if(input) input.focus(); }, 300); }
            }
        }

        function askQuick(text) {
            const input = document.getElementById('txtSoru');
            if (input) { input.value = text; sendQuestion(); }
        }

        async function sendQuestion() {
            const input = document.getElementById("txtSoru");
            const soru = input.value.trim();
            if (!soru) return;

            const chatBox = document.getElementById("chatBox");
            chatBox.innerHTML += `<div class="msg msg-user">${soru}</div>`;
            input.value = "";
            chatBox.scrollTop = chatBox.scrollHeight;

            const loadingId = "load-" + Date.now();
            chatBox.innerHTML += `<div id="${loadingId}" class="msg msg-ai"><span class="ai-badge">SİSTEM</span><i class="fas fa-circle-notch fa-spin me-1"></i> Yanıt hazırlanıyor...</div>`;
            chatBox.scrollTop = chatBox.scrollHeight;

            const formData = new FormData();
            formData.append('soru', soru);

            try {
                const res = await fetch('/YapayZeka/Sor', { method: 'POST', body: formData });
                const loadingEl = document.getElementById(loadingId);
                if(loadingEl) loadingEl.remove();

                if (res.ok) {
                    const data = await res.json();
                    chatBox.innerHTML += `<div class="msg msg-ai"><span class="ai-badge">ASİSTAN</span>${data.cevap}</div>`;
                } else {
                    chatBox.innerHTML += `<div class="msg msg-ai text-danger"><span class="ai-badge" style="color:var(--metro-danger)">HATA</span>Sunucudan yanıt alınamadı.</div>`;
                }
            } catch (err) {
                const loadingEl = document.getElementById(loadingId);
                if(loadingEl) loadingEl.remove();
                chatBox.innerHTML += `<div class="msg msg-ai text-danger"><span class="ai-badge" style="color:var(--metro-danger)">HATA</span>Bağlantı hatası oluştu.</div>`;
            }
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    </script>
    <script src="~/js/dashboard-komuta.js" asp-append-version="true"></script>
}