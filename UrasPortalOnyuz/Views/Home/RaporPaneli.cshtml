    .category-pill {
        padding: .5rem 1.1rem; border-radius: 999px; font-size: .84rem; font-weight: 600;
        box-shadow: none; background: var(--bg-card); border: 1px solid var(--border-color);
        transition: all .2s var(--ease, ease);
