            linear-gradient(90deg, rgba(15,23,42,.035) 1px, transparent 1px);
        background-size: 46px 46px;
        mask-image: radial-gradient(700px 380px at 22% 0%, #000 10%, transparent 72%);
        -webkit-mask-image: radial-gradient(700px 380px at 22% 0%, #000 10%, transparent 72%);
    }
    .hero-orb {
        /* Bulanık küreler statik: blur + sonsuz animasyon her karede yeniden rasterize edilip kaydırmayı yavaşlatıyordu */
        position: absolute; border-radius: 50%; filter: blur(46px); pointer-events: none; z-index: -1;
        transform: translateZ(0); will-change: transform;
    }
    .hero-orb.a { width: 320px; height: 320px; top: -110px; right: 16%; background: rgba(37,99,235,.16); }
    .hero-orb.b { width: 260px; height: 260px; bottom: -130px; left: 26%; background: rgba(168,85,247,.13); animation-delay: -6s; }
    @@keyframes orbFloat {
        from { transform: translate3d(0,0,0) scale(1); }
        to   { transform: translate3d(28px,-22px,0) scale(1.12); }
