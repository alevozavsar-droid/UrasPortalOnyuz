        box-shadow: 0 0 0 4px rgba(37,99,235,.22);
    }
    .hero-search .s-ico { position: absolute; left: 19px; top: 50%; transform: translateY(-50%); color: var(--text-secondary, #9aa1b1); }
    .hero-search .s-hint {
        position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
