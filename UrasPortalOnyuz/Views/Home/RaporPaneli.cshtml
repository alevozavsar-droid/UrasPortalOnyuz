    .category-pill:hover { background: var(--metro-primary-light); color: var(--metro-primary); border-color: color-mix(in srgb, var(--metro-primary) 32%, transparent); transform: none; }
    .category-pill.active {
        background: linear-gradient(135deg,#2563eb,#0ea5e9); color: #fff; border-color: transparent;
        box-shadow: 0 6px 16px rgba(37,99,235,.28);
