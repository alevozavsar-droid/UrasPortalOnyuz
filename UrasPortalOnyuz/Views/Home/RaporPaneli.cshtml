@model WebApplication3.Controllers.HomeIndexViewModel
@using System.Security.Claims
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Configuration
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Rapor Paneli";   // eski ana sayfa; raporlar Grup ERP menü yerleşimine (modüllere) göre gruplanır

    // ---------------------------------------------------------
    // 0. KULLANICI ADINI SAP B1 (OUSR TABLOSU) ÜZERİNDEN DİNAMİK ÇEKME
    // ---------------------------------------------------------
    string currentUserCode = User.Identity?.Name ?? "";
    string displayName = currentUserCode;
    var cookieDb = Context.Request.Cookies["SelectedDatabase"] ?? "DefaultConnection";

    displayName = WebApplication3.Data.OrnekVeri.KullaniciAdi(currentUserCode);   // ON YUZ ORNEGI

    var dbList = new Dictionary<string, string> {
        {"DefaultConnection", "URASKIMYA"}, {"DefaultConnection1", "URSMAKINE"}, {"DefaultConnection2", "AVRUPA_PAPER"},
        {"DefaultConnection3", "ALV_KIMYA"}, {"DefaultConnection4", "DAF_KIMYA"}, {"DefaultConnection5", "SELVI"},
        {"DefaultConnection6", "ALVFILO"}, {"DefaultConnection19", "DRN"}, {"DefaultConnection8", "ASIA"},
        {"DefaultConnection9", "DEKORLIM"}, {"DefaultConnection10", "URAS_HOLDING"}, {"DefaultConnection11", "TestUrasKimya"},
        {"DefaultConnection7", "Avrasya"}, {"DefaultConnection12", "URSMAKINE_2026"}, {"DefaultConnection13", "ALVKIMYA_2026"},
        {"DefaultConnection20", "ALVKIMYA_2026"}, {"DefaultConnection21", "URSMAKINE_2026"}, {"DefaultConnection22", "SELVI_2026"}
    };
    string currentDbDisplay = WebApplication3.Data.OrnekVeri.SirketAdi(cookieDb);

    // ---------------------------------------------------------
    // 1. DİNAMİK OLARAK GELEN RAPORLARIN TOPLAM SAYISINI BUL
    // ---------------------------------------------------------
    int totalAllowedReports = Model?.RaporGruplari?.Sum(g => g.Value.Count) ?? 0;
    int kategoriSayisi = Model?.RaporGruplari?.Count ?? 0;

    // ---------------------------------------------------------
    // 2. SELAMLAMA / AVATAR / TARİH
    // ---------------------------------------------------------
    var saat = DateTime.Now.Hour;
    string selamlama = saat < 6 ? "İyi geceler" : saat < 12 ? "Günaydın" : saat < 18 ? "İyi günler" : "İyi akşamlar";

    var adParcalari = (displayName ?? "").Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
    string basHarfler = adParcalari.Length >= 2
        ? (adParcalari[0].Substring(0, 1) + adParcalari[1].Substring(0, 1)).ToUpper()
        : (string.IsNullOrWhiteSpace(displayName) ? "?" : displayName.Trim().Substring(0, Math.Min(2, displayName.Trim().Length)).ToUpper());

    var trKultur = new System.Globalization.CultureInfo("tr-TR");
    string bugunMetni = DateTime.Now.ToString("dd MMMM yyyy dddd", trKultur);
}

<style>
    /* ========================================
       AFİLLİ GRAFİKLİ DASHBOARD CSS (GLASSMORPHISM)
       ======================================== */
    .welcome-banner {
        background: linear-gradient(135deg, #0b3d91 0%, #1e3a8a 100%);
        border-radius: 1.25rem; padding: 2.5rem; color: #ffffff;
        margin-bottom: 2rem; position: relative; overflow: hidden; box-shadow: var(--shadow-md);
    }
    .welcome-banner::before {
        content: ''; position: absolute; top: -20%; left: -10%; width: 250px; height: 250px;
        background: radial-gradient(circle, rgba(37,99,235, 0.4) 0%, rgba(255,255,255,0) 70%);
        border-radius: 50%; filter: blur(30px); pointer-events: none;
    }
    .welcome-banner::after {
        content: ''; position: absolute; bottom: -30%; right: -5%; width: 350px; height: 350px;
        background: radial-gradient(circle, rgba(14,165,233, 0.3) 0%, rgba(255,255,255,0) 70%);
        border-radius: 50%; filter: blur(40px); pointer-events: none;
    }

    .stat-badge {
        background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1); padding: 0.65rem 1.25rem; border-radius: 0.75rem;
        display: inline-flex; align-items: center; gap: 10px; font-size: 0.95rem; font-weight: 600; box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .search-container { position: relative; max-width: 100%; width: 380px; z-index: 10; }
    .search-input {
        padding-left: 50px; border-radius: 0.75rem; border: 1px solid rgba(255, 255, 255, 0.15);
        background-color: rgba(255, 255, 255, 0.05); backdrop-filter: blur(5px);
        color: #ffffff; height: 55px; font-size: 1rem; font-weight: 500; transition: all 0.3s ease;
    }
    .search-input::placeholder { color: rgba(255, 255, 255, 0.5); }
    .search-input:focus {
        background-color: var(--bg-card); color: var(--text-primary); border-color: var(--metro-primary);
        box-shadow: 0 0 0 4px rgba(37,99,235, 0.2); outline: none;
    }
    .search-input:focus + .search-icon { color: var(--metro-primary); }
    .search-icon { position: absolute; left: 20px; top: 50%; transform: translateY(-50%); color: rgba(255, 255, 255, 0.5); font-size: 1.1rem; transition: color 0.3s ease; }

    /* DASHBOARD GRAFİK KARTLARI */
    .dashboard-chart-card {
        background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 1.25rem;
        padding: 1.5rem; box-shadow: var(--shadow-sm); height: 100%; position: relative; overflow: hidden;
        transition: transform 0.3s ease;
    }
    .dashboard-chart-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }
    
    .chart-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .chart-header h3 { margin: 0; font-size: 1.1rem; font-weight: 700; color: var(--text-primary); display: flex; align-items:center; gap: 8px;}
    .chart-header h3 i { color: var(--metro-primary); }

    /* WIDGET KARTLARI */
    .dashboard-widget {
        background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 1rem;
        padding: 1.25rem; display: flex; align-items: center; box-shadow: var(--shadow-sm);
        transition: all 0.3s ease; position: relative; overflow: hidden;
    }
    .dashboard-widget:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); border-color: var(--metro-primary); }
    .widget-icon { width: 55px; height: 55px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; margin-right: 1.25rem; flex-shrink: 0; }
    
    .widget-info h4 { margin: 0; font-size: 1.3rem; font-weight: 700; color: var(--text-primary); letter-spacing: -0.5px; }
    .widget-info span { font-size: 0.85rem; color: var(--text-secondary); font-weight: 600; }

    /* Rapor Kategori Filtreleri */
    .category-filters { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 15px; margin-bottom: 1.5rem; scrollbar-width: none; }
    .category-filters::-webkit-scrollbar { display: none; }
    .category-pill {
        background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-secondary);
        padding: 0.65rem 1.5rem; border-radius: 2rem; font-size: 0.9rem; font-weight: 600;
        cursor: pointer; white-space: nowrap; transition: all 0.2s ease; box-shadow: var(--shadow-sm);
    }
    .category-pill:hover { background: var(--input-bg); color: var(--metro-primary); transform: translateY(-2px); }
    .category-pill.active { background: var(--metro-primary-gradient); border-color: transparent; color: #ffffff; box-shadow: var(--metro-glow); }

    /* Rapor Kartları (Hover Preview Destekli) */
    .report-card {
        background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 1rem;
        padding: 1.5rem; height: 100%; display: flex; align-items: flex-start; text-align: left;
        text-decoration: none !important; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: var(--shadow-sm); position: relative; overflow: visible; /* Önizleme taşabilsin diye visible */
        border-left: 4px solid transparent; animation: fadeIn 0.5s ease forwards;
    }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
    .report-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); border-left-color: var(--metro-primary); background-color: var(--bg-main); z-index: 10;}
    
    .card-icon-wrapper {
        width: 50px; height: 50px; border-radius: 0.65rem; background: var(--input-bg);
        display: flex; align-items: center; justify-content: center; font-size: 1.35rem;
        color: var(--text-secondary); margin-right: 1.25rem; transition: all 0.3s ease; flex-shrink: 0;
    }
    .report-card:hover .card-icon-wrapper { background: var(--metro-primary-light); color: var(--metro-primary); transform: scale(1.1) rotate(5deg); }
    .card-content-wrapper { display: flex; flex-direction: column; justify-content: center; height: 100%; }
    .card-title { font-weight: 700; color: var(--text-primary); font-size: 0.95rem; margin-bottom: 0.35rem; line-height: 1.3; }
    .card-action { font-size: 0.8rem; color: var(--text-muted); font-weight: 600; display: flex; align-items: center; transition: color 0.3s; }
    .report-card:hover .card-action { color: var(--metro-primary); }

    /* MİNİ RAPOR ÖNİZLEME (TOOLTIP SKELETON) */
    .report-preview-tooltip {
        position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%) translateY(15px);
        width: 240px; background: var(--bg-card); border: 1px solid var(--border-color);
        border-radius: 0.75rem; padding: 15px; box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        opacity: 0; visibility: hidden; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        z-index: 100; pointer-events: none;
    }
    .report-preview-tooltip::after {
        content: ''; position: absolute; top: 100%; left: 50%; margin-left: -8px;
        border-width: 8px; border-style: solid;
        border-color: var(--bg-card) transparent transparent transparent;
    }
    .report-card:hover .report-preview-tooltip { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(-10px); }
    
    .skeleton-header { width: 100%; height: 15px; background: var(--input-bg); border-radius: 4px; margin-bottom: 10px; display:flex; gap:5px;}
    .skeleton-col { flex:1; height:100%; background: var(--metro-primary-light); border-radius:3px; }
    .skeleton-row { width: 100%; height: 10px; background: var(--border-color); border-radius: 3px; margin-bottom: 8px; display:flex; gap:5px;}
    .skeleton-cell { flex:1; height:100%; background: var(--input-bg); border-radius:2px; }

    /* Asistan Chat */
    #asistanContainer { position: fixed; bottom: 35px; right: 35px; z-index: 1050; }
    #asistanButton {
        width: 65px; height: 65px; border-radius: 50%; background: var(--metro-primary-gradient);
        color: white; border: none; box-shadow: var(--metro-glow); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 26px; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    #asistanButton:hover { transform: scale(1.1) rotate(15deg); box-shadow: 0 15px 35px rgba(37,99,235, 0.6); }
    #asistanWindow {
        position: absolute; bottom: 90px; right: 0; width: 400px; max-height: 650px; height: 75vh;
        background: var(--bg-card); border-radius: 1rem; box-shadow: var(--shadow-md);
        display: flex; flex-direction: column; overflow: hidden; transform: scale(0); transform-origin: bottom right;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); opacity: 0; pointer-events: none; border: 1px solid var(--border-color);
    }
    #asistanWindow.active { transform: scale(1); opacity: 1; pointer-events: all; }
    .asistan-header { background: var(--metro-primary-gradient); color: white; padding: 20px 25px; display: flex; align-items: center; justify-content: space-between; }
    .asistan-header h6 { margin: 0; font-weight: 700; display: flex; align-items: center; gap: 10px; font-size: 1.1rem; }
    #chatBox { flex: 1; overflow-y: auto; padding: 25px; background: var(--bg-main); scroll-behavior: smooth; }
    .asistan-input-area { padding: 20px; background: var(--bg-card); border-top: 1px solid var(--border-color); display: flex; gap: 10px; }
    .asistan-input { border-radius: 0.75rem; border: 1px solid var(--border-color); padding: 12px 20px; flex: 1; font-size: 0.95rem; transition: 0.3s; background: var(--input-bg); color: var(--text-primary); font-weight: 500; }
    .asistan-input:focus { outline: none; background: var(--bg-card); border-color: var(--metro-primary); box-shadow: 0 0 0 4px rgba(37,99,235,0.15); }
    .btn-send { background: var(--metro-primary); color: white; border: none; width: 50px; height: 50px; border-radius: 0.75rem; transition: 0.3s; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(37,99,235,0.3); }
    .btn-send:hover { background: var(--metro-primary-active); transform: translateY(-2px); }
    .msg { margin-bottom: 20px; max-width: 85%; padding: 15px 20px; border-radius: 1rem; font-size: 0.95rem; line-height: 1.5; position: relative; font-weight: 500; }
    .msg-user { margin-left: auto; background: var(--metro-primary); color: white; border-bottom-right-radius: 0.25rem; box-shadow: 0 4px 10px rgba(37,99,235,0.2); }
    .msg-ai { margin-right: auto; background: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border-color); border-bottom-left-radius: 0.25rem; box-shadow: var(--shadow-sm); }
    .ai-badge { font-size: 0.7rem; font-weight: 700; color: var(--metro-primary); margin-bottom: 6px; display: block; letter-spacing: 0.5px; text-transform: uppercase; }
    .suggested-questions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 15px; }
    .suggested-btn { font-size: 0.8rem; background: var(--metro-primary-light); border: 1px solid transparent; color: var(--metro-primary); padding: 8px 15px; border-radius: 2rem; cursor: pointer; transition: 0.2s; font-weight: 600; }
    .suggested-btn:hover { background: var(--metro-primary); color: white; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(37,99,235,0.2);}

    /* ==========================================================
       MODERN DASHBOARD KATMANI
       ========================================================== */
    .hero {
        position: relative; overflow: hidden;
        border-radius: var(--r-xl, 24px);
        padding: clamp(1.6rem, 3vw, 2.6rem);
        margin-bottom: clamp(1.2rem, 2.4vw, 2rem);
        color: var(--text-primary, #3F4254);
        background:
            radial-gradient(820px 420px at 8% -20%, rgba(37,99,235,.16), transparent 62%),
            radial-gradient(680px 420px at 96% 118%, rgba(14,165,233,.14), transparent 60%),
            linear-gradient(135deg, #ffffff 0%, #f7fbff 55%, #f4f8fd 100%);
        border: 1px solid rgba(15,23,42,.05);
        box-shadow: 0 2px 6px rgba(16,24,40,.04), 0 18px 44px rgba(16,24,40,.06);
        isolation: isolate;
    }
    .hero::after {
        content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
        background-image:
