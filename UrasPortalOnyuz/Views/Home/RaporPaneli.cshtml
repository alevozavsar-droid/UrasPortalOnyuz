    /* --- Rapor kartları --- */
    .report-group-section .group-header { margin-bottom: 1rem; }
    .report-card {
        border-radius: var(--r-lg, 18px);
        padding: 1.15rem 1.25rem;
        border-left-width: 1px;
        gap: 14px;
        transition: transform .24s var(--ease, ease), box-shadow .24s var(--ease, ease), border-color .24s var(--ease, ease);
    }
    .report-card:hover {
        transform: translateY(-4px);
        border-color: color-mix(in srgb, var(--metro-primary) 40%, transparent);
        border-left-color: color-mix(in srgb, var(--metro-primary) 40%, transparent);
        box-shadow: var(--shadow-md);
        background-color: var(--bg-card);
    }
    .card-icon-wrapper {
        width: 46px; height: 46px; border-radius: 13px; font-size: 1.15rem;
        background: var(--metro-primary-light); color: var(--metro-primary);
        transition: transform .24s var(--ease, ease);
