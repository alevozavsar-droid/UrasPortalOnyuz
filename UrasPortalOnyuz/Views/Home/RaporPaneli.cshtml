    .report-card:hover .card-icon-wrapper { transform: scale(1.06) rotate(-4deg); }
    .card-title { font-size: .92rem; font-weight: 700; letter-spacing: -.015em; line-height: 1.35; }
    .card-action { font-size: .76rem; font-weight: 600; }
    .report-card:hover .card-action i { transform: translateX(4px); }
    .card-action i { transition: transform .24s var(--ease, ease); }

    /* --- AI asistan --- */
    #asistanButton {
        background: linear-gradient(135deg,#2563eb,#0ea5e9) !important;
        box-shadow: 0 12px 30px rgba(37,99,235,.4) !important;
