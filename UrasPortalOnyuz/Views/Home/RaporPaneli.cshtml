    .section-head { display: flex; align-items: center; gap: 14px; margin: clamp(1.6rem,3vw,2.4rem) 0 1.1rem; }
    .section-head h4 { margin: 0; font-size: 1.05rem; font-weight: 800; letter-spacing: -.02em; color: var(--text-primary); }
    .section-head .line { flex: 1; height: 1px; background: linear-gradient(90deg, var(--border-color), transparent); }

