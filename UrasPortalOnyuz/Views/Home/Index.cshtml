@model WebApplication3.Controllers.HomeIndexViewModel
@{
    // ANA SAYFA — Grup ERP Portalı › index.html tasarımının uyarlaması.
    // Kart yerleşimi, izin / doğum günü / mesaj / görev / performans kartları ve AI asistan sekmesi birebir taşındı.
    // Üst çubuk (selam, tarih, arama, ikonlar) ve sol menü kabuktan (_Layout) gelir. Veriler örnektir.
    // Eski rapor paneli /Home/RaporPaneli adresinde durur (raporlar Grup ERP yerleşimine göre gruplanır).
    ViewData["Title"] = "Ana Sayfa";
    string kod = User.Identity?.Name ?? "";
    string ad = WebApplication3.Data.OrnekVeri.KullaniciAdi(kod);
    var kullanici = WebApplication3.Data.OrnekVeri.Kullanicilar.FirstOrDefault(k => string.Equals(k.Kod, kod, StringComparison.OrdinalIgnoreCase));
    string rol = WebApplication3.Data.OrnekVeri.Roller.FirstOrDefault(r => r.RoleCode == kullanici.Yetki)?.RoleName ?? "Kullanıcı";
    string sirket = WebApplication3.Data.OrnekVeri.SirketAdi(Context.Request.Cookies["SelectedDatabase"]);
    string bas = string.Join("", ad.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p.Substring(0, 1))).ToUpper(new System.Globalization.CultureInfo("tr-TR"));
    string ay = System.Globalization.CultureInfo.GetCultureInfo("tr-TR").DateTimeFormat.GetMonthName(DateTime.Today.Month);
}
@section Styles {
    <link rel="stylesheet" href="~/css/grup-erp-ana.css" asp-append-version="true" />
}

<div class="gh-ana" id="ghAna" data-ad="@ad">
  <div class="cols">

    <!-- Sütun 1 -->
    <div class="gcol">
      <div class="gcard" style="grid-area:profil">
        <div class="bd">
          <div class="profile">
            <div>
              <h2 id="ghPName">@ad</h2>
              <div class="role">@rol</div>
              <div class="dept">@sirket</div>
            </div>
            <span class="av">@bas</span>
          </div>
          <div style="height:14px"></div>
          <div class="kv"><span class="k">Yöneticim</span><span class="v"><a href="#">Murat Özavşar</a></span></div>
          <div class="kv"><span class="k">İşe Başlama Tarihi</span><span class="v">19 Mar 2020</span></div>
          <div class="kv"><span class="k">Kullanıcı Kodu</span><span class="v">@kod</span></div>
        </div>
        <div class="ft"><a href="/Profil" data-sekme="Profilim">Hesabım ›</a></div>
      </div>

      <div class="gcard leave" style="grid-area:izin">
        <div class="hd"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 19l19-7-19-7 4 7-4 7z"/></svg></span><div style="flex:1"><h3>İzin Bilgilerim</h3><div class="sub">Yıllık İzin</div></div><span class="act"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v6h-6"/></svg></span></div>
        <div class="bd">
          <div class="sub">19 Mar @(DateTime.Today.Year + 1) tarihine kadar mevcut</div>
          <div class="big">89 gün</div>
          <div class="bar"><i style="width:99%"></i></div>
          <div class="legend"><span class="y">İleri Tarihli <b>0</b></span><span class="u">Kullanılan <b>1</b></span></div>
          <div style="height:10px"></div>
          <div class="satir"><span style="color:var(--success)">✔</span><div class="grow"><div class="t" style="font-weight:500">Yıllık İzin</div></div><div class="r">1g <b>24 Nis</b> <span class="muted">⋮</span></div></div>
        </div>
        <div class="ft"><a href="/Modul/ik-idari-isler?yol=insan-kaynaklari/izin-devamlilik" data-sekme="İzin ve Devamlılık">Tümünü Görün ›</a></div>
      </div>
    </div>

    <!-- Sütun 2 -->
    <div class="gcol">
      <div class="gcard" style="grid-area:yakizin">
        <div class="hd"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 19l19-7-19-7 4 7-4 7z"/></svg></span><h3>Yaklaşan İzinler</h3><span class="act" id="ghIzinOzet" style="font-weight:600"></span></div>
        <div class="bd" id="ghYaklasanIzin"></div>
        <div class="ft"><a href="/Modul/ik-idari-isler?yol=insan-kaynaklari/izin-devamlilik" data-sekme="İzin ve Devamlılık">Tümünü Görün ›</a></div>
      </div>
    </div>

    <!-- Sütun 3 -->
    <div class="gcol">
      <div class="gcard" style="grid-area:tatil">
        <div class="hd"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 22V4l14 3-14 3"/><path d="M4 22h6"/></svg></span><h3>Resmi Tatiller</h3></div>
        <div class="bd">
          <div class="satir"><div class="grow"><div class="t" style="font-weight:500">Cumhuriyet Bayramı Arefesi</div></div><div class="r">0,5g <b>28 Eki</b></div></div>
          <div class="satir"><div class="grow"><div class="t" style="font-weight:500">Cumhuriyet Bayramı</div></div><div class="r">1g <b>29 Eki</b></div></div>
        </div>
        <div class="ft"><a href="/Modul/takvim?yol=ortak-takvim" data-sekme="Ortak Takvim">Tüm Tatilleri Görün ›</a></div>
      </div>

      <div class="gcard" style="grid-area:dogum">
        <div class="hd"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12v9H4v-9M2 7h20v5H2zM12 22V7M12 7c-2-4-6-4-6-1s4 1 6 1zM12 7c2-4 6-4 6-1s-4 1-6 1z"/></svg></span><h3>Yaklaşan Doğum Günleri</h3></div>
        <div class="bd" id="ghDogum"></div>
        <div class="ft" style="text-align:left"><a href="#" id="ghDogumDaha">⟳ Daha Fazla Göster</a></div>
      </div>
    </div>

    <!-- Sütun 4 -->
    <div class="gcol">
      <div class="gcard" style="grid-area:iztalep">
        <div class="hd plain"><span class="ic" style="background:#64748b"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 19l19-7-19-7 4 7-4 7z"/></svg></span><h3>İzin Talepleri</h3><span class="act"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v6h-6"/></svg></span></div>
        <div class="bd"><div class="empty">Onayınızı bekleyen bir talep bulunmuyor.</div></div>
      </div>

      <div class="gcard" style="grid-area:mesai">
        <div class="hd plain"><span class="ic" style="background:#64748b"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><h3>Mesai Talepleri</h3><span class="act"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v6h-6"/></svg></span></div>
        <div class="bd"><div class="empty">Onayınızı bekleyen bir talep bulunmuyor.</div></div>
      </div>
    </div>

    <!-- Sütun 5 -->
    <div class="gcol">
      <div class="gcard msg" id="ghMesaj" style="grid-area:mesaj">
        <div class="hd"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1.1-4.3A8 8 0 1 1 21 12z"/></svg></span><h3>Şirket İçi Mesajlar</h3><span class="act"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></span></div>
        <div class="tabs" id="ghTabs"><span class="on" data-f="">Tümü</span><span data-f="duyuru">Duyurular</span><span data-f="grup">Gruplar</span><span data-f="dm">Direkt Mesajlar</span><span data-f="ai" class="ai-tab">✨ AI</span></div>
        <div class="bd" id="ghMesajlar"></div>
        <div class="bd ai" id="ghAsistan" hidden>
          <div class="ai-hello"><span class="ai-av">✨</span><div><b>AI Asistan</b><div class="s">Rapor ve ekran bulur, bekleyen onaylarınızı, görevlerinizi ve izinleri özetler, portal hakkında sorularınızı yanıtlar.</div></div></div>
          <div class="chips" id="ghAiChips">
            <button type="button" data-q="Bekleyen onaylarım neler?">Bekleyen onaylarım neler?</button>
            <button type="button" data-q="Mizan raporu nerede?">Mizan raporu nerede?</button>
            <button type="button" data-q="Bu ay kim izinde?">Bu ay kim izinde?</button>
            <button type="button" data-q="Açık görevlerimi özetle">Açık görevlerimi özetle</button>
          </div>
          <div class="log" id="ghAiLog"></div>
        </div>
        <div class="compose"><input placeholder="Mesaj yazın…" id="ghMsgInput" autocomplete="off"><button type="button" id="ghMsgStop" hidden>Durdur</button><button type="button" id="ghMsgSend">Gönder</button></div>
        <div class="ft"><a href="/Mesaj" id="ghMesajTumu" data-sekme="Mesajlar">Tüm Mesajları Görün ›</a></div>
      </div>

      <div class="gcard tasks" id="ghGorev" style="grid-area:gorev">
        <div class="hd"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span><h3>Takipteki Görevler</h3><span class="act" id="ghGorevSayi" style="font-weight:600"></span></div>
        <div class="bd" id="ghGorevler"><div class="empty">Tamamlanmayan göreviniz bulunmamaktadır.</div></div>
        <div class="ft"><a href="/Modul/hukuk?yol=operasyon/17" data-sekme="Tebligat, Süre ve Görev Takibi">Tüm Görevleri Görün ›</a></div>
      </div>

      <div class="gcard perf" style="grid-area:perf">
        <div class="hd"><span class="ic" style="background:#15803d"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg></span><h3>Performans &amp; İş Takibi</h3><span class="act" style="font-weight:600">@ay @DateTime.Today.Year</span></div>
        <div class="bd">
          <div class="period">Bu Ay</div>
          <div class="m"><span class="k">Görev Tamamlama</span><span class="v ok">%92</span><div class="bar"><i style="width:92%"></i></div></div>
          <div class="m"><span class="k">Zamanında Tamamlama</span><span class="v">%88</span><div class="bar"><i style="width:88%"></i></div></div>
          <div class="m"><span class="k">Hedef / KPI Gerçekleşmesi</span><span class="v">%84</span><div class="bar"><i style="width:84%"></i></div></div>
          <div class="m"><span class="k">Geciken Görev</span><span class="v warn">2</span></div>
          <div class="m"><span class="k">Geç Giriş</span><span class="v warn">1</span></div>
          <div class="m"><span class="k">Devamsızlık</span><span class="v ok">0</span></div>
          <div class="m"><span class="k">Açık Görev</span><span class="v">4</span></div>
        </div>
        <div class="total"><div><div class="k">Aylık Performans</div><div class="v">%87</div></div><a href="/Modul/ik-idari-isler?yol=insan-kaynaklari/performans-is-takibi" data-sekme="Performans ve İş Takibi">Detayları Görün →</a></div>
      </div>
    </div>

    <!-- Sütun 6: Portal değişiklik günlüğü (Data/PortalDegisiklikler.cs) -->
    <div class="gcol">
      @{
          var yeniler = WebApplication3.Data.PortalDegisiklikler.YeniEklenenler.ToList();
          var degisenler = WebApplication3.Data.PortalDegisiklikler.SonDegisiklikler.ToList();
          int yeniHafta = yeniler.Count(x => (DateTime.Today - x.Tarih.Date).Days <= 7);
          int degisHafta = degisenler.Count(x => (DateTime.Today - x.Tarih.Date).Days <= 7);
      }
      <div class="gcard chg" id="ghYeni" style="grid-area:yeni">
        <div class="hd"><span class="ic" style="background:#15803d"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg></span><h3>Yeni Eklenenler</h3><span class="act" style="font-weight:600">Bu hafta @yeniHafta yeni</span></div>
        <div class="bd">
          @if (yeniler.Count == 0) { <div class="empty">Yeni eklenen rapor bulunmuyor.</div> }
          @foreach (var d in yeniler)
          {
            <div class="satir" title="@d.Aciklama">
              <span class="tag green dot">Yeni</span>
              <div class="grow">
                <div class="t">@if (!string.IsNullOrEmpty(d.Href)) { <a href="@d.Href" data-sekme="@d.Ekran">@d.Ekran</a> } else { @d.Ekran }</div>
                <div class="s">@(string.IsNullOrEmpty(d.Yol) ? d.Aciklama : d.Yol)</div>
              </div>
              <div class="r"><b>@d.TarihMetni</b></div>
            </div>
          }
        </div>
        <div class="ft"><a href="/Home/Degisiklikler?tur=yeni" data-sekme="Yeni Eklenenler">Tümünü Görün ›</a></div>
      </div>

      <div class="gcard chg" id="ghDegisiklik" style="grid-area:degis">
        <div class="hd"><span class="ic" style="background:#b45309"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v6h-6"/><path d="M12 7v5l3 2"/></svg></span><h3>Son Değişiklikler</h3><span class="act" style="font-weight:600">Bu hafta @degisHafta değişiklik</span></div>
        <div class="bd">
          @if (degisenler.Count == 0) { <div class="empty">Kayıtlı değişiklik bulunmuyor.</div> }
          @foreach (var d in degisenler)
          {
            <div class="satir" title="@d.Aciklama">
              <span class="tag @d.TurRenk">@d.TurAdi</span>
              <div class="grow">
                <div class="t">@if (!string.IsNullOrEmpty(d.Href)) { <a href="@d.Href" data-sekme="@d.Ekran">@d.Ekran</a> } else { @d.Ekran }</div>
                <div class="s">@d.Aciklama</div>
              </div>
              <div class="r"><b>@d.TarihMetni</b></div>
            </div>
          }
        </div>
        <div class="ft"><a href="/Home/Degisiklikler" data-sekme="Değişiklik Günlüğü">Tümünü Görün ›</a></div>
      </div>
    </div>

  </div>
</div>

@section Scripts {
    <script src="~/js/grup-mesaj-data.js" asp-append-version="true"></script>
    <script src="~/js/grup-erp-ana.js" asp-append-version="true"></script>
}
