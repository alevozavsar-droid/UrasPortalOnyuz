@model IEnumerable<WebApplication3.Models.Rapor124ViewModel>

@{
    ViewData["Title"] = "Çek Akıbeti Detaylı Raporu (Rapor 124)";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
    
    var databases = ViewBag.Databases as List<WebApplication3.Models.DatabaseConfig>;
    var selectedDbKey = ViewBag.SelectedDatabaseKey as string;
    var currentDbDisplay = ViewBag.CurrentDbDisplay as string;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <style>
        .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }
        .table th, .table td { vertical-align: middle !important; white-space: nowrap; }
    </style>
}

<div class="container-fluid mt-4">
    @Html.AntiForgeryToken()
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-money-check-alt me-2"></i> Çek Akıbeti Detaylı Raporu (Rapor 124) - <span class="badge bg-light text-primary">@currentDbDisplay</span>
            </h5>
            <div class="d-flex align-items-center bg-white rounded p-1">
                <label for="dbSelect" class="text-dark me-2 mb-0 ms-2" style="font-size:0.9rem; font-weight:bold;">Şirket Seçin:</label>
                <select id="dbSelect" class="form-select form-select-sm" style="width: 200px;" onchange="changeDatabase(this.value)">
                    @if (databases != null)
                    {
                        foreach (var db in databases)
                        {
                            if (db.Key == selectedDbKey) { <option value="@db.Key" selected="selected">@db.Display</option> }
                            else { <option value="@db.Key">@db.Display</option> }
                        }
                    }
                </select>
            </div>
        </div>
        
        <div class="card-body p-3">
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger shadow-sm"><i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.ErrorMessage</div>
            }
            else
            {
                <div class="mb-3 d-flex gap-2">
                    <button id="createTahsilatBordroBtn" class="btn btn-primary btn-sm shadow-sm"><i class="fas fa-file-pdf"></i> Tahsilat Bordrosu Oluştur</button>
                    <button id="createIbrazBordroBtn" class="btn btn-warning btn-sm text-dark shadow-sm"><i class="fas fa-file-pdf"></i> İbraz Bordrosu Oluştur</button>
                </div>

                <div class="table-responsive">
                    <table id="rapor124Table" class="table table-striped table-bordered table-hover w-100 font-monospace" style="font-size: 12px;">
                        <thead class="table-dark text-center">
                            <tr>
                                <th class="bg-secondary text-white border-end" rowspan="2" style="width: 30px;"><input type="checkbox" id="selectAll" class="form-check-input" /></th>
                                <th colspan="5" class="bg-secondary text-white border-end">Çek Temel Bilgileri</th>
                                <th colspan="5" class="bg-success text-white border-end">Tahsilat (ORCT) Detayları</th>
                                <th colspan="4" class="bg-danger text-white border-end">Tahsilat İptal (CancelDoc) Detayları</th>
                                <th colspan="4" class="bg-warning text-dark border-end">İbraz (ODPS) Detayları</th>
                                <th colspan="4" class="bg-info text-dark">Vadeli İbraz (ODPT) Detayları</th>
                            </tr>
                            <tr>
                                <th>Sistem No</th><th>Çek No</th><th>Vade Tarihi</th><th>Tutar</th><th class="border-end">Çek Durum</th>
                                <th>Belge No</th><th>Durum</th><th>U_BE1_iade</th><th>Yevmiye No</th><th class="border-end">U_BE1_yeviptal</th>
                                <th>İptal Belge No</th><th>İptal Belge İade</th><th>İptal Yevmiye No</th><th class="border-end">İptal Yev. İptal</th>
                                <th>Belge No</th><th>Durum</th><th>Yevmiye No</th><th class="border-end">U_BE1_yeviptal</th>
                                <th>Belge No</th><th>Durum</th><th>Yevmiye No</th><th>U_BE1_yeviptal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var item in Model)
                                {
                                    <tr data-docentry="@item.DocEntry" data-ibrazbelgeno="@item.IbrazBelgeNo">
                                        <td class="text-center"><input type="checkbox" class="form-check-input row-checkbox" value="@item.DocEntry" /></td>
                                        <td class="text-center fw-bold text-secondary">@item.DocEntry</td>
                                        <td class="text-center fw-bold">@item.CekNumarasi</td>
                                        <td class="text-center">@(item.VadeTarihi.HasValue ? item.VadeTarihi.Value.ToString("dd.MM.yyyy") : "-")</td>
                                        <td class="text-end fw-bold text-primary">@(item.Tutar.HasValue ? item.Tutar.Value.ToString("N2") + " " + item.ParaBirimi : "-")</td>
                                        <td class="text-center border-end"><span class="badge @(item.CekIptal == "İptal" ? "bg-danger" : "bg-success")">@item.CekIptal</span></td>
                                        
                                        <td class="text-center">@(string.IsNullOrEmpty(item.TahsilatBelgeNo) ? "-" : item.TahsilatBelgeNo)</td>
                                        <td class="text-center">@if (!string.IsNullOrEmpty(item.TahsilatDurumu)) { <span class="badge @(item.TahsilatDurumu == "İptal Edildi" ? "bg-danger" : "bg-success")">@item.TahsilatDurumu</span> } else { <span>-</span> }</td>
                                        <td class="text-center">@(string.IsNullOrEmpty(item.TahsilatIade) ? "-" : item.TahsilatIade)</td>
                                        <td class="text-center fw-bold text-dark">@(string.IsNullOrEmpty(item.TahsilatYevmiyeNo) ? "-" : item.TahsilatYevmiyeNo)</td>
                                        <td class="text-center border-end">@(string.IsNullOrEmpty(item.TahsilatYevIptal) ? "-" : item.TahsilatYevIptal)</td>
                                        
                                        <td class="text-center">@(string.IsNullOrEmpty(item.TahsilatIptalBelgeNo) ? "-" : item.TahsilatIptalBelgeNo)</td>
                                        <td class="text-center text-danger fw-bold">@(string.IsNullOrEmpty(item.TahsilatIptalBelgeIade) ? "-" : item.TahsilatIptalBelgeIade)</td>
                                        <td class="text-center fw-bold">@(string.IsNullOrEmpty(item.TahsilatIptalYevmiyeNo) ? "-" : item.TahsilatIptalYevmiyeNo)</td>
                                        <td class="text-center border-end">@(string.IsNullOrEmpty(item.TahsilatIptalYevIptal) ? "-" : item.TahsilatIptalYevIptal)</td>
                                        
                                        <td class="text-center">@(string.IsNullOrEmpty(item.IbrazBelgeNo) ? "-" : item.IbrazBelgeNo)</td>
                                        <td class="text-center">@if (!string.IsNullOrEmpty(item.IbrazDurumu)) { <span class="badge @(item.IbrazDurumu == "İptal Edildi" ? "bg-danger" : "bg-success")">@item.IbrazDurumu</span> } else { <span>-</span> }</td>
                                        <td class="text-center fw-bold text-dark">@(string.IsNullOrEmpty(item.IbrazYevmiyeNo) ? "-" : item.IbrazYevmiyeNo)</td>
                                        <td class="text-center border-end">@(string.IsNullOrEmpty(item.IbrazYevIptal) ? "-" : item.IbrazYevIptal)</td>
                                        
                                        <td class="text-center">@(string.IsNullOrEmpty(item.VadeliIbrazNo) ? "-" : item.VadeliIbrazNo)</td>
                                        <td class="text-center">@if (!string.IsNullOrEmpty(item.VadeliIbrazDurumu)) { <span class="badge @(item.VadeliIbrazDurumu == "İptal Edildi" ? "bg-danger" : "bg-success")">@item.VadeliIbrazDurumu</span> } else { <span>-</span> }</td>
                                        <td class="text-center fw-bold text-dark">@(string.IsNullOrEmpty(item.VadeliIbrazYevmiyeNo) ? "-" : item.VadeliIbrazYevmiyeNo)</td>
                                        <td class="text-center">@(string.IsNullOrEmpty(item.VadeliIbrazYevIptal) ? "-" : item.VadeliIbrazYevIptal)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#rapor124Table').DataTable({
                "scrollX": true,
                "paging": true,
                "ordering": false,
                "info": true,
                "searching": true,
                "pageLength": 25,
                "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Tümü"]],
                "dom": '<"d-flex justify-content-between align-items-center mb-2"Bf>rt<"d-flex justify-content-between align-items-center mt-2"ilp>',
                "buttons": [
                    { extend: 'excelHtml5', className: 'btn btn-success btn-sm me-1', text: '<i class="fas fa-file-excel"></i> Excel\'e Aktar', title: 'Cek_Akibeti_Detayli_Raporu_124' },
                    { extend: 'pdfHtml5', className: 'btn btn-danger btn-sm me-1', text: '<i class="fas fa-file-pdf"></i> PDF\'e Aktar', orientation: 'landscape', pageSize: 'A2', title: 'Cek_Akibeti_Detayli_Raporu_124' },
                    { extend: 'print', className: 'btn btn-info btn-sm text-white', text: '<i class="fas fa-print"></i> Yazdır' }
                ],
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json" }
            });

            $('#selectAll').on('click', function () {
                $('.row-checkbox').prop('checked', $(this).prop('checked'));
            });

            function getSelectedData() {
                var selected = [];
                $('.row-checkbox:checked').each(function () {
                    var row = $(this).closest('tr');
                    selected.push({ DocEntry: row.data('docentry'), IbrazBelgeNo: row.data('ibrazbelgeno') });
                });
                return selected;
            }

            async function createBordro(url, docEntries) {
                try {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    const response = await fetch(url + '?db=' + '@selectedDbKey', {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token 
                        },
                        body: JSON.stringify(docEntries)
                    });

                    if (response.ok) {
                        const blob = await response.blob();
                        const downloadUrl = window.URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        let fileName = 'Bordro.pdf';
                        
                        const contentDisposition = response.headers.get('Content-Disposition');
                        if (contentDisposition) { 
                            const fileNameMatch = contentDisposition.match(/filename="(.+)"/); 
                            if (fileNameMatch && fileNameMatch.length > 1) fileName = fileNameMatch[1]; 
                        }
                        
                        a.href = downloadUrl; 
                        a.download = fileName; 
                        document.body.appendChild(a); 
                        a.click(); 
                        a.remove();
                        toastr.success('Bordro başarıyla indirildi.');
                    } else { toastr.error(`Hata: ${await response.text()}`); }
                } catch (error) { toastr.error('Bordro oluşturulurken hata meydana geldi.'); }
            }

            $('#createTahsilatBordroBtn').on('click', async function () {
                const selectedRows = getSelectedData();
                if (selectedRows.length === 0) return toastr.warning('Lütfen en az bir çek seçiniz.');
                await createBordro('/Rapor124/CreateTahsilatBordro', selectedRows.map(r => r.DocEntry));
            });

            $('#createIbrazBordroBtn').on('click', async function () {
                const selectedRows = getSelectedData();
                if (selectedRows.length === 0) return toastr.warning('Lütfen en az bir çek seçiniz.');
                if (selectedRows.every(row => !row.IbrazBelgeNo || row.IbrazBelgeNo === "")) return toastr.warning('Seçili çeklerde İbraz Belge No bulunmuyor.');
                await createBordro('/Rapor124/CreateIbrazBordro', selectedRows.map(r => r.DocEntry));
            });
        });

        function changeDatabase(dbKey) {
            document.cookie = "SelectedDatabase=" + dbKey + "; path=/; max-age=" + (30 * 24 * 60 * 60);
            window.location.href = window.location.pathname + "?db=" + dbKey;
        }
    </script>
}