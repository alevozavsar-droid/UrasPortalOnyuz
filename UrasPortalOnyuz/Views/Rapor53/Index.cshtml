@{
    ViewData["Title"] = "Tedarikçi Konsolide Ödeme Takip Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*
    TEDARİKÇİ KONSOLİDE ÖDEME TAKİP RAPORU — yeni tasarım. Tüm grup şirketlerinin tedarikçileri tek listede (ortak 14 süzgeç): borç bakiyesi, açık alış faturaları vade kırılımı, verilen çek / senet,
    Kasa Nakit Akışı planlı ödemeleri, son ödeme / alım, risk ve limit. Haftalık Ödeme Planı (fatura vadeleri ↔ nakit akış planı), Şirket Özeti, Satınalmacı Özeti ve Planlı Ödemeler (nakit akış satırları).
    Tedarikçi Fatura ve Ödeme Takip (Rapor52), Kasa Nakit Akışı, Ödeme Talebi, Otomatik Kapatma ile entegre. Uçlar: Controllers/TedarikciController.cs · betik: wwwroot/js/tedarikci-konsolide.js
*@
@section Styles {
<link rel="stylesheet" href="/css/nakit-avans.css?v=1" />
<link rel="stylesheet" href="/css/cari-islem.css?v=2" />
}
<div class="container-fluid py-3 na ci tk" id="tk">
    <div class="na-ust">
        <h4><span class="rt-ikon"><i class="fas fa-building-columns"></i></span>Tedarikçi Konsolide Ödeme Takip Raporu</h4>
        <span style="font-size:.68rem;font-weight:700;color:#475569;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:999px;padding:3px 10px"><i class="fas fa-database me-1"></i>Tüm Şirketler · Tedarikçi Kartları + Cari Mutabakat + Kasa Nakit Akışı</span>
        <span class="sub w-100">Grup şirketlerinin tedarikçi borçları tek listede: <b>vade kırılımı</b> (gecikmiş · bu hafta · 8–30 · 31–60 · 60+ gün), verilen <b>çek / senet</b>, Kasa Nakit Akışı'ndaki <b>planlı ödemeler</b>, son ödeme / alım, risk ve limit. Haftalık Ödeme Planı fatura vadeleri ile nakit akış planını karşılaştırır (plansız vade = nakit akışa eklenmeli); Şirket ve Satınalmacı özetleri toplar; Planlı Ödemeler sekmesi nakit akış satırlarını listeler.</span>
    </div>
    <div class="na-sekme" id="tkSekmeler" data-dinamik="kapali">
        <button type="button" data-p="liste" class="aktif"><i class="fas fa-list me-1"></i>Tedarikçi Listesi <span class="n" id="tkN">0</span></button>
        <button type="button" data-p="hafta"><i class="fas fa-calendar-week me-1"></i>Haftalık Ödeme Planı</button>
        <button type="button" data-p="sirket"><i class="fas fa-building me-1"></i>Şirket Özeti</button>
        <button type="button" data-p="satinalmaci"><i class="fas fa-user-tie me-1"></i>Satınalmacı Özeti</button>
        <button type="button" data-p="plan"><i class="fas fa-wallet me-1"></i>Planlı Ödemeler (Nakit Akış) <span class="n" id="tkNPlan">0</span></button>
    </div>
    <div id="naSonuc" class="alert py-2 px-3 mb-2"></div>
    <div class="ci-kpi" id="tkKpi"></div>
    <div class="na-panel aktif" data-p="liste">
        <div class="na-kart">
            <div class="na-kart-b"><span><i class="fas fa-filter me-1"></i>Filtreler</span><span class="d-flex gap-1"><button type="button" class="btn btn-light btn-sm py-0" id="tkTemizle" style="font-size:.66rem">Temizle</button><button type="button" class="btn btn-light btn-sm py-0" id="tkExcel" style="font-size:.66rem"><i class="fas fa-file-excel me-1"></i>Excel</button><a class="btn btn-light btn-sm py-0" style="font-size:.66rem" href="/Rapor52"><i class="fas fa-truck me-1"></i>Tedarikçi Fatura ve Ödeme Takip</a><a class="btn btn-light btn-sm py-0" style="font-size:.66rem" href="/Rapor79"><i class="fas fa-wallet me-1"></i>Kasa Nakit Akışı</a></span></div>
            <div class="na-kart-g">
                <div id="tkSuzgec"></div>
                <div class="ci-filtre">
                    <div><label>Ödeme Durumu</label><select class="form-select" id="tkDurum"><option value="">Tümü</option><option value="gecmis">Gecikmiş Ödemesi Olan</option><option value="buhafta">Bu Hafta Vadesi Gelen</option><option value="plansiz">Vadesi Gelen Ama Plansız</option><option value="plan">Planlı Ödemesi Olan</option><option value="cek">Verilen Çeki Olan</option><option value="eslesmemis">Eşleşmemiş Ödemesi Olan</option><option value="acik">Açık Borcu Olan</option></select></div>
                    <div><label>Sırala</label><select class="form-select" id="tkSirala"><option value="gecmis">Gecikmiş (Büyükten)</option><option value="acik">Açık Toplam</option><option value="buhafta">Bu Hafta</option><option value="plan">Planlı Ödeme</option><option value="borc">Borç Bakiyesi</option><option value="kod">Cari Kodu</option></select></div>
                    <div class="ms-auto na-mini" id="tkSayi"></div>
                </div>
                <div class="table-responsive"><table class="na-tablo ci-liste" id="tkTablo" data-dinamik="kapali"><thead><tr><th>Şirket</th><th>Tedarikçi · Satınalmacı</th><th class="e">Borç Bakiyesi</th><th class="e">Gecikmiş</th><th class="e">Bu Hafta</th><th class="e">8+ Gün (8–30 · 31–60 · 60+)</th><th class="e">Açık Toplam</th><th class="e">Çek / Senet</th><th class="e">Planlı Ödeme</th><th class="e">Son 30 Gün Ödeme</th><th>Vade Dağılımı</th><th>Risk · Limit</th><th></th></tr></thead><tbody></tbody><tfoot></tfoot></table></div>
            </div>
        </div>
    </div>
    <div class="na-panel" data-p="hafta">
        <div class="row g-2">
            <div class="col-lg-7"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-calendar-week me-1"></i>Haftalık Ödeme Planı (Fatura Vadeleri ↔ Nakit Akış Planı)</span><span class="not">liste süzgecine göre · gecikmişler ilk satırda</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="tkHafta" data-dinamik="kapali"><thead><tr><th>Hafta</th><th>Tarih Aralığı</th><th class="s">Fatura</th><th class="s">Tedarikçi</th><th class="e">Vadesi Gelen (TL)</th><th class="s">Plan</th><th class="e">Planlı (TL)</th><th class="e">Plansız</th><th>Dağılım</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div></div></div>
            <div class="col-lg-5"><div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-list-ol me-1"></i>Seçili Haftanın Faturaları</span><span class="not" id="tkHaftaNot">satıra tıklayın</span></div><div class="na-kart-g p-0"><div class="table-responsive" style="max-height:480px"><table class="na-tablo ci-liste" id="tkHaftaDetay" data-dinamik="kapali"><thead><tr><th>Vade</th><th>Tedarikçi</th><th>Belge</th><th class="s">Tip</th><th class="e">Kalan</th><th class="e">TL</th></tr></thead><tbody><tr><td colspan="6" class="na-bos">Haftalık tablodan bir satır seçin.</td></tr></tbody></table></div></div></div></div>
        </div>
    </div>
    <div class="na-panel" data-p="sirket">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-building me-1"></i>Şirket Bazlı Ödeme Özeti</span><span class="not">liste süzgecine göre · satıra tıklayınca liste o şirkete süzülür</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="tkSirketTablo" data-dinamik="kapali"><thead><tr><th>Şirket</th><th class="s">Tedarikçi</th><th class="e">Borç Bakiyesi</th><th class="e">Gecikmiş</th><th class="s">Gecikmeli</th><th class="e">Bu Hafta</th><th class="e">8–30 Gün</th><th class="e">31–60 Gün</th><th class="e">60+ Gün</th><th class="e">Çek / Senet</th><th class="e">Planlı Ödeme</th><th class="e">Son 30 Gün Ödeme</th><th class="s">Riskli</th><th>Plan Karşılama</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div></div>
    </div>
    <div class="na-panel" data-p="satinalmaci">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-user-tie me-1"></i>Satınalmacı Bazlı Özet</span><span class="not">satıra tıklayınca liste o satınalmacıya süzülür</span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="tkSatinalmaci" data-dinamik="kapali"><thead><tr><th>Satınalmacı</th><th class="s">Tedarikçi</th><th class="e">Borç Bakiyesi</th><th class="e">Gecikmiş</th><th class="e">Bu Hafta</th><th class="e">Açık Toplam</th><th class="e">Planlı Ödeme</th><th class="e">Son 30 Gün Ödeme</th><th class="s">Riskli</th><th class="s">Limit Aşımı</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div></div>
    </div>
    <div class="na-panel" data-p="plan">
        <div class="na-kart"><div class="na-kart-b"><span><i class="fas fa-wallet me-1"></i>Kasa Nakit Akışı · Tedarikçi Ödemeleri</span><span class="d-flex gap-1 align-items-center"><input class="form-control" id="tkPlanAra" placeholder="Tedarikçi, belge, ürün…" style="width:200px;font-size:.66rem;height:24px"><select class="form-select" id="tkPlanDurum" style="width:auto;font-size:.66rem;height:24px;padding:0 20px 0 6px"><option value="">Ödenmemiş</option><option value="gecikmis">Planı Gecikmiş</option><option value="hepsi">Tümü (ödenenler dahil)</option></select></span></div><div class="na-kart-g p-0"><div class="table-responsive"><table class="na-tablo ci-liste" id="tkPlanTablo" data-dinamik="kapali"><thead><tr><th>Şirket</th><th>Tedarikçi</th><th>Plan Tarihi</th><th>Belge</th><th>Ürün / Hizmet</th><th>Yöntem</th><th>Satınalmacı</th><th class="e">Tutar (TL)</th><th>Durum</th><th></th></tr></thead><tbody></tbody><tfoot></tfoot></table></div></div></div>
    </div>
</div>
@section Scripts {
<script src="/js/cari-suzgec.js?v=1"></script>
<script src="/js/tedarikci-konsolide.js?v=2"></script>
}
