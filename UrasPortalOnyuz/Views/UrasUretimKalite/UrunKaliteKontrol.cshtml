@{ ViewData["Title"] = "Ürün Kalite Kontrol"; }

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0 text-gray-800 fw-bold"><i class="fas fa-flask me-2 text-primary"></i> Ürün Kalite Kontrol</h2>
</div>
<p class="text-muted mb-3">Kazan bazlı ürün kalite kontrol formu — kalem koduna göre geçmiş formlar ve yeni form girişi.</p>

<div class="card dash-card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-bold">Kalem Kodu</label>
                <input id="fItemCode" class="form-control form-control-sm" placeholder="Kalem kodu girin...">
            </div>
            <div class="col-6 col-md-3 d-flex align-items-end">
                <button class="btn btn-outline-secondary btn-sm" onclick="formlariYukle()"><i class="fas fa-search me-1"></i>Geçmiş Formları Getir</button>
            </div>
            <div class="col-6 col-md-3 d-flex align-items-end">
                <button class="btn btn-primary btn-sm" onclick="yeniForm()"><i class="fas fa-plus me-1"></i>Yeni Form</button>
            </div>
        </div>
    </div>
</div>

<div class="card dash-card mb-3">
    <div class="card-header bg-white fw-bold small text-uppercase text-muted d-flex justify-content-between align-items-center">
        <span>Aranan Değerler ve Kalem Aralıkları</span>
        <button class="btn btn-sm btn-outline-secondary" onclick="qcAralikPaneliAcKapat()"><i class="fas fa-sliders me-1"></i>Göster/Gizle</button>
    </div>
    <div class="card-body" id="qcAralikPaneli" style="display:none;">
        <div class="row g-2 align-items-end mb-3">
            <div class="col-12 col-md-6">
                <label class="form-label small fw-bold">Kalem</label>
                <input type="text" id="qItemArama" class="form-control form-control-sm" placeholder="Kalem kodu veya adı ile ara…" oninput="qItemFiltrele()">
                <div id="qItemSonuc" class="list-group small" style="max-height:160px; overflow-y:auto;"></div>
            </div>
            <div class="col-12 col-md-6" id="qItemSecili" style="display:none;">
                <label class="form-label small fw-bold">Seçili Kalem</label>
                <div class="input-group input-group-sm">
                    <input type="text" id="qItemAd" class="form-control" disabled>
                    <button class="btn btn-outline-secondary" onclick="qItemTemizle()"><i class="fas fa-xmark"></i></button>
                </div>
            </div>
        </div>

        <div id="qFormAlan" style="display:none;">
            <input type="hidden" id="qRangeCode">
            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <div class="fw-bold small text-uppercase text-muted mb-2">Aranan Değerler (Hedef)</div>
                    <div class="row g-2">
                        <div class="col-6"><label class="form-label small">Görünüş</label><input id="qtGorunus" class="form-control form-control-sm"></div>
                        <div class="col-6"><label class="form-label small">pH</label><input id="qtPh" class="form-control form-control-sm"></div>
                        <div class="col-6"><label class="form-label small">Sıcaklık</label><input id="qtSicaklik" class="form-control form-control-sm"></div>
                        <div class="col-6"><label class="form-label small">Yoğunluk</label><input id="qtYogunluk" class="form-control form-control-sm"></div>
                        <div class="col-6"><label class="form-label small">Viskozite (Önce)</label><input id="qtVisk1" class="form-control form-control-sm"></div>
                        <div class="col-6"><label class="form-label small">Viskozite (Sonra/24h)</label><input id="qtVisk2" class="form-control form-control-sm"></div>
                        <div class="col-6"><label class="form-label small">Katı %</label><input id="qtKati" class="form-control form-control-sm"></div>
                        <div class="col-6"><label class="form-label small">Tork</label><input id="qtTork" class="form-control form-control-sm"></div>
                    </div>
                    <button class="btn btn-primary btn-sm mt-2" onclick="qcTargetKaydet()"><i class="fas fa-save me-1"></i>Hedef Değerleri Kaydet</button>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="fw-bold small text-uppercase text-muted mb-2">Kabul Edilebilir Aralık (Min–Max)</div>
                    <div class="row g-2">
                        <div class="col-6"><label class="form-label small">pH Min</label><input type="number" step="0.01" id="qrPhMin" class="form-control form-control-sm"></div>
                        <div class="col-6"><label class="form-label small">pH Max</label><input type="number" step="0.01" id="qrPhMax" class="form-control form-control-sm"></div>
                        <div class="col-6"><label class="form-label small">Yoğunluk Min</label><input type="number" step="0.01" id="qrDensityMin" class="form-control form-control-sm"></div>
                        <div class="col-6"><label class="form-label small">Yoğunluk Max</label><input type="number" step="0.01" id="qrDensityMax" class="form-control form-control-sm"></div>
                        <div class="col-6"><label class="form-label small">Katı Min</label><input type="number" step="0.01" id="qrSolidMin" class="form-control form-control-sm"></div>
                        <div class="col-6"><label class="form-label small">Katı Max</label><input type="number" step="0.01" id="qrSolidMax" class="form-control form-control-sm"></div>
                        <div class="col-3"><label class="form-label small">Visk.1 Min</label><input type="number" step="0.01" id="qrVisc1Min" class="form-control form-control-sm"></div>
                        <div class="col-3"><label class="form-label small">Visk.1 Max</label><input type="number" step="0.01" id="qrVisc1Max" class="form-control form-control-sm"></div>
                        <div class="col-3"><label class="form-label small">Spindle 1</label><input type="number" id="qrSpindle1" class="form-control form-control-sm"></div>
                        <div class="col-3"><label class="form-label small">RPM 1</label><input type="number" id="qrRPM1" class="form-control form-control-sm"></div>
                        <div class="col-3"><label class="form-label small">Visk.2 Min</label><input type="number" step="0.01" id="qrVisc2Min" class="form-control form-control-sm"></div>
                        <div class="col-3"><label class="form-label small">Visk.2 Max</label><input type="number" step="0.01" id="qrVisc2Max" class="form-control form-control-sm"></div>
                        <div class="col-3"><label class="form-label small">Spindle 2</label><input type="number" id="qrSpindle2" class="form-control form-control-sm"></div>
                        <div class="col-3"><label class="form-label small">RPM 2</label><input type="number" id="qrRPM2" class="form-control form-control-sm"></div>
                    </div>
                    <div class="mt-2 d-flex gap-2">
                        <button class="btn btn-primary btn-sm" onclick="qcRangeKaydet()"><i class="fas fa-save me-1"></i>Aralığı Kaydet</button>
                        <button class="btn btn-outline-danger btn-sm" id="qrSilBtn" style="display:none" onclick="qcRangeSil()"><i class="fas fa-trash me-1"></i>Aralığı Sil</button>
                    </div>
                </div>
            </div>
        </div>

        <hr>
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-bold small text-uppercase text-muted">Tanımlı Aralıklar <span id="qrSayisi" class="badge bg-primary ms-1">0</span></span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-custom mb-0">
                <thead><tr><th>Kalem</th><th class="text-center">pH</th><th class="text-center">Yoğunluk</th><th class="text-center">Katı</th><th></th></tr></thead>
                <tbody id="tbodyQcRange"></tbody>
            </table>
        </div>
    </div>
</div>

<div class="card dash-card mb-3" id="gecmisKart" style="display:none;">
    <div class="card-header bg-white fw-bold small text-uppercase text-muted">Geçmiş Formlar <span id="formSayisi" class="badge bg-primary ms-1">0</span></div>
    <div class="table-responsive">
        <table class="table table-hover table-custom mb-0">
            <thead><tr><th>Tarih</th><th>Form No</th><th>Ürün</th><th>Parti</th><th>Operatör</th><th class="text-end">Satır</th><th></th></tr></thead>
            <tbody id="tbodyFormlar"></tbody>
        </table>
    </div>
</div>

<div class="card dash-card" id="formKart" style="display:none;">
    <div class="card-header bg-white fw-bold small text-uppercase text-muted">Form</div>
    <div class="card-body">
        <div class="row g-2 mb-3">
            <div class="col-6 col-md-2"><label class="form-label small">Form Tarihi</label><input type="date" id="mFormDate" class="form-control form-control-sm"></div>
            <div class="col-6 col-md-2"><label class="form-label small">İş Emri No</label><input type="number" id="mWorkOrder" class="form-control form-control-sm"></div>
            <div class="col-6 col-md-2"><label class="form-label small">Kalem Kodu</label><input id="mItemCode" class="form-control form-control-sm"></div>
            <div class="col-6 col-md-2"><label class="form-label small">Ürün Adı</label><input id="mProdName" class="form-control form-control-sm"></div>
            <div class="col-6 col-md-2"><label class="form-label small">Parti No</label><input id="mPartiNo" class="form-control form-control-sm"></div>
            <div class="col-6 col-md-2"><label class="form-label small">Operatör</label><input id="mOperator" class="form-control form-control-sm"></div>
            <div class="col-4 col-md-2"><label class="form-label small">Form No</label><input id="mFormNo" class="form-control form-control-sm"></div>
            <div class="col-4 col-md-2"><label class="form-label small">Revizyon</label><input id="mRev" class="form-control form-control-sm"></div>
            <div class="col-4 col-md-2"><label class="form-label small">Sayfa</label><input id="mPage" class="form-control form-control-sm"></div>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-bold small text-uppercase text-muted">Satırlar (Kazan Bazlı Ölçümler)</span>
            <button class="btn btn-outline-primary btn-sm" onclick="satirEkle()"><i class="fas fa-plus me-1"></i>Satır Ekle</button>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-custom mb-0">
                <thead><tr><th>Kazan</th><th>Lot</th><th>Görünüş</th><th>pH</th><th>Sıcaklık</th><th>Visk. Önce</th><th>Visk. Sonra</th><th>24h</th><th>Yoğunluk</th><th>Katı</th><th>Sonuç</th><th></th></tr></thead>
                <tbody id="tbodySatirlar"></tbody>
            </table>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" onclick="formKaydet()"><i class="fas fa-save me-1"></i>Kaydet</button>
            <button class="btn btn-outline-success" onclick="pdfIndir()"><i class="fas fa-file-pdf me-1"></i>PDF</button>
            <button class="btn btn-outline-secondary" onclick="document.getElementById('formKart').style.display='none';">Kapat</button>
        </div>
    </div>
</div>

<style>
    .dash-card { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
    .table-custom th { background-color: #f8f9fc; text-transform: uppercase; font-size: 11px; color: #858796; border-bottom: 2px solid #e3e6f0; }
    .table-custom td { vertical-align: middle; font-size: 13px; }
    .table-custom input, .table-custom select { font-size: 12px; padding: 2px 6px; }
</style>

<script>
    let satirlar = [], duzenlenenDocEntry = null;
    function el(id) { return document.getElementById(id); }

    // ---- Aranan Değerler / Kalem Aralıkları ----
    let qcKalemler = [], qcRangeler = [], qcAralikYuklendi = false;

    function qcAralikPaneliAcKapat() {
        const acik = el('qcAralikPaneli').style.display !== 'none';
        el('qcAralikPaneli').style.display = acik ? 'none' : '';
        if (!acik && !qcAralikYuklendi) { qcAralikYuklendi = true; qcKalemleriYukle(); qcRangeleriYukle(); }
    }

    async function qcKalemleriYukle() {
        const res = await fetch('/UrasUretimKalite/GetOITMForQC').then(r => r.json());
        qcKalemler = res.success ? (res.data || []) : [];
    }

    function qItemFiltrele() {
        const q = (el('qItemArama').value || '').toLowerCase().trim();
        if (!q) { el('qItemSonuc').innerHTML = ''; return; }
        const list = qcKalemler.filter(k => k.ItemCode.toLowerCase().includes(q) || (k.ItemName || '').toLowerCase().includes(q)).slice(0, 20);
        el('qItemSonuc').innerHTML = list.map(k => `
            <a href="javascript:void(0)" class="list-group-item list-group-item-action py-1" onclick='qItemSec(${JSON.stringify(k)})'>
                <b>${k.ItemCode}</b> — ${k.ItemName || ''}</a>`).join('') || '<div class="text-muted small p-2">Bulunamadı.</div>';
    }

    function qItemTemizle() {
        el('qItemArama').value = ''; el('qItemSonuc').innerHTML = '';
        el('qItemSecili').style.display = 'none'; el('qFormAlan').style.display = 'none';
    }

    async function qItemSec(k) {
        el('qItemArama').value = ''; el('qItemSonuc').innerHTML = '';
        el('qItemSecili').style.display = ''; el('qItemAd').value = k.ItemCode + ' - ' + (k.ItemName || '');
        el('qFormAlan').style.display = '';
        el('qFormAlan').dataset.itemcode = k.ItemCode; el('qFormAlan').dataset.itemname = k.ItemName || '';

        ['qtGorunus', 'qtPh', 'qtSicaklik', 'qtYogunluk', 'qtVisk1', 'qtVisk2', 'qtKati', 'qtTork',
         'qrPhMin', 'qrPhMax', 'qrDensityMin', 'qrDensityMax', 'qrSolidMin', 'qrSolidMax',
         'qrVisc1Min', 'qrVisc1Max', 'qrSpindle1', 'qrRPM1', 'qrVisc2Min', 'qrVisc2Max', 'qrSpindle2', 'qrRPM2'].forEach(id => el(id).value = '');
        el('qRangeCode').value = ''; el('qrSilBtn').style.display = 'none';

        const [tRes, rRes] = await Promise.all([
            fetch('/UrasUretimKalite/GetQCTarget?itemCode=' + encodeURIComponent(k.ItemCode)).then(r => r.json()),
            fetch('/UrasUretimKalite/GetQCRangeByItemCode?itemCode=' + encodeURIComponent(k.ItemCode)).then(r => r.json())
        ]);
        const t = tRes.success && tRes.data && tRes.data.length ? tRes.data[0] : null;
        if (t) {
            el('qtGorunus').value = t.Gorunus || ''; el('qtPh').value = t.Ph || ''; el('qtSicaklik').value = t.Sicaklik || '';
            el('qtYogunluk').value = t.Yogunluk || ''; el('qtVisk1').value = t.Visk1 || ''; el('qtVisk2').value = t.Visk2 || '';
            el('qtKati').value = t.Kati || ''; el('qtTork').value = t.Tork || '';
        }
        const r = rRes.success && rRes.data && rRes.data.length ? rRes.data[0] : null;
        if (r) {
            el('qRangeCode').value = r.Code;
            el('qrPhMin').value = r.PhMin ?? ''; el('qrPhMax').value = r.PhMax ?? '';
            el('qrDensityMin').value = r.DensityMin ?? ''; el('qrDensityMax').value = r.DensityMax ?? '';
            el('qrSolidMin').value = r.SolidMin ?? ''; el('qrSolidMax').value = r.SolidMax ?? '';
            el('qrVisc1Min').value = r.Visc1Min ?? ''; el('qrVisc1Max').value = r.Visc1Max ?? '';
            el('qrSpindle1').value = r.Spindle1 ?? ''; el('qrRPM1').value = r.RPM1 ?? '';
            el('qrVisc2Min').value = r.Visc2Min ?? ''; el('qrVisc2Max').value = r.Visc2Max ?? '';
            el('qrSpindle2').value = r.Spindle2 ?? ''; el('qrRPM2').value = r.RPM2 ?? '';
            el('qrSilBtn').style.display = '';
        }
    }

    async function qcTargetKaydet() {
        const itemCode = el('qFormAlan').dataset.itemcode;
        if (!itemCode) { alert('Önce kalem seçin.'); return; }
        const body = {
            ItemCode: itemCode, Gorunus: el('qtGorunus').value, Ph: el('qtPh').value, Sicaklik: el('qtSicaklik').value,
            Visk1: el('qtVisk1').value, Visk2: el('qtVisk2').value, Yogunluk: el('qtYogunluk').value, Tork: el('qtTork').value, Kati: el('qtKati').value,
        };
        const res = await fetch('/UrasUretimKalite/SaveQCTarget', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        alert(res.message);
    }

    function numDegeri(id) { const v = el(id).value; return v === '' ? null : parseFloat(v); }
    function intDegeri(id) { const v = el(id).value; return v === '' ? null : parseInt(v, 10); }

    async function qcRangeKaydet() {
        const itemCode = el('qFormAlan').dataset.itemcode;
        if (!itemCode) { alert('Önce kalem seçin.'); return; }
        const body = {
            Code: el('qRangeCode').value || null, Name: el('qFormAlan').dataset.itemname, ItemCode: itemCode,
            PhMin: numDegeri('qrPhMin'), PhMax: numDegeri('qrPhMax'),
            Visc1Min: numDegeri('qrVisc1Min'), Visc1Max: numDegeri('qrVisc1Max'), Spindle1: intDegeri('qrSpindle1'), RPM1: intDegeri('qrRPM1'),
            Visc2Min: numDegeri('qrVisc2Min'), Visc2Max: numDegeri('qrVisc2Max'), Spindle2: intDegeri('qrSpindle2'), RPM2: intDegeri('qrRPM2'),
            DensityMin: numDegeri('qrDensityMin'), DensityMax: numDegeri('qrDensityMax'), SolidMin: numDegeri('qrSolidMin'), SolidMax: numDegeri('qrSolidMax'),
        };
        const res = await fetch('/UrasUretimKalite/SaveQCRange', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        if (!res.success) { alert('Kaydedilemedi: ' + res.message); return; }
        el('qRangeCode').value = res.message; el('qrSilBtn').style.display = '';
        alert('Aralık kaydedildi.');
        qcRangeleriYukle();
    }

    async function qcRangeSil() {
        const code = el('qRangeCode').value;
        if (!code || !confirm('Bu kalem aralığını silmek istediğinize emin misiniz?')) return;
        const res = await fetch('/UrasUretimKalite/DeleteQCRange?code=' + encodeURIComponent(code), { method: 'POST' }).then(r => r.json());
        alert(res.message);
        if (res.success) { el('qRangeCode').value = ''; el('qrSilBtn').style.display = 'none'; qcRangeleriYukle(); }
    }

    async function qcRangeleriYukle() {
        const res = await fetch('/UrasUretimKalite/GetQCRanges').then(r => r.json());
        qcRangeler = res.success ? (res.data || []) : [];
        el('qrSayisi').textContent = qcRangeler.length;
        el('tbodyQcRange').innerHTML = qcRangeler.map(r => `
            <tr><td><div class="fw-semibold">${r.Name || ''}</div><div class="text-muted small">${r.ItemCode}</div></td>
                <td class="text-center">${r.PhMin ?? '-'} / ${r.PhMax ?? '-'}</td>
                <td class="text-center">${r.DensityMin ?? '-'} / ${r.DensityMax ?? '-'}</td>
                <td class="text-center">${r.SolidMin ?? '-'} / ${r.SolidMax ?? '-'}</td>
                <td><button class="btn btn-sm btn-outline-primary" onclick='qItemSec({ItemCode:${JSON.stringify(r.ItemCode)},ItemName:${JSON.stringify(r.Name)}})'><i class="fas fa-pen"></i></button></td></tr>`).join('')
            || '<tr><td colspan="5" class="text-center text-muted py-3">Tanımlı aralık yok.</td></tr>';
    }

    async function formlariYukle() {
        const itemCode = el('fItemCode').value.trim();
        if (!itemCode) { alert('Kalem kodu girin.'); return; }
        const res = await fetch('/UrasUretimKalite/GetQCFormsByItemCode?itemCode=' + encodeURIComponent(itemCode)).then(r => r.json());
        if (!res.success) { alert('Formlar alınamadı: ' + res.message); return; }
        const liste = res.data || [];
        el('gecmisKart').style.display = '';
        el('formSayisi').textContent = liste.length;
        el('tbodyFormlar').innerHTML = liste.map(f => `
            <tr><td>${(f.FormDate || '').slice(0, 10)}</td><td>${f.FormNo || ''}</td><td>${f.ProdName || ''}</td><td>${f.PartiNo || ''}</td><td>${f.Operator || ''}</td>
                <td class="text-end">${(f.Rows || []).length}</td>
                <td><button class="btn btn-sm btn-outline-primary" onclick='formuAc(${JSON.stringify(f).replace(/'/g, "&apos;")})'>Aç</button></td></tr>`).join('')
            || '<tr><td colspan="7" class="text-center text-muted py-3">Kayıt yok.</td></tr>';
    }

    function yeniForm() {
        duzenlenenDocEntry = null;
        el('mFormDate').value = new Date().toISOString().slice(0, 10);
        el('mWorkOrder').value = ''; el('mItemCode').value = el('fItemCode').value; el('mProdName').value = '';
        el('mPartiNo').value = ''; el('mOperator').value = ''; el('mFormNo').value = ''; el('mRev').value = ''; el('mPage').value = '';
        satirlar = [];
        cizSatirlar();
        el('formKart').style.display = '';
    }

    function formuAc(f) {
        duzenlenenDocEntry = f.DocEntry;
        el('mFormDate').value = (f.FormDate || '').slice(0, 10);
        el('mWorkOrder').value = f.WorkOrderDocEntry || '';
        el('mItemCode').value = f.ItemCode || ''; el('mProdName').value = f.ProdName || ''; el('mPartiNo').value = f.PartiNo || '';
        el('mOperator').value = f.Operator || ''; el('mFormNo').value = f.FormNo || ''; el('mRev').value = f.Rev || ''; el('mPage').value = f.Page || '';
        satirlar = (f.Rows || []).map(r => ({ ...r }));
        cizSatirlar();
        el('formKart').style.display = '';
        el('formKart').scrollIntoView({ behavior: 'smooth' });
    }

    function satirEkle() { satirlar.push({}); cizSatirlar(); }
    function satirSil(i) { satirlar.splice(i, 1); cizSatirlar(); }
    function satirGuncelle(i, alan, deger) { satirlar[i][alan] = deger; }

    function cizSatirlar() {
        el('tbodySatirlar').innerHTML = satirlar.map((s, i) => `
            <tr>
                <td><input value="${s.BoilerNo || ''}" onchange="satirGuncelle(${i},'BoilerNo',this.value)"></td>
                <td><input value="${s.LotNo || ''}" onchange="satirGuncelle(${i},'LotNo',this.value)"></td>
                <td><input value="${s.Appearance || ''}" onchange="satirGuncelle(${i},'Appearance',this.value)"></td>
                <td><input value="${s.Ph || ''}" onchange="satirGuncelle(${i},'Ph',this.value)"></td>
                <td><input value="${s.Temp || ''}" onchange="satirGuncelle(${i},'Temp',this.value)"></td>
                <td><input value="${s.ViscBefore || ''}" onchange="satirGuncelle(${i},'ViscBefore',this.value)"></td>
                <td><input value="${s.ViscAfter || ''}" onchange="satirGuncelle(${i},'ViscAfter',this.value)"></td>
                <td><input value="${s.Visc24h || ''}" onchange="satirGuncelle(${i},'Visc24h',this.value)"></td>
                <td><input value="${s.Density || ''}" onchange="satirGuncelle(${i},'Density',this.value)"></td>
                <td><input value="${s.Solid || ''}" onchange="satirGuncelle(${i},'Solid',this.value)"></td>
                <td><input value="${s.Result || ''}" onchange="satirGuncelle(${i},'Result',this.value)"></td>
                <td><button class="btn btn-sm btn-outline-danger" onclick="satirSil(${i})"><i class="fas fa-trash"></i></button></td>
            </tr>`).join('') || '<tr><td colspan="12" class="text-center text-muted py-2">Satır yok.</td></tr>';
    }

    function pdfIndir() {
        htmlToPdfIndir('formKart', 'Kalite_Formu_' + (document.getElementById('mFormNo').value || ''));
    }

    async function formKaydet() {
        const model = {
            docEntry: duzenlenenDocEntry, formDate: el('mFormDate').value || null,
            workOrderDocEntry: parseInt(el('mWorkOrder').value) || 0, itemCode: el('mItemCode').value,
            prodName: el('mProdName').value, partiNo: el('mPartiNo').value, operator: el('mOperator').value,
            formNo: el('mFormNo').value, rev: el('mRev').value, page: el('mPage').value, rows: satirlar
        };
        const res = await fetch('/UrasUretimKalite/SaveQCFormUrunKK', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(model) }).then(r => r.json());
        if (!res.success) { alert('Kaydedilemedi: ' + res.message); return; }
        alert('Kaydedildi (DocEntry: ' + res.message + ').');
        formlariYukle();
    }
</script>
