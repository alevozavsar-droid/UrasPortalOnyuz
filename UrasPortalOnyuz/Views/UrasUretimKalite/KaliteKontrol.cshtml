@{ ViewData["Title"] = "KK Kalem Değer Aralıkları"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0 text-gray-800 fw-bold"><i class="fas fa-ruler me-2 text-primary"></i> KK Kalem Değer Aralıkları</h2>
</div>
<p class="text-muted mb-3">Ürün kalite kontrolünde kullanılan viskozite/pH/yoğunluk/katı madde aralıkları ve aranan hedef değerler.</p>

<div class="card dash-card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-6">
                <label class="form-label small fw-bold">Kalem</label>
                <select id="fItemCode" class="form-select form-select-sm"></select>
            </div>
            <div class="col-12 col-md-6 d-flex gap-2 align-items-end">
                <button class="btn btn-primary btn-sm" onclick="yeniKayit()"><i class="fas fa-plus me-1"></i>Yeni Aralık</button>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-7">
        <div class="card dash-card">
            <div class="card-header bg-white fw-bold small text-uppercase text-muted">Değer Aralıkları <span id="rangeSayisi" class="badge bg-primary ms-1">0</span></div>
            <div class="table-responsive">
                <table class="table table-hover table-custom mb-0">
                    <thead><tr><th>Kalem</th><th class="text-end">pH</th><th class="text-end">Visk1</th><th class="text-end">Yoğunluk</th><th class="text-end">Katı</th><th></th></tr></thead>
                    <tbody id="tbodyRanges"></tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-5">
        <div class="card dash-card">
            <div class="card-header bg-white fw-bold small text-uppercase text-muted">Aranan Hedef Değer</div>
            <div class="card-body">
                <div class="mb-2"><label class="form-label small">Görünüş</label><input id="tGorunus" class="form-control form-control-sm"></div>
                <div class="mb-2"><label class="form-label small">pH</label><input id="tPh" class="form-control form-control-sm"></div>
                <div class="mb-2"><label class="form-label small">Sıcaklık</label><input id="tSicaklik" class="form-control form-control-sm"></div>
                <div class="mb-2"><label class="form-label small">Viskozite 1</label><input id="tVisk1" class="form-control form-control-sm"></div>
                <div class="mb-2"><label class="form-label small">Viskozite 2</label><input id="tVisk2" class="form-control form-control-sm"></div>
                <div class="mb-2"><label class="form-label small">Yoğunluk</label><input id="tYogunluk" class="form-control form-control-sm"></div>
                <div class="mb-2"><label class="form-label small">Katı</label><input id="tKati" class="form-control form-control-sm"></div>
                <div class="mb-2"><label class="form-label small">Tork</label><input id="tTork" class="form-control form-control-sm"></div>
                <button class="btn btn-primary btn-sm w-100" onclick="hedefKaydet()"><i class="fas fa-save me-1"></i>Hedef Değeri Kaydet</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rangeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Değer Aralığı</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="mCode">
                <div class="mb-2"><label class="form-label small">Kalem Kodu</label><input id="mItemCode" class="form-control form-control-sm"></div>
                <div class="row g-2">
                    <div class="col-6"><label class="form-label small">pH Min</label><input id="mPhMin" type="number" step="0.01" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">pH Max</label><input id="mPhMax" type="number" step="0.01" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Visk1 Min</label><input id="mV1Min" type="number" step="0.01" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Visk1 Max</label><input id="mV1Max" type="number" step="0.01" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Yoğunluk Min</label><input id="mDnsMin" type="number" step="0.01" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Yoğunluk Max</label><input id="mDnsMax" type="number" step="0.01" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Katı Min</label><input id="mSldMin" type="number" step="0.01" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Katı Max</label><input id="mSldMax" type="number" step="0.01" class="form-control form-control-sm"></div>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button><button class="btn btn-primary btn-sm" onclick="rangeKaydet()">Kaydet</button></div>
        </div>
    </div>
</div>

<style>
    .dash-card { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
    .table-custom th { background-color: #f8f9fc; text-transform: uppercase; font-size: 11px; color: #858796; border-bottom: 2px solid #e3e6f0; }
    .table-custom td { vertical-align: middle; font-size: 13px; color: #5a5c69; }
</style>

<script>
    let kalemler = [], ranges = [];
    function fmt(n) { return n === null || n === undefined || n === '' ? '—' : n; }

    async function yukle() {
        const [k, r] = await Promise.all([
            fetch('/UrasUretimKalite/GetOITMForQC').then(r => r.json()),
            fetch('/UrasUretimKalite/GetQCRanges').then(r => r.json()),
        ]);
        kalemler = k.success ? k.data : [];
        ranges = r.success ? r.data : [];
        document.getElementById('fItemCode').innerHTML = '<option value="">Kalem seçin…</option>' + kalemler.map(x => `<option value="${x.ItemCode}">${x.ItemCode} - ${x.ItemName}</option>`).join('');
        cizRanges();
    }

    function cizRanges() {
        document.getElementById('rangeSayisi').textContent = ranges.length;
        document.getElementById('tbodyRanges').innerHTML = ranges.map(r => `
            <tr><td>${r.ItemCode}<div class="text-muted small">${r.Name || ''}</div></td>
                <td class="text-end">${fmt(r.PhMin)} - ${fmt(r.PhMax)}</td><td class="text-end">${fmt(r.Visc1Min)} - ${fmt(r.Visc1Max)}</td>
                <td class="text-end">${fmt(r.DensityMin)} - ${fmt(r.DensityMax)}</td><td class="text-end">${fmt(r.SolidMin)} - ${fmt(r.SolidMax)}</td>
                <td><button class="btn btn-sm btn-outline-primary" onclick='duzenle(${JSON.stringify(r)})'><i class="fas fa-pen"></i></button>
                    <button class="btn btn-sm btn-outline-danger" onclick="sil('${r.Code}')"><i class="fas fa-trash"></i></button></td></tr>`).join('')
            || '<tr><td colspan="6" class="text-center text-muted py-3">Kayıt yok.</td></tr>';
    }

    function yeniKayit() {
        ['mCode','mItemCode','mPhMin','mPhMax','mV1Min','mV1Max','mDnsMin','mDnsMax','mSldMin','mSldMax'].forEach(id => document.getElementById(id).value = '');
        new bootstrap.Modal(document.getElementById('rangeModal')).show();
    }
    function duzenle(r) {
        document.getElementById('mCode').value = r.Code;
        document.getElementById('mItemCode').value = r.ItemCode;
        document.getElementById('mPhMin').value = r.PhMin ?? ''; document.getElementById('mPhMax').value = r.PhMax ?? '';
        document.getElementById('mV1Min').value = r.Visc1Min ?? ''; document.getElementById('mV1Max').value = r.Visc1Max ?? '';
        document.getElementById('mDnsMin').value = r.DensityMin ?? ''; document.getElementById('mDnsMax').value = r.DensityMax ?? '';
        document.getElementById('mSldMin').value = r.SolidMin ?? ''; document.getElementById('mSldMax').value = r.SolidMax ?? '';
        new bootstrap.Modal(document.getElementById('rangeModal')).show();
    }

    async function rangeKaydet() {
        const body = {
            Code: document.getElementById('mCode').value || null,
            Name: document.getElementById('mItemCode').value,
            ItemCode: document.getElementById('mItemCode').value,
            PhMin: parseFloat(document.getElementById('mPhMin').value) || null, PhMax: parseFloat(document.getElementById('mPhMax').value) || null,
            Visc1Min: parseFloat(document.getElementById('mV1Min').value) || null, Visc1Max: parseFloat(document.getElementById('mV1Max').value) || null,
            DensityMin: parseFloat(document.getElementById('mDnsMin').value) || null, DensityMax: parseFloat(document.getElementById('mDnsMax').value) || null,
            SolidMin: parseFloat(document.getElementById('mSldMin').value) || null, SolidMax: parseFloat(document.getElementById('mSldMax').value) || null,
        };
        const res = await fetch('/UrasUretimKalite/SaveQCRange', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        if (!res.success) { alert(res.message); return; }
        bootstrap.Modal.getInstance(document.getElementById('rangeModal')).hide();
        yukle();
    }

    async function sil(code) {
        if (!confirm('Silinsin mi?')) return;
        const res = await fetch('/UrasUretimKalite/DeleteQCRange?code=' + encodeURIComponent(code), { method: 'POST' }).then(r => r.json());
        if (!res.success) { alert(res.message); return; }
        yukle();
    }

    document.getElementById('fItemCode').addEventListener('change', async function () {
        const code = this.value;
        ['tGorunus','tPh','tSicaklik','tVisk1','tVisk2','tYogunluk','tKati','tTork'].forEach(id => document.getElementById(id).value = '');
        if (!code) return;
        const res = await fetch('/UrasUretimKalite/GetQCTarget?itemCode=' + encodeURIComponent(code)).then(r => r.json());
        if (res.success && res.data && res.data.length) {
            const t = res.data[0];
            document.getElementById('tGorunus').value = t.Gorunus || ''; document.getElementById('tPh').value = t.Ph || '';
            document.getElementById('tSicaklik').value = t.Sicaklik || ''; document.getElementById('tVisk1').value = t.Visk1 || '';
            document.getElementById('tVisk2').value = t.Visk2 || ''; document.getElementById('tYogunluk').value = t.Yogunluk || '';
            document.getElementById('tKati').value = t.Kati || ''; document.getElementById('tTork').value = t.Tork || '';
        }
    });

    async function hedefKaydet() {
        const code = document.getElementById('fItemCode').value;
        if (!code) { alert('Önce kalem seçin.'); return; }
        const body = {
            ItemCode: code, Gorunus: document.getElementById('tGorunus').value, Ph: document.getElementById('tPh').value,
            Sicaklik: document.getElementById('tSicaklik').value, Visk1: document.getElementById('tVisk1').value, Visk2: document.getElementById('tVisk2').value,
            Yogunluk: document.getElementById('tYogunluk').value, Kati: document.getElementById('tKati').value, Tork: document.getElementById('tTork').value,
        };
        const res = await fetch('/UrasUretimKalite/SaveQCTarget', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        alert(res.message);
    }

    yukle();
</script>
