@{ ViewData["Title"] = "Giriş Kalite Kontrol"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0 text-gray-800 fw-bold"><i class="fas fa-clipboard-check me-2 text-primary"></i> Giriş Kalite Kontrol Formu (URS-F09-01)</h2>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-6">
        <div class="card dash-card">
            <div class="card-header bg-white fw-bold small text-uppercase text-muted d-flex justify-content-between">
                <span>Kontrol Bekleyen Hammaddeler <span id="beklSayisi" class="badge bg-warning text-dark ms-1">0</span></span>
                <input type="text" id="fBeklArama" class="form-control form-control-sm" style="width:200px" placeholder="Ara…" oninput="beklYukle()">
            </div>
            <div class="table-responsive" style="max-height:600px;">
                <table class="table table-hover table-custom mb-0">
                    <thead><tr><th>Tarih</th><th>Tedarikçi</th><th>Kalem</th><th class="text-end">Miktar</th><th></th></tr></thead>
                    <tbody id="tbodyBekleyen"></tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-6">
        <div class="card dash-card">
            <div class="card-header bg-white fw-bold small text-uppercase text-muted d-flex justify-content-between">
                <span>Defter <span id="defterSayisi" class="badge bg-primary ms-1">0</span></span>
                <select id="fSonuc" class="form-select form-select-sm" style="width:auto" onchange="defterYukle()">
                    <option value="">Tümü</option><option value="O">Onay</option><option value="S">Şartlı Onay</option><option value="R">Red</option>
                </select>
            </div>
            <div class="table-responsive" style="max-height:600px;">
                <table class="table table-hover table-custom mb-0">
                    <thead><tr><th>Tarih</th><th>Kalem</th><th>Tedarikçi</th><th>Sonuç</th><th></th></tr></thead>
                    <tbody id="tbodyDefter"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-12">
        <div class="card dash-card">
            <div class="card-header bg-white fw-bold small text-uppercase text-muted d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>Aranan Değer Aralıkları <span id="aralikSayisi" class="badge bg-primary ms-1">0</span></span>
                <div class="d-flex gap-2">
                    <input type="text" id="fAralikArama" class="form-control form-control-sm" style="width:200px" placeholder="Ürün ara…" oninput="araliklarYukle()">
                    <button class="btn btn-sm btn-primary" onclick="aralikEkleAc()"><i class="fas fa-plus me-1"></i>Yeni Aralık</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-custom mb-0">
                    <thead><tr><th>Ürün</th><th class="text-center">Viskozite Min-Max</th><th class="text-center">pH Min-Max</th><th class="text-center">Yoğunluk Min-Max</th><th class="text-center">Katı Min-Max</th><th></th></tr></thead>
                    <tbody id="tbodyAralik"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="aralikModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Aranan Değer Aralığı</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="aItemCode">
                <div class="mb-2" id="aKalemAramaAlan">
                    <label class="form-label small">Ürün</label>
                    <input type="text" id="aKalemArama" class="form-control form-control-sm" placeholder="Kalem kodu veya adı ile ara…" oninput="aralikKalemAra()">
                    <div id="aKalemSonuc" class="list-group small" style="max-height:160px; overflow-y:auto;"></div>
                </div>
                <div class="mb-2" id="aKalemSecili" style="display:none;">
                    <label class="form-label small">Ürün</label>
                    <input type="text" class="form-control form-control-sm" id="aItemAd" disabled>
                </div>
                <div class="row g-2">
                    <div class="col-6"><label class="form-label small">Viskozite Min</label><input type="number" step="0.01" id="aVisMin" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Viskozite Max</label><input type="number" step="0.01" id="aVisMax" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">pH Min</label><input type="number" step="0.01" id="aPhMin" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">pH Max</label><input type="number" step="0.01" id="aPhMax" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Yoğunluk Min</label><input type="number" step="0.01" id="aYogMin" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Yoğunluk Max</label><input type="number" step="0.01" id="aYogMax" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Katı Min</label><input type="number" step="0.01" id="aKatiMin" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Katı Max</label><input type="number" step="0.01" id="aKatiMax" class="form-control form-control-sm"></div>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button><button class="btn btn-primary btn-sm" onclick="aralikKaydet()">Kaydet</button></div>
        </div>
    </div>
</div>

<div class="modal fade" id="mailModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Giriş KK Formu Mail Gönder</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="mailCode">
                <div class="mb-2"><label class="form-label small">Alıcı E-posta (birden fazlaysa ; ile ayırın)</label><input id="mailAlici" class="form-control form-control-sm"></div>
                <div class="mb-2"><label class="form-label small">Not (opsiyonel)</label><textarea id="mailNot" class="form-control form-control-sm" rows="2"></textarea></div>
            </div>
            <div class="modal-footer"><button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button><button class="btn btn-primary btn-sm" onclick="mailGonder()">Gönder</button></div>
        </div>
    </div>
</div>

<div class="modal fade" id="kkModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Giriş Kalite Kontrol</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="mKaynakEntry"><input type="hidden" id="mKaynakLineNum"><input type="hidden" id="mKaynakNo">
                <input type="hidden" id="mCardCode"><input type="hidden" id="mItemCode">
                <div class="row g-2">
                    <div class="col-6"><label class="form-label small">Tedarikçi</label><input id="mTedarikci" class="form-control form-control-sm" disabled></div>
                    <div class="col-6"><label class="form-label small">Kalem</label><input id="mItemName" class="form-control form-control-sm" disabled></div>
                    <div class="col-4"><label class="form-label small">Tarih</label><input id="mTarih" type="date" class="form-control form-control-sm"></div>
                    <div class="col-4"><label class="form-label small">Miktar</label><input id="mMiktar" type="number" step="0.01" class="form-control form-control-sm"></div>
                    <div class="col-4"><label class="form-label small">Birim</label><input id="mBirim" class="form-control form-control-sm"></div>
                    <div class="col-4"><label class="form-label small">Parti No</label><input id="mPartiNo" class="form-control form-control-sm"></div>
                    <div class="col-4"><label class="form-label small">Görünüş</label><input id="mGorunus" class="form-control form-control-sm"></div>
                    <div class="col-4"><label class="form-label small">Renk</label><input id="mRenk" class="form-control form-control-sm"></div>
                    <div class="col-3"><label class="form-label small">Viskozite</label><input id="mViskoz" type="number" step="0.01" class="form-control form-control-sm"></div>
                    <div class="col-3"><label class="form-label small">pH</label><input id="mPh" type="number" step="0.01" class="form-control form-control-sm"></div>
                    <div class="col-3"><label class="form-label small">Yoğunluk</label><input id="mYogunluk" type="number" step="0.01" class="form-control form-control-sm"></div>
                    <div class="col-3"><label class="form-label small">Katı</label><input id="mKati" type="number" step="0.01" class="form-control form-control-sm"></div>
                    <div class="col-4"><label class="form-label small">Sonuç</label>
                        <select id="mSonuc" class="form-select form-select-sm" onchange="sonucDegisti()"><option value="O">Onay</option><option value="S">Şartlı Onay</option><option value="R">Red</option></select>
                    </div>
                    <div class="col-8" id="hedefDepoAlan"><label class="form-label small">Hedef Depo</label><select id="mHedefDepo" class="form-select form-select-sm"></select></div>
                    <div class="col-12"><label class="form-label small">Açıklama</label><textarea id="mAciklama" class="form-control form-control-sm" rows="2"></textarea></div>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button><button class="btn btn-primary btn-sm" onclick="kaydet()">Kaydet</button></div>
        </div>
    </div>
</div>

<style>
    .dash-card { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
    .table-custom th { background-color: #f8f9fc; text-transform: uppercase; font-size: 11px; color: #858796; border-bottom: 2px solid #e3e6f0; }
    .table-custom td { vertical-align: middle; font-size: 13px; color: #5a5c69; }
    .rozet { font-size: .68rem; font-weight: 700; padding: .2em .5em; border-radius: 6px; }
    .rozet-yesil { background:#e6f7ee; color:#0f9d58; } .rozet-sari { background:#fff8e6; color:#b7791f; } .rozet-kirmizi { background:#fde8e8; color:#c0392b; }
</style>

<script>
    let depolar = [];
    function sonucAd(s) { return { O: 'Onay', S: 'Şartlı Onay', R: 'Red' }[s] || s; }
    function sonucRozet(s) { return { O: 'rozet-yesil', S: 'rozet-sari', R: 'rozet-kirmizi' }[s] || ''; }

    async function beklYukle() {
        const qs = new URLSearchParams({ search: document.getElementById('fBeklArama').value });
        const res = await fetch('/UrasUretimKalite/GetGirisKKBekleyen?' + qs.toString()).then(r => r.json());
        const list = res.success ? res.data : [];
        document.getElementById('beklSayisi').textContent = list.length;
        document.getElementById('tbodyBekleyen').innerHTML = list.map(b => `
            <tr><td class="text-nowrap">${b.Tarih}</td><td>${b.Tedarikci}</td><td>${b.ItemName}<div class="text-muted small">${b.ItemCode}</div></td>
                <td class="text-end">${b.Miktar} ${b.Birim}</td>
                <td><button class="btn btn-sm btn-outline-primary" onclick='formAc(${JSON.stringify(b)})'>KK Yap</button></td></tr>`).join('')
            || '<tr><td colspan="5" class="text-center text-muted py-3">Bekleyen kalem yok.</td></tr>';
    }

    async function defterYukle() {
        const qs = new URLSearchParams({ sonuc: document.getElementById('fSonuc').value, page: 1, pageSize: 100 });
        const res = await fetch('/UrasUretimKalite/GetGirisKKDefter?' + qs.toString()).then(r => r.json());
        const d = res.success ? res.data : { list: [], totalCount: 0 };
        document.getElementById('defterSayisi').textContent = d.totalCount || (d.list || []).length;
        document.getElementById('tbodyDefter').innerHTML = (d.list || []).map(k => `
            <tr><td class="text-nowrap">${k.Tarih}</td><td>${k.ItemName}<div class="text-muted small">${k.ItemCode}</div></td><td>${k.Tedarikci}</td>
                <td><span class="rozet ${sonucRozet(k.Sonuc)}">${sonucAd(k.Sonuc)}</span></td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" title="PDF" href="/UrasUretimKalite/GirisKKPdf?code=${encodeURIComponent(k.Code)}" target="_blank"><i class="fas fa-file-pdf"></i></a>
                    <button class="btn btn-sm btn-outline-primary" title="Mail Gönder" onclick='mailAc(${JSON.stringify(k.Code)})'><i class="fas fa-envelope"></i></button>
                </td></tr>`).join('')
            || '<tr><td colspan="5" class="text-center text-muted py-3">Kayıt yok.</td></tr>';
    }

    async function mailAc(code) {
        document.getElementById('mailCode').value = code;
        document.getElementById('mailNot').value = '';
        try {
            const res = await fetch('/UrasUretimKalite/GetGirisKKMailAlicilar').then(r => r.json());
            document.getElementById('mailAlici').value = res.success ? (res.data || '') : '';
        } catch { document.getElementById('mailAlici').value = ''; }
        new bootstrap.Modal(document.getElementById('mailModal')).show();
    }

    async function mailGonder() {
        const body = { Code: document.getElementById('mailCode').value, Alici: document.getElementById('mailAlici').value, Not: document.getElementById('mailNot').value };
        if (!body.Alici) { alert('Alıcı e-posta adresi girin.'); return; }
        const res = await fetch('/UrasUretimKalite/SendGirisKKMail', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        alert(res.message);
        if (res.success) bootstrap.Modal.getInstance(document.getElementById('mailModal')).hide();
    }

    async function depolariYukle() {
        const res = await fetch('/UrasUretimKalite/GetGirisKKDepolar').then(r => r.json());
        depolar = res.success ? res.data : [];
        document.getElementById('mHedefDepo').innerHTML = depolar.map(d => `<option value="${d.WhsCode}">${d.WhsCode} - ${d.WhsName}</option>`).join('');
    }

    function sonucDegisti() { document.getElementById('hedefDepoAlan').style.display = document.getElementById('mSonuc').value === 'R' ? 'none' : ''; }

    function formAc(b) {
        document.getElementById('mKaynakEntry').value = b.DocEntry; document.getElementById('mKaynakLineNum').value = b.LineNum; document.getElementById('mKaynakNo').value = b.DocNum;
        document.getElementById('mCardCode').value = b.CardCode; document.getElementById('mItemCode').value = b.ItemCode;
        document.getElementById('mTedarikci').value = b.Tedarikci; document.getElementById('mItemName').value = b.ItemName;
        document.getElementById('mTarih').value = new Date().toISOString().slice(0, 10);
        document.getElementById('mMiktar').value = b.Miktar; document.getElementById('mBirim').value = b.Birim;
        document.getElementById('mPartiNo').value = ''; document.getElementById('mGorunus').value = ''; document.getElementById('mRenk').value = '';
        document.getElementById('mViskoz').value = ''; document.getElementById('mPh').value = ''; document.getElementById('mYogunluk').value = ''; document.getElementById('mKati').value = '';
        document.getElementById('mSonuc').value = 'O'; document.getElementById('mAciklama').value = '';
        sonucDegisti();
        new bootstrap.Modal(document.getElementById('kkModal')).show();
    }

    async function kaydet() {
        const body = {
            KaynakEntry: parseInt(document.getElementById('mKaynakEntry').value), KaynakLineNum: parseInt(document.getElementById('mKaynakLineNum').value),
            KaynakNo: document.getElementById('mKaynakNo').value, CardCode: document.getElementById('mCardCode').value, Tedarikci: document.getElementById('mTedarikci').value,
            ItemCode: document.getElementById('mItemCode').value, ItemName: document.getElementById('mItemName').value,
            IrsaliyeNo: document.getElementById('mKaynakNo').value, Tarih: document.getElementById('mTarih').value,
            Miktar: parseFloat(document.getElementById('mMiktar').value), Birim: document.getElementById('mBirim').value,
            PartiNo: document.getElementById('mPartiNo').value, Gorunus: document.getElementById('mGorunus').value, Renk: document.getElementById('mRenk').value,
            Viskozite: parseFloat(document.getElementById('mViskoz').value) || null, Ph: parseFloat(document.getElementById('mPh').value) || null,
            Yogunluk: parseFloat(document.getElementById('mYogunluk').value) || null, Kati: parseFloat(document.getElementById('mKati').value) || null,
            Sonuc: document.getElementById('mSonuc').value, Aciklama: document.getElementById('mAciklama').value, HedefDepo: document.getElementById('mHedefDepo').value,
            Partiler: [],
        };
        const res = await fetch('/UrasUretimKalite/SaveGirisKK', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        alert(res.message);
        if (res.success) { bootstrap.Modal.getInstance(document.getElementById('kkModal')).hide(); beklYukle(); defterYukle(); }
    }

    // ---- Aranan Değer Aralıkları ----
    let aralikSecim = null, aralikAramaZaman = null;
    function fmtAralik(v) { return v === null || v === undefined ? '-' : v; }

    async function araliklarYukle() {
        const qs = new URLSearchParams({ search: document.getElementById('fAralikArama').value });
        const res = await fetch('/UrasUretimKalite/GetGKKRanges?' + qs.toString()).then(r => r.json());
        const list = res.success ? (res.data || []) : [];
        document.getElementById('aralikSayisi').textContent = list.length;
        document.getElementById('tbodyAralik').innerHTML = list.map(a => `
            <tr><td><div class="fw-semibold">${a.ItemName || ''}</div><div class="text-muted small">${a.ItemCode}</div></td>
                <td class="text-center">${fmtAralik(a.VisMin)} / ${fmtAralik(a.VisMax)}</td>
                <td class="text-center">${fmtAralik(a.PhMin)} / ${fmtAralik(a.PhMax)}</td>
                <td class="text-center">${fmtAralik(a.YogMin)} / ${fmtAralik(a.YogMax)}</td>
                <td class="text-center">${fmtAralik(a.KatiMin)} / ${fmtAralik(a.KatiMax)}</td>
                <td class="text-nowrap">
                    <button class="btn btn-sm btn-outline-primary" onclick='aralikDuzenleAc(${JSON.stringify(a)})'><i class="fas fa-pen"></i></button>
                    <button class="btn btn-sm btn-outline-danger" onclick="aralikSil('${a.ItemCode}')"><i class="fas fa-trash"></i></button>
                </td></tr>`).join('')
            || '<tr><td colspan="6" class="text-center text-muted py-3">Tanımlı değer aralığı yok.</td></tr>';
    }

    function aralikFormuTemizle() {
        document.getElementById('aItemCode').value = '';
        document.getElementById('aKalemArama').value = '';
        document.getElementById('aKalemSonuc').innerHTML = '';
        document.getElementById('aKalemAramaAlan').style.display = '';
        document.getElementById('aKalemSecili').style.display = 'none';
        ['aVisMin', 'aVisMax', 'aPhMin', 'aPhMax', 'aYogMin', 'aYogMax', 'aKatiMin', 'aKatiMax'].forEach(id => document.getElementById(id).value = '');
    }

    function aralikEkleAc() {
        aralikFormuTemizle();
        new bootstrap.Modal(document.getElementById('aralikModal')).show();
    }

    function aralikDuzenleAc(a) {
        aralikFormuTemizle();
        document.getElementById('aItemCode').value = a.ItemCode;
        document.getElementById('aKalemAramaAlan').style.display = 'none';
        document.getElementById('aKalemSecili').style.display = '';
        document.getElementById('aItemAd').value = a.ItemCode + ' - ' + (a.ItemName || '');
        document.getElementById('aVisMin').value = a.VisMin ?? ''; document.getElementById('aVisMax').value = a.VisMax ?? '';
        document.getElementById('aPhMin').value = a.PhMin ?? ''; document.getElementById('aPhMax').value = a.PhMax ?? '';
        document.getElementById('aYogMin').value = a.YogMin ?? ''; document.getElementById('aYogMax').value = a.YogMax ?? '';
        document.getElementById('aKatiMin').value = a.KatiMin ?? ''; document.getElementById('aKatiMax').value = a.KatiMax ?? '';
        new bootstrap.Modal(document.getElementById('aralikModal')).show();
    }

    function aralikKalemAra() {
        clearTimeout(aralikAramaZaman);
        const q = document.getElementById('aKalemArama').value;
        if (!q) { document.getElementById('aKalemSonuc').innerHTML = ''; return; }
        aralikAramaZaman = setTimeout(async () => {
            const res = await fetch('/UrasUretimKalite/GetGirisKKHammaddeler?search=' + encodeURIComponent(q)).then(r => r.json());
            const list = res.success ? (res.data || []).slice(0, 20) : [];
            document.getElementById('aKalemSonuc').innerHTML = list.map(k => `
                <a href="javascript:void(0)" class="list-group-item list-group-item-action py-1" onclick='aralikKalemSec(${JSON.stringify(k)})'>
                    <b>${k.ItemCode}</b> — ${k.ItemName || ''}</a>`).join('') || '<div class="text-muted small p-2">Bulunamadı.</div>';
        }, 250);
    }

    function aralikKalemSec(k) {
        document.getElementById('aItemCode').value = k.ItemCode;
        document.getElementById('aKalemAramaAlan').style.display = 'none';
        document.getElementById('aKalemSecili').style.display = '';
        document.getElementById('aItemAd').value = k.ItemCode + ' - ' + (k.ItemName || '');
    }

    async function aralikKaydet() {
        const itemCode = document.getElementById('aItemCode').value;
        if (!itemCode) { alert('Ürün seçin.'); return; }
        const num = id => { const v = document.getElementById(id).value; return v === '' ? null : parseFloat(v); };
        const body = {
            ItemCode: itemCode,
            VisMin: num('aVisMin'), VisMax: num('aVisMax'), PhMin: num('aPhMin'), PhMax: num('aPhMax'),
            YogMin: num('aYogMin'), YogMax: num('aYogMax'), KatiMin: num('aKatiMin'), KatiMax: num('aKatiMax'),
        };
        const res = await fetch('/UrasUretimKalite/SaveGKKRange', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        alert(res.message);
        if (res.success) { bootstrap.Modal.getInstance(document.getElementById('aralikModal')).hide(); araliklarYukle(); }
    }

    async function aralikSil(itemCode) {
        if (!confirm('Bu değer aralığını silmek istediğinize emin misiniz?')) return;
        const res = await fetch('/UrasUretimKalite/DeleteGKKRange', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ Code: itemCode }) }).then(r => r.json());
        alert(res.message);
        if (res.success) araliklarYukle();
    }

    depolariYukle(); beklYukle(); defterYukle(); araliklarYukle();
</script>
