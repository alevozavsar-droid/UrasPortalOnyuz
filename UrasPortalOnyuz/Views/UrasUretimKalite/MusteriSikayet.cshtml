@{ ViewData["Title"] = "Müşteri Şikayet Formu"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0 text-gray-800 fw-bold"><i class="fas fa-comment-dots me-2 text-primary"></i> Müşteri Şikayet Formu</h2>
    <button class="btn btn-primary btn-sm" onclick="yeniSikayet()"><i class="fas fa-plus me-1"></i>Yeni Kayıt</button>
</div>

<div class="card dash-card">
    <div class="card-header bg-white fw-bold small text-uppercase text-muted">Kayıtlar <span id="listeSayisi" class="badge bg-primary ms-1">0</span></div>
    <div class="table-responsive">
        <table class="table table-hover table-custom mb-0">
            <thead><tr><th>Rapor No</th><th>Tarih</th><th>Tip</th><th>Müşteri</th><th>Ürün/Lot</th><th>Durum</th><th></th></tr></thead>
            <tbody id="tbodyListe"></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="sikayetModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Yeni Talep/Şikayet</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-4"><label class="form-label small">Tip</label>
                        <select id="mTip" class="form-select form-select-sm"><option value="S">Şikayet</option><option value="T">Talep</option></select>
                    </div>
                    <div class="col-4"><label class="form-label small">Tarih</label><input id="mTarih" type="date" class="form-control form-control-sm"></div>
                    <div class="col-4"><label class="form-label small">Kapsam</label><input id="mKapsam" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Müşteri</label><input id="mMusteri" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Marka</label><input id="mMarka" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Ürün / Lot</label><input id="mUrunLot" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Sevk Tarihi</label><input id="mSevkTarih" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Baskı Şart</label><input id="mBaskiSart" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Baskı Reçete</label><input id="mBaskiRecete" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Fikse</label><input id="mFikse" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Miktar Bilgisi</label><input id="mMiktarBilgi" class="form-control form-control-sm"></div>
                    <div class="col-12"><label class="form-label small">Rakip Numune</label><input id="mRakipNumune" class="form-control form-control-sm"></div>
                    <div class="col-12"><label class="form-label small">Detay <span class="text-danger">*</span></label><textarea id="mDetay" class="form-control form-control-sm" rows="3"></textarea></div>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button><button class="btn btn-primary btn-sm" onclick="sikayetKaydet()">Kaydet</button></div>
        </div>
    </div>
</div>

<div class="modal fade" id="detayModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="detayBaslik">Detay</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="dCode">
                <p id="dOzet" class="small text-muted"></p>
                <div class="row g-2 mb-3">
                    <div class="col-4"><label class="form-label small">Durum</label>
                        <select id="dDurum" class="form-select form-select-sm"><option value="A">Açık</option><option value="I">İşlemde</option><option value="K">Kapalı</option></select>
                    </div>
                    <div class="col-4"><label class="form-label small">Termin</label><input id="dTermin" class="form-control form-control-sm"></div>
                    <div class="col-4"><label class="form-label small">Maliyet</label><input id="dMaliyet" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Faaliyet Tipi</label><input id="dFaalTip" class="form-control form-control-sm" maxlength="1"></div>
                    <div class="col-6"><label class="form-label small">İade Tipi</label><input id="dIadeTip" class="form-control form-control-sm" maxlength="1"></div>
                </div>
                <button class="btn btn-sm btn-outline-primary mb-3" onclick="metaKaydet()">Meta Bilgiyi Kaydet</button>
                <hr>
                <div id="yorumListe"></div>
                <div class="row g-2 mt-2">
                    <div class="col-3"><select id="yBolum" class="form-select form-select-sm"><option value="B">Bilgi İşlem</option><option value="C">Kalite</option><option value="D">Diğer</option></select></div>
                    <div class="col-7"><input id="yYorum" class="form-control form-control-sm" placeholder="Yorum ekle…"></div>
                    <div class="col-2"><button class="btn btn-primary btn-sm w-100" onclick="yorumEkle()">Ekle</button></div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dash-card { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
    .table-custom th { background-color: #f8f9fc; text-transform: uppercase; font-size: 11px; color: #858796; border-bottom: 2px solid #e3e6f0; }
    .table-custom td { vertical-align: middle; font-size: 13px; color: #5a5c69; }
    .yorum-item { border-left: 3px solid #cbd5e1; padding: 6px 10px; margin-bottom: 6px; background: #f8fafc; border-radius: 6px; font-size: .85rem; }
</style>

<script>
    let kayitlar = [];
    function tipAd(t) { return t === 'T' ? 'Talep' : 'Şikayet'; }
    function durumAd(d) { return { A: 'Açık', I: 'İşlemde', K: 'Kapalı' }[d] || d; }

    async function listeYukle() {
        const res = await fetch('/UrasUretimKalite/GetSikayetList').then(r => r.json());
        kayitlar = res.success ? res.data : [];
        document.getElementById('listeSayisi').textContent = kayitlar.length;
        document.getElementById('tbodyListe').innerHTML = kayitlar.map(k => `
            <tr class="satir-tikla" style="cursor:pointer" onclick="detayAc('${k.Code}')">
                <td class="fw-bold">${k.RaporNo}</td><td class="text-nowrap">${k.Tarih}</td><td>${tipAd(k.Tip)}</td><td>${k.Musteri}</td>
                <td>${k.UrunLot}</td><td>${durumAd(k.Durum)}</td><td>${k.YorumSayisi} yorum</td></tr>`).join('')
            || '<tr><td colspan="7" class="text-center text-muted py-3">Kayıt yok.</td></tr>';
    }

    function yeniSikayet() {
        ['mTip','mKapsam','mMusteri','mMarka','mUrunLot','mSevkTarih','mBaskiSart','mBaskiRecete','mFikse','mMiktarBilgi','mRakipNumune','mDetay'].forEach(id => document.getElementById(id).value = '');
        document.getElementById('mTip').value = 'S';
        document.getElementById('mTarih').value = new Date().toISOString().slice(0, 10);
        new bootstrap.Modal(document.getElementById('sikayetModal')).show();
    }

    async function sikayetKaydet() {
        const body = {
            Tip: document.getElementById('mTip').value, Tarih: document.getElementById('mTarih').value, Kapsam: document.getElementById('mKapsam').value,
            Musteri: document.getElementById('mMusteri').value, Marka: document.getElementById('mMarka').value, UrunLot: document.getElementById('mUrunLot').value,
            SevkTarih: document.getElementById('mSevkTarih').value, BaskiSart: document.getElementById('mBaskiSart').value, BaskiRecete: document.getElementById('mBaskiRecete').value,
            Fikse: document.getElementById('mFikse').value, MiktarBilgi: document.getElementById('mMiktarBilgi').value, RakipNumune: document.getElementById('mRakipNumune').value,
            Detay: document.getElementById('mDetay').value,
        };
        const res = await fetch('/UrasUretimKalite/AddSikayet', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        alert(res.message);
        if (res.success) { bootstrap.Modal.getInstance(document.getElementById('sikayetModal')).hide(); listeYukle(); }
    }

    async function detayAc(code) {
        const k = kayitlar.find(x => x.Code === code);
        document.getElementById('detayBaslik').textContent = k.RaporNo + ' — ' + k.Musteri;
        document.getElementById('dCode').value = code;
        document.getElementById('dOzet').textContent = `${tipAd(k.Tip)} • ${k.Tarih} • ${k.UrunLot} • ${k.Detay}`;
        document.getElementById('dDurum').value = k.Durum || 'A'; document.getElementById('dTermin').value = k.Termin || '';
        document.getElementById('dMaliyet').value = k.Maliyet || ''; document.getElementById('dFaalTip').value = k.FaaliyetTip || ''; document.getElementById('dIadeTip').value = k.IadeTip || '';
        await yorumlariYukle(code);
        new bootstrap.Modal(document.getElementById('detayModal')).show();
    }

    async function yorumlariYukle(code) {
        const res = await fetch('/UrasUretimKalite/GetSikayetYorumlar?code=' + encodeURIComponent(code)).then(r => r.json());
        const list = res.success ? res.data : [];
        document.getElementById('yorumListe').innerHTML = list.map(y => `
            <div class="yorum-item"><b>${y.Ekleyen}</b> <span class="text-muted">(${y.Bolum} • ${y.Tarih})</span><br>${y.Yorum}</div>`).join('') || '<div class="text-muted small">Henüz yorum yok.</div>';
    }

    async function metaKaydet() {
        const body = {
            Code: document.getElementById('dCode').value, Durum: document.getElementById('dDurum').value, Termin: document.getElementById('dTermin').value,
            FaaliyetTip: document.getElementById('dFaalTip').value, IadeTip: document.getElementById('dIadeTip').value, Maliyet: document.getElementById('dMaliyet').value,
        };
        const res = await fetch('/UrasUretimKalite/UpdateSikayetMeta', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        alert(res.message);
        if (res.success) listeYukle();
    }

    async function yorumEkle() {
        const yorum = document.getElementById('yYorum').value.trim();
        if (!yorum) return;
        const body = { Code: document.getElementById('dCode').value, Bolum: document.getElementById('yBolum').value, Yorum: yorum };
        const res = await fetch('/UrasUretimKalite/AddSikayetYorum', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        if (!res.success) { alert(res.message); return; }
        document.getElementById('yYorum').value = '';
        await yorumlariYukle(document.getElementById('dCode').value);
        listeYukle();
    }

    listeYukle();
</script>
