@{ ViewData["Title"] = "Satınalma Kalite Kontrol"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0 text-gray-800 fw-bold"><i class="fas fa-flask me-2 text-primary"></i> Satınalma Kalite Kontrol</h2>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-6">
        <div class="card dash-card">
            <div class="card-header bg-white fw-bold small text-uppercase text-muted d-flex justify-content-between">
                <span>Bekleyen Kalemler <span id="beklSayisi" class="badge bg-warning text-dark ms-1">0</span></span>
                <input type="text" id="fBeklArama" class="form-control form-control-sm" style="width:200px" placeholder="Ara…" oninput="beklYukle()">
            </div>
            <div class="table-responsive" style="max-height:520px;">
                <table class="table table-hover table-custom mb-0">
                    <thead><tr><th>Tarih</th><th>Tedarikçi</th><th>Kalem</th><th></th></tr></thead>
                    <tbody id="tbodyBekleyen"></tbody>
                </table>
            </div>
        </div>
        <div class="card dash-card mt-3">
            <div class="card-header bg-white fw-bold small text-uppercase text-muted">Kimyasal Envanter (SDS) <span id="envSayisi" class="badge bg-primary ms-1">0</span></div>
            <div class="table-responsive" style="max-height:400px;">
                <table class="table table-hover table-custom mb-0">
                    <thead><tr><th>Kalem</th><th>Üretici</th><th>CAS No</th><th></th></tr></thead>
                    <tbody id="tbodyEnv"></tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-6">
        <div class="card dash-card">
            <div class="card-header bg-white fw-bold small text-uppercase text-muted d-flex justify-content-between">
                <span>Defter <span id="defterSayisi" class="badge bg-primary ms-1">0</span></span>
            </div>
            <div class="table-responsive" style="max-height:960px;">
                <table class="table table-hover table-custom mb-0">
                    <thead><tr><th>Tarih</th><th>Kalem</th><th>Tedarikçi</th><th>ECHA</th><th>Belge</th></tr></thead>
                    <tbody id="tbodyDefter"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="kkModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Satınalma Kalite Değerlendirmesi</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="mKaynakEntry"><input type="hidden" id="mKaynakLineNum"><input type="hidden" id="mKaynakNo">
                <input type="hidden" id="mCardCode"><input type="hidden" id="mItemCode">
                <div class="row g-2">
                    <div class="col-6"><label class="form-label small">Tedarikçi</label><input id="mTedarikci" class="form-control form-control-sm" disabled></div>
                    <div class="col-6"><label class="form-label small">Kalem</label><input id="mItemName" class="form-control form-control-sm" disabled></div>
                    <div class="col-4"><label class="form-label small">Tarih</label><input id="mTarih" type="date" class="form-control form-control-sm"></div>
                    <div class="col-4"><label class="form-label small">Miktar</label><input id="mMiktar" type="number" step="0.01" class="form-control form-control-sm"></div>
                    <div class="col-4"><label class="form-label small">Birim</label><input id="mBirim" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Görev/Kullanım</label><input id="mGorev" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">ECHA'ya Uygunluk</label>
                        <select id="mEcha" class="form-select form-select-sm"><option value="Y">Uygun</option><option value="N">Uygun Değil</option></select>
                    </div>
                    <div class="col-6"><label class="form-label small">ZDHC</label><input id="mZdhc" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Kontrol Tedbirleri</label><input id="mControl" class="form-control form-control-sm"></div>
                    <div class="col-12"><label class="form-label small">Açıklama</label><textarea id="mAciklama" class="form-control form-control-sm" rows="2"></textarea></div>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button><button class="btn btn-primary btn-sm" onclick="kaydet()">Kaydet</button></div>
        </div>
    </div>
</div>

<div class="modal fade" id="envModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Kimyasal Envanter / SDS</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-6"><label class="form-label small">Kalem Kodu</label><input id="eItemCode" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Üretici</label><input id="eUretici" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Ürün Adı</label><input id="eUrunAdi" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Kimyasal Türü</label><input id="eKimTur" class="form-control form-control-sm"></div>
                    <div class="col-4"><label class="form-label small">CAS No</label><input id="eCasNo" class="form-control form-control-sm"></div>
                    <div class="col-4"><label class="form-label small">EC No</label><input id="eEcNo" class="form-control form-control-sm"></div>
                    <div class="col-4"><label class="form-label small">SDS Tarihi</label><input id="eSdsTarihi" type="date" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">GHS</label><input id="eGhs" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">Depolama Alanı</label><input id="eDepoAlan" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">H Kodları</label><input id="eHKod" class="form-control form-control-sm"></div>
                    <div class="col-6"><label class="form-label small">P Kodları</label><input id="ePKod" class="form-control form-control-sm"></div>
                    <div class="col-12"><label class="form-label small">Kullanım Yeri</label><input id="eKullanim" class="form-control form-control-sm"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-danger btn-sm me-auto" id="eSilBtn" onclick="envSil()" style="display:none;">Sil</button>
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button><button class="btn btn-primary btn-sm" onclick="envKaydet()">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mailModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Satınalma KK Raporu Mail Gönder</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="mailCode">
                <div class="mb-2"><label class="form-label small">Alıcı E-posta (birden fazlaysa ; ile ayırın)</label><input id="mailAlici" class="form-control form-control-sm"></div>
                <div class="mb-2"><label class="form-label small">Not (opsiyonel)</label><textarea id="mailNot" class="form-control form-control-sm" rows="2"></textarea></div>
            </div>
            <div class="modal-footer"><button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button><button class="btn btn-primary btn-sm" onclick="mailGonder()">Gönder</button></div>
        </div>
    </div>
</div>

<div class="modal fade" id="belgeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Kalite Değerlendirme Belgeleri</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <form id="belgeYukleForm" onsubmit="belgeYukle(event)" class="row g-2 mb-3">
                    <div class="col-6"><input type="file" id="belgeDosya" class="form-control form-control-sm" required></div>
                    <div class="col-4"><input id="belgeAciklama" class="form-control form-control-sm" placeholder="Açıklama (opsiyonel)"></div>
                    <div class="col-2"><button type="submit" class="btn btn-primary btn-sm w-100">Yükle</button></div>
                </form>
                <div class="table-responsive" style="max-height:400px;">
                    <table class="table table-hover table-custom mb-0">
                        <thead><tr><th>Dosya</th><th>Tarih</th><th>Yükleyen</th><th></th></tr></thead>
                        <tbody id="tbodyBelge"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Kapat</button></div>
        </div>
    </div>
</div>

<style>
    .dash-card { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
    .table-custom th { background-color: #f8f9fc; text-transform: uppercase; font-size: 11px; color: #858796; border-bottom: 2px solid #e3e6f0; }
    .table-custom td { vertical-align: middle; font-size: 13px; color: #5a5c69; }
</style>

<script>
    async function beklYukle() {
        const qs = new URLSearchParams({ search: document.getElementById('fBeklArama').value });
        const res = await fetch('/UrasUretimKalite/GetSatinalmaKKBekleyen?' + qs.toString()).then(r => r.json());
        const list = res.success ? res.data : [];
        document.getElementById('beklSayisi').textContent = list.length;
        document.getElementById('tbodyBekleyen').innerHTML = list.map(b => `
            <tr><td class="text-nowrap">${b.Tarih}</td><td>${b.Tedarikci}</td><td>${b.ItemName}<div class="text-muted small">${b.ItemCode}</div></td>
                <td><button class="btn btn-sm btn-outline-primary" onclick='formAc(${JSON.stringify(b)})'>Değerlendir</button></td></tr>`).join('')
            || '<tr><td colspan="4" class="text-center text-muted py-3">Bekleyen kalem yok.</td></tr>';
    }

    async function defterYukle() {
        const res = await fetch('/UrasUretimKalite/GetSatinalmaKKDefter?page=1&pageSize=100').then(r => r.json());
        const d = res.success ? res.data : { list: [], totalCount: 0 };
        document.getElementById('defterSayisi').textContent = d.totalCount || (d.list || []).length;
        document.getElementById('tbodyDefter').innerHTML = (d.list || []).map(k => `
            <tr><td class="text-nowrap">${k.Tarih}</td><td>${k.ItemName}<div class="text-muted small">${k.ItemCode}</div></td><td>${k.Tedarikci}</td>
                <td>${k.Echa === 'Y' ? '<span class="text-success">Uygun</span>' : '<span class="text-danger">Uygun Değil</span>'}</td>
                <td class="text-nowrap">
                    <button class="btn btn-sm btn-outline-primary" onclick='belgeAc(${JSON.stringify(k.Code)})'><i class="fas fa-paperclip"></i> ${k.BelgeSayisi || 0}</button>
                    <a class="btn btn-sm btn-outline-secondary" title="PDF" href="/UrasUretimKalite/SatinalmaKKPdf?code=${encodeURIComponent(k.Code)}" target="_blank"><i class="fas fa-file-pdf"></i></a>
                    <button class="btn btn-sm btn-outline-primary" title="Mail Gönder" onclick='mailAc(${JSON.stringify(k.Code)})'><i class="fas fa-envelope"></i></button>
                </td></tr>`).join('')
            || '<tr><td colspan="5" class="text-center text-muted py-3">Kayıt yok.</td></tr>';
    }

    async function mailAc(code) {
        document.getElementById('mailCode').value = code;
        document.getElementById('mailNot').value = '';
        try {
            const res = await fetch('/UrasUretimKalite/GetSatinalmaKKMailAlicilar').then(r => r.json());
            document.getElementById('mailAlici').value = res.success ? (res.data || '') : '';
        } catch { document.getElementById('mailAlici').value = ''; }
        new bootstrap.Modal(document.getElementById('mailModal')).show();
    }

    async function mailGonder() {
        const body = { Code: document.getElementById('mailCode').value, Alici: document.getElementById('mailAlici').value, Not: document.getElementById('mailNot').value };
        if (!body.Alici) { alert('Alıcı e-posta adresi girin.'); return; }
        const res = await fetch('/UrasUretimKalite/SendSatinalmaKKMail', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        alert(res.message);
        if (res.success) bootstrap.Modal.getInstance(document.getElementById('mailModal')).hide();
    }

    let belgeKkCode = null;
    async function belgeAc(kkCode) {
        belgeKkCode = kkCode;
        document.getElementById('belgeYukleForm').reset();
        await belgeListeYukle();
        new bootstrap.Modal(document.getElementById('belgeModal')).show();
    }

    async function belgeListeYukle() {
        const res = await fetch('/UrasUretimKalite/GetSatinalmaKKBelgeler?kkCode=' + encodeURIComponent(belgeKkCode)).then(r => r.json());
        const list = res.success ? res.data : [];
        document.getElementById('tbodyBelge').innerHTML = list.map(b => `
            <tr><td>${b.DosyaAdi}<div class="text-muted small">${b.Aciklama || ''}</div></td><td class="text-nowrap">${b.Zaman}</td><td>${b.Yukleyen}</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" href="/UrasUretimKalite/SatinalmaKKBelgeIndir?code=${encodeURIComponent(b.Code)}" target="_blank"><i class="fas fa-download"></i></a>
                    <button class="btn btn-sm btn-outline-danger" onclick="belgeSil('${b.Code}')"><i class="fas fa-trash"></i></button>
                </td></tr>`).join('')
            || '<tr><td colspan="4" class="text-center text-muted py-3">Belge yok.</td></tr>';
    }

    async function belgeSil(code) {
        if (!confirm('Bu belgeyi silmek istediğinize emin misiniz?')) return;
        const res = await fetch('/UrasUretimKalite/DeleteSatinalmaKKBelge', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ Code: code }) }).then(r => r.json());
        alert(res.message);
        if (res.success) { belgeListeYukle(); defterYukle(); }
    }

    async function belgeYukle(ev) {
        ev.preventDefault();
        const dosya = document.getElementById('belgeDosya').files[0];
        if (!dosya) { alert('Dosya seçin.'); return; }
        const fd = new FormData();
        fd.append('dosya', dosya); fd.append('kkCode', belgeKkCode); fd.append('aciklama', document.getElementById('belgeAciklama').value);
        const res = await fetch('/UrasUretimKalite/UploadSatinalmaKKBelge', { method: 'POST', body: fd }).then(r => r.json());
        alert(res.message);
        if (res.success) { document.getElementById('belgeYukleForm').reset(); belgeListeYukle(); defterYukle(); }
    }

    async function envYukle() {
        const res = await fetch('/UrasUretimKalite/GetKimEnvList').then(r => r.json());
        const list = res.success ? res.data : [];
        document.getElementById('envSayisi').textContent = list.length;
        document.getElementById('tbodyEnv').innerHTML = list.map(e => `
            <tr><td>${e.ItemName || e.ItemCode}<div class="text-muted small">${e.ItemCode}</div></td><td>${e.Uretici}</td><td>${e.CasNo}</td>
                <td><button class="btn btn-sm btn-outline-primary" onclick='envDuzenle(${JSON.stringify(e)})'><i class="fas fa-pen"></i></button></td></tr>`).join('')
            || '<tr><td colspan="4" class="text-center text-muted py-3">Kayıt yok.</td></tr>';
    }

    function formAc(b) {
        document.getElementById('mKaynakEntry').value = b.DocEntry; document.getElementById('mKaynakLineNum').value = b.LineNum; document.getElementById('mKaynakNo').value = b.DocNum;
        document.getElementById('mCardCode').value = b.CardCode; document.getElementById('mItemCode').value = b.ItemCode;
        document.getElementById('mTedarikci').value = b.Tedarikci; document.getElementById('mItemName').value = b.ItemName;
        document.getElementById('mTarih').value = new Date().toISOString().slice(0, 10);
        document.getElementById('mMiktar').value = b.Miktar; document.getElementById('mBirim').value = b.Birim;
        document.getElementById('mGorev').value = ''; document.getElementById('mEcha').value = 'Y'; document.getElementById('mZdhc').value = '';
        document.getElementById('mControl').value = ''; document.getElementById('mAciklama').value = '';
        new bootstrap.Modal(document.getElementById('kkModal')).show();
    }

    async function kaydet() {
        const body = {
            KaynakEntry: parseInt(document.getElementById('mKaynakEntry').value), KaynakLineNum: parseInt(document.getElementById('mKaynakLineNum').value),
            KaynakNo: document.getElementById('mKaynakNo').value, CardCode: document.getElementById('mCardCode').value, Tedarikci: document.getElementById('mTedarikci').value,
            ItemCode: document.getElementById('mItemCode').value, ItemName: document.getElementById('mItemName').value,
            Miktar: parseFloat(document.getElementById('mMiktar').value), Birim: document.getElementById('mBirim').value, Tarih: document.getElementById('mTarih').value,
            Gorev: document.getElementById('mGorev').value, Echa: document.getElementById('mEcha').value, Zdhc: document.getElementById('mZdhc').value,
            ControlMeasures: document.getElementById('mControl').value, Aciklama: document.getElementById('mAciklama').value,
        };
        const res = await fetch('/UrasUretimKalite/SaveSatinalmaKK', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        alert(res.message);
        if (res.success) { bootstrap.Modal.getInstance(document.getElementById('kkModal')).hide(); beklYukle(); defterYukle(); }
    }

    function envYeni() {
        ['eItemCode','eUretici','eUrunAdi','eKimTur','eCasNo','eEcNo','eSdsTarihi','eGhs','eDepoAlan','eHKod','ePKod','eKullanim'].forEach(id => document.getElementById(id).value = '');
        document.getElementById('eSilBtn').style.display = 'none';
        new bootstrap.Modal(document.getElementById('envModal')).show();
    }
    function envDuzenle(e) {
        document.getElementById('eItemCode').value = e.ItemCode; document.getElementById('eUretici').value = e.Uretici || '';
        document.getElementById('eUrunAdi').value = e.UrunAdi || ''; document.getElementById('eKimTur').value = e.KimyasalTuru || '';
        document.getElementById('eCasNo').value = e.CasNo || ''; document.getElementById('eEcNo').value = e.EcNo || '';
        document.getElementById('eSdsTarihi').value = e.SdsTarihi ? e.SdsTarihi.split('.').reverse().join('-') : '';
        document.getElementById('eGhs').value = e.Ghs || ''; document.getElementById('eDepoAlan').value = e.DepoAlan || '';
        document.getElementById('eHKod').value = e.HKodlari || ''; document.getElementById('ePKod').value = e.PKodlari || ''; document.getElementById('eKullanim').value = e.KullanimYeri || '';
        document.getElementById('eSilBtn').style.display = '';
        new bootstrap.Modal(document.getElementById('envModal')).show();
    }
    async function envKaydet() {
        const body = {
            ItemCode: document.getElementById('eItemCode').value, Uretici: document.getElementById('eUretici').value, UrunAdi: document.getElementById('eUrunAdi').value,
            KimyasalTuru: document.getElementById('eKimTur').value, CasNo: document.getElementById('eCasNo').value, EcNo: document.getElementById('eEcNo').value,
            SdsTarihi: document.getElementById('eSdsTarihi').value, Ghs: document.getElementById('eGhs').value, DepoAlan: document.getElementById('eDepoAlan').value,
            HKodlari: document.getElementById('eHKod').value, PKodlari: document.getElementById('ePKod').value, KullanimYeri: document.getElementById('eKullanim').value,
        };
        const res = await fetch('/UrasUretimKalite/SaveKimEnv', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json());
        alert(res.message);
        if (res.success) { bootstrap.Modal.getInstance(document.getElementById('envModal')).hide(); envYukle(); }
    }
    async function envSil() {
        if (!confirm('Silinsin mi?')) return;
        const code = document.getElementById('eItemCode').value;
        const res = await fetch('/UrasUretimKalite/DeleteKimEnv', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ Code: code }) }).then(r => r.json());
        alert(res.message);
        if (res.success) { bootstrap.Modal.getInstance(document.getElementById('envModal')).hide(); envYukle(); }
    }

    beklYukle(); defterYukle(); envYukle();
</script>
